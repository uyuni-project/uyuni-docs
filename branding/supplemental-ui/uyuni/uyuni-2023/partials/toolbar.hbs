<div class="toolbar" role="navigation">
{{> nav-toggle}}
  {{#with site.homeUrl}}
  <a href="{{{relativize this}}}" class="home-link{{#if @root.page.home}} is-current{{/if}}"></a>
  {{/with}}
{{> breadcrumbs}}
{{> page-versions}}
  {{#with (englishEditUrl page.editUrl)}}
  {{#if (and (eq @root.page.attributes.lang "en") (or @root.env.FORCE_SHOW_EDIT_PAGE_LINK (not @root.page.origin.private)))}}
  <div class="edit-this-page"><a href="{{this}}">Edit this Page</a></div>
  {{/if}}
  {{/with}}
</div>
