#, no-wrap
msgid "Setup partitioning"
msgstr "ຕັ້ງຄ່າການແບ່ງພາກສ່ວນ (Partitioning)"

#. type: Plain text
#: en/modules/retail/pages/dedicated-with-scripts.adoc:38
