#. type: Title =
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:1
#, no-wrap
msgid "softwarechannel"
msgstr "ຊ່ອງທາງຊອບແວ (software channel)"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:2
msgid ""
"The following spacecmd functions are available for working with software "
"channels."
msgstr "ຟັງຊັນ spacecmd ຕໍ່ໄປນີ້ແມ່ນມີໃຫ້ສຳລັບການເຮັດວຽກກັບຊ່ອງທາງຊອບແວ."

#. type: Title ==
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:3
#, no-wrap
msgid "softwarechannel_adderrata"
msgstr "softwarechannel_adderrata"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:4
msgid "Add patches from one channel into another channel."
msgstr "ເພີ່ມແພັດ (patches) ຈາກຊ່ອງທາງໜຶ່ງໄປຫາອີກຊ່ອງທາງໜຶ່ງ."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:5
#, no-wrap
msgid ""
"usage: softwarechannel_adderrata SOURCE DEST <ERRATA|search:XXX ...>\n"
"Options:\n"
"    -q/--quick : Don't display list of packages (slightly faster)\n"
"    -s/--skip :  Skip errata which appear to exist already in DEST\n"
msgstr ""
"ວິທີໃຊ້: softwarechannel_adderrata SOURCE DEST <ERRATA|search:XXX ...>\n"
"ຕົວເລືອກ:\n"
"    -q/--quick : ບໍ່ສະແດງລາຍຊື່ແພັກເກດ (ໄວຂຶ້ນໜ້ອຍໜຶ່ງ)\n"
"    -s/--skip :  ຂ້າມ Errata ທີ່ມີຢູ່ແລ້ວໃນຊ່ອງທາງປາຍທາງ (DEST)\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:6
#, no-wrap
msgid "softwarechannel_adderratabydate"
msgstr "softwarechannel_adderratabydate"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:7
msgid "Add errata from one channel into another channel based on a date range."
msgstr "ເພີ່ມ Errata ຈາກຊ່ອງທາງໜຶ່ງໄປຫາອີກຊ່ອງທາງໜຶ່ງໂດຍອີງຕາມໄລຍະວັນທີ."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:8
#, no-wrap
msgid ""
"usage: softwarechannel_adderratabydate [options] SOURCE DEST BEGINDATE "
"ENDDATE\n"
"Date format : YYYYMMDD\n"
"Options:\n"
"        -p/--publish : Publish errata to the channel (don't clone)\n"
msgstr ""
"ວິທີໃຊ້: softwarechannel_adderratabydate [options] SOURCE DEST BEGINDATE ENDDATE\n"
"ຮູບແບບວັນທີ : YYYYMMDD\n"
"ຕົວເລືອກ:\n"
"        -p/--publish : ເຜີຍແຜ່ Errata ລົງໃນຊ່ອງທາງ (ບໍ່ແມ່ນການໂຄລນ)\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:9
#, no-wrap
msgid "softwarechannel_addpackages"
msgstr "softwarechannel_addpackages"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:10
msgid "Add packages to a software channel."
msgstr "ເພີ່ມແພັກເກດເຂົ້າໃນຊ່ອງທາງຊອບແວ."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:11
#, no-wrap
msgid "usage: softwarechannel_addpackages CHANNEL <PACKAGE ...>\n"
msgstr "ວິທີໃຊ້: softwarechannel_addpackages CHANNEL <PACKAGE ...>\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:12
#, no-wrap
msgid "softwarechannel_addrepo"
msgstr "softwarechannel_addrepo"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:13
msgid "Add a repo to a software channel."
msgstr "ເພີ່ມເຣໂປເຂົ້າໃນຊ່ອງທາງຊອບແວ."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:14
#, no-wrap
msgid "usage: softwarechannel_addrepo CHANNEL REPO\n"
msgstr "ວິທີໃຊ້: softwarechannel_addrepo CHANNEL REPO\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:15
#, no-wrap
msgid "softwarechannel_clone"
msgstr "softwarechannel_clone"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:16
msgid "Clone a software channel."
msgstr "ໂຄລນ (Clone) ຊ່ອງທາງຊອບແວ."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:17
#, no-wrap
msgid "usage: softwarechannel_clone [options]\n"
msgstr "ວິທີໃຊ້: softwarechannel_clone [options]\n"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:18
#, no-wrap
msgid ""
"options:\n"
"  -s SOURCE_CHANNEL\n"
"  -n NAME\n"
"  -l LABEL\n"
"  -p PARENT_CHANNEL\n"
"  --gpg-copy/-g (copy SOURCE_CHANNEL GPG details)\n"
"  --gpg-url GPG_URL\n"
"  --gpg-id GPG_ID\n"
"  --gpg-fingerprint GPG_FINGERPRINT\n"
"  -o do not clone any patches\n"
"  --regex/-x \"s/foo/bar\" : Optional regex replacement,\n"
"        replaces foo with bar in the clone name and label\n"
msgstr ""
"ຕົວເລືອກ:\n"
"  -s SOURCE_CHANNEL (ຊ່ອງທາງຕົ້ນທາງ)\n"
"  -n NAME (ຊື່)\n"
"  -l LABEL (ປ້າຍຊື່)\n"
"  -p PARENT_CHANNEL (ຊ່ອງທາງຫຼັກ)\n"
"  --gpg-copy/-g (ຄັດລອກລາຍລະອຽດ GPG ຈາກຊ່ອງທາງຕົ້ນທາງ)\n"
"  --gpg-url GPG_URL\n"
"  --gpg-id GPG_ID\n"
"  --gpg-fingerprint GPG_FINGERPRINT\n"
"  -o ບໍ່ຕ້ອງໂຄລນແພັດໃດໆ\n"
"  --regex/-x \"s/foo/bar\" : ການແທນທີ່ດ້ວຍ regex (ບໍ່ບັງຄັບ),\n"
"        ແທນທີ່ foo ດ້ວຍ bar ໃນຊື່ ແລະ ປ້າຍຊື່ທີ່ໂຄລນ\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:19
#, no-wrap
msgid "softwarechannel_clonetree"
msgstr "softwarechannel_clonetree"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:20
msgid "Clone a software channel and its child channels."
msgstr "ໂຄລນຊ່ອງທາງຊອບແວ ແລະ ຊ່ອງທາງຍ່ອຍຂອງມັນ."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:21
#, no-wrap
msgid ""
"usage: softwarechannel_clonetree [options]A\n"
"             e.g    softwarechannel_clonetree foobasechannel -p \"my_\"\n"
"                    softwarechannel_clonetree foobasechannel -x "
"\"s/foo/bar\"\n"
"                    softwarechannel_clonetree foobasechannel -x "
"\"s/^/my_\"\n"
msgstr ""
"ວິທີໃຊ້: softwarechannel_clonetree [options]\n"
"             ຕົວຢ່າງ: softwarechannel_clonetree foobasechannel -p \"my_\"\n"
"                    softwarechannel_clonetree foobasechannel -x \"s/foo/bar\"\n"
"                    softwarechannel_clonetree foobasechannel -x \"s/^/my_\"\n"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:22
#, no-wrap
msgid ""
"options:\n"
"  -s/--source-channel SOURCE_CHANNEL\n"
"  -p/--prefix PREFIX (is prepended to the label and name of all channels)\n"
"  --gpg-copy/-g (copy GPG details for correspondoing source channel))\n"
"  --gpg-url GPG_URL (applied to all channels)\n"
"  --gpg-id GPG_ID (applied to all channels)\n"
"  --gpg-fingerprint GPG_FINGERPRINT (applied to all channels)\n"
"  -o do not clone any errata\n"
"  --regex/-x \"s/foo/bar\" : Optional regex replacement,\n"
"        replaces foo with bar in the clone name, label and description\n"
msgstr ""
"ຕົວເລືອກ:\n"
"  -s/--source-channel SOURCE_CHANNEL (ຊ່ອງທາງຕົ້ນທາງ)\n"
"  -p/--prefix PREFIX (ຄຳນຳໜ້າທີ່ຈະຕື່ມໃສ່ປ້າຍຊື່ ແລະ ຊື່ຂອງທຸກຊ່ອງທາງ)\n"
"  --gpg-copy/-g (ຄັດລອກລາຍລະອຽດ GPG ສຳລັບຊ່ອງທາງຕົ້ນທາງທີ່ກ່ຽວຂ້ອງ)\n"
"  --gpg-url GPG_URL (ໃຊ້ກັບທຸກຊ່ອງທາງ)\n"
"  --gpg-id GPG_ID (ໃຊ້ກັບທຸກຊ່ອງທາງ)\n"
"  --gpg-fingerprint GPG_FINGERPRINT (ໃຊ້ກັບທຸກຊ່ອງທາງ)\n"
"  -o ບໍ່ຕ້ອງໂຄລນ Errata ໃດໆ\n"
"  --regex/-x \"s/foo/bar\" : ການແທນທີ່ດ້ວຍ regex,\n"
"        ແທນທີ່ foo ດ້ວຍ bar ໃນຊື່, ປ້າຍຊື່ ແລະ ຄຳອະທິບາຍ\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:23
#, no-wrap
msgid "softwarechannel_create"
msgstr "softwarechannel_create"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:24
msgid "Create a software channel."
msgstr "ສ້າງຊ່ອງທາງຊອບແວ."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:25
#, no-wrap
msgid "usage: softwarechannel_create [options]\n"
msgstr "ວິທີໃຊ້: softwarechannel_create [options]\n"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:26
#, no-wrap
msgid ""
"options:\n"
"  -n NAME\n"
"  -l LABEL\n"
"  -p PARENT_CHANNEL\n"
"  -a ARCHITECTURE ['ia32', 'ia64', 'x86_64', 'ppc',\n"
"                  'i386-sun-solaris', 'sparc-sun-solaris']\n"
"  -c CHECKSUM ['sha1', 'sha256', 'sha384', 'sha512']\n"
"  -u GPG_URL\n"
"  -i GPG_ID\n"
"  -f GPG_FINGERPRINT\n"
msgstr ""
"ຕົວເລືອກ:\n"
"  -n NAME (ຊື່)\n"
"  -l LABEL (ປ້າຍຊື່)\n"
"  -p PARENT_CHANNEL (ຊ່ອງທາງຫຼັກ)\n"
"  -a ARCHITECTURE (ສະຖາປັດຕະຍະກຳ)\n"
"  -c CHECKSUM (ການກວດສອບຄວາມຖືກຕ້ອງ)\n"
"  -u GPG_URL\n"
"  -i GPG_ID\n"
"  -f GPG_FINGERPRINT\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:27
#, no-wrap
msgid "softwarechannel_delete"
msgstr "softwarechannel_delete"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:28
msgid "Delete a software channel."
msgstr "ລຶບຊ່ອງທາງຊອບແວ."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:29
#, no-wrap
msgid "usage: softwarechannel_delete <CHANNEL ...>\n"
msgstr "ວິທີໃຊ້: softwarechannel_delete <CHANNEL ...>\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:30
#, no-wrap
msgid "softwarechannel_details"
msgstr "softwarechannel_details"

#. type: Plain text
