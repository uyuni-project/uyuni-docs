msgstr "ປິດໃຊ້ງານບັນຊີຜູ້ໃຊ້."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/user.adoc:24
#, no-wrap
msgid "usage: user_disable NAME\n"
msgstr "ວິທີໃຊ້: user_disable ຊື່\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/user.adoc:25
#, no-wrap
msgid "user_enable"
msgstr "user_enable"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/user.adoc:26
msgid "Enable an user account."
msgstr "ເປີດໃຊ້ງານບັນຊີຜູ້ໃຊ້."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/user.adoc:27
#, no-wrap
msgid "usage: user_enable NAME\n"
msgstr "ວິທີໃຊ້: user_enable ຊື່\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/user.adoc:28
#, no-wrap
msgid "user_list"
msgstr "user_list"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/user.adoc:29
msgid "List all users."
msgstr "ສະແດງລາຍຊື່ຜູ້ໃຊ້ທັງໝົດ."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/user.adoc:30
#, no-wrap
msgid "usage: user_list\n"
msgstr "ວິທີໃຊ້: user_list\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/user.adoc:31
#, no-wrap
msgid "user_listavailableroles"
msgstr "user_listavailableroles"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/user.adoc:32
msgid "List all available roles for users."
msgstr "ສະແດງລາຍຊື່ບົດບາດທັງໝົດທີ່ມີສຳລັບຜູ້ໃຊ້."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/user.adoc:33
#, no-wrap
msgid "usage: user_listavailableroles\n"
msgstr "ວິທີໃຊ້: user_listavailableroles\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/user.adoc:34
#, no-wrap
msgid "user_removedefaultgroup"
msgstr "user_removedefaultgroup"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/user.adoc:35
msgid "Remove a default group from an user account."
msgstr "ລຶບກຸ່ມເລີ່ມຕົ້ນອອກຈາກບັນຊີຜູ້ໃຊ້."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/user.adoc:36
#, no-wrap
msgid "usage: user_removedefaultgroup USER <GROUP ...>\n"
msgstr "ວິທີໃຊ້: user_removedefaultgroup ຜູ້ໃຊ້ <ກຸ່ມ ...>\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/user.adoc:37
#, no-wrap
msgid "user_removegroup"
msgstr "user_removegroup"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/user.adoc:38
