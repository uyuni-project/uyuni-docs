#. type: Title ==
#: en/modules/reference/pages/spacecmd/user.adoc:46
#, no-wrap
msgid "user_setfirstname"
msgstr "user_setfirstname"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/user.adoc:47
msgid "Set an user accounts first name field."
msgstr "ກຳນົດຂໍ້ມູນໃນຫ້ອງຊື່ຂອງບັນຊີຜູ້ໃຊ້."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/user.adoc:48
#, no-wrap
msgid "usage: user_setfirstname USER FIRST_NAME\n"
msgstr "ວິທີໃຊ້: user_setfirstname ຜູ້ໃຊ້ ຊື່\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/user.adoc:49
#, no-wrap
msgid "user_setlastname"
msgstr "user_setlastname"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/user.adoc:50
