msgstr "ກຳນົດຂໍ້ມູນໃນຫ້ອງນາມສະກຸນຂອງບັນຊີຜູ້ໃຊ້."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/user.adoc:51
#, no-wrap
msgid "usage: user_setlastname USER LAST_NAME\n"
msgstr "ວິທີໃຊ້: user_setlastname ຜູ້ໃຊ້ ນາມສະກຸນ\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/user.adoc:52
#, no-wrap
msgid "user_setpassword"
msgstr "user_setpassword"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/user.adoc:53
#: en/modules/reference/pages/spacecmd/user.adoc:56
msgid "Set an user accounts name prefix field."
msgstr "ກຳນົດຂໍ້ມູນໃນຫ້ອງຄຳນຳໜ້າຊື່ຂອງບັນຊີຜູ້ໃຊ້."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/user.adoc:54
#, no-wrap
msgid "usage: user_setpassword USER PASSWORD\n"
msgstr "ວິທີໃຊ້: user_setpassword ຜູ້ໃຊ້ ລະຫັດຜ່ານ\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/user.adoc:55
#, no-wrap
msgid "user_setprefix"
msgstr "user_setprefix"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/user.adoc:57
#, no-wrap
msgid "usage: user_setprefix USER PREFIX\n"
msgstr "ວິທີໃຊ້: user_setprefix ຜູ້ໃຊ້ ຄຳນຳໜ້າ\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/whoami.adoc:1
#: en/modules/reference/pages/spacecmd/whoami.adoc:3
#, no-wrap
msgid "whoami"
msgstr "whoami"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/whoami.adoc:2
msgid ""
"The following command is available for returning the currently logged "
"spacecmd username."
msgstr "ຄຳສັ່ງຕໍ່ໄປນີ້ໃຊ້ສຳລັບສະແດງຊື່ຜູ້ໃຊ້ spacecmd ທີ່ກຳລັງເຂົ້າລະບົບຢູ່ໃນປະຈຸບັນ."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/whoami.adoc:4
msgid "Print the currently logged spacecmd user."
msgstr "ສະແດງຜູ້ໃຊ້ spacecmd ທີ່ກຳລັງເຂົ້າລະບົບຢູ່ໃນປະຈຸບັນ."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/whoami.adoc:5
#, no-wrap
msgid ""
"spacecmd {SSM:0}> whoami\n"
"admin\n"
msgstr ""
"spacecmd {SSM:0}> whoami\n"
"admin\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/whoamitalkingto.adoc:1
#: en/modules/reference/pages/spacecmd/whoamitalkingto.adoc:3
#, no-wrap
msgid "whoamitalkingto"
msgstr "whoamitalkingto"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/whoamitalkingto.adoc:2
msgid ""
"The following spacecmd function is available for returning the server "
"hostname."
msgstr "ຟັງຊັນ spacecmd ຕໍ່ໄປນີ້ໃຊ້ສຳລັບສະແດງຊື່ໂຮສ (hostname) ຂອງເຊີເວີ."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/whoamitalkingto.adoc:4
msgid "Return the server hostname that spacecmd is connected with."
msgstr "ສົ່ງຄ່າຊື່ໂຮສຂອງເຊີເວີທີ່ spacecmd ກຳລັງເຊື່ອມຕໍ່ຢູ່."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/whoamitalkingto.adoc:5
#, no-wrap
msgid ""
"spacecmd {SSM:0}> whoamitalkingto\n"
"MGR_SERVER_HOSTNAME\n"
msgstr ""
"spacecmd {SSM:0}> whoamitalkingto\n"
"MGR_SERVER_HOSTNAME\n"

#. type: Title =
#: en/modules/reference/pages/systems/activation-keys.adoc:1
#, no-wrap
msgid "Activation Keys"
msgstr "ຄີການເປີດໃຊ້"

#. type: Plain text
#: en/modules/reference/pages/systems/activation-keys.adoc:2
msgid ""
"The menu:Systems[Activation Keys] section lists the current activation keys "
"for your organization."
msgstr "ພາກສ່ວນ menu:Systems[Activation Keys] ຈະສະແດງລາຍຊື່ຄີການເປີດໃຊ້ປະຈຸບັນສຳລັບອົງກອນຂອງທ່ານ."

#. type: Plain text
#: en/modules/reference/pages/systems/activation-keys.adoc:3
msgid ""
"The universal default activation key, if set, is automatically used for all "
"clients registered to your organization, unless you specify a different "
"activation key."
msgstr "ຄີການເປີດໃຊ້ເລີ່ມຕົ້ນແບບສາກົນ, ຫາກມີການກຳນົດໄວ້, ຈະຖືກນຳໃຊ້ໂດຍອັດຕະໂນມັດສຳລັບເຄື່ອງລູກຂ່າຍທັງໝົດທີ່ລົງທະບຽນໃນອົງກອນຂອງທ່ານ, ເວັ້ນເສຍແຕ່ທ່ານຈະລະບຸຄີການເປີດໃຊ້ອື່ນ."

#. type: Plain text
#: en/modules/reference/pages/systems/activation-keys.adoc:4
msgid ""
"The list of activation keys shows the name and description for each key, and "
"how many times the key has been used.  It also shows if the key is currently "
"enabled for your organization.  Click the key description to see more "
"information about the activation key."
msgstr "ລາຍຊື່ຂອງຄີການເປີດໃຊ້ຈະສະແດງຊື່ ແລະ ຄຳອະທິບາຍຂອງແຕ່ລະຄີ, ລວມທັງຈຳນວນຄັ້ງທີ່ຖືກນຳໃຊ້. ມັນຍັງສະແດງໃຫ້ເຫັນວ່າຄີດັ່ງກ່າວຖືກເປີດໃຊ້ງານໃນອົງກອນຂອງທ່ານຫຼືບໍ່. ຄລິກທີ່ຄຳອະທິບາຍຄີເພື່ອເບິ່ງຂໍ້ມູນເພີ່ມເຕີມ."

#. type: Plain text
#: en/modules/reference/pages/systems/activation-keys.adoc:5
msgid "Click btn:[Update Activation Keys] to refresh the list with recent changes."
msgstr "ຄລິກທີ່ປຸ່ມ btn:[Update Activation Keys] ເພື່ອໂຫຼດລາຍຊື່ຄືນໃໝ່ຕາມການປ່ຽນແປງຫຼ້າສຸດ."

#. type: Plain text
#: en/modules/reference/pages/systems/activation-keys.adoc:6
msgid "Click btn:[Create Key] to create a new activation key."
msgstr "ຄລິກທີ່ປຸ່ມ btn:[Create Key] ເພື່ອສ້າງຄີການເປີດໃຊ້ໃໝ່."

#. type: Plain text
#: en/modules/reference/pages/systems/activation-keys.adoc:7
msgid ""
"For more information about activation keys, see "
"xref:client-configuration:activation-keys.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບຄີການເປີດໃຊ້ (activation keys), ເບິ່ງໄດ້ທີ່ xref:client-configuration:activation-keys.adoc[]."

#. type: Plain text
#: en/modules/reference/pages/systems/advanced-search.adoc:2
msgid ""
"The menu:Systems[Advanced Search] section allows you to perform global "
"searches within your {productname} environment.  Searches can include "
"network information, hardware devices, location, activity, packages, "
"details, DMI information, and hardware."
msgstr "ພາກສ່ວນ menu:Systems[Advanced Search] ຊ່ວຍໃຫ້ທ່ານສາມາດຄົ້ນຫາແບບທົ່ວໄປພາຍໃນສະພາບແວດລ້ອມ {productname} ຂອງທ່ານ. ການຄົ້ນຫາສາມາດລວມເຖິງຂໍ້ມູນເຄືອຂ່າຍ, ອຸປະກອນຮາດແວ, ສະຖານທີ່, ກິດຈະກຳ, ແພັກເກັດ, ລາຍລະອຽດ, ຂໍ້ມູນ DMI ແລະ ຮາດແວ."

#. type: Plain text
#: en/modules/reference/pages/systems/advanced-search.adoc:3
msgid ""
"Type your search term in the [guimenu]``Search For`` field.  Select the "
"criterion to search by, use the radio buttons to specify whether you want to "
"query all systems or only those in the [guimenu]``System Set Manager``, and "
"click the btn:[Search] button.  Check [guimenu]``Invert Result`` to list "
"only results that do not match the specified criteria."
msgstr "ພິມຄຳທີ່ຕ້ອງການຄົ້ນຫາໃນຫ້ອງ [guimenu]``Search For``. ເລືອກເກນການຄົ້ນຫາ, ໃຊ້ປຸ່ມເລືອກ (radio buttons) ເພື່ອລະບຸວ່າຕ້ອງການຄົ້ນຫາທຸກລະບົບ ຫຼື ສະເພາະລະບົບທີ່ຢູ່ໃນ [guimenu]``System Set Manager``, ແລ້ວຄລິກປຸ່ມ btn:[Search]. ເລືອກ [guimenu]``Invert Result`` ເພື່ອສະແດງສະເພາະຜົນລັບທີ່ບໍ່ກົງກັບເກນທີ່ລະບຸ."

#. type: Plain text
#: en/modules/reference/pages/systems/advanced-search.adoc:4
msgid ""
"When you add a distribution, synchronize channels, or register a client, it "
"can take several minutes for it to be indexed and appear in search results.  "
"To force a rebuild of the search index, use this command at the command "
"prompt:"
msgstr "ເມື່ອທ່ານເພີ່ມການແຈກຢາຍ (distribution), ຊິງໂຄຣໄນຊ່ອງທາງ ຫຼື ລົງທະບຽນເຄື່ອງລູກຂ່າຍ, ອາດຈະໃຊ້ເວລາຫຼາຍນາທີເພື່ອເຮັດດັດຊະນີ ແລະ ສະແດງໃນຜົນການຄົ້ນຫາ. ເພື່ອບັງຄັບໃຫ້ສ້າງດັດຊະນີການຄົ້ນຫາໃໝ່, ໃຫ້ໃຊ້ຄຳສັ່ງນີ້ທີ່ command prompt:"

#. type: delimited block -
#: en/modules/reference/pages/systems/advanced-search.adoc:5
#, no-wrap
msgid "rhn-search cleanindex\n"
msgstr "rhn-search cleanindex\n"

#. type: Title =
#: en/modules/reference/pages/systems/autoinst-distributions.adoc:1
#, no-wrap
msgid "Distributions"
msgstr "ການແຈກຢາຍ (Distributions)"

#. type: Plain text
#: en/modules/reference/pages/systems/autoinst-distributions.adoc:2
msgid ""
"The menu:Systems[Autoinstallation > Distributions] section lists the "
"available autoinstallable distributions."
msgstr "ພາກສ່ວນ menu:Systems[Autoinstallation > Distributions] ຈະສະແດງລາຍຊື່ການແຈກຢາຍທີ່ສາມາດຕິດຕັ້ງແບບອັດຕະໂນມັດໄດ້."

#. type: Plain text
#: en/modules/reference/pages/systems/autoinst-distributions.adoc:3
msgid ""
"Click the distribution name to see more information.  Click btn:[Create "
"Distribution] to create a new autoinstallable distribution."
msgstr "ຄລິກທີ່ຊື່ການແຈກຢາຍເພື່ອເບິ່ງຂໍ້ມູນເພີ່ມເຕີມ. ຄລິກ btn:[Create Distribution] ເພື່ອສ້າງການແຈກຢາຍທີ່ຕິດຕັ້ງແບບອັດຕະໂນມັດໃໝ່."

#. type: Plain text
#: en/modules/reference/pages/systems/autoinst-distributions.adoc:4
msgid ""
"For more information about autoinstallable distributions, see "
"xref:client-configuration:autoinst-distributions.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການແຈກຢາຍທີ່ຕິດຕັ້ງອັດຕະໂນມັດ, ເບິ່ງໄດ້ທີ່ xref:client-configuration:autoinst-distributions.adoc[]."

#. type: Title =
#: en/modules/reference/pages/systems/autoinst-file-preservation.adoc:1
#, no-wrap
msgid "File Preservation"
msgstr "ການຮັກສາໄຟລ໌ (File Preservation)"

#. type: Plain text
#: en/modules/reference/pages/systems/autoinst-file-preservation.adoc:2
msgid ""
"The menu:Systems[Autoinstallation > File Preservation] section allows you to "
"store lists of files, to use them in {kickstart} profiles later on."
msgstr "ພາກສ່ວນ menu:Systems[Autoinstallation > File Preservation] ຊ່ວຍໃຫ້ທ່ານສາມາດເກັບລາຍຊື່ໄຟລ໌ເພື່ອໄປໃຊ້ໃນ {kickstart} ໂປຣໄຟລ໌ໃນພາຍຫຼັງ."

#. type: Plain text
#: en/modules/reference/pages/systems/autoinst-file-preservation.adoc:3
msgid "Click btn:[Create File Preservation List] to create a new list."
msgstr "ຄລິກ btn:[Create File Preservation List] ເພື່ອສ້າງລາຍຊື່ໃໝ່."

#. type: Plain text
#: en/modules/reference/pages/systems/autoinst-file-preservation.adoc:4
msgid ""
"For more information about {kickstart} file preservation, see "
"xref:client-configuration:autoinst-profiles.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການຮັກສາໄຟລ໌ຂອງ {kickstart}, ເບິ່ງໄດ້ທີ່ xref:client-configuration:autoinst-profiles.adoc[]."

#. type: Title =
#: en/modules/reference/pages/systems/autoinst-gpg-and-ssl-keys.adoc:1
#, no-wrap
msgid "GPG and SSL Keys"
msgstr "ຄີ GPG ແລະ SSL"

#. type: Plain text
#: en/modules/reference/pages/systems/autoinst-gpg-and-ssl-keys.adoc:2
msgid ""
"The menu:Systems[Autoinstallation > GPG and SSL Keys] section lists all "
"GPG public keys and SSL certificates currently available.  Click the name of "
"a key to see more information."
msgstr "ພາກສ່ວນ menu:Systems[Autoinstallation > GPG and SSL Keys] ຈະສະແດງລາຍຊື່ GPG public keys ແລະ ໃບຢັ້ງຢືນ SSL ທັງໝົດທີ່ມີຢູ່ໃນປະຈຸບັນ. ຄລິກທີ່ຊື່ຂອງຄີເພື່ອເບິ່ງຂໍ້ມູນເພີ່ມເຕີມ."

#. type: Plain text
#: en/modules/reference/pages/systems/autoinst-gpg-and-ssl-keys.adoc:3
msgid ""
"Click btn:[Create Stored Key/Cert] to store a new GPG key or SSL "
"certificate."
msgstr "ຄລິກ btn:[Create Stored Key/Cert] ເພື່ອເກັບຄີ GPG ຫຼື ໃບຢັ້ງຢືນ SSL ໃໝ່."

#. type: Plain text
#: en/modules/reference/pages/systems/autoinst-gpg-and-ssl-keys.adoc:4
msgid ""
"For more information about GPG keys and SSL certificates, see "
"xref:client-configuration:gpg-keys.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບຄີ GPG ແລະ ໃບຢັ້ງຢືນ SSL, ເບິ່ງໄດ້ທີ່ xref:client-configuration:gpg-keys.adoc[]."

#. type: Title =
#: en/modules/reference/pages/systems/autoinst-menu.adoc:1
#, no-wrap
msgid "Autoinstallation Menu"
msgstr "ເມນູການຕິດຕັ້ງອັດຕະໂນມັດ"

#. type: Plain text
#: en/modules/reference/pages/systems/autoinst-menu.adoc:2
msgid ""
"The menu:Systems[Autoinstallation] section allows you to manage clients for "
"autoinstallation."
msgstr "ພາກສ່ວນ menu:Systems[Autoinstallation] ຊ່ວຍໃຫ້ທ່ານສາມາດຈັດການເຄື່ອງລູກຂ່າຍສຳລັບການຕິດຕັ້ງອັດຕະໂນມັດ."

#. type: Plain text
#: en/modules/reference/pages/systems/autoinst-menu.adoc:3
#: en/modules/reference/pages/systems/autoinst-overview.adoc:13
#: en/modules/reference/pages/systems/ssm-overview.adoc:38
#: en/modules/reference/pages/systems/system-details/sd-provisioning.adoc:6
msgid ""
"For more information about autoinstallation, see "
"xref:client-configuration:autoinst-intro.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການຕິດຕັ້ງອັດຕະໂນມັດ, ເບິ່ງໄດ້ທີ່ xref:client-configuration:autoinst-intro.adoc[]."

#. type: Title =
#: en/modules/reference/pages/systems/autoinst-overview.adoc:1
#, no-wrap
msgid "Autoinstallation Overview"
msgstr "ພາບລວມການຕິດຕັ້ງອັດຕະໂນມັດ"

#. type: Plain text
#: en/modules/reference/pages/systems/autoinst-overview.adoc:2
msgid ""
"The menu:Systems[Autoinstallation > Overview] section displays an overview "
"of your autoinstallation settings, including clients that are "
"autoinstalling, or scheduled to be autoinstalled."
msgstr "ພາກສ່ວນ menu:Systems[Autoinstallation > Overview] ຈະສະແດງພາບລວມຂອງການຕັ້ງຄ່າການຕິດຕັ້ງອັດຕະໂນມັດຂອງທ່ານ, ລວມເຖິງເຄື່ອງລູກຂ່າຍທີ່ກຳລັງຕິດຕັ້ງ ຫຼື ທີ່ມີກຳນົດເວລາຈະຕິດຕັ້ງອັດຕະໂນມັດ."

#. type: Plain text
#: en/modules/reference/pages/systems/autoinst-overview.adoc:3
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:4
msgid "The menu:Systems[Details > Overview] subtab is split into sections:"
msgstr "ແຖບຍ່ອຍ menu:Systems[Details > Overview] ຖືກແບ່ງອອກເປັນພາກສ່ວນຕ່າງໆ:"

#. type: Labeled list
#: en/modules/reference/pages/systems/autoinst-overview.adoc:4
#, no-wrap
msgid "Autoinstallation Summary"
msgstr "ສະຫຼຸບການຕິດຕັ້ງອັດຕະໂນມັດ"

#. type: Plain text
#: en/modules/reference/pages/systems/autoinst-overview.adoc:5
msgid ""
"This section lists the {ay} and {kickstart} profiles currently available, "
"and the number of clients installed with each profile."
msgstr "ພາກສ່ວນນີ້ສະແດງລາຍຊື່ໂປຣໄຟລ໌ {ay} ແລະ {kickstart} ທີ່ມີຢູ່ໃນປະຈຸບັນ, ແລະ ຈຳນວນເຄື່ອງລູກຂ່າຍທີ່ຕິດຕັ້ງດ້ວຍແຕ່ລະໂປຣໄຟລ໌."

#. type: Labeled list
#: en/modules/reference/pages/systems/autoinst-overview.adoc:6
#, no-wrap
msgid "Autoinstallation Actions"
msgstr "ການດຳເນີນການຕິດຕັ້ງອັດຕະໂນມັດ"

#. type: Plain text
#: en/modules/reference/pages/systems/autoinst-overview.adoc:7
msgid ""
"This section provides links to actions related to autoinstallation.  You can "
"also access these using the menu:Systems[Autoinstallation] menu."
msgstr "ພາກສ່ວນນີ້ໃຫ້ລິ້ງໄປຫາການດຳເນີນການຕ່າງໆທີ່ກ່ຽວຂ້ອງກັບການຕິດຕັ້ງອັດຕະໂນມັດ. ທ່ານຍັງສາມາດເຂົ້າເຖິງສິ່ງເຫຼົ່ານີ້ໄດ້ໂດຍໃຊ້ເມນູ menu:Systems[Autoinstallation]."

#. type: Labeled list
#: en/modules/reference/pages/systems/autoinst-overview.adoc:8
#, no-wrap
msgid "Systems Currently Autoinstalling"
msgstr "ລະບົບທີ່ກຳລັງຕິດຕັ້ງອັດຕະໂນມັດໃນປະຈຸບັນ"

#. type: Plain text
#: en/modules/reference/pages/systems/autoinst-overview.adoc:9
msgid ""
"This section lists all clients that are currently autoinstalling, along with "
"their status."
msgstr "ພາກສ່ວນນີ້ສະແດງລາຍຊື່ເຄື່ອງລູກຂ່າຍທັງໝົດທີ່ກຳລັງຕິດຕັ້ງອັດຕະໂນມັດໃນປະຈຸບັນ, ພ້ອມກັບສະຖານະຂອງພວກມັນ."

#. type: Labeled list
#: en/modules/reference/pages/systems/autoinst-overview.adoc:10
#, no-wrap
msgid "Systems Scheduled to be Autoinstalled"
msgstr "ລະບົບທີ່ມີກຳນົດເວລາຕິດຕັ້ງອັດຕະໂນມັດ"

#. type: Plain text
#: en/modules/reference/pages/systems/autoinst-overview.adoc:11
msgid ""
"This section lists all clients that are scheduled for autoinstallation, "
"along with their status."
msgstr "ພາກສ່ວນນີ້ສະແດງລາຍຊື່ເຄື່ອງລູກຂ່າຍທັງໝົດທີ່ມີກຳນົດເວລາຕິດຕັ້ງອັດຕະໂນມັດ, ພ້ອມກັບສະຖານະຂອງພວກມັນ."

#. type: Plain text
#: en/modules/reference/pages/systems/autoinst-overview.adoc:12
#: en/modules/reference/pages/systems/autoinst-profiles.adoc:4
msgid ""
"Click btn:[Create Kickstart Profile] to create a new {kickstart} profile.  "
"Click btn:[Upload Kickstart/{ay} File] to upload a new autoinstallation "
"file."
msgstr "ຄລິກ btn:[Create Kickstart Profile] ເພື່ອສ້າງໂປຣໄຟລ໌ {kickstart} ໃໝ່. ຄລິກ btn:[Upload Kickstart/{ay} File] ເພື່ອອັບໂຫຼດໄຟລ໌ການຕິດຕັ້ງອັດຕະໂນມັດໃໝ່."

#. type: Title =
#: en/modules/reference/pages/systems/autoinst-profiles.adoc:1
#, no-wrap
msgid "Autoinstallation Profiles"
msgstr "ໂປຣໄຟລ໌ການຕິດຕັ້ງອັດຕະໂນມັດ"

#. type: Plain text
#: en/modules/reference/pages/systems/autoinst-profiles.adoc:2
msgid ""
"The menu:Systems[Autoinstallation > Profiles] section lists all profiles "
"currently available.  The list includes information about if the profile is "
"active, the distribution it is based on, and if it being managed with "
"{productname}."
msgstr "ພາກສ່ວນ menu:Systems[Autoinstallation > Profiles] ຈະສະແດງລາຍຊື່ໂປຣໄຟລ໌ທັງໝົດທີ່ມີໃນປະຈຸບັນ. ລາຍຊື່ຈະລວມມີຂໍ້ມູນວ່າໂປຣໄຟລ໌ນັ້ນເປີດໃຊ້ງານຢູ່ຫຼືບໍ່, ການແຈກຢາຍທີ່ມັນອີງໃສ່, ແລະ ມັນຖືກຈັດການດ້ວຍ {productname} ຫຼື ບໍ່."

#. type: Plain text
#: en/modules/reference/pages/systems/autoinst-profiles.adoc:3
msgid "Click the name of a profile to see more information."
msgstr "ຄລິກທີ່ຊື່ຂອງໂປຣໄຟລ໌ເພື່ອເບິ່ງຂໍ້ມູນເພີ່ມເຕີມ."

#. type: Plain text
#: en/modules/reference/pages/systems/autoinst-profiles.adoc:5
msgid ""
"For more information about autoinstallation profiles, see "
"xref:client-configuration:autoinst-profiles.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບໂປຣໄຟລ໌ການຕິດຕັ້ງອັດຕະໂນມັດ, ເບິ່ງໄດ້ທີ່ xref:client-configuration:autoinst-profiles.adoc[]."

#. type: Title =
#: en/modules/reference/pages/systems/autoinst-snippets.adoc:1
#, no-wrap
msgid "Autoinstallation Snippets"
msgstr "ຂໍ້ມູນໂຄ້ດການຕິດຕັ້ງອັດຕະໂນມັດ (Snippets)"

#. type: Plain text
#: en/modules/reference/pages/systems/autoinst-snippets.adoc:2
msgid ""
"The menu:Systems[Autoinstallation > Autoinstallation Snippets] section "
"allows you to store code snippets, to use them in autoinstallation profiles "
"later on."
msgstr "ພາກສ່ວນ menu:Systems[Autoinstallation > Autoinstallation Snippets] ຊ່ວຍໃຫ້ທ່ານສາມາດເກັບຂໍ້ມູນໂຄ້ດ (code snippets) ເພື່ອໄປໃຊ້ໃນໂປຣໄຟລ໌ການຕິດຕັ້ງອັດຕະໂນມັດໃນພາຍຫຼັງ."

#. type: Plain text
#: en/modules/reference/pages/systems/autoinst-snippets.adoc:3
msgid "Click btn:[Create Snippet] to create a new code snippet."
msgstr "ຄລິກ btn:[Create Snippet] ເພື່ອສ້າງໂຄ້ດໃໝ່."

#. type: Plain text
#: en/modules/reference/pages/systems/autoinst-snippets.adoc:4
msgid ""
"For more information about autoinstallation profiles using these code "
"snippets, see xref:client-configuration:autoinst-profiles.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບໂປຣໄຟລ໌ການຕິດຕັ້ງອັດຕະໂນມັດທີ່ໃຊ້ໂຄ້ດເຫຼົ່ານີ້, ເບິ່ງໄດ້ທີ່ xref:client-configuration:autoinst-profiles.adoc[]."

#. type: Title =
#: en/modules/reference/pages/systems/bootstrapping.adoc:1
#, no-wrap
msgid "Bootstrapping"
msgstr "ການບູດສະແຕຣັບ (Bootstrapping)"

#. type: Plain text
#: en/modules/reference/pages/systems/bootstrapping.adoc:2
msgid ""
"The menu:Systems[Bootstrapping] section allows you to register a single Salt "
"client."
msgstr "ພາກສ່ວນ menu:Systems[Bootstrapping] ຊ່ວຍໃຫ້ທ່ານສາມາດລົງທະບຽນເຄື່ອງລູກຂ່າຍ Salt ຕົວດຽວ."

#. type: Block title
#: en/modules/reference/pages/systems/bootstrapping.adoc:3
#, no-wrap
msgid "Bootstrap Options"
msgstr "ຕົວເລືອກການບູດສະແຕຣັບ"

#. type: Table
#: en/modules/reference/pages/systems/bootstrapping.adoc:4
#, no-wrap
msgid ""
"| Option\n"
"| Description\n"
"| Default\n"
"\n"
"| Host\n"
"| The hostname of the client to be registered\n"
"| -\n"
"\n"
"| SSH port\n"
"| The port on the client that allows SSH access\n"
"| 22\n"
"\n"
"| User\n"
"| The user name to use to log in to the client\n"
"| root\n"
"\n"
"| Authentication Method\n"
"| Choose [guimenu]``Password`` for simple authentication, or "
"[guimenu]``SSH Private Key`` to use SSH authentication.\n"
"| Password\n"
"\n"
"| Password\n"
"| The password to use to log in to the client\n"
"| -\n"
"\n"
"| SSH Private Key\n"
"| Upload the SSH Private Key to use to log in to the client\n"
"| -\n"
"\n"
"| SSH Private Key Passphrase\n"
"| The passphrase for the SSH Private Key, or leave blank for no password.\n"
"| -\n"
"\n"
"| Activation Key\n"
"| The activation key to use to register the client.\n"
"Leave blank to use the universal default activation key, or select ``None`` "
"for no activation key.\n"
"| None\n"
"\n"
"| Proxy\n"
"| The proxy to which the client should be registered.\n"
"Leave blank if you are not using a proxy.\n"
"| None\n"
"\n"
"| Disable SSH strict host key checking\n"
"| Automatically adds the host key to the known hosts file\n"
"| Checked\n"
"\n"
"| Manage system completely via SSH\n"
"| Uses only the SSH contact method\n"
"| Unchecked\n"
"\n"
msgstr ""
"| ຕົວເລືອກ\n"
"| ຄຳອະທິບາຍ\n"
"| ຄ່າເລີ່ມຕົ້ນ\n"
"\n"
"| Host\n"
"| ຊື່ໂຮສຂອງເຄື່ອງລູກຂ່າຍທີ່ຈະລົງທະບຽນ\n"
"| -\n"
"\n"
"| SSH port\n"
"| ພອດໃນເຄື່ອງລູກຂ່າຍທີ່ອະນຸຍາດໃຫ້ເຂົ້າເຖິງ SSH\n"
"| 22\n"
"\n"
"| User\n"
"| ຊື່ຜູ້ໃຊ້ສຳລັບລັອກອິນເຂົ້າເຄື່ອງລູກຂ່າຍ\n"
"| root\n"
"\n"
"| Authentication Method\n"
"| ເລືອກ [guimenu]``Password`` ສຳລັບການຢັ້ງຢືນຕົວຕົນແບບງ່າຍ, ຫຼື [guimenu]``SSH Private Key`` ສຳລັບການຢັ້ງຢືນແບບ SSH.\n"
"| Password\n"
"\n"
"| Password\n"
"| ລະຫັດຜ່ານສຳລັບລັອກອິນເຂົ້າເຄື່ອງລູກຂ່າຍ\n"
"| -\n"
"\n"
"| SSH Private Key\n"
"| ອັບໂຫຼດ SSH Private Key ສຳລັບລັອກອິນເຂົ້າເຄື່ອງລູກຂ່າຍ\n"
"| -\n"
"\n"
"| SSH Private Key Passphrase\n"
"| ລະຫັດຜ່ານ (passphrase) ສຳລັບ SSH Private Key, ຫຼື ປະວ່າງໄວ້ຫາກບໍ່ມີ.\n"
"| -\n"
"\n"
"| Activation Key\n"
"| ຄີການເປີດໃຊ້ສຳລັບລົງທະບຽນເຄື່ອງລູກຂ່າຍ.\n"
"ປະວ່າງໄວ້ເພື່ອໃຊ້ຄີເລີ່ມຕົ້ນແບບສາກົນ, ຫຼື ເລືອກ ``None`` ຫາກບໍ່ໃຊ້.\n"
"| None\n"
"\n"
"| Proxy\n"
"| ພຣັອກຊີທີ່ຕ້ອງການໃຫ້ເຄື່ອງລູກຂ່າຍລົງທະບຽນຜ່ານ.\n"
"ປະວ່າງໄວ້ຫາກບໍ່ໄດ້ໃຊ້ພຣັອກຊີ.\n"
"| None\n"
"\n"
"| Disable SSH strict host key checking\n"
"| ເພີ່ມຄີຂອງໂຮສເຂົ້າໃນໄຟລ໌ known hosts ໂດຍອັດຕະໂນມັດ\n"
"| Checked (ເລືອກ)\n"
"\n"
"| Manage system completely via SSH\n"
"| ຈັດການລະບົບຜ່ານວິທີການຕິດຕໍ່ SSH ເທົ່ານັ້ນ\n"
"| Unchecked (ບໍ່ເລືອກ)\n"
"\n"

#. type: delimited block =
#: en/modules/reference/pages/systems/bootstrapping.adoc:5
msgid ""
"SSH private keys are stored only for the duration of the bootstrapping "
"process.  They are deleted from the {productname} Server as soon as "
"bootstrapping is complete."
msgstr "ກຸນແຈ SSH ສ່ວນຕົວຈະຖືກເກັບໄວ້ສະເພາະໃນລະຫວ່າງຂະບວນການ bootstrapping ເທົ່ານັ້ນ. ພວກມັນຈະຖືກລຶບອອກຈາກ {productname} Server ທັນທີທີ່ການ bootstrapping ສຳເລັດ."

#. type: Plain text
#: en/modules/reference/pages/systems/bootstrapping.adoc:6
msgid ""
"When you have completed the details of the client you want to register, "
"click btn:[Bootstrap].  When the client has completed registering, navigate "
"to menu:Systems[System List] to see details."
msgstr "ເມື່ອທ່ານປ້ອນລາຍລະອຽດຂອງເຄື່ອງລູກຂ່າຍທີ່ຕ້ອງການລົງທະບຽນຄົບຖ້ວນແລ້ວ, ໃຫ້ຄລິກ btn:[Bootstrap]. ເມື່ອການລົງທະບຽນສຳເລັດ, ໃຫ້ໄປທີ່ menu:Systems[System List] ເພື່ອເບິ່ງລາຍລະອຽດ."

#. type: Plain text
#: en/modules/reference/pages/systems/bootstrapping.adoc:7
msgid ""
"For more information about bootstrapping, see "
"xref:client-configuration:registration-webui.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບ bootstrapping, ເບິ່ງໄດ້ທີ່ xref:client-configuration:registration-webui.adoc[]."

#. type: Title =
#: en/modules/reference/pages/systems/custom-system-info.adoc:1
#, no-wrap
msgid "Custom System Information"
msgstr "ຂໍ້ມູນລະບົບທີ່ກຳນົດເອງ"

#. type: Plain text
#: en/modules/reference/pages/systems/custom-system-info.adoc:2
msgid ""
"The menu:Systems[Custom System Info] section lists the custom system "
"information available to clients in your organization."
msgstr "ພາກສ່ວນ menu:Systems[Custom System Info] ຈະສະແດງລາຍຊື່ຂໍ້ມູນລະບົບທີ່ກຳນົດເອງທີ່ມີໃຫ້ກັບເຄື່ອງລູກຂ່າຍໃນອົງກອນຂອງທ່ານ."

#. type: Plain text
#: en/modules/reference/pages/systems/custom-system-info.adoc:3
msgid ""
"Click btn:[Create Key] to create a new custom system key.  Click the key "
"label to see more information, and to edit the value."
msgstr "ຄລິກ btn:[Create Key] ເພື່ອສ້າງຄີລະບົບທີ່ກຳນົດເອງໃໝ່. ຄລິກທີ່ປ້າຍຊື່ຄີເພື່ອເບິ່ງຂໍ້ມູນເພີ່ມເຕີມ ແລະ ແກ້ໄຂຄ່າ."

#. type: Plain text
#: en/modules/reference/pages/systems/custom-system-info.adoc:4
#: en/modules/reference/pages/systems/system-details/sd-custom-info.adoc:4
msgid ""
"For more information about custom system information, see "
"xref:client-configuration:custom-info.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບຂໍ້ມູນລະບົບທີ່ກຳນົດເອງ, ເບິ່ງໄດ້ທີ່ xref:client-configuration:custom-info.adoc[]."

#. type: Title =
#: en/modules/reference/pages/systems/proxy-configuration.adoc:1
#, no-wrap
msgid "Proxy Configuration"
msgstr "ການຕັ້ງຄ່າພຣັອກຊີ"

#.  **FIXME: add details!**
#. type: Plain text
#: en/modules/reference/pages/systems/proxy-configuration.adoc:2
msgid ""
"The menu:Systems[Proxy Configuration] section allows you to configure proxy "
"clients."
msgstr "ພາກສ່ວນ menu:Systems[Proxy Configuration] ຊ່ວຍໃຫ້ທ່ານສາມາດຕັ້ງຄ່າເຄື່ອງລູກຂ່າຍພຣັອກຊີ."

#.  manage clients that you have added to the system set manager.
#. type: Title =
#: en/modules/reference/pages/systems/ssm-menu.adoc:1
#, no-wrap
msgid "System Set Manager"
msgstr "ຕົວຈັດການຊຸດລະບົບ (System Set Manager)"

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-menu.adoc:2
msgid ""
"The menu:Systems[System Set Manager] section allows you to manage clients "
"that you have added to the system set manager."
msgstr "ພາກສ່ວນ menu:Systems[System Set Manager] ຊ່ວຍໃຫ້ທ່ານສາມາດຈັດການເຄື່ອງລູກຂ່າຍທີ່ທ່ານໄດ້ເພີ່ມເຂົ້າໃນຕົວຈັດການຊຸດລະບົບ."

#. type: Title =
#: en/modules/reference/pages/systems/ssm-overview.adoc:1
#, no-wrap
msgid "System Set Manager Overview"
msgstr "ພາບລວມຕົວຈັດການຊຸດລະບົບ"

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:2
msgid ""
"The menu:Systems[System Set Manager > Overview] section allows you to manage "
"clients that you have added to the system set manager (SSM).  You can also "
"access this page by clicking the [guimenu]``systems selected`` icon in the "
"top menu bar."
msgstr "ພາກສ່ວນ menu:Systems[System Set Manager > Overview] ຊ່ວຍໃຫ້ທ່ານຈັດການເຄື່ອງລູກຂ່າຍທີ່ເພີ່ມເຂົ້າໃນຕົວຈັດການຊຸດລະບົບ (SSM). ທ່ານຍັງສາມາດເຂົ້າເຖິງໜ້ານີ້ໄດ້ໂດຍການຄລິກໄອຄອນ [guimenu]``systems selected`` ຢູ່ແຖບເມນູດ້ານເທິງ."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:3
#: en/modules/reference/pages/systems/ssm-task-log.adoc:5
msgid ""
"For more information about SSM, see "
"xref:client-configuration:system-set-manager.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບ SSM, ເບິ່ງໄດ້ທີ່ xref:client-configuration:system-set-manager.adoc[]."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:4
msgid "The menu:Systems[Systems Set Manager] menu is split into tabs:"
msgstr "ເມນູ menu:Systems[Systems Set Manager] ຖືກແບ່ງອອກເປັນແຖບຕ່າງໆ:"

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:6
msgid "This section provides quick access to all the of the SSM tabs."
msgstr "ພາກສ່ວນນີ້ຊ່ວຍໃຫ້ເຂົ້າເຖິງທຸກແຖບຂອງ SSM ໄດ້ຢ່າງວ່ອງໄວ."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:8
msgid ""
"This section lists all clients currently in the SSM.  It provides "
"information about the updates available, when thew client last checked in, "
"the registered base channel, and system type.  Click the client name to see "
"more information."
msgstr "ພາກສ່ວນນີ້ສະແດງລາຍຊື່ເຄື່ອງລູກຂ່າຍທັງໝົດທີ່ຢູ່ໃນ SSM. ມັນໃຫ້ຂໍ້ມູນກ່ຽວກັບການອັບເດດທີ່ມີ, ເວລາທີ່ເຄື່ອງລູກຂ່າຍຕິດຕໍ່ມາຫຼ້າສຸດ, ຊ່ອງທາງຫຼັກທີ່ລົງທະບຽນ ແລະ ປະເພດລະບົບ. ຄລິກທີ່ຊື່ເຄື່ອງລູກຂ່າຍເພື່ອເບິ່ງຂໍ້ມູນເພີ່ມເຕີມ."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:10
msgid ""
"This section lists all patches available for upgrade on clients currently in "
"the SSM.  Click the number in the [guimenu]``Affected`` column to see which "
"clients a patch applies to.  To perform upgrades, check the patches to apply "
"and click btn:[Apply Patches]."
msgstr "ພາກສ່ວນນີ້ສະແດງລາຍຊື່ແພັດ (patches) ທັງໝົດທີ່ມີສຳລັບການອັບເກຣດໃນເຄື່ອງລູກຂ່າຍທີ່ຢູ່ໃນ SSM. ຄລິກທີ່ຕົວເລກໃນຖັນ [guimenu]``Affected`` ເພື່ອເບິ່ງວ່າແພັດນັ້ນໃຊ້ກັບເຄື່ອງລູກຂ່າຍໃດແດ່. ເພື່ອເຮັດການອັບເກຣດ, ໃຫ້ເລືອກແພັດທີ່ຕ້ອງການແລ້ວຄລິກ btn:[Apply Patches]."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:11
msgid ""
"For more information about patch management, see "
"xref:client-configuration:patch-management.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການຈັດການແພັດ, ເບິ່ງໄດ້ທີ່ xref:client-configuration:patch-management.adoc[]."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:13
#: en/modules/reference/pages/systems/ssm-overview.adoc:26
#: en/modules/reference/pages/systems/ssm-overview.adoc:34
#: en/modules/reference/pages/systems/ssm-overview.adoc:44
msgid "This section is split into subtabs."
msgstr "ພາກສ່ວນນີ້ຖືກແບ່ງອອກເປັນແຖບຍ່ອຍ."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:14
msgid ""
"The menu:Packages[Upgrade] subtab lists all packages available for upgrade "
"on clients currently in the SSM.  To perform upgrades, check the packages to "
"upgrade and click btn:[Upgrade Selected Packages]."
msgstr "ແຖບຍ່ອຍ menu:Packages[Upgrade] ສະແດງລາຍຊື່ແພັກເກັດທັງໝົດທີ່ມີສຳລັບການອັບເກຣດໃນເຄື່ອງລູກຂ່າຍທີ່ຢູ່ໃນ SSM. ເພື່ອອັບເກຣດ, ໃຫ້ເລືອກແພັກເກັດແລ້ວຄລິກ btn:[Upgrade Selected Packages]."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:15
msgid ""
"The menu:Packages[Install] subtab allows you to install new packages on all "
"clients currently in the SSM.  To install packages, click the base channel "
"that contains the package, check the packages to install, and click "
"btn:[Install Selected Packages]."
msgstr "ແຖບຍ່ອຍ menu:Packages[Install] ຊ່ວຍໃຫ້ທ່ານຕິດຕັ້ງແພັກເກັດໃໝ່ໃນທຸກເຄື່ອງລູກຂ່າຍທີ່ຢູ່ໃນ SSM. ເພື່ອຕິດຕັ້ງ, ໃຫ້ຄລິກທີ່ຊ່ອງທາງຫຼັກທີ່ມີແພັກເກັດນັ້ນ, ເລືອກແພັກເກັດແລ້ວຄລິກ btn:[Install Selected Packages]."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:16
msgid ""
"The menu:Packages[Remove] subtab allows you to remove packages from all "
"clients currently in the SSM.  If clients in the SSM have different versions "
"of a package installed, multiple versions are available in the list.  To "
"remove packages, select the packages to remove, and click btn:[Remove "
"Selected Packages]."
msgstr "ແຖບຍ່ອຍ menu:Packages[Remove] ຊ່ວຍໃຫ້ທ່ານລຶບແພັກເກັດອອກຈາກທຸກເຄື່ອງລູກຂ່າຍໃນ SSM. ຫາກເຄື່ອງລູກຂ່າຍມີແພັກເກັດເວີຊັນທີ່ຕ່າງກັນ, ຈະມີຫຼາຍເວີຊັນສະແດງໃນລາຍຊື່. ເພື່ອລຶບແພັກເກັດ, ໃຫ້ເລືອກແລ້ວຄລິກ btn:[Remove Selected Packages]."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:17
msgid ""
"For more information about package management, see "
"xref:client-configuration:package-management.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການຈັດການແພັກເກັດ, ເບິ່ງໄດ້ທີ່ xref:client-configuration:package-management.adoc[]."

#. type: Title =
#: en/modules/reference/pages/systems/ssm-overview.adoc:18
#: en/modules/reference/pages/systems/system-details/sd-groups.adoc:1
#, no-wrap
msgid "Groups"
msgstr "ກຸ່ມ"

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:19
msgid ""
"This section lists all system groups clients currently available in your "
"organization.  Click btn:[Create Group] to create a new system group.  For "
"each group in the list, check [guimenu]``Add`` to add all clients in the SSM "
"to the group, check [guimenu]``Remove`` to remove all clients in the SSM "
"from the group, or check [guimenu]``No Change`` to leave group assignments "
"as they are.  Click btn:[Alter Membership] to change group assignments."
msgstr "ພາກສ່ວນນີ້ສະແດງລາຍຊື່ກຸ່ມລະບົບທັງໝົດທີ່ມີໃນອົງກອນຂອງທ່ານ. ຄລິກ btn:[Create Group] ເພື່ອສ້າງກຸ່ມໃໝ່. ສຳລັບແຕ່ລະກຸ່ມໃນລາຍຊື່, ເລືອກ [guimenu]``Add`` ເພື່ອເພີ່ມທຸກເຄື່ອງລູກຂ່າຍໃນ SSM ເຂົ້າໃນກຸ່ມ, ເລືອກ [guimenu]``Remove`` ເພື່ອລຶບອອກ, ຫຼື ເລືອກ [guimenu]``No Change`` ເພື່ອບໍ່ປ່ຽນແປງ. ຄລິກ btn:[Alter Membership] ເພື່ອຢືນຢັນການປ່ຽນແປງ."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:20
#: en/modules/reference/pages/systems/system-details/sd-groups.adoc:4
#: en/modules/reference/pages/systems/system-groups.adoc:7
#: en/modules/reference/pages/systems/systems-list.adoc:25
msgid ""
"For more information about system groups, see "
"xref:client-configuration:system-groups.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບກຸ່ມລະບົບ, ເບິ່ງໄດ້ທີ່ xref:client-configuration:system-groups.adoc[]."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:22
msgid ""
"This section lists all base channels clients currently subscribed to by "
"clients currently in the SSM.  You can change all clients subscribed to a "
"current base channel to a new base channel, by selecting the new base "
"channel and following the prompts."
msgstr "ພາກສ່ວນນີ້ສະແດງຊ່ອງທາງຫຼັກທັງໝົດທີ່ເຄື່ອງລູກຂ່າຍໃນ SSM ລົງທະບຽນຢູ່. ທ່ານສາມາດປ່ຽນທຸກເຄື່ອງລູກຂ່າຍຈາກຊ່ອງທາງຫຼັກປະຈຸບັນໄປເປັນຊ່ອງທາງຫຼັກໃໝ່ໄດ້ ໂດຍການເລືອກຊ່ອງທາງໃໝ່ ແລະ ເຮັດຕາມຂັ້ນຕອນ."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:24
msgid ""
"For more information about using the SSM to change base channels, see "
"xref:client-configuration:system-set-manager.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການໃຊ້ SSM ເພື່ອປ່ຽນຊ່ອງທາງຫຼັກ, ເບິ່ງໄດ້ທີ່ xref:client-configuration:system-set-manager.adoc[]."

#. type: Title =
#: en/modules/reference/pages/systems/ssm-overview.adoc:25
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:1
#, no-wrap
msgid "Configuration"
msgstr "ການຕັ້ງຄ່າ"

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:27
msgid ""
"The menu:Configuration[Deploy Files] subtab lists all configuration files "
"available for deployment.  Click the number in the [guimenu]``Systems`` "
"column to see which clients are currently subscribed to the configuration "
"file.  To assign a configuration file to the clients currently in the SSM, "
"check the configuration file, and click btn:[Schedule File Deploy]."
msgstr "ແຖບຍ່ອຍ menu:Configuration[Deploy Files] ສະແດງລາຍຊື່ໄຟລ໌ການຕັ້ງຄ່າທັງໝົດທີ່ມີສຳລັບການນຳໃຊ້ (deployment). ຄລິກທີ່ຕົວເລກໃນຖັນ [guimenu]``Systems`` ເພື່ອເບິ່ງວ່າມີເຄື່ອງລູກຂ່າຍໃດແດ່ທີ່ໃຊ້ໄຟລ໌ນັ້ນ. ເພື່ອນຳໃຊ້ໄຟລ໌ການຕັ້ງຄ່າໃຫ້ກັບເຄື່ອງລູກຂ່າຍໃນ SSM, ໃຫ້ເລືອກໄຟລ໌ແລ້ວຄລິກ btn:[Schedule File Deploy]."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:28
msgid ""
"The menu:Configuration[Compare Files] subtab lists all configuration files "
"available for comparison.  This compares the configuration file deployed on "
"a client with the configuration file stored on the {productname} Server.  "
"Click the number in the [guimenu]``Systems`` column to see which clients are "
"currently subscribed to the configuration file.  To compare configuration "
"files, check the configuration files to compare, and click btn:[Schedule "
"File Comparison]."
msgstr "ແຖບຍ່ອຍ menu:Configuration[Compare Files] ສະແດງລາຍຊື່ໄຟລ໌ການຕັ້ງຄ່າທັງໝົດທີ່ມີສຳລັບການປຽບທຽບ. ນີ້ແມ່ນການປຽບທຽບໄຟລ໌ທີ່ຢູ່ໃນເຄື່ອງລູກຂ່າຍກັບໄຟລ໌ທີ່ເກັບໄວ້ໃນ {productname} Server. ຄລິກທີ່ຕົວເລກໃນຖັນ [guimenu]``Systems`` ເພື່ອເບິ່ງເຄື່ອງລູກຂ່າຍທີ່ກ່ຽວຂ້ອງ. ເພື່ອປຽບທຽບ, ໃຫ້ເລືອກໄຟລ໌ແລ້ວຄລິກ btn:[Schedule File Comparison]."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:29
msgid ""
"The menu:Configuration[Subscribe to Channels] subtab lists all configuration "
"channels available for subscription.  To subscribe the clients in the SSM to "
"a new configuration channel, check the configuration channel, click "
"btn:[Continue], and follow the prompts."
msgstr "ແຖບຍ່ອຍ menu:Configuration[Subscribe to Channels] ສະແດງລາຍຊື່ຊ່ອງທາງການຕັ້ງຄ່າທັງໝົດທີ່ມີໃຫ້ລົງທະບຽນ. ເພື່ອໃຫ້ເຄື່ອງລູກຂ່າຍໃນ SSM ລົງທະບຽນຊ່ອງທາງການຕັ້ງຄ່າໃໝ່, ໃຫ້ເລືອກຊ່ອງທາງແລ້ວຄລິກ btn:[Continue]."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:30
msgid ""
"The menu:Configuration[Unsubscribe from Channels] subtab lists all "
"configuration channels clients in the SSM are currently subscribed to.  To "
"unsubscribe the clients in the SSM from a configuration channel, check the "
"configuration channel and click btn:[Unsubscribe Systems]."
msgstr "ແຖບຍ່ອຍ menu:Configuration[Unsubscribe from Channels] ສະແດງລາຍຊື່ຊ່ອງທາງການຕັ້ງຄ່າທີ່ເຄື່ອງລູກຂ່າຍໃນ SSM ລົງທະບຽນຢູ່ປະຈຸບັນ. ເພື່ອຍົກເລີກການລົງທະບຽນ, ໃຫ້ເລືອກຊ່ອງທາງແລ້ວຄລິກ btn:[Unsubscribe Systems]."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:31
msgid ""
"The menu:Configuration[Enable Configuration] subtab lists clients in the SSM "
"that are capable of using configuration management, but have not yet been "
"enabled.  To enable clients in the SSM to use configuration management, "
"check the client and click btn:[Enable Configuration Management]."
msgstr "ແຖບຍ່ອຍ menu:Configuration[Enable Configuration] ສະແດງລາຍຊື່ເຄື່ອງລູກຂ່າຍໃນ SSM ທີ່ຮອງຮັບການຈັດການການຕັ້ງຄ່າ ແຕ່ຍັງບໍ່ທັນໄດ້ເປີດໃຊ້ງານ. ເພື່ອເປີດໃຊ້, ໃຫ້ເລືອກເຄື່ອງລູກຂ່າຍແລ້ວຄລິກ btn:[Enable Configuration Management]."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:32
msgid ""
"For more information about configuration management, see "
"xref:client-configuration:configuration-management.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການຈັດການການຕັ້ງຄ່າ (configuration management), ເບິ່ງໄດ້ທີ່ xref:client-configuration:configuration-management.adoc[]."

#. type: Title =
#: en/modules/reference/pages/systems/ssm-overview.adoc:33
#: en/modules/reference/pages/systems/system-details/sd-provisioning.adoc:1
#, no-wrap
msgid "Provisioning"
msgstr "ການຈັດກຽມລະບົບ (Provisioning)"

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:35
msgid ""
"The menu:Provisioning[Autoinstallation] subtab lists all clients in the SSM "
"available for autoinstallation, with their base channel.  To schedule "
"autoinstallation, select an autoinstallable type, click btn:[Continue] and "
"follow the prompts."
msgstr "ແຖບຍ່ອຍ menu:Provisioning[Autoinstallation] ສະແດງລາຍຊື່ເຄື່ອງລູກຂ່າຍໃນ SSM ທີ່ສາມາດຕິດຕັ້ງອັດຕະໂນມັດໄດ້. ເພື່ອກຳນົດເວລາການຕິດຕັ້ງ, ໃຫ້ເລືອກປະເພດການຕິດຕັ້ງ, ຄລິກ btn:[Continue] ແລະ ເຮັດຕາມຂັ້ນຕອນ."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:36
msgid ""
"The menu:Provisioning[Power Management Configuration] subtab allows you to "
"configure power management for the clients in the SSM.  For more information "
"about power management, see "
"xref:client-configuration:power-management.adoc[]."
msgstr "ແຖບຍ່ອຍ menu:Provisioning[Power Management Configuration] ຊ່ວຍໃຫ້ທ່ານຕັ້ງຄ່າການຈັດການພະລັງງານສຳລັບເຄື່ອງລູກຂ່າຍໃນ SSM. ເບິ່ງຂໍ້ມູນເພີ່ມເຕີມໄດ້ທີ່ xref:client-configuration:power-management.adoc[]."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:37
msgid ""
"The menu:Provisioning[Power Operations] subtab allows you to power on, power "
"off, or reboot the clients in the SSM.  For more information about power "
"management, see xref:client-configuration:power-management.adoc[]."
msgstr "ແຖບຍ່ອຍ menu:Provisioning[Power Operations] ຊ່ວຍໃຫ້ທ່ານສາມາດເປີດ, ປິດ ຫຼື ເລີ່ມລະບົບໃໝ່ (reboot) ເຄື່ອງລູກຂ່າຍໃນ SSM ໄດ້. ເບິ່ງຂໍ້ມູນເພີ່ມເຕີມໄດ້ທີ່ xref:client-configuration:power-management.adoc[]."

#. type: Title =
#: en/modules/reference/pages/systems/ssm-overview.adoc:39
#: en/modules/reference/pages/systems/system-details/sd-states.adoc:1
#, no-wrap
msgid "States"
msgstr "ສະເຕດ (States)"

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:40
msgid ""
"For Salt clients, the menu:States[Highstate] subtab allows you to apply the "
"highstate to all clients in the SSM."
msgstr "ສຳລັບເຄື່ອງລູກຂ່າຍ Salt, ແຖບຍ່ອຍ menu:States[Highstate] ຊ່ວຍໃຫ້ທ່ານສາມາດນຳໃຊ້ highstate ກັບທຸກເຄື່ອງລູກຂ່າຍໃນ SSM."

#. type: Title =
#: en/modules/reference/pages/systems/ssm-overview.adoc:41
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:1
#, no-wrap
msgid "Audit"
msgstr "ການກວດສອບ (Audit)"

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:42
msgid ""
"For more information about auditing, see "
"xref:administration:auditing.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການກວດສອບ, ເບິ່ງໄດ້ທີ່ xref:administration:auditing.adoc[]."

#. type: Title ==
#: en/modules/reference/pages/systems/ssm-overview.adoc:43
#, no-wrap
msgid "Misc"
msgstr "ອື່ນໆ (Misc)"

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:45
msgid ""
"The menu:Misc[Preferences] subtab allows you to configure the custom "
"information, system types, and system preferences for the clients in the "
"SSM."
msgstr "ແຖບຍ່ອຍ menu:Misc[Preferences] ຊ່ວຍໃຫ້ທ່ານຕັ້ງຄ່າຂໍ້ມູນທີ່ກຳນົດເອງ, ປະເພດລະບົບ ແລະ ການຕັ້ງຄ່າລະບົບສຳລັບເຄື່ອງລູກຂ່າຍໃນ SSM."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:46
msgid ""
"The menu:Misc[Hardware] subtab allows you to schedule a hardware profile "
"refresh for the clients in the SSM."
msgstr "ແຖບຍ່ອຍ menu:Misc[Hardware] ຊ່ວຍໃຫ້ທ່ານກຳນົດເວລາໃນການອັບເດດຂໍ້ມູນຮາດແວສຳລັບເຄື່ອງລູກຂ່າຍໃນ SSM."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:47
msgid ""
"The menu:Misc[Software] subtab allows you to schedule a package profile "
"refresh for the clients in the SSM."
msgstr "ແຖບຍ່ອຍ menu:Misc[Software] ຊ່ວຍໃຫ້ທ່ານກຳນົດເວລາໃນການອັບເດດຂໍ້ມູນແພັກເກັດຊອບແວສຳລັບເຄື່ອງລູກຂ່າຍໃນ SSM."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:48
msgid ""
"The menu:Misc[Remote Command] subtab allows you to schedule a remote command "
"to be executed on the clients in the SSM."
msgstr "ແຖບຍ່ອຍ menu:Misc[Remote Command] ຊ່ວຍໃຫ້ທ່ານກຳນົດເວລາໃນການສັ່ງລັນຄຳສັ່ງທາງໄກໃນເຄື່ອງລູກຂ່າຍໃນ SSM."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:49
msgid ""
"The menu:Misc[Custom Values] subtab allows you to set or remove custom key "
"values for the clients in the SSM."
msgstr "ແຖບຍ່ອຍ menu:Misc[Custom Values] ຊ່ວຍໃຫ້ທ່ານກຳນົດ ຫຼື ລຶບຄ່າຄີທີ່ກຳນົດເອງສຳລັບເຄື່ອງລູກຂ່າຍໃນ SSM."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:50
msgid ""
"The menu:Misc[Reboot] subtab allows you to schedule a reboot for the clients "
"in the SSM."
msgstr "ແຖບຍ່ອຍ menu:Misc[Reboot] ຊ່ວຍໃຫ້ທ່ານກຳນົດເວລາເລີ່ມລະບົບໃໝ່ສຳລັບເຄື່ອງລູກຂ່າຍໃນ SSM."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:51
msgid ""
"The menu:Misc[Transfer] subtab allows you to move clients in the SSM to a "
"new organization."
msgstr "ແຖບຍ່ອຍ menu:Misc[Transfer] ຊ່ວຍໃຫ້ທ່ານຍ້າຍເຄື່ອງລູກຂ່າຍໃນ SSM ໄປຍັງອົງກອນໃໝ່."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-overview.adoc:52
msgid ""
"The menu:Misc[Delete] subtab allows you to delete the system profiles of "
"clients in the SSM."
msgstr "ແຖບຍ່ອຍ menu:Misc[Delete] ຊ່ວຍໃຫ້ທ່ານລຶບໂປຣໄຟລ໌ລະບົບຂອງເຄື່ອງລູກຂ່າຍໃນ SSM."

#. type: Title =
#: en/modules/reference/pages/systems/ssm-task-log.adoc:1
#, no-wrap
msgid "System Set Manager Task Log"
msgstr "ບັນທຶກກິດຈະກຳຂອງຕົວຈັດການຊຸດລະບົບ"

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-task-log.adoc:2
msgid ""
"The menu:Systems[System Set Manager > Task Log] section shows all actions "
"applied to clients that you have added to the system set manager (SSM).  The "
"SSM Task Log lists all actions performed against clients currently in SSM.  "
"Click an entry to see more information about the action."
msgstr "ພາກສ່ວນ menu:Systems[System Set Manager > Task Log] ສະແດງການດຳເນີນການທັງໝົດທີ່ໃຊ້ກັບເຄື່ອງລູກຂ່າຍໃນ SSM. ມັນຈະລາຍງານທຸກກິດຈະກຳທີ່ຜ່ານມາ; ຄລິກທີ່ລາຍການໃດໜຶ່ງເພື່ອເບິ່ງລາຍລະອຽດ."

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-task-log.adoc:3
msgid "This section is divided into tabs:"
msgstr "ພາກສ່ວນນີ້ຖືກແບ່ງອອກເປັນແຖບຕ່າງໆ:"

#. type: Plain text
#: en/modules/reference/pages/systems/ssm-task-log.adoc:4
msgid ""
"The [guimenu]``All`` tab lists all actions that have been performed.  The "
"[guimenu]``In Progress`` tab lists all actions that are currently in "
"progress.  The [guimenu]``Completed`` tab lists all actions that have been "
"completed."
msgstr "ແຖບ [guimenu]``All`` ສະແດງທຸກການດຳເນີນການ. ແຖບ [guimenu]``In Progress`` ສະແດງການດຳເນີນການທີ່ກຳລັງເຮັດຢູ່. ແຖບ [guimenu]``Completed`` ສະແດງການດຳເນີນການທີ່ສຳເລັດແລ້ວ."

#. type: Title =
#: en/modules/reference/pages/systems/stored-profiles.adoc:1
#, no-wrap
msgid "Stored Profiles"
msgstr "ໂປຣໄຟລ໌ທີ່ເກັບໄວ້"

#. type: Plain text
#: en/modules/reference/pages/systems/stored-profiles.adoc:2
msgid ""
"The menu:Systems[Stored Profiles] section lists the stored profiles for your "
"organization.  Profiles can be used to compare packages installed on "
"clients."
msgstr "ພາກສ່ວນ menu:Systems[Stored Profiles] ສະແດງລາຍຊື່ໂປຣໄຟລ໌ທີ່ເກັບໄວ້ສຳລັບອົງກອນຂອງທ່ານ. ໂປຣໄຟລ໌ເຫຼົ່ານີ້ສາມາດໃຊ້ເພື່ອປຽບທຽບແພັກເກັດທີ່ຕິດຕັ້ງໃນເຄື່ອງລູກຂ່າຍ."

#. type: Plain text
#: en/modules/reference/pages/systems/stored-profiles.adoc:3
msgid ""
"Click the name of a profile to see more information about the packages in "
"the profile, or to edit the name or description."
msgstr "ຄລິກທີ່ຊື່ໂປຣໄຟລ໌ເພື່ອເບິ່ງຂໍ້ມູນແພັກເກັດພາຍໃນ ຫຼື ແກ້ໄຂຊື່ ແລະ ຄຳອະທິບາຍ."

#. type: Plain text
#: en/modules/reference/pages/systems/stored-profiles.adoc:4
msgid ""
"For more information about using profiles to compare packages, see "
"xref:client-configuration:package-management.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການໃຊ້ໂປຣໄຟລ໌ເພື່ອປຽບທຽບແພັກເກັດ, ເບິ່ງໄດ້ທີ່ xref:client-configuration:package-management.adoc[]."

#. type: Title =
#: en/modules/reference/pages/systems/system-details/sd-ansible.adoc:1
#, no-wrap
msgid "Ansible"
msgstr "Ansible"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-ansible.adoc:2
msgid ""
"The menu:System Details[Ansible] tab allows you to use the Ansible features "
"on the Control Node system."
msgstr "ແຖບ menu:System Details[Ansible] ຊ່ວຍໃຫ້ທ່ານສາມາດໃຊ້ຄຸນສົມບັດ Ansible ໃນລະບົບ Control Node."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-ansible.adoc:3
msgid "The tab is split into the following subtabs:"
msgstr "ແຖບນີ້ຖືກແບ່ງອອກເປັນແຖບຍ່ອຍດັ່ງນີ້:"

#. type: Labeled list
#: en/modules/reference/pages/systems/system-details/sd-ansible.adoc:4
#, no-wrap
msgid "Control Node"
msgstr "Control Node"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-ansible.adoc:5
msgid ""
"Fields for defining playbook directories and paths to inventory files on "
"your Ansible Control Node."
msgstr "ຊ່ອງຂໍ້ມູນສຳລັບກຳນົດໄດເຣັກທໍຣີ playbook ແລະ ເສັ້ນທາງ (paths) ໄປຫາໄຟລ໌ inventory ໃນ Ansible Control Node ຂອງທ່ານ."

#. type: Labeled list
#: en/modules/reference/pages/systems/system-details/sd-ansible.adoc:6
#, no-wrap
msgid "Playbooks"
msgstr "Playbooks"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-ansible.adoc:7
msgid ""
"Lists all playbooks in the defined paths.  You can click a playbook to "
"display its details or to schedule its execution."
msgstr "ສະແດງລາຍຊື່ playbooks ທັງໝົດໃນເສັ້ນທາງທີ່ກຳນົດ. ທ່ານສາມາດຄລິກທີ່ playbook ເພື່ອເບິ່ງລາຍລະອຽດ ຫຼື ກຳນົດເວລາໃນການລັນມັນ."

#. type: Labeled list
#: en/modules/reference/pages/systems/system-details/sd-ansible.adoc:8
#, no-wrap
msgid "Inventories"
msgstr "Inventories"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-ansible.adoc:9
msgid ""
"Lists all inventory files in the defined paths.  Clicking an inventory file "
"in the list introspects its contents."
msgstr "ສະແດງລາຍຊື່ໄຟລ໌ inventory ທັງໝົດໃນເສັ້ນທາງທີ່ກຳນົດ. ຄລິກທີ່ໄຟລ໌ inventory ເພື່ອເບິ່ງເນື້ອໃນພາຍໃນ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-ansible.adoc:10
msgid "For more information, see xref:administration:ansible-integration.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມ, ເບິ່ງໄດ້ທີ່ xref:administration:ansible-integration.adoc[]."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-appstreams.adoc:2
msgid ""
"The menu:Systems[Software > AppStreams] section allows you to manage the "
"list of enabled AppStream modules on the selected client."
msgstr "ພາກສ່ວນ menu:Systems[Software > AppStreams] ຊ່ວຍໃຫ້ທ່ານຈັດການລາຍຊື່ໂມດູນ AppStream ທີ່ເປີດໃຊ້ງານໃນເຄື່ອງລູກຂ່າຍທີ່ເລືອກ."

#. type: delimited block =
#: en/modules/reference/pages/systems/system-details/sd-appstreams.adoc:3
msgid ""
"The menu:Systems[Software > AppStreams] tab is only available if the client "
"has any AppStream channels assigned."
msgstr "ແຖບ menu:Systems[Software > AppStreams] ຈະສະແດງໃຫ້ເຫັນກໍຕໍ່ເມື່ອເຄື່ອງລູກຂ່າຍມີຊ່ອງທາງ AppStream ຖືກກຳນົດໃຫ້ເທົ່ານັ້ນ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-appstreams.adoc:4
msgid ""
"The page lists all the AppStream modules that are currently available to the "
"client.  After modifying the selection of enabled modules, click btn:[Apply "
"Changes] to schedule an action to update the selection on the client."
msgstr "ໜ້ານີ້ສະແດງໂມດູນ AppStream ທັງໝົດທີ່ມີໃຫ້ເຄື່ອງລູກຂ່າຍ. ຫຼັງຈາກປັບປ່ຽນການເລືອກໂມດູນແລ້ວ, ໃຫ້ຄລິກ btn:[Apply Changes] ເພື່ອກຳນົດເວລາໃນການອັບເດດການປ່ຽນແປງໃນເຄື່ອງລູກຂ່າຍ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-appstreams.adoc:5
msgid ""
"For more information about managing AppStreams on a client, see "
"xref:client-configuration:appstreams.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການຈັດການ AppStreams ໃນເຄື່ອງລູກຂ່າຍ, ເບິ່ງໄດ້ທີ່ xref:client-configuration:appstreams.adoc[]."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:2
msgid ""
"The menu:Systems[Audit] section displays the results of OpenSCAP scans that "
"you have performed on the selected client."
msgstr "ພາກສ່ວນ menu:Systems[Audit] ສະແດງຜົນການສະແກນ OpenSCAP ທີ່ທ່ານໄດ້ເຮັດໃນເຄື່ອງລູກຂ່າຍທີ່ເລືອກ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:5
msgid "The menu:Systems[Audit] subtab is split into sections:"
msgstr "ແຖບຍ່ອຍ menu:Systems[Audit] ຖືກແບ່ງອອກເປັນພາກສ່ວນຕ່າງໆ:"

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:6
#, no-wrap
msgid "List scans"
msgstr "ລາຍຊື່ການສະແກນ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:7
msgid ""
"This section displays ther results of openSCAP scans that have been "
"performed on the selected client."
msgstr "ພາກສ່ວນນີ້ສະແດງຜົນການສະແກນ OpenSCAP ທີ່ໄດ້ເຮັດຜ່ານມາໃນເຄື່ອງລູກຂ່າຍທີ່ເລືອກ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:8
msgid "The table columns on this page are:"
msgstr "ຖັນຂອງຕາຕະລາງໃນໜ້ານີ້ປະກອບມີ:"

#. type: Block title
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:9
#, no-wrap
msgid "OpenSCAP Scan Results"
msgstr "ຜົນການສະແກນ OpenSCAP"

#. type: Table
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:10
#, no-wrap
msgid ""
"| Name              | Description\n"
"| Xccdf Test Result | The name of the test result\n"
"| Diff              | FIXME\n"
"| Completed         | The time that the scan was completed\n"
"| Compliance        | The unweighted pass/fail ratio\n"
"| P                 | The number of checks that passed\n"
"| F                 | The number of checks that failed\n"
"| E                 | The number of errors that occurred\n"
"| U                 | The number of checks with an unknown status\n"
"| N                 | The number of checks that were not applicable to the "
"selected client\n"
"| K                 | The number of checks not run\n"
"| S                 | The number of checks that were not selected\n"
"| I                 | The number of checks that have information available "
"for review\n"
"| X                 | The number of checks that reported a status of fixed\n"
"| Total             | The total number of checks run\n"
msgstr ""
"| ຊື່ | ຄຳອະທິບາຍ\n"
"| Xccdf Test Result | ຊື່ຂອງຜົນການທົດສອບ\n"
"| Diff | FIXME\n"
"| Completed | ເວລາທີ່ການສະແກນສຳເລັດ\n"
"| Compliance | ອັດຕາສ່ວນການຜ່ານ/ບໍ່ຜ່ານ (Compliance)\n"
"| P | ຈຳນວນການກວດສອບທີ່ຜ່ານ\n"
"| F | ຈຳນວນການກວດສອບທີ່ບໍ່ຜ່ານ\n"
"| E | ຈຳນວນຂໍ້ຜິດພາດທີ່ເກີດຂຶ້ນ\n"
"| U | ຈຳນວນການກວດສອບທີ່ມີສະຖານະບໍ່ຊັດເຈນ\n"
"| N | ຈຳນວນການກວດສອບທີ່ບໍ່ກ່ຽວຂ້ອງກັບເຄື່ອງລູກຂ່າຍນີ້\n"
"| K | ຈຳນວນການກວດສອບທີ່ບໍ່ໄດ້ລັນ\n"
"| S | ຈຳນວນການກວດສອບທີ່ບໍ່ໄດ້ຖືກເລືອກ\n"
"| I | ຈຳນວນການກວດສອບທີ່ມີຂໍ້ມູນໃຫ້ກວດສອບຄືນ\n"
"| X | ຈຳນວນການກວດສອບທີ່ມີສະຖານະວ່າໄດ້ແກ້ໄຂແລ້ວ (fixed)\n"
"| Total | ຈຳນວນການກວດສອບທັງໝົດທີ່ລັນ\n"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:11
msgid "Click the name of a scan test result to see details about the result."
msgstr "ຄລິກທີ່ຊື່ຜົນການທົດສອບເພື່ອເບິ່ງລາຍລະອຽດ."

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:12
#, no-wrap
msgid "Rule result detail"
msgstr "ລາຍລະອຽດຜົນຂອງກົດ (Rule)"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:13
msgid ""
"The [guimenu]``Details of Rule Result`` page displays detailed information "
"about a specific XCCDF rule evaluation result and provides remediation "
"capabilities.  This page is accessed by clicking a rule in the XCCDF scan "
"results."
msgstr "ໜ້າ [guimenu]``Details of Rule Result`` ສະແດງຂໍ້ມູນລະອຽດກ່ຽວກັບຜົນການປະເມີນກົດ XCCDF ສະເພາະໃດໜຶ່ງ ແລະ ໃຫ້ຄວາມສາມາດໃນການແກ້ໄຂ (remediation). ເຂົ້າເຖິງໜ້ານີ້ໄດ້ໂດຍການຄລິກທີ່ກົດໃດໜຶ່ງໃນຜົນການສະແກນ XCCDF."

#. type: Title ===
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:14
#, no-wrap
msgid "Rule information"
msgstr "ຂໍ້ມູນຂອງກົດ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:15
msgid "The top of the page displays the following details about the rule result:"
msgstr "ສ່ວນເທິງຂອງໜ້າຈະສະແດງລາຍລະອຽດຕໍ່ໄປນີ້ກ່ຽວກັບຜົນຂອງກົດ:"

#. type: Block title
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:16
#, no-wrap
msgid "Rule Result Details"
msgstr "ລາຍລະອຽດຜົນຂອງກົດ"

#. type: Table
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:17
#, no-wrap
msgid ""
"| Field                      | Description\n"
"| Reference within Document  | The unique identifier of the rule within the "
"SCAP document.\n"
"| Evaluation Result          | The outcome of the rule evaluation (for "
"example: ``pass``, ``fail``, ``notselected``).\n"
"| Parent Scan                | A link back to the parent XCCDF scan result "
"that contains this rule.\n"
msgstr ""
"| ຊ່ອງຂໍ້ມູນ | ຄຳອະທິບາຍ\n"
"| Reference within Document | ຕົວລະບຸສະເພາະ (ID) ຂອງກົດພາຍໃນເອກະສານ SCAP.\n"
"| Evaluation Result | ຜົນຂອງການປະເມີນກົດ (ຕົວຢ່າງ: ``pass``, ``fail``, ``notselected``).\n"
"| Parent Scan | ລິ້ງກັບຄືນໄປຫາຜົນການສະແກນ XCCDF ຫຼັກທີ່ມີກົດນີ້.\n"

#. type: Title ===
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:18
#, no-wrap
msgid "Remediation"
msgstr "ການແກ້ໄຂ (Remediation)"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:19
msgid "The remediation panel provides two tabs for managing remediation scripts:"
msgstr "ແຜງການແກ້ໄຂມີສອງແຖບສຳລັບຈັດການສະຄຣິບແກ້ໄຂ:"

#. type: Title ====
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:20
#, no-wrap
msgid "Original tab"
msgstr "ແຖບຕົ້ນສະບັບ (Original)"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:21
msgid ""
"Displays the original remediation script from the SCAP datastream in a "
"read-only code editor.  This is the remediation provided by the benchmark "
"author and cannot be modified."
msgstr "ສະແດງສະຄຣິບແກ້ໄຂຕົ້ນສະບັບຈາກ SCAP datastream ໃນຮູບແບບອ່ານໄດ້ຢ່າງດຽວ. ນີ້ແມ່ນການແກ້ໄຂທີ່ຜູ້ຂຽນ benchmark ກຳນົດມາ ແລະ ບໍ່ສາມາດແກ້ໄຂໄດ້."

#. type: Title ====
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:22
#, no-wrap
msgid "Custom tab"
msgstr "ແຖບກຳນົດເອງ (Custom)"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:23
msgid ""
"Allows you to write and save custom remediation scripts for this rule.  "
"Custom remediations can be written in two script types:"
msgstr "ຊ່ວຍໃຫ້ທ່ານສາມາດຂຽນ ແລະ ບັນທຶກສະຄຣິບແກ້ໄຂເອງສຳລັບກົດນີ້. ການແກ້ໄຂແບບກຳນົດເອງສາມາດຂຽນໄດ້ໃນສອງປະເພດ:"

#. type: Block title
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:24
#, no-wrap
msgid "Script Types"
msgstr "ປະເພດສະຄຣິບ"

#. type: Table
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:25
#, no-wrap
msgid ""
"| Script Type  | Description\n"
"| Bash Script  | A shell script to remediate the rule.\n"
"| Salt State   | A Salt state in YAML format to remediate the rule.\n"
msgstr ""
"| ປະເພດສະຄຣິບ | ຄຳອະທິບາຍ\n"
"| Bash Script | ເຊລສະຄຣິບ (Shell script) ເພື່ອແກ້ໄຂຕາມກົດ.\n"
"| Salt State | Salt state ໃນຮູບແບບ YAML ເພື່ອແກ້ໄຂຕາມກົດ.\n"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:26
msgid ""
"You can maintain separate Bash and Salt remediations for the same rule by "
"switching between script types using the btn:[Script Type] dropdown."
msgstr "ທ່ານສາມາດແຍກການແກ້ໄຂແບບ Bash ແລະ Salt ສຳລັບກົດດຽວກັນໄດ້ ໂດຍການປ່ຽນປະເພດສະຄຣິບຢູ່ທີ່ປຸ່ມ btn:[Script Type]."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:27
msgid "The following actions are available in the Custom tab:"
msgstr "ການດຳເນີນການຕໍ່ໄປນີ້ມີໃຫ້ໃນແຖບ Custom:"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:28
msgid "Click btn:[Save Custom Remediation] to save the custom remediation script."
msgstr "ຄລິກ btn:[Save Custom Remediation] ເພື່ອບັນທຶກສະຄຣິບແກ້ໄຂທີ່ກຳນົດເອງ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:29
msgid ""
"Click btn:[Delete Custom Remediation] to remove the saved custom remediation "
"for the current script type.  A confirmation dialog is displayed before "
"deletion."
msgstr "ຄລິກ btn:[Delete Custom Remediation] ເພື່ອລຶບການແກ້ໄຂທີ່ບັນທຶກໄວ້. ລະບົບຈະຖາມເພື່ອຢືນຢັນກ່ອນການລຶບ."

#. type: Title ===
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:30
#, no-wrap
msgid "Applying remediation"
msgstr "ການນຳໃຊ້ການແກ້ໄຂ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:31
msgid "To apply a remediation:"
msgstr "ວິທີນຳໃຊ້ການແກ້ໄຂ:"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:32
msgid "Select the appropriate tab ([guimenu]``Original`` or [guimenu]``Custom``)."
msgstr "ເລືອກແຖບທີ່ຕ້ອງການ ([guimenu]``Original`` ຫຼື [guimenu]``Custom``)."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:33
msgid ""
"Use the [guimenu]``Schedule`` section to select the date and time for the "
"remediation action."
msgstr "ໃຊ້ພາກສ່ວນ [guimenu]``Schedule`` ເພື່ອເລືອກວັນທີ ແລະ ເວລາທີ່ຈະດຳເນີນການແກ້ໄຂ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:34
msgid ""
"Click btn:[Apply Remediation] to schedule the remediation.  A confirmation "
"dialog is displayed before the action is scheduled."
msgstr "ຄລິກ btn:[Apply Remediation] ເພື່ອກຳນົດເວລາການແກ້ໄຂ. ລະບົບຈະຖາມເພື່ອຢືນຢັນກ່ອນ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:35
msgid ""
"After scheduling, a link to the scheduled action is displayed at the top of "
"the page."
msgstr "ຫຼັງຈາກກຳນົດເວລາແລ້ວ, ຈະມີລິ້ງໄປຫາການດຳເນີນການນັ້ນສະແດງຢູ່ສ່ວນເທິງຂອງໜ້າ."

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:36
#, no-wrap
msgid "Schedule"
msgstr "ກຳນົດເວລາ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:37
msgid ""
"The [guimenu]``Schedule New XCCDF Scan`` panel allows you to schedule a "
"compliance scan on one or more systems.  You can either select a predefined "
"SCAP policy or manually configure the scan parameters."
msgstr "ແຜງ [guimenu]``Schedule New XCCDF Scan`` ຊ່ວຍໃຫ້ທ່ານກຳນົດເວລາການສະແກນຄວາມສອດຄ່ອງ (compliance scan) ໃນໜຶ່ງລະບົບ ຫຼື ຫຼາຍລະບົບ. ທ່ານສາມາດເລືອກນະໂຍບາຍ SCAP ທີ່ມີຢູ່ແລ້ວ ຫຼື ຕັ້ງຄ່າດ້ວຍຕົນເອງ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:38
msgid "This form is available from:"
msgstr "ແບບຟອມນີ້ສາມາດເຂົ້າເຖິງໄດ້ຈາກ:"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:39
msgid "A single system: menu:Systems[System Details > Audit > Schedule]"
msgstr "ລະບົບດຽວ: menu:Systems[System Details > Audit > Schedule]"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:40
msgid ""
"Multiple systems via SSM: menu:Systems[System Set Manager > Audit > "
"Schedule]"
msgstr "ຫຼາຍລະບົບຜ່ານ SSM: menu:Systems[System Set Manager > Audit > Schedule]"

#. type: Title ===
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:41
#, no-wrap
msgid "Using a SCAP policy"
msgstr "ການໃຊ້ນະໂຍບາຍ SCAP"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:42
msgid ""
"Select a policy from the btn:[SCAP Policy] dropdown to automatically "
"populate the scan configuration from the policy definition.  When a policy "
"is selected, the SCAP Content, XCCDF Profile, Tailoring File, Tailoring "
"Profile, and Fetch Remote Content fields are disabled and pre-filled with "
"the policy values."
msgstr "ເລືອກນະໂຍບາຍຈາກເມນູ btn:[SCAP Policy] ເພື່ອດຶງການຕັ້ງຄ່າຈາກນະໂຍບາຍນັ້ນໂດຍອັດຕະໂນມັດ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:43
msgid ""
"To clear the policy selection and configure the scan manually, clear the "
"btn:[SCAP Policy] dropdown."
msgstr "ຫາກຕ້ອງການຕັ້ງຄ່າດ້ວຍຕົນເອງ, ໃຫ້ເລືອກເປັນຄ່າວ່າງໃນເມນູ btn:[SCAP Policy]."

#. type: Title ===
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:44
#, no-wrap
msgid "Manual configuration"
msgstr "ການຕັ້ງຄ່າດ້ວຍຕົນເອງ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:45
msgid ""
"If no policy is selected, you can manually configure the scan using the "
"fields below."
msgstr "ຫາກບໍ່ໄດ້ເລືອກນະໂຍບາຍ, ທ່ານສາມາດຕັ້ງຄ່າການສະແກນເອງໄດ້ໂດຍໃຊ້ຊ່ອງຂໍ້ມູນລຸ່ມນີ້."

#. type: Block title
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:46
#, no-wrap
msgid "Schedule SCAP Scan Fields"
msgstr "ຊ່ອງຂໍ້ມູນການກຳນົດເວລາສະແກນ SCAP"

#. type: Table
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:47
#, no-wrap
msgid ""
"| Field                      | Required | Description\n"
"| SCAP Policy                | No       | Optionally select a predefined "
"compliance policy to auto-populate the scan configuration.\n"
"| SCAP Content               | Yes      | Select a SCAP content file "
"containing the security benchmarks.\n"
"| XCCDF Profile              | Yes      | Select an XCCDF profile from the "
"chosen SCAP content.\n"
"| Tailoring File             | No       | Optionally select a tailoring file "
"to customize the profile.\n"
"| Profile from Tailoring File | No       | Select a profile from the chosen "
"tailoring file.\n"
"| Advanced Arguments         | No       | Additional command-line arguments, "
"for example: ``--rule <rule_id> --remediate``.\n"
"| OVAL Files                 | No       | Paths to local OVAL definitions on "
"the target system, comma separated.\n"
"| Fetch Remote Content       | No       | Enable fetching of remote "
"resources during the scan. This requires internet access and significant "
"memory on the target system.\n"
msgstr ""
"| ຊ່ອງຂໍ້ມູນ | ຈຳເປັນ | ຄຳອະທິບາຍ\n"
"| SCAP Policy | ບໍ່ | ເລືອກນະໂຍບາຍທີ່ມີຢູ່ແລ້ວ (ຖ້າມີ).\n"
"| SCAP Content | ແມ່ນ | ເລືອກໄຟລ໌ເນື້ອໃນ SCAP ທີ່ມີ security benchmarks.\n"
"| XCCDF Profile | ແມ່ນ | ເລືອກໂປຣໄຟລ໌ XCCDF ຈາກເນື້ອໃນ SCAP ທີ່ເລືອກ.\n"
"| Tailoring File | ບໍ່ | ເລືອກໄຟລ໌ປັບແຕ່ງ (tailoring file) ເພື່ອປັບແຕ່ງໂປຣໄຟລ໌.\n"
"| Profile from Tailoring File | ບໍ່ | ເລືອກໂປຣໄຟລ໌ຈາກໄຟລ໌ປັບແຕ່ງ.\n"
"| Advanced Arguments | ບໍ່ | ອາຄິວເມນເພີ່ມເຕີມ, ຕົວຢ່າງ: ``--rule <rule_id> --remediate``.\n"
"| OVAL Files | ບໍ່ | ເສັ້ນທາງໄປຫາ OVAL definitions ໃນລະບົບເປົ້າໝາຍ.\n"
"| Fetch Remote Content | ບໍ່ | ເປີດການດຶງຂໍ້ມູນຈາກພາຍນອກລະຫວ່າງສະແກນ (ຕ້ອງມີອິນເຕີເນັດ).\n"

#. type: delimited block =
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:48
msgid ""
"Enabling btn:[Fetch Remote Content] requires internet access and a large "
"amount of available memory on the target minion.  Ensure the target system "
"has sufficient resources before enabling this option."
msgstr "ການເປີດໃຊ້ btn:[Fetch Remote Content] ຕ້ອງມີການເຊື່ອມຕໍ່ອິນເຕີເນັດ ແລະ ໃຊ້ໜ່ວຍຄວາມຈຳຫຼາຍໃນເຄື່ອງປາຍທາງ. ກະລຸນາກວດສອບວ່າເຄື່ອງມີຊັບພະຍາກອນພຽງພໍ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:49
msgid ""
"Use the [guimenu]``Schedule`` section to select the date and time for the "
"scan."
msgstr "ໃຊ້ພາກສ່ວນ [guimenu]``Schedule`` ເພື່ອເລືອກວັນທີ ແລະ ເວລາທີ່ຈະສະແກນ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:50
msgid "Click btn:[Schedule] to schedule the scan."
msgstr "ຄລິກ btn:[Schedule] ເພື່ອກຳນົດເວລາສະແກນ."

#. type: Title ===
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:51
#, no-wrap
msgid "Single system scheduling"
msgstr "ການກຳນົດເວລາສຳລັບລະບົບດຽວ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:52
msgid ""
"When scheduling a scan from a single system's audit page, a btn:[Create "
"Recurring] button is also available.  Click btn:[Create Recurring] to "
"navigate to the recurring actions page for the system, where you can set up "
"a recurring schedule for SCAP scans."
msgstr "ເມື່ອກຳນົດເວລາຈາກໜ້າກວດສອບຂອງລະບົບດຽວ, ຈະມີປຸ່ມ btn:[Create Recurring] ໃຫ້ເລືອກ ເພື່ອຕັ້ງຄ່າການສະແກນແບບຊ້ຳໆ."

#. type: Title ===
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:53
#, no-wrap
msgid "SSM bulk scheduling"
msgstr "ການກຳນົດເວລາແບບກຸ່ມຜ່ານ SSM"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:54
msgid ""
"When scheduling from the System Set Manager (SSM), the scan is applied to "
"all systems currently in the system set.  The btn:[Create Recurring] option "
"is not available in SSM mode."
msgstr "ເມື່ອກຳນົດເວລາຜ່ານ SSM, ການສະແກນຈະມີຜົນກັບທຸກລະບົບໃນກຸ່ມ. ຕົວເລືອກການສ້າງແບບຊ້ຳໆ (Recurring) ຈະບໍ່ມີໃຫ້ໃຊ້ໃນໂໝດ SSM."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:2
msgid ""
"The menu:Systems[Configuration] section allows you to manage the "
"configuration files for the selected client.  Configuration files are "
"distributed with a configuration channel."
msgstr "ພາກສ່ວນ menu:Systems[Configuration] ຊ່ວຍໃຫ້ທ່ານຈັດການໄຟລ໌ການຕັ້ງຄ່າສຳລັບເຄື່ອງລູກຂ່າຍ. ໄຟລ໌ເຫຼົ່ານີ້ຈະຖືກແຈກຢາຍຜ່ານຊ່ອງທາງການຕັ້ງຄ່າ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:3
#: en/modules/reference/pages/systems/system-details/sd-recurring-actions.adoc:7
#: en/modules/reference/pages/systems/system-details/sd-states.adoc:15
msgid ""
"For more information about configuration channels, see "
"xref:client-configuration:configuration-management.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບຊ່ອງທາງການຕັ້ງຄ່າ, ເບິ່ງໄດ້ທີ່ xref:client-configuration:configuration-management.adoc[]."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:4
msgid "The menu:Systems[Configuration] tab is split into subtabs:"
msgstr "ແຖບ menu:Systems[Configuration] ຖືກແບ່ງອອກເປັນແຖບຍ່ອຍ:"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:6
msgid "The menu:Systems[Configuration > Overview] subtab is split into sections:"
msgstr "ແຖບຍ່ອຍ menu:Systems[Configuration > Overview] ຖືກແບ່ງອອກເປັນພາກສ່ວນ:"

#. type: Labeled list
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:7
#, no-wrap
msgid "Configuration Overview"
msgstr "ພາບລວມການຕັ້ງຄ່າ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:8
msgid ""
"This section contained the total number of available configuration files, "
"and channel subscriptions.  Click the name of a configuration file or "
"channel to see more information.  Click btn:[Subscribe to channels] to "
"subscribe to additional configuration channels."
msgstr "ພາກສ່ວນນີ້ສະແດງຈຳນວນໄຟລ໌ການຕັ້ງຄ່າທັງໝົດ ແລະ ການລົງທະບຽນຊ່ອງທາງ. ຄລິກ btn:[Subscribe to channels] ເພື່ອລົງທະບຽນຊ່ອງທາງເພີ່ມເຕີມ."

#. type: Labeled list
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:9
#, no-wrap
msgid "Recent Events"
msgstr "ເຫດການຫຼ້າສຸດ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:10
msgid ""
"This section shows when the configuration channels was most recently "
"deployed on the selected client.  It also shows the most recent time that a "
"comparison was performed."
msgstr "ພາກສ່ວນນີ້ສະແດງເວລາທີ່ຊ່ອງທາງການຕັ້ງຄ່າຖືກນຳໃຊ້ຫຼ້າສຸດ ແລະ ເວລາທີ່ປຽບທຽບໄຟລ໌ຫຼ້າສຸດ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:12
msgid ""
"This section allows you to deploy or to compare configuration channels on "
"the selected client."
msgstr "ພາກສ່ວນນີ້ຊ່ວຍໃຫ້ທ່ານນຳໃຊ້ ຫຼື ປຽບທຽບຊ່ອງທາງການຕັ້ງຄ່າໃນເຄື່ອງລູກຂ່າຍ."

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:13
#, no-wrap
msgid "View Files"
msgstr "ເບິ່ງໄຟລ໌"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:14
msgid ""
"The menu:Systems[Configuration > View Files] subtab shows the configuration "
"files available through the system's subscribed configuration channels."
msgstr "ແຖບຍ່ອຍ menu:Systems[Configuration > View Files] ສະແດງໄຟລ໌ການຕັ້ງຄ່າທີ່ມີຜ່ານຊ່ອງທາງທີ່ລົງທະບຽນ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:15
msgid ""
"The page shows a list of all available configuration files.  Click "
"btn:[View] to see details about the configuration file.  Click btn:[Compare] "
"to compare the configuration file to other files, or to various revisions of "
"itself.  Click the configuration channel name to see more information about "
"the channel that contains this configuration file.  Click the revision "
"number to see additional details about the configuration file."
msgstr "ໜ້ານີ້ສະແດງລາຍຊື່ໄຟລ໌ການຕັ້ງຄ່າ. ຄລິກ btn:[View] ເພື່ອເບິ່ງລາຍລະອຽດ, ຄລິກ btn:[Compare] ເພື່ອປຽບທຽບ, ຫຼື ຄລິກທີ່ເລກເວີຊັນ (revision) ເພື່ອເບິ່ງລາຍລະອຽດເພີ່ມເຕີມ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:17
msgid ""
"The menu:Systems[Configuration > Deploy Files] shows a list of available "
"configuration files that can be deployed on the selected client."
msgstr "ແຖບຍ່ອຍ menu:Systems[Configuration > Deploy Files] ສະແດງລາຍຊື່ໄຟລ໌ການຕັ້ງຄ່າທີ່ສາມາດນຳໃຊ້ໃນເຄື່ອງລູກຂ່າຍໄດ້."

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:18
#, no-wrap
msgid "Compare Files"
msgstr "ປຽບທຽບໄຟລ໌"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:19
msgid ""
"The menu:Systems[Configuration > Compare Files] shows a list of available "
"configuration files that can be compared to {productname} managed "
"configuration files.  Check the configuration file to compare and click "
"btn:[Compare Files] to schedule a comparison.  Click the revision number to "
"see additional details about the configuration file.  Click the "
"configuration channel name to see more information about the channel that "
"contains this configuration file."
msgstr "ແຖບຍ່ອຍ menu:Systems[Configuration > Compare Files] ສະແດງລາຍຊື່ໄຟລ໌ທີ່ສາມາດປຽບທຽບກັບໄຟລ໌ທີ່ {productname} ຈັດການຢູ່."

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:20
#, no-wrap
msgid "Manage Configuration Channels"
msgstr "ຈັດການຊ່ອງທາງການກຳນົດຄ່າ (Configuration Channels)"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:21
msgid ""
"The menu:Systems[Configuration > Manage Configuration] subtab is split into "
"subtabs:"
msgstr "ແຖບຍ່ອຍ menu:Systems[Configuration > Manage Configuration] ຖືກແບ່ງອອກເປັນແຖບຍ່ອຍດັ່ງນີ້:"

#. type: Labeled list
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:22
#, no-wrap
msgid "List/Unsubscribe from Channels"
msgstr "ລາຍຊື່/ຍົກເລີກການລົງທະບຽນຊ່ອງທາງ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:23
msgid ""
"This section shows the list of currently subscribed channels.  To "
"unsubscribe the selected client from a configuration channel, check the "
"channel, and click btn:[Unsubscribe].  Click the configuration channel name "
"to see more information about the channel that contains this configuration "
"file."
msgstr "ພາກສ່ວນນີ້ສະແດງຊ່ອງທາງທີ່ລົງທະບຽນຢູ່ປະຈຸບັນ. ເພື່ອຍົກເລີກການລົງທະບຽນ, ໃຫ້ເລືອກຊ່ອງທາງແລ້ວຄລິກ btn:[Unsubscribe]."

#. type: Labeled list
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:24
#, no-wrap
msgid "Subscribe to Channels"
msgstr "ລົງທະບຽນຊ່ອງທາງ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:25
msgid ""
"This section shows the list of configuration channels that are available for "
"the selected client to subscribe to.  To subscribe the selected client to a "
"configuration channel, check the channel, and click btn:[Continue]."
msgstr "ພາກສ່ວນນີ້ສະແດງຊ່ອງທາງການຕັ້ງຄ່າທີ່ມີໃຫ້ເຄື່ອງລູກຂ່າຍເລືອກລົງທະບຽນ."

#. type: Labeled list
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:26
#, no-wrap
msgid "View/Modify Rankings"
msgstr "ເບິ່ງ/ແກ້ໄຂລຳດັບຄວາມສຳຄັນ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:27
msgid ""
"This section shows the currently subscribed configuration channels, in "
"ranked order.  Where settings conflicts occur between configuration "
"channels, channels closer to the top of the list take precedence.  To "
"complete subscription to a configuration channel, review the rankings, "
"adjust as necessary using the up and down arrows, and click btn:[Update "
"Channel Rankings]."
msgstr "ພາກສ່ວນນີ້ສະແດງລຳດັບຄວາມສຳຄັນຂອງຊ່ອງທາງການຕັ້ງຄ່າ. ຊ່ອງທາງທີ່ຢູ່ເທິງສຸດຈະມີຄວາມສຳຄັນກວ່າຫາກມີການຕັ້ງຄ່າທີ່ຂັດແຍ່ງກັນ."

#. type: Title =
#: en/modules/reference/pages/systems/system-details/sd-connection.adoc:1
#, no-wrap
msgid "Connection"
msgstr "ການເຊື່ອມຕໍ່"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-connection.adoc:2
msgid ""
"The menu:Systems[Details > Connection] section allows configure proxy "
"connections for this system."
msgstr "ພາກສ່ວນ menu:Systems[Details > Connection] ຊ່ວຍໃຫ້ທ່ານຕັ້ງຄ່າການເຊື່ອມຕໍ່ພຣັອກຊີສຳລັບລະບົບນີ້."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-connection.adoc:3
msgid "These connections are used to reach the primary server."
msgstr "ການເຊື່ອມຕໍ່ເຫຼົ່ານີ້ຖືກໃຊ້ເພື່ອຕິດຕໍ່ຫາເຊີເວີຫຼັກ."

#. type: Title =
#: en/modules/reference/pages/systems/system-details/sd-custom-info.adoc:1
#, no-wrap
msgid "Custom Info"
msgstr "ຂໍ້ມູນທີ່ກຳນົດເອງ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-custom-info.adoc:2
msgid ""
"The menu:Systems[Details > Custom Info] section lists the custom system "
"information that has been applied to the selected client."
msgstr "ພາກສ່ວນ menu:Systems[Details > Custom Info] ສະແດງລາຍຊື່ຂໍ້ມູນລະບົບທີ່ກຳນົດເອງທີ່ໄດ້ນຳໃຊ້ກັບເຄື່ອງລູກຂ່າຍ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-custom-info.adoc:3
msgid ""
"Click btn:[Create Value] to apply a new custom system key to the client.  "
"Click the key label to see more information, and to edit the value."
msgstr "ຄລິກ btn:[Create Value] ເພື່ອກຳນົດຄ່າຄີໃໝ່ໃຫ້ກັບເຄື່ອງລູກຂ່າຍ."

#. type: Title =
#: en/modules/reference/pages/systems/system-details/sd-details.adoc:1
#, no-wrap
msgid "System Details"
msgstr "ລາຍລະອຽດລະບົບ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-details.adoc:2
msgid ""
"The [guimenu]``System Details`` section allows you to manage the details for "
"a chosen client.  To get to this section, click the name of a client "
"anywhere throughout the {webui} to see the relevant [guimenu]``System "
"Details`` page for the client."
msgstr "ພາກສ່ວນ [guimenu]``System Details`` ຊ່ວຍໃຫ້ທ່ານຈັດການລາຍລະອຽດຂອງເຄື່ອງລູກຂ່າຍທີ່ເລືອກ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-details.adoc:3
msgid ""
"The [guimenu]``System Details`` section is divided into tabs and subtabs.  "
"Each tab and some subtabs have own sections in this document."
msgstr "ພາກສ່ວນ [guimenu]``System Details`` ຖືກແບ່ງອອກເປັນແຖບ ແລະ ແຖບຍ່ອຍ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-details.adoc:4
msgid ""
"The menu:Systems[Details > Overview] subtab is displayed by default.  Which "
"tabs are available is dependent on the [systemitem]``system type`` of the "
"client you have selected.  Most often, the flollowing are available:"
msgstr "ແຖບຍ່ອຍ menu:Systems[Details > Overview] ຈະຖືກສະແດງເປັນຄ່າເລີ່ມຕົ້ນ. ແຖບທີ່ມີໃຫ້ໃຊ້ແມ່ນຂຶ້ນກັບປະເພດລະບົບ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-details.adoc:5
#, no-wrap
msgid ""
"[guimenu]``Details``           - "
"xref:reference:systems/system-details/sd-overview.adoc[]\n"
msgstr "[guimenu]``ລາຍລະອຽດ``           - xref:reference:systems/system-details/sd-overview.adoc[]\n"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-details.adoc:6
#, no-wrap
msgid ""
"[guimenu]``Software``\t\t - "
"xref:reference:systems/system-details/sd-software.adoc[]\n"
msgstr "[guimenu]``ຊອບແວ``\t\t - xref:reference:systems/system-details/sd-software.adoc[]\n"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-details.adoc:7
#, no-wrap
msgid ""
"[guimenu]``Configuration``\t - "
"xref:reference:systems/system-details/sd-configuration.adoc[]\n"
msgstr "[guimenu]``ການຕັ້ງຄ່າ``\t - xref:reference:systems/system-details/sd-configuration.adoc[]\n"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-details.adoc:8
#, no-wrap
msgid ""
"[guimenu]``Provisioning``\t - "
"xref:reference:systems/system-details/sd-provisioning.adoc[]\n"
msgstr "[guimenu]``ການຈັດກຽມລະບົບ``\t - xref:reference:systems/system-details/sd-provisioning.adoc[]\n"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-details.adoc:9
#, no-wrap
msgid ""
"[guimenu]``Groups``\t\t - "
"xref:reference:systems/system-details/sd-groups.adoc[]\n"
msgstr "[guimenu]``ກຸ່ມ``\t\t - xref:reference:systems/system-details/sd-groups.adoc[]\n"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-details.adoc:10
#, no-wrap
msgid ""
"[guimenu]``Audit``\t\t - "
"xref:reference:systems/system-details/sd-audit.adoc[]\n"
msgstr "[guimenu]``ການກວດສອບ``\t\t - xref:reference:systems/system-details/sd-audit.adoc[]\n"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-details.adoc:11
#, no-wrap
msgid ""
"[guimenu]``States``\t\t - "
"xref:reference:systems/system-details/sd-states.adoc[]\n"
msgstr "[guimenu]``ສະເຕດ``\t\t - xref:reference:systems/system-details/sd-states.adoc[]\n"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-details.adoc:12
#, no-wrap
msgid ""
"[guimenu]``Formulas``\t\t - "
"xref:reference:systems/system-details/sd-formulas.adoc[]\n"
msgstr "[guimenu]``ຟໍມູລາ``\t\t - xref:reference:systems/system-details/sd-formulas.adoc[]\n"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-details.adoc:13
#, no-wrap
msgid ""
"[guimenu]``Recurring Actions`` - "
"xref:reference:systems/system-details/sd-recurring-actions.adoc[]\n"
msgstr "[guimenu]``ການດຳເນີນການແບບຊ້ຳໆ`` - xref:reference:systems/system-details/sd-recurring-actions.adoc[]\n"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-details.adoc:14
#, no-wrap
msgid ""
"[guimenu]``Events``            - "
"xref:reference:systems/system-details/sd-events.adoc[]\n"
msgstr "[guimenu]``ເຫດການ``            - xref:reference:systems/system-details/sd-events.adoc[]\n"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-details.adoc:15
#: en/modules/reference/pages/systems/systems-list.adoc:3
#: en/modules/reference/pages/systems/systems-menu.adoc:20
msgid ""
"For more information about managing clients, see "
"xref:client-configuration:client-config-overview.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການຈັດການເຄື່ອງລູກຂ່າຍ, ເບິ່ງໄດ້ທີ່ xref:client-configuration:client-config-overview.adoc[]."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-details.adoc:16
#: en/modules/reference/pages/systems/systems-list.adoc:4
#: en/modules/reference/pages/systems/systems-menu.adoc:21
msgid ""
"For more information about managing clients, see "
"xref:client-configuration:uyuni-client-config-overview.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການຈັດການເຄື່ອງລູກຂ່າຍ, ເບິ່ງໄດ້ທີ່ xref:client-configuration:uyuni-client-config-overview.adoc[]."

#. type: Title =
#: en/modules/reference/pages/systems/system-details/sd-events.adoc:1
#, no-wrap
msgid "Events"
msgstr "ເຫດການ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-events.adoc:2
msgid ""
"The menu:Systems[Events] section shows past, current, and scheduled actions "
"for the selected client."
msgstr "ພາກສ່ວນ menu:Systems[Events] ສະແດງການດຳເນີນການໃນອະດີດ, ປະຈຸບັນ ແລະ ທີ່ມີກຳນົດເວລາສຳລັບເຄື່ອງລູກຂ່າຍ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-events.adoc:4
msgid "The menu:Systems[Event] tab is split into subtabs:"
msgstr "ແຖບ menu:Systems[Event] ຖືກແບ່ງອອກເປັນແຖບຍ່ອຍ:"

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-events.adoc:5
#, no-wrap
msgid "Pending"
msgstr "ກຳລັງລໍຖ້າ (Pending)"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-events.adoc:6
msgid "This section shows actions that are scheduled, but have not yet started."
msgstr "ພາກສ່ວນນີ້ສະແດງການດຳເນີນການທີ່ກຳນົດເວລາໄວ້ ແຕ່ຍັງບໍ່ທັນເລີ່ມຕົ້ນ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-events.adoc:7
msgid ""
"Click the name of an action to see more information.  To cancel an action, "
"check the action and click btn:[Cancel Selected Events]."
msgstr "ຄລິກທີ່ຊື່ການດຳເນີນການເພື່ອເບິ່ງລາຍລະອຽດ. ເພື່ອຍົກເລີກ, ໃຫ້ເລືອກແລ້ວຄລິກ btn:[Cancel Selected Events]."

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-events.adoc:8
#, no-wrap
msgid "History"
msgstr "ປະຫວັດ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-events.adoc:9
msgid "This section shows actions that have been completed on the selected client."
msgstr "ພາກສ່ວນນີ້ສະແດງການດຳເນີນການທີ່ສຳເລັດແລ້ວໃນເຄື່ອງລູກຂ່າຍ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-events.adoc:10
msgid "Click the summary of an action to see more information."
msgstr "ຄລິກທີ່ບົດສະຫຼຸບຂອງການດຳເນີນການເພື່ອເບິ່ງລາຍລະອຽດ."

#. type: Title =
#: en/modules/reference/pages/systems/system-details/sd-formulas.adoc:1
#, no-wrap
msgid "Formulas"
msgstr "ຟໍມູລາ (Formulas)"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-formulas.adoc:2
msgid ""
"The menu:Systems[Formulas] section allows you to manage Salt formulas on the "
"selected client.  This is only available for Salt clients."
msgstr "ພາກສ່ວນ menu:Systems[Formulas] ຊ່ວຍໃຫ້ທ່ານຈັດການ Salt formulas ໃນເຄື່ອງລູກຂ່າຍ (ສະເພາະ Salt clients)."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-formulas.adoc:3
msgid ""
"This section lists all currently installed formulas.  Check the formulas you "
"want to apply, and click btn:[Save].  When a formula is applied, it will "
"create a new subtab.  Navigate to the subtab to configure the formula on the "
"selected client.  After most formula actions, you will need to apply the "
"highstate to pick up the changes."
msgstr "ພາກສ່ວນນີ້ສະແດງລາຍຊື່ formulas ທີ່ຕິດຕັ້ງຢູ່. ຫຼັງຈາກນຳໃຊ້ແລ້ວ ທ່ານອາດຕ້ອງລັນ highstate ເພື່ອອັບເດດການປ່ຽນແປງ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-formulas.adoc:4
msgid ""
"For more information about formulas, see "
"xref:specialized-guides:salt/salt-formulas-intro.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບ formulas, ໃຫ້ເບິ່ງ xref:specialized-guides:salt/salt-formulas-intro.adoc[]."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-groups.adoc:2
msgid ""
"The menu:Systems[Groups] section shows the system groups the selected client "
"is assigned to."
msgstr "ພາກສ່ວນ menu:Systems[Groups] ສະແດງກຸ່ມລະບົບທີ່ເຄື່ອງລູກຂ່າຍນີ້ສັງກັດຢູ່."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-groups.adoc:3
msgid "The menu:Systems[Groups] subtab is split into sections:"
msgstr "ແຖບຍ່ອຍ menu:Systems[Groups] ຖືກແບ່ງອອກເປັນພາກສ່ວນ:"

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-groups.adoc:5
#, no-wrap
msgid "List/Leave"
msgstr "ລາຍຊື່/ອອກຈາກກຸ່ມ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-groups.adoc:6
msgid "This section lists all groups that the selected client belongs to."
msgstr "ພາກສ່ວນນີ້ສະແດງທຸກກຸ່ມທີ່ເຄື່ອງລູກຂ່າຍນີ້ເປັນສະມາຊິກ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-groups.adoc:7
msgid ""
"Click the group name to see more information about the system group.  To "
"remove the selected client from a system group, check the group, and click "
"btn:[Leave Selected Groups]."
msgstr "ຄລິກທີ່ຊື່ກຸ່ມເພື່ອເບິ່ງຂໍ້ມູນ. ເພື່ອອອກຈາກກຸ່ມ, ໃຫ້ເລືອກກຸ່ມແລ້ວຄລິກ btn:[Leave Selected Groups]."

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-groups.adoc:8
#, no-wrap
msgid "Join"
msgstr "ເຂົ້າຮ່ວມ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-groups.adoc:9
msgid ""
"This section lists all groups that are available for the selected client to "
"subscribe to."
msgstr "ພາກສ່ວນນີ້ສະແດງກຸ່ມທັງໝົດທີ່ເຄື່ອງລູກຂ່າຍນີ້ສາມາດເຂົ້າຮ່ວມໄດ້."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-groups.adoc:10
msgid ""
"Click the group name to see more information about the system group.  To "
"join a system group, check the group, and click btn:[Join Selected Groups]."
msgstr "ເລືອກກຸ່ມທີ່ຕ້ອງການແລ້ວຄລິກ btn:[Join Selected Groups] ເພື່ອເຂົ້າຮ່ວມ."

#. type: Title =
#: en/modules/reference/pages/systems/system-details/sd-hardware.adoc:1
#, no-wrap
msgid "Hardware"
msgstr "ຮາດແວ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-hardware.adoc:2
msgid ""
"The menu:Systems[Details > Hardware] section shows detailed hardware "
"information about the selected client, including architecture, networking, "
"and memory."
msgstr "ພາກສ່ວນ menu:Systems[Details > Hardware] ສະແດງຂໍ້ມູນຮາດແວລະອຽດ ເຊັ່ນ: ສະຖາປັດຕະຍະກຳ, ເຄືອຂ່າຍ ແລະ ໜ່ວຍຄວາມຈຳ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-hardware.adoc:3
msgid ""
"Click btn:[Schedule Hardware Refresh] to update this page with the latest "
"hardware information.  To change the primary network interface on the "
"client, select the correct interface in the [guimenu]``Primary Network "
"Interface`` field in the [guimenu]``Networking`` section.  For clients with "
"multiple fully qualified domain names (FQDNs) configured, change the primary "
"FQDN by selecting it in the [guimenu]``Primary FQDN`` field in the "
"[guimenu]``Networking`` section.  Click btn:[Update Properties] to save your "
"changes."
msgstr "ຄລິກ btn:[Schedule Hardware Refresh] ເພື່ອອັບເດດຂໍ້ມູນຮາດແວຫຼ້າສຸດ."

#. type: delimited block =
#: en/modules/reference/pages/systems/system-details/sd-hardware.adoc:4
msgid ""
"Refreshing hardware information happens once a month automatically when the "
"[systemitem]``system-profile-refresh`` taskomatic job runs."
msgstr "ຂໍ້ມູນຮາດແວຈະຖືກອັບເດດອັດຕະໂນມັດເດືອນລະຄັ້ງໂດຍ taskomatic."

#. type: Title =
#: en/modules/reference/pages/systems/system-details/sd-notes.adoc:1
#, no-wrap
msgid "Notes"
msgstr "ໝາຍເຫດ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-notes.adoc:2
msgid ""
"The menu:Systems[Details > Notes] section lists notes about the selected "
"client."
msgstr "ພາກສ່ວນ menu:Systems[Details > Notes] ສະແດງບັນທຶກຕ່າງໆກ່ຽວກັບເຄື່ອງລູກຂ່າຍ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-notes.adoc:3
msgid ""
"Click btn:[Create Note] to create a new note.  Give your note a subject, and "
"add any details you require.  Click btn:[Create] to save the note."
msgstr "ຄລິກ btn:[Create Note] ເພື່ອສ້າງບັນທຶກໃໝ່."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-notes.adoc:4
msgid ""
"Notes are listed in the table with a time stamp of when they were last "
"edited.  Click the subject of a note to edit or delete it."
msgstr "ບັນທຶກຈະຖືກສະແດງພ້ອມກັບເວລາທີ່ແກ້ໄຂຫຼ້າສຸດ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:2
msgid ""
"The menu:Systems[Details > Overview] section shows a summary of information "
"about the selected client, including the current system status.  This subtab "
"is displayed by default when you click the name of a client anywhere "
"throughout the {webui}."
msgstr "ພາກສ່ວນ menu:Systems[Details > Overview] ສະແດງບົດສະຫຼຸບຂໍ້ມູນ ແລະ ສະຖານະຂອງເຄື່ອງລູກຂ່າຍ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:3
msgid ""
"Click btn:[Delete System] to delete the system profile.  Deleting a system "
"profile will not destroy or remove the client, but you will no longer be "
"able to manage it with {productname}.  If you delete a system profile by "
"mistake, you can re-register the client using bootstrap."
msgstr "ຄລິກ btn:[Delete System] ເພື່ອລຶບໂປຣໄຟລ໌ລະບົບ (ແຕ່ບໍ່ໄດ້ລຶບຕົວເຄື່ອງລູກຂ່າຍ)."

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:5
#, no-wrap
msgid "System Status"
msgstr "ສະຖານະລະບົບ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:6
msgid ""
"The section shows the current status of the client.  If no action is "
"required for this client, the status is ``System is up to date``."
msgstr "ພາກສ່ວນນີ້ສະແດງສະຖານະປະຈຸບັນ. ຫາກບໍ່ມີຫຍັງຕ້ອງອັບເດດ ຈະຂຶ້ນວ່າ ``System is up to date``."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:7
msgid ""
"If the client has new software ready for installation, the status is "
"``Software Updates Available``, along with details of updates.  Apply "
"updates by navigating to menu:System Details[Packages]."
msgstr "ຫາກມີຊອບແວໃໝ່ ຈະຂຶ້ນວ່າ ``Software Updates Available``."

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:8
#, no-wrap
msgid "System Info"
msgstr "ຂໍ້ມູນລະບົບ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:9
msgid "This section shows general information about the client."
msgstr "ພາກສ່ວນນີ້ສະແດງຂໍ້ມູນທົ່ວໄປຂອງເຄື່ອງລູກຂ່າຍ."

#. type: Block title
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:10
#, no-wrap
msgid "System Info Columns"
msgstr "ຖັນຂໍ້ມູນລະບົບ"

#. ?? --LKB 2020-07-14
#. type: Table
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:11
#, no-wrap
msgid ""
"| Column Name\n"
"| Description\n"
"| Conditions\n"
"\n"
"| Hostname\n"
"| The hostname used by the client with the {productname} Server.\n"
"| -\n"
"\n"
"| FQDN\n"
"| The fully qualified domain name of the client.\n"
"| Shown only if it differs from the host name.\n"
msgstr ""
"| ຊື່ຖັນ\n"
"| ຄຳອະທິບາຍ\n"
"| ເງື່ອນໄຂ\n"
"\n"
"| Hostname\n"
"| ຊື່ໂຮສທີ່ເຄື່ອງລູກຂ່າຍໃຊ້ກັບ {productname} Server.\n"
"| -\n"
"\n"
"| FQDN\n"
"| ຊື່ໂດເມນເຕັມ (FQDN) ຂອງເຄື່ອງລູກຂ່າຍ.\n"
"| ສະແດງສະເພາະຫາກມັນຕ່າງຈາກ hostname.\n"

#. type: Table
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:12
msgid ""
"| IP address | The IPv4 IP address of the client.  | - | IPv6 address | The "
"IPv6 IP address of the client.  | - | Minion ID | The minion ID of the "
"client.  | Salt clients only.  | Virtualization | The type of virtualization "
"used by the client.  | Virtualized clients only.  | UUID | The universally "
"unique identifier.  | - | Kernel | The kernel currently in use on the "
"client.  | - | {productname} System ID | A unique identifier generated by "
"{productname} when the client is registered.  | - | Activation key | The "
"activation key used to register the client.  | Remains blank if the client "
"has not been activated.  | Installed products | Software products currently "
"installed on the client.  | -"
msgstr "| IP address | ທີ່ຢູ່ IPv4 ຂອງເຄື່ອງລູກຂ່າຍ. | - | IPv6 address | ທີ່ຢູ່ IPv6 ຂອງເຄື່ອງລູກຂ່າຍ. | - | Minion ID | ID ຂອງ minion. | ສະເພາະ Salt clients. | Virtualization | ປະເພດ virtualization ທີ່ໃຊ້. | ສະເພາະ Virtualized clients. | UUID | ຕົວລະບຸສະເພາະສາກົນ. | - | Kernel | ເວີຊັນ kernel ທີ່ໃຊ້ຢູ່. | - | {productname} System ID | ID ທີ່ສ້າງໂດຍ {productname}. | - | Activation key | ຄີທີ່ໃຊ້ລົງທະບຽນ. | ຈະວ່າງໄວ້ຫາກບໍ່ໄດ້ໃຊ້. | Installed products | ຜະລິດຕະພັນຊອບແວທີ່ຕິດຕັ້ງຢູ່. | -"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:13
msgid ""
"For more information about system locks, see "
"xref:client-configuration:system-locking.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການລັອກລະບົບ, ເບິ່ງໄດ້ທີ່ xref:client-configuration:system-locking.adoc[]."

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:14
#, no-wrap
msgid "Subscribed Channels"
msgstr "ຊ່ອງທາງທີ່ລົງທະບຽນ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:15
msgid ""
"This section shows the base and child software channels this client is "
"subscribed to."
msgstr "ພາກສ່ວນນີ້ສະແດງຊ່ອງທາງຊອບແວຫຼັກ ແລະ ຍ່ອຍທີ່ເຄື່ອງລູກຂ່າຍນີ້ລົງທະບຽນຢູ່."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:16
msgid ""
"Click btn:[Alter Channel Subscriptions] to change the channel subscriptions "
"for this client.  Click a channel name to go to the [guimenu]``Channel "
"Details`` tab."
msgstr "ຄລິກ btn:[Alter Channel Subscriptions] ເພື່ອປ່ຽນການລົງທະບຽນຊ່ອງທາງ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:17
msgid ""
"For more information about channels, see "
"xref:client-configuration:channels.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບຊ່ອງທາງ, ເບິ່ງໄດ້ທີ່ xref:client-configuration:channels.adoc[]."

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:18
#, no-wrap
msgid "System Events"
msgstr "ເຫດການລະບົບ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:19
msgid "This section shows the most recent system events for this client."
msgstr "ພາກສ່ວນນີ້ສະແດງເຫດການລະບົບຫຼ້າສຸດສຳລັບເຄື່ອງລູກຂ່າຍນີ້."

#. type: Block title
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:20
#, no-wrap
msgid "System Events Columns"
msgstr "ຖັນເຫດການລະບົບ"

#. type: Table
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:21
#, no-wrap
msgid ""
"| Column Name\n"
"| Description\n"
"\n"
"| Checked in\n"
"| The time that the client last successfully checked in with the "
"{productname} Server.\n"
"\n"
"| Registered\n"
"| The time that the client registered with {productname}.\n"
"\n"
"| Last booted\n"
"| The time that the client was most recently started or rebooted.\n"
"\n"
msgstr ""
"| ຊື່ຖັນ\n"
"| ຄຳອະທິບາຍ\n"
"\n"
"| Checked in\n"
"| ເວລາທີ່ເຄື່ອງລູກຂ່າຍຕິດຕໍ່ຫາເຊີເວີສຳເລັດຫຼ້າສຸດ.\n"
"\n"
"| Registered\n"
"| ເວລາທີ່ລົງທະບຽນກັບ {productname}.\n"
"\n"
"| Last booted\n"
"| ເວລາທີ່ເລີ່ມລະບົບໃໝ່ຫຼ້າສຸດ.\n"
"\n"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:22
msgid ""
"Click btn:[Schedule system reboot] to set a time for the client to reboot.  "
"The reboot will occur when the client next checks in with the {productname} "
"Server after the scheduled time.  For more on task scheduling, see "
"xref:administration:task-schedules.adoc[]."
msgstr "ຄລິກ btn:[Schedule system reboot] ເພື່ອກຳນົດເວລາເລີ່ມລະບົບໃໝ່."

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:23
#, no-wrap
msgid "System Properties"
msgstr "ຄຸນສົມບັດລະບົບ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:24
msgid "This section shows further information about the client."
msgstr "ພາກສ່ວນນີ້ສະແດງຂໍ້ມູນເພີ່ມເຕີມຂອງເຄື່ອງລູກຂ່າຍ."

#. type: Block title
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:25
#, no-wrap
msgid "System Properties Columns"
msgstr "ຖັນຄຸນສົມບັດລະບົບ"

#. type: Table
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:26
#, no-wrap
msgid ""
"| Column Name\n"
"| Description\n"
"\n"
"| System types\n"
"| Lists the system type applied to the client.\n"
"Client type is {salt}\n"
"\n"
"| Notifications\n"
"| Lists the current notification options for this client.\n"
"\n"
"| Contact method\n"
"| The method used by this client to communicate with the {productname} "
"Server.\n"
"\n"
"| Auto patch update\n"
"| Indicates if the client is receiving patches automatically.\n"
"\n"
"| Maintenance Schedule\n"
"| Specifies which maintenance schedule is assigned to this client.\n"
"\n"
"| System name\n"
"| The system name of the client.\n"
"By default, this is the host name, but it can be changed.\n"
"\n"
"| Description\n"
"| General information about the client.\n"
"By default, this is automatically gathered when the client is registered, "
"but it can be changed.\n"
"\n"
"| Location\n"
"| The physical location of the client.\n"
"By default, this is not set, but it can be added.\n"
"\n"
msgstr ""

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:27
msgid ""
"For more information about contact methods, see "
"xref:client-configuration:contact-methods-intro.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບວິທີການຕິດຕໍ່, ເບິ່ງໄດ້ທີ່ xref:client-configuration:contact-methods-intro.adoc[]."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:28
msgid ""
"Click btn:[Edit These Properties] to go to menu:System Details[Details > "
"Properties] subtab."
msgstr "ຄລິກ btn:[Edit These Properties] ເພື່ອໄປທີ່ແຖບຍ່ອຍຄຸນສົມບັດ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-packages.adoc:2
msgid ""
"The menu:Systems[Software > Packages] section allows you to manage packages "
"on the selected client."
msgstr "ພາກສ່ວນ menu:Systems[Software > Packages] ຊ່ວຍໃຫ້ທ່ານຈັດການແພັກເກັດໃນເຄື່ອງລູກຂ່າຍ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-packages.adoc:3
msgid "Click btn:[Update Package List] to refresh the list of available packages."
msgstr "ຄລິກ btn:[Update Package List] ເພື່ອອັບເດດລາຍຊື່ແພັກເກັດ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-packages.adoc:4
msgid "The menu:Systems[Software > Packages] tab is split into subtabs:"
msgstr "ແຖບ menu:Systems[Software > Packages] ຖືກແບ່ງອອກເປັນແຖບຍ່ອຍ:"

#. type: Labeled list
#: en/modules/reference/pages/systems/system-details/sd-packages.adoc:5
#, no-wrap
msgid "List/Remove"
msgstr "ລາຍຊື່/ລຶບອອກ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-packages.adoc:6
msgid ""
"Lists all packages currently installed on the selected client.  Click the "
"name of a package to see more information.  To uninstall packages, check the "
"package in the list and click btn:[Remove Packages]."
msgstr "ສະແດງທຸກແພັກເກັດທີ່ຕິດຕັ້ງຢູ່. ເລືອກແພັກເກັດແລ້ວຄລິກ btn:[Remove Packages] ເພື່ອຖອນການຕິດຕັ້ງ."

#. type: Labeled list
#: en/modules/reference/pages/systems/system-details/sd-packages.adoc:7
#, no-wrap
msgid "Upgrade"
msgstr "ອັບເກຣດ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-packages.adoc:8
msgid ""
"Lists packages that have newer versions available.  Click the name of a "
"package to see more information.  To upgrade packages, check the package in "
"the list and click btn:[Upgrade Packages].  Any EULAs will be accepted "
"automatically."
msgstr "ສະແດງແພັກເກັດທີ່ມີເວີຊັນໃໝ່. ເລືອກແພັກເກັດແລ້ວຄລິກ btn:[Upgrade Packages] ເພື່ອອັບເກຣດ."

#. type: Labeled list
#: en/modules/reference/pages/systems/system-details/sd-packages.adoc:9
#, no-wrap
msgid "Install"
msgstr "ຕິດຕັ້ງ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-packages.adoc:10
msgid ""
"Lists packages that are available for installation on the selected client.  "
"Click the name of a package to see more information.  To install packages, "
"check the package in the list and click btn:[Install Selected Packages].  "
"Any EULAs will be accepted automatically."
msgstr "ສະແດງແພັກເກັດທີ່ມີໃຫ້ຕິດຕັ້ງ. ເລືອກແພັກເກັດແລ້ວຄລິກ btn:[Install Selected Packages] ເພື່ອຕິດຕັ້ງ."

#. type: Labeled list
#: en/modules/reference/pages/systems/system-details/sd-packages.adoc:11
#, no-wrap
msgid "Profiles"
msgstr "ໂປຣໄຟລ໌"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-packages.adoc:12
msgid ""
"Compare packages installed on the selected client with a stored profile, or "
"with packages installed on another client.  When the comparison is made, you "
"can choose to modify the selected client to match.  To compare with a stored "
"profile, select the profile and click btn:[Compare].  To compare with "
"another client, select the client name and click btn:[Compare]."
msgstr "ປຽບທຽບແພັກເກັດທີ່ຕິດຕັ້ງກັບໂປຣໄຟລ໌ອື່ນ ຫຼື ເຄື່ອງອື່ນ."

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-packages.adoc:13
#: en/modules/reference/pages/systems/systems-list.adoc:18
#, no-wrap
msgid "Non Compliant"
msgstr "ບໍ່ສອດຄ່ອງ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-packages.adoc:14
msgid ""
"Lists packages that are installed on the selected client, but are not "
"available in any of the subscribed software channels."
msgstr "ສະແດງແພັກເກັດທີ່ຕິດຕັ້ງຢູ່ ແຕ່ບໍ່ມີໃນຊ່ອງທາງທີ່ລົງທະບຽນໄວ້."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-packages.adoc:15
msgid ""
"For more information about packages, see "
"xref:client-configuration:package-management.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບແພັກເກັດ, ເບິ່ງໄດ້ທີ່ xref:client-configuration:package-management.adoc[]."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-patches.adoc:2
msgid ""
"The menu:Systems[Software > Patches] section displays a list of all patches "
"currently available to the selected client."
msgstr "ພາກສ່ວນ menu:Systems[Software > Patches] ສະແດງລາຍຊື່ແພັດທັງໝົດທີ່ມີໃຫ້ເຄື່ອງລູກຂ່າຍ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-patches.adoc:3
msgid ""
"To apply a patch, check it in the list and click btn:[Apply Patches] to "
"schedule the installation.  The [guimenu]``Status`` column in the list shows "
"whether an update has been scheduled.  Click the status for more information "
"about the action."
msgstr "ເລືອກແພັດແລ້ວຄລິກ btn:[Apply Patches] ເພື່ອກຳນົດເວລາຕິດຕັ້ງ."

#. type: Title =
#: en/modules/reference/pages/systems/system-details/sd-product-migration.adoc:1
#, no-wrap
msgid "Product Migration"
msgstr "ການຍ້າຍຜະລິດຕະພັນ (Product Migration)"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-product-migration.adoc:2
msgid ""
"The menu:Systems[Software > Product Migration] section allows you to upgrade "
"clients to the latest service pack of their underlying operating system.  "
"Product migration also allows you to migrate openSUSE Leap to the "
"corresponding SLE SP level or clients such as {rhel}, or {centos} to {sll}.  "
"Check the product version you want to upgrade the client to, and click "
"btn:[Select Channels]."
msgstr "ພາກສ່ວນ menu:Systems[Software > Product Migration] ຊ່ວຍໃຫ້ທ່ານອັບເກຣດ service pack ຫຼື ຍ້າຍລະບົບປະຕິບັດການ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-product-migration.adoc:3
msgid ""
"For more information about service pack upgrades, see "
"xref:client-configuration:client-upgrades-product-migration.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການອັບເກຣດ service pack, ເບິ່ງໄດ້ທີ່ xref:client-configuration:client-upgrades-product-migration.adoc[]."

#. type: Title =
#: en/modules/reference/pages/systems/system-details/sd-properties.adoc:1
#, no-wrap
msgid "Properties"
msgstr "ຄຸນສົມບັດ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-properties.adoc:2
msgid ""
"The menu:Systems[Details > Properties] section allows you to edit details "
"about the selected client, including the system name and details."
msgstr "ພາກສ່ວນ menu:Systems[Details > Properties] ຊ່ວຍໃຫ້ທ່ານແກ້ໄຂລາຍລະອຽດລະບົບ."

#. type: Block title
#: en/modules/reference/pages/systems/system-details/sd-properties.adoc:3
#, no-wrap
msgid "Edit System Details Settings"
msgstr "ແກ້ໄຂການຕັ້ງຄ່າລາຍລະອຽດລະບົບ"

#. type: Table
#: en/modules/reference/pages/systems/system-details/sd-properties.adoc:4
#, no-wrap
msgid ""
"| Setting Name\n"
"| Description\n"
"| Default Setting\n"
"\n"
"| System Name\n"
"| The name of the system to use within the {productname} {webui}.\n"
"| The hostname of the client.\n"
"\n"
"| Base System Type\n"
"| The type of base system used by the client.\n"
"| Shown for information only, you cannot edit this.\n"
"\n"
"| Add-on System Types\n"
"| Check additional system types to add features such as build hosts, or "
"monitoring.\n"
"| Only available system types for this client are shown.\n"
"\n"
"| Notifications\n"
"| Check to receive notifications of updates or patches, and to include this "
"client in the daily summary.\n"
"| Checked.\n"
"\n"
"| Auto Patch Update\n"
"| Check to have available patches automatically applied.\n"
"| Unchecked.\n"
"\n"
"| Description\n"
"| This field can contain any text you want.\n"
"| The operating system, release, and architecture of the system when it "
"first registered to {productname}.\n"
"\n"
"| Facility Address\n"
"| The physical location of the client.\n"
"| Blank\n"
"\n"
msgstr ""

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-provisioning.adoc:2
msgid ""
"The menu:Systems[Provisioning] section allows you to manage provisioning for "
"the selected client.  This includes managing and scheduling autoinstallation "
"and booting the selected client."
msgstr "ພາກສ່ວນ menu:Systems[Provisioning] ຊ່ວຍໃຫ້ທ່ານຈັດການການຕິດຕັ້ງລະບົບໃໝ່."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-provisioning.adoc:3
msgid "The menu:Systems[Provisioning] tab is split into subtabs:"
msgstr "ແຖບ menu:Systems[Provisioning] ຖືກແບ່ງອອກເປັນແຖບຍ່ອຍ:"

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-provisioning.adoc:4
#, no-wrap
msgid "Autoinstallation"
msgstr "ການຕິດຕັ້ງອັດຕະໂນມັດ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-provisioning.adoc:5
msgid ""
"This section displays a list of the available autoinstallation profiles for "
"the selected client.  Select a time and date for autoinstallation to "
"re-install the client."
msgstr "ພາກສ່ວນນີ້ສະແດງໂປຣໄຟລ໌ການຕິດຕັ້ງອັດຕະໂນມັດທີ່ມີ."

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-provisioning.adoc:7
#, no-wrap
msgid "Power Management"
msgstr "ການຈັດການພະລັງງານ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-provisioning.adoc:8
msgid ""
"This section allows you to power on, power off, and reboot the selected "
"client."
msgstr "ພາກສ່ວນນີ້ຊ່ວຍໃຫ້ທ່ານເປີດ, ປິດ ຫຼື ເລີ່ມລະບົບໃໝ່."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-provisioning.adoc:9
msgid ""
"This feature uses either the IPMI or Redfish protocol and is managed using a "
"{cobbler} profile.  The selected client must have a power management "
"controller supporting one of these protocols.  For Redfish, ensure you can "
"establish a valid SSL connection between the client and the {productname} "
"Server."
msgstr ""

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-provisioning.adoc:10
msgid ""
"Complete the details for the power management server, and click the "
"appropriate button for the action to take.  Click btn:[Get status] to "
"determine if the client is currently running.  Click btn:[Save only] to save "
"the details without taking any action."
msgstr ""

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-provisioning.adoc:11
msgid ""
"Click btn:[Remove Cobbler System Profile] to remove the current client's "
"system profile from {cobbler}.  For more information about unattended "
"provisioning with {cobbler}, see "
"xref:client-configuration:autoinst-unattended.adoc[]."
msgstr ""

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-provisioning.adoc:12
msgid ""
"For more information about power management, see "
"xref:client-configuration:power-management.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການຈັດການພະລັງງານ, ເບິ່ງໄດ້ທີ່ xref:client-configuration:power-management.adoc[]."

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-proxy.adoc:1
#: en/modules/reference/pages/systems/systems-list.adoc:32
#, no-wrap
msgid "Proxy"
msgstr "Proxy"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-proxy.adoc:2
msgid ""
"The menu:Systems[System List > Proxy] section shows all clients connected to "
"the selected client as a proxy.  This is only available when the selected "
"client is registered to {productname} as a proxy."
msgstr "ພາກສ່ວນ menu:Systems[System List > Proxy] ສະແດງເຄື່ອງລູກຂ່າຍທີ່ເຊື່ອມຕໍ່ຜ່ານພຣັອກຊີນີ້."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-proxy.adoc:3
msgid ""
"For more information about setting up a proxy, see "
"xref:installation-and-upgrade:install-proxy.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການຕັ້ງຄ່າພຣັອກຊີ, ເບິ່ງໄດ້ທີ່ xref:installation-and-upgrade:install-proxy.adoc[]."

#. type: Title =
#: en/modules/reference/pages/systems/system-details/sd-reactivation.adoc:1
#, no-wrap
msgid "Reactivation"
msgstr "ການເປີດໃຊ້ງານຄືນໃໝ່ (Reactivation)"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-reactivation.adoc:2
msgid ""
"The menu:Systems[Details > Reactivation] section allows you to generate "
"reactivation keys for the selected client.  Reactivation keys can be used "
"once only to re-register the client and regain all {productname} settings."
msgstr "ພາກສ່ວນ menu:Systems[Details > Reactivation] ຊ່ວຍໃຫ້ທ່ານສ້າງຄີເພື່ອລົງທະບຽນໃໝ່."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-reactivation.adoc:3
msgid ""
"For more information about reactivation keys, see "
"xref:client-configuration:activation-keys.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບຄີການເປີດໃຊ້ງານຄືນໃໝ່, ເບິ່ງໄດ້ທີ່ xref:client-configuration:activation-keys.adoc[]."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-recurring-actions.adoc:2
msgid ""
"The menu:Systems[Recurring Actions] section allows you to manage recurring "
"actions on the selected client.  You can schedule an arbitrary set of Salt "
"states or the highstate to be executed at desired intervals.  This is only "
"available for Salt clients."
msgstr "ພາກສ່ວນ menu:Systems[Recurring Actions] ຊ່ວຍໃຫ້ຈັດການການດຳເນີນການແບບຊ້ຳໆ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-recurring-actions.adoc:3
#: en/modules/reference/pages/systems/system-details/sd-states.adoc:3
msgid ""
"For more information about Salt states, see "
"xref:specialized-guides:salt/salt-states-and-pillars.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບ Salt states, ໃຫ້ເບິ່ງ xref:specialized-guides:salt/salt-states-and-pillars.adoc[]."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-recurring-actions.adoc:4
msgid ""
"Currently, {productname} supports the following action types as recurring "
"actions:"
msgstr "ປະຈຸບັນ, {productname} ຮອງຮັບປະເພດການດຳເນີນການແບບຊ້ຳໆດັ່ງຕໍ່ໄປນີ້:"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-recurring-actions.adoc:5
msgid "[guimenu]``Highstate:`` Execute the highstate."
msgstr "[guimenu]``Highstate:`` ລັນ highstate."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-recurring-actions.adoc:6
msgid ""
"[guimenu]``Custom state:`` Execute a set of custom states. A custom state "
"can be either an internal state provided by {productname}, or a "
"configuration channel created by a user."
msgstr "[guimenu]``Custom state:`` ລັນຊຸດຂອງ state ທີ່ກຳນົດເອງ."

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-recurring-actions.adoc:8
#, no-wrap
msgid "Creating Recurring Actions"
msgstr "ການສ້າງການດຳເນີນການແບບຊ້ຳໆ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-recurring-actions.adoc:9
msgid ""
"To create new schedules, click the btn:[Create] icon on the top right "
"corner.  Choose a supported action type, give your recurring schedule a "
"name, select a time and day for it to recur, and click btn:[Create "
"Schedule].  Toggle the btn:[Test mode] switch to test the highstate before "
"you apply it."
msgstr "ຄລິກໄອຄອນ btn:[Create] ເພື່ອສ້າງຕາຕະລາງໃໝ່."

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-recurring-actions.adoc:12
#, no-wrap
msgid "Disabling Recurring Actions"
msgstr "ການປິດໃຊ້ການດຳເນີນການແບບຊ້ຳໆ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-recurring-actions.adoc:13
msgid ""
"Disabling an action stops the action recurring, but does not delete it.  To "
"disable a recurring action toggle the [guimenu]``Active`` switch off.  "
"Enable them again by toggling the [guimenu]``Active`` switch on.  Disabled "
"recurring actions remain in the list, but are not executed."
msgstr "ປິດການເຮັດວຽກຊົ່ວຄາວໂດຍການປິດສະວິດ [guimenu]``Active``."

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-recurring-actions.adoc:14
#, no-wrap
msgid "Editing Recurring Actions"
msgstr "ການແກ້ໄຂການດຳເນີນການແບບຊ້ຳໆ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-recurring-actions.adoc:15
msgid ""
"In the [guimenu]``Actions`` column, click the btn:[Edit] icon for the action "
"you want to change.  On the [guimenu]``Schedule Recurring Action`` page, the "
"existing properties are pre-filled.  Make your changes, and click "
"btn:[Update Schedule]."
msgstr "ຄລິກໄອຄອນ btn:[Edit] ເພື່ອແກ້ໄຂ."

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-recurring-actions.adoc:16
#, no-wrap
msgid "Deleting Recurring Actions"
msgstr "ການລຶບການດຳເນີນການແບບຊ້ຳໆ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-recurring-actions.adoc:17
msgid ""
"Deleting an action permanently removes it.  To start using the action again, "
"you will need to create a new action.  In the [guimenu]``Actions`` column, "
"click the btn:[Delete] icon for the action you want to delete, and confirm "
"the deletion."
msgstr "ຄລິກໄອຄອນ btn:[Delete] ເພື່ອລຶບຖາວອນ."

#. type: Title =
#: en/modules/reference/pages/systems/system-details/sd-remote-command.adoc:1
#, no-wrap
msgid "Remote Command"
msgstr "ຄຳສັ່ງທາງໄກ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-remote-command.adoc:2
msgid ""
"The menu:Systems[Details > Remote Command] section allows you to run "
"commands remotely on the selected client."
msgstr "ພາກສ່ວນ menu:Systems[Details > Remote Command] ຊ່ວຍໃຫ້ທ່ານລັນຄຳສັ່ງໃນເຄື່ອງລູກຂ່າຍຈາກທາງໄກ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-remote-command.adoc:3
msgid ""
"Before doing so, you must first configure the system to accept such "
"commands.  For more information about using remote commands, see "
"xref:administration:actions.adoc[]."
msgstr "ກະລຸນາຕັ້ງຄ່າລະບົບໃຫ້ຍອມຮັບຄຳສັ່ງທາງໄກກ່ອນ."

#. type: Title =
#: en/modules/reference/pages/systems/system-details/sd-software-channels.adoc:1
#, no-wrap
msgid "Software Channels"
msgstr "ຊ່ອງທາງຊອບແວ (Software Channels)"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-software-channels.adoc:2
msgid ""
"The menu:Systems[Software > Software Channels] section allows you to manage "
"the software channels on the current client.  For more information about "
"software channels, see xref:client-configuration:channels.adoc[]."
msgstr "ພາກສ່ວນ menu:Systems[Software > Software Channels] ຊ່ວຍໃຫ້ທ່ານຈັດການຊ່ອງທາງຊອບແວ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-software-channels.adoc:3
msgid ""
"The menu:Systems[Software > Software Channels] subtab is split into "
"sections:"
msgstr "ແຖບຍ່ອຍ menu:Systems[Software > Software Channels] ຖືກແບ່ງອອກເປັນພາກສ່ວນ:"

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-software-channels.adoc:4
#, no-wrap
msgid "Base Channel"
msgstr "ຊ່ອງທາງຫຼັກ (Base Channel)"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-software-channels.adoc:5
msgid ""
"This section shows the base channel the current client is subscribed to, as "
"well as any other available base channels."
msgstr "ພາກສ່ວນນີ້ສະແດງຊ່ອງທາງຫຼັກທີ່ເຄື່ອງລູກຂ່າຍລົງທະບຽນຢູ່."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-software-channels.adoc:6
msgid ""
"Click the chain icon next to a base channel to see more information about "
"the channel.  Change the base channel subscription by selecting the new base "
"channel, and click btn:[Next] to schedule the change."
msgstr "ຄລິກທີ່ໄອຄອນໂສ້ເພື່ອເບິ່ງຂໍ້ມູນຊ່ອງທາງ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-software-channels.adoc:7
msgid ""
"The child channels associated with the base channel are populated in the "
"[guimenu]``Child Channels`` section.  Mandatory child channels are "
"pre-selected.  Toggle the [guimienu]``include recommended`` switch to also "
"select recommended child channels."
msgstr "ຊ່ອງທາງຍ່ອຍຈະສະແດງໃນພາກສ່ວນ [guimenu]``Child Channels``."

#. type: delimited block =
#: en/modules/reference/pages/systems/system-details/sd-software-channels.adoc:8
msgid ""
"By default, cloned vendor channels match the original vendor channel and "
"automatically select the dependencies.  You can disable the automatic "
"selection for cloned channels by adding the following option in "
"[path]``/etc/rhn/rhn.conf``:"
msgstr "ໂດຍຄ່າເລີ່ມຕົ້ນ, ຊ່ອງທາງຂອງຜູ້ຜະລິດທີ່ຖືກສຳເນົາມາຈະກົງກັບຊ່ອງທາງຕົ້ນສະບັບ ແລະ ຈະເລືອກແພັກເກັດທີ່ກ່ຽວຂ້ອງ (dependencies) ໂດຍອັດຕະໂນມັດ. ທ່ານສາມາດປິດການເລືອກອັດຕະໂນມັດສຳລັບຊ່ອງທາງທີ່ສຳເນົາມາໄດ້ ໂດຍການເພີ່ມຕົວເລືອກຕໍ່ໄປນີ້ໃນ [path]``/etc/rhn/rhn.conf``:"

#. type: delimited block -
#: en/modules/reference/pages/systems/system-details/sd-software-channels.adoc:9
#, no-wrap
msgid "java.cloned_channel_auto_selection = false\n"
msgstr "java.cloned_channel_auto_selection = false\n"

#. type: delimited block =
#: en/modules/reference/pages/systems/system-details/sd-software-channels.adoc:10
msgid ""
"In general, channel pre-selection is necessary to avoid problems with "
"missing dependencies for a given channel but it only works flawlessly for "
"vendor channels.  For cloned channels, {productname} relies on the channel "
"label to define dependencies and use it in auto selection.  This heuristic "
"sometimes lead to either selecting unnecessary child channels or overlooking "
"some essential ones.  Users should exercise caution and pay attention in "
"such case that correct channels are selected."
msgstr ""

#. type: delimited block =
#: en/modules/reference/pages/systems/system-details/sd-software-channels.adoc:11
msgid "For Salt clients, apply the highstate after changing software channels."
msgstr "ສຳລັບເຄື່ອງລູກຂ່າຍ Salt, ໃຫ້ລັນ highstate ຫຼັງຈາກປ່ຽນຊ່ອງທາງຊອບແວ."

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-software-channels.adoc:12
#, no-wrap
msgid "Child Channels"
msgstr "ຊ່ອງທາງຍ່ອຍ"

#. type: delimited block =
#: en/modules/reference/pages/systems/system-details/sd-software-channels.adoc:13
msgid ""
"This section shows the software product and child channels associated with "
"the currently selected base channel."
msgstr "ພາກສ່ວນນີ້ສະແດງຊ່ອງທາງຍ່ອຍທີ່ກ່ຽວຂ້ອງກັບຊ່ອງທາງຫຼັກ."

#. type: delimited block =
#: en/modules/reference/pages/systems/system-details/sd-software-channels.adoc:14
msgid ""
"Hover over the information icon next to the channel name to see channel "
"requirements.  Click the chain icon next to a base channel to see more "
"information about the channel."
msgstr "ເອົາເມົາສ໌ໄປວາງທີ່ໄອຄອນຂໍ້ມູນເພື່ອເບິ່ງຂໍ້ກຳນົດຂອງຊ່ອງທາງ."

#. type: delimited block =
#: en/modules/reference/pages/systems/system-details/sd-software-channels.adoc:15
msgid ""
"Child channels are can be either recommended or mandatory.  Mandatory child "
"channels must be installed for the selected client to use the associated "
"base channel.  Recommended child channels should be installed to provide "
"additional packages.  All other child channels are optional."
msgstr ""

#. type: delimited block =
#: en/modules/reference/pages/systems/system-details/sd-software-channels.adoc:16
msgid ""
"Check the child channels you want to install, and click btn:[Next] to "
"schedule the change."
msgstr "ເລືອກຊ່ອງທາງຍ່ອຍທີ່ຕ້ອງການແລ້ວຄລິກ btn:[Next]."

#. type: Title =
#: en/modules/reference/pages/systems/system-details/sd-software.adoc:1
#, no-wrap
msgid "Software"
msgstr "ຊອບແວ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-software.adoc:2
msgid ""
"The menu:Systems[Software] section allows you to manage software on the "
"selected client."
msgstr "ພາກສ່ວນ menu:Systems[Software] ຊ່ວຍໃຫ້ທ່ານຈັດການຊອບແວໃນເຄື່ອງລູກຂ່າຍ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-states.adoc:2
msgid ""
"The menu:Systems[States] section allows you to manage Salt states on the "
"selected client.  States provide configuration templates for Salt clients.  "
"Applying the highstate applies all outstanding Salt states.  This is only "
"available for Salt clients."
msgstr "ພາກສ່ວນ menu:Systems[States] ຊ່ວຍໃຫ້ຈັດການ Salt states."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-states.adoc:4
msgid "The menu:Systems[States] subtab is split into sections:"
msgstr "ແຖບຍ່ອຍ menu:Systems[States] ຖືກແບ່ງອອກເປັນພາກສ່ວນ:"

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-states.adoc:5
#, no-wrap
msgid "Highstate"
msgstr "ໄຮສະເຕດ (Highstate)"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-states.adoc:6
msgid ""
"This section provides details of the highstate for the selected client.  It "
"includes a state summary for the selected client, showing a list of states, "
"formulas, and configuration channels.  To schedule a time to apply the "
"highstate, select the date and time and click btn:[Apply Hightstate].  "
"Toggle the btn:[Test mode] switch to test the highstate before you apply it."
msgstr "ພາກສ່ວນນີ້ໃຫ້ລາຍລະອຽດກ່ຽວກັບ highstate ຂອງເຄື່ອງລູກຂ່າຍ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-states.adoc:8
msgid ""
"This section allows you to manage package states for the selected client.  "
"Package states determine which packages and versions should be installed on "
"the selected client."
msgstr "ພາກສ່ວນນີ້ຊ່ວຍໃຫ້ຈັດການສະຖານະຂອງແພັກເກັດ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-states.adoc:9
msgid ""
"Use the search tool to search for the package you want to change.  To set "
"the package state to install the package, select [guimenu]``Installed`` as "
"the new state.  To always upgrade the package to the latest version, select "
"[guimenu]``latest``.  Click btn:[Save] to save the changes to the state.  "
"Click btn:[Apply changes] to apply the new package state to the selected "
"client."
msgstr "ໃຊ້ເຄື່ອງມືຄົ້ນຫາເພື່ອຫາແພັກເກັດທີ່ຕ້ອງການປ່ຽນສະຖານະ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-states.adoc:10
#: en/modules/reference/pages/systems/system-details/sd-states.adoc:14
msgid ""
"Use the [guimenu]``Changes`` subtab to see what changes will occur on the "
"selected client when this state is applied."
msgstr "ໃຊ້ແຖບຍ່ອຍ [guimenu]``Changes`` ເພື່ອເບິ່ງການປ່ຽນແປງທີ່ຈະເກີດຂຶ້ນ."

#. type: Title ==
#: en/modules/reference/pages/systems/system-details/sd-states.adoc:11
#, no-wrap
msgid "Configuration Channels"
msgstr "ຊ່ອງທາງການຕັ້ງຄ່າ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-states.adoc:12
msgid ""
"This section allows you to manage configuration channels for the selected "
"client."
msgstr "ພາກສ່ວນນີ້ຊ່ວຍໃຫ້ຈັດການຊ່ອງທາງການຕັ້ງຄ່າ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-states.adoc:13
msgid ""
"Use the search tool to search for the configuration channel you want to "
"manage.  This section shows the list of configuration channels that are "
"available for the selected client to subscribe to.  To subscribe the "
"selected client to a configuration channel, check the channel, and click "
"btn:[Apply]."
msgstr "ຄົ້ນຫາຊ່ອງທາງການຕັ້ງຄ່າທີ່ຕ້ອງການຈັດການ."

#. type: Title =
#: en/modules/reference/pages/systems/system-details/sd-transfer.adoc:1
#, no-wrap
msgid "Transfer"
msgstr "ການຍ້າຍ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-transfer.adoc:2
msgid ""
"The menu:Systems[Details > Transfer] section allows you to move clients "
"between organizations.  Clients can only belong to one organization at any "
"time."
msgstr "ພາກສ່ວນ menu:Systems[Details > Transfer] ຊ່ວຍໃຫ້ທ່ານຍ້າຍເຄື່ອງລູກຂ່າຍລະຫວ່າງອົງກອນ."

#. type: delimited block =
#: en/modules/reference/pages/systems/system-details/sd-transfer.adoc:3
msgid ""
"You will need to establish trust between organizations when you want to move "
"clients.  For more information, see "
"xref:administration:organizations.adoc[]."
msgstr "ທ່ານຕ້ອງສ້າງຄວາມເຊື່ອຖື (trust) ລະຫວ່າງອົງກອນກ່ອນ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-details/sd-transfer.adoc:4
msgid ""
"To move a client to a different organization, select the name of the "
"organization in the [guimenu]``Organization Name`` field, and click "
"btn:[Migrate System]."
msgstr "ເລືອກຊື່ອົງກອນແລ້ວຄລິກ btn:[Migrate System]."

#. type: delimited block =
#: en/modules/reference/pages/systems/system-details/sd-transfer.adoc:5
msgid ""
"When you move a client to a different organization, channel assignments, "
"system group membership, custom data values, configuration channels, "
"reactivation keys, and snapshots are deleted from the system configuration.  "
"You will need to set these values again when the move is complete."
msgstr "ເມື່ອຍ້າຍອົງກອນ, ການຕັ້ງຄ່າບາງຢ່າງຈະຖືກລຶບອອກ ແລະ ທ່ານຕ້ອງຕັ້ງຄ່າໃໝ່."

#. type: Title =
#: en/modules/reference/pages/systems/system-groups.adoc:1
#, no-wrap
msgid "System Groups"
msgstr "ກຸ່ມລະບົບ"

#. type: Plain text
#: en/modules/reference/pages/systems/system-groups.adoc:2
msgid ""
"The menu:Systems[System Groups] section displays the list of system groups "
"in your organization."
msgstr "ພາກສ່ວນ menu:Systems[System Groups] ສະແດງລາຍຊື່ກຸ່ມລະບົບໃນອົງກອນ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-groups.adoc:3
msgid ""
"Click the name of a group to work with it, or to add or delete clients in "
"the group."
msgstr "ຄລິກທີ່ຊື່ກຸ່ມເພື່ອຈັດການສະມາຊິກ."

#. type: Plain text
#: en/modules/reference/pages/systems/system-groups.adoc:4
msgid ""
"The list shows an icon if there are updates available for any of the clients "
"in the group.  Click the icon to see more information about the updates "
"available."
msgstr "ຫາກມີການອັບເດດ ຈະມີໄອຄອນສະແດງໃຫ້ເຫັນ."

#. type: Block title
#: en/modules/reference/pages/systems/system-groups.adoc:5
#, no-wrap
msgid "Update Status Icons"
msgstr "ໄອຄອນສະຖານະການອັບເດດ"

#. type: Table
#: en/modules/reference/pages/systems/system-groups.adoc:6
#, no-wrap
msgid ""
"| Icon\n"
"| Description\n"
"| Action Required\n"
"\n"
"| icon:check-circle[role=\"green\"]\n"
"| No applicable updates\n"
"| All clients in this group are up to date\n"
"\n"
"| icon:exclamation-triangle[role=\"yellow\"]\n"
"| Updates available\n"
"| One or more clients have updates ready to install\n"
"\n"
"| icon:exclamation-circle[role=\"red\"]\n"
"| Security updates needed\n"
"| One or more clients have security updates that must be installed\n"
"\n"
"| icon:question-circle[role=\"blue\"]\n"
"| Status unknown\n"
"| Displaying status of available updates is disabled\n"
"\n"
msgstr ""
"| ໄອຄອນ\n"
"| ຄຳອະທິບາຍ\n"
"| ສິ່ງທີ່ຕ້ອງເຮັດ\n"
"\n"
"| icon:check-circle[role=\"green\"]\n"
"| ບໍ່ມີການອັບເດດໃໝ່\n"
"| ທຸກເຄື່ອງລູກຂ່າຍເປັນເວີຊັນຫຼ້າສຸດແລ້ວ\n"
"\n"
"| icon:exclamation-triangle[role=\"yellow\"]\n"
"| ມີການອັບເດດໃໝ່\n"
"| ມີບາງເຄື່ອງທີ່ມີການອັບເດດພ້ອມຕິດຕັ້ງ\n"
"\n"
"| icon:exclamation-circle[role=\"red\"]\n"
"| ຕ້ອງການການອັບເດດຄວາມປອດໄພ\n"
"| ຕ້ອງຕິດຕັ້ງການອັບເດດຄວາມປອດໄພໂດຍດ່ວນ\n"
"\n"
"| icon:question-circle[role=\"blue\"]\n"
"| ບໍ່ຊາບສະຖານະ\n"
"| ການສະແດງສະຖານະອັບເດດຖືກປິດໄວ້\n"
"\n"

#. type: Title =
#: en/modules/reference/pages/systems/systems-list.adoc:1
#, no-wrap
msgid "Systems List"
msgstr "ລາຍຊື່ລະບົບ"

#. type: Plain text
#: en/modules/reference/pages/systems/systems-list.adoc:2
msgid ""
"The menu:Systems[System List] section lists all clients available in your "
"{productname} environment."
msgstr "ພາກສ່ວນ menu:Systems[System List] ສະແດງລາຍຊື່ເຄື່ອງລູກຂ່າຍທັງໝົດ."

#. type: Plain text
#: en/modules/reference/pages/systems/systems-list.adoc:5
msgid "The menu:Systems[System List] section is split into submenus:"
msgstr "ພາກສ່ວນ menu:Systems[System List] ຖືກແບ່ງອອກເປັນເມນູຍ່ອຍ:"

#. type: Title ==
#: en/modules/reference/pages/systems/systems-list.adoc:6
#, no-wrap
msgid "All"
msgstr "ທັງໝົດ"

#. type: Plain text
#: en/modules/reference/pages/systems/systems-list.adoc:7
msgid ""
"The menu:Systems[System List > All] section lists every client that you have "
"permission to manage."
msgstr "ສະແດງທຸກເຄື່ອງລູກຂ່າຍທີ່ທ່ານມີສິດຈັດການ."

#. type: Title ==
#: en/modules/reference/pages/systems/systems-list.adoc:8
#, no-wrap
msgid "Physical Systems"
msgstr "ລະບົບກາຍະພາບ (Physical Systems)"

#. type: Plain text
#: en/modules/reference/pages/systems/systems-list.adoc:9
msgid ""
"The menu:Systems[System List > Physical Systems] section lists every client "
"that is installed on physical hardware."
msgstr "ສະແດງເຄື່ອງລູກຂ່າຍທີ່ຕິດຕັ້ງໃນຮາດແວຈິງ."

#. type: Title ==
#: en/modules/reference/pages/systems/systems-list.adoc:10
#, no-wrap
msgid "Unprovisioned Systems"
msgstr "ລະບົບທີ່ຍັງບໍ່ທັນຕິດຕັ້ງ"

#. type: Plain text
#: en/modules/reference/pages/systems/systems-list.adoc:11
msgid ""
"The menu:Systems[System List > Unprovisioned Systems] section lists every "
"bare metal client that the {productname} Server is aware of, but has not yet "
"been registered."
msgstr "ສະແດງລາຍຊື່ bare metal ທີ່ເຊີເວີຮັບຮູ້ແຕ່ຍັງບໍ່ທັນໄດ້ລົງທະບຽນ."

#. type: Plain text
#: en/modules/reference/pages/systems/systems-list.adoc:12
msgid ""
"For more information about bare metal clients, see "
"xref:client-configuration:autoinst-intro.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບ bare metal, ເບິ່ງໄດ້ທີ່ xref:client-configuration:autoinst-intro.adoc[]."

#. type: Title ==
#: en/modules/reference/pages/systems/systems-list.adoc:13
#, no-wrap
msgid "Out of Date"
msgstr "ບໍ່ເປັນປະຈຸບັນ (Out of Date)"

#. type: Plain text
#: en/modules/reference/pages/systems/systems-list.adoc:14
msgid ""
"The menu:Systems[System List > Out of Date] section lists every client that "
"has available updates."
msgstr "ສະແດງເຄື່ອງລູກຂ່າຍທີ່ມີການອັບເດດໃໝ່."

#. type: Plain text
#: en/modules/reference/pages/systems/systems-list.adoc:15
msgid ""
"For more information about managing client updates, see "
"xref:client-configuration:package-management.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການຈັດການການອັບເດດ, ເບິ່ງໄດ້ທີ່ xref:client-configuration:package-management.adoc[]."

#. type: Title ==
#: en/modules/reference/pages/systems/systems-list.adoc:16
#, no-wrap
msgid "Requiring Reboot"
msgstr "ຕ້ອງການເລີ່ມລະບົບໃໝ່"

#. type: Plain text
#: en/modules/reference/pages/systems/systems-list.adoc:17
msgid ""
"The menu:Systems[System List > Requiring Reboot] section lists every client "
"that requires rebooting."
msgstr "ສະແດງເຄື່ອງລູກຂ່າຍທີ່ຕ້ອງໄດ້ reboot."

#. type: Plain text
#: en/modules/reference/pages/systems/systems-list.adoc:19
msgid ""
"The menu:Systems[System List > Non Compliant] section lists every client "
"that has non-compliant packages installed.  Packages are considered "
"non-compliant if they have been installed from a source other than "
"{productname}.  In the list, the [guimenu]``Extra Packages`` column shows "
"the number of non-compliant packages on the client.  If there is at least "
"one non-compliant package, you can click the number to display listings of "
"those non-compliant packages per system."
msgstr "ສະແດງເຄື່ອງລູກຂ່າຍທີ່ມີແພັກເກັດທີ່ບໍ່ສອດຄ່ອງ (ຕິດຕັ້ງຈາກບ່ອນອື່ນ)."

#. type: Title ==
#: en/modules/reference/pages/systems/systems-list.adoc:20
#, no-wrap
msgid "Without System Type"
msgstr "ບໍ່ມີປະເພດລະບົບ"

#. type: Plain text
#: en/modules/reference/pages/systems/systems-list.adoc:21
msgid ""
"The menu:Systems[System List > Without System Type] section lists every "
"client that does not have a base system type recorded."
msgstr "ສະແດງເຄື່ອງລູກຂ່າຍທີ່ຍັງບໍ່ທັນມີການລະບຸປະເພດລະບົບຫຼັກ."

#. type: Plain text
#: en/modules/reference/pages/systems/systems-list.adoc:22
#: en/modules/reference/pages/systems/systems-list.adoc:40
msgid ""
"For more information about system types, see "
"xref:client-configuration:system-types.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບປະເພດລະບົບ, ເບິ່ງໄດ້ທີ່ xref:client-configuration:system-types.adoc[]."

#. type: Title ==
#: en/modules/reference/pages/systems/systems-list.adoc:23
#, no-wrap
msgid "Ungrouped"
msgstr "ບໍ່ໄດ້ຈັດກຸ່ມ"

#. type: Plain text
#: en/modules/reference/pages/systems/systems-list.adoc:24
msgid ""
"The menu:Systems[System List > Ungroups] section lists every client that is "
"not assigned to a system group."
msgstr "ສະແດງເຄື່ອງລູກຂ່າຍທີ່ຍັງບໍ່ທັນໄດ້ສັງກັດກຸ່ມລະບົບໃດໜຶ່ງ."

#. type: Title ==
#: en/modules/reference/pages/systems/systems-list.adoc:26
#, no-wrap
msgid "Inactive"
msgstr "ບໍ່ໄດ້ໃຊ້ງານ"

#. type: Plain text
#: en/modules/reference/pages/systems/systems-list.adoc:27
msgid ""
"The menu:Systems[System List > Inactive] section lists every client that has "
"not checked in with the {productname} Server in 24 hours or more."
msgstr "ສະແດງເຄື່ອງລູກຂ່າຍທີ່ບໍ່ໄດ້ຕິດຕໍ່ຫາເຊີເວີເກີນ 24 ຊົ່ວໂມງ."

#. type: Plain text
#: en/modules/reference/pages/systems/systems-list.adoc:28
msgid ""
"For more information about client connections to the server, see "
"xref:client-configuration:contact-methods-intro.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການເຊື່ອມຕໍ່ເຄື່ອງລູກຂ່າຍຫາເຊີເວີ, ໃຫ້ເບິ່ງທີ່ xref:client-configuration:contact-methods-intro.adoc[]."

#. type: Plain text
#: en/modules/reference/pages/systems/systems-list.adoc:29
msgid ""
"For more information on troubleshooting inactive clients, see "
"xref:administration:troubleshooting/tshoot-inactiveclients.adoc[]."
msgstr "ສຳລັບວິທີແກ້ໄຂບັນຫາເຄື່ອງລູກຂ່າຍທີ່ບໍ່ໄດ້ໃຊ້ງານ, ເບິ່ງໄດ້ທີ່ xref:administration:troubleshooting/tshoot-inactiveclients.adoc[]."

#. type: Title ==
#: en/modules/reference/pages/systems/systems-list.adoc:30
#, no-wrap
msgid "Recently Registered"
msgstr "ລົງທະບຽນເມື່ອບໍ່ດົນມານີ້"

#. type: Plain text
#: en/modules/reference/pages/systems/systems-list.adoc:31
msgid ""
"The menu:Systems[System List > Recently Registered] section lists every "
"client that has registered within a given period.  Select the period to view "
"from the [guimenu]``View systems registered`` field."
msgstr "ສະແດງເຄື່ອງລູກຂ່າຍທີ່ຫາກໍ່ລົງທະບຽນໃໝ່."

#. type: Plain text
#: en/modules/reference/pages/systems/systems-list.adoc:33
msgid ""
"The menu:Systems[System List > Proxy] section lists every client that is "
"registered as a proxy."
msgstr "ສະແດງເຄື່ອງລູກຂ່າຍທີ່ລົງທະບຽນເປັນພຣັອກຊີ."

#. type: Title ==
#: en/modules/reference/pages/systems/systems-list.adoc:34
#, no-wrap
msgid "Duplicate Systems"
msgstr "ລະບົບທີ່ຊ້ຳກັນ"

#. type: Plain text
#: en/modules/reference/pages/systems/systems-list.adoc:35
msgid ""
"The menu:Systems[System List > Duplicate Systems] section lists clients that "
"share IP addresses, host names, or MAC addresses.  Use the tabs to compare "
"clients."
msgstr "ສະແດງເຄື່ອງລູກຂ່າຍທີ່ມີ IP, hostname ຫຼື MAC ຊ້ຳກັນ."

#. type: Title ==
#: en/modules/reference/pages/systems/systems-list.adoc:36
#, no-wrap
msgid "System Currency"
msgstr "ຄະແນນຄວາມທັນສະໄໝ (System Currency)"

#. type: Plain text
#: en/modules/reference/pages/systems/systems-list.adoc:37
msgid ""
"The menu:Systems[System List > System Currency] section lists all clients "
"with information about available updates, and provides a currency score for "
"each.  You can use the currency score to determine in which order clients "
"should be updated.  A score with a larger number indicates that a client is "
"not current, and might require critical updates."
msgstr "ສະແດງຄະແນນຄວາມທັນສະໄໝຂອງແຕ່ລະລະບົບ ເພື່ອຊ່ວຍໃນການຈັດລຳດັບການອັບເດດ."

#. type: Title ==
#: en/modules/reference/pages/systems/systems-list.adoc:38
#, no-wrap
msgid "System Types"
msgstr "ປະເພດລະບົບ"

#. type: Plain text
#: en/modules/reference/pages/systems/systems-list.adoc:39
msgid ""
"The menu:Systems[System List > System Types] section lists every client, "
"their base system type, add-on system type, and base channel.  It also gives "
"a count of clients of each system type."
msgstr "ສະແດງລາຍຊື່ເຄື່ອງລູກຂ່າຍແບ່ງຕາມປະເພດລະບົບ."

#. type: Plain text
#: en/modules/reference/pages/systems/systems-menu.adoc:2
msgid "The [guimenu]``Systems`` section allows you to manage your client systems."
msgstr "ພາກສ່ວນ [guimenu]``Systems`` ຊ່ວຍໃຫ້ທ່ານຈັດການລະບົບເຄື່ອງລູກຂ່າຍ."

#. type: Plain text
#: en/modules/reference/pages/systems/systems-menu.adoc:3
msgid ""
"The menu:Systems[] menu contains submenu entries in the left navigation bar "
"and as its overview page displays the menu:Systems[System List > All] "
"listing with all client systems registered to the {productname} Server."
msgstr "ເມນູ menu:Systems[] ປະກອບມີເມນູຍ່ອຍຢູ່ໃນແຖບດ້ານຊ້າຍ."

#. type: Plain text
#: en/modules/reference/pages/systems/systems-menu.adoc:4
msgid ""
"This listing contains information about the clients, including available "
"software updates, extra packages (otherwise often referenced as "
"non-compliant packages), and the base channel they are subscribed to."
msgstr "ລາຍຊື່ນີ້ມີຂໍ້ມູນກ່ຽວກັບເຄື່ອງລູກຂ່າຍ, ລວມເຖິງການອັບເດດ ແລະ ຊ່ອງທາງຫຼັກ."

#. type: Plain text
#: en/modules/reference/pages/systems/systems-menu.adoc:5
msgid "All the submenu entries:"
msgstr "ເມນູຍ່ອຍທັງໝົດ:"

#. type: Plain text
#: en/modules/reference/pages/systems/systems-menu.adoc:6
#, no-wrap
msgid ""
"[guimenu]``System List``          - "
"xref:reference:systems/systems-list.adoc[]\n"
msgstr "[guimenu]``ລາຍຊື່ລະບົບ``          - xref:reference:systems/systems-list.adoc[]\n"

#. type: Plain text
#: en/modules/reference/pages/systems/systems-menu.adoc:7
#, no-wrap
msgid ""
"[guimenu]``System Groups``\t    - "
"xref:reference:systems/system-groups.adoc[]\n"
msgstr "[guimenu]``ກຸ່ມລະບົບ``\t    - xref:reference:systems/system-groups.adoc[]\n"

#. type: Plain text
#: en/modules/reference/pages/systems/systems-menu.adoc:8
#, no-wrap
msgid "[guimenu]``System Set Manager``   - xref:reference:systems/ssm-menu.adoc[]\n"
msgstr "[guimenu]``ຕົວຈັດການຊຸດລະບົບ``   - xref:reference:systems/ssm-menu.adoc[]\n"

#. type: Plain text
#: en/modules/reference/pages/systems/systems-menu.adoc:9
#, no-wrap
msgid ""
"[guimenu]``Bootstrapping``\t    - "
"xref:reference:systems/bootstrapping.adoc[]\n"
msgstr "[guimenu]``ການບູດສະແຕຣັບ``\t    - xref:reference:systems/bootstrapping.adoc[]\n"

#. type: Plain text
#: en/modules/reference/pages/systems/systems-menu.adoc:10
#, no-wrap
msgid ""
"[guimenu]``Proxy Configuration``  - "
"xref:reference:systems/proxy-configuration.adoc[]\n"
msgstr "[guimenu]``ການຕັ້ງຄ່າພຣັອກຊີ``  - xref:reference:systems/proxy-configuration.adoc[]\n"

#. type: Plain text
#: en/modules/reference/pages/systems/systems-menu.adoc:11
#, no-wrap
msgid ""
"[guimenu]``Advanced Search``\t    - "
"xref:reference:systems/advanced-search.adoc[]\n"
msgstr "[guimenu]``ການຄົ້ນຫາຂັ້ນສູງ``\t    - xref:reference:systems/advanced-search.adoc[]\n"

#. type: Plain text
#: en/modules/reference/pages/systems/systems-menu.adoc:12
#, no-wrap
msgid ""
"[guimenu]``Activation Keys``\t    - "
"xref:reference:systems/activation-keys.adoc[]\n"
msgstr "[guimenu]``ຄີການເປີດໃຊ້``\t    - xref:reference:systems/activation-keys.adoc[]\n"

#. type: Plain text
#: en/modules/reference/pages/systems/systems-menu.adoc:13
#, no-wrap
msgid ""
"[guimenu]``Stored Profiles``\t    - "
"xref:reference:systems/stored-profiles.adoc[]\n"
msgstr "[guimenu]``ໂປຣໄຟລ໌ທີ່ເກັບໄວ້``\t    - xref:reference:systems/stored-profiles.adoc[]\n"

#. type: Plain text
#: en/modules/reference/pages/systems/systems-menu.adoc:14
#, no-wrap
msgid ""
"[guimenu]``Custom System Info``   - "
"xref:reference:systems/custom-system-info.adoc[]\n"
msgstr "[guimenu]``ຂໍ້ມູນລະບົບທີ່ກຳນົດເອງ``   - xref:reference:systems/custom-system-info.adoc[]\n"

#. type: Plain text
#: en/modules/reference/pages/systems/systems-menu.adoc:15
#, no-wrap
msgid ""
"[guimenu]``Autoinstallation``\t    - "
"xref:reference:systems/autoinst-menu.adoc[]\n"
msgstr "[guimenu]``ການຕິດຕັ້ງອັດຕະໂນມັດ``\t    - xref:reference:systems/autoinst-menu.adoc[]\n"

#. type: Plain text
#: en/modules/reference/pages/systems/systems-menu.adoc:16
#, no-wrap
msgid ""
"[guimenu]``Virtual Host Managers` - "
"xref:reference:systems/virtual-host-managers.adoc[]`\n"
msgstr "[guimenu]``ຕົວຈັດການ Virtual Host` - xref:reference:systems/virtual-host-managers.adoc[]`\n"

#. type: Plain text
#: en/modules/reference/pages/systems/systems-menu.adoc:17
msgid ""
"Click the name of a client to go to that client system's "
"[guimenu]``Details`` overview page and all its tabs and subtabs.  For more "
"information about the [guimenu]``System Details`` overview page in the "
"{webui}, see xref:reference:systems/system-details/sd-details.adoc[]."
msgstr "ຄລິກທີ່ຊື່ເຄື່ອງລູກຂ່າຍເພື່ອເບິ່ງລາຍລະອຽດທັງໝົດ."

#. type: Plain text
#: en/modules/reference/pages/systems/systems-menu.adoc:18
msgid ""
"Check a client to add it to the system set manager.  For more information "
"about the system set manager, see "
"xref:client-configuration:system-set-manager.adoc[]."
msgstr "ເລືອກເຄື່ອງລູກຂ່າຍເພື່ອເພີ່ມເຂົ້າໃນຕົວຈັດການຊຸດລະບົບ (SSM)."

#. type: Plain text
#: en/modules/reference/pages/systems/systems-menu.adoc:19
msgid ""
"Click btn:[Add Systems] to go to menu:Systems[Bootstrapping].  For more "
"about bootstrapping new clients, see "
"xref:reference:systems/bootstrapping.adoc[]."
msgstr "ຄລິກ btn:[Add Systems] ເພື່ອໄປທີ່ໜ້າການບູດສະແຕຣັບ."

#. type: Title =
#: en/modules/reference/pages/systems/virtual-host-managers.adoc:1
#, no-wrap
msgid "Virtual Host Managers"
msgstr "ຕົວຈັດການ Virtual Host"

#. type: Plain text
#: en/modules/reference/pages/systems/virtual-host-managers.adoc:2
msgid ""
"The menu:Systems[Virtual Host Managers] section lists the active virtual "
"host managers (VHMs)."
msgstr "ພາກສ່ວນ menu:Systems[Virtual Host Managers] ສະແດງຕົວຈັດການ virtual host ທີ່ເຮັດວຽກຢູ່."

#. type: Plain text
#: en/modules/reference/pages/systems/virtual-host-managers.adoc:3
msgid ""
"VHMs can be used to collect private or public cloud instances and organize "
"them into virtualization groups."
msgstr "VHMs ໃຊ້ສຳລັບຮວບຮວມ cloud instances ເຂົ້າໃນກຸ່ມ."

#. type: Plain text
#: en/modules/reference/pages/systems/virtual-host-managers.adoc:4
msgid "For more information about VHMs, see xref:client-configuration:vhm.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບ VHMs, ເບິ່ງໄດ້ທີ່ xref:client-configuration:vhm.adoc[]."

#. type: Title =
#: en/modules/reference/pages/users/active-users.adoc:1
#, no-wrap
msgid "Active Users"
msgstr "ຜູ້ໃຊ້ທີ່ເປີດໃຊ້ງານ"

#. type: Plain text
#: en/modules/reference/pages/users/active-users.adoc:2
msgid ""
"The menu:Users[User List > Active] section shows all active users in your "
"{productname} Server."
msgstr "ພາກສ່ວນ menu:Users[User List > Active] ສະແດງຜູ້ໃຊ້ທັງໝົດທີ່ກຳລັງເປີດໃຊ້ງານຢູ່ໃນເຊີເວີ."

#. type: Plain text
#: en/modules/reference/pages/users/active-users.adoc:3
msgid ""
"Each user in the list shows the username, real name, assigned roles, and the "
"date the user last signed in.  Click btn:[Create User] to create a new user "
"account.  Click the username to go to the [guimenu]``User Details`` page."
msgstr "ຄລິກ btn:[Create User] ເພື່ອສ້າງບັນຊີຜູ້ໃຊ້ໃໝ່."

#. type: Plain text
#: en/modules/reference/pages/users/active-users.adoc:4
#: en/modules/reference/pages/users/all-users.adoc:4
#: en/modules/reference/pages/users/deactivated-users.adoc:5
#: en/modules/reference/pages/users/user-details.adoc:3
#: en/modules/reference/pages/users/users-menu.adoc:4
msgid ""
"For more information about managing users, see "
"xref:administration:users.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການຈັດການຜູ້ໃຊ້, ເບິ່ງໄດ້ທີ່ xref:administration:users.adoc[]."

#. type: Title =
#: en/modules/reference/pages/users/all-users.adoc:1
#, no-wrap
msgid "All Users"
msgstr "ຜູ້ໃຊ້ທັງໝົດ"

#. type: Plain text
#: en/modules/reference/pages/users/all-users.adoc:2
msgid ""
"The menu:Users[User List > All] section shows all activated and deactivated "
"users in your {productname} Server.  Deleted users are not shown in the "
"list."
msgstr "ພາກສ່ວນ menu:Users[User List > All] ສະແດງທັງຜູ້ໃຊ້ທີ່ເປີດ ແລະ ປິດໃຊ້ງານ."

#. type: Plain text
#: en/modules/reference/pages/users/all-users.adoc:3
msgid ""
"Each user in the list shows the username, real name, assigned roles, the "
"date the user last signed in, and the current status of the user.  Click "
"btn:[Create User] to create a new user account.  Click the username to go to "
"the [guimenu]``User Details`` page."
msgstr "ສະແດງຂໍ້ມູນທົ່ວໄປ ແລະ ສະຖານະຂອງຜູ້ໃຊ້ແຕ່ລະຄົນ."

#. type: Title =
#: en/modules/reference/pages/users/deactivated-users.adoc:1
#, no-wrap
msgid "Deactivated Users"
msgstr "ຜູ້ໃຊ້ທີ່ຖືກປິດໃຊ້ງານ"

#. type: Plain text
#: en/modules/reference/pages/users/deactivated-users.adoc:2
msgid ""
"The menu:Users[User List > Deactivated] section shows all deactivated users "
"in your {productname} Server."
msgstr "ພາກສ່ວນ menu:Users[User List > Deactivated] ສະແດງຜູ້ໃຊ້ທີ່ຖືກປິດການໃຊ້ງານ."

#. type: Plain text
#: en/modules/reference/pages/users/deactivated-users.adoc:3
msgid ""
"Each user in the list shows the username, real name, assigned roles, the "
"date the user last signed in, the user who deactivated the account, and the "
"date the account was deactivated.  Click btn:[Create User] to create a new "
"user account.  Click the username to go to the [guimenu]``User Details`` "
"page."
msgstr ""

#. type: Plain text
#: en/modules/reference/pages/users/deactivated-users.adoc:4
msgid ""
"To reactivate a user, check the username in the list and click "
"btn:[Reactivate]."
msgstr "ເພື່ອເປີດໃຊ້ງານຄືນໃໝ່, ໃຫ້ເລືອກຊື່ຜູ້ໃຊ້ແລ້ວຄລິກ btn:[Reactivate]."

#. type: Title =
#: en/modules/reference/pages/users/system-group-configuration.adoc:1
#, no-wrap
msgid "System Group Configuration"
msgstr "ການຕັ້ງຄ່າກຸ່ມລະບົບ"

#. type: Plain text
#: en/modules/reference/pages/users/system-group-configuration.adoc:2
msgid ""
"The menu:Users[System Configuration] section allows you to configure system "
"groups for your users."
msgstr "ພາກສ່ວນ menu:Users[System Configuration] ຊ່ວຍໃຫ້ທ່ານຕັ້ງຄ່າກຸ່ມລະບົບສຳລັບຜູ້ໃຊ້."

#. type: Plain text
#: en/modules/reference/pages/users/system-group-configuration.adoc:3
msgid ""
"System groups allow you to grant permissions to a group of users, instead of "
"granting permissions to individuals.  This is particularly useful if you "
"have many users."
msgstr "ກຸ່ມລະບົບຊ່ວຍໃຫ້ທ່ານກຳນົດສິດເປັນກຸ່ມໄດ້ງ່າຍຂຶ້ນ."

#. type: Plain text
#: en/modules/reference/pages/users/system-group-configuration.adoc:4
msgid ""
"You can also configure system groups for users that have been externally "
"authenticated."
msgstr "ທ່ານຍັງສາມາດຕັ້ງຄ່າກຸ່ມສຳລັບຜູ້ໃຊ້ທີ່ຢັ້ງຢືນຕົວຕົນຈາກພາຍນອກ."

#. type: Plain text
#: en/modules/reference/pages/users/system-group-configuration.adoc:5
msgid ""
"For more information about managing users with system groups, see "
"xref:administration:users.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການຈັດການຜູ້ໃຊ້ດ້ວຍກຸ່ມລະບົບ, ເບິ່ງໄດ້ທີ່ xref:administration:users.adoc[]."

#. type: Title =
#: en/modules/reference/pages/users/user-details.adoc:1
#, no-wrap
msgid "User Details"
msgstr "ລາຍລະອຽດຜູ້ໃຊ້"

#. type: Plain text
#: en/modules/reference/pages/users/user-details.adoc:2
msgid ""
"The [guimenu]``User Details`` section provides additional details about the "
"user account, and allows you to manage permissions for the user.  You can "
"also deactivate or delete users from this section."
msgstr "ພາກສ່ວນ [guimenu]``User Details`` ສະແດງຂໍ້ມູນລະອຽດ ແລະ ຈັດການສິດຂອງຜູ້ໃຊ້."

#. type: Plain text
#: en/modules/reference/pages/users/user-details.adoc:4
msgid "The [guimenu]``User Details`` section is split into tabs:"
msgstr "ພາກສ່ວນ [guimenu]``User Details`` ຖືກແບ່ງອອກເປັນແຖບ:"

#. type: Plain text
#: en/modules/reference/pages/users/user-details.adoc:6
msgid ""
"This tab allows you to change the name and password of the user account, and "
"provides information about the various permissions the user has assigned."
msgstr "ແຖບນີ້ຊ່ວຍໃຫ້ປ່ຽນຊື່, ລະຫັດຜ່ານ ແລະ ເບິ່ງສິດການໃຊ້ງານ."

#. type: Plain text
#: en/modules/reference/pages/users/user-details.adoc:7
msgid ""
"Use this section to assign or remove roles, except for the {productname} "
"Administrator.  To change a user's {productname} Administrator role, "
"navigate to menu:Admin[Users] and check or uncheck [guimenu]``{productname} "
"Admin?`` as required."
msgstr "ໃຊ້ພາກສ່ວນນີ້ເພື່ອເພີ່ມ ຫຼື ລຶບບົດບາດ (roles)."

#. type: Title ==
#: en/modules/reference/pages/users/user-details.adoc:8
#, no-wrap
msgid "System Groups"
msgstr "ກຸ່ມລະບົບ"

#. type: Plain text
#: en/modules/reference/pages/users/user-details.adoc:9
msgid ""
"This tab shows the system groups the user is assigned to.  Check or uncheck "
"system groups as required."
msgstr "ແຖບນີ້ສະແດງກຸ່ມລະບົບທີ່ຜູ້ໃຊ້ສັງກັດຢູ່."

#. type: Plain text
#: en/modules/reference/pages/users/user-details.adoc:11
msgid ""
"This tab shows the clients the user is able to administer.  Use system "
"groups to modify client access levels."
msgstr "ແຖບນີ້ສະແດງເຄື່ອງລູກຂ່າຍທີ່ຜູ້ໃຊ້ນີ້ມີສິດບໍລິຫານ."

#. type: Plain text
#: en/modules/reference/pages/users/user-details.adoc:12
msgid ""
"Select multiple systems from this page to add them to the system set manager "
"(SSM).  For more information about SSM, see "
"xref:client-configuration:system-set-manager.adoc[]."
msgstr "ເລືອກລະບົບຈາກໜ້ານີ້ເພື່ອເພີ່ມເຂົ້າໃນ SSM."

#. type: Title ==
#: en/modules/reference/pages/users/user-details.adoc:13
#, no-wrap
msgid "Channel Permissions"
msgstr "ສິດການໃຊ້ງານຊ່ອງທາງ"

#. type: Plain text
#: en/modules/reference/pages/users/user-details.adoc:14
msgid "This tab shows the channel permissions for the user."
msgstr "ແຖບນີ້ສະແດງສິດການເຂົ້າເຖິງຊ່ອງທາງຂອງຜູ້ໃຊ້."

#. type: Plain text
#: en/modules/reference/pages/users/user-details.adoc:15
msgid ""
"The [guimenu]``Subscription`` subtab shows channels that the user has "
"subscription permissions for.  The [guimenu]``Management`` subtab shows "
"channels that the user has management permissions for."
msgstr "ແຖບຍ່ອຍ [guimenu]``Subscription`` ສະແດງສິດການລົງທະບຽນ."

#. type: Plain text
#: en/modules/reference/pages/users/user-details.adoc:16
msgid "Check channels in the list to grant permissions."
msgstr "ເລືອກຊ່ອງທາງໃນລາຍຊື່ເພື່ອມອບສິດການໃຊ້ງານ."

#. type: Block title
#: en/modules/reference/pages/users/user-details.adoc:17
#: en/modules/reference/pages/users/user-details.adoc:19
#, no-wrap
msgid "User Preferences"
msgstr "ການຕັ້ງຄ່າຜູ້ໃຊ້"

#. type: Plain text
#: en/modules/reference/pages/users/user-details.adoc:18
msgid "This tab is used to configure preference settings for users."
msgstr "ແຖບນີ້ໃຊ້ສຳລັບຕັ້ງຄ່າການໃຊ້ງານສ່ວນຕົວ."

#. type: Table
#: en/modules/reference/pages/users/user-details.adoc:20
#, no-wrap
msgid ""
"| Option                | Description   | Default\n"
"| Email Notification    | Receive email for client and Taskomatic "
"notifications, including a daily summary email. | Checked\n"
"| {productname} List Page Size | Maximum number of items that can appear in "
"a list on a single page. | 25 entries\n"
"| \"Overview\" Start Page | Select the information panes to display on the "
"menu:Home[Overview] page. | All checked\n"
"| Time Zone             | Set your local timezone. | System timezone\n"
"| CSV Files             | Select whether to use comma or semi-colon "
"delimiters when producing downloadable CSV files. | Comma\n"
msgstr ""
"| ຕົວເລືອກ | ຄຳອະທິບາຍ | ຄ່າເລີ່ມຕົ້ນ\n"
"| Email Notification | ຮັບອີເມວແຈ້ງເຕືອນ. | ເລືອກ\n"
"| {productname} List Page Size | ຈຳນວນລາຍການສູງສຸດຕໍ່ໜ້າ. | 25 ລາຍການ\n"
"| \"Overview\" Start Page | ເລືອກສິ່ງທີ່ຈະສະແດງໃນໜ້າພາບລວມ. | ເລືອກທັງໝົດ\n"
"| Time Zone | ຕັ້ງຄ່າເຂດເວລາ. | ເຂດເວລາຂອງລະບົບ\n"
"| CSV Files | ເລືອກຕົວແຍກໃນໄຟລ໌ CSV. | Comma (ຈຸດ)\n"

#. type: Plain text
#: en/modules/reference/pages/users/user-details.adoc:22
msgid ""
"This tab shows the mailing addresses associated with the user.  Click "
"btn:[Fill in this address] to set a mailing address.  Click btn:[Edit this "
"address] to change an existing mailing address."
msgstr "ແຖບນີ້ສະແດງທີ່ຢູ່ສຳລັບສົ່ງຈົດໝາຍຂອງຜູ້ໃຊ້."

#. type: Title =
#: en/modules/reference/pages/users/users-list.adoc:1
#, no-wrap
msgid "User List"
msgstr "ລາຍຊື່ຜູ້ໃຊ້"

#. type: Plain text
#: en/modules/reference/pages/users/users-list.adoc:2
msgid "The menu:Users[User List] section provides access to the lists of users."
msgstr "ພາກສ່ວນ menu:Users[User List] ຊ່ວຍໃຫ້ເຂົ້າເຖິງລາຍຊື່ຜູ້ໃຊ້."

#. type: Title =
#: en/modules/reference/pages/users/users-menu.adoc:1
#, no-wrap
msgid "Users Menu"
msgstr "ເມນູຜູ້ໃຊ້"

#. type: Plain text
#: en/modules/reference/pages/users/users-menu.adoc:2
msgid ""
"The [guimenu]``Users`` menu provides access to grant and edit permissions "
"for those who administer your system groups.  You can create new users, and "
"edit user details, roles, and system groups."
msgstr "ເມນູ [guimenu]``Users`` ໃຊ້ສຳລັບກຳນົດ ແລະ ແກ້ໄຂສິດຂອງຜູ້ໃຊ້."

#. type: delimited block =
#: en/modules/reference/pages/users/users-menu.adoc:3
msgid ""
"The [guimenu]``Users`` menu is only available if you are signed in to "
"{productname} with an administrator account."
msgstr "ເມນູ [guimenu]``Users`` ຈະມີໃຫ້ສະເພາະບັນຊີຜູ້ດູແລລະບົບ (administrator) ເທົ່ານັ້ນ."

