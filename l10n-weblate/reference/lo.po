"options:\n"
"  -n NAME\n"
"  -l LABEL\n"
"  -d DESCRIPTION\n"
msgstr ""
"ຕົວເລືອກ:\n"
"  -n NAME\n"
"  -l LABEL\n"
"  -d DESCRIPTION\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/configchannel.adoc:22
#, no-wrap
msgid "configchannel_delete"
msgstr "configchannel_delete"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:23
msgid "Delete a configuration channel."
msgstr "ລຶບຊ່ອງທາງການກຳນົດຄ່າ."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:24
msgid "usage: configchannel_delete CHANNEL ..."
msgstr "ວິທີໃຊ້: configchannel_delete CHANNEL ..."

#. type: Title ==
#: en/modules/reference/pages/spacecmd/configchannel.adoc:25
#, no-wrap
msgid "configchannel_details"
msgstr "configchannel_details"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:26
msgid "Show the details of a configuration channel."
msgstr "ສະແດງລາຍລະອຽດຂອງຊ່ອງທາງການກຳນົດຄ່າ."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:27
msgid "usage: configchannel_details CHANNEL ..."
msgstr "ວິທີໃຊ້: configchannel_details CHANNEL ..."

#. type: Title ==
#: en/modules/reference/pages/spacecmd/configchannel.adoc:28
#, no-wrap
msgid "configchannel_diff"
msgstr "configchannel_diff"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:29
msgid "Find differences between configuration channels."
msgstr "ຊອກຫາຄວາມແຕກຕ່າງລະຫວ່າງຊ່ອງທາງການກຳນົດຄ່າ."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:30
msgid "usage: configchannel_diff SOURCE_CHANNEL TARGET_CHANNEL"
msgstr "ວິທີໃຊ້: configchannel_diff SOURCE_CHANNEL TARGET_CHANNEL"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/configchannel.adoc:31
#, no-wrap
msgid "configchannel_export"
msgstr "configchannel_export"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:32
msgid "Export configuration channels to a json formatted file."
msgstr "ສົ່ງອອກຊ່ອງທາງການກຳນົດຄ່າໄປເປັນໄຟລ໌ຮູບແບບ json."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:33
#, no-wrap
msgid ""
"usage: configchannel_export <CHANNEL>... [options]\n"
"options:\n"
"    -f outfile.json : specify an output filename, defaults to "
"<CHANNEL>.json\n"
"                      if exporting a single channel, ccs.json for multiple\n"
"                      channels, or cc_all.json if no CHANNEL specified\n"
"                      e.g (export ALL)\n"
msgstr ""
"ວິທີໃຊ້: configchannel_export <CHANNEL>... [ຕົວເລືອກ]\n"
"ຕົວເລືອກ:\n"
"    -f outfile.json : ກຳນົດຊື່ໄຟລ໌ຂາອອກ, ຄ່າເລີ່ມຕົ້ນແມ່ນ <CHANNEL>.json\n"
"                      ຖ້າສົ່ງອອກຊ່ອງທາງດຽວ, ccs.json ສຳລັບຫຼາຍ\n"
"                      ຊ່ອງທາງ, ຫຼື cc_all.json ຖ້າບໍ່ໄດ້ກຳນົດ CHANNEL\n"
"                      ຕົວຢ່າງ (ສົ່ງອອກທັງໝົດ)\n"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:34
msgid "Note : CHANNEL list is optional, default is to export ALL"
msgstr "ໝາຍເຫດ : ລາຍຊື່ CHANNEL ແມ່ນໃຫ້ລະບຸຫຼືບໍ່ກໍໄດ້, ຄ່າເລີ່ມຕົ້ນແມ່ນສົ່ງອອກທັງໝົດ"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/configchannel.adoc:35
#, no-wrap
msgid "configchannel_filedetails"
msgstr "configchannel_filedetails"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:36
msgid "Show the details of a file in a configuration channel."
msgstr "ສະແດງລາຍລະອຽດຂອງໄຟລ໌ໃນຊ່ອງທາງການກຳນົດຄ່າ."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:37
msgid "usage: configchannel_filedetails CHANNEL FILE [REVISION]"
msgstr "ວິທີໃຊ້: configchannel_filedetails CHANNEL FILE [REVISION]"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/configchannel.adoc:38
#, no-wrap
msgid "configchannel_forcedeploy"
msgstr "configchannel_forcedeploy"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:39
msgid "Forces a redeployment of files within a channel on all subscribed systems."
msgstr "ບັງຄັບໃຫ້ມີການຕິດຕັ້ງໄຟລ໌ຄືນໃໝ່ພາຍໃນຊ່ອງທາງໃນທຸກລະບົບທີ່ໄດ້ລົງທະບຽນໄວ້."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:40
msgid "usage: configchannel_forcedeploy CHANNEL"
msgstr "ວິທີໃຊ້: configchannel_forcedeploy CHANNEL"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/configchannel.adoc:41
#, no-wrap
msgid "configchannel_import"
msgstr "configchannel_import"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:42
msgid "Import configuration channels from a json file."
msgstr "ນຳເຂົ້າຊ່ອງທາງການກຳນົດຄ່າຈາກໄຟລ໌ json."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:43
msgid "usage: configchannel_import <JSONFILES...>"
msgstr "ວິທີໃຊ້: configchannel_import <JSONFILES...>"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/configchannel.adoc:44
#, no-wrap
msgid "configchannel_list"
msgstr "configchannel_list"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:45
msgid "List all configuration channels."
msgstr "ສະແດງລາຍຊື່ຊ່ອງທາງການກຳນົດຄ່າທັງໝົດ."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:46
msgid "usage: configchannel_list"
msgstr "ວິທີໃຊ້: configchannel_list"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/configchannel.adoc:47
#, no-wrap
msgid "configchannel_listfiles"
msgstr "configchannel_listfiles"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:48
msgid "List all files in a configuration channel."
msgstr "ສະແດງລາຍຊື່ໄຟລ໌ທັງໝົດໃນຊ່ອງທາງການກຳນົດຄ່າ."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:49
msgid "usage: configchannel_listfiles CHANNEL ..."
msgstr "ວິທີໃຊ້: configchannel_listfiles CHANNEL ..."

#. type: Title ==
#: en/modules/reference/pages/spacecmd/configchannel.adoc:50
#, no-wrap
msgid "configchannel_listsystems"
msgstr "configchannel_listsystems"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:51
msgid "List all systems subscribed to a configuration channel."
msgstr "ສະແດງລາຍຊື່ລະບົບທັງໝົດທີ່ລົງທະບຽນໃນຊ່ອງທາງການກຳນົດຄ່າ."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:52
msgid "usage: configchannel_listsystems CHANNEL"
msgstr "ວິທີໃຊ້: configchannel_listsystems CHANNEL"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/configchannel.adoc:53
#, no-wrap
msgid "configchannel_removefiles"
msgstr "configchannel_removefiles"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:54
msgid "Remove configuration files."
msgstr "ເອົາໄຟລ໌ການກຳນົດຄ່າອອກ."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:55
msgid "usage: configchannel_removefile CHANNEL <FILE ...>"
msgstr "ວິທີໃຊ້: configchannel_removefile CHANNEL <FILE ...>"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/configchannel.adoc:56
#, no-wrap
msgid "configchannel_sync"
msgstr "configchannel_sync"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:57
msgid "Sync configuration files between two configuration channels."
msgstr "ຊິງຄ໌ໄຟລ໌ການກຳນົດຄ່າລະຫວ່າງສອງຊ່ອງທາງການກຳນົດຄ່າ."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:58
msgid "usage: configchannel_sync SOURCE_CHANNEL TARGET_CHANNEL"
msgstr "ວິທີໃຊ້: configchannel_sync SOURCE_CHANNEL TARGET_CHANNEL"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/configchannel.adoc:59
#, no-wrap
msgid "configchannel_updatefile"
msgstr "configchannel_updatefile"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:60
msgid "Update a configuration file."
msgstr "ອັບເດດໄຟລ໌ການກຳນົດຄ່າ."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:61
msgid "usage: configchannel_updatefile CHANNEL FILE"
msgstr "ວິທີໃຊ້: configchannel_updatefile CHANNEL FILE"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/configchannel.adoc:62
#, no-wrap
msgid "configchannel_verifyfile"
msgstr "configchannel_verifyfile"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:63
msgid "Verify a configuration file."
msgstr "ກວດສອບຄວາມຖືກຕ້ອງຂອງໄຟລ໌ການກຳນົດຄ່າ."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:64
msgid "usage: configchannel_verifyfile CHANNEL FILE <SYSTEMS>"
msgstr "ວິທີໃຊ້: configchannel_verifyfile CHANNEL FILE <SYSTEMS>"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:65
msgid ""
"<SYSTEMS> may be substituted with any of the following targets: name ssm "
"(see 'help ssm')  search:QUERY (see 'help system_search')  group:GROUP "
"channel:CHANNEL"
msgstr "<SYSTEMS> ສາມາດແທນທີ່ດ້ວຍເປົ້າໝາຍໃດໜຶ່ງດັ່ງນີ້: name, ssm (ເບິ່ງ 'help ssm'), search:QUERY (ເບິ່ງ 'help system_search'), group:GROUP, channel:CHANNEL"

#. type: Title =
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:1
#, no-wrap
msgid "Configuring spacecmd"
msgstr "ການກຳນົດຄ່າ spacecmd"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:3
msgid "The following section provides configuration tips for spacecmd."
msgstr "ພາກສ່ວນຕໍ່ໄປນີ້ໃຫ້ຄຳແນະນຳໃນການກຳນົດຄ່າສຳລັບ spacecmd."

#. type: Title ==
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:4
#, no-wrap
msgid "Setup [command]``spacecmd`` credentials"
msgstr "ຕັ້ງຄ່າຂໍ້ມູນການເຂົ້າລະບົບ [command]``spacecmd``"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:5
msgid ""
"Normally spacecmd prompts you for a username and password each time you "
"attempt to login to the interactive shell.  Alternatively you can configure "
"spacecmd with a credentials file to avoid this requirement."
msgstr "ໂດຍປົກກະຕິ spacecmd ຈະຖາມຫາຊື່ຜູ້ໃຊ້ ແລະ ລະຫັດຜ່ານທຸກຄັ້ງທີ່ທ່ານພະຍາຍາມເຂົ້າສູ່ລະບົບ. ທ່ານສາມາດກຳນົດຄ່າ spacecmd ດ້ວຍໄຟລ໌ຂໍ້ມູນການເຂົ້າລະບົບເພື່ອຂ້າມຂັ້ນຕອນນີ້."

#. type: Block title
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:6
#, no-wrap
msgid "Procedure: Creating a [literal]``spacecmd`` credentials file"
msgstr "ຂັ້ນຕອນ: ການສ້າງໄຟລ໌ຂໍ້ມູນການເຂົ້າລະບົບ [literal]``spacecmd``"

#. type: delimited block _
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:7
msgid ""
"Create a hidden spacecmd directory in your home directory and set "
"permissions:"
msgstr "ສ້າງໄດເຣັກທໍຣີ spacecmd ທີ່ເຊື່ອງໄວ້ໃນ home directory ຂອງທ່ານ ແລະ ຕັ້ງຄ່າສິດການເຂົ້າເຖິງ:"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:8
#, no-wrap
msgid ""
"mkdir ~/.spacecmd\n"
"chmod 700 ~/.spacecmd\n"
msgstr ""
"mkdir ~/.spacecmd\n"
"chmod 700 ~/.spacecmd\n"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:9
msgid ""
"Create a [literal]``config`` file in [path]``~/.spacecmd/`` and provide "
"proper permissions:"
msgstr "ສ້າງໄຟລ໌ [literal]``config`` ໃນ [path]``~/.spacecmd/`` ແລະ ກຳນົດສິດໃຫ້ຖືກຕ້ອງ:"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:10
#, no-wrap
msgid ""
"touch ~/.spacecmd/config\n"
"chmod 600 ~/.spacecmd/config\n"
msgstr ""
"touch ~/.spacecmd/config\n"
"chmod 600 ~/.spacecmd/config\n"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:11
msgid ""
"Edit the [literal]``config`` file and add the following configuration "
"lines. (You can use either localhost, when running spacecmd from your "
"{productname} server container, or the FQDN of your {productname} server):"
msgstr "ແກ້ໄຂໄຟລ໌ [literal]``config`` ແລະ ເພີ່ມແຖວການກຳນົດຄ່າຕໍ່ໄປນີ້. (ທ່ານສາມາດໃຊ້ localhost ຖ້າໃຊ້ spacecmd ຈາກ server container ຂອງທ່ານ ຫຼື ໃຊ້ FQDN ຂອງ server ຂອງທ່ານ):"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:12
#, no-wrap
msgid "[spacecmd]\n"
msgstr "[spacecmd]\n"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:13
#, no-wrap
msgid "server=FQDN-here\n"
msgstr "server=FQDN-ຢູ່ບ່ອນນີ້\n"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:14
#, no-wrap
msgid ""
"username=username-here\n"
"password=password-here\n"
msgstr ""
"username=ຊື່ຜູ້ໃຊ້-ຢູ່ບ່ອນນີ້\n"
"password=ລະຫັດຜ່ານ-ຢູ່ບ່ອນນີ້\n"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:15
msgid "Check connectivity by entering [command]``spacecmd`` as root:"
msgstr "ກວດສອບການເຊື່ອມຕໍ່ໂດຍການພິມ [command]``spacecmd`` ໃນຖານະ root:"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:16
#, no-wrap
msgid "# spacecmd\n"
msgstr "# spacecmd\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:17
#, no-wrap
msgid "[command]``spacecmd`` quiet mode"
msgstr "[command]``spacecmd`` ໂໝດງຽບ (quiet mode)"

#. type: delimited block _
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:18
msgid ""
"By default spacecmd prints server status messages during connection "
"attempts.  These messages can cause a lot of clutter when parsing system "
"lists.  The following alias will force spacecmd to use quiet mode thus "
"preventing this behavior.  Add the following line to your `~/.bashrc` file:"
msgstr "ໂດຍຄ່າເລີ່ມຕົ້ນ spacecmd ຈະສະແດງຂໍ້ຄວາມສະຖານະເຊີບເວີໃນລະຫວ່າງການເຊື່ອມຕໍ່. ຂໍ້ຄວາມເຫຼົ່ານີ້ອາດເຮັດໃຫ້ເກີດຄວາມສັບສົນເມື່ອເບິ່ງລາຍຊື່ລະບົບ. alias ຕໍ່ໄປນີ້ຈະບັງຄັບໃຫ້ spacecmd ໃຊ້ໂໝດງຽບ. ໃຫ້ເພີ່ມແຖວຕໍ່ໄປນີ້ໃສ່ໄຟລ໌ `~/.bashrc` ຂອງທ່ານ:"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:19
#, no-wrap
msgid "alias spacecmd='spacecmd -q'\n"
msgstr "alias spacecmd='spacecmd -q'\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:20
#, no-wrap
msgid "[command]``spacecmd`` help"
msgstr "ວິທີຊ່ວຍເຫຼືອ [command]``spacecmd``"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:21
msgid "spacecmd help can be accessed by typing spacecmd [command]``-h --help``"
msgstr "ສາມາດເຂົ້າເຖິງວິທີຊ່ວຍເຫຼືອຂອງ spacecmd ໄດ້ໂດຍການພິມ spacecmd [command]``-h --help``"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:22
#, no-wrap
msgid "Usage: spacecmd [options] [command]\n"
msgstr "ວິທີໃຊ້: spacecmd [ຕົວເລືອກ] [ຄຳສັ່ງ]\n"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:23
#, no-wrap
msgid ""
"Options:\n"
"  -c CONFIG, --config CONFIG\n"
"                        config file to use [default: ~/.spacecmd/config]\n"
"  -u USERNAME, --username=USERNAME\n"
"                        use this username to connect to the server\n"
"  -p PASSWORD, --password=PASSWORD\n"
"                        use this password to connect to the server\n"
"  -s SERVER, --server=SERVER\n"
"                        connect to this server [default: local hostname]\n"
"  --nossl               use HTTP instead of HTTPS\n"
"  --nohistory           do not store command history\n"
"  -y, --yes             answer yes for all questions\n"
"  -q, --quiet           print only error messages\n"
"  -d, --debug           print debug messages (can be passed multiple "
"times)\n"
"  -h, --help            show this help message and exit\n"
msgstr ""
"ຕົວເລືອກ:\n"
"  -c CONFIG, --config CONFIG\n"
"                        ໄຟລ໌ config ທີ່ໃຊ້ [ຄ່າເລີ່ມຕົ້ນ: ~/.spacecmd/config]\n"
"  -u USERNAME, --username=USERNAME\n"
"                        ໃຊ້ຊື່ຜູ້ໃຊ້ນີ້ເພື່ອເຊື່ອມຕໍ່ຫາເຊີບເວີ\n"
"  -p PASSWORD, --password=PASSWORD\n"
"                        ໃຊ້ລະຫັດຜ່ານນີ້ເພື່ອເຊື່ອມຕໍ່ຫາເຊີບເວີ\n"
"  -s SERVER, --server=SERVER\n"
"                        ເຊື່ອມຕໍ່ຫາເຊີບເວີນີ້ [ຄ່າເລີ່ມຕົ້ນ: local hostname]\n"
"  --nossl               ໃຊ້ HTTP ແທນ HTTPS\n"
"  --nohistory           ບໍ່ເກັບປະຫວັດຄຳສັ່ງ\n"
"  -y, --yes             ຕອບ ຕົກລົງ (yes) ທຸກຄຳຖາມ\n"
"  -q, --quiet           ສະແດງສະເພາະຂໍ້ຄວາມຜິດພາດ\n"
"  -d, --debug           ສະແດງຂໍ້ຄວາມ debug\n"
"  -h, --help            ສະແດງວິທີຊ່ວຍເຫຼືອນີ້ແລ້ວອອກ\n"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:24
msgid ""
"As root you can access available functions without entering the spacecmd "
"shell:"
msgstr "ໃນຖານະ root ທ່ານສາມາດເຂົ້າເຖິງຟັງຊັນຕ່າງໆໄດ້ໂດຍບໍ່ຕ້ອງເຂົ້າສູ່ spacecmd shell:"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:25
#, no-wrap
msgid "# spacecmd -- help\n"
msgstr "# spacecmd -- help\n"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:26
#, no-wrap
msgid ""
"        Documented commands (type help <topic>):\n"
"========================================\n"
"activationkey_addchildchannels         org_trustdetails\n"
"activationkey_addconfigchannels        package_details\n"
"activationkey_addentitlements          package_listdependencies\n"
"activationkey_addgroups                package_listerrata\n"
"activationkey_addpackages              package_listinstalledsystems\n"
"activationkey_clone                    package_listorphans\n"
"activationkey_create                   package_remove\n"
"activationkey_delete                   package_removeorphans\n"
"activationkey_details                  package_search\n"
"activationkey_diff                     repo_addfilters\n"
"activationkey_disable                  repo_clearfilters\n"
"activationkey_disableconfigdeployment  repo_create\n"
msgstr ""
"        ຄຳສັ່ງທີ່ມີ (ພິມ help <topic>):\n"
"========================================\n"
"activationkey_addchildchannels         org_trustdetails\n"
"activationkey_addconfigchannels        package_details\n"
"activationkey_addentitlements          package_listdependencies\n"
"activationkey_addgroups                package_listerrata\n"
"activationkey_addpackages              package_listinstalledsystems\n"
"activationkey_clone                    package_listorphans\n"
"activationkey_create                   package_remove\n"
"activationkey_delete                   package_removeorphans\n"
"activationkey_details                  package_search\n"
"activationkey_diff                     repo_addfilters\n"
"activationkey_disable                  repo_clearfilters\n"
"activationkey_disableconfigdeployment  repo_create\n"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:27
#, no-wrap
msgid "...\n"
msgstr "...\n"

#. type: Title =
#: en/modules/reference/pages/spacecmd/cryptokey.adoc:1
#, no-wrap
msgid "cryptokey"
msgstr "cryptokey"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/cryptokey.adoc:2
msgid ""
"The following spacecmd commands are available for use with cryptographic "
"keys."
msgstr "ຄຳສັ່ງ spacecmd ຕໍ່ໄປນີ້ມີໄວ້ສຳລັບໃຊ້ກັບກະແຈເຂົ້າລະຫັດ (cryptographic keys)."

#. type: Title ==
#: en/modules/reference/pages/spacecmd/cryptokey.adoc:3
#, no-wrap
msgid "cryptokey_create"
msgstr "cryptokey_create"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/cryptokey.adoc:4
msgid "Create a cryptographic key."
msgstr "ສ້າງກະແຈເຂົ້າລະຫັດ."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/cryptokey.adoc:5
msgid "usage: cryptokey_create [options]"
msgstr "ວິທີໃຊ້: cryptokey_create [ຕົວເລືອກ]"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/cryptokey.adoc:6
#, no-wrap
msgid ""
"options:\n"
"  -t GPG or SSL\n"
"  -d DESCRIPTION\n"
"  -f KEY_FILE\n"
msgstr ""
"ຕົວເລືອກ:\n"
"  -t GPG ຫຼື SSL\n"
"  -d DESCRIPTION\n"
"  -f KEY_FILE\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/cryptokey.adoc:7
#, no-wrap
msgid "cryptokey_delete"
msgstr "cryptokey_delete"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/cryptokey.adoc:8
msgid "Delete a cryptographic key."
msgstr "ລຶບກະແຈເຂົ້າລະຫັດ."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/cryptokey.adoc:9
msgid "usage: cryptokey_delete NAME"
msgstr "ວິທີໃຊ້: cryptokey_delete NAME"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/cryptokey.adoc:10
#, no-wrap
msgid "cryptokey_details"
msgstr "cryptokey_details"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/cryptokey.adoc:11
msgid "Show the contents of a cryptographic key."
msgstr "ສະແດງເນື້ອໃນຂອງກະແຈເຂົ້າລະຫັດ."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/cryptokey.adoc:12
msgid "usage: cryptokey_details KEY ..."
msgstr "ວິທີໃຊ້: cryptokey_details KEY ..."

#. type: Title ==
#: en/modules/reference/pages/spacecmd/cryptokey.adoc:13
#, no-wrap
msgid "cryptokey_list"
msgstr "cryptokey_list"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/cryptokey.adoc:14
msgid "List all cryptographic keys (SSL, GPG)."
msgstr "ສະແດງລາຍຊື່ກະແຈເຂົ້າລະຫັດທັງໝົດ (SSL, GPG)."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/cryptokey.adoc:15
msgid "usage: cryptokey_list"
msgstr "ວິທີໃຊ້: cryptokey_list"

#. type: Title =
#: en/modules/reference/pages/spacecmd/custominfo.adoc:1
#, no-wrap
msgid "custominfo"
msgstr "custominfo"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/custominfo.adoc:2
msgid "The following spacecmd commands are available for working with custom keys."
msgstr "ຄຳສັ່ງ spacecmd ຕໍ່ໄປນີ້ມີໄວ້ສຳລັບເຮັດວຽກກັບກະແຈທີ່ກຳນົດເອງ (custom keys)."

#. type: Title ==
#: en/modules/reference/pages/spacecmd/custominfo.adoc:3
#, no-wrap
msgid "custominfo_createkey"
msgstr "custominfo_createkey"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/custominfo.adoc:4
msgid "Create a custom key."
