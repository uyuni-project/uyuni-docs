msgstr "ວິທີໃຊ້: user_removerole ຜູ້ໃຊ້ ບົດບາດ\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/user.adoc:43
#, no-wrap
msgid "user_setemail"
msgstr "user_setemail"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/user.adoc:44
