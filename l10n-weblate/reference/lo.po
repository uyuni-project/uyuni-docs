msgstr "ວິທີໃຊ້: softwarechannel_setsyncschedule <CHANNEL>\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:99
#, no-wrap
msgid "softwarechannel_setorgaccess"
msgstr "softwarechannel_setorgaccess"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:100
msgid "Set the org-access for the software channel."
msgstr "ຕັ້ງຄ່າການເຂົ້າເຖິງຂອງອົງກອນສຳລັບຊ່ອງທາງຊອບແວ."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:101
#, no-wrap
msgid ""
"usage : softwarechannel_setorgaccess <channel_label> [options]\n"
"-d,--disable : disable org access (private, no org sharing)\n"
"-e,--enable : enable org access (public access to all trusted orgs)\n"
msgstr ""
"ວິທີໃຊ້: softwarechannel_setorgaccess <channel_label> [options]\n"
"-d,--disable : ປິດການເຂົ້າເຖິງຂອງອົງກອນ (ສ່ວນຕົວ, ບໍ່ມີການແບ່ງປັນ)\n"
"-e,--enable : ເປີດການເຂົ້າເຖິງຂອງອົງກອນ (ເປີດໃຫ້ອົງກອນທີ່ເຊື່ອຖືໄດ້ທັງໝົດເຂົ້າເຖິງ)\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:102
#, no-wrap
msgid "softwarechannel_setsyncschedule"
msgstr "softwarechannel_setsyncschedule"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:103
msgid "Sets the repo sync schedule for a software channel."
msgstr "ຕັ້ງຕາຕະລາງການຊິງຄ໌ເຣໂປສຳລັບຊ່ອງທາງຊອບແວ."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:104
#, no-wrap
msgid "usage: softwarechannel_setsyncschedule <CHANNEL> <SCHEDULE>\n"
msgstr "ວິທີໃຊ້: softwarechannel_setsyncschedule <CHANNEL> <SCHEDULE>\n"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:105
#, no-wrap
msgid ""
"The schedule is specified in Quartz CronTrigger format without enclosing "
"quotes.\n"
"For example, to set a schedule of every day at 1am, <SCHEDULE> would be 0 0 "
"1 * * ?\n"
msgstr ""
"ຕາຕະລາງຖືກລະບຸໃນຮູບແບບ Quartz CronTrigger ໂດຍບໍ່ຕ້ອງໃສ່ເຄື່ອງໝາຍຄຳເວົ້າ.\n"
"ຕົວຢ່າງ, ເພື່ອຕັ້ງຕາຕະລາງທຸກໆມື້ເວລາ 1 ໂມງເຊົ້າ, <SCHEDULE> ແມ່ນ 0 0 1 * * ?\n"

#. type: Title ==
