msgstr "ຟິວທີ່ມີໃຫ້: name, epoch, version, release, arch, description, summary"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/package.adoc:30
msgid "Example: name:kernel AND version:2.6.18 AND -description:devel"
msgstr "ຕົວຢ່າງ: name:kernel AND version:2.6.18 AND -description:devel"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/proxy_container.adoc:1
#: en/modules/reference/pages/spacecmd/proxy_container.adoc:8
#, no-wrap
msgid "proxy_container_config"
msgstr "proxy_container_config"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/proxy_container.adoc:2
msgid ""
"The following spacecmd functions are available for use with proxy container "
"configuration"
msgstr "ຟັງຊັນ spacecmd ຕໍ່ໄປນີ້ມີໄວ້ສຳລັບໃຊ້ກັບການກຳນົດຄ່າ proxy container"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/proxy_container.adoc:3
#, no-wrap
msgid "proxy_container_config_generate_cert"
msgstr "proxy_container_config_generate_cert"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/proxy_container.adoc:4
msgid ""
"Create {productname} Proxy container configuration and generate new SSL "
"server certificate for it."
msgstr "ສ້າງການກຳນົດຄ່າຄອນເທນເນີ {productname} Proxy ແລະ ສ້າງໃບຢັ້ງຢືນເຊີເວີ SSL ໃໝ່ສຳລັບມັນ."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/proxy_container.adoc:5
#, no-wrap
msgid ""
"usage: proxy_container_config_generate_cert PROXY_FQDN PARENT_FQDN MAX_CACHE "
"EMAIL\n"
msgstr "ວິທີໃຊ້: proxy_container_config_generate_cert PROXY_FQDN PARENT_FQDN MAX_CACHE EMAIL\n"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/proxy_container.adoc:6
#, no-wrap
msgid ""
"parameters:\n"
"  PROXY_FQDN  the fully qualified domain name of the proxy to create.\n"
"  PARENT_FQDN the fully qualified domain name of the server or another proxy "
"to connect to.\n"
"  MAX_CACHE   the maximum cache size in MB. 60% of the storage is a good "
"value.\n"
"  EMAIL       the email of the proxy administrator\n"
msgstr ""
"ພາລາມິເຕີ:\n"
"  PROXY_FQDN  ຊື່ໂດເມນເຕັມ (FQDN) ຂອງພຣັອກຊີທີ່ຈະສ້າງ.\n"
"  PARENT_FQDN ຊື່ໂດເມນເຕັມ (FQDN) ຂອງເຊີເວີ ຫຼື ພຣັອກຊີອື່ນທີ່ຈະເຊື່ອມຕໍ່ຫາ.\n"
"  MAX_CACHE   ຂະໜາດແຄຊສູງສຸດເປັນ MB. 60% ຂອງພື້ນທີ່ຈັດເກັບຂໍ້ມູນແມ່ນຄ່າທີ່ເໝາະສົມ.\n"
"  EMAIL       ອີເມວຂອງຜູ້ດູແລລະບົບພຣັອກຊີ\n"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/proxy_container.adoc:7
#, no-wrap
msgid ""
"options:\n"
"  -o, --output Path where to create the generated configuration. Default: "
"'config.zip'\n"
"  -p, --ssh-port SSH port the proxy listens one. Default: 22\n"
"  --ca-cert path to the certificate of the CA to use to generate a new proxy "
"certificate.\n"
"           Using /root/ssl-build/RHN-ORG-TRUSTED-SSL-CERT by default.\n"
"  --ca-key path to the private key of the CA to use to generate a new proxy "
"certificate.\n"
"           Using /root/ssl-build/RHN-ORG-PRIVATE-SSL-KEY by default.\n"
"  --ca-pass path to a file containing the password of the CA private key, "
"will be prompted if not passed.\n"
"  --ssl-cname alternate name of the proxy to set in the certificate. Can be "
"provided multiple times\n"
"  --ssl-country country code to set in the certificate. If omitted, default "
"values from mgr-ssl-tool will be used.\n"
"  --ssl-state state name to set in the certificate. If omitted, default "
"values from mgr-ssl-tool will be used.\n"
"  --ssl-city the city name to set in the certificate. If omitted, default "
"values from mgr-ssl-tool will be used.\n"
"  --ssl-org the organization name to set in the certificate. If omitted, "
"default values from mgr-ssl-tool will be used.\n"
"  --ssl-org-unit the organization unit name to set in the certificate. If "
"omitted, default values from mgr-ssl-tool will be used.\n"
"  --ssl-email the email to set in the certificate. If omitted, default "
"values from mgr-ssl-tool will be used.\n"
msgstr ""
"ຕົວເລືອກ:\n"
"  -o, --output ເສັ້ນທາງທີ່ຈະສ້າງໄຟລ໌ການກຳນົດຄ່າ. ຄ່າເລີ່ມຕົ້ນ: 'config.zip'\n"
"  -p, --ssh-port ພອດ SSH ທີ່ພຣັອກຊີຈະລໍຖ້າການເຊື່ອມຕໍ່. ຄ່າເລີ່ມຕົ້ນ: 22\n"
"  --ca-cert ເສັ້ນທາງໄປຫາໃບຢັ້ງຢືນ CA ທີ່ຈະໃຊ້ສ້າງໃບຢັ້ງຢືນພຣັອກຊີໃໝ່.\n"
"           ຄ່າເລີ່ມຕົ້ນແມ່ນ /root/ssl-build/RHN-ORG-TRUSTED-SSL-CERT.\n"
"  --ca-key ເສັ້ນທາງໄປຫາຄີສ່ວນຕົວ (private key) ຂອງ CA ທີ່ຈະໃຊ້ສ້າງໃບຢັ້ງຢືນພຣັອກຊີໃໝ່.\n"
"           ຄ່າເລີ່ມຕົ້ນແມ່ນ /root/ssl-build/RHN-ORG-PRIVATE-SSL-KEY.\n"
"  --ca-pass ເສັ້ນທາງໄປຫາໄຟລ໌ທີ່ບັນຈຸລະຫັດຜ່ານຂອງ CA private key, ຈະມີການຖາມຫາຖ້າບໍ່ໄດ້ລະບຸ.\n"
"  --ssl-cname ຊື່ສຳຮອງຂອງພຣັອກຊີທີ່ຈະຕັ້ງໃນໃບຢັ້ງຢືນ. ສາມາດລະບຸໄດ້ຫຼາຍຄັ້ງ.\n"
"  --ssl-country ລະຫັດປະເທດທີ່ຈະຕັ້ງໃນໃບຢັ້ງຢືນ. ຖ້າບໍ່ລະບຸ, ຈະໃຊ້ຄ່າເລີ່ມຕົ້ນຈາກ mgr-ssl-tool.\n"
"  --ssl-state ຊື່ແຂວງ/ລັດ ທີ່ຈະຕັ້ງໃນໃບຢັ້ງຢືນ. ຖ້າບໍ່ລະບຸ, ຈະໃຊ້ຄ່າເລີ່ມຕົ້ນຈາກ mgr-ssl-tool.\n"
"  --ssl-city ຊື່ເມືອງທີ່ຈະຕັ້ງໃນໃບຢັ້ງຢືນ. ຖ້າບໍ່ລະບຸ, ຈະໃຊ້ຄ່າເລີ່ມຕົ້ນຈາກ mgr-ssl-tool.\n"
"  --ssl-org ຊື່ອົງກອນທີ່ຈະຕັ້ງໃນໃບຢັ້ງຢືນ. ຖ້າບໍ່ລະບຸ, ຈະໃຊ້ຄ່າເລີ່ມຕົ້ນຈາກ mgr-ssl-tool.\n"
"  --ssl-org-unit ຊື່ໜ່ວຍງານໃນອົງກອນທີ່ຈະຕັ້ງໃນໃບຢັ້ງຢືນ. ຖ້າບໍ່ລະບຸ, ຈະໃຊ້ຄ່າເລີ່ມຕົ້ນຈາກ mgr-ssl-tool.\n"
"  --ssl-email ອີເມວທີ່ຈະຕັ້ງໃນໃບຢັ້ງຢືນ. ຖ້າບໍ່ລະບຸ, ຈະໃຊ້ຄ່າເລີ່ມຕົ້ນຈາກ mgr-ssl-tool.\n"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/proxy_container.adoc:9
msgid ""
"Create {productname} Proxy container configuration and use already existing "
"SSL server certificate."
msgstr "ສ້າງການກຳນົດຄ່າຄອນເທນເນີ {productname} Proxy ແລະ ໃຊ້ໃບຢັ້ງຢືນເຊີເວີ SSL ທີ່ມີຢູ່ແລ້ວ."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/proxy_container.adoc:10
#, no-wrap
msgid ""
"usage: proxy_container_config [options] PROXY_FQDN PARENT_FQDN MAX_CACHE "
"EMAIL ROOT_CA CRT KEY\n"
msgstr "ວິທີໃຊ້: proxy_container_config [options] PROXY_FQDN PARENT_FQDN MAX_CACHE EMAIL ROOT_CA CRT KEY\n"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/proxy_container.adoc:11
#, no-wrap
msgid ""
"parameters:\n"
"  PROXY_FQDN  the fully qualified domain name of the proxy to create.\n"
"  PARENT_FQDN the fully qualified domain name of the server or another proxy "
"to connect to.\n"
"  MAX_CACHE   the maximum cache size in MB. 60% of the storage is a good "
"value.\n"
"  EMAIL       the email of the proxy administrator\n"
"  CA          path to the root CA used to sign the proxy certificate in PEM "
"format\n"
"  CRT         path to the proxy certificate in PEM format\n"
"  KEY         path to the proxy certificate private key in PEM format\n"
msgstr ""
"ພາລາມິເຕີ:\n"
"  PROXY_FQDN  ຊື່ໂດເມນເຕັມ (FQDN) ຂອງພຣັອກຊີທີ່ຈະສ້າງ.\n"
"  PARENT_FQDN ຊື່ໂດເມນເຕັມ (FQDN) ຂອງເຊີເວີ ຫຼື ພຣັອກຊີອື່ນທີ່ຈະເຊື່ອມຕໍ່ຫາ.\n"
"  MAX_CACHE   ຂະໜາດແຄຊສູງສຸດເປັນ MB. 60% ຂອງພື້ນທີ່ຈັດເກັບຂໍ້ມູນແມ່ນຄ່າທີ່ເໝາະສົມ.\n"
"  EMAIL       ອີເມວຂອງຜູ້ດູແລລະບົບພຣັອກຊີ\n"
"  CA          ເສັ້ນທາງໄປຫາ root CA ທີ່ໃຊ້ເຊັນໃບຢັ້ງຢືນພຣັອກຊີໃນຮູບແບບ PEM\n"
"  CRT         ເສັ້ນທາງໄປຫາໃບຢັ້ງຢືນພຣັອກຊີໃນຮູບແບບ PEM\n"
"  KEY         ເສັ້ນທາງໄປຫາຄີສ່ວນຕົວ (private key) ຂອງໃບຢັ້ງຢືນພຣັອກຊີໃນຮູບແບບ PEM\n"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/proxy_container.adoc:12
#, no-wrap
msgid ""
"options:\n"
"  -o, --output Path where to create the generated configuration. Default: "
"'config.zip'\n"
"  -p, --ssh-port SSH port the proxy listens one. Default: 22\n"
"  -i, --intermediate-ca  Path to an intermediate CA used to sign the proxy\n"
"            certicate in PEM format. May be provided multiple times.\n"
msgstr ""
"ຕົວເລືອກ:\n"
"  -o, --output ເສັ້ນທາງທີ່ຈະສ້າງໄຟລ໌ການກຳນົດຄ່າ. ຄ່າເລີ່ມຕົ້ນ: 'config.zip'\n"
"  -p, --ssh-port ພອດ SSH ທີ່ພຣັອກຊີຈະລໍຖ້າການເຊື່ອມຕໍ່. ຄ່າເລີ່ມຕົ້ນ: 22\n"
"  -i, --intermediate-ca  ເສັ້ນທາງໄປຫາ intermediate CA ທີ່ໃຊ້ເຊັນໃບຢັ້ງຢືນພຣັອກຊີ\n"
"            ໃນຮູບແບບ PEM. ສາມາດລະບຸໄດ້ຫຼາຍຄັ້ງ.\n"

#. type: Title =
#: en/modules/reference/pages/spacecmd/repo.adoc:1
#, no-wrap
msgid "repo"
msgstr "ເຣໂປ"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/repo.adoc:2
msgid ""
"The following spacecmd functions are available for working with "
"repositories."
msgstr "ຟັງຊັນ spacecmd ຕໍ່ໄປນີ້ແມ່ນມີໃຫ້ສຳລັບການເຮັດວຽກກັບເຣໂປຊິທໍຣີ (repositories)."

#. type: Title ==
#: en/modules/reference/pages/spacecmd/repo.adoc:3
#, no-wrap
msgid "repo_addfilters"
msgstr "repo_addfilters"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/repo.adoc:4
msgid "Add filters for a user repository."
msgstr "ເພີ່ມຕົວກອງສຳລັບເຣໂປຊິທໍຣີຂອງຜູ້ໃຊ້."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/repo.adoc:5
#, no-wrap
msgid "usage: repo_addfilters repo <filter ...>\n"
msgstr "ວິທີໃຊ້: repo_addfilters repo <filter ...>\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/repo.adoc:6
#, no-wrap
msgid "repo_clearfilters"
msgstr "repo_clearfilters"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/repo.adoc:7
msgid "Clears the filters for a user repository."
msgstr "ລຶບຕົວກອງສຳລັບເຣໂປຊິທໍຣີຂອງຜູ້ໃຊ້."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/repo.adoc:8
#, no-wrap
msgid "usage: repo_clearfilters repo\n"
msgstr "ວິທີໃຊ້: repo_clearfilters repo\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/repo.adoc:9
#, no-wrap
msgid "repo_create"
msgstr "repo_create"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/repo.adoc:10
msgid "Create a user repository."
msgstr "ສ້າງເຣໂປຊິທໍຣີຂອງຜູ້ໃຊ້."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/repo.adoc:11
#, no-wrap
msgid "usage: repo_create <options>\n"
msgstr "ວິທີໃຊ້: repo_create <options>\n"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/repo.adoc:12
#, no-wrap
msgid ""
"options:\n"
"  -n, --name   name of repository\n"
"  -u, --url    url of repository\n"
msgstr ""
"ຕົວເລືອກ:\n"
"  -n, --name   ຊື່ຂອງເຣໂປຊິທໍຣີ\n"
"  -u, --url    URL ຂອງເຣໂປຊິທໍຣີ\n"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/repo.adoc:13
#, no-wrap
msgid ""
"  --ca         SSL CA certificate (not required)\n"
"  --cert       SSL Client certificate (not required)\n"
"  --key        SSL Client key (not required)\n"
msgstr ""
"  --ca         ໃບຢັ້ງຢືນ SSL CA (ບໍ່ບັງຄັບ)\n"
"  --cert       ໃບຢັ້ງຢືນ SSL Client (ບໍ່ບັງຄັບ)\n"
"  --key        ຄີ SSL Client (ບໍ່ບັງຄັບ)\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/repo.adoc:14
#, no-wrap
msgid "repo_delete"
msgstr "repo_delete"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/repo.adoc:15
msgid "Delete a user repository."
msgstr "ລຶບເຣໂປຊິທໍຣີຂອງຜູ້ໃຊ້."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/repo.adoc:16
#, no-wrap
msgid "usage: repo_delete <repo ...>\n"
msgstr "ວິທີໃຊ້: repo_delete <repo ...>\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/repo.adoc:17
#, no-wrap
msgid "repo_details"
msgstr "repo_details"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/repo.adoc:18
msgid "Show the details of a user repository."
msgstr "ສະແດງລາຍລະອຽດຂອງເຣໂປຊິທໍຣີຂອງຜູ້ໃຊ້."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/repo.adoc:19
#, no-wrap
msgid "usage: repo_details <repo ...>\n"
msgstr "ວິທີໃຊ້: repo_details <repo ...>\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/repo.adoc:20
#, no-wrap
msgid "repo_list"
msgstr "repo_list"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/repo.adoc:21
msgid "List all available user repository."
msgstr "ລາຍຊື່ເຣໂປຊິທໍຣີຂອງຜູ້ໃຊ້ທີ່ມີທັງໝົດ."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/repo.adoc:22
#, no-wrap
msgid "usage: repo_list\n"
msgstr "ວິທີໃຊ້: repo_list\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/repo.adoc:23
#, no-wrap
msgid "repo_listfilters"
msgstr "repo_listfilters"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/repo.adoc:24
msgid "Show the filters for a user repository."
msgstr "ສະແດງຕົວກອງສຳລັບເຣໂປຊິທໍຣີຂອງຜູ້ໃຊ້."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/repo.adoc:25
#, no-wrap
msgid "usage: repo_listfilters repo\n"
msgstr "ວິທີໃຊ້: repo_listfilters repo\n"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/repo.adoc:26
msgid "===repo_removefilters"
msgstr "===repo_removefilters"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/repo.adoc:27
