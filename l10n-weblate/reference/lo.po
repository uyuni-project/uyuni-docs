msgstr "ວິທີໃຊ້: user_details ຜູ້ໃຊ້ ...\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/user.adoc:22
#, no-wrap
msgid "user_disable"
msgstr "user_disable"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/user.adoc:23
