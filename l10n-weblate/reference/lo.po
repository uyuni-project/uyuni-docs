msgstr "ວິທີໃຊ້: softwarechannel_sync SOURCE_CHANNEL TARGET_CHANNEL\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/softwarechannel.adoc:109
#, no-wrap
msgid "softwarechannel_syncrepos"
msgstr "softwarechannel_syncrepos"

#. type: Plain text
