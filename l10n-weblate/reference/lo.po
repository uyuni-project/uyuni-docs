msgid "xref:cli-bootstrap.adoc[Bootstrapping CLI Tools]"
msgstr "xref:cli-bootstrap.adoc[ເຄື່ອງມື CLI ສຳລັບ Bootstrapping]"

#. type: Title =
#: en/modules/reference/pages/admin/access-control.adoc:1
#, no-wrap
msgid "Access Group Management"
msgstr "ການຈັດການກຸ່ມການເຂົ້າເຖິງ"

#. type: Plain text
#: en/modules/reference/pages/admin/access-control.adoc:2
msgid ""
"The Access Group Management page provides an overview of all existing access "
"groups and allows administrators to create, edit, or delete them."
msgstr "ໜ້າການຈັດການກຸ່ມການເຂົ້າເຖິງໃຫ້ພາບລວມຂອງກຸ່ມການເຂົ້າເຖິງທີ່ມີຢູ່ທັງໝົດ ແລະ ອະນຸຍາດໃຫ້ຜູ້ດູແລລະບົບສາມາດສ້າງ, ແກ້ໄຂ, ຫຼື ລຶບພວກມັນໄດ້."

#. type: Title ==
#: en/modules/reference/pages/admin/access-control.adoc:3
#, no-wrap
msgid "Create access group"
msgstr "ສ້າງກຸ່ມການເຂົ້າເຖິງ"

#. type: Plain text
#: en/modules/reference/pages/admin/access-control.adoc:4
msgid "To create an access group use the following procedure:"
msgstr "ເພື່ອສ້າງກຸ່ມການເຂົ້າເຖິງ ໃຫ້ປະຕິບັດຕາມຂັ້ນຕອນດັ່ງນີ້:"

#. type: Block title
#: en/modules/reference/pages/admin/access-control.adoc:5
#, no-wrap
msgid "Procedure: Creating an access group"
msgstr "ຂັ້ນຕອນ: ການສ້າງກຸ່ມການເຂົ້າເຖິງ"

#. type: delimited block _
#: en/modules/reference/pages/admin/access-control.adoc:6
msgid "Define Access group by filling in the following fields:"
msgstr "ກຳນົດກຸ່ມການເຂົ້າເຖິງໂດຍການຕື່ມຂໍ້ມູນໃນຊ່ອງຕ່າງໆດັ່ງນີ້:"

#. type: delimited block _
#: en/modules/reference/pages/admin/access-control.adoc:7
msgid "Name: The name of the access group."
msgstr "Name: ຊື່ຂອງກຸ່ມການເຂົ້າເຖິງ."

#. type: delimited block _
#: en/modules/reference/pages/admin/access-control.adoc:8
msgid "Description: A brief description explaining the purpose of the group."
msgstr "Description: ຄຳອະທິບາຍສັ້ນໆກ່ຽວກັບຈຸດປະສົງຂອງກຸ່ມ."

#. type: delimited block _
#: en/modules/reference/pages/admin/access-control.adoc:9
msgid "Organization: The organization to which the access group belongs."
msgstr "Organization: ອົງກອນທີ່ກຸ່ມການເຂົ້າເຖິງນີ້ຂຶ້ນກັບ."

#. type: delimited block _
#: en/modules/reference/pages/admin/access-control.adoc:10
msgid ""
"Copy permissions from: Allows copying permissions from an existing access "
"group.  Once created, the new group functions independently and is not "
"affected by future changes to the original group."
msgstr "Copy permissions from: ອະນຸຍາດໃຫ້ຄັດລອກສິດການເຂົ້າເຖິງຈາກກຸ່ມທີ່ມີຢູ່ແລ້ວ. ເມື່ອສ້າງແລ້ວ, ກຸ່ມໃໝ່ຈະເຮັດວຽກຢ່າງເປັນເອກະລາດ ແລະ ບໍ່ໄດ້ຮັບຜົນກະທົບຈາກການປ່ຽນແປງໃນອະນາຄົດຂອງກຸ່ມຕົ້ນສະບັບ."

#. type: delimited block _
#: en/modules/reference/pages/admin/access-control.adoc:11
#: en/modules/reference/pages/admin/access-control.adoc:19
#: en/modules/reference/pages/admin/access-control.adoc:21
msgid "Select btn:[Continue] to the next step."
msgstr "ເລືອກ btn:[Continue] ເພື່ອໄປຂັ້ນຕອນຕໍ່ໄປ."

#. type: delimited block _
#: en/modules/reference/pages/admin/access-control.adoc:12
msgid ""
"Define Namespaces and Permissions.  The following permissions types are "
"available:"
msgstr "ກຳນົດ Namespaces ແລະ ສິດການໃຊ້ງານ. ປະເພດສິດການໃຊ້ງານທີ່ມີໃຫ້ມີດັ່ງນີ້:"

#. type: delimited block _
#: en/modules/reference/pages/admin/access-control.adoc:13
msgid "View: Allows read-only access."
msgstr "View: ອະນຸຍາດໃຫ້ອ່ານໄດ້ຢ່າງດຽວ."

#. type: delimited block _
#: en/modules/reference/pages/admin/access-control.adoc:14
msgid "Modify: Allows creating, updating, or deleting resources."
msgstr "Modify: ອະນຸຍາດໃຫ້ສ້າງ, ອັບເດດ, ຫຼື ລຶບຊັບພະຍາກອນ."

#. type: delimited block _
#: en/modules/reference/pages/admin/access-control.adoc:15
msgid "The available filters for the Permission table are:"
msgstr "ຕົວຊ່ວຍກັ່ນຕອງທີ່ມີໃຫ້ສຳລັບຕາຕະລາງສິດການໃຊ້ງານ (Permission table) ຄື:"

#. type: delimited block _
#: en/modules/reference/pages/admin/access-control.adoc:16
msgid "Expand or collapse namespaces to view individual permissions"
msgstr "ຂະຫຍາຍ ຫຼື ຫຍໍ້ namespaces ເພື່ອເບິ່ງສິດການໃຊ້ງານແຕ່ລະອັນ"

#. type: delimited block _
#: en/modules/reference/pages/admin/access-control.adoc:17
msgid "Search permissions by: Name and Description"
msgstr "ຄົ້ນຫາສິດການໃຊ້ງານຕາມ: ຊື່ ແລະ ຄຳອະທິບາຍ"

#. type: delimited block _
#: en/modules/reference/pages/admin/access-control.adoc:18
msgid "Filter permissions by: API, Web or Only selected permissions"
msgstr "ກັ່ນຕອງສິດການໃຊ້ງານຕາມ: API, ເວັບ ຫຼື ສະເພາະສິດທີ່ຖືກເລືອກ"

#. type: delimited block _
#: en/modules/reference/pages/admin/access-control.adoc:20
msgid "Add users."
msgstr "ເພີ່ມຜູ້ໃຊ້."

#. type: delimited block _
#: en/modules/reference/pages/admin/access-control.adoc:22
msgid ""
"Review and verify the information, and confirm to create the access group.  "
"____"
msgstr "ກວດສອບ ແລະ ຢືນຢັນຂໍ້ມູນ, ແລ້ວຢືນຢັນເພື່ອສ້າງກຸ່ມການເຂົ້າເຖິງ. ____"

#. type: Title =
#: en/modules/reference/pages/admin/admin-menu.adoc:1
#, no-wrap
msgid "Admin Menu"
msgstr "ເມນູແອດມິນ"

#. type: Plain text
#: en/modules/reference/pages/admin/admin-menu.adoc:2
msgid ""
"The [guimenu]``Admin`` menu provides access to features for managing "
"{productname} configuration.  Configuration tasks include creating and "
"managing organizations, users, and tasks.  You can also use the setup wizard "
"to help configure {productname}."
msgstr "ເມນູ [guimenu]``Admin`` ໃຫ້ການເຂົ້າເຖິງຄຸນສົມບັດຕ່າງໆສຳລັບການຈັດການການກຳນົດຄ່າ {productname}. ວຽກງານການກຳນົດຄ່າລວມມີການສ້າງ ແລະ ຈັດການອົງກອນ, ຜູ້ໃຊ້, ແລະ ວຽກງານຕ່າງໆ. ທ່ານຍັງສາມາດໃຊ້ setup wizard ເພື່ອຊ່ວຍໃນການກຳນົດຄ່າ {productname}."

#. type: delimited block =
#: en/modules/reference/pages/admin/admin-menu.adoc:3
msgid ""
"The [guimenu]``Admin`` menu is only available if you are logged in to "
"{productname} with an administrator account."
msgstr "ເມນູ [guimenu]``Admin`` ຈະໃຊ້ໄດ້ກໍຕໍ່ເມື່ອທ່ານເຂົ້າສູ່ລະບົບ {productname} ດ້ວຍບັນຊີຜູ້ດູແລລະບົບ (ແອດມິນ) ເທົ່ານັ້ນ."

#. type: Title =
#: en/modules/reference/pages/admin/bootstrap-script.adoc:1
#, no-wrap
msgid "Bootstrap Script"
msgstr "ສະຄຣິບ Bootstrap"

#. type: Plain text
#: en/modules/reference/pages/admin/bootstrap-script.adoc:2
msgid ""
"In the menu:Admin[Manager Configuration > Bootstrap Script] section you can "
"generate a custom bootstrap script.  Bootstrap scripts are used to register "
"clients with {productname}.  The generated script will be placed in "
"[path]``/srv/www/htdocs/pub/bootstrap/`` on your {productname} Server."
msgstr "ໃນສ່ວນ menu:Admin[Manager Configuration > Bootstrap Script] ທ່ານສາມາດສ້າງສະຄຣິບ bootstrap ແບບກຳນົດເອງໄດ້. ສະຄຣິບ Bootstrap ຖືກໃຊ້ເພື່ອລົງທະບຽນໄຄເອັນກັບ {productname}. ສະຄຣິບທີ່ຖືກສ້າງຂຶ້ນຈະຖືກເກັບໄວ້ໃນ [path]``/srv/www/htdocs/pub/bootstrap/`` ໃນເຊີເວີ {productname} ຂອງທ່ານ."

#. type: Block title
#: en/modules/reference/pages/admin/bootstrap-script.adoc:3
#: en/modules/reference/pages/admin/general.adoc:3
#, no-wrap
msgid "Bootstrap Script Options"
msgstr "ຕົວເລືອກສະຄຣິບ Bootstrap"

#. type: Table
#: en/modules/reference/pages/admin/bootstrap-script.adoc:4
#, no-wrap
msgid ""
"| Option                            | Description   | Default\n"
"| {productname} Server hostname     | The hostname for the {productname} "
"Server to register the client to | Pre-populated\n"
"| SSL cert location                 | Location and name of the SSL "
"certificate | Pre-populated\n"
"| Bootstrap using Salt              | Check to bootstrap clients | Checked\n"
"| Enable SSL                        | Check to use the corporate public CA "
"certificate on the client, uncheck to use self-managed CA certificates. | "
"Checked\n"
"| Enable Client GPG checking        | Check to use GPG, uncheck to disable "
"GPG checking | Checked\n"
"| Enable Remote Configuration       | Check to allow configuration from a "
"remote server. | Unchecked\n"
"| Enable Remote Commands            | Check to allow commands from a remote "
"server. | Unchecked\n"
"| Client HTTP Proxy                 | The hostname of the proxy server, if "
"you are using one. | Unpopulated\n"
"| Client HTTP Proxy Username        | The username to use on the proxy "
"server, if you are using one. | Unpopulated\n"
"| Client HTTP Proxy Password        | The password to use on the proxy "
"server, if you are using one. | Unpopulated\n"
msgstr ""
"| ຕົວເລືອກ | ຄຳອະທິບາຍ | ຄ່າເລີ່ມຕົ້ນ\n"
"| {productname} Server hostname | ຊື່ໂຮສຂອງເຊີເວີ {productname} ທີ່ຕ້ອງການລົງທະບຽນໄຄເອັນ | ມີຂໍ້ມູນມາໃຫ້ກ່ອນ\n"
"| SSL cert location | ສະຖານທີ່ ແລະ ຊື່ຂອງໃບຮັບຮອງ SSL | ມີຂໍ້ມູນມາໃຫ້ກ່ອນ\n"
"| Bootstrap using Salt | ເລືອກເພື່ອ bootstrap ໄຄເອັນ | ເລືອກໄວ້\n"
"| Enable SSL | ເລືອກເພື່ອໃຊ້ໃບຮັບຮອງ CA ສາທາລະນະຂອງບໍລິສັດໃນໄຄເອັນ, ຍົກເລີກການເລືອກເພື່ອໃຊ້ໃບຮັບຮອງ CA ທີ່ຈັດການເອງ | ເລືອກໄວ້\n"
"| Enable Client GPG checking | ເລືອກເພື່ອໃຊ້ GPG, ຍົກເລີກການເລືອກເພື່ອປິດການກວດສອບ GPG | ເລືອກໄວ້\n"
"| Enable Remote Configuration | ເລືອກເພື່ອອະນຸຍາດການກຳນົດຄ່າຈາກເຊີເວີທາງໄກ | ບໍ່ໄດ້ເລືອກ\n"
"| Enable Remote Commands | ເລືອກເພື່ອອະນຸຍາດຄຳສັ່ງຈາກເຊີເວີທາງໄກ | ບໍ່ໄດ້ເລືອກ\n"
"| Client HTTP Proxy | ຊື່ໂຮສຂອງເຊີເວີ proxy ຫາກທ່ານມີການໃຊ້ງານ | ບໍ່ມີຂໍ້ມູນ\n"
"| Client HTTP Proxy Username | ຊື່ຜູ້ໃຊ້ສຳລັບເຊີເວີ proxy ຫາກທ່ານມີການໃຊ້ງານ | ບໍ່ມີຂໍ້ມູນ\n"
"| Client HTTP Proxy Password | ລະຫັດຜ່ານສຳລັບເຊີເວີ proxy ຫາກທ່ານມີການໃຊ້ງານ | ບໍ່ມີຂໍ້ມູນ\n"

#. type: delimited block =
#: en/modules/reference/pages/admin/bootstrap-script.adoc:5
msgid ""
"Do not disable SSL in your bootstrap script.  Ensure that [guimenu]``Enable "
"SSL`` is checked in the {webui}, or that the setting `USING_SSL=1` exists in "
"the bootstrap script.  If you disable SSL, the registration process requires "
"custom SSL certificates.  For more about custom certificates, see "
"xref:administration:ssl-certs.adoc[]."
msgstr "ຫ້າມປິດການໃຊ້ງານ SSL ໃນສະຄຣິບ bootstrap ຂອງທ່ານ. ໃຫ້ແນ່ໃຈວ່າ [guimenu]``Enable SSL`` ຖືກເລືອກໄວ້ໃນ {webui}, ຫຼື ມີການຕັ້ງຄ່າ `USING_SSL=1` ຢູ່ໃນສະຄຣິບ bootstrap. ຫາກທ່ານປິດ SSL, ຂະບວນການລົງທະບຽນຈະຕ້ອງໃຊ້ໃບຮັບຮອງ SSL ແບບກຳນົດເອງ. ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບໃບຮັບຮອງແບບກຳນົດເອງ, ໃຫ້ເບິ່ງ xref:administration:ssl-certs.adoc[]."

#. type: Title =
#: en/modules/reference/pages/admin/cobbler.adoc:1
#, no-wrap
msgid "{cobbler}"
msgstr "{cobbler}"

#. type: Plain text
#: en/modules/reference/pages/admin/cobbler.adoc:2
msgid ""
"The menu:Admin[Manager Configuration > Cobbler] page allows you to run a "
"{cobbler} synchronization.  You can repair or rebuild the contents of the "
"[path]``/srv/tftpboot/`` and [path]``/srv/www/cobbler/`` directories after a "
"manual modification of the {cobbler} setup."
msgstr "ໜ້າ menu:Admin[Manager Configuration > Cobbler] ອະນຸຍາດໃຫ້ທ່ານເຮັດການ synchronize {cobbler}. ທ່ານສາມາດສ້ອມແປງ ຫຼື ສ້າງເນື້ອຫາຂອງໄດເຣັກທໍຣີ [path]``/srv/tftpboot/`` ແລະ [path]``/srv/www/cobbler/`` ຄືນໃໝ່ ຫຼັງຈາກທີ່ມີການແກ້ໄຂການຕັ້ງຄ່າ {cobbler} ດ້ວຍຕົນເອງ."

#. type: Plain text
#: en/modules/reference/pages/admin/cobbler.adoc:3
msgid ""
"For more information about autoinstallation powered by {cobbler}, see "
"xref:client-configuration:autoinst-intro.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການຕິດຕັ້ງອັດຕະໂນມັດທີ່ຂັບເຄື່ອນໂດຍ {cobbler}, ໃຫ້ເບິ່ງ xref:client-configuration:autoinst-intro.adoc[]."

#. type: delimited block =
#: en/modules/reference/pages/admin/cobbler.adoc:4
msgid ""
"{suse} only supports {cobbler} functions that are available in the "
"{productname} {webui}, or through the {productname} API.  Only supported "
"features are documented here."
msgstr "{suse} ຮອງຮັບສະເພາະຟັງຊັນ {cobbler} ທີ່ມີໃຫ້ໃນ {webui} ຂອງ {productname}, ຫຼື ຜ່ານ {productname} API ເທົ່ານັ້ນ. ສະເພາະຄຸນສົມບັດທີ່ຮອງຮັບເທົ່ານັ້ນທີ່ຖືກບັນທຶກໄວ້ໃນທີ່ນີ້."

#. type: delimited block =
#: en/modules/reference/pages/admin/cobbler.adoc:5
msgid "Using NFS for the persisent volumes of {cobbler} is not supported."
msgstr "ບໍ່ຮອງຮັບການໃຊ້ NFS ສຳລັບ persistent volumes ຂອງ {cobbler}."

#. type: Title =
#: en/modules/reference/pages/admin/general.adoc:1
#, no-wrap
msgid "General"
msgstr "ທົ່ວໄປ"

#. type: Plain text
#: en/modules/reference/pages/admin/general.adoc:2
msgid ""
"On the menu:Admin[Manager Configuration > General] page you can configure "
"your {productname} installation."
msgstr "ໃນໜ້າ menu:Admin[Manager Configuration > General] ທ່ານສາມາດກຳນົດຄ່າການຕິດຕັ້ງ {productname} ຂອງທ່ານໄດ້."

#. type: Table
#: en/modules/reference/pages/admin/general.adoc:4
#, no-wrap
msgid ""
"| Option                       | Description   | Default\n"
"| Administrator Email Address  | Email address of the {productname} "
"administrator. | Pre-populated\n"
"| {productname} Hostname       | Hostname of the {productname} Server. | "
"Pre-populated\n"
"| HTTP Proxy                   | The hostname and port of the proxy, if you "
"are using one. Use syntax ``<hostname>:<port>``, for example: "
"``<example.com>:8080``. | None\n"
"| HTTP Proxy username          | The username to use on the proxy server, if "
"you are using one. | None\n"
"| HTTP Proxy password        | The password to use on the proxy server, if "
"you are using one. | None\n"
"| Confirm HTTP Proxy password  | The directory where RPM packages are "
"mirrored. | [path]``/var/spacewalk/``\n"
"| RPM repository mount point   | The hostname of the proxy server, if you "
"are using one. | None\n"
"| Default to SSL        | Check to use SSL as the default value for "
"communications. | Checked\n"
msgstr ""
"| ຕົວເລືອກ | ຄຳອະທິບາຍ | ຄ່າເລີ່ມຕົ້ນ\n"
"| Administrator Email Address | ທີ່ຢູ່ອີເມລຂອງຜູ້ດູແລລະບົບ {productname} | ມີຂໍ້ມູນມາໃຫ້ກ່ອນ\n"
"| {productname} Hostname | ຊື່ໂຮສຂອງເຊີເວີ {productname} | ມີຂໍ້ມູນມາໃຫ້ກ່ອນ\n"
"| HTTP Proxy | ຊື່ໂຮສ ແລະ ພອດຂອງ proxy, ຫາກທ່ານມີການໃຊ້ງານ. ໃຊ້ໄວຍາກອນ ``<hostname>:<port>``, ຕົວຢ່າງ: ``<example.com>:8080`` | ບໍ່ມີ\n"
"| HTTP Proxy username | ຊື່ຜູ້ໃຊ້ສຳລັບເຊີເວີ proxy | ບໍ່ມີ\n"
"| HTTP Proxy password | ລະຫັດຜ່ານສຳລັບເຊີເວີ proxy | ບໍ່ມີ\n"
"| Confirm HTTP Proxy password | ຢືນຢັນລະຫັດຜ່ານ HTTP Proxy | ບໍ່ມີ\n"
"| RPM repository mount point | ໄດເຣັກທໍຣີທີ່ໃຊ້ໃນການ mirror ແພັກເກດ RPM | [path]``/var/spacewalk/``\n"
"| Default to SSL | ເລືອກເພື່ອໃຊ້ SSL ເປັນຄ່າເລີ່ມຕົ້ນສຳລັບການສື່ສານ | ເລືອກໄວ້\n"

#. type: Title =
#: en/modules/reference/pages/admin/manager-config-organizations.adoc:1
#, no-wrap
msgid "Configure Organizations"
msgstr "ກຳນົດຄ່າອົງກອນ"

#. type: Plain text
#: en/modules/reference/pages/admin/manager-config-organizations.adoc:2
msgid ""
"The menu:Admin[Manager Configuration > Organizations] section contains "
"details about organizations in {productname}, and provides links to create "
"and configure organizations and users."
msgstr "ສ່ວນ menu:Admin[Manager Configuration > Organizations] ປະກອບດ້ວຍລາຍລະອຽດກ່ຽວກັບອົງກອນຕ່າງໆໃນ {productname}, ແລະ ໃຫ້ລິ້ງເພື່ອສ້າງ ແລະ ກຳນົດຄ່າອົງກອນ ແລະ ຜູ້ໃຊ້."

#. type: Title =
#: en/modules/reference/pages/admin/manager-configuration.adoc:1
#, no-wrap
msgid "Manager Configuration"
msgstr "ການກຳນົດຄ່າຕົວຈັດການ"

#. type: Plain text
#: en/modules/reference/pages/admin/manager-configuration.adoc:2
msgid ""
"The menu:Admin[Manager Configuration] section contains tabs to allow you to "
"configure {productname}."
msgstr "ສ່ວນ menu:Admin[Manager Configuration] ປະກອບດ້ວຍແທັບຕ່າງໆເພື່ອໃຫ້ທ່ານກຳນົດຄ່າ {productname}."

#. type: Block title
#: en/modules/reference/pages/admin/manager-configuration.adoc:3
#, no-wrap
msgid "Configuration Options"
msgstr "ຕົວເລືອກການກຳນົດຄ່າ"

#. type: Table
#: en/modules/reference/pages/admin/manager-configuration.adoc:4
#, no-wrap
msgid ""
"| Option             | Description\n"
"| General            | Configure your {productname} installation.\n"
"| Bootstrap Script   | Generate a custom bootstrap script.\n"
"| Organizations      | Create and configure organizations and users.\n"
"| Restart            | Restart {productname}. You will need to do this after "
"making configuration changes.\n"
"| {cobbler}          | Run a {cobbler} synchronization.\n"
"| Monitoring         | Enable server monitoring.\n"
msgstr ""
"| ຕົວເລືອກ | ຄຳອະທິບາຍ\n"
"| General | ກຳນົດຄ່າການຕິດຕັ້ງ {productname} ຂອງທ່ານ.\n"
"| Bootstrap Script | ສ້າງສະຄຣິບ bootstrap ແບບກຳນົດເອງ.\n"
"| Organizations | ສ້າງ ແລະ ກຳນົດຄ່າອົງກອນ ແລະ ຜູ້ໃຊ້.\n"
"| Restart | ຣີສະຕາດ {productname}. ທ່ານຈຳເປັນຕ້ອງເຮັດສິ່ງນີ້ຫຼັງຈາກປ່ຽນການກຳນົດຄ່າ.\n"
"| {cobbler} | ເຮັດການ synchronize {cobbler}.\n"
"| Monitoring | ເປີດການຕິດຕາມເຊີເວີ.\n"

#. type: Title =
#: en/modules/reference/pages/admin/monitoring.adoc:1
#, no-wrap
msgid "Monitoring"
msgstr "ການຕິດຕາມ"

#. type: Plain text
#: en/modules/reference/pages/admin/monitoring.adoc:2
msgid ""
"The menu:Admin[Manager Configuration > Monitoring] section allows you to "
"enable {productname} monitoring with Prometheus."
msgstr "ສ່ວນ menu:Admin[Manager Configuration > Monitoring] ອະນຸຍາດໃຫ້ທ່ານເປີດການຕິດຕາມ {productname} ດ້ວຍ Prometheus."

#. type: Plain text
#: en/modules/reference/pages/admin/monitoring.adoc:3
msgid ""
"For more information about monitoring, see "
"xref:administration:monitoring.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການຕິດຕາມ, ໃຫ້ເບິ່ງ xref:administration:monitoring.adoc[]."

#. type: Title =
#: en/modules/reference/pages/admin/organizations.adoc:1
#, no-wrap
msgid "Organizations"
msgstr "ອົງກອນ (Organizations)"

#. type: Plain text
#: en/modules/reference/pages/admin/organizations.adoc:2
msgid ""
"The menu:Admin[Organizations] section allows you to create and manage your "
"{productname} organizations.  Click an organization in the list to see "
"details."
msgstr "ສ່ວນ menu:Admin[Organizations] ອະນຸຍາດໃຫ້ທ່ານສ້າງ ແລະ ຈັດການອົງກອນ {productname} ຂອງທ່ານ. ກົດທີ່ອົງກອນໃນລາຍຊື່ເພື່ອເບິ່ງລາຍລະອຽດ."

#. type: Plain text
#: en/modules/reference/pages/admin/organizations.adoc:3
#: en/modules/reference/pages/home/my-organization-configuration-channels.adoc:3
#: en/modules/reference/pages/home/my-organization-configuration.adoc:8
#: en/modules/reference/pages/home/my-organization-menu.adoc:3
msgid ""
"For more information about organizations, see "
"xref:administration:organizations.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບອົງກອນ, ໃຫ້ເບິ່ງ xref:administration:organizations.adoc[]."

#. type: Title =
#: en/modules/reference/pages/admin/payg.adoc:1
#, no-wrap
msgid "{Payg}"
msgstr "{Payg}"

#. type: Plain text
#: en/modules/reference/pages/admin/payg.adoc:2
msgid ""
"The menu:Admin[{payg}] section allows you to view and manage {payg} "
"instances.  Every instance shows its description and connection data."
msgstr "ສ່ວນ menu:Admin[{payg}] ອະນຸຍາດໃຫ້ທ່ານເບິ່ງ ແລະ ຈັດການ {payg} instances. ແຕ່ລະ instance ຈະສະແດງຄຳອະທິບາຍ ແລະ ຂໍ້ມູນການເຊື່ອມຕໍ່."

#. type: Plain text
#: en/modules/reference/pages/admin/payg.adoc:3
msgid ""
"To add new instance, click btn:[Add {payg}].  Click an instance to modify "
"its details."
msgstr "ເພື່ອເພີ່ມ instance ໃໝ່, ໃຫ້ກົດ btn:[Add {payg}]. ກົດທີ່ instance ເພື່ອແກ້ໄຂລາຍລະອຽດ."

#. type: Plain text
#: en/modules/reference/pages/admin/payg.adoc:4
msgid ""
"For more information, see "
"xref:specialized-guides:public-cloud-guide/payg/payg-overview.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມ, ໃຫ້ເບິ່ງ xref:specialized-guides:public-cloud-guide/payg/payg-overview.adoc[]."

#. type: Title =
#: en/modules/reference/pages/admin/restart.adoc:1
#, no-wrap
msgid "Restart"
msgstr "ຣີສະຕາດ"

#. type: Plain text
#: en/modules/reference/pages/admin/restart.adoc:2
msgid ""
"The menu:Admin[Manager Configuration > Restart] section allows you to "
"restart {productname}.  You will need to do this after making configuration "
"changes.  It will take some time for {productname} to become available again "
"after a restart."
msgstr "ສ່ວນ menu:Admin[Manager Configuration > Restart] ອະນຸຍາດໃຫ້ທ່ານຣີສະຕາດ {productname}. ທ່ານຈຳເປັນຕ້ອງເຮັດສິ່ງນີ້ຫຼັງຈາກປ່ຽນການກຳນົດຄ່າ. ມັນຈະໃຊ້ເວລາຄາວໜຶ່ງເພື່ອໃຫ້ {productname} ກັບມາໃຊ້ງານໄດ້ອີກຄັ້ງຫຼັງຈາກຣີສະຕາດ."

#. type: Title =
#: en/modules/reference/pages/admin/setup-wizard.adoc:1
#, no-wrap
msgid "Setup Wizard"
msgstr "ຕົວຊ່ວຍໃນການຕັ້ງຄ່າ (Setup Wizard)"

#. type: Plain text
#: en/modules/reference/pages/admin/setup-wizard.adoc:2
msgid ""
"The menu:Admin[Setup Wizard] section helps you configure {productname}.  It "
"is the default page when you use the {productname} {webui} for the first "
"time."
msgstr "ສ່ວນ menu:Admin[Setup Wizard] ຊ່ວຍໃຫ້ທ່ານກຳນົດຄ່າ {productname}. ມັນແມ່ນໜ້າເລີ່ມຕົ້ນເມື່ອທ່ານໃຊ້ {productname} {webui} ເປັນຄັ້ງທຳອິດ."

#. type: Block title
#: en/modules/reference/pages/admin/setup-wizard.adoc:3
#, no-wrap
msgid "Setup Wizard Options"
msgstr "ຕົວເລືອກ Setup Wizard"

#. type: Table
#: en/modules/reference/pages/admin/setup-wizard.adoc:4
#, no-wrap
msgid ""
"| Option             | Description\n"
"| HTTP Proxy         | Configure an HTTP proxy connection.\n"
"| Organization Credentials   | Configure an organization for accessing "
"{scclongform}.\n"
"| Products      | View product entitlements and subscribe to product "
"channels.\n"
msgstr ""
"| ຕົວເລືອກ | ຄຳອະທິບາຍ\n"
"| HTTP Proxy | ກຳນົດຄ່າການເຊື່ອມຕໍ່ HTTP proxy.\n"
"| Organization Credentials | ກຳນົດຄ່າຂໍ້ມູນປະຈຳຕົວອົງກອນສຳລັບການເຂົ້າເຖິງ {scclongform}.\n"
"| Products | ເບິ່ງສິດທິຂອງຜະລິດຕະພັນ ແລະ ສະໝັກໃຊ້ຊ່ອງທາງຜະລິດຕະພັນ.\n"

#. type: Title ==
#: en/modules/reference/pages/admin/setup-wizard.adoc:5
#, no-wrap
msgid "Configure the HTTP Proxy"
msgstr "ກຳນົດຄ່າ HTTP Proxy"

#. type: Plain text
#: en/modules/reference/pages/admin/setup-wizard.adoc:6
msgid ""
"{productname} can connect to the {scclongform} (SCC) or other remote servers "
"using a proxy.  Navigate to the [guimenu]``HTTP Proxy`` tab to configure the "
"proxy."
msgstr "{productname} ສາມາດເຊື່ອມຕໍ່ກັບ {scclongform} (SCC) ຫຼື ເຊີເວີທາງໄກອື່ນໆໂດຍໃຊ້ proxy. ໃຫ້ໄປທີ່ແທັບ [guimenu]``HTTP Proxy`` ເພື່ອກຳນົດຄ່າ proxy."

#. type: Plain text
#: en/modules/reference/pages/admin/setup-wizard.adoc:7
msgid ""
"You will need to provide the hostname of the proxy.  Use the syntax "
"``<hostname>:<port>``.  For example: ``example.com:8080``."
msgstr "ທ່ານຈະຕ້ອງລະບຸຊື່ໂຮສຂອງ proxy. ໃຊ້ໄວຍາກອນ ``<hostname>:<port>``. ຕົວຢ່າງ: ``example.com:8080``."

#. type: Plain text
#: en/modules/reference/pages/admin/setup-wizard.adoc:8
msgid "You can disable use of the proxy by clearing the fields."
msgstr "ທ່ານສາມາດປິດການໃຊ້ງານ proxy ໄດ້ໂດຍການລຶບຂໍ້ມູນໃນຊ່ອງຕ່າງໆອອກ."

#. type: delimited block =
#: en/modules/reference/pages/admin/setup-wizard.adoc:9
msgid ""
"When choosing a username or password for your {productname} Proxy, ensure it "
"does not contain an ``@`` or ``:`` character.  These characters are "
"reserved."
msgstr "ເມື່ອເລືອກຊື່ຜູ້ໃຊ້ ຫຼື ລະຫັດຜ່ານສຳລັບ proxy {productname} ຂອງທ່ານ, ໃຫ້ແນ່ໃຈວ່າມັນບໍ່ມີຕົວອັກສອນ ``@`` ຫຼື ``:``. ຕົວອັກສອນເຫຼົ່ານີ້ແມ່ນຖືກສະຫງວນໄວ້."

#. type: Title ==
#: en/modules/reference/pages/admin/setup-wizard.adoc:10
#, no-wrap
msgid "Configure Organization Credentials"
msgstr "ກຳນົດຄ່າຂໍ້ມູນປະຈຳຕົວອົງກອນ"

#. type: Plain text
#: en/modules/reference/pages/admin/setup-wizard.adoc:11
msgid ""
"Your {scclongform} account is associated with the administration account of "
"your organization.  You can share your {scclongform} access with other users "
"within your organization.  Navigate to the [guimenu]``Organization "
"Credentials`` tab to grant users within your organization access to your "
"{scclongform} account."
msgstr "ບັນຊີ {scclongform} ຂອງທ່ານມີຄວາມກ່ຽວຂ້ອງກັບບັນຊີຜູ້ດູແລຂອງອົງກອນທ່ານ. ທ່ານສາມາດແບ່ງປັນການເຂົ້າເຖິງ {scclongform} ກັບຜູ້ໃຊ້ອື່ນໆພາຍໃນອົງກອນຂອງທ່ານໄດ້. ໃຫ້ໄປທີ່ແທັບ [guimenu]``Organization Credentials`` ເພື່ອໃຫ້ສິດຜູ້ໃຊ້ພາຍໃນອົງກອນເຂົ້າເຖິງບັນຊີ {scclongform} ຂອງທ່ານ."

#. type: Plain text
#: en/modules/reference/pages/admin/setup-wizard.adoc:12
msgid ""
"Click btn:[Add a new credential], enter the username and password of the "
"user to grant access to, and click btn:[Save].  A new credential card is "
"shown for the user you have granted access to.  Use these buttons on the "
"card to edit or revoke access:"
msgstr "ກົດ btn:[Add a new credential], ປ້ອນຊື່ຜູ້ໃຊ້ ແລະ ລະຫັດຜ່ານຂອງຜູ້ໃຊ້ທີ່ຕ້ອງການໃຫ້ສິດ, ແລ້ວກົດ btn:[Save]. ບັດຂໍ້ມູນປະຈຳຕົວໃໝ່ຈະສະແດງຂຶ້ນສຳລັບຜູ້ໃຊ້ທີ່ທ່ານໄດ້ໃຫ້ສິດ. ໃຊ້ປຸ່ມເຫຼົ່ານີ້ໃນບັດເພື່ອແກ້ໄຂ ຫຼື ຍົກເລີກການເຂົ້າເຖິງ:"

#. type: Plain text
#: en/modules/reference/pages/admin/setup-wizard.adoc:13
msgid "Check credential validation status (green tick or red cross icon)."
msgstr "ກວດສອບສະຖານະຄວາມຖືກຕ້ອງຂອງຂໍ້ມູນປະຈຳຕົວ (ໄອຄອນເຄື່ອງໝາຍຕິກສີຂຽວ ຫຼື ກາກບາດສີແດງ)."

#. type: Plain text
#: en/modules/reference/pages/admin/setup-wizard.adoc:14
msgid "To re-check the credential with SCC, click the icon."
msgstr "ເພື່ອທຳການກວດສອບຂໍ້ມູນປະຈຳຕົວກັບ SCC ຄືນໃໝ່, ໃຫ້ກົດທີ່ໄອຄອນ."

#. type: Plain text
#: en/modules/reference/pages/admin/setup-wizard.adoc:15
msgid ""
"Set the primary credentials for inter-server synchronization (yellow star "
"icon)."
msgstr "ຕັ້ງຄ່າຂໍ້ມູນປະຈຳຕົວຫຼັກສຳລັບການຊິງໂຄຣໄນລະຫວ່າງເຊີເວີ (ໄອຄອນດາວສີເຫຼືອງ)."

#. type: Plain text
#: en/modules/reference/pages/admin/setup-wizard.adoc:16
msgid "List the subscriptions related to a certain credential (list icon)."
msgstr "ສະແດງລາຍຊື່ການສະໝັກໃຊ້ທີ່ກ່ຽວຂ້ອງກັບຂໍ້ມູນປະຈຳຕົວນັ້ນໆ (ໄອຄອນລາຍການ)."

#. type: Plain text
#: en/modules/reference/pages/admin/setup-wizard.adoc:17
msgid "Edit the credential (pencil icon)."
msgstr "ແກ້ໄຂຂໍ້ມູນປະຈຳຕົວ (ໄອຄອນສໍ)."

#. type: Plain text
#: en/modules/reference/pages/admin/setup-wizard.adoc:18
msgid "Delete the credential (trash can icon)."
msgstr "ລຶບຂໍ້ມູນປະຈຳຕົວ (ໄອຄອນຖັງຂີ້ເຫຍື້ອ)."

#. type: Title ==
#: en/modules/reference/pages/admin/setup-wizard.adoc:19
#, no-wrap
msgid "Configure Products"
msgstr "ຕັ້ງຄ່າຜະລິດຕະພັນ"

#. type: Plain text
#: en/modules/reference/pages/admin/setup-wizard.adoc:20
msgid ""
"Your {suse} subscription entitles you to access a range of products.  "
"Navigate to the [guimenu]``Products`` tab to browse the products available "
"to you and synchronize {productname} with {scclongform}."
msgstr "ການສະໝັກໃຊ້ {suse} ຂອງທ່ານໃຫ້ສິດໃນການເຂົ້າເຖິງຜະລິດຕະພັນຕ່າງໆ. ໃຫ້ໄປທີ່ແທັບ [guimenu]``Products`` ເພື່ອເບິ່ງຜະລິດຕະພັນທີ່ມີໃຫ້ທ່ານ ແລະ synchronize {productname} ກັບ {scclongform}."

#. type: Plain text
#: en/modules/reference/pages/admin/setup-wizard.adoc:21
msgid "Filters help you search for products by description or architecture."
msgstr "ຕົວຊ່ວຍກັ່ນຕອງຊ່ວຍໃຫ້ທ່ານຄົ້ນຫາຜະລິດຕະພັນຕາມຄຳອະທິບາຍ ຫຼື ສະຖາປັດຕະຍະກຳ."

#. type: Plain text
#: en/modules/reference/pages/admin/setup-wizard.adoc:22
msgid ""
"The list is organized by product name showing products on top which have a "
"subscription.  Freely available products appear at the end of the list.  For "
"each product, you can see the architecture it can be used on.  Click the "
"arrow next to the product name to see associated channels and extensions.  "
"Click the btn:[Channels] icon to see the complete list of channels "
"associated with each product."
msgstr "ລາຍຊື່ຖືກຈັດລຽງຕາມຊື່ຜະລິດຕະພັນ ໂດຍສະແດງຜະລິດຕະພັນທີ່ມີການສະໝັກໃຊ້ໄວ້ທາງເທິງ. ຜະລິດຕະພັນທີ່ໃຫ້ໃຊ້ຟຣີຈະປະກົດຢູ່ທ້າຍລາຍການ. ສຳລັບແຕ່ລະຜະລິດຕະພັນ, ທ່ານສາມາດເບິ່ງສະຖາປັດຕະຍະກຳທີ່ຮອງຮັບໄດ້. ກົດທີ່ລູກສອນຂ້າງຊື່ຜະລິດຕະພັນເພື່ອເບິ່ງຊ່ອງທາງ ແລະ ສ່ວນຂະຫຍາຍທີ່ກ່ຽວຂ້ອງ. ກົດໄອຄອນ btn:[Channels] ເພື່ອເບິ່ງລາຍຊື່ຊ່ອງທາງທັງໝົດທີ່ກ່ຽວຂ້ອງກັບແຕ່ລະຜະລິດຕະພັນ."

#. type: Plain text
#: en/modules/reference/pages/admin/setup-wizard.adoc:23
msgid ""
"For products based on {sle}{nbsp}15 and above, you can choose to only "
"synchronize required packages, or to also include recommended products.  "
"Toggle the btn:[include recommended] switch on to synchronize all products, "
"and toggle the switch off to synchronize only required products."
msgstr "ສຳລັບຜະລິດຕະພັນທີ່ອີງໃສ່ {sle}{nbsp}15 ຂຶ້ນໄປ, ທ່ານສາມາດເລືອກທີ່ຈະ synchronize ສະເພາະແພັກເກດທີ່ຈຳເປັນ ຫຼື ລວມເອົາຜະລິດຕະພັນທີ່ແນະນຳນຳ. ເປີດສະວິດ btn:[include recommended] ເພື່ອ synchronize ທຸກຜະລິດຕະພັນ, ແລະ ປິດສະວິດເພື່ອ synchronize ສະເພາະຜະລິດຕະພັນທີ່ຈຳເປັນ."

#. type: Plain text
#: en/modules/reference/pages/admin/setup-wizard.adoc:24
msgid ""
"You can further refine which products you want to synchronize by selecting "
"or deselecting individual product."
msgstr "ທ່ານສາມາດເລືອກຜະລິດຕະພັນທີ່ຕ້ອງການ synchronize ໄດ້ລະອຽດຂຶ້ນໂດຍການເລືອກ ຫຼື ຍົກເລີກການເລືອກແຕ່ລະຜະລິດຕະພັນ."

#. type: Plain text
#: en/modules/reference/pages/admin/setup-wizard.adoc:25
msgid ""
"When you have completed your selection, click btn:[Add products], and click "
"btn:[Refresh] to schedule the synchronization."
msgstr "ເມື່ອທ່ານເລືອກສຳເລັດແລ້ວ, ໃຫ້ກົດ btn:[Add products], ແລະ ກົດ btn:[Refresh] ເພື່ອຕັ້ງເວລາການ synchronize."

#. type: Plain text
#: en/modules/reference/pages/admin/setup-wizard.adoc:26
msgid ""
"Synchronization progress for each product is shown in a progress bar next to "
"the product name.  Depending on the products you have chosen, "
"synchronization can take up to several hours.  New products will be "
"available for you to use in {productname} when synchronization is complete."
msgstr "ຄວາມຄືບໜ້າການ synchronize ສຳລັບແຕ່ລະຜະລິດຕະພັນຈະສະແດງໃນແຖບຄວາມຄືບໜ້າຂ້າງຊື່ຜະລິດຕະພັນ. ຂຶ້ນກັບຜະລິດຕະພັນທີ່ທ່ານເລືອກ, ການ synchronize ອາດໃຊ້ເວລາຫຼາຍຊົ່ວໂມງ. ຜະລິດຕະພັນໃໝ່ຈະພ້ອມໃຫ້ໃຊ້ງານໃນ {productname} ເມື່ອການ synchronize ສຳເລັດ."

#. type: Plain text
#: en/modules/reference/pages/admin/setup-wizard.adoc:27
msgid ""
"If your synchronization fails, it could be because of a third party GPG key "
"or your company firewall blocking access to the download server.  Please "
"check the notification details for the error.  For more information about "
"troubleshooting product synchronization, see "
"xref:administration:troubleshooting/tshoot-sync.adoc[]."
msgstr "ຫາກການ synchronize ຫຼົ້ມເຫຼວ, ມັນອາດຈະເກີດຈາກ GPG key ພາຍນອກ ຫຼື firewall ຂອງບໍລິສັດທ່ານປິດກັ້ນການເຂົ້າເຖິງເຊີເວີດາວໂຫຼດ. ກະລຸນາກວດສອບລາຍລະອຽດການແຈ້ງເຕືອນສຳລັບຂໍ້ຜິດພາດ. ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການແກ້ໄຂບັນຫາການ synchronize ຜະລິດຕະພັນ, ໃຫ້ເບິ່ງ xref:administration:troubleshooting/tshoot-sync.adoc[]."

#. type: Title =
#: en/modules/reference/pages/admin/show-tomcat-logs.adoc:1
#, no-wrap
msgid "Show Tomcat Logs"
msgstr "ສະແດງບັນທຶກ Tomcat"

#. type: Plain text
#: en/modules/reference/pages/admin/show-tomcat-logs.adoc:2
msgid ""
"The menu:Admin[Show Tomcat Logs] section shows the Apache Tomcat log file.  "
"You can also view the Tomcat log from the command prompt at "
"[path]``/var/log/rhn/rhn_web_ui.log``."
msgstr "ສ່ວນ menu:Admin[Show Tomcat Logs] ສະແດງໄຟລ໌ບັນທຶກຂອງ Apache Tomcat. ທ່ານຍັງສາມາດເບິ່ງບັນທຶກ Tomcat ຈາກ command prompt ໄດ້ທີ່ [path]``/var/log/rhn/rhn_web_ui.log``."

#. type: delimited block =
#: en/modules/reference/pages/admin/show-tomcat-logs.adoc:3
msgid ""
"The menu:Admin[Show Tomcat Logs] section is only available if you are signed "
"in to {productname} with an administrator account."
msgstr "ສ່ວນ menu:Admin[Show Tomcat Logs] ຈະໃຊ້ໄດ້ກໍຕໍ່ເມື່ອທ່ານເຂົ້າສູ່ລະບົບ {productname} ດ້ວຍບັນຊີຜູ້ດູແລລະບົບ (ແອດມິນ) ເທົ່ານັ້ນ."

#. type: Title =
#: en/modules/reference/pages/admin/task-engine-status.adoc:1
#, no-wrap
msgid "Task Engine Status"
msgstr "ສະຖານະຂອງ Task Engine"

#. type: Plain text
#: en/modules/reference/pages/admin/task-engine-status.adoc:2
msgid ""
"The menu:Admin[Task Engine Status] section shows all running tasks by the "
"{productname} task engine."
msgstr "ສ່ວນ menu:Admin[Task Engine Status] ສະແດງວຽກງານທັງໝົດທີ່ກຳລັງເຮັດວຽກໂດຍ task engine ຂອງ {productname}."

#. type: Plain text
#: en/modules/reference/pages/admin/task-engine-status.adoc:3
msgid ""
"Navigate to the [guimenu]``Last Execution Times`` tab to see the task list.  "
"Each task shows the time it was last run, and the current status of the "
"task."
msgstr "ໄປທີ່ແທັບ [guimenu]``Last Execution Times`` ເພື່ອເບິ່ງລາຍຊື່ວຽກ. ແຕ່ລະວຽກຈະສະແດງເວລາທີ່ເຮັດວຽກຄັ້ງຫຼ້າສຸດ ແລະ ສະຖານະປັດຈຸບັນຂອງວຽກ."

#. type: Plain text
#: en/modules/reference/pages/admin/task-engine-status.adoc:4
msgid ""
"Navigate to the [guimenu]``Runtime Status`` tab to see all tasks that have "
"run in the past five minutes.  Each task shows the start and end time, the "
"amount of time the task ran for, and the current status.  Some tasks will "
"also provide further data, if available."
msgstr "ໄປທີ່ແທັບ [guimenu]``Runtime Status`` ເພື່ອເບິ່ງວຽກທັງໝົດທີ່ເຮັດວຽກໃນ 5 ນາທີຜ່ານມາ. ແຕ່ລະວຽກຈະສະແດງເວລາເລີ່ມຕົ້ນ ແລະ ສິ້ນສຸດ, ໄລຍະເວລາທີ່ວຽກເຮັດວຽກ, ແລະ ສະຖານະປັດຈຸບັນ. ບາງວຽກອາດຈະໃຫ້ຂໍ້ມູນເພີ່ມເຕີມຫາກມີ."

#. type: Title =
#: en/modules/reference/pages/admin/task-schedules.adoc:1
#, no-wrap
msgid "Task Schedules"
msgstr "ກຳນົດເວລາວຽກ (Task Schedules)"

#. type: Plain text
#: en/modules/reference/pages/admin/task-schedules.adoc:2
msgid ""
"The menu:Admin[Task Schedules] section lists all predefined task bunches.  "
"Tasks can be grouped together in bunches to simplify managing them."
msgstr "ສ່ວນ menu:Admin[Task Schedules] ລວບລວມລາຍຊື່ຊຸດວຽກ (task bunches) ທີ່ກຳນົດໄວ້ລ່ວງໜ້າ. ວຽກສາມາດຖືກຈັດກຸ່ມເຂົ້າກັນເປັນຊຸດເພື່ອໃຫ້ງ່າຍຕໍ່ການຈັດການ."

#. type: Plain text
#: en/modules/reference/pages/admin/task-schedules.adoc:3
msgid ""
"This page shows the schedule for each bunch of tasks.  Every schedule shows "
"how frequently it runs using ``cron`` notation, the time it became active, "
"and the bunch that it belongs to."
msgstr "ໜ້ານີ້ສະແດງຕາຕະລາງເວລາສຳລັບແຕ່ລະຊຸດວຽກ. ທຸກໆຕາຕະລາງຈະສະແດງຄວາມຖີ່ໃນການເຮັດວຽກໂດຍໃຊ້ຮູບແບບ ``cron``, ເວລາທີ່ເລີ່ມໃຊ້ງານ, ແລະ ຊຸດວຽກທີ່ມັນຂຶ້ນກັບ."

#. type: Plain text
#: en/modules/reference/pages/admin/task-schedules.adoc:4
msgid "Click a schedule to change its frequency, disable or activate it."
msgstr "ກົດທີ່ຕາຕະລາງເພື່ອປ່ຽນຄວາມຖີ່, ປິດການໃຊ້ງານ ຫຼື ເປີດໃຊ້ງານມັນ."

#. type: delimited block =
#: en/modules/reference/pages/admin/task-schedules.adoc:5
msgid ""
"Do not disable a schedule if you are not certain what it does.  Some "
"schedules are essential for {productname} to work properly."
msgstr "ຢ່າປິດການໃຊ້ງານຕາຕະລາງເວລາ ຫາກທ່ານບໍ່ແນ່ໃຈວ່າມັນເຮັດວຽກຫຍັງ. ບາງຕາຕະລາງແມ່ນມີຄວາມຈຳເປັນເພື່ອໃຫ້ {productname} ເຮັດວຽກໄດ້ຢ່າງຖືກຕ້ອງ."

#. type: Plain text
#: en/modules/reference/pages/admin/task-schedules.adoc:6
msgid ""
"For more information about task schedules, see "
"xref:administration:task-schedules.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບຕາຕະລາງເວລາວຽກ, ໃຫ້ເບິ່ງ xref:administration:task-schedules.adoc[]."

#. type: Title =
#: en/modules/reference/pages/admin/users.adoc:1
#, no-wrap
msgid "Users"
msgstr "ຜູ້ໃຊ້ (Users)"

#. type: Plain text
#: en/modules/reference/pages/admin/users.adoc:2
msgid ""
"The menu:Admin[Users] section allows you to view and manage all users of the "
"organization you are logged in to.  Every user shows the username, real "
"name, the organization they are associated with, and whether the user is an "
"organization or {productname} administrator."
msgstr "ສ່ວນ menu:Admin[Users] ອະນຸຍາດໃຫ້ທ່ານເບິ່ງ ແລະ ຈັດການຜູ້ໃຊ້ທັງໝົດຂອງອົງກອນທີ່ທ່ານກຳລັງເຂົ້າສູ່ລະບົບ. ຜູ້ໃຊ້ແຕ່ລະຄົນຈະສະແດງຊື່ຜູ້ໃຊ້, ຊື່ແທ້, ອົງກອນທີ່ກ່ຽວຂ້ອງ, ແລະ ບອກວ່າຜູ້ໃຊ້ນັ້ນເປັນຜູ້ດູແລອົງກອນ ຫຼື ຜູ້ດູແລລະບົບ {productname}."

#. type: Plain text
#: en/modules/reference/pages/admin/users.adoc:3
msgid ""
"To change a user's {productname} Administrator role, check or uncheck "
"[guimenu]``{productname} Admin`` as required."
msgstr "ເພື່ອປ່ຽນບົດບາດຜູ້ດູແລລະບົບ {productname} ຂອງຜູ້ໃຊ້, ໃຫ້ເລືອກ ຫຼື ຍົກເລີກການເລືອກ [guimenu]``{productname} Admin`` ຕາມທີ່ຕ້ອງການ."

#. type: Plain text
#: en/modules/reference/pages/admin/users.adoc:4
msgid ""
"Click a username to modify the user account details, and change other "
"administrator roles."
msgstr "ກົດທີ່ຊື່ຜູ້ໃຊ້ເພື່ອແກ້ໄຂລາຍລະອຽດບັນຊີຜູ້ໃຊ້ ແລະ ປ່ຽນບົດບາດຜູ້ດູແລອື່ນໆ."

#. type: Plain text
#: en/modules/reference/pages/admin/users.adoc:5
msgid "For more information, see xref:reference:users/user-details.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມ, ໃຫ້ເບິ່ງ xref:reference:users/user-details.adoc[]."

#. type: Title =
#: en/modules/reference/pages/audit/audit-cve-audit.adoc:1
#, no-wrap
msgid "CVE Audit"
msgstr "ການກວດສອບ CVE"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-cve-audit.adoc:2
msgid ""
"The menu:Audit[CVE Audit] section shows you which CVEs have been applied to "
"your clients.  A CVE (common vulnerabilities and exposures) is a fix for a "
"publicly known security vulnerability.  It is important that you apply CVEs "
"to your clients as soon as they become available."
msgstr "ສ່ວນ menu:Audit[CVE Audit] ສະແດງໃຫ້ທ່ານເຫັນວ່າ CVE ໃດແດ່ທີ່ໄດ້ຖືກນຳໃຊ້ກັບໄຄເອັນຂອງທ່ານ. CVE (common vulnerabilities and exposures) ແມ່ນລາຍການແກ້ໄຂສຳລັບຊ່ອງໂຫວ່ດ້ານຄວາມປອດໄພທີ່ເປັນທີ່ຮູ້ຈັກທົ່ວໄປ. ມັນເປັນສິ່ງສຳຄັນທີ່ທ່ານຕ້ອງນຳໃຊ້ CVE ກັບໄຄເອັນຂອງທ່ານທັນທີທີ່ມີໃຫ້ໃຊ້ງານ."

#. type: Plain text
#: en/modules/reference/pages/audit/audit-cve-audit.adoc:3
msgid ""
"Each CVE contains an identification number, a description of the "
"vulnerability, and links to further information.  CVE identification numbers "
"use the form ``CVE-YEAR-XXXX``."
msgstr "ແຕ່ລະ CVE ປະກອບມີໝາຍເລກປະຈຳຕົວ, ຄຳອະທິບາຍກ່ຽວກັບຊ່ອງໂຫວ່, ແລະ ລິ້ງໄປຫາຂໍ້ມູນເພີ່ມເຕີມ. ໝາຍເລກປະຈຳຕົວ CVE ຈະໃຊ້ຮູບແບບ ``CVE-ປີ-ໝາຍເລກ``."

#. type: Plain text
#: en/modules/reference/pages/audit/audit-cve-audit.adoc:4
msgid "Clients are listed with a patch status icon."
msgstr "ໄຄເອັນຈະຖືກສະແດງພ້ອມກັບໄອຄອນສະຖານະແພັດຊ໌."

#. type: Block title
#: en/modules/reference/pages/audit/audit-cve-audit.adoc:5
#: en/modules/reference/pages/patches/patch-list-all.adoc:4
#: en/modules/reference/pages/patches/patch-list-relevant.adoc:4
#, no-wrap
msgid "Patch Status Icons"
msgstr "ໄອຄອນສະຖານະແພັດຊ໌"

#. type: Table
#: en/modules/reference/pages/audit/audit-cve-audit.adoc:6
#, no-wrap
msgid ""
"| Icon | Description | Action Required\n"
"| icon:exclamation-circle[role=\"red\"] | Affected, patches are not released "
"for the CVE. | The client is affected by a vulnerability for which a patch "
"has not yet been released.\n"
"| icon:exclamation-circle[role=\"red\"] | Affected, patches were released "
"for the CVE but {productname} can't find them in any of the relevant "
"channels. | The client is affected by a vulnerability that received a patch, "
"but {productname} is unable to locate any of the patches in relevant "
"channels.\n"
"| icon:shield[role=\"red\"] | Affected, only partial patches are available "
"for the CVE. | The client is affected by a vulnerability and {productname} "
"has patches for it, but applying the patches will only fix some of the "
"vulnerable packages.\n"
"\n"
"| icon:exclamation-triangle[role=\"orange\"] | Affected, patches are "
"available in channels that are not assigned | The client is affected by a "
"vulnerability and {productname} has patches for it, but the channels "
"offering the patches are not assigned to the client.\n"
"| icon:exclamation-triangle[role=\"orange\"] | Affected, patches are "
"available in a product migration target | The client is affected by a "
"vulnerability and {productname} has patches for it, but applying the patch "
"requires migrating the product to a newer version.\n"
"| icon:shield[role=\"orange\"] | Affected, at least one patch is available "
"in an assigned channel | The client is affected by the vulnerability and "
"{productname} has patches available in a channel that is directly assigned "
"to the client.\n"
"| icon:circle[role=\"green\"]| Not affected | The client is not affected "
"because none of the CVE vulnerable packages are installed.\n"
"| icon:check-circle[role=\"green\"] | Patched | A patch has been "
"successfully installed on the client.\n"
"| icon:minus-circle[role=\"gray\"] | Unknown, CVE metadata not available | "
"The patch status cannot be determined because the CVE metadata required for "
"OVAL-based auditing is missing or has not yet been synchronized.\n"
msgstr ""
"| ໄອຄອນ | ຄຳອະທິບາຍ | ການດຳເນີນການທີ່ຈຳເປັນ\n"
"| icon:exclamation-circle[role=\"red\"] | ໄດ້ຮັບຜົນກະທົບ, ຍັງບໍ່ມີການປ່ອຍແພັດຊ໌ສຳລັບ CVE ນີ້. | ໄຄເອັນໄດ້ຮັບຜົນກະທົບຈາກຊ່ອງໂຫວ່ທີ່ຍັງບໍ່ທັນມີແພັດຊ໌ແກ້ໄຂ.\n"
"| icon:exclamation-circle[role=\"red\"] | ໄດ້ຮັບຜົນກະທົບ, ມີການປ່ອຍແພັດຊ໌ສຳລັບ CVE ແລ້ວ ແຕ່ {productname} ບໍ່ພົບໃນຊ່ອງທາງທີ່ກ່ຽວຂ້ອງ. | ໄຄເອັນໄດ້ຮັບຜົນກະທົບຈາກຊ່ອງໂຫວ່ທີ່ມີແພັດຊ໌ແລ້ວ, ແຕ່ {productname} ບໍ່ສາມາດຊອກຫາແພັດຊ໌ນັ້ນໃນຊ່ອງທາງທີ່ກ່ຽວຂ້ອງໄດ້.\n"
"| icon:shield[role=\"red\"] | ໄດ້ຮັບຜົນກະທົບ, ມີພຽງແຕ່ບາງສ່ວນຂອງແພັດຊ໌ທີ່ມີໃຫ້ສຳລັບ CVE. | ໄຄເອັນໄດ້ຮັບຜົນກະທົບຈາກຊ່ອງໂຫວ່ ແລະ {productname} ມີແພັດຊ໌ສຳລັບມັນ, ແຕ່ການນຳໃຊ້ແພັດຊ໌ຈະແກ້ໄຂໄດ້ພຽງບາງແພັກເກດເທົ່ານັ້ນ.\n"
"\n"
"| icon:exclamation-triangle[role=\"orange\"] | ໄດ້ຮັບຜົນກະທົບ, ມີແພັດຊ໌ໃນຊ່ອງທາງທີ່ຍັງບໍ່ໄດ້ກຳນົດໃຫ້ | ໄຄເອັນໄດ້ຮັບຜົນກະທົບຈາກຊ່ອງໂຫວ່ ແລະ {productname} ມີແພັດຊ໌ສຳລັບມັນ, ແຕ່ຊ່ອງທາງທີ່ມີແພັດຊ໌ນັ້ນຍັງບໍ່ໄດ້ຖືກກຳນົດໃຫ້ກັບໄຄເອັນ.\n"
"| icon:exclamation-triangle[role=\"orange\"] | ໄດ້ຮັບຜົນກະທົບ, ມີແພັດຊ໌ໃນເປົ້າໝາຍການຍ້າຍຜະລິດຕະພັນ | ໄຄເອັນໄດ້ຮັບຜົນກະທົບຈາກຊ່ອງໂຫວ່ ແລະ {productname} ມີແພັດຊ໌ສຳລັບມັນ, ແຕ່ການນຳໃຊ້ແພັດຊ໌ຕ້ອງມີການຍ້າຍຜະລິດຕະພັນໄປເວີຊັນໃໝ່ກ່ອນ.\n"
"| icon:shield[role=\"orange\"] | ໄດ້ຮັບຜົນກະທົບ, ມີຢ່າງໜ້ອຍໜຶ່ງແພັດຊ໌ໃນຊ່ອງທາງທີ່ກຳນົດໃຫ້ | ໄຄເອັນໄດ້ຮັບຜົນກະທົບຈາກຊ່ອງໂຫວ່ ແລະ {productname} ມີແພັດຊ໌ທີ່ມີໃຫ້ໃນຊ່ອງທາງທີ່ກຳນົດໃຫ້ໄຄເອັນໂດຍກົງ.\n"
"| icon:circle[role=\"green\"]| ບໍ່ໄດ້ຮັບຜົນກະທົບ | ໄຄເອັນບໍ່ໄດ້ຮັບຜົນກະທົບ ເພາະບໍ່ມີແພັກເກດທີ່ມີຊ່ອງໂຫວ່ CVE ຖືກຕິດຕັ້ງໄວ້.\n"
"| icon:check-circle[role=\"green\"] | ແກ້ໄຂແລ້ວ (Patched) | ແພັດຊ໌ໄດ້ຖືກຕິດຕັ້ງໃນໄຄເອັນສຳເລັດແລ້ວ.\n"
"| icon:minus-circle[role=\"gray\"] | ບໍ່ຮູ້ສະຖານະ, ບໍ່ມີຂໍ້ມູນ CVE (metadata) | ບໍ່ສາມາດລະບຸສະຖານະແພັດຊ໌ໄດ້ ເພາະຂໍ້ມູນ CVE ທີ່ຈຳເປັນສຳລັບການກວດສອບແບບ OVAL ຂາດຫາຍໄປ ຫຼື ຍັງບໍ່ທັນໄດ້ synchronize.\n"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-cve-audit.adoc:7
msgid ""
"For more information about CVE auditing, see "
"xref:administration:auditing.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການກວດສອບ CVE, ໃຫ້ເບິ່ງ xref:administration:auditing.adoc[]."

#. type: Title =
#: en/modules/reference/pages/audit/audit-menu.adoc:1
#, no-wrap
msgid "Audit Menu"
msgstr "ເມນູການກວດສອບ"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-menu.adoc:2
msgid ""
"The [guimenu]``Audit`` menu provides access to features for managing "
"security updates on your clients.  Audit tasks include finding and updating "
"clients with the latest CVE patches, subscription matching, and managing "
"OpenSCAP scans."
msgstr "ເມນູ [guimenu]``Audit`` ໃຫ້ການເຂົ້າເຖິງຄຸນສົມບັດຕ່າງໆສຳລັບການຈັດການການອັບເດດຄວາມປອດໄພໃນໄຄເອັນຂອງທ່ານ. ວຽກງານການກວດສອບລວມມີການຊອກຫາ ແລະ ອັບເດດໄຄເອັນດ້ວຍແພັດຊ໌ CVE ຫຼ້າສຸດ, ການຈັບຄູ່ການສະໝັກໃຊ້, ແລະ ການຈັດການການສະແກນ OpenSCAP."

#. type: Title =
#: en/modules/reference/pages/audit/audit-openscap-overview.adoc:1
#, no-wrap
msgid "OpenSCAP"
msgstr "OpenSCAP"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-openscap-overview.adoc:2
#: en/modules/reference/pages/audit/openscap-all-scans.adoc:2
#: en/modules/reference/pages/audit/openscap-menu.adoc:2
msgid ""
"The menu:Audit[OpenSCAP] section displays the results of OpenSCAP scans that "
"you have performed on your clients."
msgstr "ສ່ວນ menu:Audit[OpenSCAP] ສະແດງຜົນການສະແກນ OpenSCAP ທີ່ທ່ານໄດ້ເຮັດໃນໄຄເອັນຂອງທ່ານ."

#. type: Plain text
#: en/modules/reference/pages/audit/audit-openscap-overview.adoc:3
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:3
msgid ""
"The Security Certification and Authorization Package (SCAP) is a "
"standardized compliance checking solution for enterprise-level Linux "
"infrastructures.  {productname} uses OpenSCAP to implement the SCAP "
"specifications."
msgstr "Security Certification and Authorization Package (SCAP) ແມ່ນໂຊລູຊັນການກວດສອບການປະຕິບັດຕາມມາດຕະຖານສຳລັບໂຄງລ່າງພື້ນຖານ Linux ລະດັບອົງກອນ. {productname} ໃຊ້ OpenSCAP ເພື່ອນຳໃຊ້ມາດຕະຖານ SCAP."

#. type: Plain text
#: en/modules/reference/pages/audit/audit-openscap-overview.adoc:4
#: en/modules/reference/pages/audit/openscap-advanced-search.adoc:3
#: en/modules/reference/pages/audit/openscap-all-scans.adoc:7
#: en/modules/reference/pages/audit/openscap-menu.adoc:4
#: en/modules/reference/pages/audit/openscap-xccdf-diff.adoc:3
#: en/modules/reference/pages/home/my-organization-configuration.adoc:6
#: en/modules/reference/pages/systems/system-details/sd-audit.adoc:4
msgid ""
"For more information about OpenSCAP, see "
"xref:administration:openscap.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບ OpenSCAP, ໃຫ້ເບິ່ງ xref:administration:openscap.adoc[]."

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-content.adoc:1
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:25
#, no-wrap
msgid "SCAP Content"
msgstr "ເນື້ອຫາ SCAP"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-content.adoc:2
msgid ""
"The menu:Audit[SCAP Content] section displays the SCAP content files "
"available in your organization.  SCAP content files contain the security "
"benchmarks and profiles used to evaluate system compliance."
msgstr "ສ່ວນ menu:Audit[SCAP Content] ສະແດງໄຟລ໌ເນື້ອຫາ SCAP ທີ່ມີໃຫ້ໃນອົງກອນຂອງທ່ານ. ໄຟລ໌ເນື້ອຫາ SCAP ປະກອບມີມາດຕະຖານຄວາມປອດໄພ (benchmarks) ແລະ ໂປຣໄຟລ໌ທີ່ໃຊ້ເພື່ອປະເມີນການປະຕິບັດຕາມມາດຕະຖານຂອງລະບົບ."

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-content.adoc:3
msgid ""
"Click btn:[Upload] to upload a new SCAP content file.  For more information "
"about uploading SCAP content, see <<ref-scap-content-upload>>."
msgstr "ກົດ btn:[Upload] ເພື່ອອັບໂຫຼດໄຟລ໌ເນື້ອຫາ SCAP ໃໝ່. ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການອັບໂຫຼດເນື້ອຫາ SCAP, ໃຫ້ເບິ່ງ <<ref-scap-content-upload>>."

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-content.adoc:4
msgid ""
"Each row in the list provides btn:[Edit] and btn:[Delete] action buttons.  "
"Use btn:[Edit] to modify the name, description, or replace the uploaded "
"files for an existing SCAP content entry.  Use btn:[Delete] to remove the "
"SCAP content entry.  A confirmation dialog is displayed before deletion."
msgstr "ແຕ່ລະແຖວໃນລາຍຊື່ຈະມີປຸ່ມ btn:[Edit] ແລະ btn:[Delete]. ໃຊ້ btn:[Edit] ເພື່ອແກ້ໄຂຊື່, ຄຳອະທິບາຍ, ຫຼື ປ່ຽນໄຟລ໌ທີ່ອັບໂຫຼດໄວ້. ໃຊ້ btn:[Delete] ເພື່ອລຶບເນື້ອຫາ SCAP. ປ່ອງຢືນຢັນຈະສະແດງຂຶ້ນກ່ອນການລຶບ."

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-content.adoc:5
msgid ""
"You can filter the list using the search bar, which searches across the "
"name, file name, and description fields."
msgstr "ທ່ານສາມາດກັ່ນຕອງລາຍຊື່ໂດຍໃຊ້ແຖບຄົ້ນຫາ, ເຊິ່ງຈະຄົ້ນຫາຈາກຊື່, ຊື່ໄຟລ໌, ແລະ ຄຳອະທິບາຍ."

#. type: Block title
#: en/modules/reference/pages/audit/audit-scap-content.adoc:6
#, no-wrap
msgid "SCAP Content List Columns"
msgstr "ຄໍລຳລາຍຊື່ເນື້ອຫາ SCAP"

#. type: Table
#: en/modules/reference/pages/audit/audit-scap-content.adoc:7
#, no-wrap
msgid ""
"| Column      | Description\n"
"| Name        | The display name of the SCAP content.\n"
"| Description | A brief description of the SCAP content.\n"
"| File Name   | The file name of the uploaded DataStream file.\n"
"| Actions     | Available actions: Edit and Delete.\n"
msgstr ""
"| ຄໍລຳ | ຄຳອະທິບາຍ\n"
"| Name | ຊື່ທີ່ສະແດງຂອງເນື້ອຫາ SCAP.\n"
"| Description | ຄຳອະທິບາຍສັ້ນໆກ່ຽວກັບເນື້ອຫາ SCAP.\n"
"| File Name | ຊື່ໄຟລ໌ຂອງ DataStream ທີ່ອັບໂຫຼດ.\n"
"| Actions | ການດຳເນີນການທີ່ມີໃຫ້: ແກ້ໄຂ (Edit) ແລະ ລຶບ (Delete).\n"

#. type: Title ==
#: en/modules/reference/pages/audit/audit-scap-content.adoc:8
#, no-wrap
msgid "Upload SCAP content"
msgstr "ອັບໂຫຼດເນື້ອຫາ SCAP"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-content.adoc:9
msgid ""
"The menu:Audit[SCAP Content > Upload] page allows you to upload new SCAP "
"content to your organization."
msgstr "ໜ້າ menu:Audit[SCAP Content > Upload] ອະນຸຍາດໃຫ້ທ່ານອັບໂຫຼດເນື້ອຫາ SCAP ໃໝ່ໄປຍັງອົງກອນຂອງທ່ານ."

#. type: Block title
#: en/modules/reference/pages/audit/audit-scap-content.adoc:10
#, no-wrap
msgid "Upload SCAP Content Fields"
msgstr "ຊ່ອງຂໍ້ມູນການອັບໂຫຼດເນື້ອຫາ SCAP"

#. type: Table
#: en/modules/reference/pages/audit/audit-scap-content.adoc:11
#, no-wrap
msgid ""
"| Field                | Required | Description\n"
"| Name                 | Yes      | A display name for the SCAP content.\n"
"| Description          | No       | A brief description of the SCAP "
"content.\n"
"| SCAP Datastream File | Yes      | The DataStream file (``*-ds.xml``) to "
"upload.\n"
"| XCCDF File           | Yes      | The XCCDF file (``*-xccdf.xml``) to "
"upload.\n"
msgstr ""
"| ຊ່ອງຂໍ້ມູນ | ຈຳເປັນ | ຄຳອະທິບາຍ\n"
"| Name | ແມ່ນ | ຊື່ທີ່ສະແດງສຳລັບເນື້ອຫາ SCAP.\n"
"| Description | ບໍ່ | ຄຳອະທິບາຍສັ້ນໆກ່ຽວກັບເນື້ອຫາ SCAP.\n"
"| SCAP Datastream File | ແມ່ນ | ໄຟລ໌ DataStream (``*-ds.xml``) ທີ່ຈະອັບໂຫຼດ.\n"
"| XCCDF File | ແມ່ນ | ໄຟລ໌ XCCDF (``*-xccdf.xml``) ທີ່ຈະອັບໂຫຼດ.\n"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-content.adoc:12
msgid "Click btn:[Upload] to save the new SCAP content."
msgstr "ກົດ btn:[Upload] ເພື່ອບັນທຶກເນື້ອຫາ SCAP ໃໝ່."

#. type: Title ==
#: en/modules/reference/pages/audit/audit-scap-content.adoc:13
#, no-wrap
msgid "Edit SCAP content"
msgstr "ແກ້ໄຂເນື້ອຫາ SCAP"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-content.adoc:14
msgid ""
"The menu:Audit[SCAP Content > Edit] page allows you to update an existing "
"SCAP content entry.  You can change the name, description, or replace the "
"uploaded DataStream and XCCDF files.  If you do not upload a new file, the "
"existing file is retained."
msgstr "ໜ້າ menu:Audit[SCAP Content > Edit] ອະນຸຍາດໃຫ້ທ່ານອັບເດດລາຍການເນື້ອຫາ SCAP ທີ່ມີຢູ່. ທ່ານສາມາດປ່ຽນຊື່, ຄຳອະທິບາຍ, ຫຼື ປ່ຽນແທນໄຟລ໌ DataStream ແລະ XCCDF ທີ່ອັບໂຫຼດໄວ້. ຫາກທ່ານບໍ່ອັບໂຫຼດໄຟລ໌ໃໝ່, ໄຟລ໌ເດີມຈະຖືກຮັກສາໄວ້."

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-content.adoc:15
#: en/modules/reference/pages/audit/audit-scap-tailoring-files.adoc:15
msgid "Click btn:[Update] to save the changes."
msgstr "ກົດ btn:[Update] ເພື່ອບັນທຶກການປ່ຽນແປງ."

#. type: Title =
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:1
#, no-wrap
msgid "SCAP Policies"
msgstr "ນະໂຍບາຍ SCAP"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:2
msgid ""
"The menu:Audit[SCAP Policies] section displays the compliance policies "
"defined in your organization.  Each policy ties together a SCAP content "
"file, an XCCDF profile, and optional tailoring to define a compliance "
"standard."
msgstr "ສ່ວນ menu:Audit[SCAP Policies] ສະແດງນະໂຍບາຍການປະຕິບັດຕາມມາດຕະຖານທີ່ກຳນົດໄວ້ໃນອົງກອນຂອງທ່ານ. ແຕ່ລະນະໂຍບາຍຈະເຊື່ອມໂຍງໄຟລ໌ເນື້ອຫາ SCAP, ໂປຣໄຟລ໌ XCCDF, ແລະ ການປັບແຕ່ງ (ຕົວເລືອກເສີມ) ເຂົ້າກັນເພື່ອລະບຸມາດຕະຖານການປະຕິບັດຕາມ."

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:3
msgid ""
"Click btn:[Create] to create a new compliance policy.  For more information "
"about creating policies, see <<ref-scap-policy-create>>."
msgstr "ກົດ btn:[Create] ເພື່ອສ້າງນະໂຍບາຍການປະຕິບັດຕາມມາດຕະຖານໃໝ່. ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການສ້າງນະໂຍບາຍ, ໃຫ້ເບິ່ງ <<ref-scap-policy-create>>."

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:4
msgid ""
"Each row in the list provides btn:[Details], btn:[Edit], and btn:[Delete] "
"action buttons.  Use btn:[Details] to view the policy summary, "
"configuration, and scan history.  Use btn:[Edit] to modify the policy.  Use "
"btn:[Delete] to remove the policy.  A confirmation dialog is displayed "
"before deletion."
msgstr "ແຕ່ລະແຖວໃນລາຍຊື່ຈະມີປຸ່ມ btn:[Details], btn:[Edit], ແລະ btn:[Delete]. ໃຊ້ btn:[Details] ເພື່ອເບິ່ງສະຫຼຸບນະໂຍບາຍ, ການກຳນົດຄ່າ, ແລະ ປະຫວັດການສະແກນ. ໃຊ້ btn:[Edit] ເພື່ອແກ້ໄຂນະໂຍບາຍ. ໃຊ້ btn:[Delete] ເພື່ອລຶບນະໂຍບາຍ. ປ່ອງຢືນຢັນຈະສະແດງຂຶ້ນກ່ອນການລຶບ."

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:5
msgid ""
"You can filter the list using the search bar, which searches across the "
"policy name and SCAP content name."
msgstr "ທ່ານສາມາດກັ່ນຕອງລາຍຊື່ໂດຍໃຊ້ແຖບຄົ້ນຫາ, ເຊິ່ງຈະຄົ້ນຫາຈາກຊື່ນະໂຍບາຍ ແລະ ຊື່ເນື້ອຫາ SCAP."

#. type: Block title
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:6
#, no-wrap
msgid "SCAP Policies List Columns"
msgstr "ຄໍລຳລາຍຊື່ນະໂຍບາຍ SCAP"

#. type: Table
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:7
#, no-wrap
msgid ""
"| Column          | Description\n"
"| Name            | The display name of the compliance policy.\n"
"| Content         | The name of the associated SCAP content, or ``N/A`` if "
"none is assigned.\n"
"| Systems Scanned | The number of systems that have been scanned using this "
"policy.\n"
"| Compliance      | A compliance badge showing the percentage of compliant "
"systems and the ratio of compliant to total scanned systems.\n"
"| Actions         | Available actions: Details, Edit, and Delete.\n"
msgstr ""
"| ຄໍລຳ | ຄຳອະທິບາຍ\n"
"| Name | ຊື່ທີ່ສະແດງຂອງນະໂຍບາຍການປະຕິບັດຕາມມາດຕະຖານ.\n"
"| Content | ຊື່ຂອງເນື້ອຫາ SCAP ທີ່ກ່ຽວຂ້ອງ, ຫຼື ``N/A`` ຫາກບໍ່ມີການກຳນົດ.\n"
"| Systems Scanned | ຈຳນວນລະບົບທີ່ໄດ້ຮັບການສະແກນໂດຍໃຊ້ນະໂຍບາຍນີ້.\n"
"| Compliance | ປ້າຍສະແດງການປະຕິບັດຕາມມາດຕະຖານ ທີ່ບອກເປີເຊັນຂອງລະບົບທີ່ຜ່ານ ແລະ ອັດຕາສ່ວນຂອງລະບົບທີ່ຜ່ານທຽບກັບທັງໝົດ.\n"
"| Actions | ການດຳເນີນການທີ່ມີໃຫ້: ລາຍລະອຽດ (Details), ແກ້ໄຂ (Edit), ແລະ ລຶບ (Delete).\n"

#. type: Title ==
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:8
#, no-wrap
msgid "Create compliance policy"
msgstr "ສ້າງນະໂຍບາຍການປະຕິບັດຕາມມາດຕະຖານ"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:9
msgid ""
"The menu:Audit[SCAP Policies > Create] page allows you to define a new "
"compliance policy."
msgstr "ໜ້າ menu:Audit[SCAP Policies > Create] ອະນຸຍາດໃຫ້ທ່ານກຳນົດນະໂຍບາຍການປະຕິບັດຕາມມາດຕະຖານໃໝ່."

#. type: Block title
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:10
#, no-wrap
msgid "Create Compliance Policy Fields"
msgstr "ຊ່ອງຂໍ້ມູນການສ້າງນະໂຍບາຍການປະຕິບັດຕາມມາດຕະຖານ"

#. type: Table
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:11
#, no-wrap
msgid ""
"| Field                  | Required | Description\n"
"| Policy Name            | Yes      | A display name for the compliance "
"policy.\n"
"| Description            | No       | A brief description of the policy.\n"
"| SCAP Content           | Yes      | Select a SCAP content file. The XCCDF "
"Profile list is populated based on this selection.\n"
"| XCCDF Profile          | Yes      | Select an XCCDF profile from the "
"chosen SCAP content.\n"
"| Tailoring File         | No       | Optionally select a tailoring file to "
"customize the profile. The Tailoring Profile list is populated based on this "
"selection.\n"
"| Tailoring Profile      | No       | Select a profile from the chosen "
"tailoring file.\n"
"| Advanced Arguments     | No       | Additional command-line arguments, for "
"example: ``--rule <rule_id> --remediate``.\n"
"| OVAL Files             | No       | Paths to local OVAL definitions on the "
"target system, comma separated.\n"
"| Fetch Remote Resources | No       | Enable fetching of remote resources "
"during scans. This requires internet access and significant memory on the "
"target system.\n"
msgstr ""
"| ຊ່ອງຂໍ້ມູນ | ຈຳເປັນ | ຄຳອະທິບາຍ\n"
"| Policy Name | ແມ່ນ | ຊື່ທີ່ສະແດງສຳລັບນະໂຍບາຍການປະຕິບັດຕາມມາດຕະຖານ.\n"
"| Description | ບໍ່ | ຄຳອະທິບາຍສັ້ນໆກ່ຽວກັບນະໂຍບາຍ.\n"
"| SCAP Content | ແມ່ນ | ເລືອກໄຟລ໌ເນື້ອຫາ SCAP. ລາຍຊື່ໂປຣໄຟລ໌ XCCDF ຈະສະແດງຂຶ້ນຕາມການເລືອກນີ້.\n"
"| XCCDF Profile | ແມ່ນ | ເລືອກໂປຣໄຟລ໌ XCCDF ຈາກເນື້ອຫາ SCAP ທີ່ເລືອກ.\n"
"| Tailoring File | ບໍ່ | (ຕົວເລືອກ) ເລືອກໄຟລ໌ປັບແຕ່ງເພື່ອປັບແຕ່ງໂປຣໄຟລ໌. ລາຍຊື່ໂປຣໄຟລ໌ປັບແຕ່ງຈະສະແດງຂຶ້ນຕາມການເລືອກນີ້.\n"
"| Tailoring Profile | ບໍ່ | ເລືອກໂປຣໄຟລ໌ຈາກໄຟລ໌ປັບແຕ່ງທີ່ເລືອກ.\n"
"| Advanced Arguments | ບໍ່ | ອາຣ໌ກິວເມນບັນທັດຄຳສັ່ງເພີ່ມເຕີມ, ຕົວຢ່າງ: ``--rule <rule_id> --remediate``.\n"
"| OVAL Files | ບໍ່ | ເສັ້ນທາງໄປຫາ OVAL definitions ໃນລະບົບເປົ້າໝາຍ, ແຍກດ້ວຍຈຸດ.\n"
"| Fetch Remote Resources | ບໍ່ | ເປີດການດຶງຂໍ້ມູນຊັບພະຍາກອນທາງໄກລະຫວ່າງການສະແກນ. ນີ້ຕ້ອງໃຊ້ການເຊື່ອມຕໍ່ອິນເຕີເນັດ ແລະ ໜ່ວຍຄວາມຈຳຈຳນວນຫຼາຍໃນລະບົບເປົ້າໝາຍ.\n"

#. type: delimited block =
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:12
msgid ""
"Enabling btn:[Fetch Remote Resources] requires internet access and "
"significant available memory on the target minion.  Ensure the target system "
"has sufficient resources before enabling this option."
msgstr "ການເປີດໃຊ້ງານ btn:[Fetch Remote Resources] ຈຳເປັນຕ້ອງມີການເຂົ້າເຖິງອິນເຕີເນັດ ແລະ ໜ່ວຍຄວາມຈຳທີ່ພຽງພໍໃນ minion ເປົ້າໝາຍ. ໃຫ້ແນ່ໃຈວ່າລະບົບເປົ້າໝາຍມີຊັບພະຍາກອນພຽງພໍກ່ອນທີ່ຈະເປີດໃຊ້ງານຕົວເລືອກນີ້."

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:13
msgid "Click btn:[Create] to save the new policy."
msgstr "ກົດ btn:[Create] ເພື່ອບັນທຶກນະໂຍບາຍໃໝ່."

#. type: Title ==
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:14
#, no-wrap
msgid "Edit compliance policy"
msgstr "ແກ້ໄຂນະໂຍບາຍການປະຕິບັດຕາມມາດຕະຖານ"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:15
msgid ""
"The menu:Audit[SCAP Policies > Edit] page allows you to update an existing "
"compliance policy.  All fields from the creation form can be modified."
msgstr "ໜ້າ menu:Audit[SCAP Policies > Edit] ອະນຸຍາດໃຫ້ທ່ານອັບເດດນະໂຍບາຍການປະຕິບັດຕາມມາດຕະຖານທີ່ມີຢູ່. ທຸກຊ່ອງຂໍ້ມູນຈາກຟອມການສ້າງສາມາດແກ້ໄຂໄດ້."

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:16
msgid ""
"Click btn:[Update] to save the changes.  Click btn:[Back to List] to return "
"to the policies list without saving."
msgstr "ກົດ btn:[Update] ເພື່ອບັນທຶກການປ່ຽນແປງ. ກົດ btn:[Back to List] ເພື່ອກັບຄືນໄປຍັງລາຍຊື່ນະໂຍບາຍໂດຍບໍ່ບັນທຶກ."

#. type: Title ==
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:17
#, no-wrap
msgid "Policy details"
msgstr "ລາຍລະອຽດນະໂຍບາຍ"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:18
msgid ""
"The menu:Audit[SCAP Policies > Details] page displays a comprehensive "
"overview of a compliance policy, including compliance statistics, "
"configuration, and scan history."
msgstr "ໜ້າ menu:Audit[SCAP Policies > Details] ສະແດງພາບລວມທີ່ສົມບູນຂອງນະໂຍບາຍການປະຕິບັດຕາມມາດຕະຖານ, ລວມມີສະຖິຕິການປະຕິບັດຕາມ, ການກຳນົດຄ່າ, ແລະ ປະຫວັດການສະແກນ."

#. type: Title ===
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:19
#, no-wrap
msgid "Summary cards"
msgstr "ບັດສະຫຼຸບ"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:20
msgid "The top of the page shows four summary cards:"
msgstr "ສ່ວນເທິງຂອງໜ້າຈະສະແດງບັດສະຫຼຸບ 4 ບັດ:"

#. type: Block title
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:21
#, no-wrap
msgid "Summary Cards"
msgstr "ບັດສະຫຼຸບ"

#. type: Table
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:22
#, no-wrap
msgid ""
"| Card             | Description\n"
"| Total Scans      | The total number of scans performed using this "
"policy.\n"
"| Systems Scanned  | The number of unique systems scanned.\n"
"| Compliant Scans  | The number of scans where all rules passed.\n"
"| Compliance Rate  | The percentage of scans that are compliant.\n"
msgstr ""
"| ບັດ | ຄຳອະທິບາຍ\n"
"| Total Scans | ຈຳນວນການສະແກນທັງໝົດທີ່ເຮັດໂດຍໃຊ້ນະໂຍບາຍນີ້.\n"
"| Systems Scanned | ຈຳນວນລະບົບທີ່ບໍ່ຊ້ຳກັນທີ່ໄດ້ຮັບການສະແກນ.\n"
"| Compliant Scans | ຈຳນວນການສະແກນທີ່ຜ່ານກົດລະບຽບທັງໝົດ.\n"
"| Compliance Rate | ເປີເຊັນຂອງການສະແກນທີ່ຜ່ານຕາມມາດຕະຖານ.\n"

#. type: Title ===
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:23
#, no-wrap
msgid "Policy configuration"
msgstr "ການກຳນົດຄ່ານະໂຍບາຍ"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:24
msgid "This panel displays the current configuration of the policy:"
msgstr "ແຜງນີ້ສະແດງການກຳນົດຄ່າປັດຈຸບັນຂອງນະໂຍບາຍ:"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:26
msgid "XCCDF Profile"
msgstr "ໂປຣໄຟລ໌ XCCDF"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:27
msgid "Tailoring File (if configured)"
msgstr "ໄຟລ໌ປັບແຕ່ງ (ຫາກມີການກຳນົດຄ່າ)"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:28
msgid "Tailoring Profile (if configured)"
msgstr "ໂປຣໄຟລ໌ປັບແຕ່ງ (ຫາກມີການກຳນົດຄ່າ)"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:29
msgid "OVAL Files (if configured)"
msgstr "ໄຟລ໌ OVAL (ຫາກມີການກຳນົດຄ່າ)"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:30
msgid "Advanced Arguments (if configured)"
msgstr "ອາຣ໌ກິວເມນບັນທັດຄຳສັ່ງ (ຫາກມີການກຳນົດຄ່າ)"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:31
msgid "Fetch Remote Resources (Yes or No)"
msgstr "ດຶງຂໍ້ມູນຊັບພະຍາກອນທາງໄກ (ແມ່ນ ຫຼື ບໍ່)"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:32
msgid "Description (if provided)"
msgstr "ຄຳອະທິບາຍ (ຫາກມີລະບຸ)"

#. type: Title ===
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:33
#, no-wrap
msgid "Scan history"
msgstr "ປະຫວັດການສະແກນ"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:34
msgid ""
"The scan history table shows all scans performed using this policy.  Use the "
"checkbox btn:[Show only latest scan per system] to filter the table to "
"display only the most recent scan for each system."
msgstr "ຕາຕະລາງປະຫວັດການສະແກນສະແດງການສະແກນທັງໝົດທີ່ເຮັດໂດຍໃຊ້ນະໂຍບາຍນີ້. ໃຊ້ຊ່ອງເລືອກ btn:[Show only latest scan per system] ເພື່ອກັ່ນຕອງໃຫ້ສະແດງສະເພາະການສະແກນຫຼ້າສຸດຂອງແຕ່ລະລະບົບ."

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:35
msgid ""
"You can filter the scan history using the search bar, which searches by "
"system name."
msgstr "ທ່ານສາມາດກັ່ນຕອງປະຫວັດການສະແກນໂດຍໃຊ້ແຖບຄົ້ນຫາ, ເຊິ່ງຈະຄົ້ນຫາຕາມຊື່ລະບົບ."

#. type: Block title
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:36
#, no-wrap
msgid "Scan History Columns"
msgstr "ຄໍລຳປະຫວັດການສະແກນ"

#. type: Table
#: en/modules/reference/pages/audit/audit-scap-policies.adoc:37
#, no-wrap
msgid ""
"| Column    | Description\n"
"| System    | The name of the scanned system, linked to the system details "
"page.\n"
"| Scan Date | The date and time the scan was performed.\n"
"| Passed    | The number of rules that passed.\n"
"| Failed    | The number of rules that failed.\n"
"| Other     | The number of rules that were not selected or not "
"applicable.\n"
"| Status    | The compliance status: ``Compliant`` (no failures) or "
"``Non-Compliant`` (one or more failures).\n"
"| Actions   | Click btn:[View Details] to view the full XCCDF scan "
"results.\n"
msgstr ""
"| ຄໍລຳ | ຄຳອະທິບາຍ\n"
"| System | ຊື່ຂອງລະບົບທີ່ຖືກສະແກນ, ເຊື່ອມໂຍງກັບໜ້າລາຍລະອຽດລະບົບ.\n"
"| Scan Date | ວັນທີ ແລະ ເວລາທີ່ເຮັດການສະແກນ.\n"
"| Passed | ຈຳນວນກົດລະບຽບທີ່ຜ່ານ.\n"
"| Failed | ຈຳນວນກົດລະບຽບທີ່ບໍ່ຜ່ານ.\n"
"| Other | ຈຳນວນກົດລະບຽບທີ່ບໍ່ໄດ້ຖືກເລືອກ ຫຼື ບໍ່ກ່ຽວຂ້ອງ.\n"
"| Status | ສະຖານະການປະຕິບັດຕາມ: ``Compliant`` (ຜ່ານທັງໝົດ) ຫຼື ``Non-Compliant`` (ບໍ່ຜ່ານຢ່າງໜ້ອຍໜຶ່ງອັນ).\n"
"| Actions | ກົດ btn:[View Details] ເພື່ອເບິ່ງຜົນການສະແກນ XCCDF ທັງໝົດ.\n"

#. type: Title =
#: en/modules/reference/pages/audit/audit-scap-tailoring-files.adoc:1
#, no-wrap
msgid "Tailoring Files"
msgstr "ໄຟລ໌ປັບແຕ່ງ (Tailoring Files)"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-tailoring-files.adoc:2
msgid ""
"The menu:Audit[Tailoring Files] section displays the SCAP tailoring files "
"available in your organization.  Tailoring files allow you to customize "
"XCCDF profiles by enabling, disabling, or modifying specific rules without "
"changing the original SCAP content."
msgstr "ສ່ວນ menu:Audit[Tailoring Files] ສະແດງໄຟລ໌ປັບແຕ່ງ SCAP ທີ່ມີໃຫ້ໃນອົງກອນຂອງທ່ານ. ໄຟລ໌ປັບແຕ່ງຊ່ວຍໃຫ້ທ່ານສາມາດປັບແຕ່ງໂປຣໄຟລ໌ XCCDF ໄດ້ໂດຍການເປີດ, ປິດ, ຫຼື ແກ້ໄຂກົດລະບຽບສະເພາະ ໂດຍບໍ່ຕ້ອງປ່ຽນແປງເນື້ອຫາ SCAP ຕົ້ນສະບັບ."

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-tailoring-files.adoc:3
msgid ""
"Click btn:[Create] to upload a new tailoring file.  For more information "
"about uploading tailoring files, see <<ref-scap-tailoring-file-upload>>."
msgstr "ກົດ btn:[Create] ເພື່ອອັບໂຫຼດໄຟລ໌ປັບແຕ່ງໃໝ່. ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການອັບໂຫຼດໄຟລ໌ປັບແຕ່ງ, ໃຫ້ເບິ່ງ <<ref-scap-tailoring-file-upload>>."

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-tailoring-files.adoc:4
msgid ""
"Each row in the list provides btn:[Edit] and btn:[Delete] action buttons.  "
"Use btn:[Edit] to modify the name, description, or replace the uploaded "
"tailoring file.  Use btn:[Delete] to remove the tailoring file entry.  A "
"confirmation dialog is displayed before deletion."
msgstr "ແຕ່ລະແຖວໃນລາຍຊື່ຈະມີປຸ່ມ btn:[Edit] ແລະ btn:[Delete]. ໃຊ້ btn:[Edit] ເພື່ອແກ້ໄຂຊື່, ຄຳອະທິບາຍ, ຫຼື ປ່ຽນໄຟລ໌ປັບແຕ່ງທີ່ອັບໂຫຼດໄວ້. ໃຊ້ btn:[Delete] ເພື່ອລຶບລາຍການໄຟລ໌ປັບແຕ່ງ. ປ່ອງຢືນຢັນຈະສະແດງຂຶ້ນກ່ອນການລຶບ."

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-tailoring-files.adoc:5
msgid ""
"You can filter the list using the search bar, which searches across the "
"label and file name fields."
msgstr "ທ່ານສາມາດກັ່ນຕອງລາຍຊື່ໂດຍໃຊ້ແຖບຄົ້ນຫາ, ເຊິ່ງຈະຄົ້ນຫາຈາກປ້າຍຊື່ (label) ແລະ ຊື່ໄຟລ໌."

#. type: Block title
#: en/modules/reference/pages/audit/audit-scap-tailoring-files.adoc:6
#, no-wrap
msgid "Tailoring Files List Columns"
msgstr "ຄໍລຳລາຍຊື່ໄຟລ໌ປັບແຕ່ງ"

#. type: Table
#: en/modules/reference/pages/audit/audit-scap-tailoring-files.adoc:7
#, no-wrap
msgid ""
"| Column             | Description\n"
"| Label              | The display name of the tailoring file.\n"
"| Tailoring File Name | The file name of the uploaded tailoring file.\n"
"| Actions            | Available actions: Edit and Delete.\n"
msgstr ""
"| ຄໍລຳ | ຄຳອະທິບາຍ\n"
"| Label | ຊື່ທີ່ສະແດງຂອງໄຟລ໌ປັບແຕ່ງ.\n"
"| Tailoring File Name | ຊື່ໄຟລ໌ຂອງໄຟລ໌ປັບແຕ່ງທີ່ອັບໂຫຼດ.\n"
"| Actions | ການດຳເນີນການທີ່ມີໃຫ້: ແກ້ໄຂ (Edit) ແລະ ລຶບ (Delete).\n"

#. type: Title ==
#: en/modules/reference/pages/audit/audit-scap-tailoring-files.adoc:8
#, no-wrap
msgid "Upload tailoring file"
msgstr "ອັບໂຫຼດໄຟລ໌ປັບແຕ່ງ"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-tailoring-files.adoc:9
msgid ""
"The menu:Audit[Tailoring Files > Create] page allows you to upload a new "
"tailoring file."
msgstr "ໜ້າ menu:Audit[Tailoring Files > Create] ອະນຸຍາດໃຫ້ທ່ານອັບໂຫຼດໄຟລ໌ປັບແຕ່ງໃໝ່."

#. type: Block title
#: en/modules/reference/pages/audit/audit-scap-tailoring-files.adoc:10
#, no-wrap
msgid "Upload Tailoring File Fields"
msgstr "ຊ່ອງຂໍ້ມູນການອັບໂຫຼດໄຟລ໌ປັບແຕ່ງ"

#. type: Table
#: en/modules/reference/pages/audit/audit-scap-tailoring-files.adoc:11
#, no-wrap
msgid ""
"| Field          | Required | Description\n"
"| Name           | Yes      | A display name for the tailoring file.\n"
"| Description    | No       | A brief description of the tailoring file.\n"
"| Tailoring File | Yes      | The tailoring XML file (``.xml``) to upload.\n"
msgstr ""
"| ຊ່ອງຂໍ້ມູນ | ຈຳເປັນ | ຄຳອະທິບາຍ\n"
"| Name | ແມ່ນ | ຊື່ທີ່ສະແດງສຳລັບໄຟລ໌ປັບແຕ່ງ.\n"
"| Description | ບໍ່ | ຄຳອະທິບາຍສັ້ນໆກ່ຽວກັບໄຟລ໌ປັບແຕ່ງ.\n"
"| Tailoring File | ແມ່ນ | ໄຟລ໌ປັບແຕ່ງ XML (``.xml``) ທີ່ຈະອັບໂຫຼດ.\n"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-tailoring-files.adoc:12
msgid "Click btn:[Upload] to save the new tailoring file."
msgstr "ກົດ btn:[Upload] ເພື່ອບັນທຶກໄຟລ໌ປັບແຕ່ງໃໝ່."

#. type: Title ==
#: en/modules/reference/pages/audit/audit-scap-tailoring-files.adoc:13
#, no-wrap
msgid "Edit tailoring file"
msgstr "ແກ້ໄຂໄຟລ໌ປັບແຕ່ງ"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-scap-tailoring-files.adoc:14
msgid ""
"The menu:Audit[Tailoring Files > Edit] page allows you to update an existing "
"tailoring file entry.  You can change the name, description, or upload a "
"replacement file.  If you do not upload a new file, the existing file is "
"retained."
msgstr "ໜ້າ menu:Audit[Tailoring Files > Edit] ອະນຸຍາດໃຫ້ທ່ານອັບເດດລາຍການໄຟລ໌ປັບແຕ່ງທີ່ມີຢູ່. ທ່ານສາມາດປ່ຽນຊື່, ຄຳອະທິບາຍ, ຫຼື ອັບໂຫຼດໄຟລ໌ໃໝ່ແທນທີ່. ຫາກທ່ານບໍ່ອັບໂຫຼດໄຟລ໌ໃໝ່, ໄຟລ໌ເດີມຈະຖືກຮັກສາໄວ້."

#. type: Title =
#: en/modules/reference/pages/audit/audit-subscription-matching.adoc:1
#, no-wrap
msgid "Subscription Matching"
msgstr "ການຈັບຄູ່ການສະໝັກໃຊ້ (Subscription Matching)"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-subscription-matching.adoc:2
msgid ""
"The menu:Audit[Subscription Matching] section provides reports that match "
"your currently installed clients to your existing product subscriptions.  "
"Subscription matching reports provide information about clients that do not "
"have a subscription, and subscription start and end dates."
msgstr "ສ່ວນ menu:Audit[Subscription Matching] ໃຫ້ລາຍງານການຈັບຄູ່ລະຫວ່າງໄຄເອັນທີ່ຕິດຕັ້ງຢູ່ກັບການສະໝັກໃຊ້ຜະລິດຕະພັນທີ່ມີຢູ່. ລາຍງານການຈັບຄູ່ການສະໝັກໃຊ້ຈະໃຫ້ຂໍ້ມູນກ່ຽວກັບໄຄເອັນທີ່ບໍ່ມີການສະໝັກໃຊ້, ລວມທັງວັນທີເລີ່ມຕົ້ນ ແລະ ສິ້ນສຸດຂອງການສະໝັກໃຊ້."

#. type: Block title
#: en/modules/reference/pages/audit/audit-subscription-matching.adoc:3
#, no-wrap
msgid "Subscription Matching Options"
msgstr "ຕົວເລືອກການຈັບຄູ່ການສະໝັກໃຊ້"

#. type: Table
#: en/modules/reference/pages/audit/audit-subscription-matching.adoc:4
#, no-wrap
msgid ""
"| Column          | Description\n"
"| Part Number     | Identifier of the matched product\n"
"| Description     | Description of the matched product\n"
"| Policy          | The type of subscription matched to the product\n"
"| Matched/Total   | The number of clients currently using the subscription, "
"of the total available.\n"
"If the subscription is fully matched, the quantity column value is "
"highlighted.\n"
"| Start Date      | Start date of the subscription\n"
"| End Date        | End date of the subscription\n"
msgstr ""
"| ຄໍລຳ | ຄຳອະທິບາຍ\n"
"| Part Number | ໝາຍເລກລະບຸຂອງຜະລິດຕະພັນທີ່ຈັບຄູ່\n"
"| Description | ຄຳອະທິບາຍຂອງຜະລິດຕະພັນທີ່ຈັບຄູ່\n"
"| Policy | ປະເພດຂອງການສະໝັກໃຊ້ທີ່ຈັບຄູ່ກັບຜະລິດຕະພັນ\n"
"| Matched/Total | ຈຳນວນໄຄເອັນທີ່ກຳລັງໃຊ້ການສະໝັກໃຊ້ນີ້ ທຽບກັບຈຳນວນທີ່ມີທັງໝົດ. ຫາກການສະໝັກໃຊ້ຖືກຈັບຄູ່ຄົບແລ້ວ, ຄ່າໃນຄໍລຳຈຳນວນຈະຖືກເນັ້ນ.\n"
"| Start Date | ວັນທີເລີ່ມຕົ້ນຂອງການສະໝັກໃຊ້\n"
"| End Date | ວັນທີສິ້ນສຸດຂອງການສະໝັກໃຊ້\n"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-subscription-matching.adoc:5
msgid ""
"Table entries are highlighted if they are due to expire within three "
"months.  Table entries that have already expired are shown in grayscale."
msgstr "ລາຍການໃນຕາຕະລາງຈະຖືກເນັ້ນຫາກກຳລັງຈະໝົດອາຍຸພາຍໃນ 3 ເດືອນ. ສ່ວນລາຍການທີ່ໝົດອາຍຸໄປແລ້ວຈະສະແດງເປັນສີເທົາ."

#. type: Plain text
#: en/modules/reference/pages/audit/audit-subscription-matching.adoc:6
msgid ""
"For messages relating to subscription matching, navigate to the "
"[guimenu]``Messages`` tab."
msgstr "ສຳລັບຂໍ້ຄວາມທີ່ກ່ຽວຂ້ອງກັບການຈັບຄູ່ການສະໝັກໃຊ້, ໃຫ້ໄປທີ່ແທັບ [guimenu]``Messages``."

#. type: Block title
#: en/modules/reference/pages/audit/audit-subscription-matching.adoc:7
#, no-wrap
msgid "Subscription Matching Messages"
msgstr "ຂໍ້ຄວາມການຈັບຄູ່ການສະໝັກໃຊ້"

#. type: Table
#: en/modules/reference/pages/audit/audit-subscription-matching.adoc:8
#, no-wrap
msgid ""
"| Message                 | Type | Description | Action\n"
"| Unsupported part number detected | Debug | The detected part number is "
"unknown or unsupported. | Call {suse} support and open a Service Request "
"ticket to have the part number added to the product.\n"
"| Physical system is reported as virtual guest, please check hardware data          "
"| Debug | A client is reporting as virtual, but could be a physical "
"client. | Check the client hardware data.\n"
"| Virtual guest has unknown host, assuming it is a physical system | Warning "
"| A virtual client has an unknown host. During the matching process, it was "
"treated as a physical system. This might translate into a wrong subscription "
"assignment. | Check the virtual host manager (VHM) configuration to ensure "
"it is reporting correctly.\n"
"For Linux-based hosts using ``libvirt``, check that the host is registered, "
"and that the virtual host system type is set correctly.\n"
"| System has an unknown number of sockets, assuming 16 | Warning | Unable to "
"determine how many CPUs a client has. {productname} used the default value "
"of 16 CPUs every time the number was relevant for matching a "
"subscription. This might translate into a wrong subscription assignment. | "
"Schedule a hardware refresh on this client.\n"
"| Two subscriptions with the same part number are in a bundle | "
"Informational | Two subscriptions were identified to be part of a bundle "
"and, as result, they were merged together during the computation process. | "
"No actions needed.\n"
"| Two subscriptions with the same part number (and other properties) have "
"been merged together | Informational | Two subscription shared multiple "
"common properties and they were merged together during the computation "
"process. | No actions needed.\n"
"| Pinned match adjusted due to merged subscriptions | Informational | A user "
"defined pin was updated since the chosen subscription was merged with "
"another one. | No actions needed.\n"
"| Subscription with unsupported part number and no associated product has "
"been ignored. | Informational | An unknown subscription without any "
"associated product has been detected and it was ignored during the matching "
"process. | No actions needed.\n"
msgstr ""
"| ຂໍ້ຄວາມ | ປະເພດ | ຄຳອະທິບາຍ | ການດຳເນີນການ\n"
"| Unsupported part number detected | Debug | ພົບໝາຍເລກ part number ທີ່ບໍ່ຮູ້ຈັກ ຫຼື ບໍ່ຮອງຮັບ. | ຕິດຕໍ່ຝ່າຍຊ່ວຍເຫຼືອ {suse} ເພື່ອແຈ້ງໃຫ້ເພີ່ມໝາຍເລກ part number ໃນຜະລິດຕະພັນ.\n"
"| Physical system is reported as virtual guest... | Debug | ລະບົບ physical ລາຍງານວ່າເປັນ virtual guest. | ກວດສອບຂໍ້ມູນຮາດແວຂອງໄຄເອັນ.\n"
"| Virtual guest has unknown host... | Warning | virtual client ບໍ່ຮູ້ຈັກໂຮສ. ລະບົບຈະຖືວ່າເປັນ physical ເຊິ່ງອາດເຮັດໃຫ້ການກຳນົດການສະໝັກໃຊ້ຜິດພາດ. | ກວດສອບການກຳນົດຄ່າ VHM ໃຫ້ຖືກຕ້ອງ.\n"
"| System has an unknown number of sockets... | Warning | ບໍ່ສາມາດລະບຸຈຳນວນ CPU ໄດ້. ລະບົບໃຊ້ຄ່າເລີ່ມຕົ້ນ 16 CPU ເຊິ່ງອາດເຮັດໃຫ້ການກຳນົດການສະໝັກໃຊ້ຜິດພາດ. | ຕັ້ງເວລາໃຫ້ຣີເຟຣຊຂໍ້ມູນຮາດແວໃນໄຄເອັນນີ້.\n"
"| Two subscriptions... are in a bundle | Informational | ພົບການສະໝັກໃຊ້ສອງອັນຢູ່ໃນຊຸດດຽວກັນ ຈຶ່ງໄດ້ລວມເຂົ້າກັນໃນຂະບວນການຄຳນວນ. | ບໍ່ຕ້ອງດຳເນີນການຫຍັງ.\n"
"| Two subscriptions... merged together | Informational | ການສະໝັກໃຊ້ສອງອັນທີ່ມີຄຸນສົມບັດຄືກັນໄດ້ຖືກລວມເຂົ້າກັນ. | ບໍ່ຕ້ອງດຳເນີນການຫຍັງ.\n"
"| Pinned match adjusted... | Informational | ການປັກໝຸດ (pin) ຖືກອັບເດດ ເພາະການສະໝັກໃຊ້ທີ່ເລືອກຖືກລວມເຂົ້າກັບອັນອື່ນ. | ບໍ່ຕ້ອງດຳເນີນການຫຍັງ.\n"
"| Subscription... has been ignored. | Informational | ການສະໝັກໃຊ້ທີ່ບໍ່ຮູ້ຈັກ ແລະ ບໍ່ມີຜະລິດຕະພັນກ່ຽວຂ້ອງຖືກລະເວັ້ນໃນຂະບວນການຈັບຄູ່. | ບໍ່ຕ້ອງດຳເນີນການຫຍັງ.\n"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-subscription-matching.adoc:9
msgid ""
"To pin clients to a particular subscription, navigate to the "
"[guimenu]``Pins`` tab."
msgstr "ເພື່ອປັກໝຸດ (pin) ໄຄເອັນໃຫ້ກັບການສະໝັກໃຊ້ໃດໜຶ່ງ, ໃຫ້ໄປທີ່ແທັບ [guimenu]``Pins``."

#. type: Block title
#: en/modules/reference/pages/audit/audit-subscription-matching.adoc:10
#, no-wrap
msgid "Pin Statuses"
msgstr "ສະຖານະການປັກໝຸດ"

#. type: Table
#: en/modules/reference/pages/audit/audit-subscription-matching.adoc:11
#, no-wrap
msgid ""
"| Status                  | Description\n"
"| Satisfied               | The client and subscription were matched "
"correctly.\n"
"| Not satisfied           | The client was not successfully matched with a "
"subscription.\n"
"| Pending next run        | Waiting for the next matcher run.\n"
msgstr ""
"| ສະຖານະ | ຄຳອະທິບາຍ\n"
"| Satisfied | ໄຄເອັນ ແລະ ການສະໝັກໃຊ້ຖືກຈັບຄູ່ກັນຢ່າງຖືກຕ້ອງ.\n"
"| Not satisfied | ໄຄເອັນບໍ່ສາມາດຈັບຄູ່ກັບການສະໝັກໃຊ້ໄດ້.\n"
"| Pending next run | ກຳລັງລໍຖ້າການເຮັດວຽກຂອງລະບົບຈັບຄູ່ໃນຄັ້ງຕໍ່ໄປ.\n"

#. type: Plain text
#: en/modules/reference/pages/audit/audit-subscription-matching.adoc:12
msgid ""
"For more information about subscription matching, see "
"xref:administration:subscription-matching.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການຈັບຄູ່ການສະໝັກໃຊ້, ໃຫ້ເບິ່ງ xref:administration:subscription-matching.adoc[]."

#. type: Title =
#: en/modules/reference/pages/audit/openscap-advanced-search.adoc:1
#: en/modules/reference/pages/spacecmd/package.adoc:28
#: en/modules/reference/pages/systems/advanced-search.adoc:1
#, no-wrap
msgid "Advanced Search"
msgstr "ການຄົ້ນຫາແບບລະອຽດ"

#. type: Plain text
#: en/modules/reference/pages/audit/openscap-advanced-search.adoc:2
msgid ""
"The menu:Audit[OpenSCAP > Advanced Search] section allows you to search "
"through OpenSCAP scans and results."
msgstr "ສ່ວນ menu:Audit[OpenSCAP > Advanced Search] ອະນຸຍາດໃຫ້ທ່ານຄົ້ນຫາຜ່ານການສະແກນ ແລະ ຜົນການສະແກນ OpenSCAP."

#. type: Title =
#: en/modules/reference/pages/audit/openscap-all-scans.adoc:1
#, no-wrap
msgid "All Scans"
msgstr "ການສະແກນທັງໝົດ"

#. type: Plain text
#: en/modules/reference/pages/audit/openscap-all-scans.adoc:3
msgid ""
"￼The Security Content Automation Protocol (SCAP) is a synthesis of "
"interoperable specifications derived from community ideas."
msgstr "Security Content Automation Protocol (SCAP) ແມ່ນການລວບລວມມາດຕະຖານທີ່ເຮັດວຽກຮ່ວມກັນໄດ້ ເຊິ່ງໄດ້ມາຈາກແນວຄວາມຄິດຂອງຊຸມຊົນ."

#. type: Block title
#: en/modules/reference/pages/audit/openscap-all-scans.adoc:4
#, no-wrap
msgid "OpenSCAP Scan Details"
msgstr "ລາຍລະອຽດການສະແກນ OpenSCAP"

#. type: Table
#: en/modules/reference/pages/audit/openscap-all-scans.adoc:5
#, no-wrap
msgid ""
"| Name          | Description | Evaluation Results\n"
"| System        | The name of the scanned client. |\n"
"| XCCDF Profile | The evaluated profile. |\n"
"| Completed     | The time that the scan was completed. |\n"
"| Satisfied     | The total number of rules that have been satisfied. | A "
"rule is satisfied if the result of the evaluation is ``Pass`` or "
"``Fixed``.\n"
"| Dissatisfied  | The total number of rules that are not satisfied. | A rule "
"is dissatisfied if the result of the evaluation is ``Fail``.\n"
"| Unknown | The total number of rules that were not able to be evaluated. | "
"A rule is unknown if the result of the evaluation is ``Error``, ``Unknown`` "
"or ``Not checked``.\n"
msgstr ""
"| ຊື່ | ຄຳອະທິບາຍ | ຜົນການປະເມີນ\n"
"| System | ຊື່ຂອງໄຄເອັນທີ່ຖືກສະແກນ. |\n"
"| XCCDF Profile | ໂປຣໄຟລ໌ທີ່ຖືກປະເມີນ. |\n"
"| Completed | ເວລາທີ່ການສະແກນສຳເລັດ. |\n"
"| Satisfied | ຈຳນວນກົດລະບຽບທັງໝົດທີ່ຜ່ານ. | ກົດລະບຽບຈະຖືວ່າ 'Satisfied' ຫາກຜົນການປະເມີນເປັນ ``Pass`` ຫຼື ``Fixed``.\n"
"| Dissatisfied | ຈຳນວນກົດລະບຽບທັງໝົດທີ່ບໍ່ຜ່ານ. | ກົດລະບຽບຈະຖືວ່າ 'Dissatisfied' ຫາກຜົນການປະເມີນເປັນ ``Fail``.\n"
"| Unknown | ຈຳນວນກົດລະບຽບທັງໝົດທີ່ບໍ່ສາມາດປະເມີນໄດ້. | ກົດລະບຽບຈະຖືວ່າ 'Unknown' ຫາກຜົນເປັນ ``Error``, ``Unknown`` ຫຼື ``Not checked``.\n"

#. type: delimited block =
#: en/modules/reference/pages/audit/openscap-all-scans.adoc:6
msgid ""
"Rules can also return other results, including ``Informational``, ``Not "
"Applicable``, or ``Not Selected``.  Rules that return these results are not "
"shown in the scan results."
msgstr "ກົດລະບຽບອາດຈະສົ່ງຄືນຜົນອື່ນໆນຳ, ເຊັ່ນ: ``Informational``, ``Not Applicable``, ຫຼື ``Not Selected``. ກົດລະບຽບທີ່ສົ່ງຄືນຜົນເຫຼົ່ານີ້ຈະບໍ່ຖືກສະແດງໃນຜົນການສະແກນ."

#. type: Title =
#: en/modules/reference/pages/audit/openscap-menu.adoc:1
#, no-wrap
msgid "OpenSCAP Menu"
msgstr "ເມນູ OpenSCAP"

#. type: Plain text
#: en/modules/reference/pages/audit/openscap-menu.adoc:3
msgid ""
"The Security Content Automation Protocol (SCAP) is a synthesis of "
"interoperable specifications derived from community ideas.  {productname} "
"uses OpenSCAP to implement the SCAP specifications."
msgstr "Security Content Automation Protocol (SCAP) ແມ່ນການລວບລວມມາດຕະຖານທີ່ເຮັດວຽກຮ່ວມກັນໄດ້ ເຊິ່ງໄດ້ມາຈາກແນວຄວາມຄິດຂອງຊຸມຊົນ. {productname} ໃຊ້ OpenSCAP ເພື່ອນຳໃຊ້ມາດຕະຖານ SCAP."

#. type: Title =
#: en/modules/reference/pages/audit/openscap-xccdf-diff.adoc:1
#, no-wrap
msgid "XCCDF Diff"
msgstr "ຄວາມແຕກຕ່າງ XCCDF (XCCDF Diff)"

#. type: Plain text
#: en/modules/reference/pages/audit/openscap-xccdf-diff.adoc:2
msgid ""
"The menu:Audit[OpenSCAP > XCCDF Diff] section allows you to compare two "
"OpenSCAP XCCDF scans."
msgstr "ສ່ວນ menu:Audit[OpenSCAP > XCCDF Diff] ອະນຸຍາດໃຫ້ທ່ານປຽບທຽບການສະແກນ OpenSCAP XCCDF ສອງອັນ."

#. type: Title =
#: en/modules/reference/pages/cli-bootstrap.adoc:1
#, no-wrap
msgid "Bootstrapping Command Line Tools"
msgstr "ເຄື່ອງມືບັນທັດຄຳສັ່ງສຳລັບ Bootstrapping"

#. type: delimited block =
#: en/modules/reference/pages/cli-bootstrap.adoc:2
msgid ""
"To access a shell inside the Server container run [literal]``mgrctl term`` "
"on the container host. From there, one can run the CLI tools as usual."
msgstr "ເພື່ອເຂົ້າເຖິງ shell ພາຍໃນ Server container ໃຫ້ໃຊ້ຄຳສັ່ງ [literal]``mgrctl term`` ໃນ container host. ຈາກນັ້ນ, ທ່ານສາມາດໃຊ້ເຄື່ອງມື CLI ໄດ້ຕາມປົກກະຕິ."

#. type: Plain text
#: en/modules/reference/pages/cli-bootstrap.adoc:3
msgid ""
"The ``mgr-create-bootstrap-repo`` tool allows you to create a bootstrap "
"repository."
msgstr "ເຄື່ອງມື ``mgr-create-bootstrap-repo`` ອະນຸຍາດໃຫ້ທ່ານສ້າງ bootstrap repository."

#. type: Plain text
#: en/modules/reference/pages/cli-bootstrap.adoc:4
msgid ""
"Use the ``mgr-create-bootstrap-repo`` command on the {productname} Server to "
"create a new bootstrap repository.  The ``-l`` option lists all available "
"repositories:"
msgstr "ໃຊ້ຄຳສັ່ງ ``mgr-create-bootstrap-repo`` ໃນເຊີເວີ {productname} ເພື່ອສ້າງ bootstrap repository ໃໝ່. ຕົວເລືອກ ``-l`` ຈະສະແດງລາຍຊື່ຄັງຊອບແວທີ່ມີທັງໝົດ:"

#. type: delimited block -
#: en/modules/reference/pages/cli-bootstrap.adoc:5
#, no-wrap
msgid "mgr-create-bootstrap-repo -l\n"
msgstr "mgr-create-bootstrap-repo -l\n"

#. type: Plain text
#: en/modules/reference/pages/cli-bootstrap.adoc:6
msgid "Give the repository name to create the bootstrap repository you require:"
msgstr "ລະບຸຊື່ຄັງຊອບແວເພື່ອສ້າງ bootstrap repository ທີ່ທ່ານຕ້ອງການ:"

#. type: delimited block -
#: en/modules/reference/pages/cli-bootstrap.adoc:7
#, no-wrap
msgid "mgr-create-bootstrap-repo <repo-name>\n"
msgstr "mgr-create-bootstrap-repo <ຊື່_ຄັງຊອບແວ>\n"

#. type: Plain text
#: en/modules/reference/pages/cli-bootstrap.adoc:8
msgid ""
"You can also create a new bootstrap repository from a custom channel, with "
"the ``--with-custom-channels`` option:"
msgstr "ທ່ານຍັງສາມາດສ້າງ bootstrap repository ໃໝ່ຈາກຊ່ອງທາງທີ່ກຳນົດເອງໄດ້ ດ້ວຍຕົວເລືອກ ``--with-custom-channels``:"

#. type: delimited block -
#: en/modules/reference/pages/cli-bootstrap.adoc:9
#, no-wrap
msgid "mgr-create-bootstrap-repo --with-custom-channels\n"
msgstr "mgr-create-bootstrap-repo --with-custom-channels\n"

#. type: Plain text
#: en/modules/reference/pages/cli-bootstrap.adoc:10
msgid ""
"If you create a bootstrap repository that contains custom channels, and "
"later attempt to rebuild with the ``mgr-create-bootstrap-repo`` command, the "
"custom channel information will remain in the bootstrap repository.  To "
"remove custom channel information from your bootstrap repository, use the "
"[code]``--flush`` option when you rebuild:"
msgstr "ຫາກທ່ານສ້າງ bootstrap repository ທີ່ມີຊ່ອງທາງກຳນົດເອງ, ແລະ ຕໍ່ມາພະຍາຍາມສ້າງໃໝ່ດ້ວຍຄຳສັ່ງ ``mgr-create-bootstrap-repo``, ຂໍ້ມູນຊ່ອງທາງກຳນົດເອງຈະຍັງຄົງຢູ່ໃນ bootstrap repository. ເພື່ອລຶບຂໍ້ມູນຊ່ອງທາງກຳນົດເອງອອກ, ໃຫ້ໃຊ້ຕົວເລືອກ [code]``--flush`` ເມື່ອສ້າງໃໝ່:"

#. type: delimited block -
#: en/modules/reference/pages/cli-bootstrap.adoc:11
#, no-wrap
msgid "mgr-create-bootstrap-repo --flush\n"
msgstr "mgr-create-bootstrap-repo --flush\n"

#. type: Title =
#: en/modules/reference/pages/cli-channels.adoc:1
#, no-wrap
msgid "Channel Management CLI Tools"
msgstr "ເຄື່ອງມື CLI ສຳລັບການຈັດການຊ່ອງທາງ"

#. type: delimited block =
#: en/modules/reference/pages/cli-channels.adoc:2
#: en/modules/reference/pages/cli-sync.adoc:2
#: en/modules/reference/pages/command-line-tools.adoc:2
#: en/modules/reference/pages/spacecmd-intro.adoc:2
#: en/modules/reference/pages/spacecmd/configuring-spacecmd.adoc:2
msgid ""
"To access a shell inside the Server container, run [literal]``mgrctl term`` "
"on the container host. From there, one can run the CLI tools as usual."
msgstr "ເພື່ອເຂົ້າເຖິງ shell ພາຍໃນ Server container, ໃຫ້ໃຊ້ຄຳສັ່ງ [literal]``mgrctl term`` ໃນ container host. ຈາກນັ້ນ, ທ່ານສາມາດໃຊ້ເຄື່ອງມື CLI ໄດ້ຕາມປົກກະຕິ."

#. type: Plain text
#: en/modules/reference/pages/cli-channels.adoc:3
msgid ""
"There are tools for managing channels on the server.  With "
"[command]``spacewalk-remove-channel``, list and delete channels in various "
"ways."
msgstr "ມີເຄື່ອງມືສຳລັບຈັດການຊ່ອງທາງໃນເຊີເວີ. ດ້ວຍຄຳສັ່ງ [command]``spacewalk-remove-channel``, ທ່ານສາມາດສະແດງລາຍຊື່ ແລະ ລຶບຊ່ອງທາງໄດ້ໃນຫຼາຍຮູບແບບ."

#. type: Title ==
#: en/modules/reference/pages/cli-channels.adoc:4
#, no-wrap
msgid "Manage Channels with [command]``spacewalk-remove-channel``"
msgstr "ຈັດການຊ່ອງທາງດ້ວຍ [command]``spacewalk-remove-channel``"

#. type: Plain text
#: en/modules/reference/pages/cli-channels.adoc:5
msgid "Usage: spacewalk-remove-channel [options]"
msgstr "ວິທີໃຊ້: spacewalk-remove-channel [ຕົວເລືອກ]"

#. type: Plain text
#: en/modules/reference/pages/cli-channels.adoc:6
msgid ""
"The use of ``spacewalk-remove-channel`` is to remove channels in various "
"ways."
msgstr "ການໃຊ້ ``spacewalk-remove-channel`` ແມ່ນເພື່ອລຶບຊ່ອງທາງໃນຫຼາຍຮູບແບບ."

#. type: Plain text
#: en/modules/reference/pages/cli-channels.adoc:7
msgid ""
"The available commands and arguments for ``spacewalk-remove-channel`` are "
"listed in this table.  Use this syntax for ``spacewalk-remove-channel`` "
"commands:"
msgstr "ຄຳສັ່ງ ແລະ ອາຣ໌ກິວເມນທີ່ມີໃຫ້ສຳລັບ ``spacewalk-remove-channel`` ແມ່ນມີລາຍຊື່ໃນຕາຕະລາງນີ້. ໃຫ້ໃຊ້ໄວຍາກອນນີ້ສຳລັບຄຳສັ່ງ ``spacewalk-remove-channel``:"

#. type: delimited block -
#: en/modules/reference/pages/cli-channels.adoc:8
#, no-wrap
msgid "spacewalk-remove-channel [options]\n"
msgstr "spacewalk-remove-channel [ຕົວເລືອກ]\n"

#. type: Plain text
#: en/modules/reference/pages/cli-channels.adoc:9
msgid "The [command]``spacewalk-remove-channel`` tool has these primary commands:"
msgstr "ເຄື່ອງມື [command]``spacewalk-remove-channel`` ມີຄຳສັ່ງຫຼັກດັ່ງນີ້:"

#. type: Block title
#: en/modules/reference/pages/cli-channels.adoc:10
#, no-wrap
msgid "spacewalk-remove-channel Options"
msgstr "ຕົວເລືອກ spacewalk-remove-channel"

#. type: Table
#: en/modules/reference/pages/cli-channels.adoc:11
#, no-wrap
msgid ""
"| Option\n"
"| Description\n"
"| Example Use\n"
"\n"
"| list\n"
"| List defined channels and exit.\n"
"| ``spacewalk-remove-channel --list``\n"
"\n"
"| channel\n"
"| Delete this channel (can be present multiple times).\n"
"| ``spacewalk-remove-channel --channel=CHANNEL``\n"
"\n"
"| channel-with-children\n"
"| Delete this channel and its child channels (can be present multiple "
"times).\n"
"| ``spacewalk-remove-channel "
"--channel-with-children=CHANNEL_WITH_CHILDREN``\n"
"\n"
"| unsubscribe\n"
"| Unsubscribe systems registered to the specified channels. Note: "
"Credentials are needed\n"
"| ``spacewalk-remove-channel --unsubscribe``\n"
"\n"
"| justdb\n"
"| Delete only from the database, do not remove files from disk.\n"
"| ``spacewalk-remove-channel --justdb``\n"
"\n"
"| just-kickstart-trees\n"
"| Remove only the kickstart trees for the channels specified.\n"
"| ``spacewalk-remove-channel --just-kickstart-trees``\n"
"\n"
"| skip-channels\n"
"| Remove only packages from channel not the channel itself.\n"
"| ``spacewalk-remove-channel --skip-channels``\n"
"\n"
msgstr ""
"| ຕົວເລືອກ\n"
"| ຄຳອະທິບາຍ\n"
"| ຕົວຢ່າງການໃຊ້\n"
"\n"
"| list\n"
"| ລາຍຊື່ຊ່ອງທາງທີ່ກຳນົດໄວ້ແລ້ວອອກ.\n"
"| ``spacewalk-remove-channel --list``\n"
"\n"
"| channel\n"
"| ລຶບຊ່ອງທາງນີ້ (ສາມາດລະບຸໄດ້ຫຼາຍຄັ້ງ).\n"
"| ``spacewalk-remove-channel --channel=CHANNEL``\n"
"\n"
"| channel-with-children\n"
"| ລຶບຊ່ອງທາງນີ້ ແລະ ຊ່ອງທາງຍ່ອຍຂອງມັນ.\n"
"| ``spacewalk-remove-channel --channel-with-children=CHANNEL_WITH_CHILDREN``\n"
"\n"
"| unsubscribe\n"
"| ຍົກເລີກການສະໝັກໃຊ້ລະບົບທີ່ລົງທະບຽນໃນຊ່ອງທາງທີ່ລະບຸ (ຕ້ອງໃຊ້ຂໍ້ມູນປະຈຳຕົວ).\n"
"| ``spacewalk-remove-channel --unsubscribe``\n"
"\n"
"| justdb\n"
"| ລຶບສະເພາະໃນຖານຂໍ້ມູນ, ບໍ່ລຶບໄຟລ໌ອອກຈາກດິສກ໌.\n"
"| ``spacewalk-remove-channel --justdb``\n"
"\n"
"| just-kickstart-trees\n"
"| ລຶບສະເພາະ kickstart trees ສຳລັບຊ່ອງທາງທີ່ລະບຸ.\n"
"| ``spacewalk-remove-channel --just-kickstart-trees``\n"
"\n"
"| skip-channels\n"
"| ລຶບສະເພາະແພັກເກດອອກຈາກຊ່ອງທາງ ແຕ່ບໍ່ລຶບຕົວຊ່ອງທາງເອງ.\n"
"| ``spacewalk-remove-channel --skip-channels``\n"
"\n"

#. type: Plain text
#: en/modules/reference/pages/cli-channels.adoc:12
msgid ""
"For a complete list of options and abbreviated options, see the ``--help`` "
"output or the ``spacewalk-remove-channel`` manpage:"
msgstr "ສຳລັບລາຍການຕົວເລືອກທັງໝົດ, ໃຫ້ເບິ່ງຈາກ ``--help`` ຫຼື ໜ້າ manpage ຂອງ ``spacewalk-remove-channel``:"

#. type: delimited block -
#: en/modules/reference/pages/cli-channels.adoc:13
#, no-wrap
msgid "man spacewalk-remove-channel\n"
msgstr "man spacewalk-remove-channel\n"

#. type: Plain text
#: en/modules/reference/pages/cli-channels.adoc:14
msgid "For more information, see xref:administration:removing-channels.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມ, ໃຫ້ເບິ່ງ xref:administration:removing-channels.adoc[]."

#. type: Title =
#: en/modules/reference/pages/cli-sync.adoc:1
#, no-wrap
msgid "Synchronization CLI Tools"
msgstr "ເຄື່ອງມື CLI ສຳລັບການ Synchronization"

#. type: Plain text
#: en/modules/reference/pages/cli-sync.adoc:3
msgid ""
"There are two tools for synchronizing clients to the server.  For clients "
"that are connected to the {scclongform}, use ``mgr-sync``.  For all other "
"clients, use ``spacewalk-repo-sync``."
msgstr "ມີເຄື່ອງມືສອງຢ່າງສຳລັບ synchronization ໄຄເອັນກັບເຊີເວີ. ສຳລັບໄຄເອັນທີ່ເຊື່ອມຕໍ່ກັບ {scclongform}, ໃຫ້ໃຊ້ ``mgr-sync``. ສຳລັບໄຄເອັນອື່ນໆ, ໃຫ້ໃຊ້ ``spacewalk-repo-sync``."

#. type: Title ==
#: en/modules/reference/pages/cli-sync.adoc:4
#, no-wrap
msgid "Synchronize {scc} Repositories With mgr-sync"
msgstr "Synchronize ຄັງ {scc} ດ້ວຍ mgr-sync"

#. This content is the same as the content at modules/administration/pages/mgr-sync.adoc Perhaps we should snippet it? --LKB 2020-10-09
#. type: Plain text
#: en/modules/reference/pages/cli-sync.adoc:5
msgid ""
"The primary use of ``mgr-sync`` is to connect to the {scclongform}, retrieve "
"product and package information, and prepare channels for synchronization "
"with the {productname} Server."
msgstr "ການໃຊ້ງານຫຼັກຂອງ ``mgr-sync`` ແມ່ນເພື່ອເຊື່ອມຕໍ່ກັບ {scclongform}, ດຶງຂໍ້ມູນຜະລິດຕະພັນ ແລະ ແພັກເກດ, ແລະ ກຽມຊ່ອງທາງສຳລັບການ synchronization ກັບເຊີເວີ {productname}."

#. type: Plain text
#: en/modules/reference/pages/cli-sync.adoc:6
msgid ""
"This tool is designed for use with a {suse} support subscription.  It is not "
"required for open source distributions, including {opensuse}, {centos}, and "
"{ubuntu}."
msgstr "ເຄື່ອງມືນີ້ຖືກອອກແບບມາເພື່ອໃຊ້ກັບການສະໝັກໃຊ້ການຊ່ວຍເຫຼືອຂອງ {suse}. ມັນບໍ່ຈຳເປັນສຳລັບ open source distributions ເຊັ່ນ: {opensuse}, {centos}, ແລະ {ubuntu}."

#. type: Plain text
#: en/modules/reference/pages/cli-sync.adoc:7
msgid ""
"The available commands and arguments for ``mgr-sync`` are listed in this "
"table.  Use this syntax for ``mgr-sync`` commands:"
msgstr "ຄຳສັ່ງ ແລະ ອາຣ໌ກິວເມນທີ່ມີໃຫ້ສຳລັບ ``mgr-sync`` ແມ່ນມີລາຍຊື່ໃນຕາຕະລາງນີ້. ໃຫ້ໃຊ້ໄວຍາກອນນີ້ສຳລັບຄຳສັ່ງ ``mgr-sync``:"

#. type: delimited block -
#: en/modules/reference/pages/cli-sync.adoc:8
#, no-wrap
msgid "mgr-sync [-h] [--version] [-v] [-s] [-d {1,2,3}] {list,add,refresh,delete}\n"
msgstr "mgr-sync [-h] [--version] [-v] [-s] [-d {1,2,3}] {list,add,refresh,delete}\n"

#. type: Block title
#: en/modules/reference/pages/cli-sync.adoc:9
#, no-wrap
msgid "mgr-sync Commands"
msgstr "ຄຳສັ່ງ mgr-sync"

#. type: Table
#: en/modules/reference/pages/cli-sync.adoc:10
#, no-wrap
msgid ""
"| Command | Description | Example Use\n"
"| list | List channels, organization credentials, or products | ``mgr-sync "
"list channels``\n"
"| add | Add channels, organization credentials, or products | ``mgr-sync add "
"channel <channel_name>``\n"
"| refresh | Refresh the local copy of products, channels, and subscriptions "
"| ``mgr-sync refresh``\n"
"| delete | Delete existing {scc} organization credentials from the local "
"system | ``mgr-sync delete credentials``\n"
"| sync | Synchronize specified channel or ask for it when left blank| "
"``mgr-sync sync channel <channel_name>``\n"
msgstr ""
"| ຄຳສັ່ງ | ຄຳອະທິບາຍ | ຕົວຢ່າງການໃຊ້\n"
"| list | ລາຍຊື່ຊ່ອງທາງ, ຂໍ້ມູນປະຈຳຕົວອົງກອນ, ຫຼື ຜະລິດຕະພັນ | ``mgr-sync list channels``\n"
"| add | ເພີ່ມຊ່ອງທາງ, ຂໍ້ມູນປະຈຳຕົວອົງກອນ, ຫຼື ຜະລິດຕະພັນ | ``mgr-sync add channel <ຊື່_ຊ່ອງທາງ>``\n"
"| refresh | ຣີເຟຣຊຂໍ້ມູນຜະລິດຕະພັນ, ຊ່ອງທາງ, ແລະ ການສະໝັກໃຊ້ໃນເຄື່ອງ | ``mgr-sync refresh``\n"
"| delete | ລຶບຂໍ້ມູນປະຈຳຕົວອົງກອນ {scc} ທີ່ມີໃນລະບົບ | ``mgr-sync delete credentials``\n"
"| sync | synchronize ຊ່ອງທາງທີ່ລະບຸ ຫຼື ຖາມຫາຫາກວ່າງໄວ້ | ``mgr-sync sync channel <ຊື່_ຊ່ອງທາງ>``\n"

#. type: Plain text
#: en/modules/reference/pages/cli-sync.adoc:11
msgid "To see the full list of options specific to a command, use this command:"
msgstr "ເພື່ອເບິ່ງລາຍການຕົວເລືອກທັງໝົດທີ່ສະເພາະເຈາະຈົງກັບຄຳສັ່ງໃດໜຶ່ງ, ໃຫ້ໃຊ້ຄຳສັ່ງນີ້:"

#. type: delimited block -
#: en/modules/reference/pages/cli-sync.adoc:12
#, no-wrap
msgid "mgr-sync <command> --help\n"
msgstr "mgr-sync <ຄຳສັ່ງ> --help\n"

#. type: Block title
#: en/modules/reference/pages/cli-sync.adoc:13
#, no-wrap
msgid "mgr-sync Optional Arguments"
msgstr "ອາຣ໌ກິວເມນທາງເລືອກຂອງ mgr-sync"

#. type: Table
#: en/modules/reference/pages/cli-sync.adoc:14
#, no-wrap
msgid ""
"| Option | Abbreviated option | Description | Example Use\n"
"| help | ``h`` | Display the command usage and options | ``mgr-sync "
"--help``\n"
"| version | N/A | Display the currently installed version of ``mgr-sync`` | "
"``mgr-sync --version``\n"
"| verbose | ``v`` | Provide verbose output | ``mgr-sync --verbose "
"refresh``\n"
"| store-credentials | ``s`` | Store credentials a local hidden file | "
"``mgr-sync --store-credentials``\n"
"| debug | ``d`` | Log additional debugging information. Requires a level of "
"1, 2, 3. 3 provides the highest amnount of debugging information | "
"``mgr-sync -d 3 refresh``\n"
"| no-sync | N/A | Use with the ``add`` command to add products or channels "
"without beginning a synchronization | ``mgr-sync --no-sync add "
"<channel_name>``\n"
msgstr ""
"| ຕົວເລືອກ | ຕົວເລືອກແບບຫຍໍ້ | ຄຳອະທິບາຍ | ຕົວຢ່າງການໃຊ້\n"
"| help | ``h`` | ສະແດງວິທີການໃຊ້ງານ ແລະ ຕົວເລືອກຂອງຄຳສັ່ງ | ``mgr-sync --help``\n"
"| version | N/A | ສະແດງເວີຊັນຂອງ ``mgr-sync`` ທີ່ຕິດຕັ້ງຢູ່ | ``mgr-sync --version``\n"
"| verbose | ``v`` | ສະແດງລາຍລະອຽດການເຮັດວຽກຢ່າງລະອຽດ | ``mgr-sync --verbose refresh``\n"
"| store-credentials | ``s`` | ເກັບຂໍ້ມູນປະຈຳຕົວໄວ້ໃນໄຟລ໌ທີ່ຊ່ອນຢູ່ໃນເຄື່ອງ | ``mgr-sync --store-credentials``\n"
"| debug | ``d`` | ບັນທຶກຂໍ້ມູນການແກ້ໄຂຈຸດບົກພ່ອງເພີ່ມເຕີມ (ລະດັບ 1, 2, 3) | ``mgr-sync -d 3 refresh``\n"
"| no-sync | N/A | ໃຊ້ກັບຄຳສັ່ງ ``add`` ເພື່ອເພີ່ມຜະລິດຕະພັນ ໂດຍບໍ່ເລີ່ມ synchronization | ``mgr-sync --no-sync add <ຊື່_ຊ່ອງທາງ>``\n"

#. type: Plain text
#: en/modules/reference/pages/cli-sync.adoc:15
msgid "Logs for ``mgr-sync`` are located in:"
msgstr "ບັນທຶກ (Logs) ສຳລັບ ``mgr-sync`` ເກັບໄວ້ທີ່:"

#. type: Plain text
#: en/modules/reference/pages/cli-sync.adoc:16
msgid "[path]``/var/log/rhn/mgr-sync.log``"
msgstr "[path]``/var/log/rhn/mgr-sync.log``"

#. type: Plain text
#: en/modules/reference/pages/cli-sync.adoc:17
msgid "[path]``/var/log/rhn/rhn_web_api.log``"
msgstr "[path]``/var/log/rhn/rhn_web_api.log``"

#. type: Title ==
#: en/modules/reference/pages/cli-sync.adoc:18
#, no-wrap
msgid "Synchronize Repositories with spacewalk-repo-sync"
msgstr "Synchronize ຄັງຊອບແວດ້ວຍ spacewalk-repo-sync"

#. type: Plain text
#: en/modules/reference/pages/cli-sync.adoc:19
msgid ""
"The [command]``spacewalk-repo-sync`` tool synchronizes software repositories "
"into {productname} channels.  In most cases, this happens automatically, but "
"you can use the tool to run it manually if required."
msgstr "ເຄື່ອງມື [command]``spacewalk-repo-sync`` ຈະ synchronize ຄັງຊອບແວໄປຍັງຊ່ອງທາງຂອງ {productname}. ສ່ວນຫຼາຍມັນຈະເຮັດວຽກອັດຕະໂນມັດ, ແຕ່ທ່ານສາມາດໃຊ້ເຄື່ອງມືນີ້ເພື່ອເຮັດເອງໄດ້ຫາກຈຳເປັນ."

#. type: Plain text
#: en/modules/reference/pages/cli-sync.adoc:20
msgid "The [command]``spacewalk-repo-sync`` tool has these primary commands:"
msgstr "ເຄື່ອງມື [command]``spacewalk-repo-sync`` ມີຄຳສັ່ງຫຼັກດັ່ງນີ້:"

#. type: Block title
#: en/modules/reference/pages/cli-sync.adoc:21
#, no-wrap
msgid "spacewalk-repo-sync Options"
msgstr "ຕົວເລືອກ spacewalk-repo-sync"

#. type: Table
#: en/modules/reference/pages/cli-sync.adoc:22
#, no-wrap
msgid ""
"| Option\n"
"| Description\n"
"| Example Use\n"
"\n"
"| list\n"
"| List all custom channels and the repositories assigned to them.\n"
"| ``spacewalk-repo-sync --list``\n"
"\n"
"| channel\n"
"| Synchronize a single channel to all repositories assigned to it.\n"
"| ``spacewalk-repo-sync  --channel <custom-channel>``\n"
"\n"
"| deep-verify\n"
"| ignore cached package checksums.\n"
"| ``spacewalk-repo-sync --deep-verify``\n"
"\n"
"| force-all-errata\n"
"| force re-importing all the patches.\n"
"| ``spacewalk-repo-sync --deep-verify``\n"
"\n"
"| no-packages\n"
"| excludes packages from the operation.\n"
"| ``spacewalk-repo-sync --deep-verify --no-packages``\n"
"\n"
msgstr ""
"| ຕົວເລືອກ\n"
"| ຄຳອະທິບາຍ\n"
"| ຕົວຢ່າງການໃຊ້\n"
"\n"
"| list\n"
"| ລາຍຊື່ຊ່ອງທາງກຳນົດເອງທັງໝົດ ແລະ ຄັງຊອບແວທີ່ກ່ຽວຂ້ອງ.\n"
"| ``spacewalk-repo-sync --list``\n"
"\n"
"| channel\n"
"| synchronize ຊ່ອງທາງດຽວໄປຍັງທຸກຄັງຊອບແວທີ່ກຳນົດໃຫ້.\n"
"| ``spacewalk-repo-sync --channel <ຊ່ອງທາງ_ກຳນົດເອງ>``\n"
"\n"
"| deep-verify\n"
"| ລະເວັ້ນການກວດສອບ checksum ຂອງແພັກເກດໃນແຄັດ.\n"
"| ``spacewalk-repo-sync --deep-verify``\n"
"\n"
"| force-all-errata\n"
"| ບັງຄັບໃຫ້ນຳເຂົ້າແພັດຊ໌ທັງໝົດຄືນໃໝ່.\n"
"| ``spacewalk-repo-sync --force-all-errata``\n"
"\n"
"| no-packages\n"
"| ບໍ່ລວມແພັກເກດໃນການດຳເນີນການ.\n"
"| ``spacewalk-repo-sync --no-packages``\n"
"\n"

#. type: Plain text
#: en/modules/reference/pages/cli-sync.adoc:23
msgid "For a complete list of options, see the ``spacewalk-repo-sync`` manpage:"
msgstr "ສຳລັບລາຍການຕົວເລືອກທັງໝົດ, ໃຫ້ເບິ່ງໜ້າ manpage ຂອງ ``spacewalk-repo-sync``:"

#. type: delimited block -
#: en/modules/reference/pages/cli-sync.adoc:24
#, no-wrap
msgid "man spacewalk-repo-sync\n"
msgstr "man spacewalk-repo-sync\n"

#. type: Title ==
#: en/modules/reference/pages/cli-sync.adoc:25
#, no-wrap
msgid "Troubleshooting Synchronization"
msgstr "ການແກ້ໄຂບັນຫາການ Synchronization"

#. type: Plain text
#: en/modules/reference/pages/cli-sync.adoc:26
msgid ""
"If you are having trouble synchronizing with ``spacewalk-repo-sync`` you can "
"find out more by watching the HTTP log as the command runs."
msgstr "ຫາກທ່ານມີບັນຫາໃນການ synchronization ດ້ວຍ ``spacewalk-repo-sync``, ທ່ານສາມາດເບິ່ງຂໍ້ມູນເພີ່ມເຕີມໄດ້ຈາກການຕິດຕາມ HTTP log ໃນຂະນະທີ່ຄຳສັ່ງເຮັດວຽກ."

#. type: Block title
#: en/modules/reference/pages/cli-sync.adoc:27
#, no-wrap
msgid "Procedure: Troubleshooting Synchronization Problems"
msgstr "ຂັ້ນຕອນ: ການແກ້ໄຂບັນຫາການ Synchronization"

#. type: Plain text
#: en/modules/reference/pages/cli-sync.adoc:28
msgid "Log the HTTP output into [path]``/var/log/zypper.log``:"
msgstr "ບັນທຶກຜົນ HTTP ໄວ້ໃນ [path]``/var/log/zypper.log``:"

#. type: delimited block -
#: en/modules/reference/pages/cli-sync.adoc:29
#, no-wrap
msgid "ZYPP_MEDIA_CURL_DEBUG=2 spacewalk-repo-sync --channel <channel-label>\n"
msgstr "ZYPP_MEDIA_CURL_DEBUG=2 spacewalk-repo-sync --channel <ປ້າຍຊື່_ຊ່ອງທາງ>\n"

#. type: Plain text
#: en/modules/reference/pages/cli-sync.adoc:30
msgid "Export the setting:"
msgstr "Export ການຕັ້ງຄ່າ:"

#. type: delimited block -
#: en/modules/reference/pages/cli-sync.adoc:31
#, no-wrap
msgid "export URLGRABBER_DEBUG=DEBUG\n"
msgstr "export URLGRABBER_DEBUG=DEBUG\n"

#. type: Plain text
#: en/modules/reference/pages/cli-sync.adoc:32
msgid "Start the synchronization:"
msgstr "ເລີ່ມການ synchronization:"

#. type: delimited block -
#: en/modules/reference/pages/cli-sync.adoc:33
#, no-wrap
msgid "/usr/bin/spacewalk-repo-sync --channel <channel-label> --type yum\n"
msgstr "/usr/bin/spacewalk-repo-sync --channel <ປ້າຍຊື່_ຊ່ອງທາງ> --type yum\n"

#. type: Plain text
#: en/modules/reference/pages/cli-sync.adoc:34
#, no-wrap
msgid ""
"  You can increase the debug level, by adding the [option]``-vvv`` option to "
"the command.\n"
msgstr "  ທ່ານສາມາດເພີ່ມລະດັບການ debug ໄດ້ໂດຍການຕື່ມຕົວເລືອກ [option]``-vvv`` ໃນຄຳສັ່ງ.\n"

#. type: Plain text
#: en/modules/reference/pages/cli-sync.adoc:35
#, no-wrap
msgid "When the complete completes, or fails, disable debug mode:\n"
msgstr "ເມື່ອການເຮັດວຽກສຳເລັດ ຫຼື ຫຼົ້ມເຫຼວ, ໃຫ້ປິດໂໝດ debug:\n"

#. type: delimited block -
#: en/modules/reference/pages/cli-sync.adoc:36
#, no-wrap
msgid "unset URLGRABBER_DEBUG\n"
msgstr "unset URLGRABBER_DEBUG\n"

#. type: Title ===
#: en/modules/reference/pages/cli-sync.adoc:37
#, no-wrap
msgid "Add Custom Extra HTTP Headers"
msgstr "ເພີ່ມ Custom Extra HTTP Headers"

#. type: Plain text
#: en/modules/reference/pages/cli-sync.adoc:38
msgid ""
"You can add custom HTTP headers to the requests made by "
"[command]``spacewalk-repo-sync`` at the time of synchronization.  The custom "
"HTTP headers are defined in the "
"[path]``/etc/rhn/spacewalk-repo-sync/extra_headers.conf`` configuration "
"file.  The headers can be defined by repository name or channel label.  You "
"can also define global headers by putting them in the ``main`` section.  For "
"example:"
msgstr "ທ່ານສາມາດເພີ່ມ HTTP headers ແບບກຳນົດເອງໃຫ້ກັບການຮ້ອງຂໍທີ່ເຮັດໂດຍ [command]``spacewalk-repo-sync`` ໃນເວລາດຳເນີນການ synchronization. HTTP headers ຖືກກຳນົດໄວ້ໃນໄຟລ໌ [path]``/etc/rhn/spacewalk-repo-sync/extra_headers.conf``. headers ສາມາດກຳນົດຕາມຊື່ຄັງຊອບແວ ຫຼື ປ້າຍຊື່ຊ່ອງທາງ. ທ່ານຍັງສາມາດກຳນົດ headers ແບບທົ່ວໄປ (global) ໄດ້ໃນສ່ວນ ``main``. ຕົວຢ່າງ:"

#. type: delimited block -
#: en/modules/reference/pages/cli-sync.adoc:39
#, no-wrap
msgid ""
"[testchannel]\n"
"X-MY-HEADER-1=VALUE\n"
"X-MY-HEADER-2=VALUE\n"
msgstr ""
"[testchannel]\n"
"X-MY-HEADER-1=VALUE\n"
"X-MY-HEADER-2=VALUE\n"

#. type: delimited block -
#: en/modules/reference/pages/cli-sync.adoc:40
#, no-wrap
msgid ""
"[mychannel]\n"
"X-MY-HEADER-3=VALUE\n"
"X-MY-HEADER-4=VALUE\n"
msgstr ""
"[mychannel]\n"
"X-MY-HEADER-3=VALUE\n"
"X-MY-HEADER-4=VALUE\n"

#. type: delimited block -
#: en/modules/reference/pages/cli-sync.adoc:41
#, no-wrap
msgid ""
"[main]\n"
"X-MYGLOBAL-HEADER=VALUE\n"
msgstr ""
"[main]\n"
"X-MYGLOBAL-HEADER=VALUE\n"

#. type: Plain text
#: en/modules/reference/pages/cli-sync.adoc:42
msgid ""
"This can be particularly useful when dealing with Red Hat Update "
"Infrastructure (RHUI) repositories in the public cloud."
msgstr "ສິ່ງນີ້ມີປະໂຫຍດເປັນພິເສດເມື່ອຈັດການກັບຄັງເກັບຊອບແວ (repositories) ຂອງ Red Hat Update Infrastructure (RHUI) ໃນພັບບລິກຄລາວ (public cloud)."

#. type: Title =
#: en/modules/reference/pages/clm/clm-filters.adoc:1
#, no-wrap
msgid "Filters"
msgstr "ຕົວກັ່ນຕອງ"

#. type: Plain text
#: en/modules/reference/pages/clm/clm-filters.adoc:2
msgid ""
"In the menu:Content Lifecycle[Filters] section, you can create various types "
"of filters.  With the filters you control the content that is used when a "
"content lifecycle project is built."
msgstr "ໃນພາກສ່ວນ menu:Content Lifecycle[Filters], ທ່ານສາມາດສ້າງຕົວກັ່ນຕອງໄດ້ຫຼາຍປະເພດ. ດ້ວຍຕົວກັ່ນຕອງເຫຼົ່ານີ້, ທ່ານສາມາດຄວບຄຸມເນື້ອຫາທີ່ຈະຖືກນຳໃຊ້ເມື່ອມີການສ້າງໂຄງການວົງຈອນຊີວິດເນື້ອຫາ."

#. type: Plain text
#: en/modules/reference/pages/clm/clm-filters.adoc:3
#: en/modules/reference/pages/clm/clm-menu.adoc:4
#: en/modules/reference/pages/clm/clm-projects.adoc:3
msgid ""
"For more information about content lifecycle management, see "
"xref:administration:content-lifecycle.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການຈັດການວົງຈອນຊີວິດເນື້ອຫາ, ເບິ່ງໄດ້ທີ່ xref:administration:content-lifecycle.adoc[]."

#. type: Title =
#: en/modules/reference/pages/clm/clm-menu.adoc:1
#, no-wrap
msgid "Content Lifecycle Management Menu"
msgstr "ເມນູການຈັດການວົງຈອນຊີວິດເນື້ອຫາ"

#. type: Plain text
#: en/modules/reference/pages/clm/clm-menu.adoc:2
msgid ""
"In the [guimenu]``Content Lifecycle`` section, you can customize and test "
"packages before updating production clients."
msgstr "ໃນພາກສ່ວນ [guimenu]``Content Lifecycle``, ທ່ານສາມາດປັບແຕ່ງ ແລະ ທົດສອບແພັກເກດຕ່າງໆ ກ່ອນທີ່ຈະອັບເດດໃຫ້ກັບໄຄເອັນທີ່ໃຊ້ງານຈິງ."

#. type: Plain text
#: en/modules/reference/pages/clm/clm-menu.adoc:3
msgid ""
"Content lifecycle management allows you to select software channels as "
"sources, adjust them as required for your environment, and thoroughly test "
"them before installing onto your production clients."
msgstr "ການຈັດການວົງຈອນຊີວິດເນື້ອຫາຊ່ວຍໃຫ້ທ່ານສາມາດເລືອກຊ່ອງທາງຊອບແວເປັນແຫຼ່ງຂໍ້ມູນ, ປັບແຕ່ງພວກມັນຕາມຄວາມຕ້ອງການຂອງສະພາບແວດລ້ອມຂອງທ່ານ, ແລະ ທົດສອບຢ່າງລະອຽດ ກ່ອນທີ່ຈະຕິດຕັ້ງລົງໃນໄຄເອັນທີ່ໃຊ້ງານຈິງ."

#. type: Title =
#: en/modules/reference/pages/clm/clm-projects.adoc:1
#, no-wrap
msgid "Projects"
msgstr "ໂຄງການ"

#. type: Plain text
#: en/modules/reference/pages/clm/clm-projects.adoc:2
msgid ""
"In the menu:Content Lifecycle[Projects] section, you can create new content "
"lifecycle management projects, and edit existing projects."
msgstr "ໃນພາກສ່ວນ menu:Content Lifecycle[Projects], ທ່ານສາມາດສ້າງໂຄງການຈັດການວົງຈອນຊີວິດເນື້ອຫາໃໝ່ ແລະ ແກ້ໄຂໂຄງການທີ່ມີຢູ່ແລ້ວໄດ້."

#. type: Title =
#: en/modules/reference/pages/command-line-tools.adoc:1
#, no-wrap
msgid "Command Line Tools"
msgstr "ເຄື່ອງມືຄຳສັ່ງ (Command Line Tools)"

#. type: Plain text
#: en/modules/reference/pages/command-line-tools.adoc:3
msgid ""
"There are several command line tools available in {productname}.  Every "
"action that can be completed using the {webui} can be performed at a command "
"prompt instead.  Additionally, there are some actions that can only be "
"performed at the command prompt."
msgstr "ມີເຄື່ອງມືຄຳສັ່ງຫຼາຍຢ່າງໃຫ້ເລືອກໃຊ້ໃນ {productname}. ທຸກໆການດຳເນີນການທີ່ສາມາດເຮັດຜ່ານ {webui} ແມ່ນສາມາດເຮັດຜ່ານ command prompt ໄດ້ເຊັ່ນກັນ. ນອກຈາກນັ້ນ, ຍັງມີບາງການດຳເນີນການທີ່ສາມາດເຮັດໄດ້ສະເພາະຜ່ານ command prompt ເທົັ້ນັ້ນ."

#. type: Plain text
#: en/modules/reference/pages/command-line-tools.adoc:4
msgid "Manage package and channel synchronization with:"
msgstr "ຈັດການການຊິງໂຄຣໄນແພັກເກດ ແລະ ຊ່ອງທາງດ້ວຍ:"

#. type: Plain text
#: en/modules/reference/pages/command-line-tools.adoc:5
msgid "``spacewalk-repo-sync``"
msgstr "``spacewalk-repo-sync``"

#. type: Plain text
#: en/modules/reference/pages/command-line-tools.adoc:6
msgid "``mgr-sync``"
msgstr "``mgr-sync``"

#. type: Plain text
#: en/modules/reference/pages/command-line-tools.adoc:7
msgid "Manage bootstrapping with:"
msgstr "ຈັດການການບູດສະແຕຣບ (bootstrapping) ດ້ວຍ:"

#. type: Plain text
#: en/modules/reference/pages/command-line-tools.adoc:8
msgid "``mgr-create-bootstrap-repo``"
msgstr "``mgr-create-bootstrap-repo``"

#. type: Plain text
#: en/modules/reference/pages/command-line-tools.adoc:9
msgid ""
"Some of these command line tools are installed by default.  To install a "
"command line tool, you can use the {productname} {webui}, or use your "
"package manager at the command prompt."
msgstr "ເຄື່ອງມືຄຳສັ່ງບາງຢ່າງເຫຼົ່ານີ້ຖືກຕິດຕັ້ງໄວ້ເປັນຄ່າເລີ່ມຕົ້ນ. ເພື່ອຕິດຕັ້ງເຄື່ອງມືຄຳສັ່ງ, ທ່ານສາມາດໃຊ້ {productname} {webui} ຫຼື ໃຊ້ຕົວຈັດການແພັກເກດຂອງທ່ານຜ່ານ command prompt."

#. type: Block title
#: en/modules/reference/pages/command-line-tools.adoc:10
#, no-wrap
msgid "Procedure: Installing Command Line Tools with the WebUI"
msgstr "ຂັ້ນຕອນ: ການຕິດຕັ້ງເຄື່ອງມືຄຳສັ່ງດ້ວຍ WebUI"

#. type: Plain text
#: en/modules/reference/pages/command-line-tools.adoc:11
msgid ""
"In the {productname} {webui}, navigate to menu:Systems[System List], select "
"the client to install the tool on, and navigate to the "
"menu:Software[Packages > Install] sub-tab."
msgstr "ໃນ {productname} {webui}, ໃຫ້ໄປທີ່ menu:Systems[System List], ເລືອກໄຄເອັນທີ່ຕ້ອງການຕິດຕັ້ງເຄື່ອງມືໃສ່, ແລະ ໄປທີ່ແທັບຍ່ອຍ menu:Software[Packages > Install]."

#. type: Plain text
#: en/modules/reference/pages/command-line-tools.adoc:12
msgid "Use the search tool to search for the command line tool you want to install."
msgstr "ໃຊ້ເຄື່ອງມືຄົ້ນຫາເພື່ອຄົ້ນຫາເຄື່ອງມືຄຳສັ່ງທີ່ທ່ານຕ້ອງການຕິດຕັ້ງ."

#. type: Plain text
#: en/modules/reference/pages/command-line-tools.adoc:13
msgid "Check the package to install, and click btn:[Install Selected Packages]."
msgstr "ໝາຍເລືອກແພັກເກດທີ່ຈະຕິດຕັ້ງ, ແລ້ວຄລິກ btn:[Install Selected Packages]."

#. type: Plain text
#: en/modules/reference/pages/command-line-tools.adoc:14
msgid "Click btn:[Confirm] to begin installation."
msgstr "ຄລິກ btn:[Confirm] ເພື່ອເລີ່ມຕົ້ນການຕິດຕັ້ງ."

#. type: Block title
#: en/modules/reference/pages/command-line-tools.adoc:15
#, no-wrap
msgid "Procedure: Installing Command Line Tools from the Command Prompt"
msgstr "ຂັ້ນຕອນ: ການຕິດຕັ້ງເຄື່ອງມືຄຳສັ່ງຈາກ Command Prompt"

#.  I tried this on my test install, and it worked on the client, but not the server. What's the server version? --LKB 2020-10-08
#.  On the server, either api/spacewalk or salt probably can be used, I think --ke 2023-11-28
#. type: Plain text
#: en/modules/reference/pages/command-line-tools.adoc:16
msgid ""
"On the client that you want to install the packages on, at the command "
"prompt, as root, use zypper to install the package:"
msgstr "ຢູ່ທີ່ເຄື່ອງໄຄເອັນທີ່ທ່ານຕ້ອງການຕິດຕັ້ງແພັກເກດ, ໃນ command prompt, ດ້ວຍສິດ root, ໃຫ້ໃຊ້ zypper ເພື່ອຕິດຕັ້ງແພັກເກດ:"

#. type: delimited block -
#: en/modules/reference/pages/command-line-tools.adoc:17
#, no-wrap
msgid "zypper in <CLI_TOOL_NAME>\n"
msgstr "zypper in <CLI_TOOL_NAME>\n"

#. type: Title ==
#: en/modules/reference/pages/configuration/config-channels.adoc:1
#: en/modules/reference/pages/systems/ssm-overview.adoc:21
#, no-wrap
msgid "Channels"
msgstr "ຊ່ອງທາງ (Channels)"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-channels.adoc:2
msgid ""
"{productname} manages configuration files through two channel types: "
"[guimenu]``Config Channels`` and [guimenu]``State Channels``.  Config "
"Channels store managed configuration files.  State Channels use Salt states "
"and provide an editable [path]``init.sls`` file.  For more information about "
"custom states, see xref:specialized-guides:salt/salt-custom-states.adoc[]."
msgstr "{productname} ຈັດການໄຟລ໌ກຳນົດຄ່າຜ່ານຊ່ອງທາງສອງປະເພດຄື: [guimenu]``Config Channels`` ແລະ [guimenu]``State Channels``. Config Channels ໃຊ້ເພື່ອເກັບໄຟລ໌ກຳນົດຄ່າທີ່ຖືກຈັດການ. State Channels ໃຊ້ Salt states ແລະ ໃຫ້ໄຟລ໌ [path]``init.sls`` ທີ່ສາມາດແກ້ໄຂໄດ້. ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບ custom states, ເບິ່ງໄດ້ທີ່ xref:specialized-guides:salt/salt-custom-states.adoc[]."

#. type: Plain text
#: en/modules/reference/pages/configuration/config-channels.adoc:3
msgid ""
"Click the name of the configuration channel to see the details page for that "
"channel.  If you click the number of files in the channel, you are taken to "
"the [guimenu]``List/Remove Files`` page of that channel.  If you click the "
"number of systems subscribed to the configuration channel, you are taken to "
"the menu:Configuration Channel Details[Systems > Subscribed Systems] page "
"for that channel."
msgstr "ຄລິກໃສ່ຊື່ຂອງຊ່ອງທາງການກຳນົດຄ່າເພື່ອເບິ່ງໜ້າລາຍລະອຽດຂອງຊ່ອງທາງນັ້ນ. ຖ້າທ່ານຄລິກໃສ່ຈຳນວນໄຟລ໌ໃນຊ່ອງທາງ, ທ່ານຈະຖືກນຳໄປທີ່ໜ້າ [guimenu]``List/Remove Files`` ຂອງຊ່ອງທາງນັ້ນ. ຖ້າທ່ານຄລິກໃສ່ຈຳນວນລະບົບທີ່ລົງທະບຽນນຳໃຊ້ຊ່ອງທາງການກຳນົດຄ່າ, ທ່ານຈະຖືກນຳໄປທີ່ໜ້າ menu:Configuration Channel Details[Systems > Subscribed Systems] ສຳລັບຊ່ອງທາງນັ້ນ."

#. type: Title ==
#: en/modules/reference/pages/configuration/config-channels.adoc:4
#, no-wrap
msgid "Configuration Channel Details"
msgstr "ລາຍລະອຽດຊ່ອງທາງການກຳນົດຄ່າ"

#. type: Title =
#: en/modules/reference/pages/configuration/config-channels.adoc:5
#: en/modules/reference/pages/systems/ssm-overview.adoc:5
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:5
#: en/modules/reference/pages/systems/system-details/sd-overview.adoc:1
#, no-wrap
msgid "Overview"
msgstr "ພາບລວມ"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-channels.adoc:6
msgid ""
"The [guimenu]``Overview`` page of the [guimenu]``Configuration Channel "
"Details`` page is divided into several panels:"
msgstr "ໜ້າ [guimenu]``Overview`` ຂອງໜ້າ [guimenu]``Configuration Channel Details`` ແມ່ນຖືກແບ່ງອອກເປັນຫຼາຍແຜງ (panels):"

#. type: Labeled list
#: en/modules/reference/pages/configuration/config-channels.adoc:7
#, no-wrap
msgid "Channel Properties [Management]"
msgstr "ຄຸນສົມບັດຊ່ອງທາງ [ການຈັດການ]"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-channels.adoc:8
msgid ""
"Edit the name, label, and description of the channel by clicking btn:[Edit "
"Properties]."
msgstr "ແກ້ໄຂຊື່, ປ້າຍຊື່ (label) ແລະ ຄຳອະທິບາຍຂອງຊ່ອງທາງໂດຍການຄລິກ btn:[Edit Properties]."

#. type: Labeled list
#: en/modules/reference/pages/configuration/config-channels.adoc:9
#, no-wrap
msgid "Channel Information"
msgstr "ຂໍ້ມູນຊ່ອງທາງ"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-channels.adoc:10
msgid "Provides status information for the contents of the channel."
msgstr "ໃຫ້ຂໍ້ມູນສະຖານະສຳລັບເນື້ອຫາຂອງຊ່ອງທາງ."

#. type: Labeled list
#: en/modules/reference/pages/configuration/config-channels.adoc:11
#: en/modules/reference/pages/configuration/config-overview.adoc:9
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:11
#, no-wrap
msgid "Configuration Actions"
msgstr "ການດຳເນີນການກຳນົດຄ່າ"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-channels.adoc:12
msgid ""
"Provides access to the most common configuration tasks.  For Salt clients, "
"there is a link to edit the [path]``init.sls`` file."
msgstr "ໃຫ້ການເຂົ້າເຖິງວຽກງານການກຳນົດຄ່າທີ່ໃຊ້ເລື້ອຍໆ. ສຳລັບ Salt clients, ຈະມີລິ້ງເພື່ອແກ້ໄຂໄຟລ໌ [path]``init.sls``."

#. type: Plain text
#: en/modules/reference/pages/configuration/config-channels.adoc:13
msgid ""
"This panel allows you to deploy, compare, and add and create files.  Some "
"action are only availalble if you have files created and clients assigned to "
"configuration channels."
msgstr "ແຜງນີ້ຊ່ວຍໃຫ້ທ່ານສາມາດປັບໃຊ້ (deploy), ປຽບທຽບ, ເພີ່ມ ແລະ ສ້າງໄຟລ໌ໄດ້. ບາງການດຳເນີນການຈະສາມາດໃຊ້ໄດ້ກໍຕໍ່ເມື່ອທ່ານໄດ້ສ້າງໄຟລ໌ ແລະ ກຳນົດໄຄເອັນໃຫ້ກັບຊ່ອງທາງການກຳນົດຄ່າແລ້ວ."

#
#. Complete(?) list of:
#. Configuration Actions
#.     Deploy Files
#.     Deploy all configuration files to all subscribed systems
#.     Deploy selected configuration files to all subscribed systems
#.     Deploy all configuration files to selected subscribed systems
#.     Deploy selected configuration files to selected subscribed systems
#.     Compare Files
#.     Compare all files in channel to files on all subscribed systems
#.     Add/Create Files
#.     Create Configuration File or Directory
#.     Upload Configuration Files
#.     Import a File from Another Channel or System
#. type: Labeled list
#: en/modules/reference/pages/configuration/config-channels.adoc:14
#, no-wrap
msgid "List/Remove Files"
msgstr "ລາຍການ/ລຶບ ໄຟລ໌"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-channels.adoc:15
msgid ""
"This page only appears if there are files in the configuration channel.  You "
"can remove files or copy the latest versions into other configuration "
"channels.  Check the box next to files you want to manipulate, then click "
"the action button at the bottom."
msgstr "ໜ້ານີ້ຈະປາກົດຂຶ້ນກໍຕໍ່ເມື່ອມີໄຟລ໌ຢູ່ໃນຊ່ອງທາງການກຳນົດຄ່າເທົ່ານັ້ນ. ທ່ານສາມາດລຶບໄຟລ໌ ຫຼື ສຳເນົາເວີຊັນຫຼ້າສຸດໄປໃສ່ຊ່ອງທາງການກຳນົດຄ່າອື່ນໆໄດ້. ໝາຍຕິກໃສ່ຫ້ອງຂ້າງໆໄຟລ໌ທີ່ທ່ານຕ້ອງການຈັດການ, ແລ້ວຄລິກປຸ່ມການດຳເນີນການຢູ່ທາງລຸ່ມ."

#. type: Labeled list
#: en/modules/reference/pages/configuration/config-channels.adoc:16
#, no-wrap
msgid "Add Files"
msgstr "ເພີ່ມໄຟລ໌"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-channels.adoc:17
msgid ""
"The [guimenu]``Add Files`` page has three subtabs of its own, which allow "
"you to [guimenu]``Upload``, [guimenu]``Import``, or [guimenu]``Create`` "
"configuration files to be included in the channel."
msgstr "ໜ້າ [guimenu]``Add Files`` ມີສາມແທັບຍ່ອຍຂອງມັນເອງ, ເຊິ່ງຊ່ວຍໃຫ້ທ່ານສາມາດ [guimenu]``Upload``, [guimenu]``Import``, ຫຼື [guimenu]``Create`` ໄຟລ໌ກຳນົດຄ່າເພື່ອລວມເຂົ້າໃນຊ່ອງທາງ."

#. type: Labeled list
#: en/modules/reference/pages/configuration/config-channels.adoc:18
#, no-wrap
msgid "Upload File"
msgstr "ອັບໂຫຼດໄຟລ໌"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-channels.adoc:19
msgid ""
"To upload a file into the configuration channel, browse for the file on your "
"local system, populate all fields, and click the btn:[Upload Configuration "
"File] button.  The [guimenu]``Filename/Path`` field is the absolute path "
"where the file will be deployed."
msgstr "ເພື່ອອັບໂຫຼດໄຟລ໌ເຂົ້າໃນຊ່ອງທາງການກຳນົດຄ່າ, ໃຫ້ເລືອກໄຟລ໌ໃນລະບົບທ້ອງຖິ່ນຂອງທ່ານ, ປ້ອນຂໍ້ມູນໃສ່ທຸກຊ່ອງ, ແລ້ວຄລິກປຸ່ມ btn:[Upload Configuration File]. ຊ່ອງ [guimenu]``Filename/Path`` ແມ່ນເສັ້ນທາງເຕັມ (absolute path) ທີ່ໄຟລ໌ຈະຖືກປັບໃຊ້."

#. type: Plain text
#: en/modules/reference/pages/configuration/config-channels.adoc:20
msgid ""
"You can set the [guimenu]``Ownership`` via the [guimenu]``user name`` and "
"[guimenu]``group name`` and the [guimenu]``Permissions`` of the file when it "
"is deployed."
msgstr "ທ່ານສາມາດກຳນົດ [guimenu]``Ownership`` ຜ່ານ [guimenu]``user name`` ແລະ [guimenu]``group name`` ລວມທັງ [guimenu]``Permissions`` ຂອງໄຟລ໌ໃນເວລາທີ່ມັນຖືກປັບໃຊ້."

#. type: Plain text
#: en/modules/reference/pages/configuration/config-channels.adoc:21
msgid ""
"If the client has SELinux enabled, you can configure [guimenu]``SELinux "
"contexts`` to enable the required file attributes (such as user, role, and "
"file type)."
msgstr "ຖ້າໄຄເອັນມີການເປີດໃຊ້ SELinux, ທ່ານສາມາດກຳນົດຄ່າ [guimenu]``SELinux contexts`` ເພື່ອເປີດໃຊ້ຄຸນລັກສະນະຂອງໄຟລ໌ທີ່ຈຳເປັນ (ເຊັ່ນ: user, role, ແລະ file type)."

#. type: Plain text
#: en/modules/reference/pages/configuration/config-channels.adoc:22
msgid ""
"You can use Jinja templating with grains or pillar data instead of legacy "
"macro delimiters."
msgstr "ທ່ານສາມາດໃຊ້ Jinja templating ກັບ grains ຫຼື pillar data ແທນທີ່ການໃຊ້ macro delimiters ແບບເກົ່າໄດ້."

#. type: Labeled list
#: en/modules/reference/pages/configuration/config-channels.adoc:23
#, no-wrap
msgid "Import Files"
msgstr "ນຳເຂົ້າໄຟລ໌"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-channels.adoc:24
msgid ""
"To import files from other configuration channels, check the box to the left "
"of any file you want to import.  Then click btn:[Import Configuration "
"Files]."
msgstr "ເພື່ອ້ອງການນຳເຂົ້າໄຟລ໌ຈາກຊ່ອງທາງການກຳນົດຄ່າອື່ນໆ, ໃຫ້ໝາຍຕິກໃສ່ຫ້ອງທາງດ້ານຊ້າຍຂອງໄຟລ໌ທີ່ຕ້ອງການ. ແລ້ວຄລິກ btn:[Import Configuration Files]."

#. type: Labeled list
#: en/modules/reference/pages/configuration/config-channels.adoc:25
#, no-wrap
msgid "Create File"
msgstr "ສ້າງໄຟລ໌"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-channels.adoc:26
msgid ""
"Create a configuration file, directory, or symbolic link to be included in "
"the configuration channel."
msgstr "ສ້າງໄຟລ໌ກຳນົດຄ່າ, ໄດເຣັກທໍຣີ ຫຼື symbolic link ເພື່ອລວມເຂົ້າໃນຊ່ອງທາງການກຳນົດຄ່າ."

#. type: Title ==
#: en/modules/reference/pages/configuration/config-channels.adoc:27
#: en/modules/reference/pages/systems/system-details/sd-configuration.adoc:16
#, no-wrap
msgid "Deploy Files"
msgstr "ປັບໃຊ້ໄຟລ໌"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-channels.adoc:28
msgid ""
"This page only appears when there are files in the channel and a system is "
"subscribed to the channel.  Deploy all files by clicking the btn:[Deploy All "
"Files] button or check selected files and click the btn:[Deploy Selected "
"Files] button.  Select to which systems the files should be applied.  All "
"systems subscribed to this channel are listed.  If you want to apply the "
"file to a different system, subscribe it to the channel first.  To deploy "
"the files, click btn:[Confirm & Deploy to Selected Systems]."
msgstr "ໜ້ານີ້ຈະປາກົດຂຶ້ນກໍຕໍ່ເມື່ອມີໄຟລ໌ໃນຊ່ອງທາງ ແລະ ມີລະບົບທີ່ລົງທະບຽນນຳໃຊ້ຊ່ອງທາງນັ້ນແລ້ວ. ປັບໃຊ້ໄຟລ໌ທັງໝົດໂດຍການຄລິກປຸ່ມ btn:[Deploy All Files] ຫຼື ໝາຍເລືອກໄຟລ໌ແລ້ວຄລິກປຸ່ມ btn:[Deploy Selected Files]. ເລືອກລະບົບທີ່ຕ້ອງການປັບໃຊ້ໄຟລ໌. ທຸກໆລະບົບທີ່ລົງທະບຽນນຳໃຊ້ຊ່ອງທາງນີ້ຈະຖືກສະແດງລາຍການອອກມາ. ຖ້າທ່ານຕ້ອງການປັບໃຊ້ໄຟລ໌ກັບລະບົບອື່ນ, ໃຫ້ລົງທະບຽນລະບົບນັ້ນເຂົ້າໃນຊ່ອງທາງກ່ອນ. ເພື່ອປັບໃຊ້ໄຟລ໌, ໃຫ້ຄລິກ btn:[Confirm & Deploy to Selected Systems]."

#. type: Title ==
#: en/modules/reference/pages/configuration/config-channels.adoc:29
#: en/modules/reference/pages/systems/ssm-overview.adoc:7
#: en/modules/reference/pages/users/user-details.adoc:10
#, no-wrap
msgid "Systems"
msgstr "ລະບົບ"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-channels.adoc:30
msgid "Manage systems subscribed to the configuration channel with two subtabs:"
msgstr "ຈັດການລະບົບທີ່ລົງທະບຽນນຳໃຊ້ຊ່ອງທາງການກຳນົດຄ່າດ້ວຍສອງແທັບຍ່ອຍ:"

#. type: Title ==
#: en/modules/reference/pages/configuration/config-channels.adoc:31
#: en/modules/reference/pages/software/channel-details.adoc:16
#, no-wrap
msgid "Subscribed Systems"
msgstr "ລະບົບທີ່ລົງທະບຽນນຳໃຊ້"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-channels.adoc:32
msgid ""
"All systems subscribed to the current channel are displayed.  Click the name "
"of a system to see the [guimenu]``System Details`` page.  To unsubscribe a "
"system from the configuration channel, check the box to the left of the "
"system name and click btn:[Unsubscribe systems]."
msgstr "ລະບົບທັງໝົດທີ່ລົງທະບຽນນຳໃຊ້ຊ່ອງທາງປັດຈຸບັນຈະຖືກສະແດງອອກມາ. ຄລິກໃສ່ຊື່ຂອງລະບົບເພື່ອເບິ່ງໜ້າ [guimenu]``System Details``. ເພື່ອຍົກເລີກການລົງທະບຽນລະບົບອອກຈາກຊ່ອງທາງການກຳນົດຄ່າ, ໃຫ້ໝາຍຕິກໃສ່ຫ້ອງທາງດ້ານຊ້າຍຂອງຊື່ລະບົບ ແລ້ວຄລິກ btn:[Unsubscribe systems]."

#. type: Title ==
#: en/modules/reference/pages/configuration/config-channels.adoc:33
#: en/modules/reference/pages/configuration/config-systems-target.adoc:1
#: en/modules/reference/pages/software/channel-details.adoc:19
#, no-wrap
msgid "Target Systems"
msgstr "ລະບົບເປົ້າໝາຍ"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-channels.adoc:34
msgid ""
"This subtab displays a list of systems enabled for configuration management "
"but not yet subscribed to the channel.  To add a system to the configuration "
"channel, check the box to the left of the system name and click "
"btn:[Subscribe systems]."
msgstr "ແທັບຍ່ອຍນີ້ສະແດງລາຍຊື່ລະບົບທີ່ເປີດໃຊ້ການຈັດການການກຳນົດຄ່າແລ້ວ ແຕ່ຍັງບໍ່ທັນໄດ້ລົງທະບຽນນຳໃຊ້ຊ່ອງທາງ. ເພື່ອເພີ່ມລະບົບເຂົ້າໃນຊ່ອງທາງການກຳນົດຄ່າ, ໃຫ້ໝາຍຕິກໃສ່ຫ້ອງທາງດ້ານຊ້າຍຂອງຊື່ລະບົບ ແລ້ວຄລິກ btn:[Subscribe systems]."

#. type: Title =
#: en/modules/reference/pages/configuration/config-files.adoc:1
#, no-wrap
msgid "Files"
msgstr "ໄຟລ໌"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-files.adoc:2
msgid ""
"This page lists the configuration files managed by {productname} through "
"configuration channels."
msgstr "ໜ້ານີ້ສະແດງລາຍຊື່ໄຟລ໌ກຳນົດຄ່າທີ່ຖືກຈັດການໂດຍ {productname} ຜ່ານຊ່ອງທາງການກຳນົດຄ່າ."

#. type: Block title
#: en/modules/reference/pages/configuration/config-files.adoc:3
#, no-wrap
msgid "Files Columns"
msgstr "ຄໍລຳຂອງໄຟລ໌"

#. type: Table
#: en/modules/reference/pages/configuration/config-files.adoc:4
#, no-wrap
msgid ""
"| Column                | Description\n"
"| Path                  | Absolute filename of the configuration file.\n"
"| Configuration Channel | Name of the configuration channel that contains "
"the file.\n"
"| Systems Subscribed    | Number of systems subscribed to the channel.\n"
msgstr ""
"| ຄໍລຳ                | ຄຳອະທິບາຍ\n"
"| Path                  | ເສັ້ນທາງເຕັມຂອງໄຟລ໌ກຳນົດຄ່າ.\n"
"| Configuration Channel | ຊື່ຂອງຊ່ອງທາງການກຳນົດຄ່າທີ່ມີໄຟລ໌ນັ້ນຢູ່.\n"
"| Systems Subscribed    | ຈຳນວນລະບົບທີ່ລົງທະບຽນນຳໃຊ້ຊ່ອງທາງ.\n"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-files.adoc:5
msgid ""
"Click the [guimenu]``Path`` of a file to see its [guimenu]``Details`` tab.  "
"Click the name of the [guimenu]``Configuration Channel`` to see the "
"[guimenu]``Overview`` tab of the channel.  Clicking [guimenu]``Systems "
"Subscribed`` shows all systems currently subscribed to the channel "
"containing that file."
msgstr "ຄລິກໃສ່ [guimenu]``Path`` ຂອງໄຟລ໌ເພື່ອເບິ່ງແທັບ [guimenu]``Details``. ຄລິກໃສ່ຊື່ຂອງ [guimenu]``Configuration Channel`` ເພື່ອເບິ່ງແທັບ [guimenu]``Overview`` ຂອງຊ່ອງທາງນັ້ນ. ການຄລິກ [guimenu]``Systems Subscribed`` ຈະສະແດງລະບົບທັງໝົດທີ່ລົງທະບຽນນຳໃຊ້ຊ່ອງທາງທີ່ມີໄຟລ໌ນັ້ນຢູ່."

#. type: delimited block =
#: en/modules/reference/pages/configuration/config-files.adoc:6
msgid ""
"By default, the maximum file size for configuration files is 128 KB "
"(131072 bytes).  {suse} supports a configuration file size up to 1 MB.  "
"Larger files are not guaranteed to work."
msgstr "ໂດຍຄ່າເລີ່ມຕົ້ນ, ຂະໜາດໄຟລ໌ສູງສຸດສຳລັບໄຟລ໌ກຳນົດຄ່າແມ່ນ 128 KB (131072 ໄບທ໌). {suse} ຮອງຮັບຂະໜາດໄຟລ໌ກຳນົດຄ່າສູງສຸດເຖິງ 1 MB. ໄຟລ໌ທີ່ມີຂະໜາດໃຫຍ່ກວ່ານີ້ບໍ່ຮັບປະກັນວ່າຈະສາມາດໃຊ້ງານໄດ້."

#. type: Plain text
#: en/modules/reference/pages/configuration/config-files.adoc:7
#, no-wrap
msgid ""
"# 2010-12-21 - ke: will \"rhn\" stay here? 2010-12-28 - kkaempf: \"rhn\" "
"will\n"
"    stay here. #\n"
msgstr ""

#. type: Plain text
#: en/modules/reference/pages/configuration/config-files.adoc:8
msgid ""
"The default maximum file size is set on the {productname} Server in these "
"files:"
msgstr "ຂະໜາດໄຟລ໌ສູງສຸດຄ່າເລີ່ມຕົ້ນຖືກກຳນົດໄວ້ໃນເຄື່ອງເຊີເວີ {productname} ໃນໄຟລ໌ເຫຼົ່ານີ້:"

#. type: delimited block -
#: en/modules/reference/pages/configuration/config-files.adoc:9
#, no-wrap
msgid ""
"# /usr/share/rhn/config-defaults/rhn_web.conf\n"
"web.maximum_config_file_size = 131072\n"
msgstr ""

#. type: delimited block -
#: en/modules/reference/pages/configuration/config-files.adoc:10
#, no-wrap
msgid ""
"# /usr/share/rhn/config-defaults/rhn_server.conf\n"
"maximum_config_file_size = 131072\n"
msgstr ""

#. type: Plain text
#: en/modules/reference/pages/configuration/config-files.adoc:11
msgid ""
"Copy these variables to [filename]``/etc/rhn/rhn.conf`` and edit them.  "
"Values are specified in bytes, for example:"
msgstr "ສຳເນົາຕົວແປເຫຼົ່ານີ້ໄປທີ່ [filename]``/etc/rhn/rhn.conf`` ແລ້ວແກ້ໄຂພວກມັນ. ຄ່າຕ່າງໆຖືກກຳນົດເປັນໄບທ໌, ຕົວຢ່າງ:"

#. type: delimited block -
#: en/modules/reference/pages/configuration/config-files.adoc:12
#, no-wrap
msgid ""
"# /etc/rhn/rhn.conf\n"
"web.maximum_config_file_size = 262144\n"
"server.maximum_config_file_size = 262144\n"
msgstr ""

#. type: Plain text
#: en/modules/reference/pages/configuration/config-files.adoc:13
msgid "Then restart [systemitem]``spacewalk``:"
msgstr "ຈາກນັ້ນ ຣີສະຕາດ [systemitem]``spacewalk``:"

#. type: delimited block -
#: en/modules/reference/pages/configuration/config-files.adoc:14
#, no-wrap
msgid "spacewalk-service restart\n"
msgstr "spacewalk-service restart\n"

#. type: Title =
#: en/modules/reference/pages/configuration/config-menu.adoc:1
#, no-wrap
msgid "Configuration Menu"
msgstr "ເມນູການກຳນົດຄ່າ"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-menu.adoc:2
msgid ""
"The [guimenu]``Configuration`` section provides access to features for "
"managing the configuration of {productname} clients."
msgstr "ພາກສ່ວນ [guimenu]``Configuration`` ໃຫ້ການເຂົ້າເຖິງຄຸນສົມບັດຕ່າງໆສຳລັບການຈັດການການກຳນົດຄ່າຂອງໄຄເອັນ {productname}."

#. type: delimited block =
#: en/modules/reference/pages/configuration/config-menu.adoc:3
msgid ""
"The [guimenu]``Configuration`` menu is only available if you are signed in "
"with a configuration administrator or {productname} administrator account."
msgstr "ເມນູ [guimenu]``Configuration`` ຈະສາມາດໃຊ້ໄດ້ກໍຕໍ່ເມື່ອທ່ານເຂົ້າສູ່ລະບົບດ້ວຍບັນຊີຜູ້ດູແລລະບົບການກຳນົດຄ່າ ຫຼື ຜູ້ດູແລລະບົບ {productname} ເທົ່ານັ້ນ."

#. type: Plain text
#: en/modules/reference/pages/configuration/config-menu.adoc:4
msgid "Within the configuration pages, you can:"
msgstr "ພາຍໃນໜ້າການກຳນົດຄ່າ, ທ່ານສາມາດ:"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-menu.adoc:5
msgid "manage clients using configuration files"
msgstr "ຈັດການໄຄເອັນໂດຍໃຊ້ໄຟລ໌ກຳນົດຄ່າ"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-menu.adoc:6
msgid "configure channels offering configuration files"
msgstr "ກຳນົດຄ່າຊ່ອງທາງທີ່ໃຫ້ບໍລິການໄຟລ໌ກຳນົດຄ່າ"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-menu.adoc:7
msgid "manage configuration files themselves"
msgstr "ຈັດການຕົວໄຟລ໌ກຳນົດຄ່າເອງ"

#. type: Title =
#: en/modules/reference/pages/configuration/config-overview.adoc:1
#, no-wrap
msgid "Configuration Overview"
msgstr "ພາບລວມການກຳນົດຄ່າ"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-overview.adoc:2
msgid ""
"The menu:Configuration[Overview] section is a dashboard that contains a "
"summary of the configuration files that are managed by your organization in "
"{productname}.  The overview summarizes managed systems, configuration "
"channels, and files stored in configuration channels."
msgstr "ພາກສ່ວນ menu:Configuration[Overview] ແມ່ນແດຊບອດທີ່ລວມເອົາບົດສະຫຼຸບຂອງໄຟລ໌ກຳນົດຄ່າທີ່ຖືກຈັດການໂດຍອົງກອນຂອງທ່ານໃນ {productname}. ພາບລວມນີ້ຈະສະຫຼຸບລະບົບທີ່ຖືກຈັດການ, ຊ່ອງທາງການກຳນົດຄ່າ, ແລະ ໄຟລ໌ທີ່ເກັບໄວ້ໃນຊ່ອງທາງການກຳນົດຄ່າ."

#. type: Plain text
#: en/modules/reference/pages/configuration/config-overview.adoc:3
msgid ""
"For more information about managing configuration files, see "
"xref:client-configuration:configuration-management.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການຈັດການໄຟລ໌ກຳນົດຄ່າ, ເບິ່ງໄດ້ທີ່ xref:client-configuration:configuration-management.adoc[]."

#. type: Labeled list
#: en/modules/reference/pages/configuration/config-overview.adoc:4
#, no-wrap
msgid "Configuration Summary"
msgstr "ບົດສະຫຼຸບການກຳນົດຄ່າ"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-overview.adoc:5
msgid ""
"Provides quick information about your configuration files.  Click the blue "
"text to the right to display:"
msgstr "ໃຫ້ຂໍ້ມູນແບບວ່ອງໄວກ່ຽວກັບໄຟລ໌ກຳນົດຄ່າຂອງທ່ານ. ຄລິກຂໍ້ຄວາມສີຟ້າທາງດ້ານຂວາເພື່ອສະແດງ:"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-overview.adoc:6
msgid "Systems with managed configuration files"
msgstr "ລະບົບທີ່ມີໄຟລ໌ກຳນົດຄ່າທີ່ຖືກຈັດການ"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-overview.adoc:7
msgid "Configuration channels"
msgstr "ຊ່ອງທາງການກຳນົດຄ່າ"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-overview.adoc:8
msgid "Managed configuration files"
msgstr "ໄຟລ໌ກຳນົດຄ່າທີ່ຖືກຈັດການ"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-overview.adoc:10
msgid ""
"[guimenu]``Configuration Actions`` offers direct access to the most common "
"configuration management tasks:"
msgstr "[guimenu]``Configuration Actions`` ໃຫ້ການເຂົ້າເຖິງໂດຍກົງກັບວຽກງານການຈັດການການກຳນົດຄ່າທີ່ໃຊ້ເລື້ອຍໆ:"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-overview.adoc:11
msgid "View clients with managed configuration files"
msgstr "ເບິ່ງໄຄເອັນທີ່ມີໄຟລ໌ກຳນົດຄ່າທີ່ຖືກຈັດການ"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-overview.adoc:12
msgid "View all managed configuration files"
msgstr "ເບິ່ງໄຟລ໌ກຳນົດຄ່າທີ່ຖືກຈັດການທັງໝົດ"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-overview.adoc:13
msgid "View all managed configuration channels"
msgstr "ເບິ່ງຊ່ອງທາງການກຳນົດຄ່າທີ່ຖືກຈັດການທັງໝົດ"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-overview.adoc:14
msgid "Create a new configuration or state channel"
msgstr "ສ້າງຊ່ອງທາງການກຳນົດຄ່າ ຫຼື ຊ່ອງທາງສະຖານະໃໝ່"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-overview.adoc:15
msgid "Enable configuration management on clients"
msgstr "ເປີດໃຊ້ການຈັດການການກຳນົດຄ່າໃນໄຄເອັນ"

#. type: Labeled list
#: en/modules/reference/pages/configuration/config-overview.adoc:16
#, no-wrap
msgid "Recently Modified Configuration Files"
msgstr "ໄຟລ໌ກຳນົດຄ່າທີ່ຖືກແກ້ໄຂເມື່ອບໍ່ດົນມານີ້"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-overview.adoc:17
msgid ""
"The list shows which files have changed when and to which channel they "
"belong.  If no files have been changed, no list appears."
msgstr "ລາຍການນີ້ສະແດງວ່າໄຟລ໌ໃດຖືກປ່ຽນແປງເມື່ອໃດ ແລະ ຢູ່ໃນຊ່ອງທາງໃດ. ຖ້າບໍ່ມີໄຟລ໌ໃດຖືກປ່ຽນແປງ, ກໍຈະບໍ່ມີລາຍການສະແດງອອກມາ."

#. type: Block title
#: en/modules/reference/pages/configuration/config-overview.adoc:18
#, no-wrap
msgid "Recently Modified Configuration Files Columns"
msgstr "ຄໍລຳຂອງໄຟລ໌ກຳນົດຄ່າທີ່ຖືກແກ້ໄຂເມື່ອບໍ່ດົນມານີ້"

#. type: Table
#: en/modules/reference/pages/configuration/config-overview.adoc:19
#, no-wrap
msgid ""
"| Column               | Description\n"
"| Filename \t       | Absolute filename of the configuration file.\n"
"| Configuration Channel | Name of the configuration channel.\n"
"| Modified              | The time and date the file was modified.\n"
msgstr ""
"| ຄໍລຳ               | ຄຳອະທິບາຍ\n"
"| Filename \t       | ເສັ້ນທາງເຕັມຂອງໄຟລ໌ກຳນົດຄ່າ.\n"
"| Configuration Channel | ຊື່ຂອງຊ່ອງທາງການກຳນົດຄ່າ.\n"
"| Modified              | ເວລາ ແລະ ວັນທີທີ່ໄຟລ໌ຖືກແກ້ໄຂ.\n"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-overview.adoc:20
msgid ""
"Click the name of a file to see its [guimenu]``Details`` page.  Click the "
"channel name to see its [guimenu]``Channel Details`` page."
msgstr "ຄລິກໃສ່ຊື່ຂອງໄຟລ໌ເພື່ອເບິ່ງໜ້າ [guimenu]``Details``. ຄລິກໃສ່ຊື່ຊ່ອງທາງເພື່ອເບິ່ງໜ້າ [guimenu]``Channel Details``."

#. type: Labeled list
#: en/modules/reference/pages/configuration/config-overview.adoc:21
#, no-wrap
msgid "Recently Scheduled Configuration File Deployments"
msgstr "ການປັບໃຊ້ໄຟລ໌ກຳນົດຄ່າທີ່ຖືກຕັ້ງເວລາໄວ້ເມື່ອບໍ່ດົນມານີ້"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-overview.adoc:22
msgid ""
"Each scheduled action is listed along with the status of the action.  Any "
"scheduled configuration task, from enabling configuration management on a "
"system to deploying a specific configuration file, is displayed.  Here you "
"can quickly assess if all tasks have been successfully carried out or fix "
"any problems."
msgstr "ແຕ່ລະການດຳເນີນການທີ່ຖືກຕັ້ງເວລາໄວ້ຈະຖືກສະແດງພ້ອມກັບສະຖານະ. ທຸກໆວຽກງານການກຳນົດຄ່າທີ່ຖືກຕັ້ງເວລາໄວ້, ຕັ້ງແຕ່ການເປີດໃຊ້ການຈັດການການກຳນົດຄ່າໃນລະບົບ ໄປຈົນເຖິງການປັບໃຊ້ໄຟລ໌ກຳນົດຄ່າສະເພາະໃດໜຶ່ງ, ຈະຖືກສະແດງອອກມາ. ຢູ່ບ່ອນນີ້ທ່ານສາມາດປະເມີນໄດ້ຢ່າງວ່ອງໄວວ່າທຸກວຽກງານໄດ້ຖືກປະຕິບັດສຳເລັດແລ້ວ ຫຼື ບໍ່, ຫຼື ເພື່ອແກ້ໄຂບັນຫາຕ່າງໆ."

#. type: Block title
#: en/modules/reference/pages/configuration/config-overview.adoc:23
#, no-wrap
msgid "Scheduled Configuration File Deployments Columns"
msgstr "ຄໍລຳຂອງການປັບໃຊ້ໄຟລ໌ກຳນົດຄ່າທີ່ຖືກຕັ້ງເວລາໄວ້"

#. type: Table
#: en/modules/reference/pages/configuration/config-overview.adoc:24
#, no-wrap
msgid ""
"| Column               | Description\n"
"| System\t       | Host name of the system where you want to deploy the "
"configuration file.\n"
"| Files to be Deployed | Number of files to be deployed.\n"
"| Scheduled By\t       | The user who scheduled the job.\n"
"| Scheduled For\t       | The time and date the file deployment will "
"happen.\n"
"| Status    \t       | Status of the deployment: ``Queued``\n"
msgstr ""
"| ຄໍລຳ               | ຄຳອະທິບາຍ\n"
"| System\t       | ຊື່ໂຮສ (Host name) ຂອງລະບົບທີ່ທ່ານຕ້ອງການປັບໃຊ້ໄຟລ໌ກຳນົດຄ່າ.\n"
"| Files to be Deployed | ຈຳນວນໄຟລ໌ທີ່ຈະຖືກປັບໃຊ້.\n"
"| Scheduled By\t       | ຜູ້ໃຊ້ທີ່ເປັນຄົນຕັ້ງເວລາ.\n"
"| Scheduled For\t       | ເວລາ ແລະ ວັນທີທີ່ການປັບໃຊ້ໄຟລ໌ຈະເກີດຂຶ້ນ.\n"
"| Status    \t       | ສະຖານະຂອງການປັບໃຊ້: ``Queued`` (ຢູ່ໃນຄິວ)\n"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-overview.adoc:25
msgid ""
"Clicking the blue status text displays the menu:System Details[Schedule] "
"page for the specified system."
msgstr "ການຄລິກຂໍ້ຄວາມສະຖານະສີຟ້າຈະສະແດງໜ້າ menu:System Details[Schedule] ສຳລັບລະບົບທີ່ລະບຸໄວ້."

#. type: Title =
#: en/modules/reference/pages/configuration/config-systems-managed.adoc:1
#, no-wrap
msgid "Managed Systems"
msgstr "ລະບົບທີ່ຖືກຈັດການ"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-systems-managed.adoc:2
msgid ""
"By default the [guimenu]``Managed Systems`` page is displayed.  The listed "
"systems have been fully prepared for configuration file deployment.  The "
"page shows systems with managed configuration files and channel "
"subscriptions."
msgstr "ໂດຍຄ່າເລີ່ມຕົ້ນ ໜ້າ [guimenu]``Managed Systems`` ຈະຖືກສະແດງອອກມາ. ລະບົບທີ່ຢູ່ໃນລາຍການແມ່ນໄດ້ຖືກກຽມພ້ອມຢ່າງເຕັມທີ່ສຳລັບການປັບໃຊ້ໄຟລ໌ກຳນົດຄ່າ. ໜ້ານີ້ຈະສະແດງລະບົບທີ່ມີໄຟລ໌ກຳນົດຄ່າທີ່ຖືກຈັດການ ແລະ ການລົງທະບຽນນຳໃຊ້ຊ່ອງທາງ."

#. type: Plain text
#: en/modules/reference/pages/configuration/config-systems-managed.adoc:3
msgid ""
"Click the name of a system to show the relevant menu:System "
"Details[Configuration > Overview] page."
msgstr "ຄລິກໃສ່ຊື່ຂອງລະບົບເພື່ອສະແດງໜ້າ menu:System Details[Configuration > Overview] ທີ່ກ່ຽວຂ້ອງ."

#. type: Title =
#: en/modules/reference/pages/configuration/config-systems-menu.adoc:1
#: en/modules/reference/pages/systems/systems-menu.adoc:1
#, no-wrap
msgid "Systems Menu"
msgstr "ເມນູລະບົບ"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-systems-menu.adoc:2
msgid ""
"Displays status information about your system in relation to configuration.  "
"There are two sub-pages: [guimenu]``Managed Systems`` and [guimenu]``Target "
"Systems``."
msgstr "ສະແດງຂໍ້ມູນສະຖານະກ່ຽວກັບລະບົບຂອງທ່ານໃນສ່ວນທີ່ກ່ຽວຂ້ອງກັບການກຳນົດຄ່າ. ມີສອງໜ້າຍ່ອຍຄື: [guimenu]``Managed Systems`` ແລະ [guimenu]``Target Systems``."

#. type: Plain text
#: en/modules/reference/pages/configuration/config-systems-target.adoc:2
msgid ""
"This page shows the systems that are not prepared for configuration file "
"deployment, or are not yet subscribed to a configuration channel."
msgstr "ໜ້ານີ້ສະແດງລະບົບທີ່ຍັງບໍ່ທັນໄດ້ກຽມພ້ອມສຳລັບການປັບໃຊ້ໄຟລ໌ກຳນົດຄ່າ, ຫຼື ຍັງບໍ່ທັນໄດ້ລົງທະບຽນນຳໃຊ້ຊ່ອງທາງການກຳນົດຄ່າ."

#. type: Plain text
#: en/modules/reference/pages/configuration/config-systems-target.adoc:3
msgid "The table has three columns:"
msgstr "ຕາຕະລາງມີສາມຄໍລຳ:"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-systems-target.adoc:4
msgid "The system name"
msgstr "ຊື່ລະບົບ"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-systems-target.adoc:5
msgid "If the system is prepared for configuration file deployment"
msgstr "ສະຖານະວ່າລະບົບກຽມພ້ອມສຳລັບການປັບໃຊ້ໄຟລ໌ກຳນົດຄ່າແລ້ວຫຼືບໍ່"

#. type: Plain text
#: en/modules/reference/pages/configuration/config-systems-target.adoc:6
msgid "The steps necessary to prepare the system."
msgstr "ຂັ້ນຕອນທີ່ຈຳເປັນໃນການກຽມລະບົບ."

#. type: Plain text
#: en/modules/reference/pages/configuration/config-systems-target.adoc:7
msgid ""
"To prepare a system, check the box to the left of the profile name then "
"click the btn:[Enable {productname} Configuration Management] button.  All "
"of the preparatory steps that can be automatically performed are scheduled "
"by {productname}."
msgstr "ເພື່ອ້ອງການກຽມລະບົບ, ໃຫ້ໝາຍຕິກໃສ່ຫ້ອງທາງດ້ານຊ້າຍຂອງຊື່ໂປຣໄຟລ໌ ແລ້ວຄລິກປຸ່ມ btn:[Enable {productname} Configuration Management]. ຂັ້ນຕອນການກຽມການທັງໝົດທີ່ສາມາດເຮັດໄດ້ໂດຍອັດຕະໂນມັດຈະຖືກຕັ້ງເວລາໂດຍ {productname}."

#. type: delimited block =
#: en/modules/reference/pages/configuration/config-systems-target.adoc:8
msgid ""
"You will need to perform some manual tasks to enable configuration file "
"deployment.  Follow the on-screen instructions provided to assist with each "
"step."
msgstr "ທ່ານຈະຕ້ອງໄດ້ປະຕິບັດບາງວຽກງານດ້ວຍຕົນເອງເພື່ອເປີດໃຊ້ການປັບໃຊ້ໄຟລ໌ກຳນົດຄ່າ. ໃຫ້ປະຕິບັດຕາມຄຳແນະນຳເທິງໜ້າຈໍທີ່ໃຫ້ໄວ້ເພື່ອຊ່ວຍໃນແຕ່ລະຂັ້ນຕອນ."

#. type: Title =
#: en/modules/reference/pages/help/api-faq.adoc:1
#, no-wrap
msgid "API FAQ"
msgstr "ຄຳຖາມທີ່ພົບເລື້ອຍ (FAQ) ກ່ຽວກັບ API"

#. type: Plain text
#: en/modules/reference/pages/help/api-faq.adoc:2
msgid ""
"The menu:Help[API > FAQ] section contains frequently asked questions related "
"to {productname} APIs."
msgstr "ພາກສ່ວນ menu:Help[API > FAQ] ລວມມີຄຳຖາມທີ່ພົບເລື້ອຍທີ່ກ່ຽວຂ້ອງກັບ API ຂອງ {productname}."

#. type: Plain text
#: en/modules/reference/pages/help/api-faq.adoc:3
msgid ""
"See: "
"https://documentation.suse.com/multi-linux-manager/{productnumber}/api/docs/api/faqs.html"
msgstr "ເບິ່ງ: https://documentation.suse.com/multi-linux-manager/{productnumber}/api/docs/api/faqs.html"

#. type: Title =
#: en/modules/reference/pages/help/api-menu.adoc:1
#, no-wrap
msgid "API Menu"
msgstr "ເມນູ API"

#. type: Plain text
#: en/modules/reference/pages/help/api-menu.adoc:2
msgid ""
"The menu:Help[API] section contains links to the available API calls, and "
"includes an API FAQ and sample scripts."
msgstr "ພາກສ່ວນ menu:Help[API] ມີລິ້ງສຳລັບການເອີ້ນໃຊ້ API ທີ່ມີໃຫ້, ລວມທັງ FAQ ຂອງ API ແລະ ຕົວຢ່າງສະຄຣິບ."

#. type: Title =
#: en/modules/reference/pages/help/api-overview.adoc:1
#, no-wrap
msgid "API Overview"
msgstr "ພາບລວມ API"

#. type: Plain text
#: en/modules/reference/pages/help/api-overview.adoc:2
msgid ""
"The menu:Help[API > Overview] section provides a list of available API "
"calls.  Click the name of an API call to see the relevant documentation."
msgstr "ພາກສ່ວນ menu:Help[API > Overview] ສະແດງລາຍຊື່ການເອີ້ນໃຊ້ API ທີ່ມີຢູ່. ຄລິກໃສ່ຊື່ຂອງ API ທີ່ຕ້ອງການເພື່ອເບິ່ງເອກະສານທີ່ກ່ຽວຂ້ອງ."

#. type: Plain text
#: en/modules/reference/pages/help/api-overview.adoc:3
msgid ""
"For the full API documentation, see "
"https://documentation.suse.com/multi-linux-manager/{productnumber}/api/docs/index.html[API "
"Documentation]."
msgstr "ສຳລັບເອກະສານ API ສະບັບເຕັມ, ເບິ່ງໄດ້ທີ່ https://documentation.suse.com/multi-linux-manager/{productnumber}/api/docs/index.html[API Documentation]."

#. type: Title =
#: en/modules/reference/pages/help/api-sample-scripts.adoc:1
#, no-wrap
msgid "API Sample Scripts"
msgstr "ຕົວຢ່າງສະຄຣິບ API"

#. type: Plain text
#: en/modules/reference/pages/help/api-sample-scripts.adoc:2
msgid ""
"The menu:Help:[API > Sample Scripts] section contains example API calls for "
"you to copy.  The scripts are written in Ruby, Perl, and Python."
msgstr "ພາກສ່ວນ menu:Help:[API > Sample Scripts] ມີຕົວຢ່າງການເອີ້ນໃຊ້ API ໃຫ້ທ່ານສຳເນົາໄປໃຊ້. ສະຄຣິບເຫຼົ່ານີ້ຖືກຂຽນດ້ວຍພາສາ Ruby, Perl, ແລະ Python."

#. type: Plain text
#: en/modules/reference/pages/help/api-sample-scripts.adoc:3
msgid ""
"See: "
"https://documentation.suse.com/multi-linux-manager/{productnumber}/api/docs/api/scripts.html"
msgstr "ເບິ່ງ: https://documentation.suse.com/multi-linux-manager/{productnumber}/api/docs/api/scripts.html"

#. type: Plain text
#: en/modules/reference/pages/help/api-sample-scripts.adoc:4
msgid "See: https://www.uyuni-project.org/uyuni-docs-api/uyuni/api/scripts.html"
msgstr "ເບິ່ງ: https://www.uyuni-project.org/uyuni-docs-api/uyuni/api/scripts.html"

#. type: Title =
#: en/modules/reference/pages/help/documentation-version.adoc:1
#, no-wrap
msgid "Documentation"
msgstr "ເອກະສານ"

#. type: Plain text
#: en/modules/reference/pages/help/documentation-version.adoc:2
msgid ""
"The menu:Help[Documentation {productnumber}] section opens the current "
"version of the {productname} documentation in a new browser tab.  This is "
"the documentation installed locally on your {productname} Server."
msgstr "ພາກສ່ວນ menu:Help[Documentation {productnumber}] ຈະເປີດເອກະສານ {productname} ເວີຊັນປັດຈຸບັນໃນແທັບບຣາວເຊີໃໝ່. ນີ້ແມ່ນເອກະສານທີ່ຖືກຕິດຕັ້ງໄວ້ໃນເຄື່ອງເຊີເວີ {productname} ຂອງທ່ານ."

#. type: Plain text
#: en/modules/reference/pages/help/documentation-version.adoc:3
msgid ""
"For all versions and formats of the {susemgr} documentation, including API "
"documentation, see https://documentation.suse.com/multi-linux-manager/."
msgstr "ສຳລັບເອກະສານ {susemgr} ທຸກເວີຊັນ ແລະ ທຸກຮູບແບບ, ລວມທັງເອກະສານ API, ເບິ່ງໄດ້ທີ່ https://documentation.suse.com/multi-linux-manager/."

#. type: Plain text
#: en/modules/reference/pages/help/documentation-version.adoc:4
msgid ""
"For all versions and formats of the {uyuni} documentation, see "
"https://www.uyuni-project.org/uyuni-docs/index.html."
msgstr "ສຳລັບເອກະສານ {uyuni} ທຸກເວີຊັນ ແລະ ທຸກຮູບແບບ, ເບິ່ງໄດ້ທີ່ https://www.uyuni-project.org/uyuni-docs/index.html."

#. type: Title =
#: en/modules/reference/pages/help/help-menu.adoc:1
#, no-wrap
msgid "Help Menu"
msgstr "ເມນູຊ່ວຍເຫຼືອ"

#. type: Plain text
#: en/modules/reference/pages/help/help-menu.adoc:2
msgid ""
"The [guimenu]``Help`` section opens the current version of the {productname} "
"documentation in a new browser tab.  This is the documentation installed "
"locally on your {productname} Server."
msgstr "ພາກສ່ວນ [guimenu]``Help`` ຈະເປີດເອກະສານ {productname} ເວີຊັນປັດຈຸບັນໃນແທັບບຣາວເຊີໃໝ່. ນີ້ແມ່ນເອກະສານທີ່ຖືກຕິດຕັ້ງໄວ້ໃນເຄື່ອງເຊີເວີ {productname} ຂອງທ່ານ."

#. type: Plain text
#: en/modules/reference/pages/help/help-menu.adoc:3
msgid ""
"For all versions and formats of the {productname} documentation, see "
"https://documentation.suse.com/multi-linux-manager/"
msgstr "ສຳລັບເອກະສານ {productname} ທຸກເວີຊັນ ແລະ ທຸກຮູບແບບ, ເບິ່ງໄດ້ທີ່ https://documentation.suse.com/multi-linux-manager/"

#. type: Plain text
#: en/modules/reference/pages/help/help-menu.adoc:4
