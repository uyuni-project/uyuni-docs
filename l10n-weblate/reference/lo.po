#. type: Title ==
#: en/modules/reference/pages/spacecmd/repo.adoc:35
#, no-wrap
msgid "repo_updatessl"
msgstr "repo_updatessl"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/repo.adoc:36
msgid "Change the SSL certificates of a user repository."
msgstr "ປ່ຽນໃບຢັ້ງຢືນ SSL ຂອງເຣໂປຊິທໍຣີຂອງຜູ້ໃຊ້."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/repo.adoc:37
#, no-wrap
msgid ""
"usage: repo_updatessl <options>\n"
"options:\n"
"  --ca         SSL CA certificate (not required)\n"
"  --cert       SSL Client certificate (not required)\n"
"  --key        SSL Client key (not required)\n"
msgstr ""
"ວິທີໃຊ້: repo_updatessl <options>\n"
"ຕົວເລືອກ:\n"
"  --ca         ໃບຢັ້ງຢືນ SSL CA (ບໍ່ບັງຄັບ)\n"
"  --cert       ໃບຢັ້ງຢືນ SSL Client (ບໍ່ບັງຄັບ)\n"
"  --key        ຄີ SSL Client (ບໍ່ບັງຄັບ)\n"

