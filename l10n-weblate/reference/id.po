#. type: Title ==
#: en/modules/reference/pages/spacecmd/configchannel.adoc:31
#, no-wrap
msgid "configchannel_export"
msgstr "configchannel_export"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:32
msgid "Export configuration channels to a json formatted file."
msgstr "Ekspor saluran konfigurasi ke berkas berformat JSON."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:33
#, no-wrap
msgid ""
"usage: configchannel_export <CHANNEL>... [options]\n"
"options:\n"
"    -f outfile.json : specify an output filename, defaults to "
"<CHANNEL>.json\n"
"                      if exporting a single channel, ccs.json for multiple\n"
"                      channels, or cc_all.json if no CHANNEL specified\n"
"                      e.g (export ALL)\n"
msgstr ""
"penggunaan: configchannel_export <CHANNEL>... [options]\n"
"opsi:\n"
"    -f outfile.json : tentukan nama berkas keluaran, nilai bawaannya adalah <CHANNEL>.json\n"
"                      jika mengekspor satu saluran, ccs.json untuk beberapa\n"
"                      saluran, atau cc_all.json jika CHANNEL tidak ditentukan\n"
"                      misalnya (ekspor SEMUA)\n"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:34
msgid "Note : CHANNEL list is optional, default is to export ALL"
msgstr "Catatan : Daftar CHANNEL bersifat opsional, secara bawaan SEMUA saluran diekspor"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/configchannel.adoc:35
