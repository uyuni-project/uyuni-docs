#. type: Title =
#: en/modules/reference/pages/spacecmd/configchannel.adoc:1
#, no-wrap
msgid "configchannel"
msgstr "configchannel"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:2
msgid ""
"The following spacecmd commands are available for use with configuration "
"channels."
msgstr "Perintah spacecmd berikut tersedia untuk digunakan dengan saluran konfigurasi."

#. type: Title ==
#: en/modules/reference/pages/spacecmd/configchannel.adoc:3
#, no-wrap
msgid "configchannel_addfile"
msgstr "configchannel_addfile"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:4
msgid "Creates a configuration file."
msgstr "Buat berkas konfigurasi."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:5
msgid "usage: configchannel_addfile [CHANNEL] [options]"
msgstr "penggunaan: configchannel_addfile [CHANNEL] [options]"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:6
#, no-wrap
msgid ""
"options:\n"
"  -c CHANNEL\n"
"  -p PATH\n"
"  -r REVISION\n"
msgstr ""
"opsi:\n"
"  -c CHANNEL\n"
"  -p PATH\n"
"  -r REVISION\n"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:7
#, no-wrap
msgid "OWNER [default: root]\n"
msgstr "OWNER [default: root]\n"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:8
#, no-wrap
msgid ""
"-g GROUP [default: root]\n"
"-m MODE [defualt: 0644]\n"
"-x SELINUX_CONTEXT\n"
"-d path is a directory\n"
"-s path is a symlink\n"
"-b path is a binary (or other file which needs base64 encoding)\n"
"-t SYMLINK_TARGET\n"
"-f local path to file contents\n"
msgstr ""
"-g GROUP [default: root]\n"
"-m MODE [defualt: 0644]\n"
"-x SELINUX_CONTEXT\n"
"-d path merupakan direktori\n"
"-s path merupakan symlink\n"
"-b path merupakan berkas biner (atau berkas lain yang memerlukan pengodean base64)\n"
"-t SYMLINK_TARGET\n"
"-f path lokal ke isi berkas\n"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:9
msgid ""
"Note re binary/base64: Some text files, notably those containing trailing "
"newlines, those containing ASCII escape characters (or other charaters not "
"allowed in XML) need to be sent as binary (-b).  Some effort is made to "
"auto- detect files which require this, but you may need to explicitly "
"specify."
msgstr "Catatan tentang biner/base64: Beberapa berkas teks, terutama yang mengandung karakter baris baru di bagian akhir, karakter escape ASCII (atau karakter lain yang tidak diizinkan dalam XML), perlu dikirim sebagai berkas biner (-b).  Deteksi otomatis dilakukan untuk mengenali berkas yang memerlukan penanganan ini, tetapi Anda mungkin perlu menentukannya secara eksplisit."

#. type: Title ==
#: en/modules/reference/pages/spacecmd/configchannel.adoc:10
#, no-wrap
msgid "configchannel_backup"
msgstr "configchannel_backup"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:11
msgid "Backup a configuration channel."
msgstr "Cadangkan saluran konfigurasi."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:12
msgid "usage: configchannel_backup CHANNEL [OUTDIR]"
msgstr "penggunaan: configchannel_backup CHANNEL [OUTDIR]"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:13
msgid "OUTDIR defaults to $HOME/spacecmd-backup/configchannel/YYYY-MM-DD/CHANNEL"
msgstr "Nilai bawaan OUTDIR adalah $HOME/spacecmd-backup/configchannel/YYYY-MM-DD/CHANNEL"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/configchannel.adoc:14
#, no-wrap
msgid "configchannel_clone"
msgstr "configchannel_clone"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:15
msgid "Clone configuration channels."
msgstr "Kloning saluran konfigurasi."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:16
#, no-wrap
msgid ""
"usage examples:\n"
"                 configchannel_clone foo_label -c bar_label\n"
"                 configchannel_clone foo_label1 foo_label2 -c prefix\n"
"                 configchannel_clone foo_label -x \"s/foo/bar\"\n"
"                 configchannel_clone foo_label1 foo_label2 -x "
"\"s/foo/bar\"\n"
msgstr ""
"contoh penggunaan:\n"
"                 configchannel_clone foo_label -c bar_label\n"
"                 configchannel_clone foo_label1 foo_label2 -c prefix\n"
"                 configchannel_clone foo_label -x \"s/foo/bar\"\n"
"                 configchannel_clone foo_label1 foo_label2 -x \"s/foo/bar\"\n"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:17
#, no-wrap
msgid ""
"options:\n"
"  -c CLONE_LABEL : name/label of the resulting cc (note does not update\n"
"                   description, see -x option), treated as a prefix if\n"
"                   multiple keys are passed\n"
"  -x \"s/foo/bar\" : Optional regex replacement, replaces foo with bar in "
"the\n"
"                   clone name, label and description\n"
"  Note : If no -c or -x option is specified, interactive is assumed\n"
msgstr ""
"opsi:\n"
"  -c CLONE_LABEL : nama/label saluran konfigurasi hasil kloning (perhatikan bahwa ini tidak memperbarui\n"
"                   deskripsi, lihat opsi -x), diperlakukan sebagai awalan jika\n"
"                   beberapa kunci diteruskan\n"
"  -x \"s/foo/bar\" : Penggantian regex opsional, mengganti foo dengan bar dalam\n"
"                   nama, label, dan deskripsi hasil kloning\n"
"  Catatan : Jika opsi -c atau -x tidak ditentukan, mode interaktif digunakan\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/configchannel.adoc:18
#, no-wrap
msgid "configchannel_create"
msgstr "configchannel_create"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/configchannel.adoc:19
