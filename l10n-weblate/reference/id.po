#: en/modules/reference/pages/spacecmd/errata.adoc:31
msgid "errata_search CVE-2009:1674"
msgstr "errata_search CVE-2009:1674"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/errata.adoc:32
msgid "errata_search RHSA-2009:1674"
msgstr "errata_search RHSA-2009:1674"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/errata.adoc:33
#, no-wrap
msgid "errata_summary"
msgstr "errata_summary"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/errata.adoc:34
msgid "Print a summary of all errata."
msgstr "Tampilkan ringkasan semua errata."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/errata.adoc:35
msgid "usage: errata_summary"
msgstr "penggunaan: errata_summary"

