"search:QUERY (see 'help system_search')  group:GROUP channel:CHANNEL"
msgstr "<SYSTEMS> dapat berupa salah satu dari berikut: name ssm (lihat 'help ssm')  search:QUERY (lihat 'help system_search')  group:GROUP channel:CHANNEL"

