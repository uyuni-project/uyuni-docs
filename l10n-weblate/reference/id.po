#. type: Title =
#: en/modules/reference/pages/spacecmd/spacecmd-help.adoc:8
#, no-wrap
msgid "Miscellaneous help topics:"
msgstr "Topik bantuan lainnya:"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/spacecmd-help.adoc:9
msgid "time systems ssm"
msgstr "time systems ssm"

#. type: Title =
#: en/modules/reference/pages/spacecmd/spacecmd-history.adoc:1
#, no-wrap
msgid "history"
msgstr "history"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/spacecmd-history.adoc:2
msgid "List recent commands using the `history` command."
msgstr "Tampilkan daftar perintah terbaru menggunakan perintah `history`."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/spacecmd-history.adoc:3
#, no-wrap
msgid ""
"spacecmd {SSM:0}> history\n"
"   1  help\n"
"   2  api\n"
"   3  exit\n"
"   4  help\n"
"   5  time --help\n"
"   6  quit\n"
"   7  clear\n"
"spacecmd {SSM:0}>\n"
msgstr ""
"spacecmd {SSM:0}> history\n"
"   1  help\n"
"   2  api\n"
"   3  exit\n"
"   4  help\n"
"   5  time --help\n"
"   6  quit\n"
"   7  clear\n"
"spacecmd {SSM:0}>\n"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/ssm.adoc:2
msgid ""
"The following spacecmd functions are available for use with the system set "
"manager (SSM)."
msgstr "Fungsi spacecmd berikut tersedia untuk digunakan dengan pengelola kumpulan sistem (SSM)."

#. type: Title ==
#: en/modules/reference/pages/spacecmd/ssm.adoc:3
#, no-wrap
msgid "ssm_add"
msgstr "ssm_add"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/ssm.adoc:4
msgid "Add systems to the SSM."
msgstr "Tambahkan sistem ke SSM."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/ssm.adoc:5
#, no-wrap
msgid "usage: ssm_add <SYSTEMS>\n"
msgstr "penggunaan: ssm_add <SYSTEMS>\n"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/ssm.adoc:6
#: en/modules/reference/pages/spacecmd/ssm.adoc:14
#: en/modules/reference/pages/spacecmd/ssm.adoc:19
#: en/modules/reference/pages/spacecmd/ssm.adoc:23
#, no-wrap
msgid "see 'help ssm' for more details\n"
msgstr "lihat 'help ssm' untuk detail selengkapnya\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/ssm.adoc:8
#, no-wrap
msgid "ssm_clear"
msgstr "ssm_clear"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/ssm.adoc:9
msgid "Remove all systems from the SSM."
msgstr "Hapus semua sistem dari SSM."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/ssm.adoc:10
#, no-wrap
msgid "usage: ssm_clear\n"
msgstr "penggunaan: ssm_clear\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/ssm.adoc:11
#, no-wrap
msgid "ssm_intersect"
msgstr "ssm_intersect"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/ssm.adoc:12
msgid ""
"Replace the current SSM with the intersection of the current list of systems "
"and the list of systems passed as arguments."
msgstr "Ganti SSM saat ini dengan irisan antara daftar sistem saat ini dan daftar sistem yang diteruskan sebagai argumen."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/ssm.adoc:13
#, no-wrap
msgid "usage: ssm_intersect <SYSTEMS>\n"
msgstr "penggunaan: ssm_intersect <SYSTEMS>\n"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/ssm.adoc:15
#, no-wrap
msgid ""
"<SYSTEMS> can be any of the following:\n"
"name\n"
"ssm (see 'help ssm')\n"
"search:QUERY (see 'help system_search')\n"
"group:GROUP\n"
"channel:CHANNE\n"
msgstr ""
"<SYSTEMS> dapat berupa salah satu dari berikut:\n"
"name\n"
"ssm (lihat 'help ssm')\n"
"search:QUERY (lihat 'help system_search')\n"
"group:GROUP\n"
"channel:CHANNE\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/ssm.adoc:16
#, no-wrap
msgid "ssm_list"
msgstr "ssm_list"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/ssm.adoc:17
msgid "List the systems currently in the SSM."
msgstr "Tampilkan daftar sistem yang saat ini berada dalam SSM."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/ssm.adoc:18
#, no-wrap
msgid "usage: ssm_list\n"
msgstr "penggunaan: ssm_list\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/ssm.adoc:20
#, no-wrap
msgid "ssm_remove"
msgstr "ssm_remove"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/ssm.adoc:21
msgid "Remove systems from the SSM."
msgstr "Hapus sistem dari SSM."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/ssm.adoc:22
#, no-wrap
msgid "usage: ssm_remove <SYSTEMS>\n"
msgstr "penggunaan: ssm_remove <SYSTEMS>\n"

#. type: Title =
#: en/modules/reference/pages/spacecmd/system.adoc:1
#, no-wrap
msgid "system"
msgstr "system"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/system.adoc:2
msgid "The following spacecmd functions are available for use with systems."
msgstr "Fungsi spacecmd berikut tersedia untuk digunakan dengan sistem."

#. type: Title ==
#: en/modules/reference/pages/spacecmd/system.adoc:3
#, no-wrap
msgid "system_addchildchannels"
msgstr "system_addchildchannels"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/system.adoc:4
msgid "Add child channels to a system."
msgstr "Tambahkan saluran turunan ke sistem."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/system.adoc:5
#, no-wrap
msgid "usage: system_addchildchannels <SYSTEMS> <CHANNEL ...>\n"
msgstr "penggunaan: system_addchildchannels <SYSTEMS> <CHANNEL ...>\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/system.adoc:7
#, no-wrap
msgid "system_addconfigchannels"
msgstr "system_addconfigchannels"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/system.adoc:8
msgid "Add config channels to a system."
msgstr "Tambahkan saluran konfigurasi ke sistem."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/system.adoc:9
#, no-wrap
msgid "usage: system_addconfigchannels <SYSTEMS> <CHANNEL ...> [options]\n"
msgstr "penggunaan: system_addconfigchannels <SYSTEMS> <CHANNEL ...> [options]\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/system.adoc:12
#, no-wrap
msgid "system_addconfigfile"
msgstr "system_addconfigfile"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/system.adoc:13
msgid "Create a configuration file."
msgstr "Buat berkas konfigurasi."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/system.adoc:14
#, no-wrap
msgid ""
"Note this is only for system sandbox or locally-managed files\n"
"Centrally managed files should be created via configchannel_addfile\n"
"usage: system_addconfigfile [SYSTEM] [options]\n"
msgstr ""
"Perhatikan bahwa ini hanya untuk berkas dalam sandbox sistem atau berkas yang dikelola secara lokal\n"
"Berkas yang dikelola secara terpusat harus dibuat melalui configchannel_addfile\n"
"penggunaan: system_addconfigfile [SYSTEM] [options]\n"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/system.adoc:15
#, no-wrap
msgid ""
"options:\n"
"  -S/--sandbox : list only system-sandbox files\n"
"  -L/--local   : list only locally managed files\n"
"  -p PATH\n"
"  -r REVISION\n"
"  -o OWNER [default: root]\n"
"  -g GROUP [default: root]\n"
"  -m MODE [defualt: 0644]\n"
"  -x SELINUX_CONTEXT\n"
"  -d path is a directory\n"
"  -s path is a symlink\n"
"  -b path is a binary (or other file which needs base64 encoding)\n"
"  -t SYMLINK_TARGET\n"
"  -f local path to file contents\n"
msgstr ""
"opsi:\n"
"  -S/--sandbox : tampilkan hanya berkas dalam sandbox sistem\n"
"  -L/--local   : tampilkan hanya berkas yang dikelola secara lokal\n"
"  -p PATH\n"
"  -r REVISION\n"
"  -o OWNER [default: root]\n"
"  -g GROUP [default: root]\n"
"  -m MODE [defualt: 0644]\n"
"  -x SELINUX_CONTEXT\n"
"  -d path merupakan direktori\n"
"  -s path merupakan symlink\n"
"  -b path merupakan berkas biner (atau berkas lain yang memerlukan pengodean base64)\n"
"  -t SYMLINK_TARGET\n"
"  -f path lokal ke isi berkas\n"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/system.adoc:16
#, no-wrap
msgid ""
"  Note re binary/base64: Some text files, notably those containing "
"trailing\n"
"  newlines, those containing ASCII escape characters (or other charaters "
"not\n"
"  allowed in XML) need to be sent as binary (-b).  Some effort is made to "
"auto-\n"
"  detect files which require this, but you may need to explicitly specify.\n"
msgstr ""
"  Catatan tentang biner/base64: Beberapa berkas teks, terutama yang mengandung karakter\n"
"  baris baru di bagian akhir, karakter escape ASCII (atau karakter lain yang tidak\n"
"  diizinkan dalam XML), perlu dikirim sebagai berkas biner (-b).  Deteksi otomatis\n"
"  dilakukan untuk mengenali berkas yang memerlukan penanganan ini, tetapi Anda mungkin perlu menentukannya secara eksplisit.\n"

