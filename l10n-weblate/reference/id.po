#: en/modules/reference/pages/spacecmd/cryptokey.adoc:14
msgid "List all cryptographic keys (SSL, GPG)."
msgstr "Tampilkan daftar semua kunci kriptografi (SSL, GPG)."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/cryptokey.adoc:15
msgid "usage: cryptokey_list"
msgstr "penggunaan: cryptokey_list"

