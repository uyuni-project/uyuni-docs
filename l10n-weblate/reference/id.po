#. type: Title =
#: en/modules/reference/pages/spacecmd/distribution.adoc:1
#, no-wrap
msgid "distribution"
msgstr "distribution"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/distribution.adoc:2
msgid ""
"The following spacecmd commands are available for working with kickstart "
"distributions."
msgstr "Perintah spacecmd berikut tersedia untuk mengelola distribusi kickstart."

#. type: Title ==
#: en/modules/reference/pages/spacecmd/distribution.adoc:3
#, no-wrap
msgid "distribution_create"
msgstr "distribution_create"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/distribution.adoc:4
msgid "Create a Kickstart tree."
msgstr "Buat pohon direktori Kickstart."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/distribution.adoc:5
msgid "usage: distribution_create [options]"
msgstr "penggunaan: distribution_create [options]"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/distribution.adoc:6
#, no-wrap
msgid ""
"options:\n"
"  -n NAME\n"
"  -p path to tree\n"
"  -b base channel to associate with\n"
"  -t install type [fedora|rhel_4/5/6|suse|generic_rpm]\n"
msgstr ""
"opsi:\n"
"  -n NAME\n"
"  -p path ke pohon direktori\n"
"  -b saluran dasar yang akan dikaitkan\n"
"  -t jenis instalasi [fedora|rhel_4/5/6|suse|generic_rpm]\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/distribution.adoc:7
#, no-wrap
msgid "distribution_delete"
msgstr "distribution_delete"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/distribution.adoc:8
msgid "Delete a Kickstart tree."
msgstr "Hapus pohon direktori Kickstart."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/distribution.adoc:9
msgid "usage: distribution_delete LABEL"
msgstr "penggunaan: distribution_delete LABEL"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/distribution.adoc:10
#, no-wrap
msgid "distribution_details"
msgstr "distribution_details"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/distribution.adoc:11
msgid "Show the details of a Kickstart tree."
msgstr "Tampilkan detail pohon direktori Kickstart."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/distribution.adoc:12
msgid "usage: distribution_details LABEL"
msgstr "penggunaan: distribution_details LABEL"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/distribution.adoc:13
#, no-wrap
msgid "distribution_list"
msgstr "distribution_list"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/distribution.adoc:14
msgid "List the available autoinstall trees."
msgstr "Tampilkan daftar pohon direktori instalasi otomatis yang tersedia."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/distribution.adoc:15
msgid "usage: distribution_list"
msgstr "penggunaan: distribution_list"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/distribution.adoc:16
#, no-wrap
msgid "distribution_rename"
msgstr "distribution_rename"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/distribution.adoc:17
msgid "Rename a Kickstart tree."
msgstr "Ganti nama pohon direktori Kickstart."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/distribution.adoc:18
msgid "usage: distribution_rename OLDNAME NEWNAME"
msgstr "penggunaan: distribution_rename OLDNAME NEWNAME"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/distribution.adoc:19
#, no-wrap
msgid "distribution_update"
msgstr "distribution_update"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/distribution.adoc:20
msgid "Update the path of a Kickstart tree."
msgstr "Perbarui path pohon direktori Kickstart."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/distribution.adoc:21
msgid "usage: distribution_update NAME [options]"
msgstr "penggunaan: distribution_update NAME [options]"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/distribution.adoc:22
#, no-wrap
msgid ""
"options:\n"
"  -p path to tree\n"
"  -b base channel to associate with\n"
"  -t install type [fedora|rhel_4/5/6|suse|generic_rpm]\n"
msgstr ""
"opsi:\n"
"  -p path ke pohon direktori\n"
"  -b saluran dasar yang akan dikaitkan\n"
"  -t jenis instalasi [fedora|rhel_4/5/6|suse|generic_rpm]\n"

#. type: Title =
#: en/modules/reference/pages/spacecmd/errata.adoc:1
#, no-wrap
msgid "errata"
msgstr "errata"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/errata.adoc:2
msgid "The following spacecmd commands are available for use with errata data."
msgstr "Perintah spacecmd berikut tersedia untuk digunakan dengan data errata."

#. type: Title ==
#: en/modules/reference/pages/spacecmd/errata.adoc:3
#, no-wrap
msgid "errata_apply"
msgstr "errata_apply"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/errata.adoc:4
msgid "Apply an patch to all affected systems."
msgstr "Terapkan patch ke semua sistem yang terdampak."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/errata.adoc:5
msgid "usage: errata_apply ERRATA|search:XXX ..."
msgstr "penggunaan: errata_apply ERRATA|search:XXX ..."

#. type: Title ==
#: en/modules/reference/pages/spacecmd/errata.adoc:6
#, no-wrap
msgid "errata_delete"
msgstr "errata_delete"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/errata.adoc:7
msgid "Delete an patch."
msgstr "Hapus patch."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/errata.adoc:8
msgid "usage: errata_delete ERRATA|search:XXX ..."
msgstr "penggunaan: errata_delete ERRATA|search:XXX ..."

