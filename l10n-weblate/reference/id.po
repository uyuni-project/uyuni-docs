#: en/modules/reference/pages/spacecmd/errata.adoc:13
msgid "List errata addressing a CVE."
msgstr "Tampilkan daftar errata yang menangani CVE."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/errata.adoc:14
msgid "usage: errata_findbycve CVE-YYYY-NNNN ..."
msgstr "penggunaan: errata_findbycve CVE-YYYY-NNNN ..."

#. type: Title ==
#: en/modules/reference/pages/spacecmd/errata.adoc:15
#, no-wrap
msgid "errata_list"
msgstr "errata_list"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/errata.adoc:16
msgid "List all patches."
msgstr "Tampilkan daftar semua patch."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/errata.adoc:17
msgid "usage: errata_list"
msgstr "penggunaan: errata_list"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/errata.adoc:18
#, no-wrap
msgid "errata_listaffectedsystems"
msgstr "errata_listaffectedsystems"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/errata.adoc:19
msgid "List of systems affected by an patch."
msgstr "Daftar sistem yang terdampak oleh patch."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/errata.adoc:20
msgid "usage: errata_listaffectedsystems ERRATA|search:XXX ..."
msgstr "penggunaan: errata_listaffectedsystems ERRATA|search:XXX ..."

#. type: Title ==
#: en/modules/reference/pages/spacecmd/errata.adoc:21
#, no-wrap
msgid "errata_listcves"
msgstr "errata_listcves"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/errata.adoc:22
msgid "List of CVEs addressed by an patch."
msgstr "Daftar CVE yang ditangani oleh patch."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/errata.adoc:23
msgid "usage: errata_listcves ERRATA|search:XXX ..."
msgstr "penggunaan: errata_listcves ERRATA|search:XXX ..."

#. type: Title ==
#: en/modules/reference/pages/spacecmd/errata.adoc:24
#, no-wrap
msgid "errata_publish"
msgstr "errata_publish"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/errata.adoc:25
msgid "Publish a patch to a channel."
msgstr "Publikasikan patch ke saluran."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/errata.adoc:26
msgid "usage: errata_publish ERRATA|search:XXX <CHANNEL ...>"
msgstr "penggunaan: errata_publish ERRATA|search:XXX <CHANNEL ...>"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/errata.adoc:27
#, no-wrap
msgid "errata_search"
msgstr "errata_search"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/errata.adoc:28
msgid "List patches that meet user provided criteria"
msgstr "Tampilkan daftar patch yang memenuhi kriteria yang diberikan pengguna"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/errata.adoc:29
msgid "usage: errata_search CVE|RHSA|RHBA|RHEA|CLA ..."
msgstr "penggunaan: errata_search CVE|RHSA|RHBA|RHEA|CLA ..."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/errata.adoc:30
msgid "Example:"
msgstr "Contoh:"

