msgstr "Cadangkan grup sistem."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/group.adoc:8
msgid "usage: group_backup NAME [OUTDIR]"
msgstr "penggunaan: group_backup NAME [OUTDIR]"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/group.adoc:9
