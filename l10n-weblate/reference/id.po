#. type: Title ==
#: en/modules/reference/pages/spacecmd/proxy_container.adoc:1
#: en/modules/reference/pages/spacecmd/proxy_container.adoc:8
#, no-wrap
msgid "proxy_container_config"
msgstr "proxy_container_config"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/proxy_container.adoc:2
msgid ""
"The following spacecmd functions are available for use with proxy container "
"configuration"
msgstr "Fungsi spacecmd berikut tersedia untuk digunakan dengan konfigurasi container proxy"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/proxy_container.adoc:3
#, no-wrap
msgid "proxy_container_config_generate_cert"
msgstr "proxy_container_config_generate_cert"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/proxy_container.adoc:4
msgid ""
"Create {productname} Proxy container configuration and generate new SSL "
"server certificate for it."
msgstr "Buat konfigurasi container Proxy {productname} dan hasilkan sertifikat server SSL baru untuknya."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/proxy_container.adoc:5
#, no-wrap
msgid ""
"usage: proxy_container_config_generate_cert PROXY_FQDN PARENT_FQDN MAX_CACHE "
"EMAIL\n"
msgstr "penggunaan: proxy_container_config_generate_cert PROXY_FQDN PARENT_FQDN MAX_CACHE EMAIL\n"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/proxy_container.adoc:6
#, no-wrap
msgid ""
"parameters:\n"
"  PROXY_FQDN  the fully qualified domain name of the proxy to create.\n"
"  PARENT_FQDN the fully qualified domain name of the server or another proxy "
"to connect to.\n"
"  MAX_CACHE   the maximum cache size in MB. 60% of the storage is a good "
"value.\n"
"  EMAIL       the email of the proxy administrator\n"
msgstr ""
"parameter:\n"
"  PROXY_FQDN  nama domain lengkap dari proxy yang akan dibuat.\n"
"  PARENT_FQDN nama domain lengkap dari server atau proxy lain yang akan dihubungi.\n"
"  MAX_CACHE   ukuran cache maksimum dalam MB. 60% dari kapasitas penyimpanan merupakan nilai yang disarankan.\n"
"  EMAIL       alamat email administrator proxy\n"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/proxy_container.adoc:7
#, no-wrap
msgid ""
"options:\n"
"  -o, --output Path where to create the generated configuration. Default: "
"'config.zip'\n"
"  -p, --ssh-port SSH port the proxy listens one. Default: 22\n"
"  --ca-cert path to the certificate of the CA to use to generate a new proxy "
"certificate.\n"
"           Using /root/ssl-build/RHN-ORG-TRUSTED-SSL-CERT by default.\n"
"  --ca-key path to the private key of the CA to use to generate a new proxy "
"certificate.\n"
"           Using /root/ssl-build/RHN-ORG-PRIVATE-SSL-KEY by default.\n"
"  --ca-pass path to a file containing the password of the CA private key, "
"will be prompted if not passed.\n"
"  --ssl-cname alternate name of the proxy to set in the certificate. Can be "
"provided multiple times\n"
"  --ssl-country country code to set in the certificate. If omitted, default "
"values from mgr-ssl-tool will be used.\n"
"  --ssl-state state name to set in the certificate. If omitted, default "
"values from mgr-ssl-tool will be used.\n"
"  --ssl-city the city name to set in the certificate. If omitted, default "
"values from mgr-ssl-tool will be used.\n"
"  --ssl-org the organization name to set in the certificate. If omitted, "
"default values from mgr-ssl-tool will be used.\n"
"  --ssl-org-unit the organization unit name to set in the certificate. If "
"omitted, default values from mgr-ssl-tool will be used.\n"
"  --ssl-email the email to set in the certificate. If omitted, default "
"values from mgr-ssl-tool will be used.\n"
msgstr ""
"opsi:\n"
"  -o, --output Path tempat konfigurasi yang dihasilkan akan dibuat. Bawaan: 'config.zip'\n"
"  -p, --ssh-port Port SSH tempat proxy mendengarkan koneksi. Bawaan: 22\n"
"  --ca-cert path ke sertifikat CA yang akan digunakan untuk menghasilkan sertifikat proxy baru.\n"
"        Secara bawaan menggunakan /root/ssl-build/RHN-ORG-TRUSTED-SSL-CERT.\n"
"  --ca-key path ke kunci privat CA yang akan digunakan untuk menghasilkan sertifikat proxy baru.\n"
"           Secara bawaan menggunakan /root/ssl-build/RHN-ORG-PRIVATE-SSL-KEY.\n"
"  --ca-pass path ke berkas yang berisi kata sandi kunci privat CA, akan diminta jika tidak diberikan.\n"
"  --ssl-cname nama alternatif proxy yang akan ditetapkan dalam sertifikat. Dapat diberikan beberapa kali\n"
"  --ssl-country kode negara yang akan ditetapkan dalam sertifikat. Jika tidak diberikan, nilai bawaan dari mgr-ssl-tool akan digunakan.\n"
"  --ssl-state nama negara bagian atau provinsi yang akan ditetapkan dalam sertifikat. Jika tidak diberikan, nilai bawaan dari mgr-ssl-tool akan digunakan.\n"
"  --ssl-city nama kota yang akan ditetapkan dalam sertifikat. Jika tidak diberikan, nilai bawaan dari mgr-ssl-tool akan digunakan.\n"
"  --ssl-org nama organisasi yang akan ditetapkan dalam sertifikat. Jika tidak diberikan, nilai bawaan dari mgr-ssl-tool akan digunakan.\n"
"  --ssl-org-unit nama unit organisasi yang akan ditetapkan dalam sertifikat. Jika tidak diberikan, nilai bawaan dari mgr-ssl-tool akan digunakan.\n"
"  --ssl-email alamat email yang akan ditetapkan dalam sertifikat. Jika tidak diberikan, nilai bawaan dari mgr-ssl-tool akan digunakan.\n"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/proxy_container.adoc:9
msgid ""
"Create {productname} Proxy container configuration and use already existing "
"SSL server certificate."
msgstr "Buat konfigurasi container Proxy {productname} dan gunakan sertifikat server SSL yang sudah ada."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/proxy_container.adoc:10
#, no-wrap
msgid ""
"usage: proxy_container_config [options] PROXY_FQDN PARENT_FQDN MAX_CACHE "
"EMAIL ROOT_CA CRT KEY\n"
msgstr "penggunaan: proxy_container_config [options] PROXY_FQDN PARENT_FQDN MAX_CACHE EMAIL ROOT_CA CRT KEY\n"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/proxy_container.adoc:11
#, no-wrap
msgid ""
"parameters:\n"
"  PROXY_FQDN  the fully qualified domain name of the proxy to create.\n"
"  PARENT_FQDN the fully qualified domain name of the server or another proxy "
"to connect to.\n"
"  MAX_CACHE   the maximum cache size in MB. 60% of the storage is a good "
"value.\n"
"  EMAIL       the email of the proxy administrator\n"
"  CA          path to the root CA used to sign the proxy certificate in PEM "
"format\n"
"  CRT         path to the proxy certificate in PEM format\n"
"  KEY         path to the proxy certificate private key in PEM format\n"
msgstr ""
"parameter:\n"
"  PROXY_FQDN  nama domain lengkap dari proxy yang akan dibuat.\n"
"  PARENT_FQDN nama domain lengkap dari server atau proxy lain yang akan dihubungi.\n"
"  MAX_CACHE   ukuran cache maksimum dalam MB. 60% dari kapasitas penyimpanan merupakan nilai yang disarankan.\n"
"  EMAIL       alamat email administrator proxy\n"
"  CA          path ke CA root yang digunakan untuk menandatangani sertifikat proxy dalam format PEM\n"
"  CRT         path ke sertifikat proxy dalam format PEM\n"
"  KEY    path ke kunci privat sertifikat proxy dalam format PEM\n"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/proxy_container.adoc:12
#, no-wrap
msgid ""
"options:\n"
"  -o, --output Path where to create the generated configuration. Default: "
"'config.zip'\n"
"  -p, --ssh-port SSH port the proxy listens one. Default: 22\n"
"  -i, --intermediate-ca  Path to an intermediate CA used to sign the proxy\n"
"            certicate in PEM format. May be provided multiple times.\n"
msgstr ""
"opsi:\n"
"  -o, --output Path tempat konfigurasi yang dihasilkan akan dibuat. Bawaan: 'config.zip'\n"
"  -p, --ssh-port Port SSH tempat proxy mendengarkan koneksi. Bawaan: 22\n"
"  -i, --intermediate-ca  Path ke CA perantara yang digunakan untuk menandatangani\n"
"            sertifikat proxy dalam format PEM. Dapat diberikan beberapa kali.\n"

