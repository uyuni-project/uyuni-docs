#: en/modules/reference/pages/spacecmd/cryptokey.adoc:2
msgid ""
"The following spacecmd commands are available for use with cryptographic "
"keys."
msgstr "Perintah spacecmd berikut tersedia untuk digunakan dengan kunci kriptografi."

#. type: Title ==
#: en/modules/reference/pages/spacecmd/cryptokey.adoc:3
#, no-wrap
msgid "cryptokey_create"
msgstr "cryptokey_create"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/cryptokey.adoc:4
msgid "Create a cryptographic key."
msgstr "Buat kunci kriptografi."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/cryptokey.adoc:5
