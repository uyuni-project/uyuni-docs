#. type: Title ==
#: en/modules/reference/pages/spacecmd/scap.adoc:3
#, no-wrap
msgid "scap_getxccdfscandetails"
msgstr "scap_getxccdfscandetails"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/scap.adoc:4
msgid "Get details of given OpenSCAP XCCDF scan."
msgstr "Dapatkan detail pemindaian XCCDF OpenSCAP yang ditentukan."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/scap.adoc:5
#, no-wrap
msgid "usage: scap_getxccdfscandetails <XID>\n"
msgstr "penggunaan: scap_getxccdfscandetails <XID>\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/scap.adoc:6
#, no-wrap
msgid "scap_getxccdfscanruleresults"
msgstr "scap_getxccdfscanruleresults"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/scap.adoc:7
msgid "Return a full list of RuleResults for given OpenSCAP XCCDF scan."
msgstr "Kembalikan daftar lengkap RuleResults untuk pemindaian XCCDF OpenSCAP yang ditentukan."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/scap.adoc:8
#, no-wrap
msgid "usage: scap_getxccdfscanruleresults <XID>\n"
msgstr "penggunaan: scap_getxccdfscanruleresults <XID>\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/scap.adoc:9
#, no-wrap
msgid "scap_listxccdfscans"
msgstr "scap_listxccdfscans"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/scap.adoc:10
msgid "Return a list of finished OpenSCAP scans for given systems."
msgstr "Kembalikan daftar pemindaian OpenSCAP yang telah selesai untuk sistem yang ditentukan."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/scap.adoc:11
#, no-wrap
msgid "usage: scap_listxccdfscans <SYSTEMS>\n"
msgstr "penggunaan: scap_listxccdfscans <SYSTEMS>\n"

#. type: Title ==
#: en/modules/reference/pages/spacecmd/scap.adoc:12
#, no-wrap
msgid "scap_schedulexccdfscan"
msgstr "scap_schedulexccdfscan"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/scap.adoc:13
msgid "Schedule Scap XCCDF scan."
msgstr "Jadwalkan pemindaian XCCDF SCAP."

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/scap.adoc:14
#, no-wrap
msgid "usage: scap_schedulexccdfscan PATH_TO_XCCDF_FILE XCCDF_OPTIONS SYSTEMS\n"
msgstr "penggunaan: scap_schedulexccdfscan PATH_TO_XCCDF_FILE XCCDF_OPTIONS SYSTEMS\n"

#. type: delimited block -
#: en/modules/reference/pages/spacecmd/scap.adoc:15
#, no-wrap
msgid ""
"Example:\n"
"> scap_schedulexccdfscan '/usr/share/openscap/scap-security-xccdf.xml' "
"'profile Web-Default' \\\n"
"system-scap.example.com\n"
msgstr ""
"Contoh:\n"
"> scap_schedulexccdfscan '/usr/share/openscap/scap-security-xccdf.xml' 'profile Web-Default' \\\n"
"system-scap.example.com\n"

