#, no-wrap
msgid "group_addsystems"
msgstr "group_addsystems"

#. type: Plain text
#: en/modules/reference/pages/spacecmd/group.adoc:3
msgid "Add systems to a group."
msgstr "Tambahkan sistem ke grup."

#. type: Plain text
#: en/modules/reference/pages/spacecmd/group.adoc:4
msgid "usage: group_addsystems GROUP <SYSTEMS>"
msgstr "penggunaan: group_addsystems GROUP <SYSTEMS>"

