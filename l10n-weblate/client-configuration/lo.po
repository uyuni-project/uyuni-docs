"machine esm.ubuntu.com/apps/ubuntu/ login bearer password <token>  # "
"ubuntu-pro-client\n"
"machine esm.ubuntu.com/infra/ubuntu/ login bearer password <token>  # "
"ubuntu-pro-client\n"
msgstr ""
"machine esm.ubuntu.com/apps/ubuntu/ login bearer password <token>  # ubuntu-pro-client\n"
"machine esm.ubuntu.com/infra/ubuntu/ login bearer password <token>  # ubuntu-pro-client\n"

