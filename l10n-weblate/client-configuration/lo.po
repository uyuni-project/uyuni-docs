#: modules/client-configuration/pages/clients-sle.adoc:23
msgid ""
"To find channel names of older products, at the command prompt on the "
"{productname} Server, as root, use the [command]``mgr-sync`` command:"
msgstr "ເພື່ອຄົ້ນຫາຊື່ຊ່ອງທາງຂອງຜະລິດຕະພັນເວີຊັນເກົ່າ, ຢູ່ທີ່ command prompt ຂອງເຊີເວີ {productname}, ໃນຖານະ root, ໃຫ້ໃຊ້ຄຳສັ່ງ [command]``mgr-sync``:"

#. type: delimited block -
#: modules/client-configuration/pages/clients-sle.adoc:24
#, no-wrap
msgid "mgr-sync list --help\n"
msgstr "mgr-sync list --help\n"

#. type: Plain text
#: modules/client-configuration/pages/clients-sle.adoc:25
msgid ""
