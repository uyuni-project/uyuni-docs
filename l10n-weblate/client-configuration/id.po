msgstr "| {sles} | `/etc/zypp/repos.d` | {opensuse} | `/etc/zypp/repos.d` | {rhel} dan distribusi turunan sejenis | `/etc/yum.repos.d/` | {ubuntu} | `/etc/apt/sources.list.d/` | {debian} | `/etc/apt/sources.list.d/`"

