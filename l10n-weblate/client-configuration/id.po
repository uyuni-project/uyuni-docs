#. type: Title ==
#: en/modules/client-configuration/pages/configuration-management.adoc:13
#, no-wrap
msgid "Create Configuration Channels"
msgstr "Membuat Saluran Konfigurasi"

#. type: Title ===
#: en/modules/client-configuration/pages/configuration-management.adoc:14
#, no-wrap
msgid "Configuration Channel"
msgstr "Saluran Konfigurasi"

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:15
msgid "To create a new configuration channel:"
msgstr "Untuk membuat saluran konfigurasi baru:"

#. type: Block title
#: en/modules/client-configuration/pages/configuration-management.adoc:16
#, no-wrap
msgid "Procedure: Creating a Configuration Channel"
msgstr "Prosedur: Membuat Saluran Konfigurasi"

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:17
msgid "In the {productname} {webui}, navigate to menu:Configuration[Channels], and click btn:[Create Config Channel]."
msgstr "Pada {webui} {productname}, buka menu:Configuration[Channels], lalu klik btn:[Create Config Channel]."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:18
#: en/modules/client-configuration/pages/configuration-management.adoc:27
msgid "Type a name for the channel."
msgstr "Ketik nama saluran."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:19
#: en/modules/client-configuration/pages/configuration-management.adoc:28
msgid "Type a label for the channel."
msgstr "Ketik label saluran."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:20
#: en/modules/client-configuration/pages/configuration-management.adoc:29
msgid "This field must contain only letters, numbers, hyphens (`-`) and underscores (`_`)."
msgstr "Kolom ini hanya boleh berisi huruf, angka, tanda hubung (`-`), dan garis bawah (`_`)."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:21
#: en/modules/client-configuration/pages/configuration-management.adoc:30
msgid "Type a description for the channel that allows you to distinguish it from other channels."
msgstr "Ketik deskripsi saluran yang memungkinkan Anda membedakannya dari saluran lain."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:22
msgid "Click btn:[Create Config Channel] to create the new channel."
msgstr "Klik btn:[Create Config Channel] untuk membuat saluran baru."

#. type: Title ===
#: en/modules/client-configuration/pages/configuration-management.adoc:23
#, no-wrap
msgid "State Channel"
msgstr "Saluran State"

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:24
msgid "State Channels use {salt} states on clients:"
msgstr "Saluran State menggunakan state {salt} pada klien:"

#. type: Block title
#: en/modules/client-configuration/pages/configuration-management.adoc:25
#, no-wrap
msgid "Procedure: Creating a {salt} State Channel"
msgstr "Prosedur: Membuat Saluran State {salt}"

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:26
msgid "In the {productname} {webui}, navigate to menu:Configuration[Channels], and click btn:[Create State Channel]."
msgstr "Pada {webui} {productname}, buka menu:Configuration[Channels], lalu klik btn:[Create State Channel]."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:31
msgid "Type the `SLS Contents` for the `init.sls` file."
msgstr "Ketik `SLS Contents` untuk berkas `init.sls`."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:32
msgid "Click btn:[Create Config State Channel] to create the new channel."
msgstr "Klik btn:[Create Config State Channel] untuk membuat saluran baru."

#. type: Title ==
#: en/modules/client-configuration/pages/configuration-management.adoc:33
#, no-wrap
msgid "Add Configuration Files, Directories, or Symbolic Links"
msgstr "Menambahkan Berkas Konfigurasi, Direktori, atau Tautan Simbolis"

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:34
msgid "When you have created a configuration channel you can add a configuration file, directory, or symbolic link:"
msgstr "Setelah membuat saluran konfigurasi, Anda dapat menambahkan berkas konfigurasi, direktori, atau tautan simbolis:"

#. type: Block title
#: en/modules/client-configuration/pages/configuration-management.adoc:35
#, no-wrap
msgid "Procedure: Adding a Configuration File, Directory, or Symbolic Link"
msgstr "Prosedur: Menambahkan Berkas Konfigurasi, Direktori, atau Tautan Simbolis"

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:36
msgid "In the {productname} {webui}, navigate to menu:Configuration[Channels], and click the name of the configuration channel that you want to add a configuration file to, and navigate to the menu:Add Files[Create File] subtab."
msgstr "Pada {webui} {productname}, buka menu:Configuration[Channels], klik nama saluran konfigurasi yang ingin Anda tambahi berkas konfigurasi, lalu buka subtab menu:Add Files[Create File]."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:37
msgid "In the `File Type` field, choose whether you want to create a text file, directory, or symbolic link."
msgstr "Pada kolom `File Type`, pilih apakah Anda ingin membuat berkas teks, direktori, atau tautan simbolis."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:38
msgid "In the `Filename/Path` field, type the absolute path to the location where the file should be deployed."
msgstr "Pada kolom `Filename/Path`, ketik jalur absolut ke lokasi tempat berkas harus diterapkan."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:39
msgid "If you are creating a symbolic link, type the target file and path in the `Symbolic Link Target Filename/Path` field."
msgstr "Jika Anda membuat tautan simbolis, ketik nama dan jalur berkas tujuan pada kolom `Symbolic Link Target Filename/Path`."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:40
msgid "Type the `User name` and `Group name` for the file in the `Ownership` field, and the `File Permissions Mode`."
msgstr "Ketik `User name` dan `Group name` untuk berkas pada kolom `Ownership`, serta tetapkan `File Permissions Mode`."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:41
msgid "If the client has SELinux enabled, you can configure `SELinux contexts` to enable the required file attributes (for example: user, role, and file type)."
msgstr "Jika SELinux diaktifkan pada klien, Anda dapat mengonfigurasi `SELinux contexts` untuk mengaktifkan atribut berkas yang diperlukan (misalnya: pengguna, peran, dan jenis berkas)."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:42
msgid "You can use Jinja templating with grains or pillar data instead of legacy macro delimiters."
msgstr "Anda dapat menggunakan templat Jinja dengan data grains atau pillar sebagai pengganti pembatas makro lama."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:43
msgid "Enter the configuration file contents in the `File Contents` text box, using the script drop-down box to choose the appropriate scripting language."
msgstr "Masukkan konten berkas konfigurasi pada kotak teks `File Contents`, lalu gunakan kotak daftar tarik-turun skrip untuk memilih bahasa skrip yang sesuai."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:44
msgid "Click btn:[Create Configuration File]."
msgstr "Klik btn:[Create Configuration File]."

#. type: Title ==
#: en/modules/client-configuration/pages/configuration-management.adoc:45
#, no-wrap
msgid "Subscribe Clients to Configuration Channels"
msgstr "Mendaftarkan Klien untuk Berlangganan Saluran Konfigurasi"

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:46
msgid "You can subscribe individual clients to configuration channels by navigating to menu:Systems[System List], selecting the client you want to subscribe, and navigating to the `Configuration` tab.  To subscribe multiple clients to a configuration channel, you can use the system set manager (SSM)."
msgstr "Anda dapat mendaftarkan klien satu per satu untuk berlangganan saluran konfigurasi dengan membuka menu:Systems[System List], memilih klien yang ingin didaftarkan, lalu membuka tab `Configuration`.  Untuk mendaftarkan beberapa klien sekaligus ke saluran konfigurasi, Anda dapat menggunakan pengelola kumpulan sistem (SSM)."

#. type: Block title
#: en/modules/client-configuration/pages/configuration-management.adoc:47
#, no-wrap
msgid "Procedure: Subscribing Multiple Clients to Configuration Channels"
msgstr "Prosedur: Mendaftarkan Beberapa Klien untuk Berlangganan Saluran Konfigurasi"

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:48
msgid "In the {productname} {webui}, navigate to menu:Systems[Systems List] and select the clients you want to work with."
msgstr "Pada {webui} {productname}, buka menu:Systems[Systems List], lalu pilih klien yang ingin Anda kelola."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:49
msgid "Navigate to menu:Systems[System Set Manager], and go to the menu:Configuration[Subscribe to Channels] subtab to see the list of available configuration channels."
msgstr "Buka menu:Systems[System Set Manager], lalu buka subtab menu:Configuration[Subscribe to Channels] untuk melihat daftar saluran konfigurasi yang tersedia."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:50
msgid "OPTIONAL: Click the number in the `Systems currently subscribed` column to see which clients are currently subscribed to the configuration channel."
msgstr "OPSIONAL: Klik angka pada kolom `Systems currently subscribed` untuk melihat klien yang saat ini berlangganan saluran konfigurasi tersebut."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:51
msgid "Check the configuration channels you want to subscribe to, and click btn:[Continue]."
msgstr "Centang saluran konfigurasi yang ingin dilanggani, lalu klik btn:[Continue]."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:52
msgid "Rank the configuration channels using the up and down arrows."
msgstr "Urutkan prioritas saluran konfigurasi menggunakan panah atas dan bawah."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:53
msgid "Where settings conflicts occur between configuration channels, channels closer to the top of the list take precedence."
msgstr "Jika terjadi konflik pengaturan antarsaluran konfigurasi, saluran yang posisinya lebih dekat ke bagian atas daftar akan diprioritaskan."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:54
msgid "Determine how the channels are applied to the selected clients."
msgstr "Tentukan cara saluran diterapkan pada klien yang dipilih."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:55
msgid "Click btn:[Subscribe With Lowest Priority] to add the new channels at a lower priority than currently subscribed channels.  Click btn:[Subscribe with Highest Priority] to add the new channels at a higher priority than currently subscribed channels.  Click btn:[Replace Existing Subscriptions] to remove existing channels and replace them with the new channels."
msgstr "Klik btn:[Subscribe With Lowest Priority] untuk menambahkan saluran baru dengan prioritas lebih rendah daripada saluran yang saat ini dilanggani.  Klik btn:[Subscribe with Highest Priority] untuk menambahkan saluran baru dengan prioritas lebih tinggi daripada saluran yang saat ini dilanggani.  Klik btn:[Replace Existing Subscriptions] untuk menghapus saluran yang ada dan menggantinya dengan saluran baru."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:56
msgid "Click btn:[Apply Subscriptions]."
msgstr "Klik btn:[Apply Subscriptions]."

#. type: delimited block =
#: en/modules/client-configuration/pages/configuration-management.adoc:57
msgid "If new configuration channel priorities conflict with existing channels, the duplicate channel is removed and replaced according to the new priority.  If the client's configuration priorities are going to be reordered by an action, the {webui} requires you to confirm the change before proceeding."
msgstr "Jika prioritas saluran konfigurasi baru bertentangan dengan saluran yang ada, saluran duplikat akan dihapus dan diganti sesuai prioritas baru.  Jika suatu tindakan akan mengubah urutan prioritas konfigurasi klien, {webui} akan meminta Anda mengonfirmasi perubahan tersebut sebelum melanjutkan."

#. type: Title ==
#: en/modules/client-configuration/pages/configuration-management.adoc:58
#, no-wrap
msgid "Compare Configuration Files"
msgstr "Membandingkan Berkas Konfigurasi"

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:59
msgid "You can also use the system set manager (SSM) to compare the configuration file deployed on clients with the configuration file stored on the {productname} Server."
msgstr "Anda juga dapat menggunakan pengelola kumpulan sistem (SSM) untuk membandingkan berkas konfigurasi yang diterapkan pada klien dengan berkas konfigurasi yang disimpan di Server {productname}."

#. type: Block title
#: en/modules/client-configuration/pages/configuration-management.adoc:60
#, no-wrap
msgid "Procedure: Comparing Configuration Files"
msgstr "Prosedur: Membandingkan Berkas Konfigurasi"

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:61
msgid "In the {productname} {webui}, navigate to menu:Systems[Systems List] and select the clients subscribed to the configuration files you want to compare."
msgstr "Pada {webui} {productname}, buka menu:Systems[Systems List], lalu pilih klien yang berlangganan berkas konfigurasi yang ingin Anda bandingkan."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:62
msgid "Navigate to menu:Systems[System Set Manager], and go to the menu:Configuration[Compare Files] subtab to the list of available configuration files."
msgstr "Buka menu:Systems[System Set Manager], lalu buka subtab menu:Configuration[Compare Files] untuk melihat daftar berkas konfigurasi yang tersedia."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:63
msgid "OPTIONAL: Click the number in the `Systems` column to see which clients are currently subscribed to the configuration file."
msgstr "OPSIONAL: Klik angka pada kolom `Systems` untuk melihat klien yang saat ini berlangganan berkas konfigurasi tersebut."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:64
msgid "Check the configuration files to compare, and click btn:[Schedule File Comparison]."
msgstr "Centang berkas konfigurasi yang ingin dibandingkan, lalu klik btn:[Schedule File Comparison]."

#. type: Title ==
#: en/modules/client-configuration/pages/configuration-management.adoc:65
#, no-wrap
msgid "Jinja templating on clients"
msgstr "Templating Jinja pada klien"

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:66
msgid "Jinja templating is possible on {salt} clients.  Jinja is only evaluated when content is processed by the {salt} engine.  Jinja provides variables from pillars or grains.  They can be used in files managed by {salt} (for example, via `file.managed`) or {salt} states."
msgstr "Templating Jinja dapat digunakan pada klien {salt}.  Jinja hanya dievaluasi saat konten diproses oleh mesin {salt}.  Jinja menyediakan variabel dari pillar atau grains.  Variabel tersebut dapat digunakan dalam berkas yang dikelola oleh {salt} (misalnya, melalui `file.managed`) atau state {salt}."

#. type: delimited block =
#: en/modules/client-configuration/pages/configuration-management.adoc:67
msgid "File configuration channels deliver static files without Jinja processing.  State channel files are only applied if referenced in a {salt} state."
msgstr "Saluran konfigurasi berkas menyediakan berkas statis tanpa pemrosesan Jinja.  Berkas saluran state hanya diterapkan jika dirujuk dalam state {salt}."

#. type: Plain text
#: en/modules/client-configuration/pages/configuration-management.adoc:68
msgid "For more information, see https://docs.saltproject.io/salt/user-guide/en/latest/topics/jinja.html with this example:"
msgstr "Untuk informasi lebih lanjut, lihat https://docs.saltproject.io/salt/user-guide/en/latest/topics/jinja.html dengan contoh berikut:"

#. type: delimited block -
#: en/modules/client-configuration/pages/configuration-management.adoc:69
#, no-wrap
msgid ""
"{% if grains.os_family == 'RedHat' %}\n"
"  {% set dns_cfg = '/etc/named.conf' %}\n"
"{% elif grains.os_family == 'Debian' %}\n"
"  {% set dns_cfg = '/etc/bind/named.conf' %}\n"
"{% else %}\n"
"  {% set dns_cfg = '/etc/named.conf' %}\n"
"{% endif %}\n"
"dns_conf:\n"
"  file.managed:\n"
"    - name: {{ dns_cfg }}\n"
"    - source: salt://dns/files/named.conf\n"
"    - template: jinja\n"
msgstr ""
"{% if grains.os_family == 'RedHat' %}\n"
"  {% set dns_cfg = '/etc/named.conf' %}\n"
"{% elif grains.os_family == 'Debian' %}\n"
"  {% set dns_cfg = '/etc/bind/named.conf' %}\n"
"{% else %}\n"
"  {% set dns_cfg = '/etc/named.conf' %}\n"
"{% endif %}\n"
"dns_conf:\n"
"  file.managed:\n"
"    - name: {{ dns_cfg }}\n"
"    - source: salt://dns/files/named.conf\n"
"    - template: jinja\n"

#. type: Title =
#: en/modules/client-configuration/pages/contact-methods-default.adoc:1
#, no-wrap
msgid "Default Contact Method"
msgstr "Metode Kontak Default"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-default.adoc:2
msgid "The default contact method using the {salt} protocol is recommended unless there are specific needs.  By default, the {salt} Bundle implementation (`venv-salt-minion`) will be deployed.  For more information about {salt} in general, see xref:specialized-guides:salt/salt-overview.adoc[]."
msgstr "Metode kontak default yang menggunakan protokol {salt} direkomendasikan kecuali ada kebutuhan khusus.  Secara default, implementasi {salt} Bundle (`venv-salt-minion`) akan diterapkan.  Untuk informasi lebih lanjut tentang {salt} secara umum, lihat xref:specialized-guides:salt/salt-overview.adoc[]."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-default.adoc:3
msgid "The default contact method (`Default`) is the best scaling method.  All new {productname} features are supported."
msgstr "Metode kontak default (`Default`) merupakan metode dengan skalabilitas terbaik.  Semua fitur baru {productname} didukung."

#. type: delimited block =
#: en/modules/client-configuration/pages/contact-methods-default.adoc:4
#: en/modules/client-configuration/pages/contact-methods-intro.adoc:16
msgid "The so-called traditional contact protocol is no longer supported with {productname} 5.0 and later.  Before upgrading from {productname} 4 to 5, any existing traditional clients including the traditional proxies must be migrated to {salt} or replaced with {salt} proxies."
msgstr "Protokol kontak yang disebut tradisional tidak lagi didukung pada {productname} 5.0 dan versi yang lebih baru.  Sebelum meningkatkan versi dari {productname} 4 ke 5, semua klien tradisional yang ada, termasuk proksi tradisional, harus dimigrasikan ke {salt} atau diganti dengan proksi {salt}."

#. type: delimited block =
#: en/modules/client-configuration/pages/contact-methods-default.adoc:5
#: en/modules/client-configuration/pages/contact-methods-intro.adoc:17
msgid "For more information about migrating traditional {productname} 4 clients to {salt} clients, see https://documentation.suse.com/suma/4.3/en/suse-manager/client-configuration/contact-methods-migrate-traditional.html"
msgstr "Untuk informasi lebih lanjut tentang migrasi klien tradisional {productname} 4 ke klien {salt}, lihat https://documentation.suse.com/suma/4.3/en/suse-manager/client-configuration/contact-methods-migrate-traditional.html"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-default.adoc:6
msgid "Software updates are generally pushed from the server to the client.  Connections are initiated from the client.  This means you must open ports on the server, not on clients.  The {salt} clients are also known as {salt} minions.  {productname} Server installs a daemon on every client."
msgstr "Pembaruan perangkat lunak umumnya dikirim dari server ke klien.  Koneksi dimulai oleh klien.  Artinya, Anda harus membuka port pada server, bukan pada klien.  Klien {salt} juga dikenal sebagai minion {salt}.  Server {productname} menginstal daemon pada setiap klien."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-default.adoc:7
msgid "If you need to use {salt} clients in a disconnected setup you can configure SSH Push as a contact method.  With this contact method, clients can be located in a firewall-protected zone called a DMZ.  For more information about SSH Push, see xref:client-configuration:contact-methods-saltssh.adoc[]."
msgstr "Jika Anda perlu menggunakan klien {salt} dalam konfigurasi tanpa koneksi langsung, Anda dapat mengonfigurasi SSH Push sebagai metode kontak.  Dengan metode kontak ini, klien dapat ditempatkan di zona yang dilindungi firewall, yang disebut DMZ.  Untuk informasi lebih lanjut tentang SSH Push, lihat xref:client-configuration:contact-methods-saltssh.adoc[]."

#. type: Title ==
#: en/modules/client-configuration/pages/contact-methods-default.adoc:8
#, no-wrap
msgid "Onboarding Details"
msgstr "Detail Onboarding"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-default.adoc:9
msgid "{salt} has its own database to keep the keys for the minions. This needs to be kept in sync with the {productname} database.  As soon as the key is accepted in {salt}, the onboarding process in {productname} starts."
msgstr "{salt} memiliki basis data sendiri untuk menyimpan kunci minion. Basis data ini harus tetap disinkronkan dengan basis data {productname}.  Segera setelah kunci diterima di {salt}, proses onboarding di {productname} dimulai."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-default.adoc:10
msgid "The onboarding process will look for existing systems in the {productname} database by searching for the `minion_id` and the `machine-id`.  Depending on the outcome, the following scenarios are possible:"
msgstr "Proses onboarding akan mencari sistem yang sudah ada dalam basis data {productname} berdasarkan `minion_id` dan `machine-id`.  Bergantung pada hasilnya, skenario berikut dapat terjadi:"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-default.adoc:11
msgid "If nothing is found, the new system gets created."
msgstr "Jika tidak ada yang ditemukan, sistem baru akan dibuat."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-default.adoc:12
msgid "In case an entry with the `minion_id` or the `machine-id` is found, that system will be migrated to match the new system."
msgstr "Jika ditemukan entri dengan `minion_id` atau `machine-id` tersebut, sistem itu akan dimigrasikan agar sesuai dengan sistem baru."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-default.adoc:13
msgid "In case there is a match for both entries, and they are not the same system, the onboarding will be aborted with an error."
msgstr "Jika ditemukan kecocokan untuk kedua entri tersebut, tetapi keduanya merujuk pada sistem yang berbeda, proses onboarding akan dibatalkan dengan pesan kesalahan."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-default.adoc:14
msgid "In this case the administrator needs to resolve the conflict by removing at least one of the systems."
msgstr "Dalam hal ini, administrator harus menyelesaikan konflik dengan menghapus setidaknya salah satu sistem."

#. type: Title =
#: en/modules/client-configuration/pages/contact-methods-intro.adoc:1
#, no-wrap
msgid "Client Contact Methods"
msgstr "Metode Kontak Klien"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-intro.adoc:2
msgid "There are three contact methods how the {productname} Server can communicate with clients.  They are based on {salt} protocols."
msgstr "Terdapat tiga metode kontak yang dapat digunakan Server {productname} untuk berkomunikasi dengan klien.  Metode-metode tersebut berbasis protokol {salt}."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-intro.adoc:3
msgid "Which {salt} contact method you use depends on the type of client and your network architecture:"
msgstr "Metode kontak {salt} yang Anda gunakan bergantung pada jenis klien dan arsitektur jaringan Anda:"

#. type: Labeled list
#: en/modules/client-configuration/pages/contact-methods-intro.adoc:4
#, no-wrap
msgid "Default"
msgstr "Default"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-intro.adoc:5
msgid "is recommended unless there are specific user needs.  By default, the {salt} Bundle implementation will be deployed.  For more information, see xref:client-configuration:contact-methods-default.adoc[]."
msgstr "direkomendasikan kecuali terdapat kebutuhan khusus pengguna.  Secara default, implementasi {salt} Bundle akan diterapkan.  Untuk informasi selengkapnya, lihat xref:client-configuration:contact-methods-default.adoc[]."

#. type: Labeled list
#: en/modules/client-configuration/pages/contact-methods-intro.adoc:6
#, no-wrap
msgid "SSH Push"
msgstr "SSH Push"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-intro.adoc:7
msgid "is useful only if network restrictions make it impossible for clients to establish contact to the server.  It is supported with the {salt} Bundle only.  This contact method has serious limitations.  For more information, see xref:client-configuration:contact-methods-saltssh.adoc[]."
msgstr "hanya berguna jika pembatasan jaringan membuat klien tidak dapat menghubungi server.  Metode ini hanya didukung dengan {salt} Bundle.  Metode kontak ini memiliki keterbatasan yang signifikan.  Untuk informasi selengkapnya, lihat xref:client-configuration:contact-methods-saltssh.adoc[]."

#. type: Labeled list
#: en/modules/client-configuration/pages/contact-methods-intro.adoc:8
#, no-wrap
msgid "SSH Push (with tunnel)"
msgstr "SSH Push (dengan tunnel)"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-intro.adoc:9
msgid "is the same as SSH Push, but with using a secured communication tunnel.  For more information, see xref:client-configuration:contact-methods-saltssh-tunnel.adoc[]."
msgstr "sama dengan SSH Push, tetapi menggunakan tunnel komunikasi yang aman.  Untuk informasi selengkapnya, lihat xref:client-configuration:contact-methods-saltssh-tunnel.adoc[]."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-intro.adoc:10
msgid "Implementation of {salt} communication software options:"
msgstr "Opsi implementasi perangkat lunak komunikasi {salt}:"

#. type: Labeled list
#: en/modules/client-configuration/pages/contact-methods-intro.adoc:11
#, no-wrap
msgid "Salt Bundle (`venv-salt-minion`)"
msgstr "Salt Bundle (`venv-salt-minion`)"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-intro.adoc:12
msgid "is a single binary package containing {salt} Minion, Python 3, required Python modules, and libraries.  Thus the {salt} contact method is independent from software installed on the client."
msgstr "merupakan satu paket biner yang berisi {salt} Minion, Python 3, modul Python yang diperlukan, dan pustaka.  Dengan demikian, metode kontak {salt} tidak bergantung pada perangkat lunak yang terpasang di klien."

#. Using the {salt} Bundle is the default.
#. It is the only supported implementation for the SSH Push or SSH Push (with tunnel) contact method.
#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-intro.adoc:13
msgid "For more information, see xref:client-configuration:contact-methods-saltbundle.adoc[]."
msgstr "Untuk informasi selengkapnya, lihat xref:client-configuration:contact-methods-saltbundle.adoc[]."

#. type: Labeled list
#: en/modules/client-configuration/pages/contact-methods-intro.adoc:14
#, no-wrap
msgid "Salt Minion (`salt-minion`)"
msgstr "Salt Minion (`salt-minion`)"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-intro.adoc:15
msgid "is {salt} software installed on the client system and it is no longer supported with {productname} in general.  If needed, you can install it on {sle} 15 clients and derivatives (like {sle-micro}) for bootstrapping only.  Then, during bootstrapping it will be replaced with `venv-salt-minion`."
msgstr "merupakan perangkat lunak {salt} yang terpasang pada sistem klien dan secara umum tidak lagi didukung oleh {productname}.  Jika diperlukan, Anda dapat memasangnya pada klien {sle} 15 dan turunannya (seperti {sle-micro}) hanya untuk keperluan bootstrap.  Selanjutnya, selama proses bootstrap, perangkat lunak tersebut akan diganti dengan `venv-salt-minion`."

#. type: Title =
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:1
#, no-wrap
msgid "Salt Bundle"
msgstr "Salt Bundle"

#. type: Title ==
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:2
#, no-wrap
msgid "What is Salt Bundle?"
msgstr "Apa itu Salt Bundle?"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:3
msgid "The Salt Bundle is a single binary package containing {salt} Minion, Python 3, required Python modules, and libraries."
msgstr "Salt Bundle merupakan satu paket biner yang berisi {salt} Minion, Python 3, modul Python yang diperlukan, dan pustaka."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:4
msgid "The Salt Bundle is shipped with Python 3 and all the requirements for {salt} to run. Thus Salt Bundle does not use the Python version install on the client as system software.  The Salt Bundle can be installed on clients that do not meet the requirements for a given {salt} version."
msgstr "Salt Bundle disertakan dengan Python 3 dan semua komponen yang diperlukan untuk menjalankan {salt}. Dengan demikian, Salt Bundle tidak menggunakan versi Python yang terpasang di klien sebagai perangkat lunak sistem.  Salt Bundle dapat dipasang pada klien yang tidak memenuhi persyaratan untuk versi {salt} tertentu."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:5
msgid "It is also possible to use the Salt Bundle on systems that run a {salt} Minion connected to a {salt} Master other than the {productname} {salt} Master."
msgstr "Salt Bundle juga dapat digunakan pada sistem yang menjalankan {salt} Minion yang terhubung ke {salt} Master selain {salt} Master milik {productname}."

#. type: Title ==
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:6
#, no-wrap
msgid "Client registration with Salt Bundle as a minion"
msgstr "Pendaftaran klien dengan Salt Bundle sebagai minion"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:7
msgid "The registration method with the Salt Bundle is the recommended registration method.  This section explains the advantages and limitations of the current implementation."
msgstr "Metode pendaftaran dengan Salt Bundle merupakan metode pendaftaran yang direkomendasikan.  Bagian ini menjelaskan keunggulan dan keterbatasan implementasi saat ini."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:8
msgid "The Salt Bundle is provided as the `venv-salt-minion` package that consists of {salt}, Python 3, and the Python modules {salt} depends on."
msgstr "Salt Bundle disediakan sebagai paket `venv-salt-minion` yang terdiri atas {salt}, Python 3, dan modul Python yang diperlukan oleh {salt}."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:9
msgid "Bootstrapping with {webui} is using Salt Bundle as well, so bootstrapping with {webui} is not Python dependant.  Using the Salt Bundle, it is no longer needed that the client provides any Python interpreter or modules."
msgstr "Proses bootstrap melalui {webui} juga menggunakan Salt Bundle, sehingga proses bootstrap melalui {webui} tidak bergantung pada Python.  Dengan menggunakan Salt Bundle, klien tidak lagi perlu menyediakan interpreter atau modul Python apa pun."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:10
msgid "If you bootstrap new clients, registration with the Salt Bundle is the default method.  You can switch existing clients to the Salt Bundle method.  If you switch, the `salt-minion` package and its dependencies will stay installed."
msgstr "Jika Anda melakukan bootstrap pada klien baru, pendaftaran dengan Salt Bundle merupakan metode default.  Anda dapat mengalihkan klien yang sudah ada ke metode Salt Bundle.  Jika Anda beralih, paket `salt-minion` beserta dependensinya akan tetap terpasang."

#. type: Title ===
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:11
#, no-wrap
msgid "Using the {salt} Bundle with the {salt} Minion"
msgstr "Menggunakan {salt} Bundle bersama {salt} Minion"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:12
msgid "The {salt} Bundle can be used with the {salt} Minion managed by the {salt} Master other than {productname} Server at the same time.  If the Salt Bundle is installed on a client {productname} Server will manage the configuration files of the Salt Bundle, the configuration files of `salt-minion` will not be managed in this case.  For more information, see xref:client-configuration:registration-cli.adoc#_salt_bundle_configuration[Salt Bundle configuration]."
msgstr "{salt} Bundle dapat digunakan secara bersamaan dengan {salt} Minion yang dikelola oleh {salt} Master selain {productname} Server.  Jika Salt Bundle dipasang pada klien, {productname} Server akan mengelola berkas konfigurasi Salt Bundle; dalam hal ini, berkas konfigurasi `salt-minion` tidak akan dikelola.  Untuk informasi selengkapnya, lihat xref:client-configuration:registration-cli.adoc#_salt_bundle_configuration[Salt Bundle configuration]."

#. type: delimited block =
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:13
msgid "To bootstrap a client with the {salt} Minion managed by the {salt} Master other than {productname} Server it is recommended to use `mgr-bootstrap` `--force-bundle` when generating the bootstrap script, or to set `FORCE_VENV_SALT_MINION` to `1` in the bootstrap script."
msgstr "Untuk melakukan bootstrap pada klien dengan {salt} Minion yang dikelola oleh {salt} Master selain {productname} Server, sebaiknya gunakan `mgr-bootstrap` `--force-bundle` saat membuat skrip bootstrap, atau tetapkan `FORCE_VENV_SALT_MINION` ke `1` dalam skrip bootstrap."

#. type: delimited block =
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:14
msgid "For bootstrapping with {webui} `mgr_force_venv_salt_minion` set to `true` pillar can be specified globally.  For more information, see xref:specialized-guides:salt/salt-states-and-pillars.adoc[]."
msgstr "Untuk proses bootstrap melalui {webui}, pillar `mgr_force_venv_salt_minion` yang ditetapkan ke `true` dapat ditentukan secara global.  Untuk informasi selengkapnya, lihat xref:specialized-guides:salt/salt-states-and-pillars.adoc[]."

#. type: Title ===
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:15
#, no-wrap
msgid "Switching from {salt} Minion to Salt Bundle"
msgstr "Beralih dari {salt} Minion ke Salt Bundle"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:16
msgid "The {salt} state `util.mgr_switch_to_venv_minion` is available to switch from `salt-minion` to `venv-salt-minion`.  It is recommended to switch to `venv-salt-minion` in two steps to avoid trouble with shifting processes:"
msgstr "State {salt} `util.mgr_switch_to_venv_minion` tersedia untuk beralih dari `salt-minion` ke `venv-salt-minion`.  Sebaiknya lakukan peralihan ke `venv-salt-minion` dalam dua tahap untuk menghindari masalah saat memindahkan proses:"

#. type: Block title
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:17
#, no-wrap
msgid "Procedure: Switching with `util.mgr_switch_to_venv_minion` state to `venv-salt-minion`"
msgstr "Prosedur: Beralih ke `venv-salt-minion` dengan state `util.mgr_switch_to_venv_minion`"

#. type: delimited block _
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:18
msgid "Apply `util.mgr_switch_to_venv_minion` with no pillar specified first.  This will result in the switch to `venv-salt-minion` with copying configuration files etc.  It will not clean up the original `salt-minion` configurations and its packages."
msgstr "Terapkan `util.mgr_switch_to_venv_minion` terlebih dahulu tanpa menentukan pillar.  Tindakan ini akan mengalihkan sistem ke `venv-salt-minion` dengan menyalin berkas konfigurasi dan komponen lainnya.  Konfigurasi asli `salt-minion` beserta paketnya tidak akan dihapus."

#. type: delimited block -
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:19
#, no-wrap
msgid "salt <minion_id> state.apply util.mgr_switch_to_venv_minion\n"
msgstr "salt <minion_id> state.apply util.mgr_switch_to_venv_minion\n"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:20
msgid "Apply `util.mgr_switch_to_venv_minion` with `mgr_purge_non_venv_salt` set to `True` to remove `salt-minion` and with `mgr_purge_non_venv_salt_files` set to `True` to remove all the files related to `salt-minion`.  This second step ensures the first step was processed, and then removes the old configuration files and the now obsolete `salt-minion` package."
msgstr "Terapkan `util.mgr_switch_to_venv_minion` dengan `mgr_purge_non_venv_salt` ditetapkan ke `True` untuk menghapus `salt-minion` dan dengan `mgr_purge_non_venv_salt_files` ditetapkan ke `True` untuk menghapus semua berkas yang terkait dengan `salt-minion`. Tahap kedua ini memastikan tahap pertama telah diproses, lalu menghapus berkas konfigurasi lama dan paket `salt-minion` yang kini tidak lagi diperlukan."

#. type: delimited block -
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:21
#, no-wrap
msgid "salt <minion_id> state.apply util.mgr_switch_to_venv_minion pillar='{\"mgr_purge_non_venv_salt_files\": True, \"mgr_purge_non_venv_salt\": True}'\n"
msgstr "salt <minion_id> state.apply util.mgr_switch_to_venv_minion pillar='{\"mgr_purge_non_venv_salt_files\": True, \"mgr_purge_non_venv_salt\": True}'\n"

#. type: Title ===
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:22
#, no-wrap
msgid "Additional concerns"
msgstr "Hal lain yang perlu diperhatikan"

#. [WARNING]
#. ====
#. ====
#. type: delimited block _
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:23
msgid "In case of running the second step only and the first step, state apply process could fail as it requires stopping the `salt-minion` which is used to execute the command on the client side."
msgstr "Jika hanya tahap kedua yang dijalankan tanpa tahap pertama, proses penerapan state dapat gagal karena proses tersebut mengharuskan penghentian `salt-minion` yang digunakan untuk menjalankan perintah di sisi klien."

#. type: delimited block _
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:24
msgid "It is also possible to avoid installing the Salt Bundle and keep using `salt-minion` instead.  In this case, specify one of these options:"
msgstr "Anda juga dapat memilih untuk tidak memasang Salt Bundle dan tetap menggunakan `salt-minion`.  Dalam hal ini, tentukan salah satu opsi berikut:"

#. type: delimited block _
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:25
msgid "Execute `mgr-bootstrap` with `--no-bundle` option."
msgstr "Jalankan `mgr-bootstrap` dengan opsi `--no-bundle`."

#. type: delimited block _
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:26
msgid "Set `AVOID_VENV_SALT_MINION` to `1` in the generated bootstrap script."
msgstr "Tetapkan `AVOID_VENV_SALT_MINION` ke `1` dalam skrip bootstrap yang dihasilkan."

#. type: delimited block _
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:27
msgid "For bootstrap state set the `mgr_avoid_venv_salt_minion` pillar to `True` in `/srv/pillar/salt_bundle_config.sls`."
msgstr "Untuk state bootstrap, tetapkan pillar `mgr_avoid_venv_salt_minion` ke `True` dalam `/srv/pillar/salt_bundle_config.sls`."

#. type: Title ==
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:28
#, no-wrap
msgid "SSH push with the Salt Bundle"
msgstr "SSH Push dengan Salt Bundle"

#. type: delimited block _
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:29
msgid "The Salt Bundle is also used when performing SSH Push actions to clients."
msgstr "Salt Bundle juga digunakan saat menjalankan tindakan SSH Push pada klien."

#. type: delimited block _
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:30
msgid "A shell script deploys the Salt Bundle onto the target system without installing `venv-salt-minion` before any {salt} command is executed. Because the Salt Bundle contains the whole {salt} code base, no `salt-thin` is deployed.  SSH Push (including bootstrapping using the {webui}) uses the Python 3 interpreter within the bundle.  The target system does not need to have any other Python interpreter installed."
msgstr "Skrip shell menerapkan Salt Bundle pada sistem target tanpa memasang `venv-salt-minion` sebelum perintah {salt} apa pun dijalankan. Karena Salt Bundle berisi seluruh basis kode {salt}, `salt-thin` tidak diterapkan.  SSH Push (termasuk proses bootstrap melalui {webui}) menggunakan interpreter Python 3 di dalam bundle.  Sistem target tidak perlu memiliki interpreter Python lain yang terpasang."

#. type: delimited block _
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:31
msgid "The Python 3 deployed with the Bundle is used to handle SSH Push session on the client, so SSH Push (including bootstrapping with {webui}) is not dependant on Python installed on the system."
msgstr "Python 3 yang diterapkan bersama Bundle digunakan untuk menangani sesi SSH Push pada klien, sehingga SSH Push (termasuk proses bootstrap melalui {webui}) tidak bergantung pada Python yang terpasang di sistem."

#. type: delimited block _
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:32
msgid "Using `salt-thin` can be enabled as a fallback method, but it requires Python 3 to be installed on the client.  This method is not recommended nor supported and exists for development purposes only.  Set `web.ssh_use_salt_thin` to `true` in the `/etc/rhn/rhn.conf` configuration file."
msgstr "Penggunaan `salt-thin` dapat diaktifkan sebagai metode cadangan, tetapi memerlukan Python 3 yang terpasang pada klien.  Metode ini tidak direkomendasikan maupun didukung dan hanya tersedia untuk keperluan pengembangan.  Tetapkan `web.ssh_use_salt_thin` ke `true` dalam berkas konfigurasi `/etc/rhn/rhn.conf`."

#. type: delimited block =
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:33
msgid "The bootstrap repository must be created before bootstrapping the client with {webui}.  SSH Push is using the Salt Bundle taken from the bootstrap repository based on the detected target operating system.  For more information, see xref:client-configuration:bootstrap-repository.adoc#_prepare_to_create_a_bootstrap_repository[]."
msgstr "Repositori bootstrap harus dibuat sebelum melakukan bootstrap pada klien melalui {webui}.  SSH Push menggunakan Salt Bundle yang diambil dari repositori bootstrap berdasarkan sistem operasi target yang terdeteksi.  Untuk informasi selengkapnya, lihat xref:client-configuration:bootstrap-repository.adoc#_prepare_to_create_a_bootstrap_repository[]."

#. type: delimited block =
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:34
msgid "SSH Push is using `/var/tmp` to deploy Salt Bundle to and execute {salt} commands on the client with the bundled Python.  Therefore you must not mount `/var/tmp` with the `noexec` option.  It is not possible to bootstrap the clients, which have `/var/tmp` mounted with `noexec` option, with the {webui} because the bootstrap process is using SSH Push to reach a client."
msgstr "SSH Push menggunakan `/var/tmp` untuk menempatkan Salt Bundle dan menjalankan perintah {salt} pada klien dengan Python yang disertakan dalam bundle.  Oleh karena itu, Anda tidak boleh memasang `/var/tmp` dengan opsi `noexec`.  Klien yang memiliki `/var/tmp` yang dipasang dengan opsi `noexec` tidak dapat menjalani proses bootstrap melalui {webui} karena proses bootstrap menggunakan SSH Push untuk menghubungi klien."

#. type: Title ==
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:35
#, no-wrap
msgid "Extend Salt Bundle with Python packages using `pip`"
msgstr "Memperluas Salt Bundle dengan paket Python menggunakan `pip`"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:36
msgid "The Salt Bundle includes `pip` to make it possible to extend the functionality of the bundled {salt} Minion with extra Python packages."
msgstr "Salt Bundle menyertakan `pip` agar fungsionalitas {salt} Minion yang disertakan dalam bundle dapat diperluas dengan paket Python tambahan."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:37
msgid "By default, `salt <minion_id> pip.install <package-name>` installs the Python package specified by `<package_name>` into `/var/lib/venv-salt-minion/local`."
msgstr "Secara default, `salt <minion_id> pip.install <package-name>` memasang paket Python yang ditentukan oleh `<package_name>` ke `/var/lib/venv-salt-minion/local`."

#. type: delimited block =
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:38
msgid "If needed, the path `/var/lib/venv-salt-minion/local` can be overridden by setting the `VENV_PIP_TARGET` environment variable for the `venv-salt-minion.service`.  It is recommended to use a systemd drop-in configuration file for the service.  It could be done with the configuration file `/etc/systemd/system/venv-salt-minion.service.d/10-pip-destination.conf`:"
msgstr "Jika diperlukan, lokasi `/var/lib/venv-salt-minion/local` dapat diganti dengan menetapkan variabel lingkungan `VENV_PIP_TARGET` untuk `venv-salt-minion.service`.  Sebaiknya gunakan berkas konfigurasi drop-in systemd untuk layanan tersebut.  Hal ini dapat dilakukan dengan berkas konfigurasi `/etc/systemd/system/venv-salt-minion.service.d/10-pip-destination.conf`:"

#. type: delimited block -
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:39
#, no-wrap
msgid ""
"[Service]\n"
"Environment=VENV_PIP_TARGET=/new/path/local/venv-salt-minion/pip\n"
msgstr ""
"[Service]\n"
"Environment=VENV_PIP_TARGET=/new/path/local/venv-salt-minion/pip\n"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:40
msgid "The Python packages installed through `pip` are not changing on updating the Salt Bundle.  To ensure that such packages are available and functional after an update, it is recommended to install them with a {salt} state that is applied after Salt Bundle updates."
msgstr "Paket Python yang dipasang melalui `pip` tidak berubah saat Salt Bundle diperbarui.  Untuk memastikan paket tersebut tersedia dan berfungsi setelah pembaruan, sebaiknya pasang paket tersebut menggunakan state {salt} yang diterapkan setelah pembaruan Salt Bundle."

#. type: Title ==
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:41
#, no-wrap
msgid "Availability of Salt's \"virt\" module inside the Salt Bundle"
msgstr "Ketersediaan modul \"virt\" Salt di dalam Salt Bundle"

#. type: delimited block =
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:42
msgid "The Salt `virt` module is available within the Salt Bundle (`venv-salt-minion`) on SUSE-based operating systems ({sles}, {slemicro}, {opensuse} Leap, and {opensuse} Tumbleweed). The module requires system `libvirt` library dependencies, which are not included in the bundle."
msgstr "Modul `virt` Salt tersedia di dalam Salt Bundle (`venv-salt-minion`) pada sistem operasi berbasis SUSE ({sles}, {slemicro}, {opensuse} Leap, dan {opensuse} Tumbleweed). Modul ini memerlukan dependensi pustaka `libvirt` sistem yang tidak disertakan dalam bundle."

#. type: delimited block =
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:43
msgid "On other operating systems (such as {rhel} or {debian}-based systems), the Salt `virt` module is not available or supported inside the Salt Bundle."
msgstr "Pada sistem operasi lain (seperti {rhel} atau sistem berbasis {debian}), modul `virt` Salt tidak tersedia atau tidak didukung di dalam Salt Bundle."

#. type: delimited block =
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:44
msgid "To use the Salt `virt` module (for example, to inventory virtual machines on physical KVM hosts), the system `libvirt` libraries must be installed on the managed host:"
msgstr "Untuk menggunakan modul `virt` Salt (misalnya, untuk menginventarisasi mesin virtual pada host KVM fisik), pustaka `libvirt` sistem harus dipasang pada host yang dikelola:"

#. type: delimited block _
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:45
msgid "Install the `libvirt-libs` package on the managed host system using the system's package manager."
msgstr "Pasang paket `libvirt-libs` pada sistem host yang dikelola menggunakan pengelola paket sistem."

#. type: delimited block =
#: en/modules/client-configuration/pages/contact-methods-saltbundle.adoc:46
msgid "If a virtualization host was migrated from an earlier {productname} version, an obsolete event listener configuration file can trigger `libvirt_events` errors in `/var/log/venv-salt-minion.log`.  For instructions on resolving this problem, see xref:administration:troubleshooting/tshoot-libvirt-events.adoc[]."
msgstr "Jika host virtualisasi dimigrasikan dari versi {productname} sebelumnya, berkas konfigurasi event listener yang sudah usang dapat memicu kesalahan `libvirt_events` dalam `/var/log/venv-salt-minion.log`.  Untuk petunjuk penyelesaian masalah ini, lihat xref:administration:troubleshooting/tshoot-libvirt-events.adoc[]."

#. type: Title =
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:1
#, no-wrap
msgid "SSH Push (With Tunnel) Contact Method"
msgstr "Metode Kontak SSH Push (Dengan Tunnel)"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:2
msgid "SSH Push (with tunnel) (`ssh-push-tunnel`) is used in environments where clients cannot reach the {productname} Server directly.  In this environment, clients are located in a firewall-protected zone called a DMZ.  No system within the DMZ is authorized to open a connection to the internal network, including the {productname} Server."
msgstr "SSH Push (dengan tunnel) (`ssh-push-tunnel`) digunakan di lingkungan tempat klien tidak dapat menjangkau {productname} Server secara langsung.  Dalam lingkungan ini, klien berada di zona yang dilindungi firewall yang disebut DMZ.  Tidak ada sistem di dalam DMZ yang diizinkan membuka koneksi ke jaringan internal, termasuk {productname} Server."

#.  CHECKIT: Maybe, we can delete the following sentence.  It is already
#.  described in the second "important" admonition
#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:3
msgid "In other words: SSH Push (with tunnel) also creates a reverse tunnel from the client to the {productname} Server, not only from the server to the client."
msgstr "Dengan kata lain: SSH Push (dengan tunnel) juga membuat tunnel balik dari klien ke {productname} Server, bukan hanya dari server ke klien."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:4
msgid "The server uses SSH to contact the clients at regular intervals, checking in and performing scheduled actions and events."
msgstr "Server menggunakan SSH untuk menghubungi klien secara berkala, memeriksa status, serta menjalankan tindakan dan peristiwa terjadwal."

#. type: delimited block =
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:5
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:7
msgid "Re-installing systems using the provisioning model is not currently supported on clients managed with SSH Push."
msgstr "Pemasangan ulang sistem menggunakan model provisioning saat ini tidak didukung pada klien yang dikelola dengan SSH Push."

#. type: delimited block =
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:6
msgid "The tunnel is used to provide the access to the server through the encrypted tunnel.  The repositories assigned to the SSH Push client (with tunnel) are provided through this tunnel only, thus it is not possible to use package manager tools directly from the client system because the repositories are available only while the tunnel is up.  In other words, access is only possible if the session is initiated by the server.  All package managing operations on the client can be performed from the server side only."
msgstr "Tunnel digunakan untuk menyediakan akses ke server melalui tunnel terenkripsi.  Repositori yang ditetapkan untuk klien SSH Push (dengan tunnel) hanya disediakan melalui tunnel ini, sehingga alat pengelola paket tidak dapat digunakan secara langsung dari sistem klien karena repositori hanya tersedia saat tunnel aktif.  Dengan kata lain, akses hanya dimungkinkan jika sesi dimulai oleh server.  Semua operasi pengelolaan paket pada klien hanya dapat dilakukan dari sisi server."

#. type: delimited block =
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:7
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:29
msgid "Use `mgrctl term` before running steps inside the server container."
msgstr "Gunakan `mgrctl term` sebelum menjalankan langkah-langkah di dalam kontainer server."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:8
msgid "For tunneling connections via SSH, a port number is required for tunneling via HTTPS.  The port number used by default is `1233`.  To overwrite it, inside the container, you can add a custom port numbers greater than 1024 to `/etc/rhn/rhn.conf`:"
msgstr "Untuk koneksi tunnel melalui SSH, diperlukan nomor port untuk tunnel melalui HTTPS.  Nomor port yang digunakan secara default adalah `1233`.  Untuk menggantinya, Anda dapat menambahkan nomor port khusus yang lebih besar dari 1024 ke `/etc/rhn/rhn.conf` di dalam kontainer:"

#. type: delimited block -
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:9
#, no-wrap
msgid "ssh_push_port_https = high_port\n"
msgstr "ssh_push_port_https = high_port\n"

#. type: delimited block _
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:10
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:18
msgid "After changing this configuration parameter you must restart services such as `salt-secrets-config.service`, `tomcat.service`, and `taskomatic.service`.  To cover all needed services, it is the best to restart the {productname} Server as root.  Outside of the container, from the container host, enter:"
msgstr "Setelah mengubah parameter konfigurasi ini, Anda harus memulai ulang layanan seperti `salt-secrets-config.service`, `tomcat.service`, dan `taskomatic.service`.  Untuk mencakup semua layanan yang diperlukan, sebaiknya mulai ulang {productname} Server sebagai root.  Dari host kontainer, di luar kontainer, masukkan:"

#. type: delimited block -
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:11
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:19
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:37
#, no-wrap
msgid "mgradm restart\n"
msgstr "mgradm restart\n"

#. [IMPORTANT]
#. ====
#. Use `mgrctl term` before running steps inside the server container.
#. ====
#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:12
msgid "For security reasons, you might want to use `sudo` with SSH, to access the system as an unprivileged user instead of as root."
msgstr "Untuk alasan keamanan, Anda dapat menggunakan `sudo` dengan SSH agar dapat mengakses sistem sebagai pengguna tanpa hak istimewa, bukan sebagai root."

#. type: Block title
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:13
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:30
#, no-wrap
msgid "Procedure: Configuring unprivileged SSH access"
msgstr "Prosedur: Mengonfigurasi akses SSH tanpa hak istimewa"

#. type: delimited block _
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:14
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:32
msgid "On each client system, create an appropriate unprivileged user."
msgstr "Pada setiap sistem klien, buat pengguna tanpa hak istimewa yang sesuai."

#. type: delimited block _
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:15
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:33
msgid "Configure passwordless `sudo` access on the client for the unprivileged user.  For detailed instructions, see xref:client-configuration:registration-sudo.adoc[]."
msgstr "Konfigurasikan akses `sudo` tanpa kata sandi pada klien untuk pengguna tanpa hak istimewa tersebut.  Untuk petunjuk terperinci, lihat xref:client-configuration:registration-sudo.adoc[]."

#. type: delimited block _
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:16
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:34
msgid "Inside the {productname} Server container, edit the `/etc/rhn/rhn.conf` configuration file, and add or amend this line to include the unprivileged username:"
msgstr "Di dalam kontainer {productname} Server, edit berkas konfigurasi `/etc/rhn/rhn.conf`, lalu tambahkan atau ubah baris ini agar memuat nama pengguna tanpa hak istimewa tersebut:"

#. type: delimited block -
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:17
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:35
#, no-wrap
msgid "ssh_push_sudo_user = <user>\n"
msgstr "ssh_push_sudo_user = <user>\n"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:20
msgid "You need to use the {webui} or API to register these clients with the {productname} Server."
msgstr "Anda perlu menggunakan {webui} atau API untuk mendaftarkan klien ini ke {productname} Server."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:21
msgid "Before you begin, you need to ensure that you have specified which ports to use for SSH tunneling.  If you have registered clients before changing the port numbers, they need to be registered again with a re-activation key."
msgstr "Sebelum memulai, Anda perlu memastikan bahwa Anda telah menentukan port yang akan digunakan untuk tunnel SSH.  Jika Anda telah mendaftarkan klien sebelum mengubah nomor port, klien tersebut perlu didaftarkan ulang dengan kunci aktivasi ulang."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:22
msgid "For more information about bootstrapping, see xref:client-configuration:registration-bootstrap.adoc[]."
msgstr "Untuk informasi selengkapnya tentang proses bootstrap, lihat xref:client-configuration:registration-bootstrap.adoc[]."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:23
msgid "For more information about bootstrapping, see xref:client-configuration:activation-keys.adoc#activation-keys-reactivation[]."
msgstr "Untuk informasi selengkapnya tentang proses bootstrap, lihat xref:client-configuration:activation-keys.adoc#activation-keys-reactivation[]."

#. type: Block title
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:24
#, no-wrap
msgid "Example: API Access to SSH Push (with tunnel)"
msgstr "Contoh: Akses API ke SSH Push (dengan tunnel)"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:25
msgid "You can use the API to manage which contact method to use.  This example Python code sets the contact method to `ssh-push-tunnel`."
msgstr "Anda dapat menggunakan API untuk mengelola metode kontak yang akan digunakan.  Contoh kode Python ini menetapkan metode kontak ke `ssh-push-tunnel`."

#. type: delimited block -
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:26
#, no-wrap
msgid ""
"client = xmlrpclib.Server(MLM_HOST + \"/rpc/api\", verbose=0)\n"
"key = client.auth.login(MLM_LOGIN, MLM_PASSWORD)\n"
"client.system.setDetails(key, 1000012345, {'contact_method' : 'ssh-push-tunnel'})\n"
msgstr ""
"client = xmlrpclib.Server(MLM_HOST + \"/rpc/api\", verbose=0)\n"
"key = client.auth.login(MLM_LOGIN, MLM_PASSWORD)\n"
"client.system.setDetails(key, 1000012345, {'contact_method' : 'ssh-push-tunnel'})\n"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:27
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:21
msgid "Valid values are:"
msgstr "Nilai yang valid adalah:"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:28
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:22
msgid "`default` (pull)"
msgstr "`default` (pull)"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:29
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:23
msgid "`ssh-push`"
msgstr "`ssh-push`"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh-tunnel.adoc:30
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:24
msgid "`ssh-push-tunnel`"
msgstr "`ssh-push-tunnel`"

#. type: Title =
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:1
#, no-wrap
msgid "SSH Push Contact Method"
msgstr "Metode Kontak SSH Push"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:2
msgid "SSH Push (`ssh-push`) is used in environments where Salt clients cannot reach the {productname} Server directly.  In this environment, clients are located in a firewall-protected zone called a DMZ.  No system within the DMZ is authorized to open a connection to the internal network where the {productname} Server is located."
msgstr "SSH Push (`ssh-push`) digunakan di lingkungan tempat klien Salt tidak dapat menjangkau {productname} Server secara langsung.  Dalam lingkungan ini, klien berada di zona yang dilindungi firewall yang disebut DMZ.  Tidak ada sistem di dalam DMZ yang diizinkan membuka koneksi ke jaringan internal tempat {productname} Server berada."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:3
msgid "SSH Push opens a tunnel only from {productname} to the client, but the reverse channel goes directly.  Such a scenario might not work everywhere.  Therefore also SSH Push (with tunnel) is available as contact method.  That also opens a reverse tunnel and thus you can communicate through all firewalls which otherwise might block the connection from client to server."
msgstr "SSH Push hanya membuka tunnel dari {productname} ke klien, sedangkan saluran balik terhubung secara langsung.  Skenario seperti ini mungkin tidak berfungsi di semua lingkungan.  Oleh karena itu, SSH Push (dengan tunnel) juga tersedia sebagai metode kontak.  Metode ini juga membuka tunnel balik sehingga komunikasi dapat berlangsung melewati semua firewall yang mungkin memblokir koneksi dari klien ke server."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:4
msgid "SSH Push is also to use if installing a daemon agent on clients is not possible."
msgstr "SSH Push juga digunakan jika agen daemon tidak dapat dipasang pada klien."

#. type: delimited block =
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:5
msgid "The SSH Push method has serious limitations.  It does not scale well, and consumes more Server resources and network bandwidth than the plain Salt method (`default`).  The Push SSH method is not at all supported with large setups (1000 clients and more)."
msgstr "Metode SSH Push memiliki keterbatasan yang signifikan.  Metode ini tidak dapat diskalakan dengan baik dan menggunakan lebih banyak sumber daya Server serta bandwidth jaringan dibandingkan metode Salt biasa (`default`).  Metode SSH Push sama sekali tidak didukung pada lingkungan berskala besar (1000 klien atau lebih)."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:6
msgid "The server uses the SSH Push to contact the clients at regular intervals, checking in and performing scheduled actions and events."
msgstr "Server menggunakan SSH Push untuk menghubungi klien secara berkala, memeriksa status, serta menjalankan tindakan dan peristiwa terjadwal."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:8
msgid "This image demonstrates the SSH Push process path.  All items left of the `Taskomatic` block represent processes running on the {productname} client."
msgstr "Gambar ini menunjukkan alur proses SSH Push.  Semua elemen di sebelah kiri blok `Taskomatic` mewakili proses yang berjalan pada klien {productname}."

#. type: Target for macro image
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:9
#, no-wrap
msgid "salt-ssh-contact-taigon.png"
msgstr "salt-ssh-contact-taigon.png"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:10
msgid "To use SSH Push, you must have the SSH daemon running on the client, and reachable by the `salt-api` daemon running on the {productname} Server.  Additionally, the required Python version will be deployed with the {salt} Bundle on the client system."
msgstr "Untuk menggunakan SSH Push, daemon SSH harus berjalan pada klien dan dapat dijangkau oleh daemon `salt-api` yang berjalan pada {productname} Server.  Selain itu, versi Python yang diperlukan akan diterapkan bersama {salt} Bundle pada sistem klien."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:11
msgid "Before beginning with the following registering procedure, define an activation key with the SSH Push contact method configured.  This method expects that there is a direct connection with HTTPS to the Server."
msgstr "Sebelum memulai prosedur pendaftaran berikut, tentukan kunci aktivasi yang telah dikonfigurasi dengan metode kontak SSH Push.  Metode ini memerlukan koneksi HTTPS langsung ke Server."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:12
msgid "You need to use the {webui} or API to register these clients with the {productname} Server.  See the following procedure or example."
msgstr "Anda perlu menggunakan {webui} atau API untuk mendaftarkan klien ini ke {productname} Server.  Lihat prosedur atau contoh berikut."

#. type: Block title
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:13
#, no-wrap
msgid "Procedure: Registering Clients With SSH Push"
msgstr "Prosedur: Mendaftarkan Klien dengan SSH Push"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:14
msgid "In the {productname} {webui}, navigate to menu:Systems[Bootstrapping] and complete the appropriate fields."
msgstr "Di {webui} {productname}, buka menu:Systems[Bootstrapping] dan isi kolom yang sesuai."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:15
msgid "Select an activation key with the SSH Push contact method configured.  For more information about activation keys, see xref:client-configuration:activation-keys.adoc[]."
msgstr "Pilih kunci aktivasi yang telah dikonfigurasi dengan metode kontak SSH Push.  Untuk informasi selengkapnya tentang kunci aktivasi, lihat xref:client-configuration:activation-keys.adoc[]."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:16
msgid "Check the `Manage system completely via SSH` checkbox."
msgstr "Centang kotak `Manage system completely via SSH`."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:18
msgid "Confirm that the system has been registered correctly by navigating to menu:Systems[Overview]."
msgstr "Pastikan sistem telah terdaftar dengan benar dengan membuka menu:Systems[Overview]."

#. type: Block title
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:19
#, no-wrap
msgid "Example: API Access to Push via SSH"
msgstr "Contoh: Akses API untuk Push melalui SSH"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:20
msgid "You can use the API to manage which contact method to use.  This example Python code sets the contact method to `ssh-push`."
msgstr "Anda dapat menggunakan API untuk mengelola metode kontak yang akan digunakan.  Contoh kode Python ini menetapkan metode kontak ke `ssh-push`."

#. type: delimited block -
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:25
#, no-wrap
msgid ""
"client = xmlrpclib.Server(MLM_HOST + \"/rpc/api\", verbose=0)\n"
"key = client.auth.login(MLM_LOGIN, MLM_PASSWORD)\n"
"client.system.setDetails(key, 1000012345, {'contact_method' : 'ssh-push'})\n"
msgstr ""
"client = xmlrpclib.Server(MLM_HOST + \"/rpc/api\", verbose=0)\n"
"key = client.auth.login(MLM_LOGIN, MLM_PASSWORD)\n"
"client.system.setDetails(key, 1000012345, {'contact_method' : 'ssh-push'})\n"

#. type: Title ==
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:26
#, no-wrap
msgid "Available Parameters"
msgstr "Parameter yang Tersedia"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:27
msgid "When you are configuring SSH Push, you can modify parameters that are used when a system is registered, including the host, activation key, and password.  The password is used only for bootstrapping, it is not saved anywhere.  All future SSH sessions are authorized via a key/certificate pair.  These parameters are configured in menu:Systems[Bootstrapping]."
msgstr "Saat mengonfigurasi SSH Push, Anda dapat mengubah parameter yang digunakan saat sistem didaftarkan, termasuk host, kunci aktivasi, dan kata sandi.  Kata sandi hanya digunakan untuk proses bootstrap dan tidak disimpan di mana pun.  Semua sesi SSH berikutnya diotorisasi melalui pasangan kunci/sertifikat.  Parameter ini dikonfigurasi di menu:Systems[Bootstrapping]."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:28
msgid "You can also configure persistent parameters that are used system-wide, including the sudo user to access the system as an unprivileged user instead of as root."
msgstr "Anda juga dapat mengonfigurasi parameter persisten yang digunakan di seluruh sistem, termasuk pengguna sudo untuk mengakses sistem sebagai pengguna tanpa hak istimewa, bukan sebagai root."

#. type: delimited block _
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:31
msgid "Ensure you have the latest `spacewalk-taskomatic` and `spacewalk-certs-tools` packages installed on the {productname} Server."
msgstr "Pastikan paket `spacewalk-taskomatic` dan `spacewalk-certs-tools` versi terbaru telah terpasang pada {productname} Server."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:36
msgid "After changing this configuration parameter you must restart services such as `salt-secrets-config.service`, `tomcat.service`, and `taskomatic.service`.  To cover all needed services, restart the {productname} Server.  Outside of the container, from the container host, run:"
msgstr "Setelah mengubah parameter konfigurasi ini, Anda harus memulai ulang layanan seperti `salt-secrets-config.service`, `tomcat.service`, dan `taskomatic.service`.  Untuk mencakup semua layanan yang diperlukan, mulai ulang {productname} Server.  Dari host kontainer, di luar kontainer, jalankan:"

#. type: Title ==
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:38
#, no-wrap
msgid "Action execution"
msgstr "Eksekusi tindakan"

#. type: delimited block _
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:39
msgid "The SSH Push feature uses taskomatic to execute scheduled actions using `salt-ssh`.  The taskomatic job periodically checks for scheduled actions and executes them.  The SSH Push feature executes a complete `salt-ssh` call based on the scheduled action."
msgstr "Fitur SSH Push menggunakan taskomatic untuk menjalankan tindakan terjadwal melalui `salt-ssh`.  Tugas taskomatic secara berkala memeriksa tindakan terjadwal dan menjalankannya.  Fitur SSH Push menjalankan pemanggilan `salt-ssh` secara lengkap berdasarkan tindakan terjadwal tersebut."

#. type: delimited block _
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:40
msgid "By default, twenty Salt SSH actions can be executed at a time.  You can increase the number of actions that can be executed in parallel, by adding these lines to your configuration file, and adjusting the value of `parallel_threads` upwards.  We recommend you keep the number of parallel actions low, to avoid problems:"
msgstr "Secara default, dua puluh tindakan Salt SSH dapat dijalankan sekaligus.  Anda dapat meningkatkan jumlah tindakan yang dapat dijalankan secara paralel dengan menambahkan baris berikut ke berkas konfigurasi dan menaikkan nilai `parallel_threads`.  Sebaiknya pertahankan jumlah tindakan paralel tetap rendah untuk menghindari masalah:"

#. type: delimited block -
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:41
#, no-wrap
msgid ""
"taskomatic.sshminion_action_executor.parallel_threads = <number>\n"
"org.quartz.threadPool.threadCount = <value of parallel_threads + 20>\n"
msgstr ""
"taskomatic.sshminion_action_executor.parallel_threads = <number>\n"
"org.quartz.threadPool.threadCount = <value of parallel_threads + 20>\n"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:42
msgid "This adjusts the number of actions that can run in parallel on any one client and the total number of worker threads used by taskomatic.  If actions needs to be run on multiple clients, actions are always executed sequentially on each client."
msgstr "Pengaturan ini menyesuaikan jumlah tindakan yang dapat berjalan secara paralel pada satu klien serta jumlah total worker thread yang digunakan oleh taskomatic.  Jika tindakan perlu dijalankan pada beberapa klien, tindakan selalu dijalankan secara berurutan pada setiap klien."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:43
msgid "If the clients are connected through a proxy, you need to adjust the `MaxSessions` settings on the proxy.  In this case, set the number of parallel connections to be three times the total number of clients."
msgstr "Jika klien terhubung melalui proxy, Anda perlu menyesuaikan pengaturan `MaxSessions` pada proxy.  Dalam hal ini, tetapkan jumlah koneksi paralel menjadi tiga kali jumlah total klien."

#.  FIXME: 2024-01-23, ke: to be deleted?
#. type: Title ==
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:44
#, no-wrap
msgid "Future Features"
msgstr "Fitur Mendatang"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:45
msgid "There are some features that are not yet supported on SSH Push.  These features do not work on Salt SSH clients:"
msgstr "Beberapa fitur belum didukung pada SSH Push.  Fitur berikut tidak berfungsi pada klien Salt SSH:"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:46
msgid "OpenSCAP auditing"
msgstr "Audit OpenSCAP"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:47
msgid "Beacons, resulting in:"
msgstr "Beacons, yang mengakibatkan:"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:48
msgid "Installing a package on a system using `zypper` does not invoke the package refresh."
msgstr "Pemasangan paket pada sistem menggunakan `zypper` tidak memicu penyegaran paket."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:49
msgid "Virtual Host functions (for example, a host to guests) does not work if the virtual host system is Salt SSH-based."
msgstr "Fungsi Host Virtual (misalnya, pemetaan host ke mesin tamu) tidak berfungsi jika sistem host virtual berbasis Salt SSH."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:50
msgid "For more information:"
msgstr "Untuk informasi selengkapnya:"

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:51
msgid "about Salt SSH in general, see xref:specialized-guides:salt/salt-ssh.adoc[] and https://docs.saltproject.io/en/latest/topics/ssh/."
msgstr "tentang Salt SSH secara umum, lihat xref:specialized-guides:salt/salt-ssh.adoc[] dan https://docs.saltproject.io/en/latest/topics/ssh/."

#. type: Plain text
#: en/modules/client-configuration/pages/contact-methods-saltssh.adoc:52
msgid "about SSH key rotation, see xref:specialized-guides:salt/salt-ssh.adoc#salt.ssh.key_rotation[]."
msgstr "tentang rotasi kunci SSH, lihat xref:specialized-guides:salt/salt-ssh.adoc#salt.ssh.key_rotation[]."

#. type: Title =
#: en/modules/client-configuration/pages/custom-info.adoc:1
#, no-wrap
msgid "Custom System Information"
msgstr "Informasi Sistem Kustom"

#. type: Plain text
#: en/modules/client-configuration/pages/custom-info.adoc:2
msgid "You can include customized system information about your clients.  System information is defined as `key:value` pairs, which can be assigned to clients.  For example, you can define a `key:value pair` for a particular processor, then assign that key to all clients that have that processor installed.  Custom system information is categorized, and can be searched using the {productname} {webui}."
msgstr "Anda dapat menyertakan informasi sistem yang disesuaikan tentang klien Anda.  Informasi sistem ditentukan sebagai pasangan `key:value` yang dapat ditetapkan ke klien.  Misalnya, Anda dapat menentukan `key:value pair` untuk prosesor tertentu, lalu menetapkan kunci tersebut ke semua klien yang menggunakan prosesor tersebut.  Informasi sistem khusus dikelompokkan berdasarkan kategori dan dapat dicari melalui {webui} {productname}."

#. type: Plain text
#: en/modules/client-configuration/pages/custom-info.adoc:3
msgid "Before you begin, you need to create a key that allows you to store custom information."
msgstr "Sebelum memulai, Anda perlu membuat kunci untuk menyimpan informasi khusus."

#. type: Block title
#: en/modules/client-configuration/pages/custom-info.adoc:4
#, no-wrap
msgid "Procedure: Creating a Custom System Information Key"
msgstr "Prosedur: Membuat Kunci Informasi Sistem Khusus"

#. type: Plain text
#: en/modules/client-configuration/pages/custom-info.adoc:5
msgid "In the {productname} {webui}, navigate to menu:Systems[Custom System Info], and click btn:[Create Key]."
msgstr "Di {webui} {productname}, buka menu:Systems[Custom System Info], lalu klik btn:[Create Key]."

#. type: Plain text
#: en/modules/client-configuration/pages/custom-info.adoc:6
msgid "In the `Key Label` field, add a name for your key.  Do not use spaces.  For example, `intel-x86_64-quadcore`."
msgstr "Di kolom `Key Label`, tambahkan nama untuk kunci Anda.  Jangan gunakan spasi.  Misalnya, `intel-x86_64-quadcore`."

#. type: Plain text
#: en/modules/client-configuration/pages/custom-info.adoc:7
msgid "In the `Description` field, provide any additional information required."
msgstr "Di kolom `Description`, masukkan informasi tambahan yang diperlukan."

#. type: Plain text
#: en/modules/client-configuration/pages/custom-info.adoc:8
msgid "Repeat for each key you require."
msgstr "Ulangi untuk setiap kunci yang Anda perlukan."

#. type: Plain text
#: en/modules/client-configuration/pages/custom-info.adoc:9
msgid "The information is available via {salt} pillar.  You can retrieve this information with a command such as:"
msgstr "Informasi tersebut tersedia melalui pillar {salt}.  Anda dapat mengambil informasi ini dengan perintah seperti:"

#. type: delimited block -
#: en/modules/client-configuration/pages/custom-info.adoc:10
#, no-wrap
msgid "salt $minionid pillar.get custom_info:key1\n"
msgstr "salt $minionid pillar.get custom_info:key1\n"

#. type: Plain text
#: en/modules/client-configuration/pages/custom-info.adoc:11
msgid "This command will result in an output such as:"
msgstr "Perintah ini akan menghasilkan keluaran seperti:"

#. type: delimited block -
#: en/modules/client-configuration/pages/custom-info.adoc:12
#, no-wrap
msgid ""
"$minionid:\n"
"    val1\n"
msgstr ""
"$minionid:\n"
"    val1\n"

#. type: Plain text
#: en/modules/client-configuration/pages/custom-info.adoc:13
msgid "When you have created some custom system information keys, you can apply them to clients."
msgstr "Setelah membuat beberapa kunci informasi sistem khusus, Anda dapat menerapkannya pada klien."

#. type: Block title
#: en/modules/client-configuration/pages/custom-info.adoc:14
#, no-wrap
msgid "Procedure: Applying Custom Information Keys to Clients"
msgstr "Prosedur: Menerapkan Kunci Informasi Khusus pada Klien"

#. type: Plain text
#: en/modules/client-configuration/pages/custom-info.adoc:15
msgid "In the {productname} {webui}, navigate to `Systems`, click the client to apply custom information to, and navigate to the menu:Details[Custom Info] tab."
msgstr "Di {webui} {productname}, buka `Systems`, klik klien yang akan diberi informasi khusus, lalu buka tab menu:Details[Custom Info]."

#. type: Plain text
#: en/modules/client-configuration/pages/custom-info.adoc:16
msgid "Click btn:[Create Value]."
msgstr "Klik btn:[Create Value]."

#. type: Plain text
#: en/modules/client-configuration/pages/custom-info.adoc:17
msgid "Locate the value you want to apply, and click the key label."
msgstr "Temukan nilai yang ingin Anda terapkan, lalu klik label kunci."

#. type: Plain text
#: en/modules/client-configuration/pages/custom-info.adoc:18
msgid "In the `Value` field, provide any additional information."
msgstr "Di kolom `Value`, masukkan informasi tambahan."

#. type: Plain text
#: en/modules/client-configuration/pages/custom-info.adoc:19
msgid "Click btn:[Update Key] to apply the custom information to the client."
msgstr "Klik btn:[Update Key] untuk menerapkan informasi khusus pada klien."

#. type: Plain text
#: en/modules/client-configuration/pages/custom-info.adoc:20
msgid "For more information about configuration management, see xref:client-configuration:configuration-management.adoc[]."
msgstr "Untuk informasi selengkapnya tentang pengelolaan konfigurasi, lihat xref:client-configuration:configuration-management.adoc[]."

#. type: Title =
#: en/modules/client-configuration/pages/delete-clients.adoc:1
#, no-wrap
msgid "Client Deletion"
msgstr "Penghapusan Klien"

#.  FIXME: where do we need to add warnings (suse clients only, all clients)
#. type: Plain text
#: en/modules/client-configuration/pages/delete-clients.adoc:2
msgid "If you need to remove a client from your {productname} Server, you can:"
msgstr "Jika Anda perlu menghapus klien dari {productname} Server, Anda dapat:"

#. type: Plain text
#: en/modules/client-configuration/pages/delete-clients.adoc:3
msgid "use the {webui} to delete it"
msgstr "menggunakan {webui} untuk menghapusnya"

#. type: Plain text
#: en/modules/client-configuration/pages/delete-clients.adoc:4
msgid "remove a client from the command line."
msgstr "menghapus klien melalui baris perintah."

#.  can also be done manually.
#.  FIXME: Why Manual Cleanup is necessary sometimes.
#. type: Title ==
#: en/modules/client-configuration/pages/delete-clients.adoc:5
#, no-wrap
msgid "Delete a Client with the {webui}"
msgstr "Menghapus Klien melalui {webui}"

#. type: Block title
#: en/modules/client-configuration/pages/delete-clients.adoc:6
#, no-wrap
msgid "Procedure: Deleting a client"
msgstr "Prosedur: Menghapus klien"

#. type: delimited block _
#: en/modules/client-configuration/pages/delete-clients.adoc:7
msgid "In the {productname} {webui}, navigate to menu:Systems[System List] and select the client to delete."
msgstr "Di {webui} {productname}, buka menu:Systems[System List] dan pilih klien yang akan dihapus."

#. type: delimited block _
#: en/modules/client-configuration/pages/delete-clients.adoc:8
msgid "Click btn:[Delete System]."
msgstr "Klik btn:[Delete System]."

#. type: delimited block _
#: en/modules/client-configuration/pages/delete-clients.adoc:9
msgid "Check the details and click btn:[Delete Profile] to confirm."
msgstr "Periksa detailnya, lalu klik btn:[Delete Profile] untuk mengonfirmasi."

#. type: delimited block _
#: en/modules/client-configuration/pages/delete-clients.adoc:10
msgid "For {salt} clients, {productname} attempts to clean up additional configuration.  If the client cannot be contacted, you are given the option to cancel the deletion, or delete the client without cleaning up the configuration files."
msgstr "Untuk klien {salt}, {productname} mencoba membersihkan konfigurasi tambahan.  Jika klien tidak dapat dihubungi, Anda diberi opsi untuk membatalkan penghapusan atau menghapus klien tanpa membersihkan berkas konfigurasi."

#. type: Plain text
#: en/modules/client-configuration/pages/delete-clients.adoc:11
msgid "You can also delete multiple clients using the System Set Manager.  For more information about the System Set Manager, see xref:client-configuration:system-set-manager.adoc[]."
msgstr "Anda juga dapat menghapus beberapa klien menggunakan System Set Manager.  Untuk informasi selengkapnya tentang System Set Manager, lihat xref:client-configuration:system-set-manager.adoc[]."

#. type: delimited block =
#: en/modules/client-configuration/pages/delete-clients.adoc:12
msgid "Cleaning up a client only disables {salt} and stops the service if possible.  It does not uninstall the package."
msgstr "Pembersihan klien hanya menonaktifkan {salt} dan menghentikan layanannya jika memungkinkan.  Proses ini tidak menghapus paket."

#. type: Title ==
#: en/modules/client-configuration/pages/delete-clients.adoc:13
#, no-wrap
msgid "Delete a client on the command line (with API call)"
msgstr "Menghapus klien melalui baris perintah (dengan pemanggilan API)"

#. type: Block title
#: en/modules/client-configuration/pages/delete-clients.adoc:14
#, no-wrap
msgid "Procedure: Deleting a client from the server"
msgstr "Prosedur: Menghapus klien dari server"

#. type: delimited block _
#: en/modules/client-configuration/pages/delete-clients.adoc:15
msgid "Delete the client with the FQDN (Fully Qualified Domain Name):"
msgstr "Hapus klien menggunakan FQDN (Fully Qualified Domain Name):"

#. type: delimited block -
#: en/modules/client-configuration/pages/delete-clients.adoc:16
#, no-wrap
msgid "spacecmd system_delete FQDN\n"
msgstr "spacecmd system_delete FQDN\n"

#. type: delimited block _
#: en/modules/client-configuration/pages/delete-clients.adoc:17
msgid "`spacecmd system_delete` also deletes the {salt} key."
msgstr "`spacecmd system_delete` juga menghapus kunci {salt}."

#. type: delimited block _
#: en/modules/client-configuration/pages/delete-clients.adoc:18
msgid "`system_delete` offers the following options:"
msgstr "`system_delete` menyediakan opsi berikut:"

#. type: delimited block -
#: en/modules/client-configuration/pages/delete-clients.adoc:19
#, no-wrap
msgid "usage: system_delete [options] <SYSTEMS>\n"
msgstr "usage: system_delete [options] <SYSTEMS>\n"

#. type: delimited block -
#: en/modules/client-configuration/pages/delete-clients.adoc:20
#, no-wrap
msgid ""
"    options:\n"
"          -c TYPE - Possible values:\n"
"             *  'FAIL_ON_CLEANUP_ERR' - fail in case of cleanup error,\n"
"             *  'NO_CLEANUP' - do not cleanup, just delete,\n"
"             *  'FORCE_DELETE' - try cleanup first but delete server anyway\n"
"\t        in case of error\n"
msgstr ""
"    options:\n"
"          -c TYPE - Possible values:\n"
"             *  'FAIL_ON_CLEANUP_ERR' - fail in case of cleanup error,\n"
"             *  'NO_CLEANUP' - do not cleanup, just delete,\n"
"             *  'FORCE_DELETE' - try cleanup first but delete server anyway\n"
"\t        in case of error\n"

#
#. // move to Trouble Shooting and link from here
#. Sometimes a new registration of a deleted (unregistered) client might not be possible.
#. To solve this issue, some Salt cache files should be deleted on the {productname} Server (Salt master) before trying to re-register again:
#. ----
#. rm /var/cache/salt/master/thin/version
#. rm /var/cache/salt/master/thin/thin.tgz
#. ----
#. type: Title ==
#: en/modules/client-configuration/pages/delete-clients.adoc:21
#, no-wrap
msgid "Delete client from the command line"
msgstr "Menghapus klien melalui baris perintah"

#. type: delimited block =
#: en/modules/client-configuration/pages/delete-clients.adoc:22
msgid "This process is for {productname} clients only.  Do not run it on the {productname} Server itself."
msgstr "Proses ini hanya untuk klien {productname}.  Jangan jalankan proses ini pada {productname} Server itu sendiri."

#. type: delimited block =
#: en/modules/client-configuration/pages/delete-clients.adoc:23
msgid "You must not execute the following procedure on clients running {rhel}, {debian}, or clones.  Instead of `zypper` use equivalent packager commands such as `yum`, `dnf`, or `apt`."
msgstr "Anda tidak boleh menjalankan prosedur berikut pada klien yang menjalankan {rhel}, {debian}, atau turunannya.  Sebagai pengganti `zypper`, gunakan perintah pengelola paket yang setara seperti `yum`, `dnf`, atau `apt`."

#. type: Block title
#: en/modules/client-configuration/pages/delete-clients.adoc:24
#, no-wrap
msgid "Procedure: Deleting SLES 12 and 15 clients"
msgstr "Prosedur: Menghapus klien SLES 12 dan 15"

#. type: delimited block _
#: en/modules/client-configuration/pages/delete-clients.adoc:25
msgid "Stop the salt-minion service:"
msgstr "Hentikan layanan salt-minion:"

#. type: delimited block -
#: en/modules/client-configuration/pages/delete-clients.adoc:26
#, no-wrap
msgid "systemctl stop salt-minion\n"
msgstr "systemctl stop salt-minion\n"

#. type: Plain text
#: en/modules/client-configuration/pages/delete-clients.adoc:27
msgid "Remove the repositories and configuration files:"
msgstr "Hapus repositori dan berkas konfigurasi:"

#. type: delimited block -
#: en/modules/client-configuration/pages/delete-clients.adoc:28
#, no-wrap
msgid ""
"rm -f /etc/zypp/repos.d/susemanager\\:bootstrap.repo\n"
"rm -f /etc/zypp/repos.d/susemanager\\:channels.repo\n"
"rm -r /etc/sysconfig/rhn/\n"
"rm -r /etc/salt/\n"
msgstr ""
"rm -f /etc/zypp/repos.d/susemanager\\:bootstrap.repo\n"
"rm -f /etc/zypp/repos.d/susemanager\\:channels.repo\n"
"rm -r /etc/sysconfig/rhn/\n"
"rm -r /etc/salt/\n"

#. type: Plain text
#: en/modules/client-configuration/pages/delete-clients.adoc:29
msgid "Remove Client Packages:"
msgstr "Hapus Paket Klien:"

#. type: delimited block -
#: en/modules/client-configuration/pages/delete-clients.adoc:30
#, no-wrap
msgid "zypper rm salt salt-minion python*-salt sle-manager-tools-release\n"
msgstr "zypper rm salt salt-minion python*-salt sle-manager-tools-release\n"

#. type: Block title
#: en/modules/client-configuration/pages/delete-clients.adoc:31
#, no-wrap
msgid "Procedure: {salt} bundle client - manual registration cleanup"
msgstr "Prosedur: Klien {salt} bundle - pembersihan pendaftaran secara manual"

#. type: Plain text
#: en/modules/client-configuration/pages/delete-clients.adoc:32
msgid "To unregister, run:"
msgstr "Untuk membatalkan pendaftaran, jalankan:"

#. type: delimited block -
#: en/modules/client-configuration/pages/delete-clients.adoc:33
#, no-wrap
msgid ""
"systemctl stop venv-salt-minion\n"
"zypper rm -y venv-salt-minion sle-manager-tools-release\n"
"rm -f /etc/zypp/repos.d/susemanager\\:bootstrap.repo\n"
"rm -f /etc/zypp/repos.d/susemanager\\:channels.repo\n"
"rm -r /etc/venv-salt-minion/*\n"
msgstr ""
"systemctl stop venv-salt-minion\n"
"zypper rm -y venv-salt-minion sle-manager-tools-release\n"
"rm -f /etc/zypp/repos.d/susemanager\\:bootstrap.repo\n"
"rm -f /etc/zypp/repos.d/susemanager\\:channels.repo\n"
"rm -r /etc/venv-salt-minion/*\n"

#. type: Plain text
#: en/modules/client-configuration/pages/delete-clients.adoc:34
msgid "Remove client machine ID:"
msgstr "Hapus ID mesin klien:"

#. type: delimited block -
#: en/modules/client-configuration/pages/delete-clients.adoc:35
#, no-wrap
msgid "rm /etc/sysconfig/rhn/systemid\n"
msgstr "rm /etc/sysconfig/rhn/systemid\n"

#. type: delimited block _
#: en/modules/client-configuration/pages/delete-clients.adoc:36
msgid "For information about the {salt} bundle, see xref:client-configuration:contact-methods-saltbundle.adoc[]."
msgstr "Untuk informasi tentang {salt} bundle, lihat xref:client-configuration:contact-methods-saltbundle.adoc[]."

#. type: Title =
#: en/modules/client-configuration/pages/gpg-keys.adoc:1
#, no-wrap
msgid "GPG Keys"
msgstr "Kunci GPG"

#. type: Plain text
#: en/modules/client-configuration/pages/gpg-keys.adoc:3
msgid "In most cases, you do not need to adjust the GPG settings to be able to install software on your clients."
msgstr "Dalam kebanyakan kasus, Anda tidak perlu menyesuaikan pengaturan GPG untuk dapat memasang perangkat lunak pada klien."

#. type: Plain text
#: en/modules/client-configuration/pages/gpg-keys.adoc:4
msgid "RPM packages can be signed directly, while Debian based systems sign only the metadata and use a chain of checksums to secure the packages.  Most RPM based systems use signed metadata in addition to signed packages."
msgstr "Paket RPM dapat ditandatangani secara langsung, sedangkan sistem berbasis Debian hanya menandatangani metadata dan menggunakan rantai checksum untuk mengamankan paket.  Sebagian besar sistem berbasis RPM menggunakan metadata bertanda tangan selain paket bertanda tangan."

#
#
#
#
#
#. From Ref Guide, needs editing. --LKB 2020-09-08
#. Lists keys and certificates available for inclusion in {kickstart} profiles and provides a means to create new ones.
#. This is especially important for customers of {productname} or the Proxy Server because systems kickstarted by them must have the server key imported into {productname} and associated with the relevant {kickstart} profiles.
#. Import a profile by creating a new key on this page and then make the profile association in the `GPG and SSL keys` subtab of the `Autoinstallation Details` page.
#. To create a key or certificate, click the `Create Stored Key/Cert` link in the upper-right corner of the page.
#. Enter a description, select the type, upload the file, and click the btn:[Update Key] button.
#. A unique description is required.
#. [IMPORTANT]
#. ====
#. The GPG key you upload to {productname} must be in ASCII format.
#. Using a GPG key in binary format causes anaconda, and therefore the {kickstart} process, to fail.
#. ====
#. type: Title =
#: en/modules/client-configuration/pages/package-management.adoc:1
#, no-wrap
msgid "Package Management"
msgstr "Manajemen Paket"

#. type: Plain text
#: en/modules/client-configuration/pages/package-management.adoc:2
msgid "Clients use packages to install, uninstall, and upgrade software."
msgstr "Klien menggunakan paket untuk memasang, menghapus, dan meningkatkan versi perangkat lunak."

#.  available subtabs:
#.      List / Remove
#.      Upgrade
#.      Install
#.      Lock / Unlock
#.      Profiles
#.      Non Compliant
#. type: Plain text
#: en/modules/client-configuration/pages/package-management.adoc:3
msgid "To manage packages on a client, navigate to `Systems`, click the client to manage, and navigate to the menu:Systems[Software > Packages] subtab.  The options available in this section vary depending on the type of client you have selected, and its current channel subscriptions."
msgstr "Untuk mengelola paket pada klien, buka `Systems`, klik klien yang akan dikelola, lalu buka subtab menu:Systems[Software > Packages].  Opsi yang tersedia di bagian ini bervariasi bergantung pada jenis klien yang dipilih dan langganan salurannya saat ini."

#. type: Plain text
#: en/modules/client-configuration/pages/package-management.adoc:4
msgid "Most package management actions can be added to action chains.  For more about action chains, see xref:reference:schedule/action-chains.adoc[]."
msgstr "Sebagian besar tindakan manajemen paket dapat ditambahkan ke rantai tindakan.  Untuk informasi selengkapnya tentang rantai tindakan, lihat xref:reference:schedule/action-chains.adoc[]."

#. type: Plain text
#: en/modules/client-configuration/pages/package-management.adoc:5
msgid "When packages are installed or upgraded, licenses or EULAs are automatically accepted."
msgstr "Saat paket dipasang atau ditingkatkan versinya, lisensi atau EULA diterima secara otomatis."

#. type: Title ==
#: en/modules/client-configuration/pages/package-management.adoc:6
#, no-wrap
msgid "Compare Packages Using Profiles"
msgstr "Membandingkan Paket Menggunakan Profil"

#. type: delimited block =
#: en/modules/client-configuration/pages/package-management.adoc:7
msgid "You can compare the packages installed on a client with a stored profile, or with packages installed on another client.  When the comparison is made, you can choose to modify the selected client to match."
msgstr "Anda dapat membandingkan paket yang terpasang pada klien dengan profil tersimpan atau dengan paket yang terpasang pada klien lain.  Setelah perbandingan dilakukan, Anda dapat memilih untuk mengubah klien yang dipilih agar sesuai."

#. type: delimited block =
#: en/modules/client-configuration/pages/package-management.adoc:8
msgid "To compare packages against a profile, you need to have stored a profile.  Profiles are created from the packages on a currently installed client.  When the profile has been created, you can use it to install more clients with the same packages installed."
msgstr "Untuk membandingkan paket dengan profil, Anda harus memiliki profil yang telah disimpan.  Profil dibuat dari paket pada klien yang sudah terpasang.  Setelah profil dibuat, Anda dapat menggunakannya untuk memasang lebih banyak klien dengan paket yang sama."

#. type: Block title
#: en/modules/client-configuration/pages/package-management.adoc:9
#, no-wrap
msgid "Procedure: Creating a Stored Profile"
msgstr "Prosedur: Membuat Profil Tersimpan"

#. type: delimited block =
#: en/modules/client-configuration/pages/package-management.adoc:10
msgid "In the {productname} {webui}, navigate to `Systems`, click the client to base your profile off, and navigate to the menu:Systems[Software > Packages > Profiles] subtab."
msgstr "Di {webui} {productname}, buka `Systems`, klik klien yang akan dijadikan dasar profil, lalu buka subtab menu:Systems[Software > Packages > Profiles]."

#. type: delimited block =
#: en/modules/client-configuration/pages/package-management.adoc:11
msgid "Click btn:[Create System Profile]."
msgstr "Klik btn:[Create System Profile]."

#. type: delimited block =
#: en/modules/client-configuration/pages/package-management.adoc:12
msgid "Type a name and description for your profile and click btn:[Create Profile]."
msgstr "Masukkan nama dan deskripsi untuk profil Anda, lalu klik btn:[Create Profile]."

#. type: Block title
#: en/modules/client-configuration/pages/package-management.adoc:13
#, no-wrap
msgid "Procedure: Comparing Client Packages"
msgstr "Prosedur: Membandingkan Paket Klien"

#. type: delimited block =
#: en/modules/client-configuration/pages/package-management.adoc:14
msgid "In the {productname} {webui}, navigate to `Systems`, click the client to compare, and navigate to the menu:Systems[Software > Packages > Profiles] subtab."
msgstr "Di {webui} {productname}, buka `Systems`, klik klien yang akan dibandingkan, lalu buka subtab menu:Systems[Software > Packages > Profiles]."

#. type: delimited block =
#: en/modules/client-configuration/pages/package-management.adoc:15
msgid "To compare with a stored profile, select the profile and click btn:[Compare]."
msgstr "Untuk membandingkan dengan profil tersimpan, pilih profil tersebut, lalu klik btn:[Compare]."

#. type: delimited block =
#: en/modules/client-configuration/pages/package-management.adoc:16
msgid "To compare with another client, select the client name and click btn:[Compare] to see a list of differences between the two clients."
msgstr "Untuk membandingkan dengan klien lain, pilih nama klien, lalu klik btn:[Compare] untuk melihat daftar perbedaan antara kedua klien."

#. type: Title ==
#: en/modules/client-configuration/pages/package-management.adoc:17
#, no-wrap
msgid "Orphaned Packages"
msgstr "Paket Tanpa Saluran"

#. type: delimited block =
#: en/modules/client-configuration/pages/package-management.adoc:18
msgid "Orphaned packages are packages synchronized by {productname} that are not associated with a software channel.  Therefore, orphaned packages are usually not available to {productname} clients and users cannot install such packages without additional effort."
msgstr "Paket tanpa saluran adalah paket yang disinkronkan oleh {productname} tetapi tidak dikaitkan dengan saluran perangkat lunak.  Oleh karena itu, paket tanpa saluran biasanya tidak tersedia bagi klien {productname} dan pengguna tidak dapat memasang paket tersebut tanpa langkah tambahan."

#. type: delimited block =
#: en/modules/client-configuration/pages/package-management.adoc:19
msgid "A package can become orphaned as a result of one of the following events:"
msgstr "Paket dapat menjadi tidak terkait dengan saluran akibat salah satu peristiwa berikut:"

#. type: delimited block =
#: en/modules/client-configuration/pages/package-management.adoc:20
msgid "A synchronized repository removes a package.  By default, {productname} unlinks such a package from the channel, but does not remove the package."
msgstr "Repositori yang disinkronkan menghapus paket.  Secara default, {productname} memutus kaitan paket tersebut dari saluran, tetapi tidak menghapus paketnya."

#. type: delimited block =
#: en/modules/client-configuration/pages/package-management.adoc:21
msgid "A repository supersedes a package with a newer version and thus removes the previous version."
msgstr "Repositori menggantikan paket dengan versi yang lebih baru sehingga versi sebelumnya dihapus."

#. type: delimited block =
#: en/modules/client-configuration/pages/package-management.adoc:22
msgid "The reposync process got interrupted (for example, because of an out of space exception) and thus downloaded packages were not associated with a channel."
msgstr "Proses reposync terhenti (misalnya, karena kesalahan akibat ruang penyimpanan habis) sehingga paket yang diunduh tidak dikaitkan dengan saluran."

#. type: delimited block =
#: en/modules/client-configuration/pages/package-management.adoc:23
msgid "Users manually uploaded packages, but did not associate them with any channel."
msgstr "Pengguna mengunggah paket secara manual, tetapi tidak mengaitkannya dengan saluran apa pun."

#. type: delimited block =
#: en/modules/client-configuration/pages/package-management.adoc:24
msgid "Orphaned packages cost space in user environment and cannot be easily distributed to clients because they are not associated with a channel.  Orphaned package can make sense with specific workflows like bootstrapping or customer-specific procedures."
msgstr "Paket tanpa saluran menggunakan ruang penyimpanan di lingkungan pengguna dan tidak dapat didistribusikan dengan mudah ke klien karena tidak dikaitkan dengan saluran.  Paket tanpa saluran dapat berguna dalam alur kerja tertentu, seperti proses bootstrap atau prosedur khusus pelanggan."

#. type: delimited block =
#: en/modules/client-configuration/pages/package-management.adoc:25
msgid "You can view orphaned packages in the {webui} by clicking menu:Software[Manage > Packages > view Packages in no channel]."
msgstr "Anda dapat melihat paket tanpa saluran di {webui} dengan mengeklik menu:Software[Manage > Packages > view Packages in no channel]."

#. type: delimited block =
#: en/modules/client-configuration/pages/package-management.adoc:26
msgid "{productname} periodically runs a taskomatic job that searches for orphaned packages and modifies the package organization ID to 1.  This means that you can delete orphaned packages only after the taskomatic job execution.  If you encounter an orphaned package that you cannot delete, wait 24 hours and try the deletion again."
msgstr "{productname} secara berkala menjalankan tugas taskomatic yang mencari paket tanpa saluran dan mengubah ID organisasi paket menjadi 1.  Artinya, Anda hanya dapat menghapus paket tanpa saluran setelah tugas taskomatic dijalankan.  Jika Anda menemukan paket tanpa saluran yang tidak dapat dihapus, tunggu 24 jam dan coba hapus kembali."

#.  .Procedure: Deleting orphaned packages
#. type: delimited block =
#: en/modules/client-configuration/pages/package-management.adoc:27
msgid "Delete orphaned packages:"
msgstr "Hapus paket tanpa saluran:"

#.  * With the UI (FIXME is this possible?  How?
#. type: delimited block =
#: en/modules/client-configuration/pages/package-management.adoc:28
msgid "with command line tools targeting individual packages. For example:"
msgstr "dengan alat baris perintah yang menargetkan paket satu per satu. Misalnya:"

#. type: delimited block -
#: en/modules/client-configuration/pages/package-management.adoc:29
#, no-wrap
msgid "spacecmd package_remove zypper-1.14.52-150400.1.9.x86_64\n"
msgstr "spacecmd package_remove zypper-1.14.52-150400.1.9.x86_64\n"

#. type: Plain text
#: en/modules/client-configuration/pages/package-management.adoc:30
msgid "with command line tools targeting all orphaned packages at once:"
msgstr "dengan alat baris perintah yang menargetkan semua paket tanpa saluran sekaligus:"

#. type: delimited block -
#: en/modules/client-configuration/pages/package-management.adoc:31
#, no-wrap
msgid "spacecmd package_removeorphans\n"
msgstr "spacecmd package_removeorphans\n"

#. type: Title =
#: en/modules/client-configuration/pages/patch-management.adoc:1
#, no-wrap
msgid "Patch Management"
msgstr "Pengelolaan Patch"

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:2
msgid "You can use custom patches within your organization to manage clients.  This allows you to issue patch alerts for packages in custom channels, schedule patch installation, and manage patches across organizations."
msgstr "Anda dapat menggunakan patch khusus di dalam organisasi untuk mengelola klien.  Dengan demikian, Anda dapat menerbitkan pemberitahuan patch untuk paket dalam saluran khusus, menjadwalkan pemasangan patch, dan mengelola patch lintas organisasi."

#. type: Title ==
#: en/modules/client-configuration/pages/patch-management.adoc:3
#, no-wrap
msgid "Create Patches"
msgstr "Membuat Patch"

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:4
msgid "To use a custom patch, you need to create the patch, add packages to it and add it to one or more channels."
msgstr "Untuk menggunakan patch khusus, Anda perlu membuat patch, menambahkan paket ke dalamnya, dan menambahkannya ke satu atau beberapa saluran."

#. type: Block title
#: en/modules/client-configuration/pages/patch-management.adoc:5
#, no-wrap
msgid "Procedure: Creating a Custom Patch"
msgstr "Prosedur: Membuat Patch Khusus"

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:6
msgid "In the {productname} {webui}, navigate to menu:Patches[Manage Patches], click btn:[Create Patch]."
msgstr "Di {webui} {productname}, buka menu:Patches[Manage Patches], lalu klik btn:[Create Patch]."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:7
msgid "In the `Create Patch` section, use these details:"
msgstr "Di bagian `Create Patch`, gunakan detail berikut:"

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:8
msgid "In the `Synopsis` field, type a short description of the patch."
msgstr "Di kolom `Synopsis`, masukkan deskripsi singkat tentang patch."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:9
msgid "In the `Advisory` field, type a label for the patch."
msgstr "Di kolom `Advisory`, masukkan label untuk patch."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:10
msgid "We recommend you devise a naming convention for your organization to make patch management easier."
msgstr "Sebaiknya tetapkan konvensi penamaan untuk organisasi Anda agar manajemen patch lebih mudah."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:11
msgid "In the `Advisory Release` field, enter a release number for your patch."
msgstr "Di kolom `Advisory Release`, masukkan nomor rilis untuk patch Anda."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:12
msgid "For example, if this is the first version of this patch, use `1`."
msgstr "Misalnya, jika ini merupakan versi pertama patch tersebut, gunakan `1`."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:13
msgid "In the `Advisory Type` field, select the type of patch to use."
msgstr "Di kolom `Advisory Type`, pilih jenis patch yang akan digunakan."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:14
msgid "For example, `Bug Fix Advisory` for a patch that fixes errors."
msgstr "Misalnya, `Bug Fix Advisory` untuk patch yang memperbaiki kesalahan."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:15
msgid "If you selected an advisory type of `Security Advisory`, in the `Advisory Severity` field, select the severity level to use."
msgstr "Jika Anda memilih jenis pemberitahuan `Security Advisory`, pilih tingkat keparahan yang akan digunakan di kolom `Advisory Severity`."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:16
msgid "In the `Product` field, type the name of the product this patch refers to."
msgstr "Di kolom `Product`, masukkan nama produk yang terkait dengan patch ini."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:17
msgid "OPTIONAL: In the `Author` field, type the name of the author of the patch."
msgstr "OPSIONAL: Di kolom `Author`, masukkan nama pembuat patch."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:18
msgid "Complete the `Topic`, `Description`, and `Solution` fields with further information about the patch."
msgstr "Lengkapi kolom `Topic`, `Description`, dan `Solution` dengan informasi lebih lanjut tentang patch."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:19
msgid "OPTIONAL: In the `Bugs` section, specify the information of any related bugs, using these details:"
msgstr "OPSIONAL: Di bagian `Bugs`, tentukan informasi tentang bug terkait menggunakan detail berikut:"

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:20
msgid "In the `ID` field, enter the bug number."
msgstr "Di kolom `ID`, masukkan nomor bug."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:21
msgid "In the `Summary` field, type a short description of the bug."
msgstr "Di kolom `Summary`, masukkan deskripsi singkat tentang bug."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:22
msgid "In the `Bugzilla URL` field, type the address of the bug."
msgstr "Di kolom `Bugzilla URL`, masukkan alamat bug."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:23
msgid "In the `Keywords` field, type any keywords related to the bug."
msgstr "Di kolom `Keywords`, masukkan kata kunci yang terkait dengan bug."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:24
msgid "Use a comma between each keyword."
msgstr "Pisahkan setiap kata kunci dengan koma."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:25
msgid "Complete the `References` and `Notes` fields with further information about the bug."
msgstr "Lengkapi kolom `References` dan `Notes` dengan informasi lebih lanjut tentang bug."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:26
msgid "Select one or more channels to add the new patch to."
msgstr "Pilih satu atau beberapa saluran untuk menambahkan patch baru."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:27
msgid "Click btn:[Create Patch]."
msgstr "Klik btn:[Create Patch]."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:28
msgid "You can also create patches by cloning an existing one.  Cloning preserves package associations and simplifies issuing patches."
msgstr "Anda juga dapat membuat patch dengan mengkloning patch yang sudah ada. Pengkloningan mempertahankan kaitan paket dan menyederhanakan penerbitan patch."

#. type: Block title
#: en/modules/client-configuration/pages/patch-management.adoc:29
#, no-wrap
msgid "Procedure: Cloning Patches"
msgstr "Prosedur: Mengkloning Patch"

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:30
msgid "In the {productname} {webui}, navigate to menu:Patches[Clone Patches]."
msgstr "Di {webui} {productname}, buka menu:Patches[Clone Patches]."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:31
msgid "In the `View patches potentially applicable to:` field, select the software channel for the patch you want to clone."
msgstr "Di kolom `View patches potentially applicable to:`, pilih saluran perangkat lunak untuk patch yang ingin Anda kloning."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:32
msgid "Select the patch or patches you want to clone, and click btn:[Clone Patches]."
msgstr "Pilih satu atau beberapa patch yang ingin Anda kloning, lalu klik btn:[Clone Patches]."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:33
msgid "Select one or more channels to add the cloned patch to."
msgstr "Pilih satu atau beberapa saluran untuk menambahkan patch hasil kloning."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:34
msgid "Confirm the details to begin the clone."
msgstr "Konfirmasikan detailnya untuk memulai pengkloningan."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:35
msgid "When you have created a patch, you can assign packages to it."
msgstr "Setelah membuat patch, Anda dapat menetapkan paket ke patch tersebut."

#. type: Block title
#: en/modules/client-configuration/pages/patch-management.adoc:36
#, no-wrap
msgid "Procedure: Assigning Packages to a Patch"
msgstr "Prosedur: Menetapkan Paket ke Patch"

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:37
msgid "In the {productname} {webui}, navigate to menu:Patches[Manage Patches], and click the advisory name of the patch to see the patch details."
msgstr "Di {webui} {productname}, buka menu:Patches[Manage Patches], lalu klik nama pemberitahuan patch untuk melihat detail patch."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:38
msgid "Navigate to the menu:Packages[Add] tab."
msgstr "Buka tab menu:Packages[Add]."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:39
msgid "In the `Channel` field, select the software channel that contains the packages you want to assign to the patch, and click btn:[View Packages]."
msgstr "Di kolom `Channel`, pilih saluran perangkat lunak yang berisi paket yang ingin Anda tetapkan ke patch, lalu klik btn:[View Packages]."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:40
msgid "You can select `All managed packages` to see the available packages in all channels."
msgstr "Anda dapat memilih `All managed packages` untuk melihat paket yang tersedia di semua saluran."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:41
msgid "Check the packages you want to include, and click btn:[Add Packages]."
msgstr "Centang paket yang ingin Anda sertakan, lalu klik btn:[Add Packages]."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:42
msgid "Confirm the details of the packages, and click btn:[Confirm] to assign them to the patch."
msgstr "Konfirmasikan detail paket, lalu klik btn:[Confirm] untuk menetapkannya ke patch."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:43
msgid "Navigate to the menu:Packages[List/Remove] tab to check that the packages have been assigned correctly."
msgstr "Buka tab menu:Packages[List/Remove] untuk memastikan paket telah ditetapkan dengan benar."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:44
msgid "When packages are assigned to a patch, the patch cache is updated to reflect the changes.  The cache update might take a couple of minutes."
msgstr "Saat paket ditetapkan ke patch, cache patch diperbarui untuk mencerminkan perubahan tersebut.  Pembaruan cache dapat memerlukan waktu beberapa menit."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:45
msgid "If you need to change the details of an existing patch, you can do so from the `Patches Management` page."
msgstr "Jika Anda perlu mengubah detail patch yang sudah ada, Anda dapat melakukannya dari halaman `Patches Management`."

#. type: Block title
#: en/modules/client-configuration/pages/patch-management.adoc:46
#, no-wrap
msgid "Procedure: Editing and Deleting Existing Patch Alerts"
msgstr "Prosedur: Mengedit dan Menghapus Pemberitahuan Patch yang Sudah Ada"

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:47
msgid "In the {productname} {webui}, navigate to menu:Patches[Manage Patches]."
msgstr "Di {webui} {productname}, buka menu:Patches[Manage Patches]."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:48
msgid "Click the advisory name of the patch to see the patch details."
msgstr "Klik nama pemberitahuan patch untuk melihat detail patch."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:49
msgid "Make the changes as required, and click btn:[Update Patch]."
msgstr "Lakukan perubahan sesuai kebutuhan, lalu klik btn:[Update Patch]."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:50
msgid "To delete a patch, select the patch in the `Patches Management` page, and click btn:[Delete Patches]."
msgstr "Untuk menghapus patch, pilih patch di halaman `Patches Management`, lalu klik btn:[Delete Patches]."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:51
msgid "Deleting patches might take a few minutes."
msgstr "Penghapusan patch dapat memerlukan waktu beberapa menit."

#. type: Title ==
#: en/modules/client-configuration/pages/patch-management.adoc:52
#, no-wrap
msgid "Apply Patches to Clients"
msgstr "Menerapkan Patch pada Klien"

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:53
msgid "When a patch is ready, you can apply it to clients either singly, or with other patches."
msgstr "Setelah patch siap, Anda dapat menerapkannya pada klien secara terpisah atau bersama patch lain."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:54
msgid "Each package within a patch is part of one or more channels.  If the client is not subscribed to the channel, the update is not installed."
msgstr "Setiap paket di dalam patch merupakan bagian dari satu atau beberapa saluran.  Jika klien tidak berlangganan saluran tersebut, pembaruan tidak akan dipasang."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:55
msgid "If the client has a more recent version of a package already installed, the update is not installed.  If the client has an older version of the package installed, the package is upgraded."
msgstr "Jika klien sudah memiliki versi paket yang lebih baru, pembaruan tidak akan dipasang.  Jika klien memiliki versi paket yang lebih lama, versi paket akan ditingkatkan."

#. type: Block title
#: en/modules/client-configuration/pages/patch-management.adoc:56
#, no-wrap
msgid "Procedure: Applying All Applicable Patches"
msgstr "Prosedur: Menerapkan Semua Patch yang Berlaku"

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:57
msgid "In the {productname} {webui}, navigate to menu:Systems[Overview] and select the client you want to update."
msgstr "Di {webui} {productname}, buka menu:Systems[Overview] dan pilih klien yang ingin Anda perbarui."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:58
msgid "Navigate to the menu:Software[Patches] tab."
msgstr "Buka tab menu:Software[Patches]."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:59
msgid "Click btn:[Select All] to select all applicable patches."
msgstr "Klik btn:[Select All] untuk memilih semua patch yang berlaku."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:60
msgid "Click btn:[Apply Patches] to update the client."
msgstr "Klik btn:[Apply Patches] untuk memperbarui klien."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:61
msgid "If you are signed in with Administrator privileges, you can also perform larger batch upgrades for clients."
msgstr "Jika Anda masuk dengan hak istimewa Administrator, Anda juga dapat melakukan peningkatan versi secara massal untuk lebih banyak klien."

#. type: Block title
#: en/modules/client-configuration/pages/patch-management.adoc:62
#, no-wrap
msgid "Procedure: Applying a Single Patch to Multiple Clients"
msgstr "Prosedur: Menerapkan Satu Patch pada Beberapa Klien"

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:63
msgid "In the {productname} {webui}, navigate to menu:Patches[Patch List]."
msgstr "Di {webui} {productname}, buka menu:Patches[Patch List]."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:64
msgid "Locate the patch you want to apply, and click the number under the `Systems` column for that patch."
msgstr "Temukan patch yang ingin Anda terapkan, lalu klik angka di kolom `Systems` untuk patch tersebut."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:65
msgid "Select the clients you want to apply the patch to, and click btn:[Apply Patches]."
msgstr "Pilih klien yang ingin Anda terapkan patch, lalu klik btn:[Apply Patches]."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:66
msgid "Confirm the list of clients to perform the update."
msgstr "Konfirmasikan daftar klien untuk menjalankan pembaruan."

#. type: Block title
#: en/modules/client-configuration/pages/patch-management.adoc:67
#, no-wrap
msgid "Procedure: Applying Multiple Patches to Multiple Clients"
msgstr "Prosedur: Menerapkan Beberapa Patch pada Beberapa Klien"

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:68
msgid "In the {productname} {webui}, navigate to menu:Systems[Overview] and check the clients you want to update to add them to the system set manager."
msgstr "Di {webui} {productname}, buka menu:Systems[Overview] dan centang klien yang ingin Anda perbarui untuk menambahkannya ke System Set Manager."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:69
msgid "Navigate to menu:Systems[System Set Manager] and naviagte to the `Patches` tab."
msgstr "Buka menu:Systems[System Set Manager], lalu buka tab `Patches`."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:70
msgid "Select the patches you want to apply to the clients and click btn:[Apply Patches]."
msgstr "Pilih patch yang ingin Anda terapkan pada klien, lalu klik btn:[Apply Patches]."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:71
msgid "Schedule a date and time for the update to occur, and click btn:[Confirm]."
msgstr "Jadwalkan tanggal dan waktu pelaksanaan pembaruan, lalu klik btn:[Confirm]."

#. type: Plain text
#: en/modules/client-configuration/pages/patch-management.adoc:72
msgid "To check the progress of the update, navigate to menu:Schedule[Pending Actions]."
msgstr "Untuk memeriksa progres pembaruan, buka menu:Schedule[Pending Actions]."

#. type: delimited block =
#: en/modules/client-configuration/pages/patch-management.adoc:73
msgid "Scheduled package updates are installed using the contact method configured for each client.  For more information, see xref:client-configuration:contact-methods-intro.adoc[]."
msgstr "Pembaruan paket terjadwal dipasang menggunakan metode kontak yang dikonfigurasi untuk setiap klien.  Untuk informasi selengkapnya, lihat xref:client-configuration:contact-methods-intro.adoc[]."

#. type: Title =
#: en/modules/client-configuration/pages/power-management.adoc:1
#, no-wrap
msgid "Power Management"
msgstr "Pengelolaan Daya"

#. type: Plain text
#: en/modules/client-configuration/pages/power-management.adoc:3
msgid "You can power on, power off, and reboot clients using the {productname} {webui}."
msgstr "Anda dapat menyalakan, mematikan, dan memulai ulang klien melalui {webui} {productname}."

#. type: Plain text
#: en/modules/client-configuration/pages/power-management.adoc:4
msgid "This feature uses either the IPMI or Redfish protocol and is managed using a {cobbler} profile.  The selected client must have a power management controller supporting one of these protocols."
msgstr "Fitur ini menggunakan protokol IPMI atau Redfish dan dikelola menggunakan profil {cobbler}.  Klien yang dipilih harus memiliki pengontrol manajemen daya yang mendukung salah satu protokol tersebut."

#. type: Plain text
#: en/modules/client-configuration/pages/power-management.adoc:5
msgid "For Redfish, ensure you can establish a valid SSL connection between the client and the {productname} Server.  You must have trusted the certificate authority used to sign the SSL Server Certificate of the Redfish management controller.  The CA certificate must be in `.pem` format, and stored on the {productname} Server at `/etc/pki/trust/anchors/`.  When you have saved the certificate, run `update-ca-certificate`."
msgstr "Untuk Redfish, pastikan Anda dapat membuat koneksi SSL yang valid antara klien dan {productname} Server.  Anda harus sudah memercayai otoritas sertifikat yang digunakan untuk menandatangani Sertifikat Server SSL pengontrol manajemen Redfish.  Sertifikat CA harus berformat `.pem` dan disimpan pada {productname} Server di `/etc/pki/trust/anchors/`.  Setelah menyimpan sertifikat, jalankan `update-ca-certificate`."

#. type: Block title
#: en/modules/client-configuration/pages/power-management.adoc:6
#, no-wrap
msgid "Procedure: Enabling Power Management"
msgstr "Prosedur: Mengaktifkan Manajemen Daya"

#. type: Plain text
#: en/modules/client-configuration/pages/power-management.adoc:7
msgid "In the {productname} {webui}, navigate to menu:Systems[Systems List], select the client you want to manage, and navigate to the menu:Provisioning[Power Management] tab."
msgstr "Di {webui} {productname}, buka menu:Systems[Systems List], pilih klien yang ingin Anda kelola, lalu buka tab menu:Provisioning[Power Management]."

#. type: Plain text
#: en/modules/client-configuration/pages/power-management.adoc:8
msgid "In the `Type` field, select the power management protocol to use."
msgstr "Di kolom `Type`, pilih protokol manajemen daya yang akan digunakan."

#. type: Plain text
#: en/modules/client-configuration/pages/power-management.adoc:9
msgid "Complete the details for the power management server, and click the appropriate button for the action to take, or click btn:[Save only] to save the details without taking any action."
msgstr "Lengkapi detail server manajemen daya, lalu klik tombol yang sesuai dengan tindakan yang akan dilakukan, atau klik btn:[Save only] untuk menyimpan detail tanpa melakukan tindakan apa pun."

#. type: Plain text
#: en/modules/client-configuration/pages/power-management.adoc:10
msgid "You can apply power management actions to multiple clients at the same time by adding them to the system set manager.  For more information about using the system set manager, see xref:client-configuration:system-set-manager.adoc[]."
msgstr "Anda dapat menerapkan tindakan manajemen daya pada beberapa klien sekaligus dengan menambahkannya ke System Set Manager.  Untuk informasi selengkapnya tentang penggunaan System Set Manager, lihat xref:client-configuration:system-set-manager.adoc[]."

#. type: Title ==
#: en/modules/client-configuration/pages/power-management.adoc:11
#, no-wrap
msgid "Power Management and {cobbler}"
msgstr "Manajemen Daya dan {cobbler}"

#. type: Plain text
#: en/modules/client-configuration/pages/power-management.adoc:12
msgid "The first time you use a power management feature, a {cobbler} system record is automatically created, if one does not yet exist for the client.  These automatically created system records are not bootable from the network, and include a reference to a dummy system image.  This is needed because {cobbler} does not currently support system records without profiles or images."
msgstr "Saat pertama kali Anda menggunakan fitur manajemen daya, rekaman sistem {cobbler} dibuat secara otomatis jika belum tersedia untuk klien tersebut.  Rekaman sistem yang dibuat secara otomatis ini tidak dapat digunakan untuk melakukan boot melalui jaringan dan menyertakan referensi ke image sistem dummy.  Hal ini diperlukan karena {cobbler} saat ini tidak mendukung rekaman sistem tanpa profil atau image."

#. type: Plain text
#: en/modules/client-configuration/pages/power-management.adoc:13
msgid "{cobbler} power management uses fence-agent tools to support protocols other than IPMI.  Only IPMI and Redfish protocols are supported by {productname}.  You can configure your client to use other protocols by adding the fence-agent names as a comma-separated list to the `java.power_management.types` configuration parameter in the `rhn.conf` configuration files."
msgstr "Manajemen daya {cobbler} menggunakan alat fence-agent untuk mendukung protokol selain IPMI.  Hanya protokol IPMI dan Redfish yang didukung oleh {productname}.  Anda dapat mengonfigurasi klien untuk menggunakan protokol lain dengan menambahkan nama fence-agent sebagai daftar yang dipisahkan koma ke parameter konfigurasi `java.power_management.types` dalam berkas konfigurasi `rhn.conf`."

#. type: Title =
#: en/modules/client-configuration/pages/products.adoc:1
#, no-wrap
msgid "Software Products"
msgstr "Produk Perangkat Lunak"

#. type: Plain text
#: en/modules/client-configuration/pages/products.adoc:2
msgid "In {productname}, software is made available in products.  Your {suse} subscription allows you to access a range of different products, which you can browse and select in the {productname} {webui} by navigating to menu:Admin[Setup Wizard > Products]."
msgstr "Di {productname}, perangkat lunak disediakan dalam bentuk produk.  Langganan {suse} Anda memungkinkan akses ke berbagai produk yang dapat Anda telusuri dan pilih di {webui} {productname} dengan membuka menu:Admin[Setup Wizard > Products]."

#. type: Plain text
#: en/modules/client-configuration/pages/products.adoc:3
msgid "Products contain any number of software channels.  Click the `Show product's channels` icon to see the channels included in the product.  When you have added a product and synchronized successfully, you have access to the channels provided by the product, and can use the packages in the product on your {productname} Server and clients."
msgstr "Produk dapat berisi sejumlah saluran perangkat lunak.  Klik ikon `Show product's channels` untuk melihat saluran yang disertakan dalam produk.  Setelah Anda menambahkan produk dan berhasil melakukan sinkronisasi, Anda dapat mengakses saluran yang disediakan oleh produk tersebut serta menggunakan paket di dalamnya pada {productname} Server dan klien."

#. type: Title =
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:1
#, no-wrap
msgid "Register Clients With a Bootstrap Script"
msgstr "Mendaftarkan Klien dengan Skrip Bootstrap"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:3
msgid "Registering clients with a bootstrap script gives you control over parameters, and can help if you have to register a large number of clients at once."
msgstr "Pendaftaran klien dengan skrip bootstrap memberi Anda kendali atas parameter dan dapat membantu jika Anda perlu mendaftarkan banyak klien sekaligus."

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:4
msgid "To register clients using a bootstrap script, we recommend you create a template bootstrap script to begin, which can then be copied and modified.  The bootstrap script you create is executed on the client when it is registered, and ensures all the necessary packages are deployed to the client.  Some parameters in the bootstrap script ensure the client system can be assigned to its base channel, using activation key and GPG key."
msgstr "Untuk mendaftarkan klien menggunakan skrip bootstrap, sebaiknya buat templat skrip bootstrap terlebih dahulu yang kemudian dapat disalin dan dimodifikasi.  Skrip bootstrap yang Anda buat dijalankan pada klien saat pendaftaran dan memastikan semua paket yang diperlukan diterapkan pada klien.  Beberapa parameter dalam skrip bootstrap memastikan sistem klien dapat ditetapkan ke saluran dasarnya menggunakan kunci aktivasi dan kunci GPG."

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:5
msgid "It is important that you check the repository information carefully, to ensure it matches the base channel repository.  If the repository information does not match exactly, the bootstrap script cannot download the correct packages."
msgstr "Anda harus memeriksa informasi repositori dengan cermat untuk memastikan kesesuaiannya dengan repositori saluran dasar.  Jika informasi repositori tidak sama persis, skrip bootstrap tidak dapat mengunduh paket yang benar."

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:6
msgid "Additional considerations:"
msgstr "Hal lain yang perlu diperhatikan:"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:7
msgid "All clients need a bootstrap repository.  It is automatically created and regenerated on the {productname} Server when products are synchronized.  A bootstrap repository includes packages for installing {salt} on clients, and for registering clients.  For more information about creating a bootstrap repository, see xref:client-configuration:bootstrap-repository.adoc[]."
msgstr "Semua klien memerlukan repositori bootstrap.  Repositori ini dibuat dan dibuat ulang secara otomatis pada {productname} Server saat produk disinkronkan.  Repositori bootstrap menyertakan paket untuk memasang {salt} pada klien dan untuk mendaftarkan klien.  Untuk informasi selengkapnya tentang pembuatan repositori bootstrap, lihat xref:client-configuration:bootstrap-repository.adoc[]."

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:8
msgid "openSUSE Leap 15 and SLE 15 use Python 3 by default.  Bootstrap scripts based on Python 2 must be re-created for openSUSE Leap 15 and SLE 15 systems.  If you register openSUSE Leap 15 or SLE 15 systems using Python 2, the bootstrap script fails."
msgstr "openSUSE Leap 15 dan SLE 15 menggunakan Python 3 secara default.  Skrip bootstrap berbasis Python 2 harus dibuat ulang untuk sistem openSUSE Leap 15 dan SLE 15.  Jika Anda mendaftarkan sistem openSUSE Leap 15 atau SLE 15 menggunakan Python 2, skrip bootstrap akan gagal."

#. type: Block title
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:9
#, no-wrap
msgid "GPG keys and Uyuni client tools"
msgstr "Kunci GPG dan alat klien Uyuni"

#. type: delimited block =
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:10
msgid "The GPG key used by Uyuni Client Tools is not trusted by default.  When you create your bootstrap script, add a path to the file containing the public key fingerprint with the `ORG_GPG_KEY` parameter."
msgstr "Kunci GPG yang digunakan oleh Uyuni Client Tools tidak dipercaya secara default.  Saat membuat skrip bootstrap, tambahkan lokasi berkas yang berisi sidik jari kunci publik menggunakan parameter `ORG_GPG_KEY`."

#. type: delimited block =
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:11
#: en/modules/client-configuration/pages/registration-overview.adoc:11
msgid "After migrating from an older version of {productname} to a newer version, we strongly recommend re-generating the bootstrap scripts before onboarding new systems to prevent any potential issues."
msgstr "Setelah melakukan migrasi dari versi {productname} yang lebih lama ke versi yang lebih baru, kami sangat menyarankan agar skrip bootstrap dibuat ulang sebelum mendaftarkan sistem baru untuk mencegah potensi masalah."

#. type: delimited block =
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:12
msgid "To access a shell inside the server container run `mgrctl term` on the container host.  From there, one can run the CLI tools as usual."
msgstr "Untuk mengakses shell di dalam kontainer server, jalankan `mgrctl term` pada host kontainer.  Dari sana, Anda dapat menjalankan alat CLI seperti biasa."

#. type: Title ==
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:13
#, no-wrap
msgid "Create a bootstrap script with `mgr-bootstrap`"
msgstr "Membuat skrip bootstrap dengan `mgr-bootstrap`"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:14
msgid "The `mgr-bootstrap` command generates custom bootstrap scripts.  A bootstrap script is used by {productname} client systems for simplifying their initial registration and configuration."
msgstr "Perintah `mgr-bootstrap` menghasilkan skrip bootstrap khusus.  Skrip bootstrap digunakan oleh sistem klien {productname} untuk menyederhanakan pendaftaran dan konfigurasi awalnya."

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:15
msgid "The arguments `--activation-keys` and `--script`, are the only mandatory arguments.  On the {productname} Server, as root at the command line execute it with the mandatory arguments.  Replace `<ACTIVATION_KEY` and `<EDITED_NAME>` with your values:"
msgstr "Argumen `--activation-keys` dan `--script` merupakan satu-satunya argumen wajib.  Pada {productname} Server, jalankan perintah tersebut dengan argumen wajib sebagai root melalui baris perintah.  Ganti `<ACTIVATION_KEY` dan `<EDITED_NAME>` dengan nilai Anda:"

#. type: delimited block _
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:16
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:41
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:63
msgid "From the command prompt of the {productname} container host, run the following command as the root user to enter the server container:"
msgstr "Dari prompt perintah host kontainer {productname}, jalankan perintah berikut sebagai pengguna root untuk masuk ke kontainer server:"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:18
msgid "Execute the following command (adjust the values as needed)"
msgstr "Jalankan perintah berikut (sesuaikan nilainya jika diperlukan)"

#. type: delimited block -
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:19
#, no-wrap
msgid "mgr-bootstrap --activation-keys=<ACTIVATION_KEY> --script=bootstrap-<EDITED_NAME>.sh\n"
msgstr "mgr-bootstrap --activation-keys=<ACTIVATION_KEY> --script=bootstrap-<EDITED_NAME>.sh\n"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:20
msgid "The `mgr-bootstrap` command offers several other options, including the ability to set a specific hostname, set specific GPG keys, and set the registration method (salt-minion or salt-bundle)."
msgstr "Perintah `mgr-bootstrap` menyediakan beberapa opsi lain, termasuk kemampuan untuk menetapkan nama host tertentu, menetapkan kunci GPG tertentu, dan menetapkan metode pendaftaran (salt-minion atau salt-bundle)."

#. type: delimited block =
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:21
msgid "If you wish to create a bootstrap script to register against the Proxy, you can do so by using the following command from the Server container:"
msgstr "Jika Anda ingin membuat skrip bootstrap untuk mendaftar melalui Proxy, gunakan perintah berikut dari kontainer Server:"

#. type: delimited block -
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:22
#, no-wrap
msgid "mgr-boostrap --hostname <PROXY_FQDN>\n"
msgstr "mgr-boostrap --hostname <PROXY_FQDN>\n"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:23
msgid "This command will create a new bootstrap script with default name `bootstrap.sh` and it will overwrite the existing `bootstrap.sh` file which is used for the Server."
msgstr "Perintah ini akan membuat skrip bootstrap baru dengan nama default `bootstrap.sh` dan menimpa berkas `bootstrap.sh` yang sudah ada yang digunakan untuk Server."

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:24
msgid "To specify a different script, use the following comamnd:"
msgstr "Untuk menentukan skrip yang berbeda, gunakan perintah berikut:"

#. type: delimited block -
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:25
#, no-wrap
msgid "mgr-bootstrap --hostname <PROXY_FQDN> --script=boostrap-<PROXY-SCRIPT>.sh\n"
msgstr "mgr-bootstrap --hostname <PROXY_FQDN> --script=boostrap-<PROXY-SCRIPT>.sh\n"

#. type: delimited block =
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:26
msgid "For more information, see the `mgr-bootstrap` man page, or run `mgr-bootstrap --help`."
msgstr "Untuk informasi selengkapnya, lihat halaman manual `mgr-bootstrap`, atau jalankan `mgr-bootstrap --help`."

#. type: Title ==
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:27
#, no-wrap
msgid "Create a bootstrap script from {webui}"
msgstr "Membuat skrip bootstrap melalui {webui}"

#. type: delimited block =
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:28
msgid "You can use the {productname} {webui} to create an editable bootstrap script."
msgstr "Anda dapat menggunakan {webui} {productname} untuk membuat skrip bootstrap yang dapat diedit."

#.  2022-10-26, ke: In step 2, check whether we can use {productname} macro.
#. type: Block title
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:29
#, no-wrap
msgid "Procedure: Creating a bootstrap script"
msgstr "Prosedur: Membuat skrip bootstrap"

#. type: delimited block _
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:30
msgid "In the {productname} {webui}, navigate to menu:Admin[Manager Configuration > Bootstrap Script]."
msgstr "Di {webui} {productname}, buka menu:Admin[Manager Configuration > Bootstrap Script]."

#. type: delimited block _
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:31
msgid "The required fields are pre-populated with values derived from previous installation steps.  For details on each setting, see xref:reference:admin/bootstrap-script.adoc[]."
msgstr "Kolom wajib telah diisi dengan nilai yang diperoleh dari langkah-langkah pemasangan sebelumnya.  Untuk detail setiap pengaturan, lihat xref:reference:admin/bootstrap-script.adoc[]."

#. type: delimited block _
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:32
msgid "Click btn:[Update] to create the script."
msgstr "Klik btn:[Update] untuk membuat skrip."

#. type: delimited block _
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:33
msgid "The bootstrap script is generated and stored on the server in the `/srv/www/htdocs/pub/bootstrap` directory.  Alternatively, you can access the bootstrap script over HTTPS.  Replace `<example.com>` with the host name of your {productname} Server:"
msgstr "Skrip bootstrap dibuat dan disimpan pada server di direktori `/srv/www/htdocs/pub/bootstrap`.  Sebagai alternatif, Anda dapat mengakses skrip bootstrap melalui HTTPS.  Ganti `<example.com>` dengan nama host {productname} Server Anda:"

#. type: delimited block -
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:34
#, no-wrap
msgid "https://<example.com>/pub/bootstrap/bootstrap.sh\n"
msgstr "https://<example.com>/pub/bootstrap/bootstrap.sh\n"

#. type: delimited block =
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:35
msgid "Do not disable SSL in your bootstrap script.  Ensure that `Enable SSL` is checked in the {webui}, or that the setting `USING_SSL=1` exists in the bootstrap script.  If you disable SSL, the registration process requires custom SSL certificates."
msgstr "Jangan nonaktifkan SSL dalam skrip bootstrap Anda.  Pastikan `Enable SSL` dicentang di {webui}, atau pengaturan `USING_SSL=1` tersedia dalam skrip bootstrap.  Jika Anda menonaktifkan SSL, proses pendaftaran memerlukan sertifikat SSL khusus."

#. type: delimited block =
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:36
msgid "For more information about custom certificates, see xref:administration:ssl-certs.adoc[]."
msgstr "Untuk informasi selengkapnya tentang sertifikat khusus, lihat xref:administration:ssl-certs.adoc[]."

#. type: Title ==
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:37
#, no-wrap
msgid "Edit a bootstrap script"
msgstr "Mengedit skrip bootstrap"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:38
msgid "You can copy and modify the template bootstrap script you created to customize it.  A minimal requirement when modifying a bootstrap script for use with {productname} is the inclusion of an activation key.  Most packages are signed with GPG, so you also need to have trusted GPG keys on your system to install them."
msgstr "Anda dapat menyalin dan memodifikasi templat skrip bootstrap yang telah dibuat untuk menyesuaikannya.  Persyaratan minimum saat memodifikasi skrip bootstrap untuk digunakan dengan {productname} adalah menyertakan kunci aktivasi.  Sebagian besar paket ditandatangani dengan GPG, sehingga sistem Anda juga harus memiliki kunci GPG tepercaya untuk memasangnya."

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:39
msgid "In this procedure, you need to know the exact name of your activation keys.  Navigate to menu:Home[Overview] and, in the `Tasks` box, click `Manage Activation Keys`.  All keys created for channels are listed on this page.  You must enter the full name of the key you wish to use in the bootstrap script exactly as presented in the key field.  For more information about activation keys, see xref:client-configuration:activation-keys.adoc[]."
msgstr "Dalam prosedur ini, Anda perlu mengetahui nama persis kunci aktivasi Anda.  Buka menu:Home[Overview], lalu di kotak `Tasks`, klik `Manage Activation Keys`.  Semua kunci yang dibuat untuk saluran tercantum di halaman ini.  Anda harus memasukkan nama lengkap kunci yang ingin digunakan dalam skrip bootstrap persis seperti yang ditampilkan di kolom kunci.  Untuk informasi selengkapnya tentang kunci aktivasi, lihat xref:client-configuration:activation-keys.adoc[]."

#. type: Block title
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:40
#, no-wrap
msgid "Procedure: Modifying a bootstrap script"
msgstr "Prosedur: Memodifikasi skrip bootstrap"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:43
msgid "On your {productname} Server, as root at the command line change to the bootstrap directory with:"
msgstr "Pada {productname} Server, sebagai root melalui baris perintah, pindah ke direktori bootstrap dengan:"

#. type: delimited block -
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:44
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:66
#, no-wrap
msgid "cd /srv/www/htdocs/pub/bootstrap/\n"
msgstr "cd /srv/www/htdocs/pub/bootstrap/\n"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:45
msgid "Create and rename two copies of the template bootstrap script for use with each of your clients."
msgstr "Buat dua salinan templat skrip bootstrap dan ubah namanya untuk digunakan pada masing-masing klien Anda."

#. type: delimited block -
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:46
#, no-wrap
msgid ""
"cp bootstrap.sh bootstrap-sles12.sh\n"
"cp bootstrap.sh bootstrap-sles15.sh\n"
msgstr ""
"cp bootstrap.sh bootstrap-sles12.sh\n"
"cp bootstrap.sh bootstrap-sles15.sh\n"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:47
msgid "Open `bootstrap-sles15.sh` for modification."
msgstr "Buka `bootstrap-sles15.sh` untuk dimodifikasi."

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:48
msgid "Scroll down until you can see the text shown below.  If `exit 1` exists in the file, comment it out by typing a hash or pound sign (&#35;) at the beginning of the line.  This activates the script.  Enter the name of the key for this script in the `ACTIVATION_KEYS=` field:"
msgstr "Gulir ke bawah hingga Anda melihat teks yang ditampilkan di bawah ini. Jika `exit 1` terdapat dalam berkas, jadikan baris tersebut sebagai komentar dengan mengetikkan tanda pagar (&#35;) di awal baris.  Tindakan ini mengaktifkan skrip.  Masukkan nama kunci untuk skrip ini di kolom `ACTIVATION_KEYS=`:"

#. type: delimited block -
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:49
#, no-wrap
msgid ""
"echo \"Enable this script: comment (with #'s) this block (or, at least just\"\n"
"echo \"the exit below)\"\n"
"echo\n"
"#exit 1\n"
msgstr ""
"echo \"Aktifkan skrip ini: jadikan blok ini sebagai komentar (dengan #)\"\n"
"echo \"(atau, setidaknya, baris exit di bawah)\"\n"
"echo\n"
"#exit 1\n"

#. type: delimited block -
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:50
#, no-wrap
msgid ""
"# can be edited, but probably correct (unless created during initial install):\n"
"# NOTE: ACTIVATION_KEYS *must* be used to bootstrap a client machine.\n"
"ACTIVATION_KEYS=1-sles15\n"
"ORG_GPG_KEY=\n"
msgstr ""
"# dapat diedit, tetapi kemungkinan sudah benar (kecuali dibuat saat pemasangan awal):\n"
"# CATATAN: ACTIVATION_KEYS *harus* digunakan untuk melakukan bootstrap pada mesin klien.\n"
"ACTIVATION_KEYS=1-sles15\n"
"ORG_GPG_KEY=\n"

#. type: delimited block =
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:51
msgid "Instead of editing the script manually, user can pass the following environment variables at runtime:"
msgstr "Sebagai alternatif dari mengedit skrip secara manual, pengguna dapat meneruskan variabel lingkungan berikut saat skrip dijalankan:"

#. type: delimited block =
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:52
msgid "`ACTIVATION_KEYS`: Activation keys to use for registration"
msgstr "`ACTIVATION_KEYS`: Kunci aktivasi yang digunakan untuk pendaftaran"

#. type: delimited block =
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:53
msgid "`ORG_GPG_KEY`: Path or identifier of the GPG key"
msgstr "`ORG_GPG_KEY`: Lokasi atau pengenal kunci GPG"

#. type: delimited block =
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:54
msgid "`REACTIVATION_KEY`: Reactivation key for previously registered systems. Note that reactivation keys are valid for single-use only."
msgstr "`REACTIVATION_KEY`: Kunci aktivasi ulang untuk sistem yang telah terdaftar sebelumnya. Perhatikan bahwa kunci aktivasi ulang hanya berlaku untuk sekali pakai."

#. type: delimited block =
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:55
msgid "`MGR_SERVER_HOSTNAME`: Hostname of the Server or Proxy to register the client against"
msgstr "`MGR_SERVER_HOSTNAME`: Nama host Server atau Proxy yang digunakan untuk mendaftarkan klien"

#. type: delimited block =
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:56
msgid "Using environment variables allows dynamic input at runtime and makes it easier to reuse the same bootstrap script across different systems or environments."
msgstr "Penggunaan variabel lingkungan memungkinkan masukan dinamis saat skrip dijalankan dan memudahkan penggunaan ulang skrip bootstrap yang sama pada sistem atau lingkungan yang berbeda."

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:57
msgid "When you have finished, save the file, and repeat this procedure for the second bootstrap script."
msgstr "Setelah selesai, simpan berkas, lalu ulangi prosedur ini untuk skrip bootstrap kedua."

#. type: delimited block =
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:58
msgid "By default, bootstrap script will try to install `venv-salt-minion` if it is available in the bootstrap repository and `salt-minion` if there is no {salt} bundle in the bootstrap repository.  It is possible to avoid installing {salt} bundle and keep using `salt-minion` if you need it for some reason."
msgstr "Secara default, skrip bootstrap akan mencoba memasang `venv-salt-minion` jika tersedia di repositori bootstrap, dan `salt-minion` jika tidak ada {salt} bundle di repositori bootstrap.  Anda dapat memilih untuk tidak memasang {salt} bundle dan tetap menggunakan `salt-minion` jika diperlukan karena alasan tertentu."

#. type: delimited block =
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:59
msgid "For more information, see xref:client-configuration:contact-methods-saltbundle.adoc[Salt Bundle]."
msgstr "Untuk informasi selengkapnya, lihat xref:client-configuration:contact-methods-saltbundle.adoc[Salt Bundle]."

#. type: Title ==
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:60
#, no-wrap
msgid "Register clients running the bootstrap script"
msgstr "Mendaftarkan klien dengan menjalankan skrip bootstrap"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:61
msgid "When you have finished creating your script, you can use it to register clients."
msgstr "Setelah selesai membuat skrip, Anda dapat menggunakannya untuk mendaftarkan klien."

#. type: Block title
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:62
#, no-wrap
msgid "Procedure: Running the bootstrap script"
msgstr "Prosedur: Menjalankan skrip bootstrap"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:65
msgid "On the {productname} Server, change to the bootstrap directory:"
msgstr "Pada {productname} Server, pindah ke direktori bootstrap:"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:67
msgid "Run this command to execute the bootstrap script on the client; replace `EXAMPLE.COM` with the host name of your client:"
msgstr "Jalankan perintah ini untuk mengeksekusi skrip bootstrap pada klien; ganti `EXAMPLE.COM` dengan nama host klien Anda:"

#. type: delimited block -
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:68
#, no-wrap
msgid "cat bootstrap-sles15.sh | ssh root@EXAMPLE.COM /bin/bash\n"
msgstr "cat bootstrap-sles15.sh | ssh [root@EXAMPLE.COM](mailto:root@EXAMPLE.COM) /bin/bash\n"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:69
msgid "Alternatively, on the client, run this command:"
msgstr "Sebagai alternatif, jalankan perintah ini pada klien:"

#. type: delimited block -
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:70
#, no-wrap
msgid ""
"ACTIVATION_KEYS=\"17-someactivationkey\" \\\n"
"MGR_SERVER_HOSTNAME=\"proxy.example.com\" \\\n"
"ORG_GPG_KEY=\"mykey\" \\\n"
"REACTIVATION_KEY=my-reactivation-key \\\n"
"curl -Sks https://server_hostname/pub/bootstrap/bootstrap.sh | /bin/bash\n"
msgstr ""
"ACTIVATION_KEYS=\"17-someactivationkey\" \\\n"
"MGR_SERVER_HOSTNAME=\"proxy.example.com\" \\\n"
"ORG_GPG_KEY=\"mykey\" \\\n"
"REACTIVATION_KEY=my-reactivation-key \\\n"
"curl -Sks https://server_hostname/pub/bootstrap/bootstrap.sh | /bin/bash\n"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:71
msgid "If you do not need to override any values, you can omit the environment variables entirely:"
msgstr "Jika Anda tidak perlu mengganti nilai apa pun, Anda dapat menghilangkan seluruh variabel lingkungan:"

#. type: delimited block -
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:72
#, no-wrap
msgid "curl -Sks https://server_hostname/pub/bootstrap/bootstrap.sh | /bin/bash\n"
msgstr "curl -Sks https://server_hostname/pub/bootstrap/bootstrap.sh | /bin/bash\n"

#. type: delimited block =
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:73
msgid "To avoid problems, make sure the bootstrap script is executed using `bash`."
msgstr "Untuk menghindari masalah, pastikan skrip bootstrap dijalankan menggunakan `bash`."

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:74
msgid "This script downloads the required dependencies located in the repositories directory you created earlier."
msgstr "Skrip ini mengunduh dependensi yang diperlukan dari direktori repositori yang telah Anda buat sebelumnya."

#. type: Plain text
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:75
msgid "When the script has finished running, you can check that the client is registered correctly.  Open the {productname} {webui} and navigate to menu:Systems[Overview] to ensure the new client is listed.  If the client is not listed, in the {productname} {webui} navigate to menu:Salt[Keys] and check whether the client key is accepted."
msgstr "Setelah skrip selesai dijalankan, Anda dapat memeriksa apakah klien telah terdaftar dengan benar.  Buka {webui} {productname}, lalu buka menu:Systems[Overview] untuk memastikan klien baru tercantum.  Jika klien tidak tercantum, buka menu:Salt[Keys] di {webui} {productname} dan periksa apakah kunci klien telah diterima."

#. type: delimited block =
#: en/modules/client-configuration/pages/registration-bootstrap.adoc:76
msgid "When new packages or updates are installed on the client using {productname}, any end user license agreements (EULAs) are automatically accepted.  To review a package EULA, open the package detail page in the {webui}."
msgstr "Saat paket baru atau pembaruan dipasang pada klien menggunakan {productname}, semua perjanjian lisensi pengguna akhir (EULA) diterima secara otomatis.  Untuk meninjau EULA paket, buka halaman detail paket di {webui}."

#. type: Title =
#: en/modules/client-configuration/pages/registration-cli.adoc:1
#, no-wrap
msgid "Register Clients on the Command Line"
msgstr "Mendaftarkan Klien melalui Baris Perintah"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-cli.adoc:3
msgid "{salt} clients are registered accurately with the default bootstrap methods in most cases."
msgstr "Dalam kebanyakan kasus, klien {salt} terdaftar dengan benar menggunakan metode bootstrap default."

#. type: Plain text
#: en/modules/client-configuration/pages/registration-cli.adoc:4
msgid "However, you can use {salt} to register the client to the {productname} Server manually by editing the {salt} minion file on the client, and providing the fully qualified domain name (FQDN) of the server."
msgstr "Namun, Anda dapat menggunakan {salt} untuk mendaftarkan klien ke {productname} Server secara manual dengan mengedit berkas minion {salt} pada klien dan memasukkan nama domain lengkap (FQDN) server."

#. type: Plain text
#: en/modules/client-configuration/pages/registration-cli.adoc:5
msgid "This method:"
msgstr "Metode ini:"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-cli.adoc:6
msgid "uses ports 4505 and 4506 inbound to the server."
msgstr "menggunakan port 4505 dan 4506 untuk koneksi masuk ke server."

#. type: Plain text
#: en/modules/client-configuration/pages/registration-cli.adoc:7
msgid "requires no configuration on the {productname} Server aside from ensuring that these ports are open."
msgstr "tidak memerlukan konfigurasi pada {productname} Server selain memastikan port tersebut terbuka."

#. type: Plain text
#: en/modules/client-configuration/pages/registration-cli.adoc:8
msgid "requires that you have installed the `venv-salt-minion` (Salt bundle) or, in the case of {sle} 15 or its derivatives, the `salt-minion` package on the Salt client before registration.  Both use configuration files in different locations and filenames remain the same.  The `systemd` service filename is different."
msgstr "mengharuskan Anda memasang paket `venv-salt-minion` (Salt bundle) atau, untuk {sle} 15 atau turunannya, paket `salt-minion` pada klien Salt sebelum pendaftaran.  Keduanya menggunakan berkas konfigurasi di lokasi yang berbeda, tetapi nama berkasnya tetap sama.  Nama berkas layanan `systemd` berbeda."

#. type: delimited block =
#: en/modules/client-configuration/pages/registration-cli.adoc:9
msgid "Bootstrapping this way will only work if you use the `salt-minion` being part of the client tools channels or of an official {suse} distributions."
msgstr "Proses bootstrap dengan cara ini hanya akan berfungsi jika Anda menggunakan `salt-minion` yang disediakan dalam saluran alat klien atau distribusi resmi {suse}."

#. type: Title ==
#: en/modules/client-configuration/pages/registration-cli.adoc:10
#, no-wrap
msgid "{salt} Bundle Configuration"
msgstr "Konfigurasi {salt} Bundle"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-cli.adoc:11
msgid "{salt} Bundle (`venv-salt-minion`)::"
msgstr "{salt} Bundle (`venv-salt-minion`)::"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-cli.adoc:12
msgid "`/etc/venv-salt-minion/`"
msgstr "`/etc/venv-salt-minion/`"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-cli.adoc:13
msgid "`/etc/venv-salt-minion/minion`"
msgstr "`/etc/venv-salt-minion/minion`"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-cli.adoc:14
msgid "`/etc/venv-salt-minion/minion.d/NAME.conf`"
msgstr "`/etc/venv-salt-minion/minion.d/NAME.conf`"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-cli.adoc:15
msgid "systemd service file: `venv-salt-minion.service`"
msgstr "berkas layanan systemd: `venv-salt-minion.service`"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-cli.adoc:16
msgid "For more information about the Salt bundle, see xref:client-configuration:contact-methods-saltbundle.adoc[Salt Bundle]."
msgstr "Untuk informasi selengkapnya tentang Salt bundle, lihat xref:client-configuration:contact-methods-saltbundle.adoc[Salt Bundle]."

#. type: Block title
#: en/modules/client-configuration/pages/registration-cli.adoc:17
#, no-wrap
msgid "Procedure: Registering Clients with Salt Bundle Configuration File"
msgstr "Prosedur: Mendaftarkan Klien dengan Berkas Konfigurasi Salt Bundle"

#. type: delimited block _
#: en/modules/client-configuration/pages/registration-cli.adoc:18
#: en/modules/client-configuration/pages/registration-cli.adoc:41
msgid "On the Salt client, open the `minion` configuration file.  The configuration file is either located at:"
msgstr "Pada klien Salt, buka berkas konfigurasi `minion`.  Berkas konfigurasi berada di salah satu lokasi berikut:"

#. type: Block title
#: en/modules/client-configuration/pages/registration-cli.adoc:19
#: en/modules/client-configuration/pages/registration-cli.adoc:22
#, no-wrap
msgid "Configuration File"
msgstr "Berkas Konfigurasi"

#. type: delimited block -
#: en/modules/client-configuration/pages/registration-cli.adoc:20
#, no-wrap
msgid "/etc/venv-salt-minion/minion\n"
msgstr "/etc/venv-salt-minion/minion\n"

#. type: delimited block -
#: en/modules/client-configuration/pages/registration-cli.adoc:23
#, no-wrap
msgid "/etc/venv-salt-minion/minion.d/NAME.conf\n"
msgstr "/etc/venv-salt-minion/minion.d/NAME.conf\n"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-cli.adoc:24
msgid "In the file add or edit the FQDN of the {productname} Server or Proxy, and the activation key if any. Also add the other configuration parameters listed below."
msgstr "Di dalam berkas, tambahkan atau edit FQDN {productname} Server atau Proxy, serta kunci aktivasi jika ada. Tambahkan juga parameter konfigurasi lain yang tercantum di bawah ini."

#. type: Block title
#: en/modules/client-configuration/pages/registration-cli.adoc:25
#, no-wrap
msgid "Configuration Parameters"
msgstr "Parameter Konfigurasi"

#. type: delimited block -
#: en/modules/client-configuration/pages/registration-cli.adoc:26
#: en/modules/client-configuration/pages/registration-cli.adoc:46
#, no-wrap
msgid "master: SERVER.EXAMPLE.COM\n"
msgstr "master: SERVER.EXAMPLE.COM\n"

#. type: delimited block -
#: en/modules/client-configuration/pages/registration-cli.adoc:27
#: en/modules/client-configuration/pages/registration-cli.adoc:47
#, no-wrap
msgid ""
"grains:\n"
"  susemanager:\n"
"    activation_key: \"<Activation_Key_Name>\"\n"
msgstr ""
"grains:\n"
"  susemanager:\n"
"    activation_key: \"<Activation_Key_Name>\"\n"

#. type: delimited block -
#: en/modules/client-configuration/pages/registration-cli.adoc:28
#: en/modules/client-configuration/pages/registration-cli.adoc:48
#, no-wrap
msgid ""
"server_id_use_crc: adler32\n"
"enable_legacy_startup_events: False\n"
"enable_fqdns_grains: False\n"
msgstr ""
"server_id_use_crc: adler32\n"
"enable_legacy_startup_events: False\n"
"enable_fqdns_grains: False\n"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-cli.adoc:29
msgid "Restart the `venv-salt-minion` service:"
msgstr "Mulai ulang layanan `venv-salt-minion`:"

#. type: delimited block -
#: en/modules/client-configuration/pages/registration-cli.adoc:30
#, no-wrap
msgid "systemctl restart venv-salt-minion\n"
msgstr "systemctl restart venv-salt-minion\n"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-cli.adoc:31
#: en/modules/client-configuration/pages/registration-cli.adoc:51
msgid "On the {productname} Server, accept the new client key; replace `<client>` with the name of your client:"
msgstr "Pada {productname} Server, terima kunci klien baru; ganti `<client>` dengan nama klien Anda:"

#.  bsc#1275658
#. type: Title ==
#: en/modules/client-configuration/pages/registration-cli.adoc:33
#, no-wrap
msgid "Client Configuration"
msgstr "Konfigurasi Klien"

#. type: delimited block =
#: en/modules/client-configuration/pages/registration-cli.adoc:34
msgid "The plain `salt-minion` is unsupported in general.  Use this section only for bootstrapping {sle} 15 or its derivatives. It is replaced by `venv-salt-minion` during bootstrapping."
msgstr "Secara umum, `salt-minion` biasa tidak didukung.  Gunakan bagian ini hanya untuk melakukan bootstrap pada {sle} 15 atau turunannya. Paket ini akan diganti dengan `venv-salt-minion` selama proses bootstrap."

#. type: Labeled list
#: en/modules/client-configuration/pages/registration-cli.adoc:35
#, no-wrap
msgid "Client (`salt-minion`)"
msgstr "Klien (`salt-minion`)"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-cli.adoc:36
msgid "`/etc/salt/`"
msgstr "`/etc/salt/`"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-cli.adoc:37
msgid "`/etc/salt/minion`"
msgstr "`/etc/salt/minion`"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-cli.adoc:38
msgid "`/etc/salt/minion.d/NAME.conf`"
msgstr "`/etc/salt/minion.d/NAME.conf`"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-cli.adoc:39
msgid "systemd service file: `salt-minion.service`"
msgstr "berkas layanan systemd: `salt-minion.service`"

#. type: Block title
#: en/modules/client-configuration/pages/registration-cli.adoc:40
#, no-wrap
msgid "Procedure: Registering Clients with Salt Minion Configuration File"
msgstr "Prosedur: Mendaftarkan Klien dengan Berkas Konfigurasi Salt Minion"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-cli.adoc:45
msgid "In the file add or edit the FQDN of the {productname} Server or Proxy, and the activation key if any.  Also add the other configuration parameters listed below."
msgstr "Di dalam berkas, tambahkan atau edit FQDN {productname} Server atau Proxy, serta kunci aktivasi jika ada.  Tambahkan juga parameter konfigurasi lain yang tercantum di bawah ini."

#. type: delimited block _
#: en/modules/client-configuration/pages/registration-cli.adoc:53
msgid "For more information about the {salt} minion configuration file, see https://docs.saltproject.io/en/latest/ref/configuration/minion.html[Configuring the Salt Minion]."
msgstr "Untuk informasi selengkapnya tentang berkas konfigurasi minion {salt}, lihat https://docs.saltproject.io/en/latest/ref/configuration/minion.html[Configuring the Salt Minion]."

#. type: Title =
#: en/modules/client-configuration/pages/registration-methods.adoc:1
#, no-wrap
msgid "Registration Methods"
msgstr "Metode Pendaftaran"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-methods.adoc:2
msgid "There are several ways to register clients to your {productname} Server."
msgstr "Ada beberapa cara untuk mendaftarkan klien ke {productname} Server Anda."

#. type: Plain text
#: en/modules/client-configuration/pages/registration-methods.adoc:3
msgid "For only a few clients, we recommend that you register clients using the {productname} {webui}."
msgstr "Jika jumlah klien hanya sedikit, sebaiknya daftarkan klien melalui {webui} {productname}."

#. type: Plain text
#: en/modules/client-configuration/pages/registration-methods.adoc:4
msgid "For more information, see xref:client-configuration:registration-webui.adoc[]."
msgstr "Untuk informasi selengkapnya, lihat xref:client-configuration:registration-webui.adoc[]."

#. type: Plain text
#: en/modules/client-configuration/pages/registration-methods.adoc:5
msgid "If you want more control over the process, or have to register many clients, we recommend that you create a bootstrap script."
msgstr "Jika Anda menginginkan kendali lebih besar atas proses ini atau perlu mendaftarkan banyak klien, sebaiknya buat skrip bootstrap."

#. type: Plain text
#: en/modules/client-configuration/pages/registration-methods.adoc:6
msgid "For more information, see xref:client-configuration:registration-bootstrap.adoc[]."
msgstr "Untuk informasi selengkapnya, lihat xref:client-configuration:registration-bootstrap.adoc[]."

#. type: Plain text
#: en/modules/client-configuration/pages/registration-methods.adoc:7
msgid "For even more control over the process, executing a single commands on the command line can be useful."
msgstr "Untuk mendapatkan kendali yang lebih besar lagi atas proses ini, menjalankan perintah satu per satu melalui baris perintah dapat berguna."

#. type: Plain text
#: en/modules/client-configuration/pages/registration-methods.adoc:8
msgid "For more information, see xref:client-configuration:registration-cli.adoc[]."
msgstr "Untuk informasi selengkapnya, lihat xref:client-configuration:registration-cli.adoc[]."

#. type: Plain text
#: en/modules/client-configuration/pages/registration-methods.adoc:9
msgid "The client must have the date and time synchronized correctly with the {productname} Server before registration."
msgstr "Tanggal dan waktu klien harus disinkronkan dengan benar dengan {productname} Server sebelum pendaftaran."

#. type: Plain text
#: en/modules/client-configuration/pages/registration-methods.adoc:10
msgid "You must create an activation key first, to use bootstrap script or command line method.  For more information about creating activation keys, see xref:client-configuration:activation-keys.adoc[]."
msgstr "Anda harus membuat kunci aktivasi terlebih dahulu untuk menggunakan metode skrip bootstrap atau baris perintah.  Untuk informasi selengkapnya tentang pembuatan kunci aktivasi, lihat xref:client-configuration:activation-keys.adoc[]."

#. type: delimited block =
#: en/modules/client-configuration/pages/registration-methods.adoc:11
#: en/modules/client-configuration/pages/registration-webui.adoc:6
msgid "Do not register the {productname} Server to itself.  The {productname} Server must be managed individually or by using another separate {productname} Server.  For more information about using multiple servers, see xref:specialized-guides:large-deployments/hub-multi-server.adoc[]."
msgstr "Jangan daftarkan {productname} Server ke dirinya sendiri.  {productname} Server harus dikelola secara individual atau menggunakan {productname} Server lain yang terpisah.  Untuk informasi selengkapnya tentang penggunaan beberapa server, lihat xref:specialized-guides:large-deployments/hub-multi-server.adoc[]."

#. type: Title =
#: en/modules/client-configuration/pages/registration-overview-alibaba.adoc:1
#, no-wrap
msgid "{alibabaclo} Client Registration"
msgstr "Pendaftaran Klien {alibabaclo}"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-overview-alibaba.adoc:2
msgid "You can register {alibabaclo} clients to your {productname} Server.  The method and details vary depending on the operating system of the client."
msgstr "Anda dapat mendaftarkan klien {alibabaclo} ke {productname} Server Anda.  Metode dan detailnya bervariasi bergantung pada sistem operasi klien."

#. type: Plain text
#: en/modules/client-configuration/pages/registration-overview-alibaba.adoc:3
#: en/modules/client-configuration/pages/registration-overview-almalinux.adoc:3
#: en/modules/client-configuration/pages/registration-overview-amazon.adoc:3
#: en/modules/client-configuration/pages/registration-overview-centos.adoc:3
#: en/modules/client-configuration/pages/registration-overview-debian.adoc:3
#: en/modules/client-configuration/pages/registration-overview-oes.adoc:3
#: en/modules/client-configuration/pages/registration-overview-openeuler.adoc:4
#: en/modules/client-configuration/pages/registration-overview-opensuse.adoc:3
#: en/modules/client-configuration/pages/registration-overview-oracle.adoc:3
#: en/modules/client-configuration/pages/registration-overview-raspberrypios.adoc:3
#: en/modules/client-configuration/pages/registration-overview-redhat.adoc:4
#: en/modules/client-configuration/pages/registration-overview-rocky.adoc:3
#: en/modules/client-configuration/pages/registration-overview-suse.adoc:8
#: en/modules/client-configuration/pages/registration-overview-ubuntu.adoc:3
msgid "Before you start, ensure that the client has the date and time synchronized correctly with the {productname} Server."
msgstr "Sebelum memulai, pastikan tanggal dan waktu klien telah disinkronkan dengan benar dengan {productname} Server."

#. type: Plain text
#: en/modules/client-configuration/pages/registration-overview-alibaba.adoc:4
#: en/modules/client-configuration/pages/registration-overview-amazon.adoc:4
#: en/modules/client-configuration/pages/registration-overview-debian.adoc:4
#: en/modules/client-configuration/pages/registration-overview-openeuler.adoc:5
#: en/modules/client-configuration/pages/registration-overview-opensuse.adoc:4
#: en/modules/client-configuration/pages/registration-overview-raspberrypios.adoc:4
#: en/modules/client-configuration/pages/registration-overview-suse.adoc:9
#: en/modules/client-configuration/pages/registration-overview-ubuntu.adoc:4
msgid "You must also have created an activation key.  For more information about creating activation keys, see xref:client-configuration:activation-keys.adoc[]."
msgstr "Anda juga harus sudah membuat kunci aktivasi.  Untuk informasi selengkapnya tentang pembuatan kunci aktivasi, lihat xref:client-configuration:activation-keys.adoc[]."

#. type: Title =
#: en/modules/client-configuration/pages/registration-overview-almalinux.adoc:1
#, no-wrap
msgid "{almalinux} Client Registration"
msgstr "Pendaftaran Klien {almalinux}"

#. type: Plain text
#: en/modules/client-configuration/pages/registration-overview-almalinux.adoc:2
msgid "You can register {almalinux} clients to your {productname} Server.  The method and details vary depending on the operating system of the client."
msgstr "Anda dapat mendaftarkan klien {almalinux} ke {productname} Server Anda.  Metode dan detailnya bervariasi bergantung pada sistem operasi klien."

#. type: Plain text
