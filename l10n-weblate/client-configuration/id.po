#. type: Title =
#: en/modules/client-configuration/pages/supported-features.adoc:1
#, no-wrap
msgid "Supported Clients and Features"
msgstr "Klien dan Fitur yang Didukung"

#. type: Plain text
#: en/modules/client-configuration/pages/supported-features.adoc:2
msgid "{productname} is compatible with a range of client technologies.  You can install Salt clients running {sle} or another Linux operating system, with a range of hardware options."
msgstr "{productname} kompatibel dengan berbagai teknologi klien.  Anda dapat menginstal klien Salt yang menjalankan {sle} atau sistem operasi Linux lainnya, dengan berbagai pilihan perangkat keras."

#. type: Plain text
#: en/modules/client-configuration/pages/supported-features.adoc:3
msgid "This section contains summary of supported client systems. For a detailed list of features available on each client, see the following pages."
msgstr "Bagian ini berisi ringkasan sistem klien yang didukung. Untuk daftar terperinci fitur yang tersedia pada setiap klien, lihat halaman-halaman berikut."

#. type: Title ==
#: en/modules/client-configuration/pages/supported-features.adoc:4
#, no-wrap
msgid "Supported client systems"
msgstr "Sistem klien yang didukung"

#. type: Plain text
#: en/modules/client-configuration/pages/supported-features.adoc:5
msgid "Client operating system is supported by the organization that supplies the operating system.  The versions and SP levels must be under general support (normal or LTSS) to be supported with {productname}.  For details on supported product versions, see https://www.suse.com/lifecycle."
msgstr "Sistem operasi klien didukung oleh organisasi yang menyediakan sistem operasi tersebut.  Versi dan tingkat SP harus berada dalam masa dukungan umum (normal atau LTSS) agar didukung oleh {productname}.  Untuk perincian tentang versi produk yang didukung, lihat https://www.suse.com/lifecycle."

#. type: Plain text
#: en/modules/client-configuration/pages/supported-features.adoc:6
msgid "Supported client operating systems are listed in this table. The icons in the table indicate:"
msgstr "Sistem operasi klien yang didukung tercantum dalam tabel ini. Ikon dalam tabel menunjukkan:"

#. type: Plain text
#: en/modules/client-configuration/pages/supported-features.adoc:7
msgid "{check} clients running this operating system are supported by {suse}"
msgstr "{check} klien yang menjalankan sistem operasi ini didukung oleh {suse}"

#. type: Plain text
#: en/modules/client-configuration/pages/supported-features.adoc:8
msgid "{cross} clients running this operating system are not supported by {suse}"
msgstr "{cross} klien yang menjalankan sistem operasi ini tidak didukung oleh {suse}"

#. type: Plain text
#: en/modules/client-configuration/pages/supported-features.adoc:9
msgid "{question} clients are under consideration, and may or may not be supported at a later date."
msgstr "{question} dukungan untuk klien sedang dipertimbangkan, dan mungkin diberikan atau tidak diberikan di kemudian hari."

#. type: delimited block =
#: en/modules/client-configuration/pages/supported-features.adoc:10
msgid "The operating system running on a client is supported by the organization that supplies the operating system."
msgstr "Sistem operasi yang berjalan pada klien didukung oleh organisasi yang menyediakan sistem operasi tersebut."

