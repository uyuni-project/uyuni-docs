#. type: Title =
#: en/modules/client-configuration/pages/clients-ubuntu.adoc:1
#, no-wrap
msgid "Registering {ubuntu} Clients"
msgstr "Mendaftarkan Klien {ubuntu}"

#. type: Plain text
#: en/modules/client-configuration/pages/clients-ubuntu.adoc:2
msgid "This section contains information about registering clients running {ubuntu} operating systems."
msgstr "Bagian ini berisi informasi tentang pendaftaran klien yang menjalankan sistem operasi {ubuntu}."

#.  Use list format: repository URLs / packages and metadata / version info
#. type: delimited block =
#: en/modules/client-configuration/pages/clients-ubuntu.adoc:3
msgid "Packages and metadata are provided by Ubuntu, not by {suse}."
msgstr "Paket dan metadata disediakan oleh Ubuntu, bukan oleh {suse}."

#. type: delimited block =
#: en/modules/client-configuration/pages/clients-ubuntu.adoc:4
msgid "For supported products, see the release notes and the support table at xref:client-configuration:supported-features-ubuntu.adoc[]."
msgstr "Untuk produk yang didukung, lihat catatan rilis dan tabel dukungan di xref:client-configuration:supported-features-ubuntu.adoc[]."

#. type: Plain text
#: en/modules/client-configuration/pages/clients-ubuntu.adoc:5
msgid "{productname} supports {ubuntu} 22.04 LTS, 24.04 LTS, and 26.04 LTS clients using {salt}."
msgstr "{productname} mendukung klien {ubuntu} 22.04 LTS, 24.04 LTS, dan 26.04 LTS yang menggunakan {salt}."

#. type: Plain text
#: en/modules/client-configuration/pages/clients-ubuntu.adoc:6
msgid "Bootstrapping is supported for starting {ubuntu} clients and performing initial state runs such as setting repositories and performing profile updates.  However, the root user on {ubuntu} is disabled by default, so to use bootstrapping, you require an existing user with `sudo` privileges for Python."
msgstr "Bootstrap didukung untuk menginisialisasi klien {ubuntu} dan menjalankan state awal, seperti mengatur repositori dan memperbarui profil.  Namun, pengguna root pada {ubuntu} dinonaktifkan secara default, sehingga untuk menggunakan bootstrap, Anda memerlukan pengguna yang sudah ada dengan hak akses `sudo` untuk Python."

#. type: delimited block =
#: en/modules/client-configuration/pages/clients-ubuntu.adoc:7
msgid "Canonical does not endorse or support {productname}."
msgstr "Canonical tidak memberikan pengesahan atau dukungan untuk {productname}."

#. type: Plain text
#: en/modules/client-configuration/pages/clients-ubuntu.adoc:9
msgid "Before you register {ubuntu} clients to your {productname} Server, you need to add the required software channels, and synchronize them."
msgstr "Sebelum mendaftarkan klien {ubuntu} ke Server {productname}, Anda harus menambahkan saluran perangkat lunak yang diperlukan dan menyinkronkannya."

