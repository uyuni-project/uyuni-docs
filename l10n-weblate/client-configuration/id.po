#. type: delimited block =
#: en/modules/client-configuration/pages/clients-debian.adoc:23
msgid "{debian} channels can be very large.  Synchronization can sometimes take several hours."
msgstr "Saluran {debian} dapat berukuran sangat besar.  Sinkronisasi terkadang dapat memerlukan waktu beberapa jam."

#. type: delimited block =
#: en/modules/client-configuration/pages/clients-debian.adoc:28
msgid "{debian} clients can require multiple GPG keys to be installed."
msgstr "Klien {debian} mungkin memerlukan instalasi beberapa kunci GPG."

#. type: Plain text
#: en/modules/client-configuration/pages/clients-debian.adoc:29
msgid "When synchronizing third-party {debian} repositories, you will need to import the appropriate GPG key on the server.  If the GPG key is missing, synchronization will fail."
msgstr "Saat menyinkronkan repositori {debian} pihak ketiga, Anda perlu mengimpor kunci GPG yang sesuai ke server.  Jika kunci GPG tidak tersedia, sinkronisasi akan gagal."

#. type: Plain text
#: en/modules/client-configuration/pages/clients-debian.adoc:30
msgid "For {debian} repositories, only the metadata is signed. Therefore importing a GPG key for the software channel is not needed.  Packages will not be re-signed by Uyuni."
msgstr "Untuk repositori {debian}, hanya metadata yang ditandatangani. Oleh karena itu, kunci GPG untuk saluran perangkat lunak tidak perlu diimpor.  Paket tidak akan ditandatangani ulang oleh Uyuni."

#. type: Plain text
#: en/modules/client-configuration/pages/clients-debian.adoc:31
#: en/modules/client-configuration/pages/clients-raspberrypios.adoc:38
msgid "To see which GPG keys are already imported to {productname} Server, run the following command:"
msgstr "Untuk melihat kunci GPG yang telah diimpor ke Server {productname}, jalankan perintah berikut:"

#. type: delimited block -
#: en/modules/client-configuration/pages/clients-debian.adoc:32
#: en/modules/client-configuration/pages/clients-raspberrypios.adoc:39
#, no-wrap
msgid "mgrctl gpg list\n"
msgstr "mgrctl gpg list\n"

#. type: Plain text
#: en/modules/client-configuration/pages/clients-debian.adoc:33
#: en/modules/client-configuration/pages/clients-raspberrypios.adoc:40
msgid "To import a new GPG key, run the following command:"
msgstr "Untuk mengimpor kunci GPG baru, jalankan perintah berikut:"

#. type: delimited block -
#: en/modules/client-configuration/pages/clients-debian.adoc:34
#: en/modules/client-configuration/pages/clients-raspberrypios.adoc:41
#, no-wrap
msgid "mgrctl gpg upload <filename>.gpg\n"
msgstr "mgrctl gpg upload <filename>.gpg\n"

#. type: Plain text
#: en/modules/client-configuration/pages/clients-debian.adoc:36
msgid "The root user on {debian} is disabled by default for SSH access.  To onboard using a regular user, you must edit the `sudoers` file on the client system."
msgstr "Akses SSH untuk pengguna root pada {debian} dinonaktifkan secara default.  Untuk melakukan pendaftaran menggunakan pengguna biasa, Anda harus mengedit berkas `sudoers` pada sistem klien."

#. type: Title =
#: en/modules/client-configuration/pages/clients-oes.adoc:1
#, no-wrap
msgid "Registering {oes} Clients"
msgstr "Mendaftarkan Klien {oes}"

#. type: Plain text
#: en/modules/client-configuration/pages/clients-oes.adoc:2
msgid "This section contains information about registering clients running {oes} operating systems."
msgstr "Bagian ini berisi informasi tentang pendaftaran klien yang menjalankan sistem operasi {oes}."

#. type: Plain text
