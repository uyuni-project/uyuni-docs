msgid "Packages and metadata are provided by Raspberry Pi OS, not by {suse}."
msgstr "Paket dan metadata disediakan oleh Raspberry Pi OS, bukan oleh {suse}."

#. type: Plain text
#: en/modules/client-configuration/pages/clients-raspberrypios.adoc:8
msgid "Some preparation is required before you can register {raspberrypios} clients to the {productname} Server:"
msgstr "Beberapa persiapan diperlukan sebelum Anda dapat mendaftarkan klien {raspberrypios} ke Server {productname}:"

