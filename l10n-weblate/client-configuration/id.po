#: en/modules/client-configuration/pages/client-config-overview.adoc:3
#: en/modules/client-configuration/pages/client-config-overview.adoc:14
#: en/modules/client-configuration/pages/uyuni-client-config-overview.adoc:3
#: en/modules/client-configuration/pages/uyuni-client-config-overview.adoc:9
#, no-wrap
msgid "Preface"
msgstr "Prakata"

#. type: Plain text
#: en/modules/client-configuration/pages/client-config-overview.adoc:4
#: en/modules/client-configuration/pages/client-config-overview.adoc:16
#: en/modules/client-configuration/pages/uyuni-client-config-overview.adoc:4
#: en/modules/client-configuration/pages/uyuni-client-config-overview.adoc:11
msgid "After installing {productname}, the first step is registering clients. Managing these clients will be a key part of your workflow."
msgstr "Setelah menginstal {productname}, langkah pertama adalah mendaftarkan klien. Pengelolaan klien ini akan menjadi bagian penting dari alur kerja Anda."

#. type: Plain text
#: en/modules/client-configuration/pages/client-config-overview.adoc:5
#: en/modules/client-configuration/pages/client-config-overview.adoc:17
#: en/modules/client-configuration/pages/uyuni-client-config-overview.adoc:5
#: en/modules/client-configuration/pages/uyuni-client-config-overview.adoc:12
msgid "{productname} supports {sle} and other Linux distributions, offering compatibility across various hardware options."
msgstr "{productname} mendukung {sle} dan distribusi Linux lainnya, serta menawarkan kompatibilitas dengan berbagai pilihan perangkat keras."

#. type: Plain text
#: en/modules/client-configuration/pages/client-config-overview.adoc:6
#: en/modules/client-configuration/pages/client-config-overview.adoc:18
#: en/modules/client-configuration/pages/uyuni-client-config-overview.adoc:6
#: en/modules/client-configuration/pages/uyuni-client-config-overview.adoc:13
msgid "For a complete list of supported clients and features, refer to xref:client-configuration:supported-features.adoc[Supported Clients and Features]."
msgstr "Untuk daftar lengkap klien dan fitur yang didukung, lihat xref:client-configuration:supported-features.adoc[Supported Clients and Features]."

#. type: Plain text
#: en/modules/client-configuration/pages/client-config-overview.adoc:7
#: en/modules/client-configuration/pages/client-config-overview.adoc:19
#: en/modules/client-configuration/pages/uyuni-client-config-overview.adoc:7
#: en/modules/client-configuration/pages/uyuni-client-config-overview.adoc:14
msgid "This guide covers both manual and automated client registration and configuration."
msgstr "Panduan ini membahas pendaftaran dan konfigurasi klien secara manual maupun otomatis."

