#. type: Title =
#: en/modules/client-configuration/pages/clients-rocky.adoc:1
#, no-wrap
msgid "Registering {rocky} Clients"
msgstr "Mendaftarkan Klien {rocky}"

#. type: Plain text
#: en/modules/client-configuration/pages/clients-rocky.adoc:2
msgid "This section contains information about registering clients running {rocky} operating systems."
msgstr "Bagian ini berisi informasi tentang pendaftaran klien yang menjalankan sistem operasi {rocky}."

#.  Use list format: repository URLs / packages and metadata / version info
#. type: delimited block =
#: en/modules/client-configuration/pages/clients-rocky.adoc:3
msgid "{rocky} repository URLs are available from {scclongform}."
msgstr "URL repositori {rocky} tersedia dari {scclongform}."

#. type: delimited block =
#: en/modules/client-configuration/pages/clients-rocky.adoc:4
msgid "Packages and metadata are provided by Rocky Enterprise Software Foundation, not by {suse}."
msgstr "Paket dan metadata disediakan oleh Rocky Enterprise Software Foundation, bukan oleh {suse}."

#. type: delimited block =
#: en/modules/client-configuration/pages/clients-rocky.adoc:5
msgid "For supported products, see the release notes and the support table at xref:client-configuration:supported-features-rocky.adoc[]."
msgstr "Untuk produk yang didukung, lihat catatan rilis dan tabel dukungan di xref:client-configuration:supported-features-rocky.adoc[]."

#. type: delimited block =
#: en/modules/client-configuration/pages/clients-rocky.adoc:6
msgid "Registering {rocky} clients to {productname} is tested with the default SELinux configuration of `enforcing` with a `targeted` policy.  You do not need to disable SELinux to register {rocky} clients to {productname}."
msgstr "Pendaftaran klien {rocky} ke {productname} telah diuji dengan konfigurasi default SELinux, yaitu `enforcing` dengan kebijakan `targeted`.  Anda tidak perlu menonaktifkan SELinux untuk mendaftarkan klien {rocky} ke {productname}."

#. type: Plain text
#: en/modules/client-configuration/pages/clients-rocky.adoc:8
msgid "Before you can register {rocky} clients to your {productname} Server, you need to add the required software channels, and synchronize them."
msgstr "Sebelum dapat mendaftarkan klien {rocky} ke Server {productname}, Anda harus menambahkan saluran perangkat lunak yang diperlukan dan menyinkronkannya."

