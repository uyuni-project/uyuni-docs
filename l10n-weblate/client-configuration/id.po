"| {rhel} and similar derivatives | `/etc/yum.repos.d/`\n"
"| {ubuntu} | `/etc/apt/sources.list.d/`\n"
"| {debian} | `/etc/apt/sources.list.d/`\n"
msgstr ""
"| Sistem Operasi Klien | Direktori Repositori Lokal\n"
"\n"
"| {sles} | `/etc/zypp/repos.d`\n"
"| {opensuse} | `/etc/zypp/repos.d`\n"
"| {sles} {es} | `/etc/yum.repos.d/`\n"
"| {rhel} dan distribusi turunan sejenis | `/etc/yum.repos.d/`\n"
"| {ubuntu} | `/etc/apt/sources.list.d/`\n"
"| {debian} | `/etc/apt/sources.list.d/`\n"

