#: en/modules/installation-and-upgrade/pages/installation-and-upgrade-overview.adoc:24
#: en/modules/installation-and-upgrade/pages/uyuni-installation-and-upgrade-overview.adoc:2
#: en/modules/installation-and-upgrade/pages/uyuni-installation-and-upgrade-overview.adoc:19
#, no-wrap
msgid "**Publication Date:** {docdate}\n"
msgstr "**Tanggal Publikasi:** {docdate}\n"

#. type: Title ==
#: en/modules/installation-and-upgrade/pages/installation-and-upgrade-overview.adoc:3
#: en/modules/installation-and-upgrade/pages/uyuni-installation-and-upgrade-overview.adoc:3
#, no-wrap
msgid "Preface "
msgstr "Prakata "

