msgid "Configure RAM and number of CPUs."
msgstr "Konfigurasi RAM dan jumlah CPU."

#. type: Plain text
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/server-deployment-vm-mlm.adoc:18
msgid "Name your KVM machine."
msgstr "Beri nama mesin KVM Anda."

#. type: Title ==
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/server-deployment-vm-mlm.adoc:32
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/server-deployment-vmdk-mlm.adoc:24
#, no-wrap
msgid "Register {sl-micro} and {productname} {productnumber} Server"
msgstr "Mendaftarkan {sl-micro} dan Server {productname} {productnumber}"

#. type: delimited block =
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/server-deployment-vm-mlm.adoc:33
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/server-deployment-vmdk-mlm.adoc:26
#: en/modules/installation-and-upgrade/partials/snippet-prepare-micro-host.adoc:19
msgid ""
"The {sl-micro} {microversion} entitlement is included within the "
"{productname} entitlement, so it does not require a separate registration "
"code."
msgstr "Hak {sl-micro} {microversion} disertakan dalam hak {productname}, sehingga tidak memerlukan kode pendaftaran terpisah."

#. type: Block title
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/server-deployment-vm-mlm.adoc:34
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/server-deployment-vmdk-mlm.adoc:27
#, no-wrap
msgid "Procedure: Registering {sl-micro} and {productname} {productnumber}"
msgstr "Prosedur: Mendaftarkan {sl-micro} dan {productname} {productnumber}"

