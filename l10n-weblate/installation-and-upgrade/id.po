msgid "scp config.tar.gz <proxy-FQDN>:/root\n"
msgstr ""

#. type: Plain text
#: en/modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-deployment-uyuni.adoc:72
msgid "Install the Proxy with:"
msgstr "Instal Proxy dengan:"

#. type: delimited block -
#: en/modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-deployment-uyuni.adoc:73
#: en/modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-migration-uyuni.adoc:63
#: en/modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-migration-uyuni.adoc:74
