#: en/modules/installation-and-upgrade/pages/installation-and-upgrade-overview.adoc:4
#: en/modules/installation-and-upgrade/pages/installation-and-upgrade-overview.adoc:18
#: en/modules/installation-and-upgrade/pages/uyuni-installation-and-upgrade-overview.adoc:4
#: en/modules/installation-and-upgrade/pages/uyuni-installation-and-upgrade-overview.adoc:13
msgid ""
"This guide provides comprehensive, step-by-step instructions for deploying, "
"upgrading, and managing {productname} Server and Proxy."
msgstr "Panduan ini menyediakan instruksi komprehensif langkah demi langkah untuk menerapkan, memutakhirkan, dan mengelola Server dan Proxy {productname}."

#. type: Plain text
#: en/modules/installation-and-upgrade/pages/installation-and-upgrade-overview.adoc:5
#: en/modules/installation-and-upgrade/pages/installation-and-upgrade-overview.adoc:19
#: en/modules/installation-and-upgrade/pages/uyuni-installation-and-upgrade-overview.adoc:5
#: en/modules/installation-and-upgrade/pages/uyuni-installation-and-upgrade-overview.adoc:14
msgid "It is organized into the following sections:"
msgstr "Panduan ini diorganisir ke dalam bagian berikut:"

#. type: Plain text
#: en/modules/installation-and-upgrade/pages/installation-and-upgrade-overview.adoc:6
#: en/modules/installation-and-upgrade/pages/installation-and-upgrade-overview.adoc:20
#: en/modules/installation-and-upgrade/pages/uyuni-installation-and-upgrade-overview.adoc:6
#: en/modules/installation-and-upgrade/pages/uyuni-installation-and-upgrade-overview.adoc:15
#, no-wrap
msgid ""
"**Requirements:** Outlines the essential hardware, software, and networking "
"prerequisites to ensure a smooth setup.\n"
msgstr "**Persyaratan:** Menguraikan prasyarat perangkat keras, perangkat lunak, dan jaringan yang penting untuk memastikan penyiapan yang lancar.\n"

#. type: Plain text
#: en/modules/installation-and-upgrade/pages/installation-and-upgrade-overview.adoc:7
#: en/modules/installation-and-upgrade/pages/installation-and-upgrade-overview.adoc:21
#: en/modules/installation-and-upgrade/pages/uyuni-installation-and-upgrade-overview.adoc:7
#: en/modules/installation-and-upgrade/pages/uyuni-installation-and-upgrade-overview.adoc:16
#, no-wrap
msgid ""
"**Deployment and Installation:** Guides you through deploying {productname} "
"as a container and completing the initial configuration.\n"
msgstr "**Penerapan dan Instalasi:** Membimbing Anda melalui penerapan {productname} sebagai kontainer dan menyelesaikan konfigurasi awal.\n"

#. type: Plain text
#: en/modules/installation-and-upgrade/pages/installation-and-upgrade-overview.adoc:8
#: en/modules/installation-and-upgrade/pages/installation-and-upgrade-overview.adoc:22
#: en/modules/installation-and-upgrade/pages/uyuni-installation-and-upgrade-overview.adoc:8
#: en/modules/installation-and-upgrade/pages/uyuni-installation-and-upgrade-overview.adoc:17
#, no-wrap
msgid ""
"**Upgrade and Migration:** Details the process for upgrading and migrating "
"{productname} while minimizing downtime.\n"
msgstr "**Pemutakhiran dan Migrasi:** Merinci proses untuk memutakhirkan dan memigrasikan {productname} sambil meminimalkan waktu henti.\n"

#. type: Plain text
#: en/modules/installation-and-upgrade/pages/installation-and-upgrade-overview.adoc:9
#: en/modules/installation-and-upgrade/pages/installation-and-upgrade-overview.adoc:23
#: en/modules/installation-and-upgrade/pages/uyuni-installation-and-upgrade-overview.adoc:9
#: en/modules/installation-and-upgrade/pages/uyuni-installation-and-upgrade-overview.adoc:18
#, no-wrap
msgid ""
"**Basic Server Management:** Covers fundamental server operations, helping "
"you get started with {productname} efficiently. \n"
msgstr "**Manajemen Server Dasar:** Mencakup operasi server fundamental, membantu Anda memulai dengan {productname} secara efisien. \n"

