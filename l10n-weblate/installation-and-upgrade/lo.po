#. type: Title ==
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/server-air-gapped-deployment-mlm.adoc:22
#, no-wrap
msgid "PTFs"
msgstr "PTFs"

#. type: delimited block _
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/server-air-gapped-deployment-mlm.adoc:23
#, fuzzy
#| msgid "The PTF images are not available as packages.  This means that they should be pulled using [command]``podman`` on a machine with internet access, then saved in an archive, transferred to the air-gapped machine and loaded there."
msgid "The PTF images are not available as packages.  This means that they should be pulled using `podman` on a machine with internet access, then saved in an archive, transferred to the air-gapped machine and loaded there."
msgstr "PTF images ບໍ່ມີໃຫ້ໃນຮູບແບບແພັກເກດ. ນັ້ນໝາຍຄວາມວ່າພວກມັນຄວນຖືກດຶງ (Pull) ໂດຍໃຊ້ [command]``podman`` ໃນເຄື່ອງທີ່ມີອິນເຕີເນັດ, ຈາກນັ້ນບັນທຶກໄວ້ໃນບ່ອນເກັບໄຟລ໌ (Archive), ໂອນຍ້າຍໄປຫາເຄື່ອງທີ່ແຍກສ່ວນ (Air-gapped) ແລະ ໂຫຼດຢູ່ທີ່ນັ້ນ."

#. type: Block title
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/server-air-gapped-deployment-mlm.adoc:24
#, no-wrap
msgid "Procedure: Pulling the image on a machine with internet access"
msgstr "ຂັ້ນຕອນ: ການດຶງ Image ໃນເຄື່ອງທີ່ມີອິນເຕີເນັດ"

#. type: Plain text
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/server-air-gapped-deployment-mlm.adoc:25
#, fuzzy
#| msgid "Install [command]``podman``."
msgid "Install `podman`."
msgstr "ຕິດຕັ້ງ [command]``podman``."

#. type: Plain text
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/server-air-gapped-deployment-mlm.adoc:26
msgid "Authenticate against the {suse} Registry using the SCC credentials:"
msgstr "ຢືນຢັນຕົວຕົນກັບ {suse} Registry ໂດຍໃຊ້ຂໍ້ມູນປະຈຳຕົວ SCC:"

#. type: Plain text
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/server-air-gapped-deployment-mlm.adoc:27
msgid "Run the following commands in a shell."
msgstr "ລັນຄຳສັ່ງຕໍ່ໄປນີ້ໃນ Shell."

#. type: delimited block =
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/server-air-gapped-deployment-mlm.adoc:28
#, fuzzy
#| msgid "This example assumes that the PTF is for the [path]``server`` image, adjust the example if the PTF concerns another image."
msgid "This example assumes that the PTF is for the `server` image, adjust the example if the PTF concerns another image."
msgstr "ຕົວຢ່າງນີ້ສົມມຸດວ່າ PTF ແມ່ນສຳລັບ [path]``server`` image, ໃຫ້ປັບປ່ຽນຕົວຢ່າງຫາກ PTF ກ່ຽວຂ້ອງກັບ image ອື່ນ."

#. type: delimited block -
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/server-air-gapped-deployment-mlm.adoc:29
#, no-wrap
msgid ""
"SCC_USERID=aXXXX\n"
"PTFID=12345\n"
"echo \"registry.suse.com/a/$SCC_USERID/$PTFID/suse/multi-linux-manager/5.2/x86_64/server:latest-ptf-$PTFID\" >>/tmp/ptf-images\n"
msgstr ""
"SCC_USERID=aXXXX\n"
"PTFID=12345\n"
"echo \"registry.suse.com/a/$SCC_USERID/$PTFID/suse/multi-linux-manager/5.2/x86_64/server:latest-ptf-$PTFID\" >>/tmp/ptf-images\n"

#. type: Plain text
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/server-air-gapped-deployment-mlm.adoc:30
msgid "Verify that the file contains the full path to the PTF image.  If needed, other images full paths can be added to the file, one per line."
msgstr "ກວດສອບວ່າໄຟລ໌ມີເສັ້ນທາງເຕັມໄປຫາ PTF image. ຫາກຈຳເປັນ, ສາມາດເພີ່ມເສັ້ນທາງເຕັມຂອງ image ອື່ນໆລົງໃນໄຟລ໌ໄດ້, ໜຶ່ງລາຍການຕໍ່ແຖວ."

#. type: Plain text
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/server-air-gapped-deployment-mlm.adoc:31
msgid "Pull each of the container images of the PTF and save them in a tar archive by running the following commands."
msgstr "ດຶງແຕ່ລະ container images ຂອງ PTF ແລະ ບັນທຶກພວກມັນໄວ້ໃນ Tar archive ໂດຍການລັນຄຳສັ່ງຕໍ່ໄປນີ້."

#. type: delimited block -
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/server-air-gapped-deployment-mlm.adoc:32
#, no-wrap
msgid ""
"for image in `cat /tmp/ptf-images`; do\n"
"    podman pull $image\n"
"done\n"
"podman save -o /tmp/ptf-images.tar $(cat /tmp/ptf-images)\n"
msgstr ""
"for image in `cat /tmp/ptf-images`; do\n"
"    podman pull $image\n"
"done\n"
"podman save -o /tmp/ptf-images.tar $(cat /tmp/ptf-images)\n"

#. type: Plain text
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/server-air-gapped-deployment-mlm.adoc:33
#, fuzzy
#| msgid "Transfer the [path]``/tmp/ptf-images.tar`` images archive on the server to patch."
msgid "Transfer the `/tmp/ptf-images.tar` images archive on the server to patch."
msgstr "ໂອນຍ້າຍ [path]``/tmp/ptf-images.tar`` ບ່ອນເກັບ images ໄປຍັງເຊີເວີທີ່ຈະລົງແພັດ (Patch)."

#. type: Block title
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/server-air-gapped-deployment-mlm.adoc:34
#, no-wrap
msgid "Procedure: Loading the images on the server to patch"
msgstr "ຂັ້ນຕອນ: ການໂຫຼດ images ໃນເຊີເວີທີ່ຈະລົງແພັດ"

#. type: Plain text
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/server-air-gapped-deployment-mlm.adoc:35
#, fuzzy
#| msgid "Ensure the [path]``ptf-images.tar`` file is available on the server."
msgid "Ensure the `ptf-images.tar` file is available on the server."
msgstr "ໃຫ້ແນ່ໃຈວ່າໄຟລ໌ [path]``ptf-images.tar`` ມີໃຫ້ໃຊ້ງານໃນເຊີເວີ."

#. type: Plain text
