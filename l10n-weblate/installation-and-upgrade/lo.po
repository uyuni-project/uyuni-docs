#, no-wrap
msgid "Deploy with Virtual Machine"
msgstr "ນຳໃຊ້ດ້ວຍ Virtual Machine"

#. type: Plain text
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/proxy-air-gapped-deployment-mlm.adoc:6
