#. type: Title ==
#: modules/installation-and-upgrade/pages/container-deployment/suma/server-deployment-vm-suma.adoc:39
#: modules/installation-and-upgrade/pages/container-deployment/suma/server-deployment-vmdk-suma.adoc:28
#, no-wrap
msgid "Register {sle-micro} and {productname} {productnumber} Server"
msgstr "ລົງທະບຽນ {sle-micro} ແລະ ເຊີເວີ {productname} {productnumber}"

#. type: delimited block =
#: modules/installation-and-upgrade/pages/container-deployment/suma/server-deployment-vm-suma.adoc:40
#: modules/installation-and-upgrade/pages/container-deployment/suma/server-deployment-vmdk-suma.adoc:30
#: modules/installation-and-upgrade/partials/container-deployment/prepare-micro-host.adoc:20
msgid ""
"The {sle-micro} {microversion} entitlement is included within the "
"{productname} entitlement, so it does not require a separate registration "
"code."
msgstr "ສິດທິການນຳໃຊ້ (entitlement) ຂອງ {sle-micro} {microversion} ແມ່ນລວມຢູ່ໃນສິດທິການນຳໃຊ້ຂອງ {productname} ແລ້ວ, ດັ່ງນັ້ນຈຶ່ງບໍ່ຈຳເປັນຕ້ອງໃຊ້ລະຫັດລົງທະບຽນແຍກຕ່າງຫາກ."

