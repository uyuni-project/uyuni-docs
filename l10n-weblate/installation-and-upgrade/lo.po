#: modules/installation-and-upgrade/partials/container-deployment/prepare-micro-proxy-host.adoc:8
#, no-wrap
msgid "Procedure: Installing {sle-micro} {microversion}"
msgstr "ຂັ້ນຕອນ: ການຕິດຕັ້ງ {sle-micro} {microversion}"

#. type: delimited block _
#: modules/installation-and-upgrade/partials/container-deployment/prepare-micro-host.adoc:9
#: modules/installation-and-upgrade/partials/container-deployment/prepare-micro-proxy-host.adoc:9
