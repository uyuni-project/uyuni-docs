"Select the {productname} {productnumber} Proxy extension "
"[systemitem]``Checkbox``."
msgstr "ເລືອກ [systemitem]``Checkbox`` ຂອງສ່ວນຂະຫຍາຍ {productname} {productnumber} Proxy."

#. type: Plain text
#: modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-deployment-uyuni.adoc:53
msgid "Enter your {productname} {productnumber} Proxy extension registration code."
msgstr "ປ້ອນລະຫັດລົງທະບຽນສ່ວນຂະຫຍາຍ {productname} {productnumber} Proxy ຂອງທ່ານ."

#. type: Plain text
#: modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-deployment-uyuni.adoc:54
#: modules/installation-and-upgrade/pages/uyuni-server-setup.adoc:18
