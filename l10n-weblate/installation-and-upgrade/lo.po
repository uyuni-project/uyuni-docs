#. type: Plain text
#: modules/installation-and-upgrade/pages/container-deployment/mlm/proxy-conversion-from-client-mlm.adoc:31
#: modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-conversion-from-client-uyuni.adoc:25
msgid "Transfer the certificates to {productname} server host"
msgstr ""

#. type: delimited block -
#: modules/installation-and-upgrade/pages/container-deployment/mlm/proxy-conversion-from-client-mlm.adoc:32
#: modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-conversion-from-client-uyuni.adoc:26
#, no-wrap
msgid ""
"mgrctl cp server:/root/ssl-build/<PROXY-FQDN>/server.crt "
"/root/proxycert.pem\n"
"mgrctl cp server:/root/ssl-build/<PROXY-FQDN>/server.key "
"/root/proxykey.pem\n"
"mgrctl cp server:/root/ssl-build/RHN-ORG-TRUSTED-SSL-CERT /root/rootca.pem\n"
msgstr ""

#. type: delimited block =
#: modules/installation-and-upgrade/pages/container-deployment/mlm/proxy-conversion-from-client-mlm.adoc:33
#: modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-conversion-from-client-uyuni.adoc:27
