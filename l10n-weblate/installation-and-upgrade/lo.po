#. type: Title =
#: modules/installation-and-upgrade/pages/container-management/mgradm-yaml-custom-configuration.adoc:1
#, no-wrap
msgid "Custom YAML Configuration and Deployment with [command]``mgradm``"
msgstr "ການຕັ້ງຄ່າ YAML ທີ່ກຳນົດເອງ ແລະ ການຕິດຕັ້ງດ້ວຍ [command]``mgradm``"

#. type: Plain text
#: modules/installation-and-upgrade/pages/container-management/mgradm-yaml-custom-configuration.adoc:2
msgid ""
"You have the option to create a custom [filename]``mgradm.yaml`` file, which "
"the [command]``mgradm`` tool can utilize during deployment."
msgstr ""

#. type: delimited block =
#: modules/installation-and-upgrade/pages/container-management/mgradm-yaml-custom-configuration.adoc:3
msgid ""
"[command]``mgradm`` will prompt for basic variables if they are not provided "
"using command line parameters or the [filename]``mgradm.yaml`` configuration "
"file."
msgstr "[command]``mgradm`` ຈະຖາມຫາຕົວປ່ຽນພື້ນຖານ ຫາກພວກມັນບໍ່ໄດ້ຖືກລະບຸຜ່ານພາຣາມິເຕີໃນຄອມມານລາຍ ຫຼື ໄຟລ໌ການຕັ້ງຄ່າ [filename]``mgradm.yaml``."

#. type: delimited block =
#: modules/installation-and-upgrade/pages/container-management/mgradm-yaml-custom-configuration.adoc:4
msgid ""
"For security, **using command line parameters to specify passwords should be "
"avoided**.  Use a configuration file with proper permissions instead."
msgstr ""

#. type: Block title
#: modules/installation-and-upgrade/pages/container-management/mgradm-yaml-custom-configuration.adoc:5
#, no-wrap
msgid ""
"Procedure: Deploying the {productname} Container with Podman Using a Custom "
"Configuration File"
msgstr ""

#. type: Plain text
#: modules/installation-and-upgrade/pages/container-management/mgradm-yaml-custom-configuration.adoc:6
msgid ""
"Prepare a configuration file named [filename]``mgradm.yaml`` similar to the "
"following example:"
msgstr "ກຽມໄຟລ໌ການຕັ້ງຄ່າທີ່ມີຊື່ວ່າ [filename]``mgradm.yaml`` ຄ້າຍຄືກັບຕົວຢ່າງຕໍ່ໄປນີ້:"

#. type: delimited block .
#: modules/installation-and-upgrade/pages/container-management/mgradm-yaml-custom-configuration.adoc:7
#, no-wrap
msgid ""
"# Database password. Randomly generated by default\n"
"db:\n"
"  password: MySuperSecretDBPass\n"
msgstr ""
"# ລະຫັດຜ່ານຖານຂໍ້ມູນ. ໂດຍຄ່າເລີ່ມຕົ້ນຈະຖືກສຸ່ມສ້າງຂຶ້ນ\n"
"db:\n"
"  password: MySuperSecretDBPass\n"

#. type: delimited block .
#: modules/installation-and-upgrade/pages/container-management/mgradm-yaml-custom-configuration.adoc:8
#, no-wrap
msgid ""
"# Password for the CA certificate\n"
"ssl:\n"
"  password: MySuperSecretSSLPassword\n"
msgstr ""
