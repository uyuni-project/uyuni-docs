#. type: delimited block -
#: modules/installation-and-upgrade/pages/container-deployment/mlm/proxy-conversion-from-client-mlm.adoc:34
#: modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-conversion-from-client-uyuni.adoc:28
#, no-wrap
msgid "mgrctl exec -ti -- ls -ltd /root/ssl-build/*/\n"
msgstr ""

#. type: delimited block =
#: modules/installation-and-upgrade/pages/container-deployment/mlm/proxy-conversion-from-client-mlm.adoc:35
msgid ""
"Transfer the certificates from the {productname} server host to your local "
