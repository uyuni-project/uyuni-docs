#: modules/installation-and-upgrade/pages/install-proxy-uyuni.adoc:8
#, no-wrap
msgid ""
"repo=repositories/systemsmanagement:/\n"
"repo=${repo}Uyuni:/Stable/images/repo/Uyuni-Proxy-POOL-x86_64-Media1/\n"
"zypper ar https://download.opensuse.org/$repo uyuni-proxy-stable\n"
msgstr ""
"repo=repositories/systemsmanagement:/\n"
"repo=${repo}Uyuni:/Stable/images/repo/Uyuni-Proxy-POOL-x86_64-Media1/\n"
"zypper ar https://download.opensuse.org/$repo uyuni-proxy-stable\n"

#. type: Plain text
#: modules/installation-and-upgrade/pages/install-proxy-uyuni.adoc:9
msgid "Refresh metadata from the repositories."
msgstr "ຣີເຟຣຊຂໍ້ມູນເມຕາເດຕາ (metadata) ຈາກຄັງເກັບຊອບແວ."

#. type: delimited block -
#: modules/installation-and-upgrade/pages/install-proxy-uyuni.adoc:11
#: modules/installation-and-upgrade/pages/install-uyuni.adoc:14
#: modules/installation-and-upgrade/pages/server-minor-upgrade-uyuni.adoc:11
#: modules/installation-and-upgrade/pages/server-z.adoc:11
#, no-wrap
msgid "zypper ref\n"
msgstr "zypper ref\n"

#. type: Plain text
#: modules/installation-and-upgrade/pages/install-proxy-uyuni.adoc:12
