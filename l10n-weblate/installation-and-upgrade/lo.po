msgstr "mgr-storage-proxy /dev/nvme1n1\n"

#. type: delimited block =
#: modules/installation-and-upgrade/pages/container-deployment/suma/proxy-deployment-suma.adoc:41
#: modules/installation-and-upgrade/pages/container-deployment/suma/server-deployment-suma.adoc:42
