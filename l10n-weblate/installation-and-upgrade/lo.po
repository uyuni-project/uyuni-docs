msgid "zypper up\n"
msgstr "zypper up\n"

#. type: Plain text
#: modules/installation-and-upgrade/pages/container-management/updating-proxy-containers.adoc:17
msgid ""
"The {productname} Proxy containers running on [literal]``podman`` can be "
"updated using the following command:"
msgstr ""

