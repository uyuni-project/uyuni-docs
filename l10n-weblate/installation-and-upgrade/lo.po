#. type: Block title
#: modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-deployment-uyuni.adoc:60
#, no-wrap
msgid "Task: Update the System"
msgstr "ວຽກ: ອັບເດດລະບົບ"

#. type: Plain text
#: modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-deployment-uyuni.adoc:61
msgid "Login as *root*."
msgstr "ເຂົ້າສູ່ລະບົບໃນນາມ *root*."

#. type: Plain text
#: modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-deployment-uyuni.adoc:62
#: modules/installation-and-upgrade/partials/container-deployment/prepare-micro-host.adoc:47
msgid "Run **transactional-update**:"
msgstr "ຣັນ **transactional-update**:"

#. type: Plain text
#: modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-deployment-uyuni.adoc:64
#: modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-deployment-uyuni.adoc:69
#: modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-migration-uyuni.adoc:56
msgid "Reboot the system."
msgstr "ຣີບູດລະບົບ."

#. type: Plain text
#: modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-deployment-uyuni.adoc:65
msgid "Login as root."
msgstr "ເຂົ້າສູ່ລະບົບໃນນາມ root."

#. type: Plain text
#: modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-deployment-uyuni.adoc:66
msgid "Install the container utilities:"
msgstr "ຕິດຕັ້ງເຄື່ອງມືຄອນເທນເນີ:"

#. type: delimited block =
#: modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-deployment-uyuni.adoc:67
msgid ""
"Alternatively you may install [systemitem]``mgrpxy-zsh-completion`` or "
"[systemitem]``mgrpxy-fish-completion``."
msgstr "ນອກຈາກນີ້, ທ່ານຍັງສາມາດຕິດຕັ້ງ [systemitem]``mgrpxy-zsh-completion`` ຫຼື [systemitem]``mgrpxy-fish-completion`` ກໍໄດ້."

#. type: delimited block -
#: modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-deployment-uyuni.adoc:68
#, no-wrap
