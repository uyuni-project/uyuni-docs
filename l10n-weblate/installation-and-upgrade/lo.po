msgstr "ໃນໜ້າ [systemitem]``Installation Settings`` ໃຫ້ຄລິກ btn:[Install]."

#. type: Plain text
#: modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-deployment-uyuni.adoc:58
msgid ""
"This concludes installation of {sle-micro} {microversion} and {productname} "
"{productnumber} Proxy as an extension."
msgstr "ນີ້ແມ່ນການສິ້ນສຸດການຕິດຕັ້ງ {sle-micro} {microversion} ແລະ {productname} {productnumber} Proxy ໃນຮູບແບບສ່ວນຂະຫຍາຍ."

