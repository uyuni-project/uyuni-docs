#. type: Block title
#: modules/installation-and-upgrade/pages/proxy-container-installation.adoc:13
#, no-wrap
msgid "Proxy Container Host Software Requirements"
msgstr "ຄວາມຕ້ອງການດ້ານຊອບແວຂອງ Proxy Container Host"

#. type: Table
#: modules/installation-and-upgrade/pages/proxy-container-installation.adoc:14
#, no-wrap
