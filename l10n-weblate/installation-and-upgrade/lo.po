#. type: Block title
#: en/modules/installation-and-upgrade/partials/snippet-prepare-micro-host.adoc:44
#: en/modules/installation-and-upgrade/partials/snippet-prepare-micro-proxy-host.adoc:21
#, no-wrap
msgid "Procedure: Updating the system"
msgstr "ຂັ້ນຕອນ: ການອັບເດດລະບົບ"

#. type: delimited block _
#: en/modules/installation-and-upgrade/partials/snippet-prepare-micro-host.adoc:45
#: en/modules/installation-and-upgrade/partials/snippet-prepare-micro-proxy-host.adoc:22
msgid "Log in as *root*."
