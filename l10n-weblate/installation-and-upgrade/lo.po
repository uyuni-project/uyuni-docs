#: modules/installation-and-upgrade/pages/container-deployment/mlm/server-deployment-mlm.adoc:13
msgid "[literal]``mlm.example.com``"
msgstr ""

#. type: delimited block =
#: modules/installation-and-upgrade/pages/container-deployment/mlm/server-deployment-mlm.adoc:14
msgid "[literal]``mlm.container.lab``"
msgstr ""

