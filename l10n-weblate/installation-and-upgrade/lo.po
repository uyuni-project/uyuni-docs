#. type: delimited block -
#: modules/installation-and-upgrade/pages/container-deployment/mlm/proxy-conversion-from-client-mlm.adoc:36
#, no-wrap
msgid ""
"scp <MLM-FQDN>:/root/proxycert.pem ./\n"
"scp <MLM-FQDN>:/root/proxykey.pem ./\n"
"scp <MLM-FQDN>:/root/rootca.pem ./\n"
msgstr ""

