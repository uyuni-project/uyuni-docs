#. type: delimited block -
#: modules/installation-and-upgrade/pages/container-deployment/mlm/proxy-conversion-from-client-mlm.adoc:29
#: modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-conversion-from-client-uyuni.adoc:23
#, no-wrap
msgid ""
"mgrctl exec -ti -- rhn-ssl-tool --gen-server \\\n"
"  --set-hostname=\"<PROXY-FQDN>\" \\\n"
"  --dir=\"/root/ssl-build\"\n"
msgstr ""

#. type: Plain text
#: modules/installation-and-upgrade/pages/container-deployment/mlm/proxy-conversion-from-client-mlm.adoc:30
#: modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-conversion-from-client-uyuni.adoc:24
