#. type: Title =
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/proxy-air-gapped-deployment-mlm.adoc:1
#, no-wrap
msgid "{productname} Proxy Air-gapped Deployment"
msgstr "ການນຳໃຊ້ {productname} Proxy ແບບແຍກສ່ວນ (Air-gapped)"

#. type: Title ==
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/proxy-air-gapped-deployment-mlm.adoc:2
#: en/modules/installation-and-upgrade/pages/container-deployment/uyuni/server-air-gapped-deployment-uyuni.adoc:2
#, no-wrap
msgid "What is air-gapped deployment?"
msgstr "ການນຳໃຊ້ແບບແຍກສ່ວນ (Air-gapped) ແມ່ນຫຍັງ?"

#. type: Plain text
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/proxy-air-gapped-deployment-mlm.adoc:3
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/server-air-gapped-deployment-mlm.adoc:3
#: en/modules/installation-and-upgrade/pages/container-deployment/uyuni/server-air-gapped-deployment-uyuni.adoc:3
msgid "Air-gapped deployment refers to the setup and operation of any networked system that is physically isolated from insecure networks, especially the internet.  This type of deployment is commonly used in high-security environments such as military installations, financial systems, critical infrastructure, and anywhere sensitive data is handled and must be protected from external threats."
msgstr "ການນຳໃຊ້ແບບແຍກສ່ວນ (Air-gapped) ໝາຍເຖິງການຕັ້ງຄ່າ ແລະ ການເຮັດວຽກຂອງລະບົບເຄືອຂ່າຍໃດໜຶ່ງ ທີ່ຖືກແຍກອອກຈາກເຄືອຂ່າຍທີ່ບໍ່ປອດໄພທາງກາຍະພາບ, ໂດຍສະເພາະອິນເຕີເນັດ. ການນຳໃຊ້ປະເພດນີ້ມັກຈະຖືກໃຊ້ໃນສະພາບແວດລ້ອມທີ່ມີຄວາມປອດໄພສູງ ເຊັ່ນ: ສະຖານທີ່ທາງການທະຫານ, ລະບົບການເງິນ, ໂຄງສ້າງພື້ນຖານທີ່ສຳຄັນ ແລະ ບ່ອນໃດກໍຕາມທີ່ມີການຈັດການຂໍ້ມູນທີ່ລະອຽດອ່ອນ ເຊິ່ງຕ້ອງໄດ້ຮັບການປົກປ້ອງຈາກໄພຄຸກຄາມພາຍນອກ."

#. type: delimited block =
#: en/modules/installation-and-upgrade/pages/container-deployment/mlm/proxy-air-gapped-deployment-mlm.adoc:4
