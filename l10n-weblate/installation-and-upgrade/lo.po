msgstr "ກັອບປີ້ໄຟລ໌ຈາກຄອນເທນເນີເຊີເວີໄປຫາ OS ຂອງໂຮສເຊີເວີ:"

#. type: delimited block -
#: modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-deployment-uyuni.adoc:122
#: modules/installation-and-upgrade/partials/container-deployment/transfer_proxy_config.adoc:5
#, no-wrap
msgid "mgrctl cp server:/root/config.tar.gz .\n"
msgstr "mgrctl cp server:/root/config.tar.gz .\n"

#. type: Plain text
#: modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-deployment-uyuni.adoc:123
msgid "Next copy the files from the Server host OS to the Proxy host:"
msgstr "ຕໍ່ໄປໃຫ້ກັອບປີ້ໄຟລ໌ຈາກ OS ຂອງໂຮສເຊີເວີໄປຫາພຣັອກຊີໂຮສ:"

#. type: delimited block -
#: modules/installation-and-upgrade/pages/container-deployment/uyuni/proxy-deployment-uyuni.adoc:124
#: modules/installation-and-upgrade/partials/container-deployment/transfer_proxy_config.adoc:7
#, no-wrap
msgid "scp config.tar.gz <proxy-FQDN>:/root\n"
msgstr "scp config.tar.gz <proxy-FQDN>:/root\n"

