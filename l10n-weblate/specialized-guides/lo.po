msgstr "mgr_server: ຊື່ໂຮສຂອງ Salt master"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:72
msgid "mgr_origin_server: The hostname of the {productname} Server"
msgstr "mgr_origin_server: ຊື່ໂຮສຂອງເຊີເວີ {productname}"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:73
msgid "minion_id: The hostname of the client to bootstrap"
msgstr "minion_id: ຊື່ໂຮສຂອງເຄື່ອງລູກຂ່າຍທີ່ຈະບູດສະແຕຣບ"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:74
