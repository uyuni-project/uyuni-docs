msgid "**{productname} Proxy**\n"
msgstr "**{productname} Proxy**\n"

#. type: Plain text
#: modules/specialized-guides/pages/public-cloud-guide/payg/aws/payg-aws-webui-configuration.adoc:20
#: modules/specialized-guides/pages/public-cloud-guide/payg/azure/payg-azure-webui-configuration.adoc:20
#, no-wrap
msgid "**{productname} Server**\n"
msgstr "**{productname} Server**\n"

#. type: Plain text
#: modules/specialized-guides/pages/public-cloud-guide/payg/aws/payg-aws-webui-configuration.adoc:21
#: modules/specialized-guides/pages/public-cloud-guide/payg/azure/payg-azure-webui-configuration.adoc:21
