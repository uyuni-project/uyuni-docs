#. type: Title ===
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:84
#, no-wrap
msgid "File-based service discovery"
msgstr "ການຄົ້ນຫາບໍລິການແບບໃຊ້ໄຟລ໌ (File-based service discovery)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:85
msgid ""
"It is possible to define monitored targets using file-based service "
"discovery provided in the Prometheus formula.  This is a basic example "
"demonstrating the usage:"
msgstr "ສາມາດກຳນົດເປົ້າໝາຍການຕິດຕາມກວດກາໂດຍໃຊ້ file-based service discovery ທີ່ມີໃຫ້ໃນ Prometheus formula. ນີ້ແມ່ນຕົວຢ່າງພື້ນຖານທີ່ສະແດງເຖິງການໃຊ້ງານ:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:86
#, no-wrap
msgid ""
"[\n"
"  {\n"
"    \"targets\": [ \"<client1>:9100\", \"<client2>:9100\" ],\n"
"    \"labels\": {\n"
"      \"role\": \"<suma-client>\",\n"
"      \"job\": \"<suma-refclient>\"\n"
"    }\n"
"  },\n"
"  {\n"
"    \"targets\": [ \"<server>:80\" ],\n"
"    \"labels\": {\n"
"      \"role\": \"<suma-server>\",\n"
"      \"job\": \"<suma-refhost>\",\n"
"      \"__metrics_path__\": \"/rhn/metrics\"\n"
"    }\n"
"  }\n"
"]\n"
msgstr ""

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:87
msgid "For more information, see https://prometheus.io/docs/guides/file-sd/."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມ, ໃຫ້ເບິ່ງ https://prometheus.io/docs/guides/file-sd/."

#. type: Title ===
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:88
#, no-wrap
msgid "TLS certificates and keys"
msgstr "TLS certificates ແລະ keys"

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:90
#, no-wrap
msgid "Activate Forms"
msgstr "ເປີດໃຊ້ແບບຟອມ (Activate Forms)"

