msgstr "link:https://suse.com/c/new-dawn-for-suse-manager/[ຍຸກໃໝ່ຂອງ {productname}]"

#. type: Plain text
#: modules/specialized-guides/pages/public-cloud-guide/faq/faq-miscellaneous.adoc:5
msgid "link:https://documentation.suse.com/suma/[documentation.suse.com/suma/]"
