#. type: Title =
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:1
#, no-wrap
msgid "Monitoring Formula"
msgstr "ສູດການຕິດຕາມ (Monitoring Formula)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:2
msgid ""
"The monitoring services in {productname} are configured using formulas with "
"forms.  The package is installed by default, and contains these formulas:"
msgstr "ການບໍລິການຕິດຕາມໃນ {productname} ຖືກຕັ້ງຄ່າໂດຍໃຊ້ສູດ (formulas) ພ້ອມກັບແບບຟອມ (forms). ແພັກເກັດຈະຖືກຕິດຕັ້ງມາໃຫ້ແລ້ວໂດຍມາດຕະຖານ, ແລະ ປະກອບມີສູດເຫຼົ່ານີ້:"

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:3
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:7
#, no-wrap
msgid "Grafana"
msgstr "Grafana"

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:4
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:27
#, no-wrap
msgid "Prometheus"
msgstr "Prometheus"

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:5
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:63
#, no-wrap
msgid "Prometheus Exporters"
msgstr "Prometheus Exporters"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:6
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:92
msgid ""
"For more information about using monitoring, see "
"xref:administration:monitoring.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການໃຊ້ການຕິດຕາມ, ໃຫ້ເບິ່ງທີ່ xref:administration:monitoring.adoc[]."

#. type: Block title
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:8
#, no-wrap
msgid "Procedure: Configuring the Grafana Formula"
msgstr "ຂັ້ນຕອນ: ການຕັ້ງຄ່າສູດ Grafana"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:9
msgid ""
"Navigate to the menu:Formulas[Grafana] tab, and set these parameters in the "
"[guimenu]``Grafana`` section:"
msgstr "ໄປທີ່ແທັບ menu:Formulas[Grafana], ແລະ ຕັ້ງພາລາມິເຕີເຫຼົ່ານີ້ໃນພາກສ່ວນ [guimenu]``Grafana``:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:10
msgid "Check the [guimenu]``Enabled`` box to enable Grafana visualizations."
msgstr "ໝາຍຕິກຊ່ອງ [guimenu]``Enabled`` ເພື່ອເປີດໃຊ້ການສະແດງຜົນດ້ວຍພາບ (visualizations) ຂອງ Grafana."

#. type: delimited block =
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:11
msgid ""
"[guimenu]``Initial admin password`` is used on the first run only, and "
"Grafana UI prompts to change it.  This field cannot be used to change the "
"Grafana password.  For more information on how to change the password, see "
"xref:administration:monitoring.adoc[]."
msgstr "[guimenu]``Initial admin password`` ແມ່ນໃຊ້ສຳລັບການຣັນຄັ້ງທຳອິດເທົ່ານັ້ນ, ແລະ Grafana UI ຈະແຈ້ງໃຫ້ປ່ຽນມັນ. ຊ່ອງນີ້ບໍ່ສາມາດໃຊ້ເພື່ອປ່ຽນລະຫັດຜ່ານ Grafana ໄດ້. ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບວິທີປ່ຽນລະຫັດຜ່ານ, ໃຫ້ເບິ່ງທີ່ xref:administration:monitoring.adoc[]."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:12
msgid ""
"For each Prometheus data source you want to use, in the "
"menu:Datasources[Prometheus] section, click btn:[+], and set these "
"parameters:"
msgstr "ສຳລັບແຫຼ່ງຂໍ້ມູນ (data source) ຂອງ Prometheus ແຕ່ລະອັນທີ່ທ່ານຕ້ອງການໃຊ້, ໃນພາກສ່ວນ menu:Datasources[Prometheus], ໃຫ້ກົດ btn:[+], ແລະ ຕັ້ງພາລາມິເຕີເຫຼົ່ານີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:13
msgid ""
"In the [guimenu]``Datasource name`` field, type a name to identify the data "
"source."
msgstr "ໃນຊ່ອງ [guimenu]``Datasource name``, ໃຫ້ພິມຊື່ເພື່ອລະບຸແຫຼ່ງຂໍ້ມູນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:14
msgid ""
"In the [guimenu]``Prometheus URL`` field, type the used protocol, the "
"location of the Prometheus server, and append port ``9090``."
msgstr "ໃນຊ່ອງ [guimenu]``Prometheus URL``, ໃຫ້ພິມໂປຣໂຕຄໍທີ່ໃຊ້, ຕຳແໜ່ງຂອງເຊີເວີ Prometheus, ແລະ ຕາມດ້ວຍພອດ ``9090``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:15
msgid ""
"For example, ``http://example.com:9090``. In case TLS encryption is enabled "
"in Prometheus formula make sure to use `https` protocol and FQDN."
msgstr "ຕົວຢ່າງ, ``http://example.com:9090``. ໃນກໍລະນີທີ່ເປີດໃຊ້ການເຂົ້າລະຫັດ TLS ໃນສູດ Prometheus, ໃຫ້ແນ່ໃຈວ່າໄດ້ໃຊ້ໂປຣໂຕຄໍ `https` ແລະ FQDN."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:16
msgid ""
"In the fields [guimenu]``Prometheus server username`` and "
"[guimenu]``Prometheus server password``,"
msgstr "ໃນຊ່ອງ [guimenu]``Prometheus server username`` ແລະ [guimenu]``Prometheus server password``,"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:17
msgid ""
"enter basic authentication credentials for Prometheus server matching the "
"ones in Prometheus formula."
msgstr "ປ້ອນຂໍ້ມູນປະຈຳຕົວສຳລັບການຢືນຢັນຕົວຕົນພື້ນຖານ (basic authentication) ສຳລັບເຊີເວີ Prometheus ໃຫ້ກົງກັບທີ່ຢູ່ໃນສູດ Prometheus."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:18
msgid ""
"In the [guimenu]``Dashboards`` section, check the dashboards you want to "
"use:"
msgstr "ໃນພາກສ່ວນ [guimenu]``Dashboards``, ໃຫ້ໝາຍຕິກແດຊບອດ (dashboards) ທີ່ທ່ານຕ້ອງການໃຊ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:19
msgid "[guimenu]``Uyuni server dashboard``"
msgstr "[guimenu]``Uyuni server dashboard``"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:20
msgid "[guimenu]``Uyuni clients dashboard``"
msgstr "[guimenu]``Uyuni clients dashboard``"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:21
msgid "[guimenu]``PostgreSQL dashboard``"
msgstr "[guimenu]``PostgreSQL dashboard``"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:22
msgid "[guimenu]``Apache HTTPD dashboard``"
msgstr "[guimenu]``Apache HTTPD dashboard``"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:23
msgid "[guimenu]``Kubernetes cluster dashboard``"
msgstr "[guimenu]``Kubernetes cluster dashboard``"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:24
msgid "[guimenu]``Kubernetes etcd dashboard``"
msgstr "[guimenu]``Kubernetes etcd dashboard``"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:25
msgid "[guimenu]``Kubernetes namespaces dashboard``"
msgstr "[guimenu]``Kubernetes namespaces dashboard``"

#. type: Block title
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:28
#, no-wrap
msgid "Procedure: Configuring the Prometheus Formula"
msgstr "ຂັ້ນຕອນ: ການຕັ້ງຄ່າສູດ Prometheus"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:29
msgid ""
"Navigate to the menu:Formulas[Prometheus] tab, and set these parameters in "
"the [guimenu]``Prometheus`` section:"
msgstr "ໄປທີ່ແທັບ menu:Formulas[Prometheus], ແລະ ຕັ້ງພາລາມິເຕີເຫຼົ່ານີ້ໃນພາກສ່ວນ [guimenu]``Prometheus``:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:30
msgid "Check the [guimenu]``Enabled`` box to enable Prometheus monitoring."
msgstr "ໝາຍຕິກຊ່ອງ [guimenu]``Enabled`` ເພື່ອເປີດໃຊ້ການຕິດຕາມຂອງ Prometheus."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:31
msgid ""
"In the [guimenu]``Scrape interval`` field, type the frequency of data "
"scraping, in seconds."
msgstr "ໃນຊ່ອງ [guimenu]``Scrape interval``, ໃຫ້ພິມຄວາມຖີ່ຂອງການຂູດຂໍ້ມູນ (data scraping), ເປັນວິນາທີ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:32
msgid "For example, ``15`` will scrape data every fifteen seconds."
msgstr "ຕົວຢ່າງ, ``15`` ຈະໝາຍເຖິງການຂູດຂໍ້ມູນທຸກໆ 15 ວິນາທີ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:33
msgid ""
"In the [guimenu]``Evaluation interval`` field, type the frequency of rules "
"evaluation, in seconds."
msgstr "ໃນຊ່ອງ [guimenu]``Evaluation interval``, ໃຫ້ພິມຄວາມຖີ່ຂອງການປະເມີນກົດເກນ (rules evaluation), ເປັນວິນາທີ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:34
msgid ""
"For example, ``15`` will evaluate alerting and aggregation rules every "
"fifteen seconds."
msgstr "ຕົວຢ່າງ, ``15`` ຈະໝາຍເຖິງການປະເມີນກົດເກນການແຈ້ງເຕືອນ ແລະ ການລວມຂໍ້ມູນທຸກໆ 15 ວິນາທີ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:35
msgid "In the [guimenu]``TLS`` section, set these parameters:"
msgstr "ໃນພາກສ່ວນ [guimenu]``TLS``, ໃຫ້ຕັ້ງພາລາມິເຕີເຫຼົ່ານີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:36
msgid ""
"Check the [guimenu]``Enabled`` box to enable the secure configuration on "
"Prometheus server."
msgstr "ໝາຍຕິກຊ່ອງ [guimenu]``Enabled`` ເພື່ອເປີດໃຊ້ການຕັ້ງຄ່າແບບປອດໄພໃນເຊີເວີ Prometheus."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:37
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:81
msgid ""
"In the [guimenu]``Server Certificate`` field, type the path to the TLS "
"server certificate."
msgstr "ໃນຊ່ອງ [guimenu]``Server Certificate``, ໃຫ້ພິມເສັ້ນທາງໄປຫາໃບຢັ້ງຢືນ TLS ຂອງເຊີເວີ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:38
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:82
msgid "In the [guimenu]``Server Key`` field, type the path to the TLS server key."
msgstr "ໃນຊ່ອງ [guimenu]``Server Key``, ໃຫ້ພິມເສັ້ນທາງໄປຫາຄີ (key) TLS ຂອງເຊີເວີ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:39
msgid "In the [guimenu]``User`` field, type the user name for Prometheus server."
msgstr "ໃນຊ່ອງ [guimenu]``User``, ໃຫ້ພິມຊື່ຜູ້ໃຊ້ສຳລັບເຊີເວີ Prometheus."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:40
msgid ""
"In the [guimenu]``Password Hash`` field, type the password for Prometheus "
"server hashed with bcrypt."
msgstr "ໃນຊ່ອງ [guimenu]``Password Hash``, ໃຫ້ພິມລະຫັດຜ່ານສຳລັບເຊີເວີ Prometheus ທີ່ຜ່ານການແຮຊ (hash) ດ້ວຍ bcrypt."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:41
msgid "In the [guimenu]``Uyuni Server`` section, set these parameters:"
msgstr "ໃນພາກສ່ວນ [guimenu]``Uyuni Server``, ໃຫ້ຕັ້ງພາລາມິເຕີເຫຼົ່ານີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:42
msgid "Check the [guimenu]``Enabled`` box to enable monitoring on this server."
msgstr "ໝາຍຕິກຊ່ອງ [guimenu]``Enabled`` ເພື່ອເປີດໃຊ້ການຕິດຕາມໃນເຊີເວີນີ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:43
msgid ""
"Check the [guimenu]``Autodiscover clients`` box to enable Prometheus to "
"automatically find and monitor new clients when they are added to the "
"server."
msgstr "ໝາຍຕິກຊ່ອງ [guimenu]``Autodiscover clients`` ເພື່ອໃຫ້ Prometheus ຄົ້ນຫາ ແລະ ຕິດຕາມໄຄເອັນໃໝ່ໂດຍອັດຕະໂນມັດເມື່ອພວກມັນຖືກເພີ່ມເຂົ້າໃນເຊີເວີ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:44
msgid ""
"In the [guimenu]``Username`` field, type the user name of the Prometheus "
"account on the server."
msgstr "ໃນຊ່ອງ [guimenu]``Username``, ໃຫ້ພິມຊື່ຜູ້ໃຊ້ຂອງບັນຊີ Prometheus ໃນເຊີເວີ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:45
msgid ""
"In the [guimenu]``Password`` field, type the password of the Prometheus "
"account on the server."
msgstr "ໃນຊ່ອງ [guimenu]``Password``, ໃຫ້ພິມລະຫັດຜ່ານຂອງບັນຊີ Prometheus ໃນເຊີເວີ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:46
msgid "In the [guimenu]``Targets TLS`` section, set these parameters:"
msgstr "ໃນພາກສ່ວນ [guimenu]``Targets TLS``, ໃຫ້ຕັ້ງພາລາມິເຕີເຫຼົ່ານີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:47
msgid ""
"Check the [guimenu]``Enabled`` box to enable the secure configuration for "
"auto-discovered targets."
msgstr "ໝາຍຕິກຊ່ອງ [guimenu]``Enabled`` ເພື່ອເປີດໃຊ້ການຕັ້ງຄ່າແບບປອດໄພສຳລັບເປົ້າໝາຍທີ່ຖືກຄົ້ນຫາໂດຍອັດຕະໂນມັດ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:48
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:80
msgid ""
"In the [guimenu]``CA Certificate`` field, type the path to the Certificate "
"Authority certificate."
msgstr "ໃນຊ່ອງ [guimenu]``CA Certificate``, ໃຫ້ພິມເສັ້ນທາງໄປຫາໃບຢັ້ງຢືນຂອງ Certificate Authority (CA)."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:49
msgid ""
"In the [guimenu]``Client Certificate`` field, type the path to the TLS "
"client certificate for authentication."
msgstr "ໃນຊ່ອງ [guimenu]``Client Certificate``, ໃຫ້ພິມເສັ້ນທາງໄປຫາໃບຢັ້ງຢືນ TLS ຂອງໄຄເອັນສຳລັບການຢືນຢັນຕົວຕົນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:50
msgid ""
"In the [guimenu]``Client Key`` field, type the path to the TLS client key "
"for authentication."
msgstr "ໃນຊ່ອງ [guimenu]``Client Key``, ໃຫ້ພິມເສັ້ນທາງໄປຫາຄີ TLS ຂອງໄຄເອັນສຳລັບການຢືນຢັນຕົວຕົນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:51
msgid "In the [guimenu]``Alerting`` section, set these parameters:"
msgstr "ໃນພາກສ່ວນ [guimenu]``Alerting``, ໃຫ້ຕັ້ງພາລາມິເຕີເຫຼົ່ານີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:52
msgid ""
"Check the [guimenu]``Enable local Alertmanager service`` box to enable the "
"alert manager service."
msgstr "ໝາຍຕິກຊ່ອງ [guimenu]``Enable local Alertmanager service`` ເພື່ອເປີດໃຊ້ການບໍລິການຕົວຈັດການການແຈ້ງເຕືອນ (alert manager) ພາຍໃນເຄື່ອງ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:53
msgid ""
"Check the [guimenu]``Use local Alertmanager`` box to use the local alert "
"manager service."
msgstr "ໝາຍຕິກຊ່ອງ [guimenu]``Use local Alertmanager`` ເພື່ອໃຊ້ການບໍລິການຕົວຈັດການການແຈ້ງເຕືອນພາຍໃນເຄື່ອງ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:54
msgid ""
"For each alert manager you want to use, in the menu:Alerting[Alertmanagers] "
"section, click btn:[+], and set these parameters:"
msgstr "ສຳລັບຕົວຈັດການການແຈ້ງເຕືອນແຕ່ລະອັນທີ່ທ່ານຕ້ອງການໃຊ້, ໃນພາກສ່ວນ menu:Alerting[Alertmanagers], ໃຫ້ກົດ btn:[+], ແລະ ຕັ້ງພາລາມິເຕີເຫຼົ່ານີ້:"

#. For example, ``FIXME``.
#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:55
msgid ""
"In the [guimenu]``IP Address:Port`` field, type the location of the alert "
"manager target, including the port number."
msgstr "ໃນຊ່ອງ [guimenu]``IP Address:Port``, ໃຫ້ພິມຕຳແໜ່ງຂອງເປົ້າໝາຍຕົວຈັດການການແຈ້ງເຕືອນ, ລວມທັງໝາຍເລກພອດ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:56
msgid ""
"To use a rule file, in the menu:Alerting[Rule Files] section, click btn:[+], "
"and set these parameters:"
msgstr "ຫາກຕ້ອງການໃຊ້ໄຟລ໌ກົດເກນ (rule file), ໃນພາກສ່ວນ menu:Alerting[Rule Files], ໃຫ້ກົດ btn:[+], ແລະ ຕັ້ງພາລາມິເຕີເຫຼົ່ານີ້:"

#. For example, ``FIXME``.
#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:57
msgid ""
"In the [guimenu]``Rule Files`` field, type the location of the rule file you "
"want to use."
msgstr "ໃນຊ່ອງ [guimenu]``Rule Files``, ໃຫ້ພິມຕຳແໜ່ງຂອງໄຟລ໌ກົດເກນທີ່ທ່ານຕ້ອງການໃຊ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:58
msgid ""
"To add a custom scrape configuration, in the [guimenu]``User defined scrape "
"configurations`` section, click btn:[+], and set these parameters:"
msgstr "ຫາກຕ້ອງການເພີ່ມການຕັ້ງຄ່າການຂູດຂໍ້ມູນແບບກຳນົດເອງ, ໃນພາກສ່ວນ [guimenu]``User defined scrape configurations``, ໃຫ້ກົດ btn:[+], ແລະ ຕັ້ງພາລາມິເຕີເຫຼົ່ານີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:59
msgid ""
"In the [guimenu]``Job name`` field, type a unique job name for your "
"configuration."
msgstr "ໃນຊ່ອງ [guimenu]``Job name``, ໃຫ້ພິມຊື່ວຽກ (job name) ທີ່ບໍ່ຊໍ້າກັນສຳລັບການຕັ້ງຄ່າຂອງທ່ານ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:60
msgid ""
"In the [guimenu]``Files`` field, type the location pattern of file service "
"discovery files you want to use.  For more information, see the upstream "
"documentation "
"https://prometheus.io/docs/prometheus/latest/configuration/configuration/#file_sd_config."
msgstr "ໃນຊ່ອງ [guimenu]``Files``, ໃຫ້ພິມຮູບແບບຕຳແໜ່ງຂອງໄຟລ໌ຄົ້ນຫາການບໍລິການ (file service discovery) ທີ່ທ່ານຕ້ອງການໃຊ້. ສຳລັບຂໍ້ມູນເພີ່ມເຕີມ, ໃຫ້ເບິ່ງເອກະສານຕົ້ນສະບັບ https://prometheus.io/docs/prometheus/latest/configuration/configuration/#file_sd_config."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:62
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:89
msgid ""
"The formula does not generate and deploy the TLS certificates and keys.  "
"Ensure the files are present on the Salt client and readable for the user "
"``prometheus`` before applying the highstate.  For more information about "
"generating client and server certificates, see "
"xref:administration:monitoring.adoc[]."
msgstr "ສູດນີ້ບໍ່ໄດ້ສ້າງ ແລະ ຕິດຕັ້ງໃບຢັ້ງຢືນ TLS ແລະ ຄີ. ໃຫ້ແນ່ໃຈວ່າໄຟລ໌ເຫຼົ່ານັ້ນມີຢູ່ໃນ Salt client ແລະ ຜູ້ໃຊ້ ``prometheus`` ສາມາດອ່ານໄດ້ກ່ອນທີ່ຈະນຳໃຊ້ highstate. ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການສ້າງໃບຢັ້ງຢືນໄຄເອັນ ແລະ ເຊີເວີ, ໃຫ້ເບິ່ງທີ່ xref:administration:monitoring.adoc[]."

#. type: Block title
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:64
#, no-wrap
msgid "Procedure: Configuring the Prometheus Exporters Formula"
msgstr "ຂັ້ນຕອນ: ການຕັ້ງຄ່າສູດ Prometheus Exporters"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:65
msgid ""
"Navigate to the menu:Formulas[Prometheus Exporters] tab, and set these "
"parameters in the [guimenu]``Node Exporter`` section:"
msgstr "ໄປທີ່ແທັບ menu:Formulas[Prometheus Exporters], ແລະ ຕັ້ງພາລາມິເຕີເຫຼົ່ານີ້ໃນພາກສ່ວນ [guimenu]``Node Exporter``:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:66
msgid "Check the [guimenu]``Enabled`` box to enable the node exporter."
msgstr "ໝາຍຕິກຊ່ອງ [guimenu]``Enabled`` ເພື່ອເປີດໃຊ້ node exporter."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:67
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:71
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:76
msgid ""
"In the [guimenu]``Arguments`` field, type any customized arguments for this "
"exporter."
msgstr "ໃນຊ່ອງ [guimenu]``Arguments``, ໃຫ້ພິມອາກິວເມນ (arguments) ໃດໆ ທີ່ກຳນົດເອງສຳລັບ exporter ນີ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:68
msgid "For example, ``--web.listen-address=\":9100\"``."
msgstr "ຕົວຢ່າງ, ``--web.listen-address=\":9100\"``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:69
msgid "In the [guimenu]``Apache Exporter`` section:"
msgstr "ໃນພາກສ່ວນ [guimenu]``Apache Exporter``:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:70
msgid "Check the [guimenu]``Enabled`` box to enable the Apache exporter."
msgstr "ໝາຍຕິກຊ່ອງ [guimenu]``Enabled`` ເພື່ອເປີດໃຊ້ Apache exporter."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:72
msgid "For example, ``--telemetry.address=\":9117\"``."
msgstr "ຕົວຢ່າງ, ``--telemetry.address=\":9117\"``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:73
msgid "In the [guimenu]``Postgres Exporter`` section:"
msgstr "ໃນພາກສ່ວນ [guimenu]``Postgres Exporter``:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:74
msgid "Check the [guimenu]``Enabled`` box to enable the PostreSQL exporter."
msgstr "ໝາຍຕິກຊ່ອງ [guimenu]``Enabled`` ເພື່ອເປີດໃຊ້ PostreSQL exporter."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:75
msgid ""
"In the [guimenu]``Data source Name`` field, type the name of the data source "
"to use."
msgstr "ໃນຊ່ອງ [guimenu]``Data source Name``, ໃຫ້ພິມຊື່ຂອງແຫຼ່ງຂໍ້ມູນທີ່ຈະໃຊ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:77
msgid "For example, ``--web.listen-address=\":9187\"``."
msgstr "ຕົວຢ່າງ, ``--web.listen-address=\":9187\"``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:78
msgid "In the [guimenu]``TLS`` section:"
msgstr "ໃນພາກສ່ວນ [guimenu]``TLS``:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:79
msgid "Check the [guimenu]``Enabled`` box to enable the secure configuration."
msgstr "ໝາຍຕິກຊ່ອງ [guimenu]``Enabled`` ເພື່ອເປີດໃຊ້ການຕັ້ງຄ່າແບບປອດໄພ."

#. type: Title ===
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:84
#, no-wrap
msgid "File-based service discovery"
msgstr "ການຄົ້ນຫາການບໍລິການແບບໃຊ້ໄຟລ໌ (File-based service discovery)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:85
msgid ""
"It is possible to define monitored targets using file-based service "
"discovery provided in the Prometheus formula.  This is a basic example "
"demonstrating the usage:"
msgstr "ທ່ານສາມາດກຳນົດເປົ້າໝາຍທີ່ຈະຕິດຕາມໂດຍໃຊ້ການຄົ້ນຫາການບໍລິການແບບໃຊ້ໄຟລ໌ທີ່ມີໃຫ້ໃນສູດ Prometheus. ນີ້ແມ່ນຕົວຢ່າງພື້ນຖານທີ່ສະແດງເຖິງການນຳໃຊ້:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:86
#, no-wrap
msgid ""
"[\n"
"  {\n"
"    \"targets\": [ \"<client1>:9100\", \"<client2>:9100\" ],\n"
"    \"labels\": {\n"
"      \"role\": \"<suma-client>\",\n"
"      \"job\": \"<suma-refclient>\"\n"
"    }\n"
"  },\n"
"  {\n"
"    \"targets\": [ \"<server>:80\" ],\n"
"    \"labels\": {\n"
"      \"role\": \"<suma-server>\",\n"
"      \"job\": \"<suma-refhost>\",\n"
"      \"__metrics_path__\": \"/rhn/metrics\"\n"
"    }\n"
"  }\n"
"]\n"
msgstr ""
"[\n"
"  {\n"
"    \"targets\": [ \"<client1>:9100\", \"<client2>:9100\" ],\n"
"    \"labels\": {\n"
"      \"role\": \"<suma-client>\",\n"
"      \"job\": \"<suma-refclient>\"\n"
"    }\n"
"  },\n"
"  {\n"
"    \"targets\": [ \"<server>:80\" ],\n"
"    \"labels\": {\n"
"      \"role\": \"<suma-server>\",\n"
"      \"job\": \"<suma-refhost>\",\n"
"      \"__metrics_path__\": \"/rhn/metrics\"\n"
"    }\n"
"  }\n"
"]\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:87
msgid "For more information, see https://prometheus.io/docs/guides/file-sd/."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມ, ໃຫ້ເບິ່ງທີ່ https://prometheus.io/docs/guides/file-sd/."

#. type: Title ===
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:88
#, no-wrap
msgid "TLS certificates and keys"
msgstr "ໃບຢັ້ງຢືນ TLS ແລະ ຄີ"

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:90
#, no-wrap
msgid "Activate Forms"
msgstr "ເປີດໃຊ້ແບບຟອມ"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-monitoring.adoc:91
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:114
msgid "When you have completed and saved all the forms, apply the highstate."
msgstr "ເມື່ອທ່ານຕື່ມຂໍ້ມູນ ແລະ ບັນທຶກແບບຟອມທັງໝົດແລ້ວ, ໃຫ້ຄລິກນຳໃຊ້ highstate."

#. type: Title =
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:1
#, no-wrap
msgid "PXE Formula"
msgstr "ສູດ PXE"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:2
msgid "The PXE formula is used to configure PXE booting on the branch server."
msgstr "ສູດ PXE ແມ່ນໃຊ້ເພື່ອຕັ້ງຄ່າການບູດ PXE ໃນເຊີເວີສາຂາ."

#. type: Block title
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:4
#, no-wrap
msgid "Procedure: Configuring PXE Booting"
msgstr "ຂັ້ນຕອນ: ການຕັ້ງຄ່າການບູດ PXE"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:6
msgid "Select the [systemitem]``Pxe`` formula, and click [btn]``Save``."
msgstr "ເລືອກສູດ [systemitem]``Pxe``, ແລະ ກົດ [btn]``Save``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:7
msgid "Navigate to the menu:Formulas[Pxe] tab, and set these parameters:"
msgstr "ໄປທີ່ແທັບ menu:Formulas[Pxe], ແລະ ຕັ້ງພາລາມິເຕີເຫຼົ່ານີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:8
msgid "In the [guimenu]``Kernel Filename`` field, keep the default value."
msgstr "ໃນຊ່ອງ [guimenu]``Kernel Filename``, ໃຫ້ໃຊ້ຄ່າມາດຕະຖານໄວ້ຄືເກົ່າ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:9
msgid "In the [guimenu]``Initrd Filename`` field, keep the default value."
msgstr "ໃນຊ່ອງ [guimenu]``Initrd Filename``, ໃຫ້ໃຊ້ຄ່າມາດຕະຖານໄວ້ຄືເກົ່າ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:10
msgid ""
"If the terminals connecting to this branch server are running {arm64} "
"architecture, check the [guimenu]``Enable ARM64 UEFI boot`` box.  Leave "
"unchecked for {x86_64}."
msgstr "ຫາກເທີມິນໍທີ່ເຊື່ອມຕໍ່ກັບເຊີເວີສາຂານີ້ໃຊ້ສະຖາປັດຕະຍະກຳ {arm64}, ໃຫ້ໝາຍຕິກຊ່ອງ [guimenu]``Enable ARM64 UEFI boot``. ຫາກເປັນ {x86_64} ໃຫ້ປະຫວ່າງໄວ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:11
msgid "In the [guimenu]``Kernel Filename for ARM64`` field, keep the default value."
msgstr "ໃນຊ່ອງ [guimenu]``Kernel Filename for ARM64``, ໃຫ້ໃຊ້ຄ່າມາດຕະຖານໄວ້ຄືເກົ່າ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:12
msgid "In the [guimenu]``Initrd Filename for ARM64`` field, keep the default value."
msgstr "ໃນຊ່ອງ [guimenu]``Initrd Filename for ARM64``, ໃຫ້ໃຊ້ຄ່າມາດຕະຖານໄວ້ຄືເກົ່າ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:13
msgid ""
"In the [guimenu]``Kernel Command Line Parameters`` field, keep the default "
"value.  For more information about possible values, see "
"<<retail.sect.formulas.pxe.kernelparams>>."
msgstr "ໃນຊ່ອງ [guimenu]``Kernel Command Line Parameters``, ໃຫ້ໃຊ້ຄ່າມາດຕະຖານໄວ້ຄືເກົ່າ. ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບຄ່າທີ່ເປັນໄປໄດ້, ໃຫ້ເບິ່ງທີ່ <<retail.sect.formulas.pxe.kernelparams>>."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:14
msgid ""
"In the [guimenu]``PXE root directory`` field, enter the path to the "
"{saltboot} directory (for example, [systemitem]``/srv/saltboot``)."
msgstr "ໃນຊ່ອງ [guimenu]``PXE root directory``, ປ້ອນເສັ້ນທາງໄປຫາໄດເຣັກທໍຣີ {saltboot} (ຕົວຢ່າງ, [systemitem]``/srv/saltboot``)."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:15
msgid "Click [btn]``Save Formula`` to save your configuration."
msgstr "ກົດ [btn]``Save Formula`` ເພື່ອບັນທຶກການຕັ້ງຄ່າຂອງທ່ານ."

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:17
#, no-wrap
msgid "{saltboot} Kernel Command Line Parameters"
msgstr "ພາລາມິເຕີບັນທັດຄຳສັ່ງ Kernel ຂອງ {saltboot}"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:18
msgid ""
"{saltboot} supports common kernel parameters and {saltboot}-specific kernel "
"parameters.  All the parameters can be entered in the [guimenu]``Kernel "
"Command Line Parameters`` field of the PXE formula."
msgstr "{saltboot} ຮອງຮັບພາລາມິເຕີ kernel ທົ່ວໄປ ແລະ ພາລາມິເຕີ kernel ສະເພາະຂອງ {saltboot}. ພາລາມິເຕີທັງໝົດສາມາດປ້ອນເຂົ້າໃນຊ່ອງ [guimenu]``Kernel Command Line Parameters`` ຂອງສູດ PXE ໄດ້."

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:19
#, no-wrap
msgid "[systemitem]``kiwidebug=1``"
msgstr "[systemitem]``kiwidebug=1``"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:20
msgid "Starts a shell on tty2 during boot and enables debug logging in Salt."
msgstr "ເລີ່ມຕົ້ນ shell ໃນ tty2 ໃນລະຫວ່າງການບູດ ແລະ ເປີດໃຊ້ການບັນທຶກ debug ໃນ Salt."

#. type: delimited block =
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:21
msgid ""
"Do not use this parameter in a production environment as it creates a major "
"security hole.  This parameter should be used only in a development "
"environment for debug purposes."
msgstr "ຫ້າມໃຊ້ພາລາມິເຕີນີ້ໃນສະພາບແວດລ້ອມການຜະລິດ (production) ເພາະມັນຈະເຮັດໃຫ້ເກີດຊ່ອງໂຫວ່ດ້ານຄວາມປອດໄພທີ່ຮ້າຍແຮງ. ພາລາມິເຕີນີ້ຄວນໃຊ້ໃນສະພາບແວດລ້ອມການພັດທະນາເພື່ອຈຸດປະສົງໃນການ debug ເທົ່ານັ້ນ."

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:22
#, no-wrap
msgid "[systemitem]``MASTER``"
msgstr "[systemitem]``MASTER``"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:23
msgid "Overrides auto-detection of the Salt master. For example:"
msgstr "ຂ້າມການກວດຫາອັດຕະໂນມັດຂອງ Salt master. ຕົວຢ່າງ:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:24
#, no-wrap
msgid "MASTER=myproxy.domain.com\n"
msgstr "MASTER=myproxy.domain.com\n"

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:25
#, no-wrap
msgid "[systemitem]``SALT_TIMEOUT``"
msgstr "[systemitem]``SALT_TIMEOUT``"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:26
msgid ""
"Overrides the local boot fallback timeout if the Salt master does not apply "
"the {saltboot} state within this timeout (default: 60 seconds).  For "
"example:"
msgstr "ຂ້າມເວລາໝົດກຳນົດ (timeout) ຂອງການບູດເຄື່ອງພາຍໃນເຄື່ອງ (local boot fallback) ຫາກ Salt master ບໍ່ນຳໃຊ້ສະຖານະ {saltboot} ພາຍໃນເວລານີ້ (ມາດຕະຖານ: 60 ວິນາທີ). ຕົວຢ່າງ:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:27
#, no-wrap
msgid "SALT_TIMEOUT=300\n"
msgstr "SALT_TIMEOUT=300\n"

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:28
#, no-wrap
msgid "[systemitem]``DISABLE_HOSTNAME_ID``"
msgstr "[systemitem]``DISABLE_HOSTNAME_ID``"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:29
msgid ""
"If the terminal has a hostname assigned by DHCP, it is by default used as a "
"minion ID.  Setting this option to `1` disables this mechanism, and SMBios "
"information will be used as a minion ID."
msgstr "ຫາກເທີມິນໍມີຊື່ໂຮສທີ່ຖືກກຳນົດໂດຍ DHCP, ໂດຍມາດຕະຖານມັນຈະຖືກໃຊ້ເປັນ minion ID. ການຕັ້ງຄ່າໂຕເລືອກນີ້ເປັນ `1` ຈະປິດການເຮັດວຽກນີ້, ແລະ ຈະໃຊ້ຂໍ້ມູນ SMBios ເປັນ minion ID ແທນ."

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:30
#, no-wrap
msgid "[systemitem]``DISABLE_UNIQUE_SUFFIX``"
msgstr "[systemitem]``DISABLE_UNIQUE_SUFFIX``"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:31
msgid ""
"Setting this option to `1` disables adding random generated suffix to "
"terminal minion ID."
msgstr "ການຕັ້ງຄ່າໂຕເລືອກນີ້ເປັນ `1` ຈະປິດການເພີ່ມຄຳຕໍ່ທ້າຍ (suffix) ທີ່ສຸ່ມສ້າງຂຶ້ນໃຫ້ກັບ minion ID ຂອງເທີມິນໍ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:32
msgid ""
"If you set this parameter make sure your terminal has either a unique "
"hostname provided by DHCP and DNS, or the terminal hardware comes with a "
"unique serial number stored in its SMBios memory.  Otherwise there is a risk "
"of terminal minion ID duplicity, and bootstrapping the minion will fail."
msgstr "ຫາກທ່ານຕັ້ງພາລາມິເຕີນີ້, ໃຫ້ແນ່ໃຈວ່າເທີມິນໍຂອງທ່ານມີຊື່ໂຮສທີ່ບໍ່ຊໍ້າກັນເຊິ່ງສະໜອງໂດຍ DHCP ແລະ DNS, ຫຼື ອຸປະກອນເທີມິນໍມາກັບໝາຍເລກຊີຣຽວ (serial number) ທີ່ບໍ່ຊໍ້າກັນເຊິ່ງເກັບໄວ້ໃນໜ່ວຍຄວາມຈຳ SMBios. ບໍ່ດັ່ງນັ້ນ, ອາດມີຄວາມສ່ຽງທີ່ minion ID ຂອງເທີມິນໍຈະຊໍ້າກັນ, ແລະ ການ bootstrap minion ຈະຫຼົ້ມເຫຼວ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:33
msgid ""
"The following parameters (`MINION_ID_PREFIX`, `salt_device`, `root`) are "
"usually autoconfigured and should be used only in specific conditions such "
"as debugging or development:"
msgstr "ພາລາມິເຕີຕໍ່ໄປນີ້ (`MINION_ID_PREFIX`, `salt_device`, `root`) ໂດຍປົກກະຕິແລ້ວຈະຖືກຕັ້ງຄ່າໂດຍອັດຕະໂນມັດ ແລະ ຄວນໃຊ້ໃນເງື່ອນໄຂສະເພາະເທົ່ານັ້ນ ເຊັ່ນ ການ debugging ຫຼື ການພັດທະນາ:"

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:34
#, no-wrap
msgid "[systemitem]``MINION_ID_PREFIX``"
msgstr "[systemitem]``MINION_ID_PREFIX``"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:35
msgid "Branch ID set in the Branch Network formula form."
msgstr "ID ຂອງສາຂາທີ່ຕັ້ງໄວ້ໃນແບບຟອມສູດເຄືອຂ່າຍສາຂາ."

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:36
#, no-wrap
msgid "[systemitem]``salt_device``"
msgstr "[systemitem]``salt_device``"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:37
msgid "Device that contains the Salt configuration."
msgstr "ອຸປະກອນທີ່ປະກອບມີການຕັ້ງຄ່າ Salt."

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:38
#, no-wrap
msgid "[systemitem]``root``"
msgstr "[systemitem]``root``"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-pxe.adoc:39
msgid ""
"Device that contains the already deployed root file system.  Used for "
"falling back to local boot."
msgstr "ອຸປະກອນທີ່ປະກອບມີລະບົບໄຟລ໌ຮາກ (root file system) ທີ່ຖືກຕິດຕັ້ງແລ້ວ. ໃຊ້ສຳລັບການບູດເຄື່ອງພາຍໃນເຄື່ອງ (local boot)."

#. type: Title =
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:1
#, no-wrap
msgid "{saltboot} Formula"
msgstr "ສູດ {saltboot}"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:2
msgid ""
"The {saltboot} formula is used to configure disk images and partitioning for "
"the selected hardware type."
msgstr "ສູດ {saltboot} ແມ່ນໃຊ້ເພື່ອຕັ້ງຄ່າຮູບພາບດິດ (disk images) ແລະ ການແບ່ງພາກສ່ວນ (partitioning) ສຳລັບປະເພດຮາດແວທີ່ເລືອກ."

#. type: delimited block =
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:3
msgid ""
"The {saltboot} formula is meant to be used as a group formula.  Enable and "
"configure {saltboot} formula for hardware type groups."
msgstr "ສູດ {saltboot} ມີໄວ້ເພື່ອໃຊ້ເປັນສູດກຸ່ມ. ໃຫ້ເປີດໃຊ້ ແລະ ຕັ້ງຄ່າສູດ {saltboot} ສຳລັບກຸ່ມປະເພດຮາດແວ."

#. type: delimited block =
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:4
msgid ""
"To apply changes to a terminal, terminal needs to be restarted.  Applying "
"highstate does not have any effect on running terminals."
msgstr "ເພື່ອໃຫ້ນຳໃຊ້ການປ່ຽນແປງກັບເທີມິນໍ, ຕ້ອງໄດ້ຣີສະຕາດເທີມິນໍໃໝ່. ການນຳໃຊ້ highstate ຈະບໍ່ມີຜົນໃດໆ ຕໍ່ເທີມິນໍທີ່ກຳລັງເຮັດວຽກຢູ່."

#. type: Block title
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:5
#, no-wrap
msgid "Procedure: Configuring the Hardware Type Group with {saltboot}"
msgstr "ຂັ້ນຕອນ: ການຕັ້ງຄ່າກຸ່ມປະເພດຮາດແວດ້ວຍ {saltboot}"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:6
msgid ""
"Open the details page for your new hardware type group, and navigate to the "
"[guimenu]``Formulas`` tab."
msgstr "ເປີດໜ້າລາຍລະອຽດສຳລັບກຸ່ມປະເພດຮາດແວໃໝ່ຂອງທ່ານ, ແລະ ໄປທີ່ແທັບ [guimenu]``Formulas``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:7
msgid "Select the {saltboot} formula and click btn:[Save]."
msgstr "ເລືອກສູດ {saltboot} ແລະ ກົດ btn:[Save]."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:8
msgid "Navigate to the menu:Formulas[Saltboot] tab."
msgstr "ໄປທີ່ແທັບ menu:Formulas[Saltboot]."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:9
msgid "In the [guimenu]``Disk 1`` section, set these parameters:"
msgstr "ໃນພາກສ່ວນ [guimenu]``Disk 1``, ໃຫ້ຕັ້ງພາລາມິເຕີເຫຼົ່ານີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:10
msgid ""
"In the [guimenu]``Disk symbolic ID`` field, enter a custom name for the disk "
"(for example, [systemitem]``disk1``)."
msgstr "ໃນຊ່ອງ [guimenu]``Disk symbolic ID``, ໃຫ້ປ້ອນຊື່ທີ່ກຳນົດເອງສຳລັບດິດ (ຕົວຢ່າງ, [systemitem]``disk1``)."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:11
msgid "In the [guimenu]``Device type`` field, select [systemitem]``DISK``."
msgstr "ໃນຊ່ອງ [guimenu]``Device type``, ເລືອກ [systemitem]``DISK``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:12
msgid ""
"In the [guimenu]``Disk device`` field, select the device that corresponds to "
"the device name on the target machine or asterisk [systemitem]``*``, see "
"xref:saltboot-formula-disk-selection[]."
msgstr "ໃນຊ່ອງ [guimenu]``Disk device``, ເລືອກອຸປະກອນທີ່ກົງກັບຊື່ອຸປະກອນໃນເຄື່ອງເປົ້າໝາຍ ຫຼື ໃຊ້ເຄື່ອງໝາຍດອກຈັນ [systemitem]``*``, ເບິ່ງທີ່ xref:saltboot-formula-disk-selection[]."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:13
msgid "In the [guimenu]``RAID level`` field, leave it empty."
msgstr "ໃນຊ່ອງ [guimenu]``RAID level``, ໃຫ້ປະຫວ່າງໄວ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:14
msgid "In the [guimenu]``Disk Label`` field, select [systemitem]``gpt``."
msgstr "ໃນຊ່ອງ [guimenu]``Disk Label``, ເລືອກ [systemitem]``gpt``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:15
msgid ""
"In the [guimenu]``Partition`` section, set these parameters for "
"[guimenu]``Partition 1``:"
msgstr "ໃນພາກສ່ວນ [guimenu]``Partition``, ໃຫ້ຕັ້ງພາລາມິເຕີເຫຼົ່ານີ້ສຳລັບ [guimenu]``Partition 1``:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:16
msgid ""
"In the [guimenu]``Partition symbolic ID`` field, enter a custom name for the "
"partition (for example, [systemitem]``p1``)."
msgstr "ໃນຊ່ອງ [guimenu]``Partition symbolic ID``, ໃຫ້ປ້ອນຊື່ທີ່ກຳນົດເອງສຳລັບພາກສ່ວນ (ຕົວຢ່າງ, [systemitem]``p1``)."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:17
msgid "In the [guimenu]``Partition size`` use value 500."
msgstr "ໃນຊ່ອງ [guimenu]``Partition size`` ໃຫ້ໃຊ້ຄ່າ 500."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:18
msgid "In the [guimenu]``Device mount point`` use [path]``/boot/efi``."
msgstr "ໃນຊ່ອງ [guimenu]``Device mount point`` ໃຫ້ໃຊ້ [path]``/boot/efi``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:19
msgid "In the [guimenu]``Filesystem format`` use [systemitem]``vfat``."
msgstr "ໃນຊ່ອງ [guimenu]``Filesystem format`` ໃຫ້ໃຊ້ [systemitem]``vfat``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:20
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:28
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:36
msgid "In the [guimenu]``OS Image to deploy`` field, leave it empty."
msgstr "ໃນຊ່ອງ [guimenu]``OS Image to deploy``, ໃຫ້ປະຫວ່າງໄວ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:21
msgid "In the [guimenu]``Partition encryption password`` field, leave it empty."
msgstr "ໃນຊ່ອງ [guimenu]``Partition encryption password``, ໃຫ້ປະຫວ່າງໄວ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:22
msgid "In the [guimenu]``Partition flags`` use [systemitem]``boot``."
msgstr "ໃນຊ່ອງ [guimenu]``Partition flags`` ໃຫ້ໃຊ້ [systemitem]``boot``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:23
msgid ""
"In the [guimenu]``Partition`` section, set these parameters for "
"[guimenu]``Partition 2``:"
msgstr "ໃນພາກສ່ວນ [guimenu]``Partition``, ໃຫ້ຕັ້ງພາລາມິເຕີເຫຼົ່ານີ້ສຳລັບ [guimenu]``Partition 2``:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:24
msgid ""
"In the [guimenu]``Partition symbolic ID`` field, enter a custom name for the "
"partition (for example, [systemitem]``p2``)."
msgstr "ໃນຊ່ອງ [guimenu]``Partition symbolic ID``, ໃຫ້ປ້ອນຊື່ທີ່ກຳນົດເອງສຳລັບພາກສ່ວນ (ຕົວຢ່າງ, [systemitem]``p2``)."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:25
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:33
msgid ""
"In the [guimenu]``Partition size`` field, specify a size for the partition "
"in Mebibytes (MiB)."
msgstr "ໃນຊ່ອງ [guimenu]``Partition size``, ໃຫ້ລະບຸຂະໜາດສຳລັບພາກສ່ວນເປັນ ເມບີໄບຕ໌ (MiB)."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:26
msgid ""
"In the [guimenu]``Device mount point`` field, select a location to mount the "
"partition (for example, [path]``/data``)."
msgstr "ໃນຊ່ອງ [guimenu]``Device mount point``, ເລືອກຕຳແໜ່ງທີ່ຈະເມົາທ໌ (mount) ພາກສ່ວນ (ຕົວຢ່າງ, [path]``/data``)."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:27
msgid ""
"In the [guimenu]``Filesystem format`` field, select your preferred format "
"(for example, [systemitem]``xfs``)."
msgstr "ໃນຊ່ອງ [guimenu]``Filesystem format``, ເລືອກຮູບແບບທີ່ທ່ານຕ້ອງການ (ຕົວຢ່າງ, [systemitem]``xfs``)."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:29
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:37
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:48
msgid ""
"In the [guimenu]``Partition encryption password`` field, enter a password if "
"you want to encrypt the partition."
msgstr "ໃນຊ່ອງ [guimenu]``Partition encryption password``, ໃຫ້ປ້ອນລະຫັດຜ່ານຫາກທ່ານຕ້ອງການເຂົ້າລະຫັດພາກສ່ວນນັ້ນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:30
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:49
msgid "In the [guimenu]``Partition flags`` field, leave it empty."
msgstr "ໃນຊ່ອງ [guimenu]``Partition flags``, ໃຫ້ປະຫວ່າງໄວ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:31
msgid ""
"In the [guimenu]``Partition`` section, set these parameters for "
"[guimenu]``Partition 3``:"
msgstr "ໃນພາກສ່ວນ [guimenu]``Partition``, ໃຫ້ຕັ້ງພາລາມິເຕີເຫຼົ່ານີ້ສຳລັບ [guimenu]``Partition 3``:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:32
msgid ""
"In the [guimenu]``Partition symbolic ID`` field, enter a custom name for the "
"partition (for example, [systemitem]``p3``)."
msgstr "ໃນຊ່ອງ [guimenu]``Partition symbolic ID``, ໃຫ້ປ້ອນຊື່ທີ່ກຳນົດເອງສຳລັບພາກສ່ວນ (ຕົວຢ່າງ, [systemitem]``p3``)."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:34
msgid "In the [guimenu]``Device mount point`` field, leave it empty."
msgstr "ໃນຊ່ອງ [guimenu]``Device mount point``, ໃຫ້ປະຫວ່າງໄວ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:35
msgid "In the [guimenu]``Filesystem format`` field, select [systemitem]``swap``."
msgstr "ໃນຊ່ອງ [guimenu]``Filesystem format``, ເເລືອກ [systemitem]``swap``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:38
msgid "In the [guimenu]``Partition flags`` field, select [systemitem]``swap``."
msgstr "ໃນຊ່ອງ [guimenu]``Partition flags``, ເລືອກ [systemitem]``swap``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:39
msgid ""
"In the [guimenu]``Partition`` section, set these parameters for "
"[guimenu]``Partition 4``:"
msgstr "ໃນພາກສ່ວນ [guimenu]``Partition``, ໃຫ້ຕັ້ງພາລາມິເຕີເຫຼົ່ານີ້ສຳລັບ [guimenu]``Partition 4``:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:40
msgid ""
"In the [guimenu]``Partition symbolic ID`` field, enter a custom name for the "
"partition (for example, [systemitem]``p4``)."
msgstr "ໃນຊ່ອງ [guimenu]``Partition symbolic ID``, ໃຫ້ປ້ອນຊື່ທີ່ກຳນົດເອງສຳລັບພາກສ່ວນ (ຕົວຢ່າງ, [systemitem]``p4``)."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:41
msgid "In the [guimenu]``Partition size`` field, leave it empty."
msgstr "ໃນຊ່ອງ [guimenu]``Partition size``, ໃຫ້ປະຫວ່າງໄວ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:42
msgid "This will ensure the partition uses up all remaining space."
msgstr "ສິ່ງນີ້ຈະເຮັດໃຫ້ແນ່ໃຈວ່າພາກສ່ວນນັ້ນໃຊ້ເນື້ອທີ່ທັງໝົດທີ່ຍັງເຫຼືອຢູ່."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:43
msgid "In the [guimenu]``Device mount point`` field, select [systemitem]``/``."
msgstr "ໃນຊ່ອງ [guimenu]``Device mount point``, ເລືອກ [systemitem]``/``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:44
msgid "In the [guimenu]``Filesystem format`` field, leave it empty."
msgstr "ໃນຊ່ອງ [guimenu]``Filesystem format``, ໃຫ້ປະຫວ່າງໄວ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:45
msgid ""
"In the [guimenu]``OS Image to deploy`` field, enter the name of the image to "
"deploy."
msgstr "ໃນຊ່ອງ [guimenu]``OS Image to deploy``, ໃຫ້ປ້ອນຊື່ຂອງຮູບພາບທີ່ຈະຕິດຕັ້ງ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:46
msgid "In the [guimenu]``Image version`` field, leave it empty."
msgstr "ໃນຊ່ອງ [guimenu]``Image version``, ໃຫ້ປະຫວ່າງໄວ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:47
msgid "This will ensure you use the latest available version."
msgstr "ສິ່ງນີ້ຈະເຮັດໃຫ້ແນ່ໃຈວ່າທ່ານໃຊ້ເວີຊັນຫຼ້າສຸດທີ່ມີຢູ່."

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:51
#, no-wrap
msgid "Special Partition Types"
msgstr "ປະເພດພາກສ່ວນ (Partition) ພິເສດ"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:52
msgid "The {saltboot} formula helps you with setting up special partition types."
msgstr "ສູດ {saltboot} ຊ່ວຍທ່ານໃນການຕັ້ງຄ່າປະເພດພາກສ່ວນພິເສດ."

#. type: delimited block =
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:53
msgid ""
"For terminal to be able to boot locally, either [systemitem]``BIOS grub`` or "
"[systemitem]``EFI`` partition must be configured."
msgstr "ເພື່ອໃຫ້ເທີມິນໍສາມາດບູດຈາກພາຍໃນເຄື່ອງໄດ້, ຕ້ອງມີການຕັ້ງຄ່າພາກສ່ວນ [systemitem]``BIOS grub`` ຫຼື [systemitem]``EFI`` ຢ່າງໃດຢ່າງໜຶ່ງ."

#. type: Title ===
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:54
#, no-wrap
msgid "BIOS grub Partition"
msgstr "ພາກສ່ວນ BIOS grub"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:55
msgid ""
"A BIOS grub partition is needed for local booting from a `GPT` disk on "
"non-EFI machines.  For more information, see "
"https://en.wikipedia.org/wiki/BIOS_boot_partition."
msgstr "ພາກສ່ວນ BIOS grub ແມ່ນຈຳເປັນສຳລັບການບູດຈາກພາຍໃນເຄື່ອງຈາກດິດແບບ `GPT` ໃນເຄື່ອງທີ່ບໍ່ແມ່ນ EFI. ສຳລັບຂໍ້ມູນເພີ່ມເຕີມ, ໃຫ້ເບິ່ງທີ່ https://en.wikipedia.org/wiki/BIOS_boot_partition."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:56
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:61
msgid "In the formula, enter the following options:"
msgstr "ໃນສູດ, ໃຫ້ປ້ອນໂຕເລືອກຕໍ່ໄປນີ້:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:57
#, no-wrap
msgid ""
"Partition Symbolic ID: p1\n"
"Partition Size (MiB): 50\n"
"Partition Flags: bios_grub\n"
msgstr ""
"Partition Symbolic ID: p1\n"
"Partition Size (MiB): 50\n"
"Partition Flags: bios_grub\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:58
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:63
msgid "Leave the other fields empty."
msgstr "ປະຊ່ອງອື່ນໆ ໃຫ້ຫວ່າງໄວ້."

#. type: Title ===
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:59
#, no-wrap
msgid "EFI Partition"
msgstr "ພາກສ່ວນ EFI"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:60
msgid ""
"An EFI partition is needed for local booting on EFI machines, "
"[guimenu]``Partition Table Type`` must be `GPT`.  For more information, see "
"https://en.wikipedia.org/wiki/EFI_system_partition."
msgstr "ພາກສ່ວນ EFI ແມ່ນຈຳເປັນສຳລັບການບູດຈາກພາຍໃນເຄື່ອງໃນເຄື່ອງ EFI, [guimenu]``Partition Table Type`` ຕ້ອງເປັນ `GPT`. ສຳລັບຂໍ້ມູນເພີ່ມເຕີມ, ໃຫ້ເບິ່ງທີ່ https://en.wikipedia.org/wiki/EFI_system_partition."

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:62
#, no-wrap
msgid ""
"Partition Symbolic ID: p1\n"
"Partition Size (MiB): 500\n"
"Device Mount Point: /boot/efi\n"
"Filesystem Format: vfat\n"
"Partition Flags: boot\n"
msgstr ""
"Partition Symbolic ID: p1\n"
"Partition Size (MiB): 500\n"
"Device Mount Point: /boot/efi\n"
"Filesystem Format: vfat\n"
"Partition Flags: boot\n"

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:64
#, no-wrap
msgid "Disk Selection in {saltboot} Formula"
msgstr "ການເລືອກດິດໃນສູດ {saltboot}"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:65
msgid ""
"When there is only one disk present on target hardware (including USB "
"drives), use an asterisk [systemitem]``*`` to automatically select the disk "
"device."
msgstr "ເມື່ອມີດິດພຽງໜຶ່ງອັນໃນຮາດແວເປົ້າໝາຍ (ລວມທັງ USB drive), ໃຫ້ໃຊ້ເຄື່ອງໝາຍດອກຈັນ [systemitem]``*`` ເພື່ອເລືອກອຸປະກອນດິດໂດຍອັດຕະໂນມັດ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:66
msgid ""
"When there are multiple disks, use an asterisk [systemitem]``*`` in the "
"device path.  In this example, SATA disks are differentiated from USB disks:"
msgstr "ເມື່ອມີດິດຫຼາຍອັນ, ໃຫ້ໃຊ້ເຄື່ອງໝາຍດອກຈັນ [systemitem]``*`` ໃນເສັ້ນທາງອຸປະກອນ. ໃນຕົວຢ່າງນີ້, ດິດ SATA ຈະຖືກແຍກອອກຈາກດິດ USB:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:67
#, no-wrap
msgid ""
"/dev/disk/by-path/*-ata-1\n"
"/dev/disk/by-path/*usb*\n"
msgstr ""
"/dev/disk/by-path/*-ata-1\n"
"/dev/disk/by-path/*usb*\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:68
msgid ""
"If the entered value does not contain [systemitem]``/``, the entered value "
"is automatically prepended by [path]``/dev/disk/by-path/``.  For example, "
"[systemitem]``\\*usb*`` is the same as [path]``/dev/disk/by-path/\\*usb*``."
msgstr "ຫາກຄ່າທີ່ປ້ອນບໍ່ມີ [systemitem]``/``, ຄ່າທີ່ປ້ອນນັ້ນຈະຖືກຕື່ມ [path]``/dev/disk/by-path/`` ໃສ່ທາງໜ້າໂດຍອັດຕະໂນມັດ. ຕົວຢ່າງ, [systemitem]``\\*usb*`` ຈະມີຄ່າເທົ່າກັບ [path]``/dev/disk/by-path/\\*usb*``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:69
msgid ""
"If you prefer to select specific devices, you can this format in the disk "
"device field:"
msgstr "ຫາກທ່ານຕ້ອງການເລືອກອຸປະກອນສະເພາະ, ທ່ານສາມາດໃຊ້ຮູບແບບນີ້ໃນຊ່ອງອຸປະກອນດິດ:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:70
msgid "symbolic names (for example: [path]``/dev/sda``)"
msgstr "ຊື່ສັນຍະລັກ (ຕົວຢ່າງ: [path]``/dev/sda``)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:71
msgid "by-path (for example: [path]``/dev/disk/by-path/..``)"
msgstr "ຕາມເສັ້ນທາງ (ຕົວຢ່າງ: [path]``/dev/disk/by-path/..``)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:72
msgid "by-id (for example: [path]``/dev/disk/by-id/...``)"
msgstr "ຕາມໄອດີ (ຕົວຢ່າງ: [path]``/dev/disk/by-id/...``)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:73
msgid ""
"To see a list of available devices from the command prompt, press kbd:[Esc] "
"while waiting for key approval."
msgstr "ຫາກຕ້ອງການເບິ່ງລາຍການອຸປະກອນທີ່ມີຢູ່ຈາກພອມພ໌ຄຳສັ່ງ (command prompt), ໃຫ້ກົດ kbd:[Esc] ໃນລະຫວ່າງທີ່ລໍຖ້າການອະນຸມັດຄີ."

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:74
#, no-wrap
msgid "Troubleshooting the {saltboot} Formula"
msgstr "ການແກ້ໄຂບັນຫາສູດ {saltboot}"

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:75
#, no-wrap
msgid "``msdos`` Disklabel Limitations"
msgstr "ຂໍ້ຈຳກັດຂອງ Disklabel ແບບ ``msdos``"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-saltboot.adoc:76
msgid ""
"On the ``msdos`` disk label, you can create a maximum of four primary "
"partitions.  Extended partitions are not supported.  If you need more than "
"four partitions, use the ``GPT`` disk label instead."
msgstr "ໃນ disk label ແບບ ``msdos``, ທ່ານສາມາດສ້າງພາກສ່ວນຫຼັກ (primary partitions) ໄດ້ສູງສຸດພຽງສີ່ອັນ. ບໍ່ຮອງຮັບພາກສ່ວນເສີມ (extended partitions). ຫາກທ່ານຕ້ອງການຫຼາຍກວ່າສີ່ພາກສ່ວນ, ໃຫ້ໃຊ້ disk label ແບບ ``GPT`` ແທນ."

#. type: Title =
#: modules/specialized-guides/pages/salt/salt-formula-tftpd.adoc:1
#, no-wrap
msgid "TFTPd Formula"
msgstr "ສູດ TFTPd"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-tftpd.adoc:2
msgid ""
"The TFTPd formula is used to configure the TFTP service on the {productname} "
"{smr} branch server."
msgstr "ສູດ TFTPd ແມ່ນໃຊ້ເພື່ອຕັ້ງຄ່າການບໍລິການ TFTP ໃນເຊີເວີສາຂາ {productname} {smr}."

#. type: Block title
#: modules/specialized-guides/pages/salt/salt-formula-tftpd.adoc:4
#, no-wrap
msgid "Procedure: Configuring TFTP"
msgstr "ຂັ້ນຕອນ: ການຕັ້ງຄ່າ TFTP"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-tftpd.adoc:6
msgid "Select the [systemitem]``Tftpd`` formula, and click btn:[Save]."
msgstr "ເລືອກສູດ [systemitem]``Tftpd``, ແລະ ກົດ btn:[Save]."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-tftpd.adoc:7
msgid "Navigate to the menu:Formulas[Tftpd] tab, and set these parameters:"
msgstr "ໄປທີ່ແທັບ menu:Formulas[Tftpd], ແລະ ຕັ້ງພາລາມິເຕີເຫຼົ່ານີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-tftpd.adoc:8
msgid ""
"In the [guimenu]``Internal Network Address`` field, enter the IP address of "
"the branch server (for example: [systemitem]``192.168.1.5``)."
msgstr "ໃນຊ່ອງ [guimenu]``Internal Network Address``, ໃຫ້ປ້ອນທີ່ຢູ່ IP ຂອງເຊີເວີສາຂາ (ຕົວຢ່າງ: [systemitem]``192.168.1.5``)."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-tftpd.adoc:9
msgid ""
"In the [guimenu]``TFTP Base Directory`` field, enter the path to the "
"{saltboot} directory (for example, [systemitem]``/srv/saltboot``)."
msgstr "ໃນຊ່ອງ [guimenu]``TFTP Base Directory``, ໃຫ້ປ້ອນເສັ້ນທາງໄປຫາໄດເຣັກທໍຣີ {saltboot} (ຕົວຢ່າງ, [systemitem]``/srv/saltboot``)."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-tftpd.adoc:10
msgid ""
"In the [guimenu]``Run TFTP Under User`` field, enter "
"[systemitem]``saltboot``."
msgstr "ໃນຊ່ອງ [guimenu]``Run TFTP Under User``, ໃຫ້ປ້ອນ [systemitem]``saltboot``."

#. type: Title =
#: modules/specialized-guides/pages/salt/salt-formula-virtualization-guest.adoc:1
#, no-wrap
msgid "Virtualization Guest Formula"
msgstr "ສູດ Virtualization Guest"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-virtualization-guest.adoc:2
msgid ""
"The Virtualization Guest formula is used to configure settings for virtual "
"machine."
msgstr "ສູດ Virtualization Guest ແມ່ນໃຊ້ເພື່ອຕັ້ງຄ່າສຳລັບເຄື່ອງສະເໝືອນ (virtual machine)."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-virtualization-guest.adoc:3
msgid ""
"Open the [guimenu]``Tuning`` pull-down checklist and select from the "
"following virtual machine performance tuning settings:"
msgstr "ເປີດລາຍການກວດສອບ [guimenu]``Tuning`` ແລະ ເລືອກຈາກການຕັ້ງຄ່າປັບແຕ່ງປະສິດທິພາບຂອງເຄື່ອງສະເໝືອນດັ່ງຕໍ່ໄປນີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-virtualization-guest.adoc:4
msgid "[guimenu]``Disable IRQ balancing``."
msgstr "[guimenu]``Disable IRQ balancing``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-virtualization-guest.adoc:5
msgid ""
"[guimenu]``Disable Kernel Samepage Merging (KSM)``.  Reduces performance "
"overhead by not sharing memory across virtual machines."
msgstr "[guimenu]``Disable Kernel Samepage Merging (KSM)``. ຊ່ວຍຫຼຸດພາລະການເຮັດວຽກໂດຍການບໍ່ແບ່ງປັນໜ່ວຍຄວາມຈຳລະຫວ່າງເຄື່ອງສະເໝືອນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-virtualization-guest.adoc:6
msgid ""
"[guimenu]``Optimizations for KVM passed through host CPU``.  Requires the "
"KVM hint-dedicated option to be set on the VM definition."
msgstr "[guimenu]``Optimizations for KVM passed through host CPU``. ຕ້ອງການໃຫ້ຕັ້ງຄ່າໂຕເລືອກ KVM hint-dedicated ໃນການກຳນົດຄ່າ VM."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-virtualization-guest.adoc:7
#: modules/specialized-guides/pages/salt/salt-formula-virtualization-host.adoc:11
msgid ""
"When configured, click btn:[Save Formula] to save your configuration, and "
"apply the highstate."
msgstr "ເມື່ອຕັ້ງຄ່າແລ້ວ, ໃຫ້ຄລິກ btn:[Save Formula] ເພື່ອບັນທຶກການຕັ້ງຄ່າຂອງທ່ານ, ແລະ ນຳໃຊ້ highstate."

#. type: Title =
#: modules/specialized-guides/pages/salt/salt-formula-virtualization-host.adoc:1
#, no-wrap
msgid "Virtualization Host Formula"
msgstr "ສູດ Virtualization Host"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-virtualization-host.adoc:2
msgid ""
"The Virtualization Host formula is used to configure settings for a "
"virtualization host."
msgstr "ສູດ Virtualization Host ແມ່ນໃຊ້ເພື່ອຕັ້ງຄ່າສຳລັບເຄື່ອງທີ່ເປັນໂຮສຂອງລະບົບສະເໝືອນ (virtualization host)."

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formula-virtualization-host.adoc:3
#, no-wrap
msgid "Hypervisor"
msgstr "ໄຮເປີໄວເຊີ (Hypervisor)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-virtualization-host.adoc:4
msgid "Select KVM or Xen as the hypervisor."
msgstr "ເລືອກ KVM ຫຼື Xen ເປັນ hypervisor."

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formula-virtualization-host.adoc:5
#, no-wrap
msgid "Create default storage pool"
msgstr "ສ້າງ storage pool ມາດຕະຖານ"

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formula-virtualization-host.adoc:6
#, no-wrap
msgid "Create default virtual network"
msgstr "ສ້າງເຄືອຂ່າຍສະເໝືອນມາດຕະຖານ"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-virtualization-host.adoc:7
msgid ""
"Default pool: Open the pull-down list and enter the directory name of the "
"default storage pool."
msgstr "Default pool: ເປີດລາຍການລົງມາ ແລະ ປ້ອນຊື່ໄດເຣັກທໍຣີຂອງ storage pool ມາດຕະຖານ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-virtualization-host.adoc:8
msgid ""
"Default net: Open the pull-down list and configure the default virtual "
"network by setting the [guimenu]``Mode`` ([literal]``NAT`` or "
"[literal]``Bridge``) and the [guimenu]``Bridge name``."
msgstr "Default net: ເປີດລາຍການລົງມາ ແລະ ຕັ້ງຄ່າເຄືອຂ່າຍສະເໝືອນມາດຕະຖານໂດຍການຕັ້ງຄ່າ [guimenu]``Mode`` ([literal]``NAT`` ຫຼື [literal]``Bridge``) ແລະ [guimenu]``Bridge name``."

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formula-virtualization-host.adoc:9
#, no-wrap
msgid "Tuning"
msgstr "ການປັບແຕ່ງ (Tuning)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-virtualization-host.adoc:10
msgid "Enable IOMMU support (x86_64)."
msgstr "ເປີດໃຊ້ການຮອງຮັບ IOMMU (x86_64)."

#. type: Title =
#: modules/specialized-guides/pages/salt/salt-formula-vsftpd.adoc:1
#, no-wrap
msgid "VsFTPd Formula"
msgstr "ສູດ VsFTPd (VsFTPd Formula)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-vsftpd.adoc:2
msgid ""
"The VsFTPd formula is used to configure the FTP service on the branch "
"server."
msgstr "ສູດ VsFTPd ແມ່ນໃຊ້ເພື່ອຕັ້ງຄ່າບໍລິການ FTP ໃນເຊີເວີສາຂາ."

#. type: Block title
#: modules/specialized-guides/pages/salt/salt-formula-vsftpd.adoc:3
#, no-wrap
msgid "Procedure: Configuring VsFTPd"
msgstr "ຂັ້ນຕອນ: ການຕັ້ງຄ່າ VsFTPd"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-vsftpd.adoc:5
msgid "Select the [systemitem]``Vsftpd`` formula, and click btn:[Save]."
msgstr "ເລືອກສູດ [systemitem]``Vsftpd``, ແລ້ວຄລິກ btn:[Save]."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-vsftpd.adoc:6
msgid "Navigate to the menu:Formulas[Vsftpd] tab, and set these parameters:"
msgstr "ໄປທີ່ແທັບ menu:Formulas[Vsftpd], ແລະ ຕັ້ງຄ່າພະລາມິເຕີເຫຼົ່ານີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-vsftpd.adoc:7
msgid ""
"In the [guimenu]``FTP server directory`` field, enter "
"[systemitem]``/srv/saltboot``."
msgstr "ໃນຫ້ອງ [guimenu]``FTP server directory``, ໃຫ້ປ້ອນ [systemitem]``/srv/saltboot``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-vsftpd.adoc:8
msgid ""
"In the [guimenu]``Internal Network Address`` field, enter the IP address of "
"the branch server (for example: [literal]``192.168.1.5``)."
msgstr "ໃນຫ້ອງ [guimenu]``Internal Network Address``, ໃຫ້ປ້ອນທີ່ຢູ່ IP ຂອງເຊີເວີສາຂາ (ຕົວຢ່າງ: [literal]``192.168.1.5``)."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-vsftpd.adoc:9
msgid "All other fields can retain their default values."
msgstr "ຫ້ອງອື່ນໆທັງໝົດສາມາດໃຊ້ຄ່າເລີ່ມຕົ້ນໄດ້."

#. type: Title =
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:1
#, no-wrap
msgid "Yomi Formula"
msgstr "ສູດ Yomi"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:2
msgid ""
"The Yomi (yet one more installer) installer for {suse} and openSUSE "
"operating systems is configured using formulas with forms."
msgstr "ຕົວຕິດຕັ້ງ Yomi (yet one more installer) ສຳລັບລະບົບປະຕິບັດການ {suse} ແລະ openSUSE ຖືກຕັ້ງຄ່າໂດຍໃຊ້ສູດພ້ອມກັບແບບຟອມ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:3
msgid "The ``yomi-formula`` package provides these formulas:"
msgstr "ແພັກເກັດ ``yomi-formula`` ປະກອບມີສູດເຫຼົ່ານີ້:"

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:4
#: modules/specialized-guides/pages/salt/salt-yomi.adoc:63
#, no-wrap
msgid "Yomi"
msgstr "Yomi"

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:5
#: modules/specialized-guides/pages/salt/salt-yomi.adoc:66
#, no-wrap
msgid "Yomi Storage"
msgstr "Yomi Storage"

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:6
#: modules/specialized-guides/pages/salt/salt-yomi.adoc:94
#, no-wrap
msgid "Yomi Bootloader"
msgstr "Yomi Bootloader"

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:7
#: modules/specialized-guides/pages/salt/salt-yomi.adoc:100
#, no-wrap
msgid "Yomi Software"
msgstr "Yomi Software"

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:8
#: modules/specialized-guides/pages/salt/salt-yomi.adoc:111
#, no-wrap
msgid "Yomi Services"
msgstr "Yomi Services"

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:9
#: modules/specialized-guides/pages/salt/salt-yomi.adoc:116
#, no-wrap
msgid "Yomi Users"
msgstr "Yomi Users"

#. type: Block title
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:10
#, no-wrap
msgid "Procedure: Install the Yomi Formulas with Forms"
msgstr "ຂັ້ນຕອນ: ການຕິດຕັ້ງສູດ Yomi ພ້ອມແບບຟອມ"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:11
#: modules/specialized-guides/pages/salt/salt-yomi.adoc:25
msgid ""
"On the {productname} Server, at the command prompt, as root, install the "
"``yomi-formula`` package:"
msgstr "ໃນເຊີເວີ {productname}, ທີ່ພອມພ໌ຄຳສັ່ງ, ໃນຖານະ root, ໃຫ້ຕິດຕັ້ງແພັກເກັດ ``yomi-formula``:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:12
#: modules/specialized-guides/pages/salt/salt-yomi.adoc:26
#, no-wrap
msgid "zypper in yomi-formula\n"
msgstr "zypper in yomi-formula\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:13
#: modules/specialized-guides/pages/salt/salt-yomi.adoc:27
msgid "Restart services:"
msgstr "ຣີສະຕາດການບໍລິການ:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:14
#: modules/specialized-guides/pages/salt/salt-yomi.adoc:28
#, no-wrap
msgid "systemctl restart salt-master.service\n"
msgstr "systemctl restart salt-master.service\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:15
msgid ""
"When the formula package is installed, you need to install the PXE Yomi "
"image on the client, boot the client you want to provision, and enable the "
"Yomi formulas on the client.  For more information on preparing Yomi clients "
"for provisioning, see xref:specialized-guides:salt/salt-yomi.adoc[]."
msgstr "ເມື່ອຕິດຕັ້ງແພັກເກັດສູດແລ້ວ, ທ່ານຈຳເປັນຕ້ອງຕິດຕັ້ງຮູບພາບ PXE Yomi ໃນເຄື່ອງໄຄເອັນ, ບູດເຄື່ອງໄຄເອັນທີ່ທ່ານຕ້ອງການຈັດຕຽມ (provision), ແລະ ເປີດໃຊ້ສູດ Yomi ໃນໄຄເອັນ. ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການຕຽມໄຄເອັນ Yomi, ໃຫ້ເບິ່ງທີ່ xref:specialized-guides:salt/salt-yomi.adoc[]."

#. type: Block title
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:16
#, no-wrap
msgid "Procedure: Configuring the Yomi Formula"
msgstr "ຂັ້ນຕອນ: ການຕັ້ງຄ່າສູດ Yomi"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:17
msgid ""
"Navigate to the menu:Formulas[Yomi] tab, and set these parameters in the "
"[guimenu]``General Configuration`` section:"
msgstr "ໄປທີ່ແທັບ menu:Formulas[Yomi], ແລະ ຕັ້ງພາລາມິເຕີເຫຼົ່ານີ້ໃນພາກສ່ວນ [guimenu]``General Configuration``:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:18
msgid "Check the [guimenu]``Events`` box to allow monitoring."
msgstr "ໝາຍຕິກຊ່ອງ [guimenu]``Events`` ເພື່ອອະນຸຍາດການຕິດຕາມ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:19
msgid ""
"In the [guimenu]``Reboot`` field, select ``yes`` to instruct the client to "
"reboot after installation."
msgstr "ໃນຊ່ອງ [guimenu]``Reboot``, ເລືອກ ``yes`` ເພື່ອສັ່ງໃຫ້ໄຄເອັນຣີບູດຫຼັງຈາກການຕິດຕັ້ງ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:20
msgid ""
"Check the [guimenu]``Snapper`` box if you are using the btrfs file system on "
"the client."
msgstr "ໝາຍຕິກຊ່ອງ [guimenu]``Snapper`` ຫາກທ່ານໃຊ້ລະບົບໄຟລ໌ btrfs ໃນໄຄເອັນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:21
msgid ""
"In the [guimenu]``Locale`` field, select the region and encoding for systemd "
"to use on the client."
msgstr "ໃນຊ່ອງ [guimenu]``Locale``, ເລືອກພາກພື້ນ ແລະ ການເຂົ້າລະຫັດໃຫ້ systemd ໃຊ້ໃນໄຄເອັນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:22
msgid "For example: ``en_US.utf8`` for US English and UTF-8."
msgstr "ຕົວຢ່າງ: ``en_US.utf8`` ສຳລັບພາສາອັງກິດອາເມລິກາ ແລະ UTF-8."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:23
msgid "In the [guimenu]``Keymap`` field, select the appropriate keyboard layout."
msgstr "ໃນຊ່ອງ [guimenu]``Keymap``, ເລືອກຮູບແບບແປ້ນພິມທີ່ເໝາະສົມ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:24
msgid "For example: ``us`` for a US keyboard layout."
msgstr "ຕົວຢ່າງ: ``us`` ສຳລັບຮູບແບບແປ້ນພິມສະຫະລັດ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:25
msgid ""
"In the [guimenu]``Timezone`` field, select the timezone for the client to "
"use."
msgstr "ໃນຊ່ອງ [guimenu]``Timezone``, ເລືອກເຂດເວລາສຳລັບໄຄເອັນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:26
msgid "For example: [guimenu]``America/New_York`` for EST."
msgstr "ຕົວຢ່າງ: [guimenu]``America/New_York`` ສຳລັບ EST."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:27
msgid ""
"In the [guimenu]``Hostname`` field, enter the hostname for the client to "
"use."
msgstr "ໃນຊ່ອງ [guimenu]``Hostname``, ໃຫ້ປ້ອນຊື່ໂຮສສຳລັບໄຄເອັນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:28
msgid "Leave this blank if you are using DHCP to provide the hostname."
msgstr "ປະຫວ່າງໄວ້ຫາກທ່ານໃຊ້ DHCP ເພື່ອສະໜອງຊື່ໂຮສ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:29
msgid ""
"In the [guimenu]``Machine Id`` field, enter a machine identification number "
"for the client."
msgstr "ໃນຊ່ອງ [guimenu]``Machine Id``, ໃຫ້ປ້ອນໝາຍເລກລະບຸເຄື່ອງສຳລັບໄຄເອັນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:30
msgid "Leave this blank to have systemd generate one automatically."
msgstr "ປະຫວ່າງໄວ້ເພື່ອໃຫ້ systemd ສ້າງໃຫ້ໂດຍອັດຕະໂນມັດ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:31
msgid "In the [guimenu]``Target`` field, enter a systemd target unit."
msgstr "ໃນຊ່ອງ [guimenu]``Target``, ໃຫ້ປ້ອນ systemd target unit."

#. type: Block title
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:33
#, no-wrap
msgid "Procedure: Configuring the Yomi Storage Formula"
msgstr "ຂັ້ນຕອນ: ການຕັ້ງຄ່າສູດ Yomi Storage"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:34
msgid ""
"Navigate to the menu:Formulas[Yomi Storage] tab, and set these parameters in "
"the menu:Partitions[Config] section:"
msgstr "ໄປທີ່ແທັບ menu:Formulas[Yomi Storage], ແລະ ຕັ້ງພາລາມິເຕີເຫຼົ່ານີ້ໃນພາກສ່ວນ menu:Partitions[Config]:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:35
msgid ""
"In the [guimenu]``Labels`` field, select the default partition table type to "
"use."
msgstr "ໃນຊ່ອງ [guimenu]``Labels``, ເລືອກປະເພດຕາຕະລາງພາກສ່ວນ (partition table) ມາດຕະຖານທີ່ຈະໃຊ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:36
msgid ""
"In the [guimenu]``Initial Gap`` field, select the default amount of space to "
"leave before the first partition."
msgstr "ໃນຊ່ອງ [guimenu]``Initial Gap``, ເລືອກຈຳນວນເນື້ອທີ່ວ່າງມາດຕະຖານທີ່ຈະປະໄວ້ກ່ອນພາກສ່ວນທຳອິດ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:37
msgid ""
"For example: ``1{nbsp}MB``, or use ``0`` to leave no space between "
"partitions."
msgstr "ຕົວຢ່າງ: ``1{nbsp}MB``, ຫຼື ໃຊ້ ``0`` ເພື່ອບໍ່ໃຫ້ມີເນື້ອທີ່ວ່າງລະຫວ່າງພາກສ່ວນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:38
msgid ""
"For each device that you want to configure, in the menu:Partitions[Devices] "
"section, click btn:[+], and set these parameters:"
msgstr "ສຳລັບອຸປະກອນແຕ່ລະອັນທີ່ທ່ານຕ້ອງການຕັ້ງຄ່າ, ໃນພາກສ່ວນ menu:Partitions[Devices], ໃຫ້ກົດ btn:[+], ແລະ ຕັ້ງພາລາມິເຕີເຫຼົ່ານີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:39
msgid "In the [guimenu]``Device`` field, type the mount point for the device."
msgstr "ໃນຊ່ອງ [guimenu]``Device``, ໃຫ້ພິມຈຸດເມົາທ໌ (mount point) ສຳລັບອຸປະກອນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:40
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:61
msgid "For example, ``/dev/sda``."
msgstr "ຕົວຢ່າງ, ``/dev/sda``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:41
msgid ""
"In the [guimenu]``Label`` field, select the partition table type to use, if "
"it is different from the default label you selected."
msgstr "ໃນຫ້ອງ [guimenu]``Label``, ເລືອກປະເພດຕາຕະລາງພາທິຊັນທີ່ຈະໃຊ້, ຫາກມັນແຕກຕ່າງຈາກປ້າຍຊື່ເລີ່ມຕົ້ນທີ່ເຈົ້າໄດ້ເລືອກໄວ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:42
msgid ""
"In the [guimenu]``Initial Gap`` field, select the amount of space to leave "
"before the first partition, if it is different from the default space you "
"specified."
msgstr "ໃນຫ້ອງ [guimenu]``Initial Gap``, ເລືອກຈຳນວນເນື້ອທີ່ວ່າງທີ່ຈະປະໄວ້ກ່ອນພາທິຊັນທຳອິດ, ຫາກມັນແຕກຕ່າງຈາກເນື້ອທີ່ເລີ່ມຕົ້ນທີ່ເຈົ້າລະບຸໄວ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:43
msgid ""
"For each partition that you want to create, in the menu:Partitions[Devices > "
"Partitions] section, click btn:[+], and set these parameters:"
msgstr "ສຳລັບແຕ່ລະພາທິຊັນທີ່ເຈົ້າຕ້ອງການສ້າງ, ໃນພາກສ່ວນ menu:Partitions[Devices > Partitions], ໃຫ້ກົດ btn:[+], ແລະ ຕັ້ງຄ່າພາລາມິເຕີເຫຼົ່ານີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:44
msgid ""
"In the [guimenu]``Partition Number`` field, enter a number for the "
"partition."
msgstr "ໃນຫ້ອງ [guimenu]``Partition Number``, ໃຫ້ປ້ອນໝາຍເລກສຳລັບພາທິຊັນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:45
msgid ""
"The number you enter here is appended to the device name to identify the "
"partition.  For example, partition number ``1`` on device ``/dev/sda`` can "
"be identified as ``/dev/sda1``."
msgstr "ໝາຍເລກທີ່ເຈົ້າປ້ອນໃສ່ນີ້ຈະຖືກຕໍ່ທ້າຍຊື່ຂອງອຸປະກອນເພື່ອລະບຸພາທິຊັນ. ຕົວຢ່າງ: ພາທິຊັນໝາຍເລກ ``1`` ໃນອຸປະກອນ ``/dev/sda`` ສາມາດລະບຸໄດ້ວ່າເປັນ ``/dev/sda1``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:46
msgid "In the [guimenu]``Partition Name`` field, enter a name for the partition."
msgstr "ໃນຫ້ອງ [guimenu]``Partition Name``, ໃຫ້ປ້ອນຊື່ສຳລັບພາທິຊັນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:47
msgid ""
"Leave this blank if you have entered a partition number in the previous "
"field."
msgstr "ໃຫ້ປະຫວ່າງໄວ້ ຫາກເຈົ້າໄດ້ປ້ອນໝາຍເລກພາທິຊັນໃນຫ້ອງກ່ອນໜ້ານີ້ແລ້ວ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:48
msgid "In the [guimenu]``Partition Size`` field, enter a size for the partition."
msgstr "ໃນຫ້ອງ [guimenu]``Partition Size``, ໃຫ້ປ້ອນຂະໜາດສຳລັບພາທິຊັນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:49
msgid ""
"For example: ``500{nbsp}MB``.  Use ``rest`` to use all the remaining free "
"space."
msgstr "ຕົວຢ່າງ: ``500{nbsp}MB``. ໃຊ້ ``rest`` ເພື່ອໃຊ້ເນື້ອທີ່ວ່າງທີ່ເຫຼືອທັງໝົດ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:50
msgid ""
"For each file system that you want to create, in the "
"[guimenu]``Filesystems`` section, click btn:[+], and set these parameters:"
msgstr "ສຳລັບແຕ່ລະລະບົບໄຟລ໌ທີ່ເຈົ້າຕ້ອງການສ້າງ, ໃນພາກສ່ວນ [guimenu]``Filesystems``, ໃຫ້ກົດ btn:[+], ແລະ ຕັ້ງຄ່າພາລາມິເຕີເຫຼົ່ານີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:51
msgid ""
"In the [guimenu]``Partition`` field, select the partition to create the file "
"system on."
msgstr "ໃນຫ້ອງ [guimenu]``Partition``, ເລືອກພາທິຊັນທີ່ຈະສ້າງລະບົບໄຟລ໌ໃສ່."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:52
msgid "For example, ``/dev/sda1``."
msgstr "ຕົວຢ່າງ, ``/dev/sda1``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:53
msgid "In the [guimenu]``Filesystem`` field, select the file system type to create."
msgstr "ໃນຫ້ອງ [guimenu]``Filesystem``, ເລືອກປະເພດລະບົບໄຟລ໌ທີ່ຈະສ້າງ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:54
msgid ""
"In the [guimenu]``Mountpoint`` field, type the mount point for the file "
"system."
msgstr "ໃນຫ້ອງ [guimenu]``Mountpoint``, ໃຫ້ພິມຈຸດຕິດຕັ້ງ (mount point) ສຳລັບລະບົບໄຟລ໌."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:55
msgid "For example: ``/`` for root."
msgstr "ຕົວຢ່າງ: ``/`` ສຳລັບ root."

#. type: delimited block =
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:57
msgid ""
"If you want to use LVM or RAID on your devices, click btn:[+] in the "
"appropriate sections, and complete the details for your environment."
msgstr "ຫາກເຈົ້າຕ້ອງການໃຊ້ LVM ຫຼື RAID ໃນອຸປະກອນຂອງເຈົ້າ, ໃຫ້ກົດ btn:[+] ໃນພາກສ່ວນທີ່ກ່ຽວຂ້ອງ, ແລະ ປ້ອນລາຍລະອຽດໃຫ້ຄົບຖ້ວນສຳລັບສະພາບແວດລ້ອມຂອງເຈົ້າ."

#. type: Block title
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:58
#, no-wrap
msgid "Procedure: Configuring the Yomi Bootloader Formula"
msgstr "ຂັ້ນຕອນ: ການຕັ້ງຄ່າ Yomi Bootloader Formula"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:59
msgid ""
"Navigate to the menu:Formulas[Yomi Bootloader] tab, and set these parameters "
"in the [guimenu]``Bootloader`` section:"
msgstr "ໄປທີ່ແທັບ menu:Formulas[Yomi Bootloader], ແລະ ຕັ້ງຄ່າພາລາມິເຕີເຫຼົ່ານີ້ໃນພາກສ່ວນ [guimenu]``Bootloader``:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:60
msgid "In the [guimenu]``Device`` field, type the path for the bootloader."
msgstr "ໃນຫ້ອງ [guimenu]``Device``, ໃຫ້ພິມເສັ້ນທາງ (path) ສຳລັບບູດໂຫລດເດີ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:62
msgid ""
"In the [guimenu]``Timeout`` field, select the number of seconds grub will "
"wait before booting the default menu entry."
msgstr "ໃນຫ້ອງ [guimenu]``Timeout``, ເລືອກຈຳນວນວິນາທີທີ່ grub ຈະລໍຖ້າກ່ອນຈະບູດເຂົ້າລາຍການເມນູເລີ່ມຕົ້ນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:63
msgid ""
"In the [guimenu]``Kernel`` field, type any additional kernel parameters you "
"want to use."
msgstr "ໃນຫ້ອງ [guimenu]``Kernel``, ໃຫ້ພິມພາລາມິເຕີເຄີເນີນເພີ່ມເຕີມທີ່ເຈົ້າຕ້ອງການໃຊ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:64
msgid ""
"Any kernel parameters you add here will be appended to the "
"``GRUB_CMDLINE_LINUX_DEFAULT`` line during boot."
msgstr "ພາລາມິເຕີເຄີເນີນໃດໆທີ່ເຈົ້າເພີ່ມໃສ່ນີ້ຈະຖືກຕໍ່ທ້າຍໃສ່ແຖວ ``GRUB_CMDLINE_LINUX_DEFAULT`` ໃນລະຫວ່າງການບູດ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:65
msgid ""
"In the [guimenu]``Terminal`` field, type the terminal to use for both "
"terminal input and output."
msgstr "ໃນຫ້ອງ [guimenu]``Terminal``, ໃຫ້ພິມເທີມິນໍທີ່ຈະໃຊ້ສຳລັບທັງການປ້ອນຂໍ້ມູນເຂົ້າ ແລະ ການສະແດງຜົນອອກ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:66
msgid ""
"In the [guimenu]``Serial Command`` field, type parameters for using the "
"serial port."
msgstr "ໃນຫ້ອງ [guimenu]``Serial Command``, ໃຫ້ພິມພາລາມິເຕີສຳລັບການໃຊ້ພອດຊີຣຽວ (serial port)."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:67
msgid "Use this only if you are using the serial console as the default terminal."
msgstr "ໃຊ້ຄຳສັ່ງນີ້ກໍຕໍ່ເມື່ອເຈົ້າກຳລັງໃຊ້ຊີຣຽວຄອນໂຊນເປັນເທີມິນໍເລີ່ມຕົ້ນເທົ່ານັ້ນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:68
msgid ""
"In the [guimenu]``Gfxmode`` field, type the resolution to use for the "
"graphical terminal."
msgstr "ໃນຫ້ອງ [guimenu]``Gfxmode``, ໃຫ້ພິມຄວາມລະອຽດທີ່ຈະໃຊ້ສຳລັບເທີມິນໍແບບກຣາບຟິກ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:69
msgid ""
"Use this only if you are using the graphical console as the default "
"terminal."
msgstr "ໃຊ້ຄຳສັ່ງນີ້ກໍຕໍ່ເມື່ອເຈົ້າກຳລັງໃຊ້ກຣາບຟິກຄອນໂຊນເປັນເທີມິນໍເລີ່ມຕົ້ນເທົ່ານັ້ນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:70
msgid "Check the [guimenu]``Theme`` box to use GRUB2 default branding package."
msgstr "ໝາຍຕິກເອົາຫ້ອງ [guimenu]``Theme`` ເພື່ອໃຊ້ແພັກເກັດ branding ເລີ່ມຕົ້ນຂອງ GRUB2."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:71
msgid ""
"Check the [guimenu]``Disable OS Prober`` box to disable using the OS prober "
"to discover other installed operating systems."
msgstr "ໝາຍຕິກເອົາຫ້ອງ [guimenu]``Disable OS Prober`` ເພື່ອປິດການໃຊ້ OS prober ໃນການຄົ້ນຫາລະບົບປະຕິບັດການອື່ນໆທີ່ຕິດຕັ້ງໄວ້."

#. type: Block title
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:73
#, no-wrap
msgid "Procedure: Configuring the Yomi Software Formula"
msgstr "ຂັ້ນຕອນ: ການຕັ້ງຄ່າ Yomi Software Formula"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:74
msgid ""
"Navigate to the menu:Formulas[Yomi Software] tab, and set these parameters "
"in the menu:Software[Configuration] section:"
msgstr "ໄປທີ່ແທັບ menu:Formulas[Yomi Software], ແລະ ຕັ້ງຄ່າພາລາມິເຕີເຫຼົ່ານີ້ໃນພາກສ່ວນ menu:Software[Configuration]:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:75
msgid ""
"Check the [guimenu]``Minimal`` box to use a minimal installation, which only "
"installs packages listed as ``Required``."
msgstr "ໝາຍຕິກເອົາຫ້ອງ [guimenu]``Minimal`` ເພື່ອໃຊ້ການຕິດຕັ້ງແບບຂັ້ນຕ່ຳ, ເຊິ່ງຈະຕິດຕັ້ງສະເພາະແພັກເກັດທີ່ລະບຸວ່າ ``Required`` ເທົ່ານັ້ນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:76
msgid ""
"For each repository that you want to add, in the menu:Software[Repositories] "
"section, click btn:[+], and set these parameters:"
msgstr "ສຳລັບແຕ່ລະຄັງຊອບແວ (repository) ທີ່ເຈົ້າຕ້ອງການເພີ່ມ, ໃນພາກສ່ວນ menu:Software[Repositories], ໃຫ້ກົດ btn:[+], ແລະ ຕັ້ງຄ່າພາລາມິເຕີເຫຼົ່ານີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:77
msgid "In the [guimenu]``Repository Name`` field, type a name for the repository."
msgstr "ໃນຫ້ອງ [guimenu]``Repository Name``, ໃຫ້ພິມຊື່ສຳລັບຄັງຊອບແວ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:78
msgid ""
"In the [guimenu]``Repository URL`` field, type the location of the "
"repository."
msgstr "ໃນຫ້ອງ [guimenu]``Repository URL``, ໃຫ້ພິມທີ່ຢູ່ (location) ຂອງຄັງຊອບແວ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:79
msgid ""
"To add packages from each repository, in the menu:Software[Packages] "
"section, click btn:[+], and set these parameters:"
msgstr "ເພື່ອເພີ່ມແພັກເກັດຈາກແຕ່ລະຄັງຊອບແວ, ໃນພາກສ່ວນ menu:Software[Packages], ໃຫ້ກົດ btn:[+], ແລະ ຕັ້ງຄ່າພາລາມິເຕີເຫຼົ່ານີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:80
msgid ""
"In the menu:Software[Packages] field, type the names of the packages to "
"install, or type a pattern to search for the appropriate packages."
msgstr "ໃນຫ້ອງ menu:Software[Packages], ໃຫ້ພິມຊື່ຂອງແພັກເກັດທີ່ຈະຕິດຕັ້ງ, ຫຼື ພິມຮູບແບບ (pattern) ເພື່ອຄົ້ນຫາແພັກເກັດທີ່ເໝາະສົມ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:81
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:96
msgid "For example, ``pattern:enhanced_base glibc-locale``, or ``kernel-default``."
msgstr "ຕົວຢ່າງ, ``pattern:enhanced_base glibc-locale``, ຫຼື ``kernel-default``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:82
msgid "In the menu:Software[Image] section, set these parameters:"
msgstr "ໃນພາກສ່ວນ menu:Software[Image], ໃຫ້ຕັ້ງຄ່າພາລາມິເຕີເຫຼົ່ານີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:83
msgid ""
"In the [guimenu]``Image URL`` field, type the location of the operating "
"system ISO image to use."
msgstr "ໃນຫ້ອງ [guimenu]``Image URL``, ໃຫ້ພິມທີ່ຢູ່ຂອງໄຟລ໌ ISO image ຂອງລະບົບປະຕິບັດການທີ່ຈະໃຊ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:84
msgid "In the [guimenu]``Md5`` field, type the MD5 hash to use to verify the ISO."
msgstr "ໃນຫ້ອງ [guimenu]``Md5``, ໃຫ້ພິມຄ່າ MD5 hash ເພື່ອໃຊ້ກວດສອບຄວາມຖືກຕ້ອງຂອງໄຟລ໌ ISO."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:85
msgid "In the menu:SUSEConect[Config] section, set these parameters:"
msgstr "ໃນພາກສ່ວນ menu:SUSEConnect[Config], ໃຫ້ຕັ້ງຄ່າພາລາມິເຕີເຫຼົ່ານີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:86
msgid ""
"In the [guimenu]``Registration Code`` field, type the registration code for "
"the client you are installing."
msgstr "ໃນຫ້ອງ [guimenu]``Registration Code``, ໃຫ້ພິມລະຫັດລົງທະບຽນສຳລັບເຄື່ອງລູກຂ່າຍທີ່ເຈົ້າກຳລັງຕິດຕັ້ງ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:87
msgid "You can obtain this code from {scclongform}."
msgstr "ເຈົ້າສາມາດເອົາລະຫັດນີ້ໄດ້ຈາກ {scclongform}."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:88
msgid ""
"In the [guimenu]``Email`` field, type the administrator email address to "
"use."
msgstr "ໃນຫ້ອງ [guimenu]``Email``, ໃຫ້ພິມທີ່ຢູ່ອີເມວຂອງຜູ້ດູແລລະບົບທີ່ຈະໃຊ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:89
msgid ""
"In the [guimenu]``Url`` field, type the address of the registration server "
"to use."
msgstr "ໃນຫ້ອງ [guimenu]``Url``, ໃຫ້ພິມທີ່ຢູ່ຂອງເຊີເວີລົງທະບຽນທີ່ຈະໃຊ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:90
msgid "For example, use ``https://scc.suse.com``, to register with {scclongform}."
msgstr "ຕົວຢ່າງ: ໃຊ້ ``https://scc.suse.com``, ເພື່ອລົງທະບຽນກັບ {scclongform}."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:91
msgid ""
"In the [guimenu]``Version`` field, type the version of the product you are "
"registering."
msgstr "ໃນຫ້ອງ [guimenu]``Version``, ໃຫ້ພິມເວີຊັນຂອງຜະລິດຕະພັນທີ່ເຈົ້າກຳລັງລົງທະບຽນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:92
msgid ""
"For each product that you want to register, in the "
"menu:SUSEConnect[Products] section, click btn:[+], and set these parameters:"
msgstr "ສຳລັບແຕ່ລະຜະລິດຕະພັນທີ່ເຈົ້າຕ້ອງການລົງທະບຽນ, ໃນພາກສ່ວນ menu:SUSEConnect[Products], ໃຫ້ກົດ btn:[+], ແລະ ຕັ້ງຄ່າພາລາມິເຕີເຫຼົ່ານີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:93
msgid "In the [guimenu]``Product`` field, type each product you want to register."
msgstr "ໃນຫ້ອງ [guimenu]``Product``, ໃຫ້ພິມແຕ່ລະຜະລິດຕະພັນທີ່ເຈົ້າຕ້ອງການລົງທະບຽນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:94
msgid ""
"For example, ``<product_name>/1.1/x86``, for version 1.1 with {x86} "
"architecture."
msgstr "ຕົວຢ່າງ, ``<product_name>/1.1/x86``, ສຳລັບເວີຊັນ 1.1 ທີ່ມີສະຖາປັດຕະຍະກຳ {x86}."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:95
msgid ""
"In the menu:SUSEConnect[Packages] field, type the names of the packages to "
"install, or type a pattern to search for the appropriate packages."
msgstr "ໃນຫ້ອງ menu:SUSEConnect[Packages], ໃຫ້ພິມຊື່ຂອງແພັກເກັດທີ່ຈະຕິດຕັ້ງ, ຫຼື ພິມຮູບແບບເພື່ອຄົ້ນຫາແພັກເກັດທີ່ເໝາະສົມ."

#. type: Block title
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:98
#, no-wrap
msgid "Procedure: Configuring the Yomi Services Formula"
msgstr "ຂັ້ນຕອນ: ການຕັ້ງຄ່າ Yomi Services Formula"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:99
msgid "Navigate to the menu:Formulas[Yomi Services] tab, and set these parameters:"
msgstr "ໄປທີ່ແທັບ menu:Formulas[Yomi Services], ແລະ ຕັ້ງຄ່າພາລາມິເຕີເຫຼົ່ານີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:100
msgid ""
"Check the [guimenu]``Install salt-minion`` box to install and configure the "
"client as a Salt client."
msgstr "ໝາຍຕິກເອົາຫ້ອງ [guimenu]``Install salt-minion`` ເພື່ອຕິດຕັ້ງ ແລະ ຕັ້ງຄ່າເຄື່ອງລູກຂ່າຍໃຫ້ເປັນ Salt client."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:101
msgid ""
"For each service you want to enable, in the menu:Services[Enabled] section, "
"click btn:[+], and set these parameters:"
msgstr "ສຳລັບແຕ່ລະບໍລິການ (service) ທີ່ເຈົ້າຕ້ອງການເປີດໃຊ້, ໃນພາກສ່ວນ menu:Services[Enabled], ໃຫ້ກົດ btn:[+], ແລະ ຕັ້ງຄ່າພາລາມິເຕີເຫຼົ່ານີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:102
msgid "In the [guimenu]``Service`` field, type the name of the service to enable."
msgstr "ໃນຫ້ອງ [guimenu]``Service``, ໃຫ້ພິມຊື່ຂອງບໍລິການທີ່ຈະເປີດໃຊ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:103
msgid "For example, ``salt-minion``."
msgstr "ຕົວຢ່າງ, ``salt-minion``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:104
msgid ""
"For each service you want to disable, in the menu:Services[Disabled] "
"section, click btn:[+], and set these parameters:"
msgstr "ສຳລັບແຕ່ລະບໍລິການທີ່ເຈົ້າຕ້ອງການປິດການໃຊ້, ໃນພາກສ່ວນ menu:Services[Disabled], ໃຫ້ກົດ btn:[+], ແລະ ຕັ້ງຄ່າພາລາມິເຕີເຫຼົ່ານີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:105
msgid "In the [guimenu]``Service`` field, type the name of the service to disable."
msgstr "ໃນຫ້ອງ [guimenu]``Service``, ໃຫ້ພິມຊື່ຂອງບໍລິການທີ່ຈະປິດການໃຊ້."

#. type: Block title
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:107
#, no-wrap
msgid "Procedure: Configuring the Yomi Users Formula"
msgstr "ຂັ້ນຕອນ: ການຕັ້ງຄ່າ Yomi Users Formula"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:108
msgid "Navigate to the menu:Formulas[Yomi Users] tab."
msgstr "ໄປທີ່ແທັບ menu:Formulas[Yomi Users]."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:109
msgid ""
"For each user you want to create, in the [guimenu]``Users`` section, click "
"btn:[+], and set these parameters:"
msgstr "ສຳລັບແຕ່ລະຜູ້ໃຊ້ທີ່ເຈົ້າຕ້ອງການສ້າງ, ໃນພາກສ່ວນ [guimenu]``Users``, ໃຫ້ກົດ btn:[+], ແລະ ຕັ້ງຄ່າພາລາມິເຕີເຫຼົ່ານີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:110
msgid "In the [guimenu]``Username`` field, type the name of the new user."
msgstr "ໃນຫ້ອງ [guimenu]``Username``, ໃຫ້ພິມຊື່ຂອງຜູ້ໃຊ້ໃໝ່."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:111
msgid ""
"In the [guimenu]``Password Hash`` field, type the hashed version of the "
"password to use."
msgstr "ໃນຫ້ອງ [guimenu]``Password Hash``, ໃຫ້ພິມລະຫັດຜ່ານໃນຮູບແບບ hash ທີ່ຈະໃຊ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:112
msgid ""
"To add a certificate for each user, in the menu:Users[Certificates] section, "
"click btn:[+], and add the certificate to the [guimenu]``Certificate`` "
"field."
msgstr "ເພື່ອເພີ່ມໃບຢັ້ງຢືນ (certificate) ສຳລັບແຕ່ລະຜູ້ໃຊ້, ໃນພາກສ່ວນ menu:Users[Certificates], ໃຫ້ກົດ btn:[+], ແລະ ເພີ່ມໃບຢັ້ງຢືນລົງໃນຫ້ອງ [guimenu]``Certificate``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formula-yomi.adoc:115
msgid ""
"For more information about using Yomi, see "
"xref:specialized-guides:salt/salt-yomi.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການໃຊ້ Yomi, ໃຫ້ເບິ່ງ xref:specialized-guides:salt/salt-yomi.adoc[]."

#. type: Title =
#: modules/specialized-guides/pages/salt/salt-formulas-by-product.adoc:1
#, no-wrap
msgid "Formulas Provided by {productname}"
msgstr "Formulas ທີ່ສະໜອງໃຫ້ໂດຍ {productname}"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-by-product.adoc:2
msgid ""
"Some formulas are installed by default with {productname}.  Other official "
"formulas can be installed as RPM packages.  When the formula is installed, "
"you can activate them using the {productname} {webui}."
msgstr "ບາງ formulas ຈະຖືກຕິດຕັ້ງມາພ້ອມກັບ {productname} ໂດຍເລີ່ມຕົ້ນ. formulas ທາງການອື່ນໆສາມາດຕິດຕັ້ງໄດ້ໃນຮູບແບບແພັກເກັດ RPM. ເມື່ອຕິດຕັ້ງ formula ແລ້ວ, ເຈົ້າສາມາດເປີດໃຊ້ພວກມັນໄດ້ໂດຍໃຊ້ {productname} {webui}."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-by-product.adoc:3
msgid ""
"For information about writing custom formulas, see "
"xref:specialized-guides:salt/salt-formulas-custom.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນກ່ຽວກັບການຂຽນ custom formulas, ໃຫ້ເບິ່ງ xref:specialized-guides:salt/salt-formulas-custom.adoc[]."

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-formulas-by-product.adoc:4
#, no-wrap
msgid "Install Formulas with Zypper"
msgstr "ຕິດຕັ້ງ Formulas ດ້ວຍ Zypper"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-by-product.adoc:5
msgid "Formulas are provided in the {productname} pool software channel."
msgstr "Formulas ແມ່ນມີໃຫ້ໃນຊ່ອງທາງຊອບແວ pool ຂອງ {productname}."

#. type: delimited block =
#: modules/specialized-guides/pages/salt/salt-formulas-by-product.adoc:6
msgid ""
"If a formula uses the same name as an existing Salt state, the two names "
"will collide, and could result in the formula being used instead of the "
"state.  Always check states and formulas to avoid name clashes."
msgstr "ຫາກ formula ໃຊ້ຊື່ດຽວກັນກັບ Salt state ທີ່ມີຢູ່ແລ້ວ, ຊື່ທັງສອງຈະຊ້ຳກັນ ແລະ ອາດສົ່ງຜົນໃຫ້ formula ຖືກນຳໃຊ້ແທນ state. ໃຫ້ກວດສອບ states ແລະ formulas ສະເໝີເພື່ອຫຼີກເວັ້ນການຊ້ຳກັນຂອງຊື່."

#. type: Block title
#: modules/specialized-guides/pages/salt/salt-formulas-by-product.adoc:7
#, no-wrap
msgid "Procedure: Installing Formulas with Zypper"
msgstr "ຂັ້ນຕອນ: ການຕິດຕັ້ງ Formulas ດ້ວຍ Zypper"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-by-product.adoc:8
msgid ""
"On the {productname} Server, at the command prompt, search for available "
"formulas:"
msgstr "ຢູ່ທີ່ເຊີເວີ {productname}, ໃນໜ້າຕ່າງຄຳສັ່ງ (command prompt), ໃຫ້ຄົ້ນຫາ formulas ທີ່ມີໃຫ້:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-by-product.adoc:9
#, no-wrap
msgid "zypper se --type package formula\n"
msgstr "zypper se --type package formula\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-by-product.adoc:10
msgid "Get more information about a formula:"
msgstr "ເບິ່ງຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບ formula:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-by-product.adoc:11
#, no-wrap
msgid "zypper info <formula_name>\n"
msgstr "zypper info <formula_name>\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-by-product.adoc:12
msgid ""
"On the {productname} Server, at the command prompt, as root, install the "
"formula:"
msgstr "ຢູ່ທີ່ເຊີເວີ {productname}, ໃນໜ້າຕ່າງຄຳສັ່ງ, ໂດຍໃຊ້ສິດ root, ໃຫ້ຕິດຕັ້ງ formula:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-by-product.adoc:13
#, no-wrap
msgid "zypper in <formula_name>\n"
msgstr "zypper in <formula_name>\n"

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-formulas-by-product.adoc:14
#, no-wrap
msgid "Activate Formulas from the {webui}"
msgstr "ເປີດໃຊ້ Formulas ຜ່ານ {webui}"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-by-product.adoc:15
msgid ""
"Formulas provided by {productname}, or formulas that you have installed, can "
"be activated using the {productname} {webui}."
msgstr "Formulas ທີ່ສະໜອງໃຫ້ໂດຍ {productname}, ຫຼື formulas ທີ່ເຈົ້າໄດ້ຕິດຕັ້ງ, ສາມາດເປີດໃຊ້ໄດ້ໂດຍໃຊ້ {productname} {webui}."

#. type: Block title
#: modules/specialized-guides/pages/salt/salt-formulas-by-product.adoc:16
#, no-wrap
msgid "Procedure: Activate Formulas from the {webui}"
msgstr "ຂັ້ນຕອນ: ເປີດໃຊ້ Formulas ຜ່ານ {webui}"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-by-product.adoc:17
msgid ""
"In the {productname} {webui}, navigate to menu:Systems[List], select the "
"client you want to activate the formula for."
msgstr "ໃນ {productname} {webui}, ໄປທີ່ menu:Systems[List], ແລ້ວເລືອກເຄື່ອງລູກຂ່າຍທີ່ເຈົ້າຕ້ອງການເປີດໃຊ້ formula ໃຫ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-by-product.adoc:18
msgid ""
"Navigate to the menu:Systems[Formulas] tab, and check the formula you want "
"to activate."
msgstr "ໄປທີ່ແທັບ menu:Systems[Formulas], ແລະ ໝາຍຕິກເອົາ formula ທີ່ເຈົ້າຕ້ອງການເປີດໃຊ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-by-product.adoc:19
msgid "Click btn:[Save]."
msgstr "ກົດ btn:[Save]."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-by-product.adoc:20
msgid ""
"Navigate to the new subtab for the formula, and configure the formula as "
"required."
msgstr "ໄປທີ່ແທັບຍ່ອຍໃໝ່ສຳລັບ formula ນັ້ນ, ແລະ ຕັ້ງຄ່າ formula ຕາມຄວາມຕ້ອງການ."

#. type: Title =
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:1
#, no-wrap
msgid "Custom Salt Formulas"
msgstr "Custom Salt Formulas"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:2
msgid ""
"This section contains information about writing custom formulas, including "
"formulas with forms.  You can write your own custom formulas, and make them "
"available to client systems in the {productname} {webui}."
msgstr "ພາກສ່ວນນີ້ປະກອບດ້ວຍຂໍ້ມູນກ່ຽວກັບການຂຽນ custom formulas, ລວມທັງ formulas ທີ່ມີແບບຟອມ (forms). ເຈົ້າສາມາດຂຽນ custom formulas ຂອງເຈົ້າເອງ ແລະ ເຮັດໃຫ້ພວກມັນພ້ອມໃຊ້ງານສຳລັບລະບົບລູກຂ່າຍໃນ {productname} {webui}."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:3
msgid ""
"For information about the formulas provided by {productname}, see "
"xref:specialized-guides:salt/salt-formulas-by-product.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນກ່ຽວກັບ formulas ທີ່ສະໜອງໃຫ້ໂດຍ {productname}, ໃຫ້ເບິ່ງ xref:specialized-guides:salt/salt-formulas-by-product.adoc[]."

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:4
#, no-wrap
msgid "File Structure Overview"
msgstr "ພາບລວມໂຄງສ້າງໄຟລ໌"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:5
msgid ""
"RPM-based formulas must be placed in a specific directory structure to "
"ensure that they work correctly.  A formula contains two separate "
"directories: [path]``states``, and [path]``metadata``.  Folders in these "
"directories need to have exactly matching names."
msgstr "Formulas ທີ່ອີງຕາມ RPM ຕ້ອງຖືກຈັດວາງໄວ້ໃນໂຄງສ້າງໄດເຣັກທໍຣີທີ່ສະເພາະເຈາະຈົງເພື່ອໃຫ້ແນ່ໃຈວ່າພວກມັນເຮັດວຽກໄດ້ຢ່າງຖືກຕ້ອງ. formula ໜຶ່ງຈະປະກອບມີສອງໄດເຣັກທໍຣີທີ່ແຍກກັນຄື: [path]``states``, ແລະ [path]``metadata``. ໂຟນເດີໃນໄດເຣັກທໍຣີເຫຼົ່ານີ້ຕ້ອງມີຊື່ທີ່ກົງກັນຢ່າງແນ່ນອນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:6
msgid ""
"The formula states directory contains anything necessary for a Salt state to "
"work independently.  This includes [path]``.sls`` files, a "
"[path]``map.jinja`` file and any other required files.  This directory "
"should only be modified by RPMs and should not be edited manually.  For "
"example, the [package]``locale-formula`` states directory is located in:"
msgstr "ໄດເຣັກທໍຣີ states ຂອງ formula ຈະປະກອບດ້ວຍສິ່ງທີ່ຈຳເປັນທັງໝົດເພື່ອໃຫ້ Salt state ເຮັດວຽກໄດ້ດ້ວຍຕົວມັນເອງ. ເຊິ່ງລວມມີໄຟລ໌ [path]``.sls``, ໄຟລ໌ [path]``map.jinja`` ແລະ ໄຟລ໌ອື່ນໆທີ່ຈຳເປັນ. ໄດເຣັກທໍຣີນີ້ນີ້ຄວນຖືກແກ້ໄຂໂດຍ RPMs ເທົ່ານັ້ນ ແລະ ບໍ່ຄວນແກ້ໄຂດ້ວຍມື. ຕົວຢ່າງ: ໄດເຣັກທໍຣີ states ຂອງ [package]``locale-formula`` ແມ່ນຕັ້ງຢູ່:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:7
#, no-wrap
msgid "/usr/share/susemanager/formulas/states/locale/\n"
msgstr "/usr/share/susemanager/formulas/states/locale/\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:8
msgid ""
"To create formulas with forms, the metadata directory contains a "
"[path]``form.yml`` file.  The [path]``form.yml`` file defines the forms for "
"{productname}.  The metadata directory also contains an optional "
"[path]``metadata.yml`` file with additional information about the formula.  "
"For example, the [package]``locale-formula`` metadata directory is located "
"in:"
msgstr "ເພື່ອສ້າງ formulas ທີ່ມີແບບຟອມ, ໄດເຣັກທໍຣີ metadata ຈະປະກອບດ້ວຍໄຟລ໌ [path]``form.yml``. ໄຟລ໌ [path]``form.yml`` ຈະກຳນົດແບບຟອມສຳລັບ {productname}. ໄດເຣັກທໍຣີ metadata ຍັງອາດຈະມີໄຟລ໌ [path]``metadata.yml`` (ເປັນທາງເລືອກ) ທີ່ມີຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບ formula. ຕົວຢ່າງ: ໄດເຣັກທໍຣີ metadata ຂອງ [package]``locale-formula`` ແມ່ນຕັ້ງຢູ່:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:9
#, no-wrap
msgid "/usr/share/susemanager/formulas/metadata/locale/\n"
msgstr "/usr/share/susemanager/formulas/metadata/locale/\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:10
msgid ""
"If you have a custom formula that is not in an RPM, it must be in a state "
"directory configured as a Salt file root.  Custom state formula data must be "
"in:"
msgstr "ຫາກເຈົ້າມີ custom formula ທີ່ບໍ່ໄດ້ຢູ່ໃນ RPM, ມັນຕ້ອງຢູ່ໃນໄດເຣັກທໍຣີ state ທີ່ຖືກຕັ້ງຄ່າໃຫ້ເປັນ Salt file root. ຂໍ້ມູນ custom state formula ຕ້ອງຢູ່ໃນ:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:11
#, no-wrap
msgid "/srv/salt/<custom-formula-name>/\n"
msgstr "/srv/salt/<custom-formula-name>/\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:12
msgid "Custom metadata information must be in:"
msgstr "ຂໍ້ມູນ custom metadata ຕ້ອງຢູ່ໃນ:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:13
#, no-wrap
msgid "/srv/formula_metadata/<custom-formula-name>/\n"
msgstr "/srv/formula_metadata/<custom-formula-name>/\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:14
msgid ""
"All custom folders must contain a [path]``form.yml`` file.  These files are "
"detected as form recipes and are applied to groups and systems from the "
"{webui}:"
msgstr "ທຸກໆໂຟນເດີ custom ຕ້ອງມີໄຟລ໌ [path]``form.yml``. ໄຟລ໌ເຫຼົ່ານີ້ຈະຖືກກວດພົບວ່າເປັນ form recipes ແລະ ຈະຖືກນຳໃຊ້ກັບກຸ່ມ ແລະ ລະບົບຕ່າງໆຈາກ {webui}:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:15
#, no-wrap
msgid "/srv/formula_metadata/<custom-formula-name>/form.yml\n"
msgstr "/srv/formula_metadata/<custom-formula-name>/form.yml\n"

#. type: delimited block =
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:16
msgid ""
"The Salt formula directory changed in {productname}{nbsp}4.0.  The old "
"directory location, [path]``/usr/share/susemanager/formulas``, will continue "
"to work for some time.  You should ensure that you update to the new "
"directory location, [path]``/usr/share/salt-formulas/`` as soon as possible."
msgstr "ໄດເຣັກທໍຣີ Salt formula ໄດ້ປ່ຽນແປງໃນ {productname}{nbsp}4.0. ທີ່ຕັ້ງໄດເຣັກທໍຣີເກົ່າ [path]``/usr/share/susemanager/formulas`` ຈະຍັງຄົງໃຊ້ງານໄດ້ຢູ່ໄລຍະໜຶ່ງ. ເຈົ້າຄວນແນ່ໃຈວ່າໄດ້ອັບເດດໄປທີ່ໄດເຣັກທໍຣີໃໝ່ [path]``/usr/share/salt-formulas/`` ໂດຍໄວທີ່ສຸດ."

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:17
#, no-wrap
msgid "Define Formula with Forms Data"
msgstr "ກຳນົດ Formula ດ້ວຍຂໍ້ມູນແບບຟອມ (Forms Data)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:18
msgid ""
"{productname} requires a file called [path]``form.yml``, to describe how "
"formula data should look within the {webui}.  The [path]``form.yml`` file is "
"used by {productname} to generate the desired formula with forms, with "
"values editable by a user."
msgstr "{productname} ຕ້ອງການໄຟລ໌ທີ່ຊື່ວ່າ [path]``form.yml`` ເພື່ອອະທິບາຍວ່າຂໍ້ມູນ formula ຄວນມີໜ້າຕາແນວໃດໃນ {webui}. ໄຟລ໌ [path]``form.yml`` ຖືກໃຊ້ໂດຍ {productname} ເພື່ອສ້າງ formula ທີ່ມີແບບຟອມຕາມທີ່ຕ້ອງການ, ໂດຍທີ່ຜູ້ໃຊ້ສາມາດແກ້ໄຂຄ່າຕ່າງໆໄດ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:19
msgid ""
"The file contains a list of editable attributes that start with a `$` sign.  "
"These attributes are used to determine how to display the formula in the "
"{productname} {webui}."
msgstr "ໄຟລ໌ນີ້ປະກອບດ້ວຍລາຍການຂອງຄຸນລັກສະນະ (attributes) ທີ່ສາມາດແກ້ໄຂໄດ້ ເຊິ່ງເລີ່ມຕົ້ນດ້ວຍເຄື່ອງໝາຍ `$`. ຄຸນລັກສະນະເຫຼົ່ານີ້ຖືກໃຊ້ເພື່ອລະບຸວິທີການສະແດງຜົນ formula ໃນ {productname} {webui}."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:20
msgid ""
"For example, the [path]``form.yml`` that is included with the "
"[package]``locale-formula`` is in:"
msgstr "ຕົວຢ່າງ: ໄຟລ໌ [path]``form.yml`` ທີ່ມາພ້ອມກັບ [package]``locale-formula`` ແມ່ນຢູ່ໃນ:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:21
#, no-wrap
msgid "/usr/share/susemanager/formulas/metadata/locale/form.yml\n"
msgstr "/usr/share/susemanager/formulas/metadata/locale/form.yml\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:22
msgid "Part of that file looks like this:"
msgstr "ບາງສ່ວນຂອງໄຟລ໌ນັ້ນມີໜ້າຕາຄືແນວນີ້:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:23
#, no-wrap
msgid ""
"timezone:\n"
"  $type: group\n"
msgstr ""
"timezone:\n"
"  $type: group\n"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:24
#, no-wrap
msgid ""
"  name:\n"
"    $type: select\n"
"    $values: [\"CET\",\n"
"              \"Etc/Zulu\"\n"
"              ]\n"
"    $default: CET\n"
msgstr ""
"  name:\n"
"    $type: select\n"
"    $values: [\"CET\",\n"
"              \"Etc/Zulu\"\n"
"              ]\n"
"    $default: CET\n"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:25
#, no-wrap
msgid ""
"  hardware_clock_set_to_utc:\n"
"    $type: boolean\n"
"    $default: True\n"
"...\n"
msgstr ""
"  hardware_clock_set_to_utc:\n"
"    $type: boolean\n"
"    $default: True\n"
"...\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:26
msgid ""
"All values that start with a `$` sign are annotations used to display the UI "
"that users interact with.  These annotations are not part of pillar data "
"itself and are handled as metadata."
msgstr "ຄ່າທັງໝົດທີ່ເລີ່ມຕົ້ນດ້ວຍເຄື່ອງໝາຍ `$` ແມ່ນຄຳອະທິບາຍ (annotations) ທີ່ໃຊ້ເພື່ອສະແດງຜົນ UI ທີ່ຜູ້ໃຊ້ໂຕ້ຕອບນຳ. ຄຳອະທິບາຍເຫຼົ່ານີ້ບໍ່ແມ່ນສ່ວນໜຶ່ງຂອງຂໍ້ມູນ pillar ໂດຍກົງ ແລະ ຈະຖືກຈັດການເປັນ metadata."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:27
msgid "This section lists the available attributes:"
msgstr "ພາກສ່ວນນີ້ສະແດງລາຍການຄຸນລັກສະນະທີ່ມີໃຫ້ໃຊ້:"

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:28
#, no-wrap
msgid "$type"
msgstr "$type"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:29
msgid ""
"The most important attribute is the `$type` attribute.  It defines the type "
"of the pillar value and the form-field that is generated.  The supported "
"types are:"
msgstr "ຄຸນລັກສະນະທີ່ສຳຄັນທີ່ສຸດແມ່ນ `$type`. ມັນກຳນົດປະເພດຂອງຄ່າ pillar ແລະ ຫ້ອງຂໍ້ມູນໃນແບບຟອມ (form-field) ທີ່ຈະຖືກສ້າງຂຶ້ນ. ປະເພດທີ່ຮອງຮັບມີດັ່ງນີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:30
msgid "`text`"
msgstr "`text`"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:31
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:83
msgid "`password`"
msgstr "`password`"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:32
msgid "`number`"
msgstr "`number`"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:33
msgid "`url`"
msgstr "`url`"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:34
msgid "`email`"
msgstr "`email`"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:35
msgid "`date`"
msgstr "`date`"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:36
msgid "`time`"
msgstr "`time`"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:37
msgid "`datetime`"
msgstr "`datetime`"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:38
msgid "`boolean`"
msgstr "`boolean`"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:39
msgid "`color`"
msgstr "`color`"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:40
msgid "`select`"
msgstr "`select`"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:41
msgid "`group`"
msgstr "`group`"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:42
msgid "`edit-group`"
msgstr "`edit-group`"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:43
msgid "`namespace`"
msgstr "`namespace`"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:44
msgid "`hidden-group` (obsolete, renamed to ``namespace``)"
msgstr "`hidden-group` (ຍົກເລີກແລ້ວ, ປ່ຽນຊື່ເປັນ ``namespace``)"

#. type: delimited block =
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:45
msgid ""
"The text attribute is the default and does not need to be specified "
"explicitly."
msgstr "ຄຸນລັກສະນະ text ແມ່ນຄ່າເລີ່ມຕົ້ນ ແລະ ບໍ່ຈຳເປັນຕ້ອງລະບຸຢ່າງຊັດເຈນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:46
msgid "Many of these values are self-explanatory:"
msgstr "ຫຼາຍໆຄ່າເຫຼົ່ານີ້ສາມາດເຂົ້າໃຈໄດ້ງ່າຍດ້ວຍຕົວມັນເອງ:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:47
msgid "The `text` type generates a simple text field"
msgstr "ປະເພດ `text` ຈະສ້າງຫ້ອງປ້ອນຂໍ້ຄວາມແບບງ່າຍໆ"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:48
msgid "The `password` type generates a password field"
msgstr "ປະເພດ `password` ຈະສ້າງຫ້ອງປ້ອນລະຫັດຜ່ານ"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:49
msgid "The `color` type generates a color picker"
msgstr "ປະເພດ `color` ຈະສ້າງເຄື່ອງມືເລືອກສີ (color picker)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:50
msgid ""
"The ``group``, ``edit-group``, and `namespace` (formerly ``hidden-group``) "
"types do not generate an editable field and are used to structure form and "
"pillar data.  All these types support nesting."
msgstr "ປະເພດ ``group``, ``edit-group``, ແລະ `namespace` (ເມື່ອກ່ອນແມ່ນ ``hidden-group``) ຈະບໍ່ສ້າງຫ້ອງຂໍ້ມູນທີ່ແກ້ໄຂໄດ້, ແຕ່ຖືກໃຊ້ເພື່ອຈັດໂຄງສ້າງຂອງແບບຟອມ ແລະ ຂໍ້ມູນ pillar. ທຸກໆປະເພດເຫຼົ່ານີ້ຮອງຮັບການຊ້ອນກັນ (nesting)."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:51
msgid ""
"The `group` and `namespace` types differ slightly.  The `group` type "
"generates a visible border with a heading.  The `namespace` type shows "
"nothing visually, and is only used to structure pillar data."
msgstr "ປະເພດ `group` ແລະ `namespace` ມີຄວາມແຕກຕ່າງກັນເລັກນ້ອຍ. ປະເພດ `group` ຈະສ້າງຂອບທີ່ເບິ່ງເຫັນໄດ້ພ້ອມກັບຫົວຂໍ້. ສ່ວນປະເພດ `namespace` ຈະບໍ່ສະແດງຜົນຫຍັງໃຫ້ເຫັນ, ແລະ ຖືກໃຊ້ເພື່ອຈັດໂຄງສ້າງຂໍ້ມູນ pillar ເທົ່ານັ້ນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:52
msgid ""
"The `edit-group` type allows you to structure and restrict editable fields "
"in a more flexible way.  The `edit-group` type is a collection of items of "
"the same kind.  Collections can have these four shapes:"
msgstr "ປະເພດ `edit-group` ຊ່ວຍໃຫ້ເຈົ້າຈັດໂຄງສ້າງ ແລະ ຈຳກັດຫ້ອງຂໍ້ມູນທີ່ແກ້ໄຂໄດ້ຢ່າງຢືດຢຸ່ນຫຼາຍຂຶ້ນ. ປະເພດ `edit-group` ແມ່ນກຸ່ມຂອງລາຍການປະເພດດຽວກັນ. ການລວມກຸ່ມສາມາດມີ 4 ຮູບແບບດັ່ງນີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:53
msgid "List of primitive items"
msgstr "ລາຍການຂອງຂໍ້ມູນພື້ນຖານ (primitive items)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:54
msgid "List of dictionaries"
msgstr "ລາຍການຂອງ dictionaries"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:55
msgid "Dictionary of primitive items"
msgstr "Dictionary ຂອງຂໍ້ມູນພື້ນຖານ"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:56
msgid "Dictionary of dictionaries"
msgstr "Dictionary ຂອງ dictionaries"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:57
msgid "The size of each collection is variable.  Users can add or remove elements."
msgstr "ຂະໜາດຂອງແຕ່ລະກຸ່ມແມ່ນສາມາດປ່ຽນແປງໄດ້. ຜູ້ໃຊ້ສາມາດເພີ່ມ ຫຼື ລົບອົງປະກອບອອກໄດ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:58
msgid ""
"For example, `edit-group` supports the `$minItems` and `$maxItems` "
"attributes, which simplifies complex and repeatable input structures.  "
"These, and also `itemName`, are optional."
msgstr "ຕົວຢ່າງ, `edit-group` ຮອງຮັບຄຸນລັກສະນະ `$minItems` ແລະ `$maxItems`, ເຊິ່ງຊ່ວຍເຮັດໃຫ້ໂຄງສ້າງການປ້ອນຂໍ້ມູນທີ່ຊັບຊ້ອນ ແລະ ຊ້ຳໆກັນນັ້ນງ່າຍຂຶ້ນ. ຄຸນລັກສະນະເຫຼົ່ານີ້, ລວມທັງ `itemName`, ແມ່ນເປັນທາງເລືອກ (optional)."

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:59
#, no-wrap
msgid "$default"
msgstr "$default"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:60
msgid ""
"Allows you to specify a default value to be displayed.  This default value "
"will be used if no other value is entered.  In an `edit-group` it allows you "
"to create initial members of the group and populate them with specified "
"data."
msgstr "ຊ່ວຍໃຫ້ເຈົ້າກຳນົດຄ່າເລີ່ມຕົ້ນທີ່ຈະສະແດງຜົນ. ຄ່າເລີ່ມຕົ້ນນີ້ຈະຖືກນຳໃຊ້ຫາກບໍ່ມີການປ້ອນຄ່າອື່ນ. ໃນ `edit-group`, ມັນຊ່ວຍໃຫ້ເຈົ້າສ້າງສະມາຊິກເລີ່ມຕົ້ນຂອງກຸ່ມ ແລະ ໃສ່ຂໍ້ມູນທີ່ກຳນົດໄວ້ລົງໄປ."

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:61
#, no-wrap
msgid "$optional"
msgstr "$optional"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:62
msgid ""
"This type is a Boolean attribute.  If it is `true` and the field is empty in "
"the form, then this field will not be generated in the formula data and the "
"generated dictionary will not contain the field name key.  If it is `false` "
"and the field is empty, the formula data will contain a `<field name>: null` "
"entry."
msgstr "ປະເພດນີ້ແມ່ນຄຸນລັກສະນະແບບບູລີນ (Boolean). ຫາກມັນເປັນ `true` ແລະ ຫ້ອງຂໍ້ມູນວ່າງຢູ່ໃນແບບຟອມ, ຫ້ອງຂໍ້ມູນນີ້ຈະບໍ່ຖືກສ້າງຂຶ້ນໃນຂໍ້ມູນ formula ແລະ dictionary ທີ່ສ້າງຂຶ້ນກໍຈະບໍ່ມີ key ຂອງຊື່ຫ້ອງຂໍ້ມູນນັ້ນ. ຫາກມັນເປັນ `false` ແລະ ຫ້ອງຂໍ້ມູນວ່າງ, ຂໍ້ມູນ formula ຈະມີລາຍການ `<field name>: null` ປະກົດຢູ່."

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:63
#, no-wrap
msgid "$ifEmpty"
msgstr "$ifEmpty"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:64
msgid ""
"This type is used if the field is empty.  This usually occurs because the "
"user did not provide a value.  The `ifEmpty` type can only be used when "
"`$optional` is `false` or not defined.  If `$optional` is `true`, then "
"`$ifEmpty` is ignored.  In this example, the `DP2` string would be used if "
"the user leaves the field empty:"
msgstr "ປະເພດນີ້ຖືກໃຊ້ຫາກຫ້ອງຂໍ້ມູນວ່າງ. ໂດຍປົກກະຕິແລ້ວຈະເກີດຂຶ້ນຍ້ອນຜູ້ໃຊ້ບໍ່ໄດ້ປ້ອນຄ່າໃດໆ. ປະເພດ `ifEmpty` ສາມາດໃຊ້ໄດ້ກໍຕໍ່ເມື່ອ `$optional` ເປັນ `false` ຫຼື ບໍ່ໄດ້ກຳນົດໄວ້ເທົ່ານັ້ນ. ຫາກ `$optional` ເປັນ `true`, `$ifEmpty` ຈະຖືກຂ້າມໄປ. ໃນຕົວຢ່າງນີ້, ຂໍ້ຄວາມ `DP2` ຈະຖືກນຳໃຊ້ຫາກຜູ້ໃຊ້ປະຫ້ອງຂໍ້ມູນໃຫ້ວ່າງ:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:65
#, no-wrap
msgid ""
"displayName:\n"
"  $type: string\n"
"  $ifEmpty: DP2\n"
msgstr ""
"displayName:\n"
"  $type: string\n"
"  $ifEmpty: DP2\n"

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:66
#, no-wrap
msgid "$name"
msgstr "$name"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:67
msgid ""
"Allows you to specify the name of a value that is shown in the form.  If "
"this value is not set, the pillar name is used and capitalized without "
"underscores and dashes.  Reference it in the same section with "
"``pass:c[${name}]``."
msgstr "ຊ່ວຍໃຫ້ເຈົ້າກຳນົດຊື່ຂອງຄ່າທີ່ຈະສະແດງໃນແບບຟອມ. ຫາກຄ່ານີ້ບໍ່ໄດ້ຖືກຕັ້ງໄວ້, ຈະໃຊ້ຊື່ຂອງ pillar ແທນ ໂດຍປ່ຽນເປັນຕົວພິມໃຫຍ່ ແລະ ຕັດເຄື່ອງໝາຍຂີດກາງ ຫຼື ຂີດກ້ອງອອກ. ອ້າງອີງເຖິງມັນໃນພາກສ່ວນດຽວກັນດ້ວຍ ``pass:c[${name}]``."

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:68
#, no-wrap
msgid "$help and $placeholder"
msgstr "$help ແລະ $placeholder"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:69
msgid ""
"These attributes are used to give a user a better understanding of what the "
"value should be.  The `$help` type defines the message a user sees when "
"hovering over a field The `$placeholder` type displays a gray placeholder "
"text in the field"
msgstr "ຄຸນລັກສະນະເຫຼົ່ານີ້ຖືກໃຊ້ເພື່ອໃຫ້ຜູ້ໃຊ້ເຂົ້າໃຈດີຂຶ້ນວ່າຄ່າທີ່ຄວນປ້ອນແມ່ນຫຍັງ. ປະເພດ `$help` ກຳນົດຂໍ້ຄວາມທີ່ຜູ້ໃຊ້ຈະເຫັນເມື່ອເອົາເມົ້າໄປຊີ້ (hover) ໃສ່ຫ້ອງຂໍ້ມູນ. ປະເພດ `$placeholder` ຈະສະແດງຂໍ້ຄວາມສີເທົາຈາງໆຢູ່ໃນຫ້ອງຂໍ້ມູນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:70
msgid ""
"Use `$placeholder` only with text fields like text, password, email or date "
"fields.  Do not add a placeholder if you also use `$default`, as it will "
"hide the placeholder."
msgstr "ໃຊ້ `$placeholder` ສະເພາະກັບຫ້ອງປ້ອນຂໍ້ຄວາມ ເຊັ່ນ text, password, email ຫຼື date ເທົ່ານັ້ນ. ບໍ່ຄວນເພີ່ມ placeholder ຫາກເຈົ້າໃຊ້ `$default` ຢູ່ແລ້ວ, ເພາະມັນຈະບັງ placeholder ໄວ້."

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:71
#, no-wrap
msgid "$key"
msgstr "$key"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:72
msgid ""
"Applicable only if the `edit-group` has the shape of a dictionary.  When the "
"pillar data is a dictionary, the `$key` attribute determines the key of an "
"entry in the dictionary."
msgstr "ໃຊ້ໄດ້ສະເພາະຫາກ `edit-group` ຢູ່ໃນຮູບແບບຂອງ dictionary ເທົ່ານັ້ນ. ເມື່ອຂໍ້ມູນ pillar ເປັນ dictionary, ຄຸນລັກສະນະ `$key` ຈະກຳນົດ key ຂອງລາຍການໃນ dictionary ນັ້ນ."

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:74
#, no-wrap
msgid ""
"user_passwords:\n"
"  $type: edit-group\n"
"  $minItems: 1\n"
"  $prototype:\n"
"    $key:\n"
"        $type: text\n"
"    $type: text\n"
"  $default:\n"
"    alice: secret-password\n"
"    bob: you-shall-not-pass\n"
msgstr ""
"user_passwords:\n"
"  $type: edit-group\n"
"  $minItems: 1\n"
"  $prototype:\n"
"    $key:\n"
"        $type: text\n"
"    $type: text\n"
"  $default:\n"
"    alice: secret-password\n"
"    bob: you-shall-not-pass\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:75
msgid "Pillar:"
msgstr "Pillar:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:76
#, no-wrap
msgid ""
"user_passwords:\n"
"  alice:\n"
"    secret-password\n"
"  bob:\n"
"    you-shall-not-pass\n"
msgstr ""
"user_passwords:\n"
"  alice:\n"
"    secret-password\n"
"  bob:\n"
"    you-shall-not-pass\n"

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:77
#, no-wrap
msgid "$minItems and $maxItems"
msgstr "$minItems ແລະ $maxItems"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:78
msgid ""
"In an ``edit-group``, `$minItems` and `$maxItems` specifies the lowest and "
"highest numbers for the group."
msgstr "ໃນ ``edit-group``, `$minItems` ແລະ `$maxItems` ຈະກຳນົດຈຳນວນຕ່ຳສຸດ ແລະ ສູງສຸດສຳລັບກຸ່ມນັ້ນ."

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:79
#, no-wrap
msgid "$itemName"
msgstr "$itemName"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:80
msgid ""
"In an ``edit-group``, `$itemName` defines a template for the name to be used "
"for the members of the group."
msgstr "ໃນ ``edit-group``, `$itemName` ຈະກຳນົດຮູບແບບ (template) ສຳລັບຊື່ທີ່ຈະໃຊ້ສຳລັບສະມາຊິກຂອງກຸ່ມ."

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:81
#, no-wrap
msgid "$prototype"
msgstr "$prototype"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:82
msgid ""
"In an ``edit-group``, `$prototype` is mandatory and defines the default "
"pre-filled values for newly added members in the group."
msgstr "ໃນ ``edit-group``, `$prototype` ແມ່ນສິ່ງທີ່ຈຳເປັນ ແລະ ຈະກຳນົດຄ່າເລີ່ມຕົ້ນທີ່ຈະຖືກຕື່ມໄວ້ກ່ອນສຳລັບສະມາຊິກທີ່ເພີ່ມເຂົ້າມາໃໝ່ໃນກຸ່ມ."

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:83
#, no-wrap
msgid "$scope"
msgstr "$scope"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:84
msgid ""
"Specifies a hierarchy level at which a value may be edited.  Possible values "
"are ``system``, `group`, and ``readonly``."
msgstr "ກຳນົດລະດັບລຳດັບຂັ້ນ (hierarchy level) ທີ່ຄ່າໃດໜຶ່ງສາມາດແກ້ໄຂໄດ້. ຄ່າທີ່ເປັນໄປໄດ້ແມ່ນ ``system``, `group`, ແລະ ``readonly``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:85
msgid ""
"The default value is `$scope: system`, allows values to be edited at group "
"and system levels.  A value can be entered for each system but if no value "
"is entered the system will fall back to the group default."
msgstr "ຄ່າເລີ່ມຕົ້ນແມ່ນ `$scope: system`, ເຊິ່ງອະນຸຍາດໃຫ້ແກ້ໄຂຄ່າໄດ້ທັງໃນລະດັບກຸ່ມ ແລະ ລະດັບລະບົບ. ສາມາດປ້ອນຄ່າສຳລັບແຕ່ລະລະບົບໄດ້, ແຕ່ຫາກບໍ່ມີການປ້ອນຄ່າ, ລະບົບຈະກັບໄປໃຊ້ຄ່າເລີ່ມຕົ້ນຂອງກຸ່ມ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:86
msgid ""
"The ``$scope: group`` option makes a value editable only for a group.  On "
"the system level you will be able to see the value, but not edit it."
msgstr "ຕົວເລືອກ ``$scope: group`` ຈະເຮັດໃຫ້ຄ່າສາມາດແກ້ໄຂໄດ້ສະເພາະສຳລັບກຸ່ມເທົ່ານັ້ນ. ໃນລະດັບລະບົບ ເຈົ້າຈະສາມາດເຫັນຄ່າໄດ້ ແຕ່ບໍ່ສາມາດແກ້ໄຂມັນໄດ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:87
msgid ""
"The `$scope: readonly` option makes a field read-only.  It can be used to "
"show data to the user, but will not allow them to edit it.  This option "
"should be used in combination with the ``$default`` attribute."
msgstr "ຕົວເລືອກ `$scope: readonly` ຈະເຮັດໃຫ້ຫ້ອງຂໍ້ມູນເປັນແບບອ່ານໄດ້ຢ່າງດຽວ. ມັນສາມາດໃຊ້ເພື່ອສະແດງຂໍ້ມູນໃຫ້ຜູ້ໃຊ້ເຫັນ ແຕ່ບໍ່ອະນຸຍາດໃຫ້ເຂົາເຈົ້າແກ້ໄຂ. ຕົວເລືອກນີ້ຄວນໃຊ້ຄູ່ກັບຄຸນລັກສະນະ ``$default``."

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:88
#, no-wrap
msgid "$visibleIf"
msgstr "$visibleIf"

#. type: delimited block =
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:89
msgid "Deprecated in favor of `$visible`."
msgstr "ຖືກຍົກເລີກ ແລະ ໃຫ້ໃຊ້ `$visible` ແທນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:90
msgid ""
"Allows you to show a field or group if a simple condition is met.  An "
"example condition is:"
msgstr "ຊ່ວຍໃຫ້ເຈົ້າສະແດງຫ້ອງຂໍ້ມູນ ຫຼື ກຸ່ມ ຫາກເປັນໄປຕາມເງື່ອນໄຂແບບງ່າຍໆ. ຕົວຢ່າງເງື່ອນໄຂຄື:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:91
#, no-wrap
msgid "some_group#another_group#my_checkbox == true\n"
msgstr "some_group#another_group#my_checkbox == true\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:92
msgid ""
"The left part of the condition is the path to another value, and groups are "
"separated by `#` signs.  The middle section of the condition should be "
"either `==` for a value to be equal or `!=` for values that should be not "
"equal.  The last field in the statement can be any value which a field "
"should have or not have."
msgstr "ສ່ວນຊ້າຍຂອງເງື່ອນໄຂແມ່ນເສັ້ນທາງ (path) ໄປຫາຄ່າອື່ນ, ໂດຍທີ່ແຕ່ລະກຸ່ມຈະຖືກແຍກດ້ວຍເຄື່ອງໝາຍ `#`. ສ່ວນກາງຂອງເງື່ອນໄຂຄວນເປັນ `==` ສຳລັບຄ່າທີ່ເທົ່າກັນ ຫຼື `!=` ສຳລັບຄ່າທີ່ບໍ່ເທົ່າກັນ. ສ່ວນສຸດທ້າຍຂອງຂໍ້ຄວາມສາມາດເປັນຄ່າໃດໆກໍໄດ້ທີ່ຫ້ອງຂໍ້ມູນນັ້ນຄວນຈະມີ ຫຼື ບໍ່ມີ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:93
msgid ""
"The field with this attribute associated with it will be shown only when the "
"condition is met.  In this example the field will be shown only if "
"`my_checkbox` is checked.  The ability to use conditional statements is not "
"limited to check boxes.  It may also be used to check values of "
"select-fields, text-fields, and similar."
msgstr "ຫ້ອງຂໍ້ມູນທີ່ມີຄຸນລັກສະນະນີ້ຈະຖືກສະແດງກໍຕໍ່ເມື່ອເປັນໄປຕາມເງື່ອນໄຂເທົ່ານັ້ນ. ໃນຕົວຢ່າງນີ້ ຫ້ອງຂໍ້ມູນຈະສະແດງກໍຕໍ່ເມື່ອ `my_checkbox` ຖືກໝາຍຕິກ. ຄວາມສາມາດໃນການໃຊ້ເງື່ອນໄຂບໍ່ໄດ້ຈຳກັດຢູ່ພຽງແຕ່ check box ເທົ່ານັ້ນ, ແຕ່ຍັງສາມາດໃຊ້ກວດສອບຄ່າຂອງ select-fields, text-fields ແລະ ອື່ນໆໄດ້ອີກ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:94
msgid "A check box should be structured like this:"
msgstr "Check box ຄວນມີໂຄງສ້າງແບບນີ້:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:95
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:99
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:117
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:140
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:149
#, no-wrap
msgid ""
"some_group:\n"
"  $type: group\n"
msgstr ""
"some_group:\n"
"  $type: group\n"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:96
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:100
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:118
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:141
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:150
#, no-wrap
msgid ""
"  another_group:\n"
"    $type: group\n"
msgstr ""
"  another_group:\n"
"    $type: group\n"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:97
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:119
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:142
#, no-wrap
msgid ""
"      my_checkbox:\n"
"        $type: boolean\n"
msgstr ""
"      my_checkbox:\n"
"        $type: boolean\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:98
msgid ""
"Relative paths can be specified using prefix dots.  One dot indicates a "
"sibling, two dots indicate a parent, and so on.  This is mostly useful for "
"``edit-group``."
msgstr "ສາມາດລະບຸເສັ້ນທາງສຳພັນ (Relative paths) ໄດ້ໂດຍໃຊ້ຈ້ຳ (.) ເປັນຄຳນຳໜ້າ. ຈ້ຳດຽວໝາຍເຖິງລະດັບດຽວກັນ (sibling), ສອງຈ້ຳໝາຍເຖິງລະດັບເທິງ (parent), ແລະ ຕໍ່ໆໄປ. ສ່ວນຫຼາຍຈະມີປະໂຫຍດສຳລັບ ``edit-group``."

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:101
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:151
#, no-wrap
msgid ""
"    my_checkbox:\n"
"      $type: boolean\n"
msgstr ""
"    my_checkbox:\n"
"      $type: boolean\n"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:102
#, no-wrap
msgid ""
"    my_text:\n"
"      $visibleIf: .my_checkbox == true\n"
msgstr ""
"    my_text:\n"
"      $visibleIf: .my_checkbox == true\n"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:103
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:153
#, no-wrap
msgid ""
"  yet_another_group:\n"
"    $type: group\n"
msgstr ""
"  yet_another_group:\n"
"    $type: group\n"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:104
#, no-wrap
msgid ""
"    my_text2:\n"
"      $visibleIf: ..another_group#my_checkbox == true\n"
msgstr ""
"    my_text2:\n"
"      $visibleIf: ..another_group#my_checkbox == true\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:105
msgid ""
"If you use multiple groups with the attribute, you can allow a users to "
"select an option and show a completely different form, dependent upon the "
"selected value."
msgstr "ຫາກເຈົ້າໃຊ້ຫຼາຍກຸ່ມທີ່ມີຄຸນລັກສະນະນີ້, ເຈົ້າສາມາດໃຫ້ຜູ້ໃຊ້ເລືອກຕົວເລືອກໃດໜຶ່ງ ແລະ ສະແດງແບບຟອມທີ່ແຕກຕ່າງກັນອອກໄປເລີຍ ໂດຍຂຶ້ນກັບຄ່າທີ່ຖືກເລືອກ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:106
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:124
msgid ""
"Values from hidden fields can be merged into the pillar data and sent to the "
"client.  A formula must check the condition again and use the appropriate "
"data.  For example:"
msgstr "ຄ່າຈາກຫ້ອງຂໍ້ມູນທີ່ຖືກເຊື່ອງໄວ້ສາມາດຖືກລວມເຂົ້າໃນຂໍ້ມູນ pillar ແລະ ສົ່ງໄປຫາເຄື່ອງລູກຂ່າຍໄດ້. formula ຕ້ອງກວດສອບເງື່ອນໄຂອີກຄັ້ງ ແລະ ໃຊ້ຂໍ້ມູນທີ່ເໝາະສົມ. ຕົວຢ່າງ:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:107
#, no-wrap
msgid ""
"show_option:\n"
"  $type: checkbox\n"
"some_text:\n"
"  $visibleIf: .show_option == true\n"
msgstr ""
"show_option:\n"
"  $type: checkbox\n"
"some_text:\n"
"  $visibleIf: .show_option == true\n"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:108
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:126
#, no-wrap
msgid ""
"{% if pillar.show_option %}\n"
"do_something:\n"
"  with: {{ pillar.some_text }}\n"
"{% endif %}\n"
msgstr ""
"{% if pillar.show_option %}\n"
"do_something:\n"
"  with: {{ pillar.some_text }}\n"
"{% endif %}\n"

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:109
#, no-wrap
msgid "$values"
msgstr "$values"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:110
msgid ""
"Can only be used together with ``$type`` Use to specify the different "
"options in the select-field.  `$values` must be a list of possible values to "
"select.  For example:"
msgstr "ສາມາດໃຊ້ໄດ້ຮ່ວມກັບ ``$type`` ເທົ່ານັ້ນ. ໃຊ້ເພື່ອລະບຸຕົວເລືອກຕ່າງໆໃນ select-field. `$values` ຕ້ອງເປັນລາຍການຂອງຄ່າທີ່ເປັນໄປໄດ້ທີ່ຈະໃຫ້ເລືອກ. ຕົວຢ່າງ:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:111
#, no-wrap
msgid ""
"select_something:\n"
"  $type: select\n"
"  $values: [\"option1\", \"option2\"]\n"
msgstr ""
"select_something:\n"
"  $type: select\n"
"  $values: [\"option1\", \"option2\"]\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:112
msgid "Or:"
msgstr "ຫຼື:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:113
#, no-wrap
msgid ""
"select_something:\n"
"  $type: select\n"
"  $values:\n"
"    - option1\n"
"    - option2\n"
msgstr ""
"select_something:\n"
"  $type: select\n"
"  $values:\n"
"    - option1\n"
"    - option2\n"

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:114
#, no-wrap
msgid "$visible"
msgstr "$visible"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:115
msgid ""
"Allows you to show a field or group if a condition is met.  You must use the "
"https://github.com/TomFrost/jexl[jexl] expression language to write the "
"condition."
msgstr "ຊ່ວຍໃຫ້ເຈົ້າສະແດງຫ້ອງຂໍ້ມູນ ຫຼື ກຸ່ມ ຫາກເປັນໄປຕາມເງື່ອນໄຂ. ເຈົ້າຕ້ອງໃຊ້ພາສາ jexl (https://github.com/TomFrost/jexl) ໃນການຂຽນເງື່ອນໄຂ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:116
msgid "Example structure:"
msgstr "ໂຄງສ້າງຕົວຢ່າງ:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:120
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:143
msgid "An example condition is:"
msgstr "ຕົວຢ່າງເງື່ອນໄຂຄື:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:121
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:144
#, no-wrap
msgid "formValues.some_group.another_group.my_checkbox == true\n"
msgstr "formValues.some_group.another_group.my_checkbox == true\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:122
msgid ""
"The field with this attribute will only show if the condition is met.  In "
"this example, the field will show only if ``my_checkbox`` is checked.  You "
"can also choose other elements for the conditional statement, such as select "
"fields or text fields."
msgstr "ຫ້ອງຂໍ້ມູນທີ່ມີຄຸນລັກສະນະນີ້ຈະສະແດງກໍຕໍ່ເມື່ອເປັນໄປຕາມເງື່ອນໄຂເທົ່ານັ້ນ. ໃນຕົວຢ່າງນີ້ ຫ້ອງຂໍ້ມູນຈະສະແດງກໍຕໍ່ເມື່ອ ``my_checkbox`` ຖືກໝາຍຕິກ. ເຈົ້າຍັງສາມາດເລືອກອົງປະກອບອື່ນໆສຳລັບເງື່ອນໄຂໄດ້ ເຊັ່ນ select fields ຫຼື text fields."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:123
msgid ""
"If you use multiple groups with the attribute, users can select an option "
"that will show a completely different form, depending on the selected value."
msgstr "ຫາກເຈົ້າໃຊ້ຫຼາຍກຸ່ມທີ່ມີຄຸນລັກສະນະນີ້, ຜູ້ໃຊ້ສາມາດເລືອກຕົວເລືອກທີ່ຈະສະແດງແບບຟອມທີ່ແຕກຕ່າງກັນອອກໄປເລີຍ ໂດຍຂຶ້ນກັບຄ່າທີ່ຖືກເລືອກ."

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:125
#, no-wrap
msgid ""
"show_option:\n"
"  $type: checkbox\n"
"some_text:\n"
"  $visible: this.parent.value.show_option == true\n"
msgstr ""
"show_option:\n"
"  $type: checkbox\n"
"some_text:\n"
"  $visible: this.parent.value.show_option == true\n"

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:127
#, no-wrap
msgid "$disabled"
msgstr "$disabled"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:128
msgid ""
"Allows you to disable a field or group if a condition is met. You must use "
"the https://github.com/TomFrost/jexl[jexl] expression language to write the "
"condition."
msgstr "ຊ່ວຍໃຫ້ເຈົ້າປິດການໃຊ້ (disable) ຫ້ອງຂໍ້ມູນ ຫຼື ກຸ່ມ ຫາກເປັນໄປຕາມເງື່ອນໄຂ. ເຈົ້າຕ້ອງໃຊ້ພາສາ jexl ໃນການຂຽນເງື່ອນໄຂ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:129
msgid "If specified at group level it will disable all fields in that group."
msgstr "ຫາກກຳນົດໃນລະດັບກຸ່ມ, ມັນຈະປິດການໃຊ້ທຸກໆຫ້ອງຂໍ້ມູນໃນກຸ່ມນັ້ນ."

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:130
#, no-wrap
msgid "$required"
msgstr "$required"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:131
msgid ""
"Fields with this attribute are mandatory. Supports using the "
"https://github.com/TomFrost/jexl[jexl] expresion language."
msgstr "ຫ້ອງຂໍ້ມູນທີ່ມີຄຸນລັກສະນະນີ້ແມ່ນຈຳເປັນຕ້ອງປ້ອນ (mandatory). ຮອງຮັບການໃຊ້ພາສາ jexl ໃນການຂຽນເງື່ອນໄຂ."

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:132
#, no-wrap
msgid "$match"
msgstr "$match"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:133
msgid "Allows using a regular expression to validate the content of a text field."
msgstr "ຊ່ວຍໃຫ້ໃຊ້ regular expression ເພື່ອກວດສອບຄວາມຖືກຕ້ອງຂອງເນື້ອໃນໃນຫ້ອງປ້ອນຂໍ້ຄວາມ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:134
msgid "It supports the regular expression features existing in JavaScript."
msgstr "ມັນຮອງຮັບຄຸນສົມບັດຂອງ regular expression ທີ່ມີຢູ່ໃນ JavaScript."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:135
#: modules/specialized-guides/pages/salt/salt-gitfs.adoc:10
#: modules/specialized-guides/pages/salt/salt-gitfs.adoc:14
#: modules/specialized-guides/pages/salt/salt-gitfs.adoc:18
msgid "Example:"
msgstr "ຕົວຢ່າງ:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:136
#, no-wrap
msgid ""
"      hardware:\n"
"        $type: text\n"
"        $name: Hardware Type and Address\n"
"        $placeholder: Enter hardware-type hardware-address (for example, "
"\"ethernet AA:BB:CC:DD:EE:FF\")\n"
"        $help: Hardware Identifier - prefix is mandatory\n"
"        $match: \"\\\\w+ "
"[A-Z]{2}:[A-Z]{2}:[A-Z]{2}:[A-Z]{2}:[A-Z]{2}:[A-Z]{2}\"\n"
msgstr ""
"      hardware:\n"
"        $type: text\n"
"        $name: Hardware Type and Address\n"
"        $placeholder: ປ້ອນ hardware-type hardware-address (ຕົວຢ່າງ, \"ethernet AA:BB:CC:DD:EE:FF\")\n"
"        $help: Hardware Identifier - ຕ້ອງມີຄຳນຳໜ້າສະເໝີ\n"
"        $match: \"\\\\w+ [A-Z]{2}:[A-Z]{2}:[A-Z]{2}:[A-Z]{2}:[A-Z]{2}:[A-Z]{2}\"\n"

#. type: Title ===
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:137
#, no-wrap
msgid "Expression language"
msgstr "ພາສາສະແດງເງື່ອນໄຂ (Expression language)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:138
msgid ""
"You must use the https://github.com/TomFrost/jexl[jexl] expression language "
"to write conditions."
msgstr "ເຈົ້າຕ້ອງໃຊ້ພາສາ jexl ໃນການຂຽນເງື່ອນໄຂ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:139
msgid "Given a structure like this:"
msgstr "ຈາກໂຄງສ້າງຕົວຢ່າງນີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:145
msgid "Absolute paths must begin with ``formValues``."
msgstr "ເສັ້ນທາງສົມບູນ (Absolute paths) ຕ້ອງເລີ່ມຕົ້ນດ້ວຍ ``formValues``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:146
msgid ""
"Specify relative paths using ``this.parent.value`` to define the value of "
"the parent."
msgstr "ລະບຸເສັ້ນທາງສຳພັນໂດຍໃຊ້ ``this.parent.value`` ເພື່ອກຳນົດຄ່າຂອງລະດັບເທິງ (parent)."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:147
msgid ""
"You can also refer to the parent of the parent, with "
"``this.parent.parent.value``.  This is mostly useful for ``edit-group`` "
"elements."
msgstr "ເຈົ້າຍັງສາມາດອ້າງອີງເຖິງລະດັບເທິງຂອງລະດັບເທິງອີກເທື່ອໜຶ່ງດ້ວຍ ``this.parent.parent.value``. ເຊິ່ງສ່ວນຫຼາຍຈະມີປະໂຫຍດສຳລັບອົງປະກອບໃນ ``edit-group``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:148
msgid "Example for relative paths:"
msgstr "ຕົວຢ່າງສຳລັບເສັ້ນທາງສຳພັນ:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:152
#, no-wrap
msgid ""
"    my_text:\n"
"      $visible: this.parent.value.my_checkbox\n"
msgstr ""
"    my_text:\n"
"      $visible: this.parent.value.my_checkbox\n"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:154
#, no-wrap
msgid ""
"    my_text2:\n"
"      $visible: this.parent.parent.value.another_group.my_checkbox\n"
msgstr ""
"    my_text2:\n"
"      $visible: this.parent.parent.value.another_group.my_checkbox\n"

#. type: Block title
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:155
#, no-wrap
msgid "Example: Basic edit-group"
msgstr "ຕົວຢ່າງ: edit-group ແບບພື້ນຖານ"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:156
#, no-wrap
msgid ""
"partitions:\n"
"  $name: \"Hard Disk Partitions\"\n"
"  $type: \"edit-group\"\n"
"  $minItems: 1\n"
"  $maxItems: 4\n"
"  $itemName: \"Partition ${name}\"\n"
"  $prototype:\n"
"    name:\n"
"      $default: \"New partition\"\n"
"    mountpoint:\n"
"      $default: \"/var\"\n"
"    size:\n"
"      $type: \"number\"\n"
"      $name: \"Size in GB\"\n"
"  $default:\n"
"    - name: \"Boot\"\n"
"      mountpoint: \"/boot\"\n"
"    - name: \"Root\"\n"
"      mountpoint: \"/\"\n"
"      size: 5000\n"
msgstr ""
"partitions:\n"
"  $name: \"Hard Disk Partitions\"\n"
"  $type: \"edit-group\"\n"
"  $minItems: 1\n"
"  $maxItems: 4\n"
"  $itemName: \"Partition ${name}\"\n"
"  $prototype:\n"
"    name:\n"
"      $default: \"New partition\"\n"
"    mountpoint:\n"
"      $default: \"/var\"\n"
"    size:\n"
"      $type: \"number\"\n"
"      $name: \"Size in GB\"\n"
"  $default:\n"
"    - name: \"Boot\"\n"
"      mountpoint: \"/boot\"\n"
"    - name: \"Root\"\n"
"      mountpoint: \"/\"\n"
"      size: 5000\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:157
msgid "Click btn:[Add] to fill the form with the default values."
msgstr "ກົດ btn:[Add] ເພື່ອຕື່ມແບບຟອມດ້ວຍຄ່າເລີ່ມຕົ້ນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:158
msgid ""
"The formula is called [path]``hd-partitions`` and will appear as "
"[guimenu]``Hd Partitions`` in the {webui}."
msgstr "Formula ນີ້ຊື່ວ່າ [path]``hd-partitions`` ແລະ ຈະປະກົດເປັນ [guimenu]``Hd Partitions`` ໃນ {webui}."

#. type: Target for macro image
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:159
#, no-wrap
msgid "formula-custom-harddisk-partitions.png"
msgstr "formula-custom-harddisk-partitions.png"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:160
msgid ""
"To remove the definition of a partition click the minus symbol in the title "
"line of an inner group."
msgstr "ເພື່ອລົບການກຳນົດຄ່າຂອງພາທິຊັນ, ໃຫ້ກົດເຄື່ອງໝາຍລົບ (-) ໃນແຖວຫົວຂໍ້ຂອງກຸ່ມພາຍໃນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:161
msgid "When you are finished, click btn:[Save Formula]."
msgstr "ເມື່ອສຳເລັດແລ້ວ, ໃຫ້ກົດ btn:[Save Formula]."

#. type: Block title
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:162
#, no-wrap
msgid "Example: Nested edit-group"
msgstr "ຕົວຢ່າງ: edit-group ແບບຊ້ອນກັນ (Nested)"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:163
#, no-wrap
msgid ""
"users:\n"
"  $name: \"Users\"\n"
"  $type: edit-group\n"
"  $minItems: 2\n"
"  $maxItems: 5\n"
"  $prototype:\n"
"    name:\n"
"      $default: \"username\"\n"
"    password:\n"
"      $type: password\n"
"    groups:\n"
"      $type: edit-group\n"
"      $minItems: 1\n"
"      $prototype:\n"
"        group_name:\n"
"          $type: text\n"
"  $default:\n"
"    - name: \"root\"\n"
"      groups:\n"
"        - group_name: \"users\"\n"
"        - group_name: \"admins\"\n"
"    - name: \"admin\"\n"
"      groups:\n"
"        - group_name: \"users\"\n"
msgstr ""
"users:\n"
"  $name: \"Users\"\n"
"  $type: edit-group\n"
"  $minItems: 2\n"
"  $maxItems: 5\n"
"  $prototype:\n"
"    name:\n"
"      $default: \"username\"\n"
"    password:\n"
"      $type: password\n"
"    groups:\n"
"      $type: edit-group\n"
"      $minItems: 1\n"
"      $prototype:\n"
"        group_name:\n"
"          $type: text\n"
"  $default:\n"
"    - name: \"root\"\n"
"      groups:\n"
"        - group_name: \"users\"\n"
"        - group_name: \"admins\"\n"
"    - name: \"admin\"\n"
"      groups:\n"
"        - group_name: \"users\"\n"

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:164
#, no-wrap
msgid "Writing Salt Formulas"
msgstr "ການຂຽນ Salt Formulas"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:165
msgid ""
"Salt formulas are pre-written Salt states.  You can use Jinja to configure "
"formulas with pillar data."
msgstr "Salt formulas ແມ່ນ Salt states ທີ່ຖືກຂຽນໄວ້ລ່ວງໜ້າ. ເຈົ້າສາມາດໃຊ້ Jinja ເພື່ອຕັ້ງຄ່າ formulas ດ້ວຍຂໍ້ມູນ pillar."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:166
msgid "Basic Jinja syntax is:"
msgstr "ໄວຍາກອນ Jinja ພື້ນຖານຄື:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:167
#, no-wrap
msgid "pillar.some.value\n"
msgstr "pillar.some.value\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:168
msgid "When you are sure a pillar exists, use this syntax:"
msgstr "ເມື່ອເຈົ້າແນ່ໃຈວ່າ pillar ນັ້ນມີຢູ່, ໃຫ້ໃຊ້ໄວຍາກອນນີ້:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:169
#, no-wrap
msgid "salt['pillar.get']('some:value', 'default value')\n"
msgstr "salt['pillar.get']('some:value', 'default value')\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:170
msgid ""
"You can also replace the `pillar` value with `grains`.  For example, "
"``grains.some.value``."
msgstr "ເຈົ້າຍັງສາມາດປ່ຽນຄ່າ `pillar` ເປັນ `grains` ໄດ້. ຕົວຢ່າງ: ``grains.some.value``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:171
msgid ""
"Using data this way makes the formula configurable.  In this example, a "
"specified package is installed in the ``package_name`` pillar:"
msgstr "ການໃຊ້ຂໍ້ມູນໃນລັກສະນະນີ້ເຮັດໃຫ້ formula ສາມາດຕັ້ງຄ່າໄດ້. ໃນຕົວຢ່າງນີ້, ແພັກເກັດທີ່ລະບຸຈະຖືກຕິດຕັ້ງໃນ pillar ``package_name``:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:172
#, no-wrap
msgid ""
"install_a_package:\n"
"  pkg.installed:\n"
"    - name: {{ pillar.package_name }}\n"
msgstr ""
"install_a_package:\n"
"  pkg.installed:\n"
"    - name: {{ pillar.package_name }}\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:173
msgid ""
"You can also use more complex constructs such as `if/else` and `for-loops` "
"to provide greater functionality:"
msgstr "ເຈົ້າຍັງສາມາດໃຊ້ໂຄງສ້າງທີ່ຊັບຊ້ອນຂຶ້ນ ເຊັ່ນ `if/else` ແລະ `for-loops` ເພື່ອໃຫ້ມີການເຮັດວຽກທີ່ຫຼາກຫຼາຍຂຶ້ນ:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:174
#, no-wrap
msgid ""
"{% if pillar.installSomething %}\n"
"something:\n"
"  pkg.installed\n"
"{% else %}\n"
"anotherPackage:\n"
"  pkg.installed\n"
"{% endif %}\n"
msgstr ""
"{% if pillar.installSomething %}\n"
"something:\n"
"  pkg.installed\n"
"{% else %}\n"
"anotherPackage:\n"
"  pkg.installed\n"
"{% endif %}\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:175
msgid "Another example:"
msgstr "ຕົວຢ່າງອື່ນ:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:176
#, no-wrap
msgid ""
"{% for service in pillar.services %}\n"
"start_{{ service }}:\n"
"  service.running:\n"
"    - name: {{ service }}\n"
"{% endfor %}\n"
msgstr ""
"{% for service in pillar.services %}\n"
"start_{{ service }}:\n"
"  service.running:\n"
"    - name: {{ service }}\n"
"{% endfor %}\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:177
msgid ""
"Jinja also provides other helpful functions.  For example, you can iterate "
"over a dictionary:"
msgstr "Jinja ຍັງມີຟັງຊັນທີ່ມີປະໂຫຍດອື່ນໆ. ຕົວຢ່າງ: ເຈົ້າສາມາດວົນລູບ (iterate) ໃນ dictionary ໄດ້:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:178
#, no-wrap
msgid ""
"{% for key, value in some_dictionary.items() %}\n"
"do_something_with_{{ key }}: {{ value }}\n"
"{% endfor %}\n"
msgstr ""
"{% for key, value in some_dictionary.items() %}\n"
"do_something_with_{{ key }}: {{ value }}\n"
"{% endfor %}\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:179
msgid ""
"You can have Salt manage your files (for example, configuration files for a "
"program), and change them with pillar data."
msgstr "ເຈົ້າສາມາດໃຫ້ Salt ຈັດການໄຟລ໌ຂອງເຈົ້າ (ຕົວຢ່າງ: ໄຟລ໌ຕັ້ງຄ່າສຳລັບໂປຣແກຣມ), ແລະ ປ່ຽນແປງພວກມັນດ້ວຍຂໍ້ມູນ pillar."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:180
msgid ""
"In this example, Salt copies the file "
"[path]``salt-file_roots/my_state/files/my_program.conf`` on the server to "
"[path]``/etc/my_program/my_program.conf`` on the client and template it with "
"Jinja:"
msgstr "ໃນຕົວຢ່າງນີ້, Salt ຈະກັອບປີ້ໄຟລ໌ [path]``salt-file_roots/my_state/files/my_program.conf`` ໃນເຊີເວີ ໄປໄວ້ທີ່ [path]``/etc/my_program/my_program.conf`` ໃນເຄື່ອງລູກຂ່າຍ ແລະ ໃຊ້ Jinja ເປັນ template:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:181
#, no-wrap
msgid ""
"/etc/my_program/my_program.conf:\n"
"  file.managed:\n"
"    - source: salt://my_state/files/my_program.conf\n"
"    - template: jinja\n"
msgstr ""
"/etc/my_program/my_program.conf:\n"
"  file.managed:\n"
"    - source: salt://my_state/files/my_program.conf\n"
"    - template: jinja\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:182
msgid ""
"This example allows you to use Jinja in the file, like the previous example "
"for states:"
msgstr "ຕົວຢ່າງນີ້ຊ່ວຍໃຫ້ເຈົ້າໃຊ້ Jinja ໃນໄຟລ໌ໄດ້, ຄືກັບຕົວຢ່າງກ່ອນໜ້ານີ້ສຳລັບ states:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:183
#, no-wrap
msgid "some_config_option = {{ pillar.config_option_a }}\n"
msgstr "some_config_option = {{ pillar.config_option_a }}\n"

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:184
#, no-wrap
msgid "Separate Data"
msgstr "ແຍກຂໍ້ມູນ (Separate Data)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:185
msgid ""
"Separating data from a state can increase flexibility and make it easier to "
"re-use.  You can do this by writing values into a separate file named "
"[path]``map.jinja``.  This file must be within the same directory as the "
"state files."
msgstr "ການແຍກຂໍ້ມູນອອກຈາກ state ສາມາດເພີ່ມຄວາມຢືດຢຸ່ນ ແລະ ເຮັດໃຫ້ນຳກັບມາໃຊ້ໃໝ່ໄດ້ງ່າຍຂຶ້ນ. ເຈົ້າສາມາດເຮັດໄດ້ໂດຍການຂຽນຄ່າຕ່າງໆລົງໃນໄຟລ໌ແຍກທີ່ຊື່ວ່າ [path]``map.jinja``. ໄຟລ໌ນີ້ຕ້ອງຢູ່ໃນໄດເຣັກທໍຣີດຽວກັນກັບໄຟລ໌ state."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:186
msgid ""
"This example sets `data` to a dictionary with different values, depending on "
"which system the state runs on.  It will also merge data with the pillar "
"using the `some.pillar.data` value so you can access "
"`some.pillar.data.value` by using ``data.value``."
msgstr "ຕົວຢ່າງນີ້ກຳນົດໃຫ້ `data` ເປັນ dictionary ທີ່ມີຄ່າແຕກຕ່າງກັນ ໂດຍຂຶ້ນກັບວ່າ state ນັ້ນເຮັດວຽກໃນລະບົບໃດ. ມັນຍັງຈະລວມຂໍ້ມູນເຂົ້າກັບ pillar ໂດຍໃຊ້ຄ່າ `some.pillar.data`, ເຮັດໃຫ້ເຈົ້າສາມາດເຂົ້າເຖິງ `some.pillar.data.value` ໄດ້ໂດຍການໃຊ້ ``data.value``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:187
msgid ""
"You can choose to override defined values from pillars.  For example, by "
"overriding `some.pillar.data.package` in this example:"
msgstr "ເຈົ້າສາມາດເລືອກຂຽນທັບ (override) ຄ່າທີ່ກຳນົດໄວ້ຈາກ pillars ໄດ້. ຕົວຢ່າງ: ໂດຍການຂຽນທັບ `some.pillar.data.package` ໃນຕົວຢ່າງນີ້:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:188
#, no-wrap
msgid ""
"{% set data = salt['grains.filter_by']({\n"
"    'Suse': {\n"
"        'package': 'packageA',\n"
"        'service': 'serviceA'\n"
"    },\n"
"    'RedHat': {\n"
"        'package': 'package_a',\n"
"        'service': 'service_a'\n"
"    }\n"
"}, merge=salt['pillar.get']('some:pillar:data')) %}\n"
msgstr ""
"{% set data = salt['grains.filter_by']({\n"
"    'Suse': {\n"
"        'package': 'packageA',\n"
"        'service': 'serviceA'\n"
"    },\n"
"    'RedHat': {\n"
"        'package': 'package_a',\n"
"        'service': 'service_a'\n"
"    }\n"
"}, merge=salt['pillar.get']('some:pillar:data')) %}\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:189
msgid ""
"When you have created a map file, you can maintain compatibility with "
"multiple system types while accessing deep pillar data in a simpler way."
msgstr "ເມື່ອເຈົ້າສ້າງໄຟລ໌ map ແລ້ວ, ເຈົ້າຈະສາມາດຮັກສາຄວາມເຂົ້າກັນໄດ້ກັບລະບົບຫຼາຍປະເພດ ໃນຂະນະທີ່ເຂົ້າເຖິງຂໍ້ມູນ pillar ທີ່ຢູ່ເລິກໆໄດ້ໃນແບບທີ່ງ່າຍຂຶ້ນ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:190
msgid "Now you can import and use `data` in any file.  For example:"
msgstr "ຕອນນີ້ເຈົ້າສາມາດນຳເຂົ້າ (import) ແລະ ໃຊ້ `data` ໃນໄຟລ໌ໃດກໍໄດ້. ຕົວຢ່າງ:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:191
#, no-wrap
msgid "{% from \"some_folder/map.jinja\" import data with context %}\n"
msgstr "{% from \"some_folder/map.jinja\" import data with context %}\n"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:192
#, no-wrap
msgid ""
"install_package_a:\n"
"  pkg.installed:\n"
"    - name: {{ data.package }}\n"
msgstr ""
"install_package_a:\n"
"  pkg.installed:\n"
"    - name: {{ data.package }}\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:193
msgid ""
"You can define multiple variables by copying the `{% set ...%}` statement "
"with different values and then merge it with other pillars.  For example:"
msgstr "ເຈົ້າສາມາດກຳນົດຕົວປ່ຽນຫຼາຍຕົວໄດ້ໂດຍການກັອບປີ້ຂໍ້ຄວາມ `{% set ...%}` ດ້ວຍຄ່າທີ່ແຕກຕ່າງກັນ ແລ້ວລວມມັນເຂົ້າກັບ pillars ອື່ນໆ. ຕົວຢ່າງ:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:194
#, no-wrap
msgid ""
"{% set server = salt['grains.filter_by']({\n"
"    'Suse': {\n"
"        'package': 'my-server-pkg'\n"
"    }\n"
"}, merge=salt['pillar.get']('myFormula:server')) %}\n"
"{% set client = salt['grains.filter_by']({\n"
"    'Suse': {\n"
"        'package': 'my-client-pkg'\n"
"    }\n"
"}, merge=salt['pillar.get']('myFormula:client')) %}\n"
msgstr ""
"{% set server = salt['grains.filter_by']({\n"
"    'Suse': {\n"
"        'package': 'my-server-pkg'\n"
"    }\n"
"}, merge=salt['pillar.get']('myFormula:server')) %}\n"
"{% set client = salt['grains.filter_by']({\n"
"    'Suse': {\n"
"        'package': 'my-client-pkg'\n"
"    }\n"
"}, merge=salt['pillar.get']('myFormula:client')) %}\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:195
msgid "To import multiple variables, separate them with a comma.  For example:"
msgstr "ເພື່ອການນຳເຂົ້າຕົວປ່ຽນຫຼາຍຕົວ, ໃຫ້ແຍກພວກມັນດ້ວຍເຄື່ອງໝາຍຈ້ຳ (,). ຕົວຢ່າງ:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:196
#, no-wrap
msgid "{% from \"map.jinja\" import server, client with context %}\n"
msgstr "{% from \"map.jinja\" import server, client with context %}\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:197
msgid ""
"For more information about conventions to use when writing formulas, see "
"https://docs.saltproject.io/en/latest/topics/development/conventions/formulas.html."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບຂໍ້ກຳນົດ (conventions) ທີ່ຄວນໃຊ້ໃນການຂຽນ formulas, ໃຫ້ເບິ່ງທີ່ https://docs.saltproject.io/en/latest/topics/development/conventions/formulas.html."

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:198
#, no-wrap
msgid "Generated Pillar Data"
msgstr "ຂໍ້ມູນ Pillar ທີ່ຖືກສ້າງຂຶ້ນ (Generated Pillar Data)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:199
msgid ""
"Pillar data is generated by {productname} when events occur like generating "
"the highstate.  You can use an external pillar script to generate pillar "
"data for packages and group IDs, and include all pillar data for a system:"
msgstr "ຂໍ້ມູນ Pillar ຈະຖືກສ້າງຂຶ້ນໂດຍ {productname} ເມື່ອມີເຫດການເກີດຂຶ້ນ ເຊັ່ນ: ການສ້າງ highstate. ເຈົ້າສາມາດໃຊ້ສະຄຣິບ pillar ພາຍນອກເພື່ອສ້າງຂໍ້ມູນ pillar ສຳລັບແພັກເກັດ ແລະ ID ຂອງກຸ່ມ, ແລະ ລວມເອົາຂໍ້ມູນ pillar ທັງໝົດສຳລັບລະບົບໃດໜຶ່ງ:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:200
#, no-wrap
msgid "/usr/share/susemanager/modules/pillar/suma_minion.py\n"
msgstr "/usr/share/susemanager/modules/pillar/suma_minion.py\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:201
msgid "The process is executed like this:"
msgstr "ຂະບວນການແມ່ນເຮັດວຽກດັ່ງນີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:202
msgid ""
"The `suma_minion.py` script starts and finds all formulas for a system by "
"checking the `group_formulas.json` and `server_formulas.json` files."
msgstr "ສະຄຣິບ `suma_minion.py` ຈະເລີ່ມເຮັດວຽກ ແລະ ຄົ້ນຫາ formulas ທັງໝົດສຳລັບລະບົບໂດຍການກວດສອບໄຟລ໌ `group_formulas.json` ແລະ `server_formulas.json`."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:203
msgid ""
"The script loads the values for each formula (groups and from the system) "
"and merges them with the highstate."
msgstr "ສະຄຣິບຈະໂຫລດຄ່າສຳລັບແຕ່ລະ formula (ຈາກກຸ່ມ ແລະ ຈາກລະບົບ) ແລ້ວລວມພວກມັນເຂົ້າກັບ highstate."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:204
msgid ""
"By default, if no values are found, a group overrides a system if `$scope: "
"group`."
msgstr "ໂດຍເລີ່ມຕົ້ນ, ຫາກບໍ່ພົບຄ່າໃດໆ, ຄ່າຈາກກຸ່ມຈະຂຽນທັບ (override) ຄ່າຈາກລະບົບ ຫາກກຳນົດເປັນ `$scope: group`."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:205
msgid ""
"The script also includes a list of formulas applied to the system in a "
"pillar named ``formulas``."
msgstr "ສະຄຣິບຍັງຈະລວມເອົາລາຍການຂອງ formulas ທີ່ຖືກນຳໃຊ້ກັບລະບົບໄວ້ໃນ pillar ທີ່ຊື່ວ່າ ``formulas``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:206
msgid ""
"This structure makes it possible to include states.  In this example, the "
"top file is specifically generated by the `mgr_master_tops.py` script.  The "
"top file includes a state called ``formulas`` for each system.  This "
"includes the `formulas.sls` file located in "
"[path]``/usr/share/susemanager/formulas/states`` or "
"[path]``/usr/share/salt-formulas/states/``.  The content looks similar to "
"this:"
msgstr "ໂຄງສ້າງນີ້ຊ່ວຍໃຫ້ສາມາດລວມ states ເຂົ້າໄດ້. ໃນຕົວຢ່າງນີ້, top file ຈະຖືກສ້າງຂຶ້ນໂດຍສະເພາະໂດຍສະຄຣິບ `mgr_master_tops.py`. top file ຈະລວມເອົາ state ທີ່ຊື່ວ່າ ``formulas`` ສຳລັບແຕ່ລະລະບົບ. ເຊິ່ງລວມມີໄຟລ໌ `formulas.sls` ທີ່ຕັ້ງຢູ່ໃນ [path]``/usr/share/susemanager/formulas/states`` ຫຼື [path]``/usr/share/salt-formulas/states/``. ເນື້ອໃນຈະມີໜ້າຕາປະມານນີ້:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:207
#, no-wrap
msgid "include: {{ pillar[\"formulas\"] }}\n"
msgstr "include: {{ pillar[\"formulas\"] }}\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:208
msgid ""
"This pillar includes all formulas that are specified in the pillar data "
"generated from the external pillar script."
msgstr "Pillar ນີ້ຈະລວມເອົາທຸກໆ formulas ທີ່ລະບຸໄວ້ໃນຂໍ້ມູນ pillar ທີ່ສ້າງຂຶ້ນຈາກສະຄຣິບ pillar ພາຍນອກ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:209
msgid ""
"Formulas should be created directly after {productname} is installed.  If "
"you encounter any problems with formulas check these things first:"
msgstr "Formulas ຄວນຖືກສ້າງຂຶ້ນທັນທີຫຼັງຈາກທີ່ຕິດຕັ້ງ {productname} ສຳເລັດ. ຫາກເຈົ້າພົບກັບບັນຫາໃດໆກ່ຽວກັບ formulas ໃຫ້ກວດສອບສິ່ງເຫຼົ່ານີ້ກ່ອນ:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:210
msgid "The external pillar script (``suma_minion.py``) must include formula data."
msgstr "ສະຄຣິບ pillar ພາຍນອກ (``suma_minion.py``) ຕ້ອງລວມເອົາຂໍ້ມູນ formula."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:211
msgid ""
"Data is saved to [path]``/srv/susemanager/formula_data`` and the "
"[path]``pillar`` and [path]``group_pillar`` sub-directories."
msgstr "ຂໍ້ມູນຈະຖືກບັນທຶກໄວ້ໃນ [path]``/srv/susemanager/formula_data`` ແລະ ໄດເຣັກທໍຣີຍ່ອຍ [path]``pillar`` ແລະ [path]``group_pillar``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:212
msgid "These directories should be automatically generated by the server."
msgstr "ໄດເຣັກທໍຣີເຫຼົ່ານີ້ຄວນຈະຖືກສ້າງຂຶ້ນໂດຍອັດຕະໂນມັດໂດຍເຊີເວີ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:213
msgid "Formulas must be included for every client listed in the top file."
msgstr "Formulas ຕ້ອງຖືກລວມເຂົ້າສຳລັບທຸກໆເຄື່ອງລູກຂ່າຍທີ່ລະບຸໄວ້ໃນ top file."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-custom.adoc:214
msgid ""
"Currently this process is initiated by the [path]``mgr_master_tops.py`` "
"script which includes the `formulas.sls` file located in "
"[path]``/usr/share/susemanager/formulas/states/`` or "
"[path]``/usr/share/salt-formulas/states/``.  This directory must be a salt "
"file root.  File roots are configured on the salt-master ({productname}) "
"located at [path]``/etc/salt/master.d/susemanager.conf``."
msgstr "ໃນປັດຈຸບັນ ຂະບວນການນີ້ຖືກເລີ່ມຕົ້ນໂດຍສະຄຣິບ [path]``mgr_master_tops.py`` ເຊິ່ງລວມເອົາໄຟລ໌ `formulas.sls` ທີ່ຕັ້ງຢູ່ໃນ [path]``/usr/share/susemanager/formulas/states/`` ຫຼື [path]``/usr/share/salt-formulas/states/``. ໄດເຣັກທໍຣີນີ້ນີ້ຕ້ອງເປັນ salt file root. File roots ຈະຖືກຕັ້ງຄ່າໃນ salt-master ({productname}) ທີ່ຕັ້ງຢູ່ [path]``/etc/salt/master.d/susemanager.conf``."

#. type: Title =
#: modules/specialized-guides/pages/salt/salt-formulas-intro.adoc:1
#, no-wrap
msgid "Salt Formulas"
msgstr "Salt Formulas"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-intro.adoc:2
msgid ""
"Formulas are collections of Salt States that contain generic parameter "
"fields.  Formulas allow for reliable reproduction of a specific "
"configuration.  Some formulas are supplied by {suse}, or you can install "
"formulas from RPM packages or an external git repository."
msgstr "Formulas ແມ່ນການລວມກຸ່ມຂອງ Salt States ທີ່ປະກອບດ້ວຍຫ້ອງພາລາມິເຕີທົ່ວໄປ. Formulas ຊ່ວຍໃຫ້ສາມາດສ້າງການຕັ້ງຄ່າທີ່ສະເພາະເຈາະຈົງຄືນໃໝ່ໄດ້ຢ່າງຖືກຕ້ອງ. ບາງ formulas ແມ່ນມີໃຫ້ໂດຍ {suse}, ຫຼື ເຈົ້າສາມາດຕິດຕັ້ງ formulas ຈາກແພັກເກັດ RPM ຫຼື ຈາກຄັງຂໍ້ມູນ git ພາຍນອກໄດ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-intro.adoc:3
msgid ""
"Formulas work best for large, non-trivial, configurations.  For smaller "
"tasks, use a state rather than a formula.  Formulas and states both act as a "
"kind of configuration documentation.  When you have written and stored the "
"configuration, they provide a snapshot of your infrastructure."
msgstr "Formulas ເຮັດວຽກໄດ້ດີທີ່ສຸດສຳລັບການຕັ້ງຄ່າທີ່ໃຫຍ່ ແລະ ຊັບຊ້ອນ. ສຳລັບວຽກຂະໜາດນ້ອຍ, ໃຫ້ໃຊ້ state ແທນທີ່ຈະໃຊ້ formula. ທັງ Formulas ແລະ states ຕ່າງກໍເຮັດໜ້າທີ່ເປັນເໝືອນເອກະສານບັນທຶກການຕັ້ງຄ່າ. ເມື່ອເຈົ້າໄດ້ຂຽນ ແລະ ຈັດເກັບການຕັ້ງຄ່າແລ້ວ, ພວກມັນຈະເຮັດໜ້າທີ່ເປັນພາບລວມ (snapshot) ຂອງໂຄງສ້າງພື້ນຖານຂອງເຈົ້າ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-intro.adoc:4
msgid "Formula data can be managed using the XMLRPC API."
msgstr "ຂໍ້ມູນ Formula ສາມາດຈັດການໄດ້ໂດຍໃຊ້ XMLRPC API."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-intro.adoc:5
msgid ""
"You can use the {productname} {webui} to apply {productname} formulas.  The "
"most commonly used formulas are documented in this section."
msgstr "ເຈົ້າສາມາດໃຊ້ {productname} {webui} ເພື່ອນຳໃຊ້ {productname} formulas. formulas ທີ່ຖືກໃຊ້ເລື້ອຍທີ່ສຸດແມ່ນມີຄູ່ມືຢູ່ໃນພາກສ່ວນນີ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-intro.adoc:6
msgid ""
"Alternatively, you can use pre-written formulas as a starting point for your "
"own custom formulas.  Pre-written formulas are available from "
"https://github.com/saltstack-formulas."
msgstr "ນອກຈາກນັ້ນ, ເຈົ້າຍັງສາມາດໃຊ້ formulas ທີ່ຖືກຂຽນໄວ້ແລ້ວເປັນຈຸດເລີ່ມຕົ້ນສຳລັບ custom formulas ຂອງເຈົ້າເອງ. formulas ທີ່ຂຽນໄວ້ແລ້ວແມ່ນມີໃຫ້ຢູ່ທີ່ https://github.com/saltstack-formulas."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-formulas-intro.adoc:7
msgid ""
"For more information on custom formulas, see "
"xref:specialized-guides:salt/salt-formulas-custom.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບ custom formulas, ໃຫ້ເບິ່ງ xref:specialized-guides:salt/salt-formulas-custom.adoc[]."

#. type: Title =
#: modules/specialized-guides/pages/salt/salt-gitfs.adoc:1
#, no-wrap
msgid "The gitfs Fileserver Backend"
msgstr "gitfs Fileserver Backend"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gitfs.adoc:2
msgid ""
"In {productname}, [package]``pygit2`` is the supported Python interface to "
"git.  When [package]``pygit2`` is installed the ``gitfs`` fileserver backend "
"is available and it is a supported feature."
msgstr "ໃນ {productname}, [package]``pygit2`` ແມ່ນ Python interface ທີ່ຮອງຮັບສຳລັບການຕິດຕໍ່ກັບ git. ເມື່ອຕິດຕັ້ງ [package]``pygit2`` ແລ້ວ, ``gitfs`` fileserver backend ຈະພ້ອມໃຊ້ງານ ແລະ ເປັນຄຸນສົມບັດທີ່ໄດ້ຮັບການຮອງຮັບ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gitfs.adoc:3
msgid ""
"Configuration options are set in the [path]``/etc/salt/master`` file, or in "
"a separate configuration file in the [path]``/etc/salt/master.d/`` "
"directory.  The basic settings are:"
msgstr "ຕົວເລືອກການຕັ້ງຄ່າແມ່ນຖືກຕັ້ງໄວ້ໃນໄຟລ໌ [path]``/etc/salt/master``, ຫຼື ໃນໄຟລ໌ຕັ້ງຄ່າແຍກຕ່າງຫາກໃນໄດເຣັກທໍຣີ [path]``/etc/salt/master.d/``. ການຕັ້ງຄ່າພື້ນຖານມີດັ່ງນີ້:"

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-gitfs.adoc:4
#, no-wrap
msgid "fileserver_backend"
msgstr "fileserver_backend"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gitfs.adoc:5
msgid ""
"List of fileserver backends that the Salt master checks for files in the "
"order they are defined.  Options:"
msgstr "ລາຍການຂອງ fileserver backends ທີ່ Salt master ຈະກວດສອບຫາໄຟລ໌ຕາມລຳດັບທີ່ກຳນົດໄວ້. ຕົວເລືອກມີດັ່ງນີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gitfs.adoc:6
msgid "[literal]``roots``: Files local on the Salt master ({productname} Server)."
msgstr "[literal]``roots``: ໄຟລ໌ທີ່ຢູ່ໃນເຄື່ອງ Salt master ໂດຍກົງ ({productname} Server)."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gitfs.adoc:7
msgid ""
"[literal]``roots`` is required to keep the product running.  You can only "
"enable [literal]``gitfs`` optionally.  Additionally, {suse} strongly "
"recommends to prefer [literal]``roots`` (local files) over "
"[literal]``gitfs``.  The standard backend."
msgstr "[literal]``roots`` ແມ່ນຈຳເປັນເພື່ອໃຫ້ຜະລິດຕະພັນເຮັດວຽກຕໍ່ໄປໄດ້. ເຈົ້າສາມາດເປີດໃຊ້ [literal]``gitfs`` ເປັນທາງເລືອກເສີມເທົ່ານັ້ນ. ນອກຈາກນັ້ນ, {suse} ແນະນຳຢ່າງຍິ່ງໃຫ້ເລືອກໃຊ້ [literal]``roots`` (ໄຟລ໌ໃນເຄື່ອງ) ກ່ອນ [literal]``gitfs``. ນີ້ແມ່ນ backend ມາດຕະຖານ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gitfs.adoc:8
msgid "[literal]``gitfs``: Files stored in one or more git repositories."
msgstr "[literal]``gitfs``: ໄຟລ໌ທີ່ຖືກຈັດເກັບໄວ້ໃນຄັງຂໍ້ມູນ git ຢ່າງໜ້ອຍໜຶ່ງແຫ່ງ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gitfs.adoc:9
msgid "The repositories are defined with [literal]``gitfs_remotes``."
msgstr "ຄັງຂໍ້ມູນ (repositories) ຈະຖືກກຳນົດດ້ວຍ [literal]``gitfs_remotes``."

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-gitfs.adoc:11
#, no-wrap
msgid ""
"fileserver_backend:\n"
"  - roots\n"
"  - git\n"
msgstr ""
"fileserver_backend:\n"
"  - roots\n"
"  - git\n"

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-gitfs.adoc:12
#, no-wrap
msgid "gitfs_remotes"
msgstr "gitfs_remotes"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gitfs.adoc:13
msgid ""
"List of git repositories.  ``git://``, ``https://``, ``file://``, or "
"``ssh://`` URLs can be configured.  For SSH remotes, a [command]``scp``-like "
"syntax is also supported; for example: "
"[literal]``gitlab@gitlab.example.com:universe/setup.git``.  Then you can "
"also specify options for credentials, file locations, or branches such as "
"[literal]``pubkey``, [literal]``privkey``, "
"[literal]``root``,[literal]``base``."
msgstr "ລາຍການຂອງຄັງຂໍ້ມູນ git. ສາມາດຕັ້ງຄ່າ URL ແບບ ``git://``, ``https://``, ``file://``, ຫຼື ``ssh://`` ໄດ້. ສຳລັບ SSH remotes, ຍັງຮອງຮັບໄວຍາກອນທີ່ຄ້າຍຄືກັບຄຳສັ່ງ [command]``scp``; ຕົວຢ່າງ: [literal]``gitlab@gitlab.example.com:universe/setup.git``. ນອກຈາກນັ້ນ ເຈົ້າຍັງສາມາດລະບຸຕົວເລືອກສຳລັບຂໍ້ມູນຢັ້ງຢືນຕົວຕົນ, ທີ່ຕັ້ງໄຟລ໌, ຫຼື ກິ່ງ (branches) ເຊັ່ນ [literal]``pubkey``, [literal]``privkey``, [literal]``root``, [literal]``base``."

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-gitfs.adoc:15
#, no-wrap
msgid ""
"gitfs_remotes:\n"
"  - https://example.com/myformulas/formula.git\n"
"  - gitlab@gitlab.example.com:universe/setup.git:\n"
"    - pubkey: /var/lib/salt/.ssh/id_rsa_gitlab.pub\n"
"    - privkey: /var/lib/salt/.ssh/id_rsa_gitlab\n"
"    - root: srv/salt\n"
"    - base: master\n"
msgstr ""
"gitfs_remotes:\n"
"  - https://example.com/myformulas/formula.git\n"
"  - gitlab@gitlab.example.com:universe/setup.git:\n"
"    - pubkey: /var/lib/salt/.ssh/id_rsa_gitlab.pub\n"
"    - privkey: /var/lib/salt/.ssh/id_rsa_gitlab\n"
"    - root: srv/salt\n"
"    - base: master\n"

#. type: Labeled list
#: modules/specialized-guides/pages/salt/salt-gitfs.adoc:16
#, no-wrap
msgid "ext_pillar"
msgstr "ext_pillar"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gitfs.adoc:17
msgid ""
"List of external pillar interfaces.  Salt can also serve pillar data from "
"one or more git repositories.  For syntax and options, also see the "
"[literal]``gitfs_remotes`` setting."
msgstr "ລາຍການຂອງ external pillar interfaces. Salt ຍັງສາມາດໃຫ້ບໍລິການຂໍ້ມູນ pillar ຈາກຄັງຂໍ້ມູນ git ຢ່າງໜ້ອຍໜຶ່ງແຫ່ງໄດ້. ສຳລັບໄວຍາກອນ ແລະ ຕົວເລືອກຕ່າງໆ, ໃຫ້ເບິ່ງການຕັ້ງຄ່າ [literal]``gitfs_remotes`` ເຊັ່ນກັນ."

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-gitfs.adoc:19
#, no-wrap
msgid ""
"ext_pillar:\n"
"  - git:\n"
"    - master gitlab@gitlab.example.com:universe/setup.git:\n"
"      - root: srv/pillar\n"
"      - pubkey: /var/lib/salt/.ssh/id_rsa_gitlab.pub\n"
"      - privkey: /var/lib/salt/.ssh/id_rsa_gitlab\n"
msgstr ""
"ext_pillar:\n"
"  - git:\n"
"    - master gitlab@gitlab.example.com:universe/setup.git:\n"
"      - root: srv/pillar\n"
"      - pubkey: /var/lib/salt/.ssh/id_rsa_gitlab.pub\n"
"      - privkey: /var/lib/salt/.ssh/id_rsa_gitlab\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gitfs.adoc:21
msgid "https://docs.saltproject.io/en/latest/topics/tutorials/gitfs.html"
msgstr "https://docs.saltproject.io/en/latest/topics/tutorials/gitfs.html"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gitfs.adoc:22
msgid "https://docs.saltproject.io/en/latest/ref/configuration/master.html"
msgstr "https://docs.saltproject.io/en/latest/ref/configuration/master.html"

#. type: Title =
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:1
#, no-wrap
msgid "GPG Encrypted Pillars"
msgstr "Pillars ທີ່ຖືກເຂົ້າລະຫັດດ້ວຍ GPG"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:2
msgid ""
"{salt} has support to transparently decrypt GPG-encrypted Pillar data "
"built-in.  The decryption happens on the {salt} Master during Pillar "
"rendering."
msgstr "{salt} ມີການຮອງຮັບການຖອດລະຫັດຂໍ້ມູນ Pillar ທີ່ຖືກເຂົ້າລະຫັດດ້ວຍ GPG ໂດຍອັດຕະໂນມັດ. ການຖອດລະຫັດຈະເກີດຂຶ້ນໃນ {salt} Master ໃນລະຫວ່າງຂະບວນການ Pillar rendering."

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:3
#, no-wrap
msgid "Generate GPG keyring for {salt} Master"
msgstr "ສ້າງ GPG keyring ສຳລັບ {salt} Master"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:4
msgid ""
"The GPG keyring can be specified in [path]``/etc/salt/master`` or in its own "
"file under [path]``/etc/salt/master.d/``, for example "
"[path]``/etc/salt/master.d/gpg-pillar.conf``."
msgstr "GPG keyring ສາມາດລະບຸໄດ້ໃນ [path]``/etc/salt/master`` ຫຼື ໃນໄຟລ໌ຂອງມັນເອງພາຍໃຕ້ [path]``/etc/salt/master.d/``, ຕົວຢ່າງ [path]``/etc/salt/master.d/gpg-pillar.conf``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:5
msgid "Always create a separate keyring for the {salt} Master."
msgstr "ໃຫ້ສ້າງ keyring ແຍກຕ່າງຫາກສຳລັບ {salt} Master ສະເໝີ."

#. type: Block title
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:6
#, no-wrap
msgid "Procedure: Generating key pair"
msgstr "ຂັ້ນຕອນ: ການສ້າງຄູ່ລະຫັດ (key pair)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:7
msgid "On the {salt} Master create GPG home directory and restrict its permissions:"
msgstr "ຢູ່ທີ່ {salt} Master, ໃຫ້ສ້າງໄດເຣັກທໍຣີຫຼັກ (home directory) ຂອງ GPG ແລະ ຈຳກັດສິດການເຂົ້າເຖິງ:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:8
#, no-wrap
msgid ""
"mkdir /etc/salt/gpgkeys\n"
"chmod 700 /etc/salt/gpgkeys\n"
msgstr ""
"mkdir /etc/salt/gpgkeys\n"
"chmod 700 /etc/salt/gpgkeys\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:9
msgid "Generate a key pair interactively."
msgstr "ສ້າງຄູ່ລະຫັດແບບໂຕ້ຕອບ."

#. type: delimited block =
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:10
msgid "The password must be empty."
msgstr "ລະຫັດຜ່ານຕ້ອງວ່າງ (ບໍ່ຕ້ອງໃສ່ລະຫັດຜ່ານ)."

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:11
#, no-wrap
msgid "gpg --gen-key --homedir /etc/salt/gpgkeys\n"
msgstr "gpg --gen-key --homedir /etc/salt/gpgkeys\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:12
msgid ""
"{salt} does not run with root permissions on SUSE Linux Enterprise and "
"openSUSE distributions."
msgstr "{salt} ບໍ່ໄດ້ເຮັດວຽກດ້ວຍສິດ root ໃນລະບົບ SUSE Linux Enterprise ແລະ openSUSE."

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:13
#, no-wrap
msgid "chown -R salt:salt /etc/salt/gpgkeys\n"
msgstr "chown -R salt:salt /etc/salt/gpgkeys\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:14
msgid "Configure {salt} Master to use the new GPG home directory"
msgstr "ຕັ້ງຄ່າ {salt} Master ໃຫ້ໃຊ້ໄດເຣັກທໍຣີຫຼັກຂອງ GPG ໃໝ່"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:15
#, no-wrap
msgid ""
"echo 'gpg_keydir: /etc/salt/gpgkeys' >/etc/salt/master.d/gpg-pillar.conf\n"
"systemctl reload-or-restart salt-master\n"
msgstr ""
"echo 'gpg_keydir: /etc/salt/gpgkeys' >/etc/salt/master.d/gpg-pillar.conf\n"
"systemctl reload-or-restart salt-master\n"

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:16
#, no-wrap
msgid "Use GPG for encrypting Pillar secrets"
msgstr "ໃຊ້ GPG ສຳລັບການເຂົ້າລະຫັດຂໍ້ມູນລັບໃນ Pillar"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:17
msgid ""
"Salt's GPG renderer decrypts GPG encrypted contents that are ASCII-armored.  "
"To use the GPG renderer in a single Pillar YAML file, change"
msgstr "Salt's GPG renderer ຈະຖອດລະຫັດເນື້ອໃນທີ່ເຂົ້າລະຫັດດ້ວຍ GPG ທີ່ເປັນແບບ ASCII-armored. ເພື່ອໃຊ້ GPG renderer ໃນໄຟລ໌ Pillar YAML ດຽວ, ໃຫ້ປ່ຽນ"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:18
#, no-wrap
msgid "#!jinja|yaml\n"
msgstr "#!jinja|yaml\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:19
msgid "to"
msgstr "ເປັນ"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:20
#, no-wrap
msgid "#!jinja|yaml|gpg\n"
msgstr "#!jinja|yaml|gpg\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:21
msgid ""
"To use Salt's GPG renderer globally, including for "
"xref:client-configuration:custom-info.adoc[], configure Salt Master as "
"follows"
msgstr "ເພື່ອໃຊ້ Salt's GPG renderer ໃນລະດັບສາກົນ (globally), ລວມເຖິງ xref:client-configuration:custom-info.adoc[], ໃຫ້ກຳນົດຄ່າ Salt Master ດັ່ງນີ້"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:22
#, no-wrap
msgid ""
"cat >/etc/salt/master.d/z-gpg-pillar.conf <<EOF\n"
"ext_pillar:\n"
"  - gpg: True\n"
"EOF\n"
msgstr ""
"cat >/etc/salt/master.d/z-gpg-pillar.conf <<EOF\n"
"ext_pillar:\n"
"  - gpg: True\n"
"EOF\n"

#. type: delimited block =
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:23
msgid ""
"The filename should have a [literal]``z-`` prefix to ensure the GPG renderer "
"runs after other configured pillar renderers."
msgstr "ຊື່ໄຟລ໌ຄວນຈະມີຄຳນຳໜ້າເປັນ [literal]``z-`` ເພື່ອຮັບປະກັນວ່າ GPG renderer ຈະເຮັດວຽກ ຫຼັງຈາກ renderer ຂອງ pillar ອື່ນໆ ທີ່ຖືກກຳນົດຄ່າໄວ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:24
msgid ""
"Encrypting pillar secrets can be done anywhere as long as the GPG and the "
"public key generated in <<proc-key-pair-generation>> are available."
msgstr "ການເຂົ້າລະຫັດຄວາມລັບຂອງ pillar ສາມາດເຮັດໄດ້ຢູ່ໃສກໍໄດ້ ຕາບໃດທີ່ GPG ແລະ public key ທີ່ສ້າງຂຶ້ນໃນ <<proc-key-pair-generation>> ສາມາດໃຊ້ງານໄດ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:25
msgid "In this example, \"SUMA Salt Master\" is the GPG key’s UID created earlier."
msgstr "ໃນຕົວຢ່າງນີ້, \"SUMA Salt Master\" ແມ່ນ UID ຂອງກະແຈ GPG ທີ່ສ້າງຂຶ້ນກ່ອນໜ້ານີ້."

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:26
#, no-wrap
msgid ""
"echo 't0ps3cr3t' | gpg --armor --batch --encrypt --recipient \"SUMA Salt "
"Master\"\n"
msgstr "echo 't0ps3cr3t' | gpg --armor --batch --encrypt --recipient \"SUMA Salt Master\"\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:27
msgid ""
"When the GPG encrytped contents are created and available as ASCII-armored "
"output, this output can be used as a multi-line string in a pillar YAML "
"file:"
msgstr "ເມື່ອເນື້ອໃນທີ່ຖືກເຂົ້າລະຫັດດ້ວຍ GPG ຖືກສ້າງຂຶ້ນ ແລະ ຢູ່ໃນຮູບແບບ ASCII-armored, ຜົນລັດພໍນີ້ສາມາດນຳໄປໃຊ້ເປັນ multi-line string ໃນໄຟລ໌ pillar YAML ໄດ້:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:28
#, no-wrap
msgid "#!yaml|gpg\n"
msgstr "#!yaml|gpg\n"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:29
#, no-wrap
msgid ""
"secret:\n"
"  my-secret: |\n"
"    -----BEGIN PGP MESSAGE-----\n"
msgstr ""
"secret:\n"
"  my-secret: |\n"
"    -----BEGIN PGP MESSAGE-----\n"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:30
#, no-wrap
msgid ""
"    hQEMA3OrmRaWrqgqAQf/ej8xV+nO3HVbQRCeJgCmt5ZjnogT++HHeFzXymfr1SgT\n"
"    XySyAqpIZB2N6MjZXtupO2sCmG6fzqtmnW+vRsZhQG8PAqzRtAekFuVbXzgkigBk\n"
"    338yOdyltVBtMONnkHFQ+7EP1tfJnWLCVrJ1I42vGFLZf2AD1xhbjewCcoaK82J4\n"
"    f8u9U/dxgV0N6na28WG5m6YU5Reu1Ca37PXHuqA/0XZl65DY63xaMPMDHZEi1wkU\n"
"    GXU7OsiL1dO0/sST1Awo5i99kVt/kA6DCGDuxTNpLrauNLOKUbtwcxvavtNZGwdQ\n"
"    yI9zWVx8qerWE0aO3M7zVDJftv77faV2ENiqzaadvtJHAZynW4GW7rSuP1RXFzlB\n"
"    DOAmzdRuIJwiLC9R2BKu3x+avReQb6xoz7eF7WthC0H0dz4mYakwPlVZ5yqYa/+G\n"
"    83i951rqAGI=\n"
"    =g+ji\n"
"    -----END PGP MESSAGE-----\n"
msgstr ""
"    hQEMA3OrmRaWrqgqAQf/ej8xV+nO3HVbQRCeJgCmt5ZjnogT++HHeFzXymfr1SgT\n"
"    XySyAqpIZB2N6MjZXtupO2sCmG6fzqtmnW+vRsZhQG8PAqzRtAekFuVbXzgkigBk\n"
"    338yOdyltVBtMONnkHFQ+7EP1tfJnWLCVrJ1I42vGFLZf2AD1xhbjewCcoaK82J4\n"
"    f8u9U/dxgV0N6na28WG5m6YU5Reu1Ca37PXHuqA/0XZl65DY63xaMPMDHZEi1wkU\n"
"    GXU7OsiL1dO0/sST1Awo5i99kVt/kA6DCGDuxTNpLrauNLOKUbtwcxvavtNZGwdQ\n"
"    yI9zWVx8qerWE0aO3M7zVDJftv77faV2ENiqzaadvtJHAZynW4GW7rSuP1RXFzlB\n"
"    DOAmzdRuIJwiLC9R2BKu3x+avReQb6xoz7eF7WthC0H0dz4mYakwPlVZ5yqYa/+G\n"
"    83i951rqAGI=\n"
"    =g+ji\n"
"    -----END PGP MESSAGE-----\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:31
msgid ""
"When the pillar is assigned to a system with [path]``top.sls``, the GPG "
"encrypted pillar data is available in a decrypted format."
msgstr "ເມື່ອ pillar ຖືກກຳນົດໃຫ້ກັບລະບົບດ້ວຍ [path]``top.sls``, ຂໍ້ມູນ pillar ທີ່ຖືກເຂົ້າລະຫັດ GPG ຈະຖືກສະແດງອອກໃນຮູບແບບທີ່ຖອດລະຫັດແລ້ວ."

#. type: delimited block =
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:32
msgid ""
"The client's in-memory cache is only updated on startup or when running "
"execution module functions that trigger a cache refresh such as "
"[literal]``saltutil.refresh_pillar``, [litaral]``pillar.items``, or "
"[literal]``state.apply``."
msgstr "ແຄຊ໌ (cache) ໃນໜ່ວຍຄວາມຈຳຂອງເຄື່ອງລູກຂ່າຍຈະຖືກອັບເດດເມື່ອເລີ່ມຕົ້ນລະບົບ ຫຼື ເມື່ອດຳເນີນການ ຟັງຊັນໂມດູນທີ່ກະຕຸ້ນການຣີເຟຣຊ (refresh) ແຄຊ໌ ເຊັ່ນ: [literal]``saltutil.refresh_pillar``, [literal]``pillar.items``, ຫຼື [literal]``state.apply``."

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:33
#, no-wrap
msgid ""
"suma-sles15sp1.tf.local:\n"
"    ----------\n"
"    my-secret:\n"
"        t0p s3cr3t!\n"
msgstr ""
"suma-sles15sp1.tf.local:\n"
"    ----------\n"
"    my-secret:\n"
"        t0p s3cr3t!\n"

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:34
#, no-wrap
msgid "Export the GPG key"
msgstr "ສົ່ງອອກ (Export) ລະຫັດ GPG"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:35
msgid "To export the GPG key, use the command:"
msgstr "ເພື່ອສົ່ງອອກລະຫັດ GPG, ໃຫ້ໃຊ້ຄຳສັ່ງ:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:36
#, no-wrap
msgid ""
"gpg --export 'SUMA Salt Master' --homedir /etc/salt/gpgkeys --output "
"suma-salt-master.gpg\n"
msgstr "gpg --export 'SUMA Salt Master' --homedir /etc/salt/gpgkeys --output suma-salt-master.gpg\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:37
msgid "Here 'SUMA Salt Master' is the name used during key generation."
msgstr "ໃນທີ່ນີ້ 'SUMA Salt Master' ແມ່ນຊື່ທີ່ໃຊ້ໃນລະຫວ່າງການສ້າງກະແຈ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-gpg-encrypted-pillars.adoc:38
msgid "The [literal]```suma-salt-master.gpg``` public key can be freely shared."
msgstr "ກະແຈສາທາລະນະ [literal]```suma-salt-master.gpg``` ສາມາດແບ່ງປັນໄດ້ຢ່າງເສລີ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-large-scale-tuning.adoc:3
#: modules/specialized-guides/pages/salt/salt-scaling-minions.adoc:3
msgid ""
"For more information on managing large scale deployments, see "
"xref:specialized-guides:large-deployments/overview.adoc[]."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການຈັດການການຕິດຕັ້ງລະບົບຂະໜາດໃຫຍ່, ໃຫ້ເບິ່ງ xref:specialized-guides:large-deployments/overview.adoc[]."

#. type: Title =
#: modules/specialized-guides/pages/salt/salt-overview.adoc:1
#, no-wrap
msgid "Salt Guide Overview"
msgstr "ພາບລວມຂອງຄູ່ມື Salt"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-overview.adoc:2
msgid ""
"Salt is a remote execution engine, configuration management and "
"orchestration system used by {productname} to manage clients."
msgstr "Salt ແມ່ນລະບົບສັ່ງການທາງໄກ (remote execution engine), ລະບົບຈັດການການຕັ້ງຄ່າ (configuration management) ແລະ ລະບົບປະສານງານ (orchestration) ທີ່ {productname} ໃຊ້ເພື່ອຈັດການເຄື່ອງລູກຂ່າຍ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-overview.adoc:3
msgid ""
"In {productname}, the Salt master runs on the {productname} Server, allowing "
"you to register and manage Salt clients."
msgstr "ໃນ {productname}, Salt master ຈະເຮັດວຽກຢູ່ທີ່ {productname} Server, ເຮັດໃຫ້ເຈົ້າສາມາດລົງທະບຽນ ແລະ ຈັດການ Salt clients ໄດ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-overview.adoc:4
msgid "This book is designed to be a primer for using Salt with {productname}."
msgstr "ປຶ້ມຫົວນີ້ຖືກອອກແບບມາເພື່ອເປັນບົດຮຽນພື້ນຖານສຳລັບການໃຊ້ Salt ຮ່ວມກັບ {productname}."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-overview.adoc:5
msgid ""
"For more information about Salt, see the Salt documentation at "
"https://docs.saltproject.io/en/latest/contents.html."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບ Salt, ໃຫ້ເບິ່ງເອກະສານຂອງ Salt ທີ່ https://docs.saltproject.io/en/latest/contents.html."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-overview.adoc:6
msgid "The current version of Salt in {productname} is {saltversion}."
msgstr "ເວີຊັນປັດຈຸບັນຂອງ Salt ໃນ {productname} ແມ່ນ {saltversion}."

#. type: Title =
#: modules/specialized-guides/pages/salt/salt-rate-limiting.adoc:1
#, no-wrap
msgid "Salt Rate Limiting"
msgstr "ການຈຳກັດອັດຕາການເຮັດວຽກຂອງ Salt (Rate Limiting)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-rate-limiting.adoc:2
msgid ""
"Salt is able to run commands in parallel on a large number of clients.  This "
"can potentially create large amounts of load on your infrastructure.  You "
"can use these rate-limiting parameters to control the load in your "
"environment."
msgstr "Salt ສາມາດສັ່ງການໃຫ້ເຄື່ອງລູກຂ່າຍຈຳນວນຫຼາຍເຮັດວຽກພ້ອມໆກັນໄດ້. ເຊິ່ງອາດຈະສ້າງພາລະ (load) ມະຫາສານໃຫ້ກັບໂຄງສ້າງພື້ນຖານຂອງເຈົ້າ. ເຈົ້າສາມາດໃຊ້ພາລາມິເຕີຈຳກັດອັດຕາເຫຼົ່ານີ້ເພື່ອຄວບຄຸມພາລະໃນສະພາບແວດລ້ອມຂອງເຈົ້າ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-rate-limiting.adoc:3
msgid ""
"These parameters are all configured in the [filename]``/etc/rhn/rhn.conf`` "
"configuration file."
msgstr "ພາລາມິເຕີເຫຼົ່ານີ້ທັງໝົດແມ່ນຖືກຕັ້ງຄ່າໃນໄຟລ໌ຕັ້ງຄ່າ [filename]``/etc/rhn/rhn.conf``."

#. type: delimited block =
#: modules/specialized-guides/pages/salt/salt-rate-limiting.adoc:4
msgid ""
"Salt commands that are executed from the command line are not subject to "
"these parameters."
msgstr "ຄຳສັ່ງ Salt ທີ່ຖືກສັ່ງການຈາກໜ້າຕ່າງຄຳສັ່ງ (command line) ໂດຍກົງ ຈະບໍ່ຖືກຄວບຄຸມໂດຍພາລາມິເຕີເຫຼົ່ານີ້."

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-rate-limiting.adoc:5
#, no-wrap
msgid "Batching"
msgstr "ການເຮັດວຽກແບບເປັນຊຸດ (Batching)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-rate-limiting.adoc:6
msgid ""
"There are two parameters that control how actions are sent to clients, one "
"for the batch size, and one for the delay."
msgstr "ມີສອງພາລາມິເຕີທີ່ຄວບຄຸມວິທີການສົ່ງຄຳສັ່ງໄປຫາເຄື່ອງລູກຂ່າຍ, ໜຶ່ງຄືຂະໜາດຂອງຊຸດ (batch size) ແລະ ອີກໜຶ່ງຄືໄລຍະເວລາລໍຖ້າ (delay)."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-rate-limiting.adoc:7
msgid ""
"When the {productname} Server sends a batch of actions to the target "
"clients, it will send it to the number of clients determined in the batch "
"size parameter.  After the specified delay period, commands will be sent to "
"the next batch of clients.  The number of clients in each subsequent batch "
"is equal to the number of clients that have completed in the previous batch."
msgstr "ເມື່ອ {productname} Server ສົ່ງຊຸດຂອງຄຳສັ່ງໄປຫາເຄື່ອງລູກຂ່າຍເປົ້າໝາຍ, ມັນຈະສົ່ງໃຫ້ຕາມຈຳນວນເຄື່ອງລູກຂ່າຍທີ່ກຳນົດໄວ້ໃນພາລາມິເຕີ batch size. ຫຼັງຈາກໝົດໄລຍະເວລາລໍຖ້າທີ່ລະບຸ, ຄຳສັ່ງຈະຖືກສົ່ງໄປຫາເຄື່ອງລູກຂ່າຍຊຸດຖັດໄປ. ຈຳນວນເຄື່ອງລູກຂ່າຍໃນແຕ່ລະຊຸດຖັດມາຈະເທົ່າກັບຈຳນວນເຄື່ອງລູກຂ່າຍທີ່ເຮັດວຽກສຳເລັດແລ້ວໃນຊຸດກ່ອນໜ້າ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-rate-limiting.adoc:8
msgid ""
"Choosing a lower batch size will reduce system load and parallelism, but "
"might reduce overall performance for processing actions."
msgstr "ການເລືອກຂະໜາດ batch size ທີ່ຕ່ຳລົງຈະຊ່ວຍຫຼຸດພາລະຂອງລະບົບ ແລະ ການເຮັດວຽກແບບຂະໜານ, ແຕ່ອາດຈະຫຼຸດປະສິດທິພາບໂດຍລວມໃນການປະມວນຜົນຄຳສັ່ງ."

#.  Defaulte is 200 according to salt-large-scale-tuning.adoc
#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-rate-limiting.adoc:9
msgid ""
"The batch size parameter sets the maximum number of clients that can execute "
"a single action at the same time.  Adjust the "
"[systemitem]``java.salt_batch_size`` parameter."
msgstr "ພາລາມິເຕີ batch size ຈະກຳນົດຈຳນວນເຄື່ອງລູກຂ່າຍສູງສຸດທີ່ສາມາດເຮັດວຽກດຽວກັນພ້ອມໆກັນໄດ້. ປັບຄ່າໄດ້ທີ່ພາລາມິເຕີ [systemitem]``java.salt_batch_size``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-rate-limiting.adoc:10
msgid "Defaults to 200."
msgstr "ຄ່າເລີ່ມຕົ້ນແມ່ນ 200."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-rate-limiting.adoc:11
msgid ""
"Increasing the delay increases the chance that multiple clients will have "
"completed before the next action is issued (more clients are grouped "
"together in subsequent batches), resulting in fewer overall commands, and "
"reducing load."
msgstr "ການເພີ່ມໄລຍະເວລາລໍຖ້າຈະຊ່ວຍເພີ່ມໂອກາດທີ່ເຄື່ອງລູກຂ່າຍຫຼາຍເຄື່ອງຈະເຮັດວຽກສຳເລັດກ່ອນທີ່ຄຳສັ່ງຖັດໄປຈະຖືກສົ່ງອອກ (ມີເຄື່ອງລູກຂ່າຍລວມກຸ່ມກັນຫຼາຍຂຶ້ນໃນຊຸດຖັດໄປ), ເຮັດໃຫ້ມີຈຳນວນຄຳສັ່ງໂດຍລວມໜ້ອຍລົງ ແລະ ຫຼຸດພາລະຂອງລະບົບ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-rate-limiting.adoc:12
msgid ""
"The batch delay parameter sets the amount of time, in seconds, to wait after "
"a command from the previous batch is processed before beginning to process "
"the command on the next client.  Adjust the "
"[systemitem]``java.salt_batch_delay`` parameter.  Defaults to 1.0 seconds."
msgstr "ພາລາມິເຕີ batch delay ກຳນົດໄລຍະເວລາເປັນວິນາທີທີ່ຈະລໍຖ້າຫຼັງຈາກຄຳສັ່ງຈາກຊຸດກ່ອນໜ້າຖືກປະມວນຜົນ ແລ້ວຈຶ່ງເລີ່ມປະມວນຜົນຄຳສັ່ງໃນເຄື່ອງລູກຂ່າຍຖັດໄປ. ປັບຄ່າໄດ້ທີ່ພາລາມິເຕີ [systemitem]``java.salt_batch_delay``. ຄ່າເລີ່ມຕົ້ນແມ່ນ 1.0 ວິນາທີ."

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-rate-limiting.adoc:13
#, no-wrap
msgid "Disabling the Salt Mine"
msgstr "ການປິດໃຊ້ງານ Salt Mine"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-rate-limiting.adoc:14
msgid ""
"In older versions, {productname} used a tool called Salt mine to check "
"client availability.  The Salt mine would cause clients to contact the "
"server every hour, which created significant load.  With the introduction of "
"a more efficient mechanism in {productname}{nbsp}3.2, the Salt mine is no "
"longer required.  Instead, the {productname} Server uses Taskomatic to ping "
"only the clients that appear to have been offline for twelve hours or more, "
"with all clients being contacted at least once in every twenty four hour "
"period by default.  You can adjust this by changing the "
"[systemitem]``web.system_checkin_threshold`` parameter in "
"[path]``rhn.conf``.  The value is expressed in days, and the default value "
"is [literal]``1``."
msgstr "ໃນເວີຊັນເກົ່າ, {productname} ໃຊ້ເຄື່ອງມືທີ່ຊື່ວ່າ Salt mine ເພື່ອກວດສອບການເຊື່ອມຕໍ່ຂອງລູກຂ່າຍ. Salt mine ຈະເຮັດໃຫ້ລູກຂ່າຍຕິດຕໍ່ຫາເຊີເວີທຸກໆຊົ່ວໂມງ, ເຊິ່ງເຮັດໃຫ້ເກີດ load ຫຼາຍ. ດ້ວຍການນຳໃຊ້ກົນໄກທີ່ມີປະສິດທິພາບກວ່າໃນ {productname}{nbsp}3.2, Salt mine ຈຶ່ງບໍ່ຈຳເປັນອີກຕໍ່ໄປ. ແທນທີ່ຈະເຮັດແນວນັ້ນ, {productname} Server ຈະໃຊ້ Taskomatic ເພື່ອ ping ຫາສະເພາະລູກຂ່າຍທີ່ເບິ່ງຄືວ່າ offline ເປັນເວລາ 12 ຊົ່ວໂມງ ຫຼື ຫຼາຍກວ່າ, ໂດຍລູກຂ່າຍທັງໝົດຈະຖືກຕິດຕໍ່ຢ່າງໜ້ອຍໜຶ່ງຄັ້ງໃນທຸກໆ 24 ຊົ່ວໂມງໂດຍຄ່າເລີ່ມຕົ້ນ. ເຈົ້າສາມາດປັບຄ່ານີ້ໄດ້ໂດຍການປ່ຽນພາຣາມີເຕີ [systemitem]``web.system_checkin_threshold`` ໃນ [path]``rhn.conf``. ຄ່າແມ່ນກຳນົດເປັນຈຳນວນມື້, ແລະ ຄ່າເລີ່ມຕົ້ນແມ່ນ [literal]``1``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-rate-limiting.adoc:15
msgid ""
"Newly registered Salt clients will have the Salt mine disabled by default.  "
"If the Salt mine is running on your system, you can reduce load by disabling "
"it.  This is especially effective if you have a large number of clients."
msgstr "ລູກຂ່າຍ Salt ທີ່ລົງທະບຽນໃໝ່ຈະຖືກປິດໃຊ້ງານ Salt mine ໂດຍຄ່າເລີ່ມຕົ້ນ. ຖ້າ Salt mine ກຳລັງເຮັດວຽກຢູ່ໃນລະບົບຂອງເຈົ້າ, ເຈົ້າສາມາດຫຼຸດ load ໄດ້ໂດຍການປິດມັນ. ສິ່ງນີ້ຈະເຫັນຜົນຊັດເຈນຖ້າເຈົ້າມີລູກຂ່າຍຈຳນວນຫຼາຍ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-rate-limiting.adoc:16
msgid "Disable the Salt mine by running this command on the server:"
msgstr "ປິດ Salt mine ໂດຍການລັນຄຳສັ່ງນີ້ໃນເຊີເວີ:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-rate-limiting.adoc:18
msgid ""
"This will restart the clients and generate some Salt events to be processed "
"by the server.  If you have a large number of clients, handling these events "
"could create excessive load.  To avoid this, you can execute the command in "
"batch mode with this command:"
msgstr "ສິ່ງນີ້ຈະເລີ່ມການເຮັດວຽກຂອງລູກຂ່າຍໃໝ່ ແລະ ສ້າງເຫດການ Salt ບາງຢ່າງເພື່ອໃຫ້ເຊີເວີປະມວນຜົນ. ຖ້າເຈົ້າມີລູກຂ່າຍຈຳນວນຫຼາຍ, ການຈັດການເຫດການເຫຼົ່ານີ້ອາດຈະເຮັດໃຫ້ເກີດ load ຫຼາຍເກີນໄປ. ເພື່ອຫຼີກເວັ້ນບັນຫານີ້, ເຈົ້າສາມາດລັນຄຳສັ່ງໃນໂໝດ batch ດ້ວຍຄຳສັ່ງນີ້:"

#. type: Title =
#: modules/specialized-guides/pages/salt/salt-scaling-minions.adoc:1
#, no-wrap
msgid "Scaling Minions (Large Scale Deployments)"
msgstr "ການຂະຫຍາຍຈຳນວນ Minions (ສຳລັບການຕິດຕັ້ງລະບົບຂະໜາດໃຫຍ່)"

#. type: Title =
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:1
#, no-wrap
msgid "Salt SSH"
msgstr "Salt SSH"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:2
msgid ""
"Salt SSH allows Salt commands and states to be issued directly over SSH.  "
"SSH connections are created on demand, when the server executes an action on "
"a client."
msgstr "Salt SSH ຊ່ວຍໃຫ້ສາມາດສົ່ງຄຳສັ່ງ ແລະ states ຂອງ Salt ຜ່ານ SSH ໄດ້ໂດຍກົງ. ການເຊື່ອມຕໍ່ SSH ຈະຖືກສ້າງຂຶ້ນຕາມຄວາມຕ້ອງການ, ເມື່ອເຊີເວີສັ່ງໃຫ້ເຮັດວຽກໃນເຄື່ອງລູກຂ່າຍ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:3
msgid ""
"For more information about Salt SSH, see "
"https://docs.saltproject.io/en/latest/topics/ssh/."
msgstr "ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບ Salt SSH, ໃຫ້ເບິ່ງທີ່ https://docs.saltproject.io/en/latest/topics/ssh/."

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:4
#, no-wrap
msgid "SSH Connection Methods"
msgstr "ວິທີການເຊື່ອມຕໍ່ SSH"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:5
msgid ""
"In {productname} there are two SSH connection methods, `ssh-push` and "
"`ssh-push-tunnel`.  In both methods the server initiates an SSH connection "
"to the client to execute a Salt call."
msgstr "ໃນ {productname} ມີສອງວິທີການເຊື່ອມຕໍ່ SSH ຄື: `ssh-push` ແລະ `ssh-push-tunnel`. ໃນທັງສອງວິທີ, ເຊີເວີຈະເປັນຜູ້ເລີ່ມຕົ້ນການເຊື່ອມຕໍ່ SSH ໄປຫາເຄື່ອງລູກຂ່າຍເພື່ອຮຽກໃຊ້ Salt."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:6
msgid ""
"In the `ssh-push` method, the package manager works as normal, and the HTTP "
"or HTTPS connection is directly created."
msgstr "ໃນວິທີ `ssh-push`, ຕົວຈັດການແພັກເກັດຈະເຮັດວຽກຕາມປົກກະຕິ, ແລະ ການເຊື່ອມຕໍ່ HTTP ຫຼື HTTPS ຈະຖືກສ້າງຂຶ້ນໂດຍກົງ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:7
msgid ""
"In the `ssh-push-tunnel` method, the server creates an HTTP or HTTPS "
"connection through an SSH tunnel.  The HTTP connection initiated by the "
"package manager is redirected through the tunnel using `/etc/hosts` "
"aliasing.  Use this method for in-place firewall environments that block "
"HTTP or HTTPS connections between server and client."
msgstr "ໃນວິທີ `ssh-push-tunnel`, ເຊີເວີຈະສ້າງການເຊື່ອມຕໍ່ HTTP ຫຼື HTTPS ຜ່ານທໍ່ SSH (SSH tunnel). ການເຊື່ອມຕໍ່ HTTP ທີ່ເລີ່ມຕົ້ນໂດຍຕົວຈັດການແພັກເກັດຈະຖືກປ່ຽນເສັ້ນທາງຜ່ານທໍ່ SSH ໂດຍໃຊ້ການຕັ້ງຊື່ແຝງ (aliasing) ໃນ `/etc/hosts`. ໃຊ້ວິທີນີ້ສຳລັບສະພາບແວດລ້ອມທີ່ມີໄຟວໍ (firewall) ປິດກັ້ນການເຊື່ອມຕໍ່ HTTP ຫຼື HTTPS ລະຫວ່າງເຊີເວີ ແລະ ເຄື່ອງລູກຂ່າຍ."

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:8
#, no-wrap
msgid "Salt SSH Integration"
msgstr "ການເຮັດວຽກຮ່ວມກັນຂອງ Salt SSH (Salt SSH Integration)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:9
msgid "As with all Salt calls, {productname} invokes `salt-ssh` via the `salt-api`."
msgstr "ເຊັ່ນດຽວກັນກັບການຮຽກໃຊ້ Salt ທັງໝົດ, {productname} ຈະຮຽກໃຊ້ `salt-ssh` ຜ່ານ `salt-api`."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:10
msgid ""
"Salt SSH relies on a roster to obtain details such as hostname, ports, and "
"the SSH parameters of a client.  {productname} keeps these details in the "
"database and makes them available to Salt SSH by using the "
"[literal]``uyuni`` roster module, or by generating a temporary roster file "
"on bootstrapping new clients with the {webui}.  The location of the "
"temporary roster file is supplied to Salt SSH using the "
"[option]``roster-file`` option.  For the registered clients "
"[option]``roster`` set to `uyuni` is used instead to get the roster from the "
"database with `uyuni` salt roster module."
msgstr "Salt SSH ອາໄສ roster ເພື່ອຂໍຂໍ້ມູນລາຍລະອຽດ ເຊັ່ນ: ຊື່ໂຮສ (hostname), ພອດ (ports), ແລະ ພາລາມິເຕີ SSH ຂອງເຄື່ອງລູກຂ່າຍ. {productname} ຈະຈັດເກັບລາຍລະອຽດເຫຼົ່ານີ້ໄວ້ໃນຖານຂໍ້ມູນ ແລະ ເຮັດໃຫ້ Salt SSH ສາມາດນຳໃຊ້ໄດ້ໂດຍຜ່ານ roster module [literal]``uyuni``, ຫຼື ໂດຍການສ້າງໄຟລ໌ roster ຊົ່ວຄາວໃນລະຫວ່າງການ bootstrap ເຄື່ອງລູກຂ່າຍໃໝ່ຜ່ານ {webui}. ທີ່ຕັ້ງຂອງໄຟລ໌ roster ຊົ່ວຄາວຈະຖືກສົ່ງໃຫ້ Salt SSH ໂດຍໃຊ້ຕົວເລືອກ [option]``roster-file``. ສຳລັບເຄື່ອງລູກຂ່າຍທີ່ລົງທະບຽນແລ້ວ, ຕົວເລືອກ [option]``roster`` ທີ່ຕັ້ງເປັນ `uyuni` ຈະຖືກນຳໃຊ້ແທນເພື່ອດຶງຂໍ້ມູນ roster ຈາກຖານຂໍ້ມູນດ້ວຍ `uyuni` salt roster module."

#. type: delimited block =
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:11
msgid ""
"It is not recommended to run [command]``salt-ssh`` as [literal]``root`` "
"user. This can cause permission issues the next time {productname} tries to "
"use Salt SSH.  Use [command]``mgr-salt-ssh``, which changes the effective "
"user to [literal]``salt`` and avoids file permission issues.  If you want to "
"use [command]``mgr-salt-ssh`` with a user other than [literal]``root``, the "
"user should have the permission to change effective user to "
"[literal]``salt``."
msgstr "ບໍ່ແນະນຳໃຫ້ໃຊ້ຄຳສັ່ງ [command]``salt-ssh`` ໃນນາມຜູ້ໃຊ້ [literal]``root``. ເພາະອາດເຮັດໃຫ້ເກີດບັນຫາເລື່ອງສິດການເຂົ້າເຖິງໃນຄັ້ງຖັດໄປທີ່ {productname} ພະຍາຍາມໃຊ້ Salt SSH. ໃຫ້ໃຊ້ [command]``mgr-salt-ssh`` ແທນ, ເຊິ່ງຈະປ່ຽນຜູ້ໃຊ້ທີ່ໃຊ້ງານຈິງເປັນ [literal]``salt`` ແລະ ຊ່ວຍຫຼີກເວັ້ນບັນຫາເລື່ອງສິດຂອງໄຟລ໌. ຫາກເຈົ້າຕ້ອງການໃຊ້ [command]``mgr-salt-ssh`` ດ້ວຍຜູ້ໃຊ້ອື່ນທີ່ບໍ່ແມ່ນ [literal]``root``, ຜູ້ໃຊ້ນັ້ນຕ້ອງມີສິດໃນການປ່ຽນຜູ້ໃຊ້ທີ່ໃຊ້ງານຈິງເປັນ [literal]``salt``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:12
msgid ""
"[command]``mgr-salt-ssh`` uses [option]``roster`` set to [literal]``uyuni`` "
"by default, if neither [option]``roster`` nor [option]``roster-file`` "
"specified in the command line.  It helps to call Salt commands to the "
"registered Salt SSH clients with no roster file generation."
msgstr "[command]``mgr-salt-ssh`` ໃຊ້ [option]``roster`` ທີ່ຕັ້ງເປັນ [literal]``uyuni`` ໂດຍເລີ່ມຕົ້ນ, ຫາກບໍ່ມີການລະບຸ [option]``roster`` ຫຼື [option]``roster-file`` ໃນໜ້າຕ່າງຄຳສັ່ງ. ມັນຊ່ວຍໃນການຮຽກໃຊ້ຄຳສັ່ງ Salt ໄປຫາເຄື່ອງລູກຂ່າຍ Salt SSH ທີ່ລົງທະບຽນແລ້ວ ໂດຍບໍ່ຕ້ອງສ້າງໄຟລ໌ roster ໃໝ່."

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:13
#, no-wrap
msgid "Authentication"
msgstr "ການຢັ້ງຢືນຕົວຕົນ (Authentication)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:14
msgid ""
"Salt SSH supports both password and key authentication.  {productname} uses "
"both methods:"
msgstr "Salt SSH ຮອງຮັບທັງການຢັ້ງຢືນຕົວຕົນດ້ວຍລະຫັດຜ່ານ ແລະ ດ້ວຍຄູ່ລະຫັດ (key). {productname} ໃຊ້ທັງສອງວິທີຄື:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:15
msgid ""
"Password authentication is used only when bootstrapping.  During the "
"bootstrap step the key of the server is not authorized on the client and "
"therefore a password must be used for a connection to be made.  The password "
"is used transiently in a temporary roster file used for bootstrapping and "
"the roster file is removed on finishing processing the event.  This password "
"is not stored."
msgstr "ການຢັ້ງຢືນຕົວຕົນດ້ວຍລະຫັດຜ່ານຈະຖືກໃຊ້ສະເພາະໃນລະຫວ່າງການ bootstrapping ເທົ່ານັ້ນ. ໃນຂັ້ນຕອນ bootstrap, ຄູ່ລະຫັດຂອງເຊີເວີຍັງບໍ່ທັນໄດ້ຮັບອະນຸຍາດໃນເຄື່ອງລູກຂ່າຍ, ດັ່ງນັ້ນຈຶ່ງຕ້ອງໃຊ້ລະຫັດຜ່ານເພື່ອສ້າງການເຊື່ອມຕໍ່. ລະຫັດຜ່ານນີ້ຈະຖືກໃຊ້ພຽງຊົ່ວຄາວໃນໄຟລ໌ roster ຊົ່ວຄາວສຳລັບການ bootstrap ແລະ ໄຟລ໌ roster ຈະຖືກລົບອອກເມື່ອຂະບວນການສຳເລັດ. ລະຫັດຜ່ານນີ້ຈະບໍ່ຖືກຈັດເກັບໄວ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:16
msgid ""
"All other common Salt calls use key authentication.  During the bootstrap "
"step the SSH key of the server is authorized on the client and added to the "
"client [path]``/.ssh/authorized_keys`` file.  Subsequent calls no longer "
"require a password."
msgstr "ການຮຽກໃຊ້ Salt ທົ່ວໄປອື່ນໆທັງໝົດຈະໃຊ້ການຢັ້ງຢືນຕົວຕົນດ້ວຍຄູ່ລະຫັດ. ໃນລະຫວ່າງຂັ້ນຕອນ bootstrap, ລະຫັດ SSH ຂອງເຊີເວີຈະໄດ້ຮັບອະນຸຍາດໃນເຄື່ອງລູກຂ່າຍ ແລະ ຖືກເພີ່ມເຂົ້າໃນໄຟລ໌ [path]``/.ssh/authorized_keys`` ຂອງເຄື່ອງລູກຂ່າຍ. ການຮຽກໃຊ້ໃນຄັ້ງຕໍ່ໆໄປກໍຈະບໍ່ຈຳເປັນຕ້ອງໃຊ້ລະຫັດຜ່ານອີກ."

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:17
#, no-wrap
msgid "User Account"
msgstr "ບັນຊີຜູ້ໃຊ້"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:18
msgid ""
"The user for Salt SSH calls made by {productname} is taken from the "
"`ssh_push_sudo_user` setting.  By default, the user is root."
msgstr "ຜູ້ໃຊ້ສຳລັບການຮຽກໃຊ້ Salt SSH ໂດຍ {productname} ແມ່ນເອົາມາຈາກການຕັ້ງຄ່າ `ssh_push_sudo_user`. ໂດຍເລີ່ມຕົ້ນ, ຜູ້ໃຊ້ແມ່ນ root."

#. type: delimited block =
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:19
msgid ""
"If bootstrapping with default settings fail, check whether the client allows "
"root login with ssh."
msgstr "ຫາກການ bootstrap ດ້ວຍຄ່າເລີ່ມຕົ້ນຫຼົ້ມເຫຼວ, ໃຫ້ກວດສອບວ່າເຄື່ອງລູກຂ່າຍອະນຸຍາດໃຫ້ root ລັອກອິນຜ່ານ ssh ຫຼື ບໍ່."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:20
msgid ""
"If the value of `ssh_push_sudo_user` is not root, then the `--sudo` options "
"of `salt-ssh` are used.  For this user you must configure the `NOPASSWD` "
"option in the [path]``sudoers`` file.  At least, set the python binary with "
"the version number; for example:"
msgstr "ຫາກຄ່າຂອງ `ssh_push_sudo_user` ບໍ່ແມ່ນ root, ຕົວເລືອກ `--sudo` ຂອງ `salt-ssh` ຈະຖືກນຳໃຊ້. ສຳລັບຜູ້ໃຊ້ນີ້ ເຈົ້າຕ້ອງຕັ້ງຄ່າຕົວເລືອກ `NOPASSWD` ໃນໄຟລ໌ [path]``sudoers``. ຢ່າງໜ້ອຍ, ໃຫ້ກຳນົດເສັ້ນທາງໄປຫາໄຟລ໌ໄບນາຣີຂອງ python ພ້ອມໝາຍເລກເວີຊັນ; ຕົວຢ່າງ:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:21
#, no-wrap
msgid "<USER> ALL=(ALL) NOPASSWD:/usr/bin/python3.6\n"
msgstr "<USER> ALL=(ALL) NOPASSWD:/usr/bin/python3.6\n"

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:22
#, no-wrap
msgid "HTTP Redirection"
msgstr "ການປ່ຽນເສັ້ນທາງ HTTP (HTTP Redirection)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:23
msgid ""
"The `ssh-push-tunnel` method requires traffic to be redirected through an "
"SSH tunnel.  This allows traffic to bypass firewalls blocking a direct "
"connection between the client and the server."
msgstr "ວິທີ `ssh-push-tunnel` ຮຽກຮ້ອງໃຫ້ມີການປ່ຽນເສັ້ນທາງຂໍ້ມູນຜ່ານທໍ່ SSH. ນີ້ຊ່ວຍໃຫ້ຂໍ້ມູນສາມາດຜ່ານໄຟວໍທີ່ປິດກັ້ນການເຊື່ອມຕໍ່ໂດຍກົງລະຫວ່າງເຄື່ອງລູກຂ່າຍ ແລະ ເຊີເວີໄດ້."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:24
msgid "This is achieved by using port 1233 in the repository URL:"
msgstr "ສາມາດເຮັດໄດ້ໂດຍການໃຊ້ພອດ 1233 ໃນ URL ຂອງຄັງຊອບແວ:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:25
#, no-wrap
msgid "https://suma-server:1233/repourl...\n"
msgstr "https://suma-server:1233/repourl...\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:26
msgid ""
"You can alias the suma-server hostname to [literal]``localhost`` in "
"[path]``/etc/hosts``:"
msgstr "ເຈົ້າສາມາດຕັ້ງຊື່ແຝງ (alias) ໃຫ້ກັບໂຮສ suma-server ເປັນ [literal]``localhost`` ໃນ [path]``/etc/hosts``:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:27
#, no-wrap
msgid "127.0.0.1       localhost    suma-server\n"
msgstr "127.0.0.1       localhost    suma-server\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:28
msgid ""
"The server creates a reverse SSH tunnel that connects `localhost:1233` on "
"the client to `suma-server:443`:"
msgstr "ເຊີເວີຈະສ້າງ reverse SSH tunnel ທີ່ເຊື່ອມຕໍ່ `localhost:1233` ໃນເຄື່ອງລູກຂ່າຍ ໄປຫາ `suma-server:443`:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:29
#, no-wrap
msgid "ssh ... -R 1233:suma-server:443\n"
msgstr "ssh ... -R 1233:suma-server:443\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:30
msgid ""
"This means that the package manager will actually connect to "
"`localhost:1233`, which is then forwarded to `suma-server:443` by the SSH "
"tunnel."
msgstr "ນັ້ນໝາຍຄວາມວ່າ ຕົວຈັດການແພັກເກັດຈະເຊື່ອມຕໍ່ໄປຫາ `localhost:1233` ແທ້ໆ, ເຊິ່ງຈາກນັ້ນຈະຖືກສົ່ງຕໍ່ໄປຫາ `suma-server:443` ໂດຍທໍ່ SSH."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:31
msgid ""
"The package manager can contact the server only if the tunnel is open, which "
"occurs only when the server executes an action on the client."
msgstr "ຕົວຈັດການແພັກເກັດຈະສາມາດຕິດຕໍ່ກັບເຊີເວີໄດ້ກໍຕໍ່ເມື່ອທໍ່ SSH ເປີດຢູ່ເທົ່ານັ້ນ, ເຊິ່ງຈະເກີດຂຶ້ນກໍຕໍ່ເມື່ອເຊີເວີສັ່ງໃຫ້ເຮັດວຽກໃນເຄື່ອງລູກຂ່າຍ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:32
msgid ""
"Manual package manager operations that require server connectivity are not "
"possible in this case."
msgstr "ໃນກໍລະນີນີ້, ການຈັດການແພັກເກັດດ້ວຍມືທີ່ຕ້ອງມີການເຊື່ອມຕໍ່ກັບເຊີເວີຈະບໍ່ສາມາດເຮັດໄດ້."

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:33
#, no-wrap
msgid "Call Sequence"
msgstr "ລຳດັບການຮຽກໃຊ້ (Call Sequence)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:34
msgid "Salt SSH calls run in this sequence:"
msgstr "ການຮຽກໃຊ້ Salt SSH ຈະເຮັດວຽກຕາມລຳດັບດັ່ງນີ້:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:35
msgid ""
"Set `roster` parameter to `uyuni` for registered clients or prepare the Salt "
"roster on bootstrapping for the call"
msgstr "ຕັ້ງພາລາມິເຕີ `roster` ເປັນ `uyuni` ສຳລັບເຄື່ອງລູກຂ່າຍທີ່ລົງທະບຽນແລ້ວ ຫຼື ກຽມ Salt roster ໃນລະຫວ່າງການ bootstrap ສຳລັບການຮຽກໃຊ້"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:36
msgid ""
"Create remote port forwarding option if the contact method is "
"`ssh-push-tunnel`"
msgstr "ສ້າງຕົວເລືອກການສົ່ງຕໍ່ພອດທາງໄກ (remote port forwarding) ຫາກວິທີການຕິດຕໍ່ແມ່ນ `ssh-push-tunnel`"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:37
msgid "Compute the `ProxyCommand` if the client is connected through a proxy"
msgstr "ຄຳນວນ `ProxyCommand` ຫາກເຄື່ອງລູກຂ່າຍເຊື່ອມຕໍ່ຜ່ານພຣັອກຊີ (proxy)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:38
msgid "Create Roster content"
msgstr "ສ້າງເນື້ອໃນຂອງ Roster"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:39
msgid "Create a temporary roster file (only in case of bootstrapping new client)"
msgstr "ສ້າງໄຟລ໌ roster ຊົ່ວຄາວ (ສະເພາະໃນກໍລະນີ bootstrap ເຄື່ອງລູກຂ່າຍໃໝ່)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:40
msgid "Execute a synchronous `salt-ssh` call using the API"
msgstr "ສັ່ງໃຫ້ເຮັດວຽກ `salt-ssh` ແບບຊິງໂຄຣນັດ (synchronous) ໂດຍໃຊ້ API"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:41
msgid "Remove the temporary roster file (only in case of bootstrapping new client)"
msgstr "ລົບໄຟລ໌ roster ຊົ່ວຄາວອອກ (ສະເພາະໃນກໍລະນີ bootstrap ເຄື່ອງລູກຂ່າຍໃໝ່)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:42
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:80
msgid "The roster content contains:"
msgstr "ເນື້ອໃນຂອງ roster ປະກອບດ້ວຍ:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:43
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:81
msgid "`hostname`"
msgstr "`hostname`"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:44
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:82
msgid "`user`"
msgstr "`user`"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:45
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:84
msgid "`port`"
msgstr "`port`"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:46
msgid "`remote_port_forwards`: The remote port forwarding SSH option"
msgstr "`remote_port_forwards`: ຕົວເລືອກການສົ່ງຕໍ່ພອດ SSH ທາງໄກ"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:47
msgid "`ssh_options`: Other ssh options:"
msgstr "`ssh_options`: ຕົວເລືອກ ssh ອື່ນໆ:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:48
msgid "`ProxyCommand`: If the client connects through a proxy"
msgstr "`ProxyCommand`: ຫາກເຄື່ອງລູກຂ່າຍເຊື່ອມຕໍ່ຜ່ານພຣັອກຊີ"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:49
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:88
msgid "`timeout`: defaults to 180 seconds"
msgstr "`timeout`: ຄ່າເລີ່ມຕົ້ນແມ່ນ 180 ວິນາທີ"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:50
msgid "`minion_opts`:"
msgstr "`minion_opts`:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:51
msgid "`master`: Set to the minion ID if the contact method is `ssh-push-tunnel`"
msgstr "`master`: ຕັ້ງເປັນ minion ID ຫາກວິທີການຕິດຕໍ່ແມ່ນ `ssh-push-tunnel`"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:52
msgid ""
"`ssh_pre_flight`: The path to the shell script executed on the client before "
"running any Salt command"
msgstr "`ssh_pre_flight`: ເສັ້ນທາງໄປຫາສະຄຣິບທ໌ເຊວ (shell script) ທີ່ເຮັດວຽກຢູ່ເທິງລູກຂ່າຍ ກ່ອນການລັນຄຳສັ່ງ Salt ໃດໆ"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:53
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:90
msgid ""
"`ssh_pre_flight_args`: The list of arguments to call the pre flight script "
"on the client"
msgstr "`ssh_pre_flight_args`: ລາຍການພາຣາມິເຕີ (arguments) ເພື່ອເອີ້ນໃຊ້ສະຄຣິບທ໌ pre-flight ຢູ່ເທິງລູກຂ່າຍ"

#. type: Title ==
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:54
#, no-wrap
msgid "Bootstrap Sequence"
msgstr "ລຳດັບການບູດສະແຕຣັບ (Bootstrap Sequence)"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:55
msgid ""
"This section describes the sequence of events when clients are registered to "
"a Salt master.  While bootstrapping is a type of Salt SSH call, the sequence "
"differs slightly from regular SSH calls."
msgstr "ພາກສ່ວນນີ້ອະທິບາຍກ່ຽວກັບລຳດັບເຫດການ ເມື່ອລູກຂ່າຍຖືກລົງທະບຽນເຂົ້າກັບ Salt master. ໃນຂະນະທີ່ການບູດສະແຕຣັບແມ່ນການເອີ້ນໃຊ້ Salt SSH ຮູບແບບໜຶ່ງ, ແຕ່ລຳດັບຂັ້ນຕອນຈະແຕກຕ່າງຈາກການເອີ້ນໃຊ້ SSH ປົກກະຕິເລັກນ້ອຍ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:56
msgid ""
"Bootstrapping uses Salt SSH for communication between the master and the "
"client.  This happens for both regular and SSH clients."
msgstr "ການບູດສະແຕຣັບໃຊ້ Salt SSH ສຳລັບການສື່ສານລະຫວ່າງ master ແລະ ລູກຂ່າຍ. ສິ່ງນີ້ເກີດຂຶ້ນທັງກັບລູກຂ່າຍແບບປົກກະຕິ ແລະ ລູກຂ່າຍ SSH."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:57
msgid ""
"For a regular Salt client, generate and pre-authorize the Salt key of the "
"client."
msgstr "ສຳລັບລູກຂ່າຍ Salt ປົກກະຕິ, ໃຫ້ສ້າງ ແລະ ອະນຸມັດຄີ Salt ຂອງລູກຂ່າຍໄວ້ລ່ວງໜ້າ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:58
msgid ""
"For an SSH client, if a proxy was selected, retrieve the SSH public key of "
"the proxy using the ``mgrutil.chain_ssh_cmd`` runner."
msgstr "ສຳລັບລູກຂ່າຍ SSH, ຖ້າຫາກມີການເລືອກພຣັອກຊີ (proxy), ໃຫ້ດຶງເອົາຄີສາທາລະນະ SSH ຂອງພຣັອກຊີ ໂດຍໃຊ້ຕົວລັນ ``mgrutil.chain_ssh_cmd``."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:59
msgid ""
"The runner copies the public key of the proxy to the server using SSH.  If "
"needed, it can chain multiple SSH commands to reach the proxy across "
"multiple hops."
msgstr "ຕົວລັນຈະກັອບປີ້ຄີສາທາລະນະຂອງພຣັອກຊີໄປຫາເຊີເວີໂດຍໃຊ້ SSH. ຖ້າຈຳເປັນ, ມັນສາມາດເຊື່ອມຕໍ່ຄຳສັ່ງ SSH ຫຼາຍຄຳສັ່ງ ເພື່ອເຂົ້າຫາພຣັອກຊີຜ່ານຫຼາຍຈຸດເຊື່ອມຕໍ່ (multiple hops)."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:60
msgid "Generate pillar data for bootstrap."
msgstr "ສ້າງຂໍ້ມູນ pillar ສຳລັບການບູດສະແຕຣັບ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:61
msgid ""
"The pillar data is compiled and stored on the Salt master, and retrieved by "
"the client."
msgstr "ຂໍ້ມູນ pillar ຈະຖືກປະມວນຜົນ ແລະ ເກັບໄວ້ຢູ່ເທິງ Salt master, ແລະ ຖືກດຶງໄປໃຊ້ໂດຍລູກຂ່າຍ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:62
msgid "Generate the roster for bootstrapping into a temporary file on the client."
msgstr "ສ້າງບັນຊີລາຍຊື່ (roster) ສຳລັບການບູດສະແຕຣັບ ລົງໃນໄຟລ໌ຊົ່ວຄາວຢູ່ເທິງລູກຂ່າຍ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:63
msgid "You can use the roster by passing it to the Salt API, with this command:"
msgstr "ທ່ານສາມາດໃຊ້ roster ໄດ້ໂດຍການສົ່ງມັນໄປຫາ Salt API ດ້ວຍຄຳສັ່ງນີ້:"

#. type: delimited block -
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:64
#, no-wrap
msgid ""
"mgr-salt-ssh --roster-file=<temporary_bootstrap_roster> minion state.apply "
"certs,<bootstrap_state>`\n"
msgstr "mgr-salt-ssh --roster-file=<temporary_bootstrap_roster> minion state.apply certs,<bootstrap_state>`\n"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:65
msgid ""
"For `bootstrap_state`, use `bootstrap` for regular clients or "
"`ssh_bootstrap` for SSH clients."
msgstr "ສຳລັບ `bootstrap_state`, ໃຫ້ໃຊ້ `bootstrap` ສຳລັບລູກຂ່າຍປົກກະຕິ ຫຼື `ssh_bootstrap` ສຳລັບລູກຂ່າຍ SSH."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:66
msgid ""
"The way the client retrieves the pillar data depends on the contact method "
"you have chosen for your client:"
msgstr "ວິທີທີ່ລູກຂ່າຍດຶງຂໍ້ມູນ pillar ແມ່ນຂຶ້ນກັບວິທີການຕິດຕໍ່ (contact method) ທີ່ທ່ານເລືອກໄວ້ສຳລັບລູກຂ່າຍຂອງທ່ານ:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:67
msgid ""
"If you are using the `ssh-push-tunnel` contact method, ensure you have "
"completed the remote port forwarding option."
msgstr "ຖ້າທ່ານໃຊ້ວິທີການຕິດຕໍ່ແບບ `ssh-push-tunnel`, ໃຫ້ແນ່ໃຈວ່າທ່ານໄດ້ຕັ້ງຄ່າຕົວເລືອກການສົ່ງຕໍ່ພອດທາງໄກ (remote port forwarding) ແລ້ວ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:68
msgid ""
"If the client connects through a proxy, ensure you have completed the "
"`ProxyCommand` option."
msgstr "ຖ້າລູກຂ່າຍເຊື່ອມຕໍ່ຜ່ານພຣັອກຊີ, ໃຫ້ແນ່ໃຈວ່າທ່ານໄດ້ຕັ້ງຄ່າຕົວເລືອກ `ProxyCommand` ແລ້ວ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:69
msgid ""
"This depends on your proxy configuration, including how many proxies you "
"need to connect through."
msgstr "ສິ່ງນີ້ຂຶ້ນກັບການຕັ້ງຄ່າພຣັອກຊີຂອງທ່ານ, ລວມທັງຈຳນວນພຣັອກຊີທີ່ທ່ານຕ້ອງເຊື່ອມຕໍ່ຜ່ານ."

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:70
msgid "Pillar data contains:"
msgstr "ຂໍ້ມູນ Pillar ປະກອບມີ:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:71
msgid "mgr_server: The hostname of the Salt master"
msgstr "mgr_server: ຊື່ໂຮສ (hostname) ຂອງ Salt master"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:72
msgid "mgr_origin_server: The hostname of the {productname} Server"
msgstr "mgr_origin_server: ຊື່ໂຮສ ຂອງເຊີເວີ {productname}"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:73
msgid "minion_id: The hostname of the client to bootstrap"
msgstr "minion_id: ຊື່ໂຮສ ຂອງລູກຂ່າຍທີ່ຈະບູດສະແຕຣັບ"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:74
msgid "contact_method: The connection type"
msgstr "contact_method: ຮູບແບບການເຊື່ອມຕໍ່"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:75
msgid "mgr_sudo_user: The user for `salt-ssh`"
msgstr "mgr_sudo_user: ຜູ້ໃຊ້ສຳລັບ `salt-ssh`"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:76
msgid "activation_key: If selected"
msgstr "activation_key: ຖ້າມີການເລືອກໄວ້"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:77
msgid "minion_pub: The pre-authorized public client key"
msgstr "minion_pub: ຄີສາທາລະນະຂອງລູກຂ່າຍທີ່ໄດ້ຮັບການອະນຸມັດໄວ້ລ່ວງໜ້າ"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:78
msgid "minion_pem: The pre-authorized private client key"
msgstr "minion_pem: ຄີສ່ວນຕົວຂອງລູກຂ່າຍທີ່ໄດ້ຮັບການອະນຸມັດໄວ້ລ່ວງໜ້າ"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:79
msgid ""
"proxy_pub_key: The public SSH key that was retrieved from the proxy if the "
"target is an SSH client and a proxy was selected"
msgstr "proxy_pub_key: ຄີສາທາລະນະ SSH ທີ່ດຶງມາຈາກພຣັອກຊີ ຖ້າຫາກເປົ້າໝາຍແມ່ນລູກຂ່າຍ SSH ແລະ ມີການເລືອກພຣັອກຊີໄວ້"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:85
msgid "`remote_port_forwards`: the remote port forwarding SSH option"
msgstr "`remote_port_forwards`: ຕົວເລືອກ SSH ສຳລັບການສົ່ງຕໍ່ພອດທາງໄກ"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:86
msgid "`ssh_options`: other SSH options:"
msgstr "`ssh_options`: ຕົວເລືອກ SSH ອື່ນໆ:"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:87
msgid "`ProxyCommand` if the client connects through a proxy"
msgstr "`ProxyCommand` ຖ້າລູກຂ່າຍເຊື່ອມຕໍ່ຜ່ານພຣັອກຊີ"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:89
msgid ""
"`ssh_pre_flight`: The path to the pre flight shell script (default: "
"[path]``/usr/share/susemanager/salt-ssh/preflight.sh``)"
msgstr "`ssh_pre_flight`: ເສັ້ນທາງໄປຫາສະຄຣິບທ໌ pre-flight shell (ຄ່າເລີ່ມຕົ້ນ: [path]``/usr/share/susemanager/salt-ssh/preflight.sh``)"

#. type: Plain text
