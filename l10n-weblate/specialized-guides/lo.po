msgstr "mgr_sudo_user: ຜູ້ໃຊ້ສຳລັບ `salt-ssh`"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:76
msgid "activation_key: If selected"
msgstr "activation_key: ຖ້າຫາກເລືອກໄວ້"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:77
msgid "minion_pub: The pre-authorized public client key"
msgstr "minion_pub: ກະແຈສາທາລະນະຂອງເຄື່ອງລູກຂ່າຍທີ່ໄດ້ຮັບການອະນຸຍາດໄວ້ລ່ວງໜ້າ"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:78
msgid "minion_pem: The pre-authorized private client key"
msgstr "minion_pem: ກະແຈສ່ວນຕົວຂອງເຄື່ອງລູກຂ່າຍທີ່ໄດ້ຮັບການອະນຸຍາດໄວ້ລ່ວງໜ້າ"

#. type: Plain text
#: modules/specialized-guides/pages/salt/salt-ssh.adoc:79
msgid ""
"proxy_pub_key: The public SSH key that was retrieved from the proxy if the "
