#. type: Plain text
#: en/modules/specialized-guides/pages/salt/salt-formula-liberate.adoc:37
msgid "EL9: `EL9-Pool for x86_64`"
msgstr "EL9: `EL9-Pool for x86_64`"

#. type: Labeled list
#: en/modules/specialized-guides/pages/salt/salt-formula-liberate.adoc:38
#, no-wrap
msgid "Child Channel"
msgstr "ຊ່ອງທາງຍ່ອຍ (Child Channel)"

#. type: Plain text
#: en/modules/specialized-guides/pages/salt/salt-formula-liberate.adoc:39
msgid "Include all child channels."
msgstr "ລວມເອົາຊ່ອງທາງຍ່ອຍທັງໝົດ."

#. type: Labeled list
#: en/modules/specialized-guides/pages/salt/salt-formula-liberate.adoc:40
#, no-wrap
msgid "Add-On system type"
msgstr "ປະເພດລະບົບເສີມ (Add-On system type)"

#. type: Plain text
#: en/modules/specialized-guides/pages/salt/salt-formula-liberate.adoc:41
