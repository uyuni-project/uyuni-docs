"link:https://suse.com/c/new-dawn-for-suse-manager/[New dawn for "
"{productname}]"
msgstr "link:https://suse.com/c/new-dawn-for-suse-manager/[ຍຸກສະໄໝໃໝ່ຂອງ {productname}]"

#. type: Plain text
#: modules/specialized-guides/pages/public-cloud-guide/faq/faq-miscellaneous.adoc:5
msgid "link:https://documentation.suse.com/suma/[documentation.suse.com/suma/]"
msgstr "link:https://documentation.suse.com/suma/[documentation.suse.com/suma/]"

#. type: Title ==
#: modules/specialized-guides/pages/public-cloud-guide/faq/faq-miscellaneous.adoc:6
#, no-wrap
msgid "Where can I find out more about {productname}?"
msgstr "ຂ້ອຍສາມາດສຶກສາເພີ່ມເຕີມກ່ຽວກັບ {productname} ໄດ້ຢູ່ໃສ?"

#. type: Plain text
#: modules/specialized-guides/pages/public-cloud-guide/faq/faq-miscellaneous.adoc:7
