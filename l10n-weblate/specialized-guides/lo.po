msgstr "ປະຫວ່າງໄວ້ທັງໝົດ."

#. type: Labeled list
#: en/modules/specialized-guides/pages/salt/salt-formula-liberate.adoc:42
#, no-wrap
msgid "Contact Method"
msgstr "ວິທີການຕິດຕໍ່"

#. type: Plain text
#: en/modules/specialized-guides/pages/salt/salt-formula-liberate.adoc:43
msgid "Default"
msgstr "ມາດຕະຖານ (Default)"

