"java.sso.onelogin.saml2.organization.displayname = SUSE Manager admin\n"
"java.sso.onelogin.saml2.organization.url = https://sumaserver.example.org\n"
"java.sso.onelogin.saml2.organization.lang =\n"
msgstr ""
