#: en/modules/administration/pages/openscap.adoc:99
#: en/modules/administration/pages/openscap.adoc:106
#, no-wrap
msgid ""
"#!/bin/bash\n"
"chmod +x -R /usr/share/scap-security-guide/bash\n"
"/usr/share/scap-security-guide/bash/sle15-script-stig.sh\n"
msgstr ""
