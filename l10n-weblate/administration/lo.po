"|Number of virtual systems\n"
"\n"
"|uyuni_inactive_systems\n"
"|gauge\n"
"|Number of inactive systems\n"
"\n"
"|uyuni_outdated_systems\n"
"|gauge\n"
"|Number of systems with outdated packages\n"
msgstr ""
"|Metric |Type | ຄຳອະທິບາຍ\n"
"\n"
