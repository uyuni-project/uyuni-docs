"java.notifications_type_disabled = OnboardingFailed,ChannelSyncFailed,\\\n"
"  ChannelSyncFinished,CreateBootstrapRepoFailed,StateApplyFailed,\\\n"
"  PaygAuthenticationUpdateFailed,EndOfLifePeriod,SubscriptionWarning\n"
msgstr ""
"java.notifications_type_disabled = OnboardingFailed,ChannelSyncFailed,\\\n"
"  ChannelSyncFinished,CreateBootstrapRepoFailed,StateApplyFailed,\\\n"
"  PaygAuthenticationUpdateFailed,EndOfLifePeriod,SubscriptionWarning\n"

#. type: Plain text
