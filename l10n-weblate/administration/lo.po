#: en/modules/administration/pages/content-lifecycle-examples.adoc:52
#, no-wrap
msgid "Procedure: Including a patch in a project"
msgstr "ຂັ້ນຕອນ: ການລວມແພັດຊ໌ເຂົ້າໃນໂປຣເຈັກ"

#. type: delimited block _
#: en/modules/administration/pages/content-lifecycle-examples.adoc:54
msgid "In the `Filter Name` field, type a name for the filter."
msgstr ""

#. type: delimited block _
#: en/modules/administration/pages/content-lifecycle-examples.adoc:55
msgid "For example, `Include kernel security fix`."
msgstr ""

#. type: delimited block _
#: en/modules/administration/pages/content-lifecycle-examples.adoc:58
